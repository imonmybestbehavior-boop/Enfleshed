-- Data-only visual asset grammar. Small composable layers, never finished per-spell assets.
-- A layer: Kind (Nodes|Emitter|Trail|Fire|Light), Arrangement, Priority (1 boundary/silhouette,
-- 2 element body, 3 mechanic accent, 4 detail), Params defaults, Limits {min, max}, and
-- Drivers { Param, Feature, Weight, Shape? }: value = default + sum(weight * shape(feature)).
-- "Form" as an Arrangement means "follow the form's own volume arrangement".
local Library = {}

-- Count features (Pierces, Bounces, ...) are divided by this before driving a parameter.
Library.CountScale = 8

Library.Budget = {
	PerSpell = {
		MaxLayers = 12,
		MaxAccents = 4,
		MaxParts = 40,
		-- Parts held back from element bodies so mechanic accents (forks, satellites...) stay visible.
		AccentReserve = 12,
		MaxLinks = 28,
		MaxTrails = 3,
		MaxEmitters = 4,
		MaxEmitterRate = 24,
		MaxSpellRate = 48,
		MaxFire = 8,
		MaxLights = 1,
	},
	Global = {
		MaxSessions = 32,
		MaxEmitters = 32,
		MaxContinuousRate = 160,
		MaxFire = 96,
		MaxLights = 32,
	},
	-- Distance (studs) -> highest Priority still drawn. Priority 1 survives every visible tier.
	DistanceTiers = { { 70, 4 }, { 120, 3 }, { 180, 2 } },
	HiddenDistance = 180,
	Quality = {
		High = { Count = 1, Rate = 1, MaxPriority = 4, MaxEmitters = 4, MaxFire = 8 },
		Medium = { Count = 0.7, Rate = 0.6, MaxPriority = 4, MaxEmitters = 2, MaxFire = 4 },
		Low = { Count = 0.5, Rate = 0.35, MaxPriority = 3, MaxEmitters = 1, MaxFire = 2 },
	},
}

-- Volume arrangement used when an element/mechanic layer follows its form.
Library.FormArrangement = {
	Projectile = "Comet",
	Beam = "Helix",
	Wave = "Crest",
	Field = "Ground", -- fields are grounded: element bodies stand upright inside the footprint
	Aura = "Orbit",
	Construct = "Lattice",
	SelfEnhancement = "Mantle",
	Manipulation = "Lattice",
	Rush = "Comet",
	Tether = "Helix",
}

local function range(min, max)
	return { min, max }
end

