-- Every identity is a kit (SignatureKits) covering all forms. Fire and Body keep their
-- hand-authored layers for the roles they were designed for; templates fill the rest.
local Kits = require(script.Parent.SignatureKits)
local bespoke = {
	Fire = { Owns = { Projectile = true, Impact = true, Cast = true }, Signature = Library.Signatures.Fire },
	Body = { Owns = { Wave = true, Cast = true }, Signature = Library.Signatures.Body },
}
Library.Signatures = {}
for name in pairs(Kits.Definitions) do
	local authored = bespoke[name]
	Library.Signatures[name] = Kits.build(name, authored and {
		Owns = authored.Owns,
		Layers = authored.Signature.Layers,
		Palette = authored.Signature.Palette,
		Tintable = authored.Signature.Tintable,
	})
end
Library.Match = Kits.Match

return Library
