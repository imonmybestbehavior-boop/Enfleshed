-- Pure data: reusable form components, effect-layer slots and per-principle visual signatures.
-- A signature is chosen from the spell's Element or Source.Principle (never its name or id) and
-- supplies layer recipes per slot. Components decide which slots a gameplay form/phase uses, so a
-- new visual identity is a new table here, not a new service. Layers reference assets by name
-- from Assets/VFXAssetManifest; nothing in this file creates instances.
--
-- Layer fields
--   Id, Slot, Kind, Priority (1 = gameplay-critical, kept at every quality; 3 = detail)
--   Texture / Mesh / Meshes   manifest asset names
--   Colors                    palette tokens, sampled over particle life (or one token)
--   Params                    base numbers (see SignatureRenderer for meaning per Kind)
--   Drivers                   { Param, Scalar, Weight }: value = base + weight * scalar (scalars 0..1)
--   Limits                    { Param = { min, max } } applied after drivers
--   Forms                     optional allowlist of gameplay forms (plan.Form) for this layer
--   Roles                     optional allowlist of anchor roles (Projectile, Wave, Impact, Cast...)
local Library = {}

-- Slots, in build order. Lower slots win budget contention.
Library.Slots = { "Core", "Shell", "Trail", "Impact", "Charge", "Cast", "Secondary", "Ambient", "Dissipate" }

-- Form components: which slots a form instantiates for each anchor phase. "Cast" is the casting
-- cue anchored to the caster; "Impact" is the per-hit anchor.
Library.Components = {
	Projectile = { Sustain = { "Core", "Shell", "Secondary", "Trail", "Ambient" }, End = { "Dissipate" } },
	Beam = { Sustain = { "Core", "Secondary", "Ambient" }, End = { "Dissipate" } },
	Wave = {
		Release = { "Core", "Shell", "Secondary", "Impact", "Ambient" },
		Sustain = { "Core", "Shell", "Secondary", "Impact", "Ambient" },
		End = { "Dissipate" },
	},
	Field = { Sustain = { "Secondary", "Ambient" }, End = { "Dissipate" } },
	Aura = { Sustain = { "Shell", "Ambient" }, End = { "Dissipate" } },
	Construct = { Sustain = { "Ambient" }, End = { "Dissipate" } },
	SelfEnhancement = { Sustain = { "Shell", "Ambient" }, End = { "Dissipate" } },
	Manipulation = { Sustain = { "Ambient" }, End = { "Dissipate" } },
	Cast = { Gather = { "Charge" }, Release = { "Cast" } },
	Impact = { Impact = { "Impact", "Dissipate" } },
}

-- Quality presets. Priority-1 layers survive every preset so spells stay recognizable.
Library.Quality = {
	High = { MaxPriority = 3, Rate = 1, Count = 1, Lights = true, Meshes = true },
	Medium = { MaxPriority = 2, Rate = 0.65, Count = 0.7, Lights = true, Meshes = true },
	Low = { MaxPriority = 1, Rate = 0.4, Count = 0.45, Lights = false, Meshes = false },
}

-- Client-wide caps for signature layers (independent of the procedural composer's own caps).
Library.Budget = {
	MaxSessions = 24,
	MaxEmitters = 72,
	MaxContinuousRate = 420,
	MaxMeshes = 72,
	MaxLights = 10,
	MaxTrails = 24,
	MaxBurstPerSecond = 900,
	MaxEmitterRate = 60,
	MaxBurstCount = 48,
}

-- Cel look controls, applied at runtime (no asset re-upload needed).
--   Saturation / Value  multiply every palette colour's saturation and brightness (Ink excluded)
--   LightInfluence      how much scene lighting dims particles, trails and beams (0 = flat, unlit)
--   Brightness          particle brightness multiplier
--   InkScale            extra growth of `_ink` outline hulls beyond their authored thickness
Library.Style = {
	Saturation = 1.35,
	Value = 1.15,
	LightInfluence = 0.1,
	Brightness = 1.35,
	InkScale = 0.06,
}

local function layer(t)
	t.Params = t.Params or {}
	t.Drivers = t.Drivers or {}
	t.Limits = t.Limits or {}
	return t
end

