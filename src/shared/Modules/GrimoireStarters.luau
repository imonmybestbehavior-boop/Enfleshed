local function buildPayloads(form: string, principle: string, event: string, definitions: { any })
	local result = {}
	for _, sourcePayload in ipairs(definitions) do
		local schemaPayload = assert(Schema.Payloads[sourcePayload.Kind], "Unknown showcase payload")
		local payload = Spec.copy(schemaPayload.Defaults)
		overlay(payload, sourcePayload)
		payload.Kind = sourcePayload.Kind
		assert(
			Schema.supportsPayload(payload.Kind, form, event, principle),
			"Unsupported showcase effect: " .. form .. " / " .. event .. " / " .. payload.Kind
		)
		table.insert(result, payload)
	end
	return result
end

local function buildRecipeCollection(sourceRecipes: { any }, collectionLabel: string)
	local result = {}
	for _, recipe in ipairs(sourceRecipes) do
		local built, entry = pcall(function()
			local definition =
				assert(Spec.createDraft(recipe.Form, recipe.Principle), "Unsupported " .. collectionLabel .. " form")
			definition.SpellId = string.gsub(recipe.Name, "%W", "")
			definition.Name = recipe.Name
			definition.Element = recipe.Element
			definition.Tags = { "showcase", string.lower(recipe.Element), string.lower(recipe.Form) }
			if recipe.Targeting then
				definition.Targeting = recipe.Targeting
			end
			if recipe.Targeting == "EntityTarget" then
				definition.TargetPolicy = "Aim"
			end
			if recipe.Geometry then
				definition.Geometry = recipe.Geometry
			end
			if recipe.Casting then
				overlay(definition.Casting, recipe.Casting)
			end
			if recipe.Lifetime then
				overlay(definition.Lifetime, recipe.Lifetime)
			end
			for _, section in ipairs({ "Projectile", "Beam", "Wave", "Field", "Aura", "Construct", "MaterialConfig" }) do
				local key = if section == "MaterialConfig" then "Material" else section
				if recipe[section] then
					if section == "MaterialConfig" then
						definition.Material = Spec.copy(recipe.MaterialConfig)
					else
						overlay(definition[key], recipe[section])
					end
				end
			end
			if recipe.AreaConfig then
				definition[recipe.Form] = Spec.copy(recipe.AreaConfig)
			end
			-- Curated spells wear their element's own signature colours (the untouched Origin
			-- palette), matching the F8 preview; players pick a palette on their own copies.
			local visual = VisualSpec.PaletteDefinitions.Origin
			definition.Visual.Palette = "Origin"
			definition.Visual.Color = visual.Colors[1]
			definition.Visual.SecondaryColor = visual.Colors[2]
			definition.Visual.AccentColor = visual.Colors[3]
			definition.Visual.CoreShape = recipe.Shape
			definition.Visual.MaterialAppearance = recipe.Material
			definition.Visual.ParticleStyle = recipe.Particle
			definition.Visual.TrailStyle = recipe.Trail
			definition.Visual.ImpactStyle = recipe.Impact
			definition.Visual.VFXDefinition = recipe.VFX
			definition.Visual.CastingStyle = "GroundSigil"
			if recipe.TargetRules then
				overlay(definition.TargetRules, recipe.TargetRules)
			end
			definition.Triggers[recipe.Event] = {
				{ Payloads = buildPayloads(recipe.Form, recipe.Principle, recipe.Event, recipe.Payloads) },
			}
			for event, definitions in pairs(recipe.OtherTriggers or {}) do
				definition.Triggers[event] =
					{ { Payloads = buildPayloads(recipe.Form, recipe.Principle, event, definitions) } }
			end
			local valid, reason = Spec.validate(definition)
			assert(valid, "Invalid " .. collectionLabel .. " spell: " .. tostring(reason))
			return { Definition = definition, Description = recipe.Description }
		end)
		if built then
			table.insert(result, entry)
		else
			warn(
				string.format(
					"[MagicLab] Skipping invalid %s spell %s: %s",
					collectionLabel,
					recipe.Name,
					tostring(entry)
				)
			)
		end
	end
	return result
end

function Starters.buildShowcase()
	return buildRecipeCollection(showcases, "showcase")
end

function Starters.buildCombatStarters()
	return buildRecipeCollection(combatStarters, "combat starter")
end

function Starters.buildShowcaseExpansion()
	return buildRecipeCollection(showcaseExpansion, "showcase expansion")
end

return Starters
