{
  "name": "Enfleshed",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared",
        "SandboxRemotes": {
          "$className": "Folder",
          "ActionRequest": { "$className": "RemoteEvent" },
          "ActionFeedback": { "$className": "RemoteEvent" },
          "AerialControl": { "$className": "RemoteEvent" },
          "MagicLabRequest": { "$className": "RemoteEvent" },
          "MagicLabResponse": { "$className": "RemoteEvent" },
          "GrimoireResponse": { "$className": "RemoteEvent" },
          "TrainingDummyRequest": { "$className": "RemoteEvent" },
          "TrainingDummyResponse": { "$className": "RemoteEvent" },
          "MagicPresentation": { "$className": "RemoteEvent" },
          "SpellVFX": { "$className": "RemoteEvent" },
          "MissionRemote": { "$className": "RemoteEvent" },
          "InventoryRemote": { "$className": "RemoteEvent" }
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "StreamingMinRadius": 256,
        "StreamingTargetRadius": 768,
        "FallenPartsDestroyHeight": -100
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -90,
            0
          ],
          "Size": [
            6000,
            20,
            8000
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Future"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
