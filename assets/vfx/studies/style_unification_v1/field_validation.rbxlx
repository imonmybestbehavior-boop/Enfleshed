            </Properties>
          </Item>
          <Item class="ModuleScript" referent="312">
            <Properties>
              <string name="Name">SpellVisualFeatureExtractor</string>
              <string name="Source"><![CDATA[-- Pure: validated SpellSpec -> normalized mechanical visual features.
-- Reads gameplay data only; never mutates it. No spell name/ID is consulted.
local Curves = require(script.Parent.VisualCurves)
local Extractor = {}

-- Normalization references. These mirror Configuration/MagicLab safety limits
-- (a test asserts they stay in sync) so a maximum-legal value saturates at 1.
Extractor.Reference = {
	Damage = 120,
	DotTick = 25,
	TickRate = 10, -- 1 / MagicLab.MinInterval
	Duration = 15, -- MagicLab.MaxDuration
	DotTotal = 250,
	Heal = 150,
	Shield = 150, -- MagicLab.MaxShieldPerTarget
	MaxSlow = 0.75, -- 1 - MagicLab.MinSlowMultiplier
	Bind = 4, -- MagicLab.MaxBindDuration
	Force = 100, -- MagicLab.MaxForce
	Speed = 200, -- MagicLab.MaxSpeed
	ProjectileRadius = 4,
	Range = 200, -- MagicLab.MaxRange
	Radius = 20, -- MagicLab.MaxRadius
	BeamWidth = 10,
	TurnRate = 540, -- MagicLab.MaxHomingTurnRate
	Construct = 20,
	Cast = 5,
	Lifetime = 30,
	Payloads = 8,
	MarkStacks = 5, -- MagicLab.MaxElementalMarkStacks
	Summon = 6,
	Aerial = 48, -- MagicLab.MaxAerialSpeed
	Reveal = 15,
	MaxCount = 8,
}

-- Canonical feature order: encoding, fingerprinting and tests depend on it.
Extractor.Order = {
	"Direct",
	"DotTick",
	"DotRate",
	"DotDuration",
	"DotTotal",
	"Heal",
	"Shield",
	"Duration",
	"Slow",
	"Bind",
	"Force",
	"Speed",
	"Size",
	"Range",
	"Radius",
	"Width",
	"Homing",
	"Linger",
	"Construct",
	"Growth",
	"Cast",
	"Lifetime",
	"Payloads",
	"Mark",
	"TimeDilation",
	"Reveal",
	"Summon",
	"Aerial",
	"Repeat",
	"Pierces",
	"Bounces",
	"Splits",
	"Chains",
}
-- Integer counts (0..MaxCount); everything else is normalized 0..1.
Extractor.Counts = { Pierces = true, Bounces = true, Splits = true, Chains = true }

local PRIMARY = {
	OnCast = true,
	OnImpact = true,
	OnEnter = true,
	OnSpawn = true,
	OnTick = true,
	OnProximity = true,
}

local function num(v)
	return if type(v) == "number" and v == v and v > -math.huge and v < math.huge then v else 0
end

local function sortedEvents(triggers)
	local events = {}
	if type(triggers) ~= "table" then
		return events
	end
	for event in pairs(triggers) do
		if type(event) == "string" then
			table.insert(events, event)
		end
	end
	table.sort(events)
	return events
end

-- Accumulates raw mechanical magnitudes from one payload list.
local function scanPayloads(payloads, raw, weight)
	for _, p in ipairs(type(payloads) == "table" and payloads or {}) do
		if type(p) == "table" and type(p.Kind) == "string" then
			raw.payloads += weight
			local kind = p.Kind
			local duration = num(p.Duration)
			if kind == "Damage" then
				raw.direct += num(p.Amount) * weight
			elseif kind == "DamageOverTime" then
				local amount, interval = num(p.Amount), math.max(num(p.Interval), 0.1)
				local ticks = math.max(1, math.floor(duration / interval + 1e-6))
				raw.dotTotal += amount * ticks * weight
				if amount > raw.dotTick then
					raw.dotTick = amount
					raw.dotRate = 1 / interval
				end
				raw.dotDuration = math.max(raw.dotDuration, duration)
			elseif kind == "Heal" then
				raw.heal += num(p.Amount) * weight
			elseif kind == "Restoration" then
				local interval = math.max(num(p.Interval), 0.1)
				raw.heal += num(p.Amount) * math.max(1, math.floor(duration / interval + 1e-6)) * weight
			elseif kind == "Shield" then
				raw.shield += num(p.Amount) * weight
			elseif kind == "ModifyAttribute" and p.Attribute == "MagicArmor" and num(p.Amount) > 0 then
				raw.shield += num(p.Amount) * 0.6 * weight
			elseif kind == "Slow" then
				raw.slow = math.max(raw.slow, 1 - (if p.Multiplier == nil then 1 else num(p.Multiplier)))
			elseif kind == "Bind" then
				raw.bind = math.max(raw.bind, duration)
			elseif kind == "Force" then
				raw.force = math.max(raw.force, num(p.Magnitude) + num(p.Upward) * 0.5)
			elseif kind == "Control" then
				raw.force = math.max(raw.force, num(p.Acceleration), num(p.MaxSpeed) * 0.5)
			elseif kind == "Displacement" then
				raw.force = math.max(raw.force, num(p.Distance) * 4)
			elseif kind == "ElementalMark" then
				raw.mark = math.max(raw.mark, math.max(1, num(p.Stacks)))
			elseif kind == "TimeDilation" then
				raw.time = math.max(raw.time, math.abs(1 - (if p.Rate == nil then 1 else num(p.Rate))))
			elseif kind == "Reveal" then
				raw.reveal = math.max(raw.reveal, duration)
			elseif kind == "Summon" then
				raw.summon += math.max(1, num(p.Count))
			elseif kind == "AerialMovement" then
				raw.aerial = math.max(raw.aerial, num(p.Speed))
			elseif kind == "Enhancement" then
				raw.force = math.max(raw.force, num(p.WalkSpeedBonus) * 2)
			end
			if kind ~= "DamageOverTime" and kind ~= "Damage" then
				raw.duration = math.max(raw.duration, duration)
			end
		end
	end
end

-- Accumulates raw mechanical magnitudes from every payload and trigger behavior.
local function scanTriggers(spell, raw)
	-- Forms that deliver their own payloads (a wave's push, a beam's burn) count as primary events.
	for _, key in ipairs({ "Projectile", "Beam", "Wave", "Field", "Aura" }) do
		local form = spell[key]
		if type(form) == "table" and type(form.Payloads) == "table" then
			scanPayloads(form.Payloads, raw, 1)
		end
	end
	for _, event in ipairs(sortedEvents(spell.Triggers)) do
		local weight = if PRIMARY[event] then 1 else 0.5
		if event == "OnTick" then
			raw.repeats = true
		end
		local steps = spell.Triggers[event]
		for _, step in ipairs(type(steps) == "table" and steps or {}) do
			if type(step) == "table" then
				if step.Behavior == "Explode" then
					raw.direct += num(step.Radius) * 1.5 * weight
				end
				scanPayloads(step.Payloads, raw, weight)
			end
		end
	end
end

local function scanProjectile(spell, raw)
	local p = spell.Projectile
	if type(p) ~= "table" then
		return
	end
	raw.speed = math.max(raw.speed, num(p.Speed))
	raw.size = math.max(raw.size, num(p.Radius))
	raw.range = math.max(raw.range, num(p.MaxDistance))
	for _, b in ipairs(type(p.Behaviors) == "table" and p.Behaviors or {}) do
		if type(b) == "table" then
			local kind = b.Kind
			if kind == "Pierce" then
				raw.pierces += math.max(1, num(b.MaxPierces))
			elseif kind == "Bounce" then
				raw.bounces += math.max(1, num(b.MaxBounces))
			elseif kind == "Return" then
				raw.bounces += 1
			elseif kind == "Split" then
				raw.splits += math.max(2, num(b.ChildCount))
			elseif kind == "Spread" then
				raw.splits += math.max(1, num(b.SidePairs)) * 2
			elseif kind == "Chain" then
				raw.chains += math.max(1, num(b.MaxJumps))
			elseif kind == "Propagate" then
				raw.chains += math.max(1, num(b.MaxTargets))
			elseif kind == "Homing" then
				raw.homing = math.max(raw.homing, num(b.TurnRate))
			elseif kind == "Linger" then
				raw.linger = math.max(raw.linger, num(b.Duration))
				raw.repeats = true
				raw.repeatRate = math.max(raw.repeatRate, 1 / math.max(num(b.Interval), 0.1))
			elseif kind == "Pulse" or kind == "Proximity" then
				raw.repeats = true
				raw.repeatRate = math.max(raw.repeatRate, 1 / math.max(num(b.Interval), 0.1))
			end
		end
	end
	if num(p.ChannelInterval) > 0 and raw.repeats then
		raw.repeatRate = math.max(raw.repeatRate, 1 / math.max(num(p.ChannelInterval), 0.1))
	end
end

local function areaRadius(config)
	return math.max(
		num(config.Radius),
		num(config.OuterRadius),
		num(config.Range) * 0.5,
		num(config.Width) * 0.5,
		num(config.Depth) * 0.5
	)
end

local function scanForms(spell, raw)
	local beam = spell.Beam
	if type(beam) == "table" then
		raw.range = math.max(raw.range, num(beam.Range))
		raw.width = math.max(raw.width, num(beam.Width))
		if beam.Pattern == "Cascade" then
			raw.chains += math.max(1, num(beam.StrikeCount))
			raw.repeatRate = math.max(raw.repeatRate, 1 / math.max(num(beam.StrikeInterval), 0.1))
			raw.repeats = true
		end
		if num(beam.Interval) > 0 and spell.Casting and spell.Casting.Mode == "Channeled" then
			raw.repeatRate = math.max(raw.repeatRate, 1 / math.max(num(beam.Interval), 0.1))
		end
		raw.growth = math.max(raw.growth, num(beam.GrowthDuration))
	end
	local wave = spell.Wave
	if type(wave) == "table" then
		raw.range = math.max(raw.range, num(wave.Range))
		raw.radius = math.max(raw.radius, num(wave.Range))
		raw.growth = math.max(raw.growth, num(wave.GrowthDuration))
		if raw.repeats and num(wave.Interval) > 0 then
			raw.repeatRate = math.max(raw.repeatRate, 1 / math.max(num(wave.Interval), 0.1))
		end
	end
	for _, key in ipairs({ "Field", "Aura" }) do
		local area = spell[key]
		if type(area) == "table" then
			raw.radius = math.max(raw.radius, areaRadius(area))
			raw.growth = math.max(raw.growth, num(area.GrowthDuration))
			if raw.repeats and num(area.Interval) > 0 then
				raw.repeatRate = math.max(raw.repeatRate, 1 / math.max(num(area.Interval), 0.1))
			end
		end
	end
	local construct = spell.Construct
	if type(construct) == "table" then
		local volume = math.max(num(construct.Width), 0.1)
			* math.max(num(construct.Height), 0.1)
			* math.max(num(construct.Depth), 0.1)
		raw.construct = math.max(raw.construct, volume ^ (1 / 3))
		raw.growth = math.max(raw.growth, num(construct.GrowthDuration))
	end
	local casting = spell.Casting
	if type(casting) == "table" then
		raw.cast = num(casting.CastTime) + num(casting.MaximumCharge)
		if casting.Mode == "Channeled" then
			raw.repeats = true
		end
	end
	if type(spell.Lifetime) == "table" then
		raw.lifetime = num(spell.Lifetime.Duration)
	end
end

function Extractor.raw(spell)
	local raw = {
		direct = 0,
		dotTick = 0,
		dotRate = 0,
		dotDuration = 0,
		dotTotal = 0,
		heal = 0,
		shield = 0,
		duration = 0,
		slow = 0,
		bind = 0,
		force = 0,
		speed = 0,
		size = 0,
		range = 0,
		radius = 0,
		width = 0,
		homing = 0,
		linger = 0,
		construct = 0,
		growth = 0,
		cast = 0,
		lifetime = 0,
		payloads = 0,
		mark = 0,
		time = 0,
		reveal = 0,
		summon = 0,
		aerial = 0,
		repeats = false,
		repeatRate = 0,
		pierces = 0,
		bounces = 0,
		splits = 0,
		chains = 0,
	}
	if type(spell) ~= "table" then
		return raw
	end
	scanTriggers(spell, raw)
	scanProjectile(spell, raw)
	scanForms(spell, raw)
	if raw.aerial > 0 then
		raw.speed = math.max(raw.speed, raw.aerial * 2)
	end
	return raw
end

function Extractor.extract(spell)
	local r, R = Extractor.raw(spell), Extractor.Reference
	local f = {
		Direct = Curves.log(r.direct, R.Damage),
		DotTick = Curves.log(r.dotTick, R.DotTick),
		DotRate = if r.dotTick > 0 then Curves.log(r.dotRate, R.TickRate) else 0,
		DotDuration = if r.dotTick > 0 then Curves.sqrt(r.dotDuration, R.Duration) else 0,
		DotTotal = Curves.log(r.dotTotal, R.DotTotal),
		Heal = Curves.log(r.heal, R.Heal),
		Shield = Curves.log(r.shield, R.Shield),
		Duration = Curves.sqrt(r.duration, R.Duration),
		Slow = Curves.smoothstep(r.slow, 0, R.MaxSlow),
		Bind = Curves.sqrt(r.bind, R.Bind),
		Force = Curves.log(r.force, R.Force),
		Speed = Curves.log(r.speed, R.Speed),
		Size = Curves.sqrt(r.size, R.ProjectileRadius),
		Range = Curves.log(r.range, R.Range),
		Radius = Curves.sqrt(r.radius, R.Radius),
		Width = Curves.sqrt(r.width, R.BeamWidth),
		Homing = Curves.sqrt(r.homing, R.TurnRate),
		Linger = Curves.sqrt(r.linger, R.Duration),
		Construct = Curves.sqrt(r.construct, R.Construct),
		Growth = Curves.sqrt(r.growth, R.Duration),
		Cast = Curves.sqrt(r.cast, R.Cast),
		Lifetime = Curves.sqrt(r.lifetime, R.Lifetime),
		Payloads = Curves.saturate(r.payloads, R.Payloads / 3),
		Mark = Curves.linear(r.mark, R.MarkStacks),
		TimeDilation = Curves.linear(r.time, 1),
		Reveal = Curves.sqrt(r.reveal, R.Reveal),
		Summon = Curves.linear(r.summon, R.Summon),
		Aerial = Curves.linear(r.aerial, R.Aerial),
		Repeat = if r.repeats then math.max(0.15, Curves.log(r.repeatRate, R.TickRate)) else 0,
		Pierces = Curves.int(r.pierces, R.MaxCount),
		Bounces = Curves.int(r.bounces, R.MaxCount),
		Splits = Curves.int(r.splits, R.MaxCount),
		Chains = Curves.int(r.chains, R.MaxCount),
	}
	for _, key in ipairs(Extractor.Order) do
		if not Extractor.Counts[key] then
			f[key] = Curves.quantize(f[key])
		end
	end
	return f
end

-- Compact, deterministic replication form: one string attribute instead of 33.
function Extractor.encode(features)
	local parts = {}
	for index, key in ipairs(Extractor.Order) do
		local value = features[key] or 0
		parts[index] = if Extractor.Counts[key]
			then tostring(math.floor(value))
			else tostring(math.floor(value * 1000 + 0.5))
	end
	return table.concat(parts, ",")
end

function Extractor.decode(encoded)
	local features = {}
	for _, key in ipairs(Extractor.Order) do
		features[key] = 0
	end
	if type(encoded) ~= "string" then
		return features
	end
	local index = 0
	for token in string.gmatch(encoded, "[^,]+") do
		index += 1
		local key = Extractor.Order[index]
		if not key then
			break
		end
		local value = tonumber(token) or 0
		features[key] = if Extractor.Counts[key]
			then math.clamp(math.floor(value), 0, Extractor.Reference.MaxCount)
			else math.clamp(value / 1000, 0, 1)
	end
	return features
end

return Extractor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="313">
            <Properties>
              <string name="Name">SpellVisualFingerprint</string>
              <string name="Source"><![CDATA[-- Pure, deterministic cosmetic seed from canonical gameplay features.
-- Never reads spell names, SpellId, time, or math.random.
local Fingerprint = {}

local MOD = 4294967296 -- 2^32

-- Exact 32-bit multiply without exceeding double precision.
local function mul32(a, b)
	local aLow, aHigh = a % 65536, math.floor(a / 65536)
	return (aLow * b + ((aHigh * b) % 65536) * 65536) % MOD
end

local function mix(h)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = mul32(h, 0x45D9F3B)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = mul32(h, 0x45D9F3B)
	return bit32.bxor(h, bit32.rshift(h, 16))
end

function Fingerprint.hash(text)
	local h = 2166136261
	for i = 1, #text do
		h = (h * 31 + string.byte(text, i)) % MOD
	end
	return mix(h)
end

function Fingerprint.canonical(element, form, geometry, encodedFeatures)
	return table.concat(
		{ element or "Neutral", form or "Projectile", geometry or "Sphere", encodedFeatures or "" },
		"|"
	)
end

function Fingerprint.seed(element, form, geometry, encodedFeatures)
	return Fingerprint.hash(Fingerprint.canonical(element, form, geometry, encodedFeatures))
end

-- Stable value in [0, 1) for a named purpose ("phase", "tilt", ...).
function Fingerprint.unit(seed, salt)
	local h = mix(bit32.bxor(seed % MOD, Fingerprint.hash(salt or "")))
	return h / MOD
end

function Fingerprint.pick(seed, salt, options)
	if #options == 0 then
		return nil
	end
	return options[math.floor(Fingerprint.unit(seed, salt) * #options) + 1]
end

return Fingerprint
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="314">
            <Properties>
              <string name="Name">SpellVisualPlanBuilder</string>
              <string name="Source"><![CDATA[-- Pure: (base plan + features + seed) x asset library -> bounded, deterministic render plan.
-- No Roblox instances are created here; the composer instantiates the result.
local Curves = require(script.Parent.VisualCurves)
local Library = require(script.Parent.SpellVisualAssetLibrary)
local Fingerprint = require(script.Parent.SpellVisualFingerprint)
local Extractor = require(script.Parent.SpellVisualFeatureExtractor)
local Builder = {}

local tau = math.pi * 2

local function featureValue(features, name)
	local value = features[name] or 0
	if Extractor.Counts[name] then
		return math.clamp(value / Library.CountScale, 0, 1)
	end
	return Curves.clamp01(value)
end

local function evaluate(definition, features)
	local params = {}
	for key, value in pairs(definition.Params) do
		params[key] = value
	end
	for _, driver in ipairs(definition.Drivers or {}) do
		local param, feature, weight, shape = driver[1], driver[2], driver[3], driver[4]
		params[param] = (params[param] or 0) + weight * Curves.shape(shape, featureValue(features, feature))
	end
	if definition.CountFrom then
		params.Count = math.max(params.Count or 1, features[definition.CountFrom] or 0)
	end
	for key, limit in pairs(definition.Limits or {}) do
		if params[key] ~= nil then
			params[key] = math.clamp(params[key], limit[1], limit[2])
		end
	end
	if params.Count then
		params.Count = math.max(0, math.floor(params.Count + 0.5))
	end
	return params
end

local function requiresMet(definition, features)
	local requirement = definition.Requires
	if not requirement then
		return true
	end
	return (features[requirement[1]] or 0) >= requirement[2]
end

local function rankOf(definition, features)
	local rank = featureValue(features, definition.Rank)
	for _, extra in ipairs(definition.AlsoRanks or {}) do
		rank = math.max(rank, featureValue(features, extra))
	end
	return rank
end

local function layer(definition, features, seed, form, motifs)
	local arrangement = definition.Arrangement
	if arrangement == "Form" then
		arrangement = Library.FormArrangement[form] or "Comet"
	end
	return {
		Id = definition.Id,
		Kind = definition.Kind,
		Arrangement = arrangement,
		Motif = definition.Motif or Fingerprint.pick(seed, definition.Id .. ":motif", motifs) or "Sphere",
		Texture = definition.Texture,
		Priority = definition.Priority,
		Phase = Curves.quantize(Fingerprint.unit(seed, definition.Id .. ":phase")) * tau,
		Tilt = (Curves.quantize(Fingerprint.unit(seed, definition.Id .. ":tilt")) - 0.5) * 0.8,
		Curve = (Curves.quantize(Fingerprint.unit(seed, definition.Id .. ":curve")) - 0.5) * 2,
		Params = evaluate(definition, features),
		Limits = definition.Limits,
	}
end

-- Ordered candidates: form silhouette, element body/detail, light, ranked mechanic accents.
function Builder.candidates(plan, features, seed)
	local form = plan.Form
	local element = Library.Elements[plan.Element] or Library.Elements.Neutral
	local list = {}
	local formLayers = if plan.CastingCue then Library.Forms.Cue else (Library.Forms[form] or Library.Forms.Projectile)
	for _, definition in ipairs(formLayers) do
		table.insert(list, layer(definition, features, seed, form, element.Motifs))
	end
	local elementForm = if plan.CastingCue then "Projectile" else form
	for _, definition in ipairs(element.Layers) do
		local allowed = definition.Forms == nil or definition.Forms[elementForm] == true
		if
			allowed
			and not (plan.CastingCue and definition.Arrangement == "Core")
			and requiresMet(definition, features)
		then
			table.insert(list, layer(definition, features, seed, elementForm, element.Motifs))
		end
	end
	table.insert(list, layer(Library.Light, features, seed, form, element.Motifs))
	local mechanics = {}
	for _, definition in ipairs(Library.Mechanics) do
		if requiresMet(definition, features) then
			table.insert(mechanics, { Definition = definition, Rank = rankOf(definition, features) })
		end
	end
	table.sort(mechanics, function(a, b)
		if a.Rank ~= b.Rank then
			return a.Rank > b.Rank
		end
		return a.Definition.Id < b.Definition.Id
	end)
	for index = 1, math.min(#mechanics, Library.Budget.PerSpell.MaxAccents) do
		table.insert(list, layer(mechanics[index].Definition, features, seed, elementForm, element.Motifs))
	end
	return list
end

-- Applies per-spell caps and quality scaling in priority order; priority 1 is always kept.
function Builder.build(plan, options)
	options = options or {}
	local features = plan.Features or Extractor.decode(plan.FeatureVector)
	local seed = plan.Seed or Fingerprint.seed(plan.Element, plan.Form, plan.Geometry, Extractor.encode(features))
	local caps = Library.Budget.PerSpell
	local quality = Library.Budget.Quality[options.Quality or "High"] or Library.Budget.Quality.High
	local candidates = Builder.candidates(plan, features, seed)
	-- Stable priority sort keeps the authored order inside each priority band.
	for index, entry in ipairs(candidates) do
		entry.Order = index
	end
	table.sort(candidates, function(a, b)
		if a.Priority ~= b.Priority then
			return a.Priority < b.Priority
		end
		return a.Order < b.Order
	end)
	local totals =
		{ Layers = 0, Accents = 0, Parts = 0, Links = 0, Trails = 0, Emitters = 0, Rate = 0, Fire = 0, Lights = 0 }
	local maxEmitters = math.min(caps.MaxEmitters, quality.MaxEmitters)
	local maxFire = math.min(caps.MaxFire, quality.MaxFire)
	local layers = {}
	for _, entry in ipairs(candidates) do
		entry.Order = nil
		local keep = totals.Layers < caps.MaxLayers and (entry.Priority <= quality.MaxPriority or entry.Priority == 1)
		local p = entry.Params
		if keep and entry.Kind == "Nodes" then
			local count =
				math.max(1, math.floor((p.Count or 1) * (if entry.Priority == 1 then 1 else quality.Count) + 0.5))
			local ceiling = caps.MaxParts - (if entry.Priority == 2 then caps.AccentReserve else 0)
			count = math.min(count, ceiling - totals.Parts)
			if entry.Priority == 1 then
				count = math.max(count, 1)
			end
			if count <= 0 then
				keep = false
			else
				p.Count = count
				totals.Parts += count
				if p.Links == 1 then
					local links = math.min(count, caps.MaxLinks - totals.Links)
					p.LinkCount = math.max(0, links)
					totals.Links += p.LinkCount
				end
			end
		elseif keep and entry.Kind == "Emitter" then
			local rate = math.min(p.Rate * quality.Rate, caps.MaxEmitterRate, caps.MaxSpellRate - totals.Rate)
			if totals.Emitters >= maxEmitters or rate < 0.5 then
				keep = false
			else
				p.Rate = math.floor(rate * 10 + 0.5) / 10
				totals.Emitters += 1
				totals.Rate += p.Rate
			end
		elseif keep and entry.Kind == "Trail" then
			local count = math.min(p.Count or 1, caps.MaxTrails - totals.Trails)
			if count <= 0 then
				keep = false
			else
				p.Count = count
				totals.Trails += count
			end
		elseif keep and entry.Kind == "Fire" then
			local count = math.min(math.max(1, math.floor((p.Count or 1) * quality.Count + 0.5)), maxFire - totals.Fire)
			if count <= 0 then
				keep = false
			else
				p.Count = count
				totals.Fire += count
			end
		elseif keep and entry.Kind == "Light" then
			if totals.Lights >= caps.MaxLights then
				keep = false
			else
				totals.Lights += 1
			end
		end
		if keep then
			totals.Layers += 1
			if entry.Priority == 3 then
				totals.Accents += 1
			end
			table.insert(layers, entry)
		end
	end
	local element = Library.Elements[plan.Element] or Library.Elements.Neutral
	return {
		Element = plan.Element,
		Form = plan.Form,
		Geometry = plan.Geometry,
		Seed = seed,
		Quality = options.Quality or "High",
		ElementSpeed = element.Speed,
		-- Slow and time dilation read as heavier, slower animation; never below half speed.
		TimeScale = math.clamp(1 - 0.4 * (features.Slow or 0) - 0.3 * (features.TimeDilation or 0), 0.5, 1),
		MotionRate = 0.8 + 1.4 * (features.Speed or 0),
		Layers = layers,
		Totals = totals,
	}
end

function Builder.find(renderPlan, id)
	for _, entry in ipairs(renderPlan.Layers) do
		if entry.Id == id then
			return entry
		end
	end
	return nil
end

return Builder
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="315">
            <Properties>
              <string name="Name">VisualCurves</string>
              <string name="Source"><![CDATA[-- Bounded, nonlinear normalization shared by the visual feature extractor and plan builder.
-- Every function returns a value in [0, 1] for any finite or non-finite input.
local Curves = {}

local function finite(x)
	return type(x) == "number" and x == x and x > -math.huge and x < math.huge
end

function Curves.clamp01(x)
	if not finite(x) then
		return if x == math.huge then 1 else 0
	end
	return math.clamp(x, 0, 1)
end

-- log1p(x) / log1p(ref): strong response at small values, saturates at ref.
function Curves.log(x, ref)
	if not finite(x) then
		return Curves.clamp01(x)
	end
	if x <= 0 then
		return 0
	end
	return math.min(1, math.log(1 + x) / math.log(1 + ref))
end

function Curves.sqrt(x, ref)
	if not finite(x) or x <= 0 then
		return Curves.clamp01(x)
	end
	return math.min(1, math.sqrt(x / ref))
end

function Curves.linear(x, ref)
	if not finite(x) then
		return Curves.clamp01(x)
	end
	return math.clamp(x / ref, 0, 1)
end

-- 1 - e^(-x/k): saturating response for counts.
function Curves.saturate(x, k)
	if not finite(x) or x <= 0 then
		return Curves.clamp01(x)
	end
	return 1 - math.exp(-x / k)
end

function Curves.smoothstep(x, lo, hi)
	local t = Curves.clamp01((finite(x) and (x - lo) / (hi - lo)) or Curves.clamp01(x))
	return t * t * (3 - 2 * t)
end

-- Response shaping used by layer drivers on already-normalized features.
Curves.Shapes = {
	Linear = function(t)
		return t
	end,
	Ease = function(t)
		return t * t * (3 - 2 * t)
	end,
	Soft = function(t)
		return math.sqrt(t)
	end,
	Late = function(t)
		return t * t
	end,
}

function Curves.shape(name, t)
	local f = Curves.Shapes[name or "Linear"] or Curves.Shapes.Linear
	return f(Curves.clamp01(t))
end

function Curves.quantize(x, steps)
	steps = steps or 1000
	return math.floor(Curves.clamp01(x) * steps + 0.5) / steps
end

function Curves.int(x, maximum)
	if not finite(x) or x <= 0 then
		return 0
	end
	return math.min(maximum, math.floor(x + 0.5))
end

return Curves
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="Folder" referent="316">
        <Properties>
          <string name="Name">Types</string>
        </Properties>
        <Item class="ModuleScript" referent="317">
          <Properties>
            <string name="Name">CombatTypes</string>
            <string name="Source"><![CDATA[--!strict

export type Attack = {
	Startup: number,
	Active: number,
	Recovery: number,
	Damage: number,
	Size: Vector3,
	Offset: number,
	Reach: number,
	Reaction: string?,
}

export type ActionOptions = {
	Sprinting: boolean?,
	Direction: Vector3?,
	SpellId: string?,
	AimDirection: Vector3?,
	WorldPoint: Vector3?,
	TargetModel: Model?,
	TargetInstance: Instance?,
	CastOrigin: Vector3?,
	EquipmentSlot: string?,
	EquipmentAction: string?,
	SummonMode: string?,
	SummonId: number?,
	AllowsTargetedSpells: boolean?,
}

export type ActionRequest = {
	Action: string,
	Sequence: number,
	Character: Model,
	Sprinting: boolean?,
	Direction: Vector3?,
	SpellId: string?,
	AimDirection: Vector3?,
	WorldPoint: Vector3?,
	TargetModel: Model?,
	TargetInstance: Instance?,
	CastOrigin: Vector3?,
	EquipmentSlot: string?,
	EquipmentAction: string?,
	SummonMode: string?,
	SummonId: number?,
	AllowsTargetedSpells: boolean?,
}

export type HitResult = { Target: Model, Damage: number, Health: number }

-- Type information only: the actual state is created and retained exclusively on the server.
export type PlayerState = {
	Character: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Sprinting: boolean,
	MagicWalkSpeedBonus: number,
	MagicSpeedMultiplier: number,
	MagicSlowMultiplier: number,
	MagicCastingMultiplier: number,
	MagicRotationLocked: boolean,
	MagicCastingDirection: Vector3?,
	MagicBaseJumpHeight: number,
	MagicPreviousMultiplier: number?,
	MagicSpeedGraceUntil: number?,
	MagicJumpPowerBonus: number,
	MagicAerialSpeed: number,
	MagicAerialInput: Vector3,
	MagicAerialInputExpiresAt: number,
	MagicAerialAttachment: Attachment?,
	MagicAerialVelocity: LinearVelocity?,
	DashUntil: number,
	DashReadyAt: number,
	DashOrigin: Vector3?,
	DashCheckUntil: number,
	LastPosition: Vector3,
	LastFramePosition: Vector3,
	LastCheck: number,
	DashAllowance: number,
	CorrectionUntil: number,
	SpawnGraceUntil: number,
	Combo: number,
	ReadyAt: number,
	ComboExpires: number,
	Attack: Attack?,
	ActiveAt: number,
	ActiveUntil: number,
	HitTargets: { [Humanoid]: boolean },
	Heavy: boolean,
	Blocking: boolean,
	AttackFacing: Vector3?, -- Flat facing the client swung toward, once checked against the server's.
	DamageScale: number, -- Multiplier for the current swing (a parry bonus raises it).
	ParryBonusUntil: number,
}

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="318">
          <Properties>
            <string name="Name">EquipmentTypes</string>
            <string name="Source"><![CDATA[--!strict

export type Slot = "PrimaryWeapon" | "SecondaryWeapon" | "Utility"

export type State = {
	PrimaryWeapon: string?,
	SecondaryWeapon: string?,
	Utility: string?,
	ActiveSlot: Slot,
}

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="319">
          <Properties>
            <string name="Name">MagicTypes</string>
            <string name="Source"><![CDATA[--!strict

export type ValidationResult = "VALID" | "UNSAFE" | "IMPOSSIBLE"

export type CastIntent = {
	SpellId: string,
	AimDirection: Vector3,
	WorldPoint: Vector3?,
	TargetModel: Model?,
	TargetInstance: Instance?,
}

export type ActiveSpell = {
	SpellId: string,
	Caster: Model,
	Age: number,
	CurrentPhase: string,
	TargetsHit: { [Humanoid]: boolean },
	RemainingLifetime: number,
}

export type Payload = {
	Kind: string,
	Duration: number?,
	Interval: number?,
	Amount: number?,
	Magnitude: number?,
	Upward: number?,
	SpeedMultiplier: number?,
	WalkSpeedBonus: number?,
	JumpPowerBonus: number?,
	Operation: string?,
	Distance: number?,
	Mode: string?,
	DamageChannel: string?,
	Rate: number?,
	Attribute: string?,
	Multiplier: number?,
	Acceleration: number?,
	MaxSpeed: number?,
	Archetype: string?,
	Count: number?,
	SpellSlot: string?,
}
export type TriggerStep = { Behavior: string?, Radius: number?, Payloads: { Payload } }
export type SpellSpec = {
	SpellId: string,
	Name: string,
	Version: number,
	Tags: { string },
	Element: string,
	Source: { Principle: string, Expression: string },
	Form: string,
	Targeting: string,
	TargetPolicy: string?,
	Geometry: string,
	Motion: string,
	TargetRules: {
		Range: number,
		MaxTargets: number,
		RequiresLineOfSight: boolean,
		IncludeCaster: boolean,
		Relationship: string,
		RequiresConsent: boolean,
	},
	Conditions: any,
	Casting: {
		Mode: string,
		Cooldown: number,
		CastTime: number,
		RecoveryTime: number,
		MinimumCharge: number?,
		MaximumCharge: number?,
		InterruptOnDamage: boolean?,
		InterruptMoveDistance: number?,
		CanMoveWhileCasting: boolean?,
		MovementPenalty: number?,
		CanRotateWhileCasting: boolean?,
	},
	Lifetime: { Mode: string, Duration: number? },
	Cost: {
		ManaDemand: number,
		Strain: number,
		Complexity: number,
		SpecialResources: { [string]: number }?,
	},
	LocusRequirements: {
		Capacity: number?,
		Efficiency: number?,
		Potency: number?,
		StrainTolerance: number?,
		ComplexityCapacity: number?,
	}?,
	Triggers: { [string]: { TriggerStep } },
	Visual: { Color: Color3, Profile: string?, ProjectileScale: number? },
	Projectile: {
		Speed: number,
		Radius: number,
		MaxDistance: number,
		Gravity: number,
		Acceleration: number,
		MotionPhases: {
			{
				Mode: string?,
				Duration: number,
				SpeedMultiplier: number?,
				Acceleration: number?,
				Gravity: number?,
				ArcHeight: number?,
				BezierSide: number?,
				BezierHeight: number?,
				OrbitRadius: number?,
				OrbitAngularSpeed: number?,
				ExpandMultiplier: number?,
			}
		}?,
	}?,
	Beam: {
		Range: number,
		Width: number,
		DebugDuration: number,
		Pattern: ("Single" | "Cascade")?,
		StrikeCount: number?,
		SpreadRadius: number?,
		DropHeight: number?,
		StrikeInterval: number?,
		Interval: number?,
		GrowthStartScale: number?,
		GrowthEndScale: number?,
		GrowthDuration: number?,
	}?,
	Field: {
		Radius: number?,
		InnerRadius: number?,
		OuterRadius: number?,
		Width: number?,
		Height: number?,
		Depth: number?,
		Range: number?,
		Angle: number?,
		Interval: number,
		DebugHeight: number?,
		Yaw: number?,
		GrowthStartScale: number?,
		GrowthEndScale: number?,
		GrowthDuration: number?,
	}?,
	Wave: {
		Range: number,
		Dot: number,
		DebugDuration: number,
		GrowthStartScale: number?,
		GrowthEndScale: number?,
		GrowthDuration: number?,
	}?,
	Aura: {
		Radius: number?,
		InnerRadius: number?,
		OuterRadius: number?,
		Width: number?,
		Height: number?,
		Depth: number?,
		Range: number?,
		Angle: number?,
		Interval: number,
		Yaw: number?,
		GrowthStartScale: number?,
		GrowthEndScale: number?,
		GrowthDuration: number?,
	}?,
	Construct: {
		Width: number,
		Height: number,
		Depth: number,
		Distance: number,
		GrowthStartScale: number?,
		GrowthEndScale: number?,
		GrowthDuration: number?,
		Components: {
			{
				Shape: string,
				SizeX: number,
				SizeY: number,
				SizeZ: number,
				OffsetX: number,
				OffsetY: number,
				OffsetZ: number,
				RotationX: number,
				RotationY: number,
				RotationZ: number,
			}
		}?,
	}?,
	Material: { Material: string, Amount: number?, SearchRadius: number }?,
}
return {}
]]></string>
          </Properties>
        </Item>
      </Item>
