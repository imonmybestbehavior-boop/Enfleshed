				{ "Rate", "Potency", 12 },
				{ "Speed", "Speed", 6 },
				{ "Lifetime", "Potency", 0.1 },
			},
			Limits = { Rate = { 6, 44 } },
		}),
		-- Secondary motion: loose wisps that peel off and lean into the direction of travel.
		layer({
			Id = "Fire.Secondary.Wisps",
			Slot = "Secondary",
			Kind = "Emitter",
			Priority = 3,
			Texture = "flame_wisp",
			Colors = { "Body", "Deep" },
			Params = {
				Rate = 5,
				Lifetime = 0.45,
				Speed = 4,
				Spread = 60,
				Direction = "Back",
				Size = 0.9,
				SizeEnd = 0.2,
				Light = 0.5,
				Orientation = "VelocityParallel",
				Drag = 2,
			},
			Drivers = { { "Rate", "Potency", 8 }, { "Rate", "Lifetime", 4 } },
		}),
		-- Trails: a ragged flame wake; homing keeps it longer so curves read clearly.
		layer({
			Id = "Fire.Trail.Wake",
			Roles = { Projectile = true },
			Slot = "Trail",
