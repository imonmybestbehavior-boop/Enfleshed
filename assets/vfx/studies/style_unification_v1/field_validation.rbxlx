			Framerate = 14,
			Spin = 0.6,
			Scroll = 2,
			Wobble = 0.6,
			CoreMeshSize = 0.55,
			ScatterSize = 0.6,
			FieldMode = "Wisps",
			SpiritOrbit = true,
		},
	},
	Space = {
		Palette = {
			Hi = Color3.fromRGB(236, 226, 255),
			Mid = Color3.fromRGB(130, 100, 255),
			Lo = Color3.fromRGB(16, 8, 40),
			Smoke = Color3.fromRGB(30, 22, 52),
		},
		Tintable = { Mid = 0.6, Lo = 0.3 },
		Assets = {
			Core = "void_orb",
			CoreMesh = "void_shard",
			Particle = "rift_tear",
			Mote = "star_mote",
			Trail = "shard_trail",
			Beam = "shard_trail",
			Wave = "warp_implode",
			Ground = "portal_rings",
			Impact = "warp_implode",
			Smoke = "smoke_billow",
			Sigil = "portal_rings",
			Scatter = "void_shard",
			Debris = { "void_shard" },
		},
		Feel = { Light = 0.2, Rise = 0, Framerate = 16, Spin = 1.5, Scroll = 3, CoreMeshSize = 0.45, ScatterSize = 0.7,
			PathGlyphs=true,FieldMode="Void",VoidAll=true },
	},
	Time = {
		Palette = {
			Hi = Color3.fromRGB(255, 244, 210),
			Mid = Color3.fromRGB(226, 182, 92),
			Lo = Color3.fromRGB(96, 64, 26),
			Smoke = Color3.fromRGB(150, 128, 92),
		},
		Tintable = { Mid = 0.6, Lo = 0.5 },
		Assets = {
			Core = "time_ripple",
			Flow = "gear_mote",
			CoreMesh = "chrono_gear",
			Particle = "sand_trail",
			Mote = "gear_mote",
			Trail = "sand_trail",
			Beam = "sand_trail",
			Wave = "time_ripple",
			Ground = "clock_dial",
			Impact = "time_ripple",
			Smoke = "dust_burst",
			Sigil = "clock_dial",
			Scatter = "hourglass",
			Aura = "time_ripple",
		},
		Feel = { Light = 0.2, Rise = -1, Framerate = 12, Spin = 0.5, Scroll = 1, CoreMeshSize = 0.4, ScatterSize = 0.7,
			StreamBeam=true,StreamSpeed=3,StreamLength=4,StreamEndWidth=1,BeamClocks=true },
	},
}

-- Builds a full signature from a kit, then lets hand-authored layers (same Slot, owning Roles)
-- replace template layers for the roles they cover.
function Kits.build(name, bespoke)
	local kit = table.clone(Kits.Definitions[name])
	kit.Name = name
	local palette = table.clone(kit.Palette)
	palette.Ink = INK
	local layers = templates(kit)
	local owned = (bespoke and bespoke.Owns) or {}
	if bespoke then
		local kept = {}
		for _, t in ipairs(layers) do
			local roles = t.Roles
			local overlapped = false
			if roles then
				for role in pairs(roles) do
					if owned[role] then
						overlapped = true
					end
				end
			elseif owned.Cast and (t.Slot == "Charge" or t.Slot == "Cast") then
				overlapped = true
			end
			if not overlapped then
				table.insert(kept, t)
			end
		end
		-- Role-less authored layers (wisps, embers, dissipation) belong to the roles the author owns,
		-- except slot-wide ones (Charge/Cast/Dissipate) which replace the template's role-less layers.
		local authoredSlots = {}
		for _, t in ipairs(bespoke.Layers) do
			if not t.Roles then
				authoredSlots[t.Slot] = true
			end
		end
		layers = {}
		for _, t in ipairs(kept) do
			if t.Roles or not authoredSlots[t.Slot] then
				table.insert(layers, t)
			end
		end
		for _, t in ipairs(bespoke.Layers) do
			local copy = table.clone(t)
			-- A connected fluid body replaces legacy spinning core sprites at its source.
			if kit.Feel.StreamBeam and copy.Roles and copy.Roles.Beam then
				copy.Roles=table.clone(copy.Roles);copy.Roles.Beam=nil
			end
			if not copy.Roles and copy.Slot ~= "Charge" and copy.Slot ~= "Cast" and copy.Slot ~= "Dissipate" then
				copy.Roles = table.clone(owned)
			end
			table.insert(layers, copy)
		end
		for token, color in pairs(bespoke.Palette or {}) do
			palette[token] = color
		end
	end
	if kit.Feel.VoidAll or kit.Feel.GustAll then
		local roles=if kit.Feel.VoidAll then {Projectile="Core",Wave="Core",Aura="Shell",SelfEnhancement="Shell",Construct="Ambient",Manipulation="Ambient",Impact="Impact"}
			else {Projectile="Core",Aura="Shell",SelfEnhancement="Shell"}
		local kept={}
		for _,t in layers do
			local replace=false
			for role in roles do if t.Roles and t.Roles[role] then replace=true end end
			if kit.Feel.VoidAll and (t.Slot=="Dissipate" or t.Slot=="Charge") then replace=true end
			if not replace then table.insert(kept,t) end
		end
		layers=kept
		for role,slot in roles do
			table.insert(layers,layer({Id=name.."."..role..".DynamicMotif",Slot=slot,Kind="Dynamics",Priority=1,
				Roles={[role]=true},Colors={"Hi","Mid"},Params={Mode=if kit.Feel.VoidAll then "Void" else "Gusts",Ground=false}}))
		end
		if kit.Feel.VoidAll then
			table.insert(layers,layer({Id=name..".Charge.GroundPortal",Slot="Charge",Kind="Dynamics",Priority=1,
				Roles={Cast=true},Colors={"Hi","Mid"},Params={Mode="Void",Ground=true}}))
		end
	end
	if kit.Feel.NoSpin then
		for _,t in layers do
			t.Params=table.clone(t.Params);t.Params.RotSpeed=0;t.Params.RandomRotation=0;t.Params.Spin=0
			if t.Kind=="Emitter" or t.Kind=="Burst" then t.Params.Orientation="VelocityParallel" end
		end
	end
	local tintable = table.clone(kit.Tintable)
	table.insert(layers,layer({Id=name..".Cast.ReleaseCue",Slot="Cast",Kind="Light",Priority=1,
		Roles={Cast=true},Colors="Mid",Params={Brightness=.65,Range=4,Flash=.12,OffsetZ=-1.3,OffsetY=.5}}))
	for token, amount in pairs((bespoke and bespoke.Tintable) or {}) do
		tintable[token] = amount
	end
	local all = { Form = true, Element = true, Mechanic = true, Detail = true }
	return {
		Name = name,
		Palette = palette,
		Tintable = tintable,
		Layers = layers,
		-- Kits cover every role, so the procedural composer's layers are fully replaced; it still
		-- renders whenever a signature session cannot be created (budget, disabled).
		Replaces = { Default = all },
	}
end

-- Selection, by data only: element first, then the expression or principle for elementless
-- schools, then Arcane for everything else (Neutral, Unawakened).
Kits.Match = {
	Element = {
		Fire = "Fire",
		Ice = "Ice",
		Lightning = "Lightning",
		Water = "Water",
		Earth = "Earth",
		Wind = "Wind",
		Poison = "Poison",
	},
	Expression = {
		Force = "Force",
		BodyEnhancement = "Body",
		Spirit = "Spirit",
		SpatialFold = "Space",
		TemporalShift = "Time",
	},
	Principle = { Body = "Body", Soul = "Spirit", Space = "Space", Time = "Time" },
	Fallback = "Arcane",
}

return Kits
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="304">
            <Properties>
              <string name="Name">SignatureLibrary</string>
              <string name="Source"><![CDATA[-- Pure data: reusable form components, effect-layer slots and per-principle visual signatures.
-- A signature is chosen from the spell's Element or Source.Principle (never its name or id) and
-- supplies layer recipes per slot. Components decide which slots a gameplay form/phase uses, so a
-- new visual identity is a new table here, not a new service. Layers reference assets by name
-- from Assets/VFXAssetManifest; nothing in this file creates instances.
--
-- Layer fields
--   Id, Slot, Kind, Priority (1 = gameplay-critical, kept at every quality; 3 = detail)
--   Texture / Mesh / Meshes   manifest asset names
--   Colors                    palette tokens, sampled over particle life (or one token)
--   Params                    base numbers (see SignatureRenderer for meaning per Kind)
--   Drivers                   { Param, Scalar, Weight }: value = base + weight * scalar (scalars 0..1)
--   Limits                    { Param = { min, max } } applied after drivers
--   Forms                     optional allowlist of gameplay forms (plan.Form) for this layer
--   Roles                     optional allowlist of anchor roles (Projectile, Wave, Impact, Cast...)
local Library = {}

-- Slots, in build order. Lower slots win budget contention.
Library.Slots = { "Core", "Shell", "Trail", "Impact", "Charge", "Cast", "Secondary", "Ambient", "Dissipate" }

-- Form components: which slots a form instantiates for each anchor phase. "Cast" is the casting
-- cue anchored to the caster; "Impact" is the per-hit anchor.
Library.Components = {
	Projectile = { Sustain = { "Core", "Shell", "Secondary", "Trail", "Ambient" }, End = { "Dissipate" } },
	Beam = { Sustain = { "Core", "Secondary", "Ambient" }, End = { "Dissipate" } },
	Wave = {
		Release = { "Core", "Shell", "Secondary", "Impact", "Ambient" },
		Sustain = { "Core", "Shell", "Secondary", "Impact", "Ambient" },
		End = { "Dissipate" },
	},
	Field = { Sustain = { "Secondary", "Ambient" }, End = { "Dissipate" } },
	Aura = { Sustain = { "Shell", "Ambient" }, End = { "Dissipate" } },
	Construct = { Sustain = { "Ambient" }, End = { "Dissipate" } },
	SelfEnhancement = { Sustain = { "Shell", "Ambient" }, End = { "Dissipate" } },
	Manipulation = { Sustain = { "Ambient" }, End = { "Dissipate" } },
	Cast = { Gather = { "Charge" }, Release = { "Cast" } },
	Impact = { Impact = { "Impact", "Dissipate" } },
}

-- Quality presets. Priority-1 layers survive every preset so spells stay recognizable.
Library.Quality = {
	High = { MaxPriority = 3, Rate = 1, Count = 1, Lights = true, Meshes = true },
	Medium = { MaxPriority = 2, Rate = 0.65, Count = 0.7, Lights = true, Meshes = true },
	Low = { MaxPriority = 1, Rate = 0.4, Count = 0.45, Lights = false, Meshes = false },
}

-- Client-wide caps for signature layers (independent of the procedural composer's own caps).
Library.Budget = {
	MaxSessions = 24,
	MaxEmitters = 72,
	MaxContinuousRate = 420,
	MaxMeshes = 72,
	MaxLights = 10,
	MaxTrails = 24,
	MaxBurstPerSecond = 900,
	MaxEmitterRate = 60,
	MaxBurstCount = 48,
}

-- Cel look controls, applied at runtime (no asset re-upload needed).
--   Saturation / Value  multiply every palette colour's saturation and brightness (Ink excluded)
--   LightInfluence      how much scene lighting dims particles, trails and beams (0 = flat, unlit)
--   Brightness          particle brightness multiplier
--   InkScale            extra growth of `_ink` outline hulls beyond their authored thickness
Library.Style = {
	Saturation = 1.35,
	Value = 1.15,
	LightInfluence = 0.1,
	Brightness = 1.35,
	InkScale = 0.06,
}

local function layer(t)
	t.Params = t.Params or {}
	t.Drivers = t.Drivers or {}
	t.Limits = t.Limits or {}
	return t
end

-- ===================================================================================== Fire
Library.Signatures = {}

Library.Signatures.Fire = {
	Name = "Fire",
	-- Complete painted projectile body. Other roles retain their existing recipes.
	ProjectileLayers = {
		layer({
			Id = "Fire.Core.Painted",
			Slot = "Core",
			Kind = "DirectionalSprite",
			Priority = 1,
			DirectionalAsset = "PaintedFire",
			Params = { Size = 4.2, Opacity = 1 },
		}),
		layer({
			Id = "Fire.Ambient.PaintedLight",
			Slot = "Ambient",
			Kind = "Light",
			Priority = 2,
			Colors = "Body",
			Params = { Brightness = 1.3, Range = 10 },
			Drivers = { { "Brightness", "Potency", 1 }, { "Range", "Size", 6 } },
		}),
	},
	-- Composer layers this signature visually supersedes, per role ("Form", "Element",
	-- "Mechanic", "Detail" = composer priorities 1-4). Roles it fully covers drop the procedural
	-- accents too: their Neon shards read as the old look, and trails/streaks carry the motion.
	Replaces = {
		Projectile = { Form = true, Element = true, Mechanic = true, Detail = true },
		Cast = { Form = true, Element = true, Mechanic = true, Detail = true },
		Impact = { Form = true, Element = true, Mechanic = true, Detail = true },
		Default = { Detail = true },
	},
	Palette = {
		WhiteHot = Color3.fromRGB(255, 244, 214),
		Hot = Color3.fromRGB(255, 196, 92),
		Body = Color3.fromRGB(255, 108, 28),
		Deep = Color3.fromRGB(150, 28, 8),
		Ember = Color3.fromRGB(255, 150, 60),
		Soot = Color3.fromRGB(34, 26, 24),
		Ash = Color3.fromRGB(70, 62, 58),
	},
	-- Player colors tint these tokens (by this much) and leave the white-hot core alone.
	Tintable = { Body = 0.6, Deep = 0.5, Ember = 0.35 },
	Layers = {
		-- Charge: a forming ignition point fed by converging sparks.
		layer({
			Id = "Fire.Charge.Converge",
			Slot = "Charge",
			Kind = "Emitter",
			Priority = 2,
			Texture = "ember_streak",
			Colors = { "Hot", "Body" },
			Params = {
				Rate = 10,
				Lifetime = 0.35,
				Speed = 9,
				Size = 0.35,
				SizeEnd = 0.05,
				Direction = "In",
				ShapeRadius = 3.2,
				Orientation = "VelocityParallel",
				Light = 1,
				Ramp = 1,
				OffsetZ = -1.6,
				OffsetY = 0.5,
			},
			Drivers = { { "Rate", "Charge", 22 }, { "ShapeRadius", "Charge", 1.5 } },
		}),
		layer({
			Id = "Fire.Charge.Point",
			Slot = "Charge",
			Kind = "Sprite",
			Priority = 1,
			Texture = "core_plasma",
			Colors = { "WhiteHot", "Body" },
			Params = { Size = 0.5, Grow = 1.2, Framerate = 22, Light = 1, Ramp = 1, OffsetZ = -1.6, OffsetY = 0.5 },
			Drivers = { { "Grow", "Charge", 1.0 }, { "Grow", "Size", 0.6 } },
		}),
		layer({
			Id = "Fire.Charge.Sigil",
			Slot = "Charge",
			Kind = "Mesh",
			Priority = 2,
			Mesh = "sigil_ring",
			Colors = "Body",
			Params = {
				Size = 3.4,
				Spin = 0.9,
				Opacity = 0.55,
				Orient = "Ground",
				Material = "Neon",
				Ramp = 1,
				RequireAsset = 1,
			},
			Drivers = { { "Spin", "Charge", 1.4 }, { "Size", "Potency", 0.8 } },
		}),
		layer({
			Id = "Fire.Charge.Light",
			Slot = "Charge",
			Kind = "Light",
			Priority = 3,
			Colors = "Body",
			Params = { Brightness = 1.2, Range = 7, Ramp = 1, OffsetZ = -1.6, OffsetY = 0.5 },
			Drivers = { { "Brightness", "Charge", 1.2 } },
		}),
		-- Cast: ignition at the hand, a short forward lick of flame and sparks.
		layer({
			Id = "Fire.Cast.Flash",
			Slot = "Cast",
			Kind = "Burst",
			Priority = 1,
			Texture = "glow_soft",
			Colors = { "WhiteHot", "Body" },
			Params = {
				Count = 1,
				Lifetime = 0.16,
				Speed = 0,
				Size = 2.2,
				SizeEnd = 3.2,
				Light = 1,
				OffsetZ = -1.8,
				OffsetY = 0.5,
			},
			Drivers = { { "Size", "Potency", 1.2 } },
		}),
		layer({
			Id = "Fire.Cast.Ignite",
			Slot = "Cast",
			Kind = "Burst",
			Priority = 2,
			Texture = "flame_tongue",
			Colors = { "Hot", "Body", "Deep" },
			Params = {
				Count = 5,
				Lifetime = 0.32,
				Speed = 7,
				Spread = 28,
				Direction = "Forward",
				Size = 1.4,
				SizeEnd = 0.3,
				Framerate = 40,
				Light = 0.8,
				OffsetZ = -1.8,
				OffsetY = 0.5,
			},
			Drivers = { { "Count", "Potency", 4 } },
		}),
		layer({
			Id = "Fire.Cast.Sparks",
			Slot = "Cast",
			Kind = "Burst",
			Priority = 3,
			Texture = "ember_streak",
			Colors = { "WhiteHot", "Ember" },
			Params = {
				Count = 8,
				Lifetime = 0.4,
				Speed = 16,
				Spread = 35,
				Direction = "Forward",
				Size = 0.3,
				SizeEnd = 0.05,
				Drag = 3,
				Orientation = "VelocityParallel",
				Light = 1,
				OffsetZ = -1.8,
				OffsetY = 0.5,
			},
		}),
		-- Core: a turbulent plasma heart inside a solid, twisting core body.
		layer({
			Id = "Fire.Core.Heart",
			Roles = { Projectile = true, Beam = true },
			Slot = "Core",
			Kind = "Sprite",
			Priority = 1,
			Texture = "core_plasma",
			Colors = { "WhiteHot", "Hot" },
			Params = { Size = 1.25, Framerate = 22, RotSpeed = 90, Light = 1 },
			Drivers = { { "Framerate", "Potency", 18 }, { "RotSpeed", "Potency", 160 } },
		}),
		layer({
			Id = "Fire.Core.Body",
			Roles = { Projectile = true },
			Slot = "Core",
			Kind = "Mesh",
			Priority = 2,
			Mesh = "fire_core",
			Colors = "Hot",
			Params = {
				Size = 0.5,
				Spin = 2.2,
				Wobble = 0.08,
				Opacity = 0.9,
				Material = "Neon",
				Orient = "Travel",
				RequireAsset = 1,
			},
			Drivers = { { "Spin", "Potency", 3.5 }, { "Wobble", "Potency", 0.22 } },
		}),
		-- Shell: swept flame tongues around the core; speed stretches them backwards.
		layer({
