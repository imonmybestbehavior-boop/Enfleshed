    </Item>
  </Item>
  <Item class="SoundService" referent="392">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="393">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="394">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="395">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local launcher = require(script.Controllers.GrimoireLauncher).start()
local camera = require(script.Controllers.CameraController).start()
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Protocol = require(Shared:WaitForChild("Networking"):WaitForChild("Protocol"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local remotes = Shared:WaitForChild(Protocol.Folder)
local request = remotes:WaitForChild(Protocol.Request) :: RemoteEvent
local feedback = remotes:WaitForChild(Protocol.Feedback) :: RemoteEvent
local aerialControl = remotes:WaitForChild(Protocol.AerialControl) :: RemoteEvent
local studioSandbox = game:GetService("RunService"):IsStudio()
	and require(Shared.Configuration.DevelopmentSandbox).Enabled
local sequence = 0

local function send(action: string, extra: Types.ActionOptions?): number
	sequence += 1
	local character = player.Character
	if not character or (not studioSandbox and not player:GetAttribute("CharacterReady")) then
		return 0 -- Nothing was sent, so callers must not wait for a reply.
	end
	local payload: Types.ActionRequest = {
		Action = action,
		Sequence = sequence,
		Character = character,
		Sprinting = if extra then extra.Sprinting else nil,
		Direction = if extra then extra.Direction else nil,
		SpellId = if extra then extra.SpellId else nil,
		AimDirection = if extra then extra.AimDirection else nil,
		WorldPoint = if extra then extra.WorldPoint else nil,
		TargetModel = if extra then extra.TargetModel else nil,
		TargetInstance = if extra then extra.TargetInstance else nil,
		CastOrigin = if extra then extra.CastOrigin else nil,
		EquipmentSlot = if extra then extra.EquipmentSlot else nil,
		EquipmentAction = if extra then extra.EquipmentAction else nil,
		SummonMode = if extra then extra.SummonMode else nil,
		SummonId = if extra then extra.SummonId else nil,
	}
	request:FireServer(payload)
	return sequence
end

local function startController(name: string, ...: any): ...any
	local ok, result = pcall(function(...)
		local controller = require(script.Controllers:WaitForChild(name))
		return controller.start(...)
	end, ...)
	if not ok then
		warn(string.format("Enfleshed client controller %s failed to start: %s", name, tostring(result)))
		if name == "MagicController" then
			launcher:SetError(tostring(result))
		end
		return nil
	end
	return result
end

local hud = startController("UIController", launcher)
local debug = startController("DebugController")
startController("MagicRevealController")
startController("SpellVFXController", remotes)
startController("SpellVFXShowcase")
startController("LanternController")
local aerial = startController("MagicAerialController", aerialControl)
local movement = startController("MovementController", send)
local inventory = startController("InventoryController")
if hud and inventory then
	hud.BindInventory(inventory)
end
local combat =
	startController("CombatController", send, movement, debug, hud, if inventory then inventory.MeleeLoadout else nil)
local magic = startController(
	"MagicController",
	send,
	if camera
		then camera.GetAim
		else function()
			return Vector3.zAxis, Vector3.zero, nil, nil
		end,
	launcher
)
local equipment = if combat and magic
	then startController("EquipmentController", send, combat, magic.WeaponAction)
	else nil
local generated = if magic then startController("GeneratedSpellController", magic, debug) else nil
local selectedSummonId: number? = nil
local function cycleSummonSelection()
	local summons = workspace:FindFirstChild("MagicSummons")
	local owned = {}
	if summons then
		for _, model in summons:GetChildren() do
			local summonId = model:GetAttribute("MagicSummonId")
			if
				model:IsA("Model")
				and model:GetAttribute("MagicSummonOwnerUserId") == player.UserId
				and type(summonId) == "number"
			then
				table.insert(owned, { Model = model, Id = summonId })
			end
		end
	end
	table.sort(owned, function(first, second)
		return first.Id < second.Id
	end)
	if #owned == 0 then
		selectedSummonId = nil
	else
		local nextIndex = 1
		for index, summon in owned do
			if summon.Id == selectedSummonId then
				nextIndex = index % #owned + 1
				break
			end
		end
		selectedSummonId = owned[nextIndex].Id
	end
	player:SetAttribute("MagicSelectedSummonId", selectedSummonId)
end

local function summonCommand(mode: string)
	local _, point, target = if camera then camera.GetAim() else Vector3.zAxis, Vector3.zero, nil
	send(Protocol.SummonCommand, {
		SummonMode = mode,
		TargetModel = if mode == "Attack" then target else nil,
		WorldPoint = if mode == "Move" or mode == "Patrol" then point else nil,
		SummonId = if mode == "Dismiss" then nil else selectedSummonId,
	})
end

local summonCommands = startController("SummonCommandController", summonCommand, cycleSummonSelection)
if movement and combat and magic and equipment and generated then
	startController(
		"InputController",
		movement.Sprint,
		function()
			if combat.CanDash() then
				movement.Dash()
			end
		end,
		magic.Cast,
		magic.Release,
		equipment.Use,
		equipment.Switch,
		generated.Cycle,
		generated.Begin,
		generated.Release,
		cycleSummonSelection,
		summonCommand
	)
else
	warn("Enfleshed input is disabled because a required combat or magic controller did not start")
end

local function reset()
	selectedSummonId = nil
	player:SetAttribute("MagicSelectedSummonId", nil)
	if movement then
		movement.Reset()
	end
	if aerial then
		aerial.Reset()
	end
	if combat then
		combat.Reset()
	end
	if magic then
		magic.Reset()
	end
	if equipment then
		equipment.Reset()
	end
end
player.CharacterRemoving:Connect(reset)
local deathConnection: RBXScriptConnection? = nil
local function characterAdded(character: Model)
	reset()
	if deathConnection then
		deathConnection:Disconnect()
		deathConnection = nil
	end
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") and player.Character == character then
		deathConnection = humanoid.Died:Connect(reset)
	end
end
player.CharacterAdded:Connect(characterAdded)
if player.Character then
	task.spawn(characterAdded, player.Character)
end
feedback.OnClientEvent:Connect(function(message)
	if message.Kind == "Equipment" then
		if equipment then
			equipment.Feedback(message)
		end
	elseif message.Kind == "ImpactNumber" then
		local target = if typeof(message.Target) == "Instance" and message.Target:IsA("Model")
			then message.Target
			else nil
		if typeof(message.Amount) == "number" and typeof(message.Effect) == "string" then
			if debug then
				debug.Number(message.Effect, message.Amount, target)
			end
		end
	elseif message.Kind == "Magic" then
		if debug then
			debug.Magic(message)
		end
	elseif message.Kind == "SummonCommand" then
		if debug then
			debug.SummonCommand(message)
		end
		if summonCommands then
			summonCommands.Feedback(message)
		end
	elseif
		message.Kind == "Swing"
		or message.Kind == "Guard"
		or (player.Character ~= nil and message.Character == player.Character)
	then
		if movement then
			movement.Feedback(message)
		end
		if combat then
			combat.Feedback(message)
		end
	end
end)
]]></string>
        </Properties>
        <Item class="Folder" referent="396">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="397">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict

-- A compact Scriptable third-person camera. It owns gameplay mouse look but can
-- release the cursor for a future UI without that UI depending on camera internals.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Configuration.Sandbox).Camera
local studioSandbox = game:GetService("RunService"):IsStudio()
	and require(game:GetService("ReplicatedStorage").Shared.Configuration.DevelopmentSandbox).Enabled
local Camera = {}

function Camera.start()
	local player = Players.LocalPlayer
	local enabled = true
	local yaw = 0
	local pitch = Config.InitialPitch
	local gui = Instance.new("ScreenGui")
	gui.Name = "SandboxCrosshair"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 120
	gui.Parent = player:WaitForChild("PlayerGui")
	local crosshair = Instance.new("Frame")
	crosshair.Name = "Center"
	crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
	crosshair.Position = UDim2.fromScale(0.5, 0.5)
	crosshair.Size = UDim2.fromOffset(0, 0)
	crosshair.BackgroundTransparency = 1
	crosshair.Parent = gui
	for _, line in
		{
			{
				UDim2.fromOffset(Config.Crosshair.Thickness, Config.Crosshair.Size),
				UDim2.fromOffset(0, -Config.Crosshair.Gap),
			},
			{
				UDim2.fromOffset(Config.Crosshair.Thickness, Config.Crosshair.Size),
				UDim2.fromOffset(0, Config.Crosshair.Gap),
			},
			{
				UDim2.fromOffset(Config.Crosshair.Size, Config.Crosshair.Thickness),
				UDim2.fromOffset(-Config.Crosshair.Gap, 0),
			},
			{
				UDim2.fromOffset(Config.Crosshair.Size, Config.Crosshair.Thickness),
				UDim2.fromOffset(Config.Crosshair.Gap, 0),
			},
		}
	do
		local part = Instance.new("Frame")
		part.AnchorPoint = Vector2.new(0.5, 0.5)
		part.Size = line[1]
		part.Position = UDim2.fromScale(0.5, 0.5) + line[2]
		part.BackgroundColor3 = Color3.fromRGB(255, 239, 198)
		part.BackgroundTransparency = math.min(Config.Crosshair.Transparency, 0.05)
		part.BorderSizePixel = 0
		part.ZIndex = 10
		part.Parent = crosshair
	end

	-- ALT toggles a free cursor during gameplay; aim stays on the crosshair.
	local hint = Instance.new("TextLabel")
	hint.Name = "CursorHint"
	hint.AnchorPoint = Vector2.new(0.5, 0)
	hint.Position = UDim2.new(0.5, 0, 0.5, 26)
	hint.Size = UDim2.fromOffset(220, 18)
	hint.BackgroundTransparency = 1
	hint.Font = Enum.Font.GothamBold
	hint.TextSize = 12
	hint.TextColor3 = Color3.fromRGB(255, 239, 198)
	hint.TextStrokeTransparency = 0.4
	hint.Text = "ALT · LOCK AIM"
	hint.Visible = false
	hint.Parent = gui
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
			player:SetAttribute("CursorFreed", player:GetAttribute("CursorFreed") ~= true)
		end
	end)

	local mouseLocked: boolean? = nil
	local function setMouseLocked(value: boolean)
		local grimoireOpen = player:GetAttribute("MagicLabOpen") == true
		local missionCursor = player:GetAttribute("UIModalOpen") == true
		value = value and not missionCursor
		local desiredBehavior = if value then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
		local desiredIconEnabled = not value and (missionCursor or not grimoireOpen)
		-- Only repair properties when another UI (for example, the Escape menu)
		-- has changed them. This keeps gameplay mouse state stable without
		-- rewriting it every frame, while the grimoire can own its custom cursor.
		if mouseLocked == value then
			if UserInputService.MouseBehavior ~= desiredBehavior then
				UserInputService.MouseBehavior = desiredBehavior
			end
			if UserInputService.MouseIconEnabled ~= desiredIconEnabled then
				UserInputService.MouseIconEnabled = desiredIconEnabled
			end
			return
		end
		mouseLocked = value
		UserInputService.MouseBehavior = desiredBehavior
		UserInputService.MouseIconEnabled = desiredIconEnabled
		-- Keep the aim reticle visible while the editor releases the mouse. The
		-- crosshair marks the viewport-center aim ray in both states.
		gui.Enabled = true
	end

	local function getRoot(): BasePart?
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		return if root and root:IsA("BasePart") then root else nil
	end

	local function getAim(): (Vector3, Vector3, Model?, Instance?)
		local camera = Workspace.CurrentCamera
		if not camera then
			return Vector3.zAxis, Vector3.zero, nil, nil
		end
		local viewport = camera.ViewportSize
		local centerRay = camera:ViewportPointToRay(viewport.X * 0.5, viewport.Y * 0.5)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character or Workspace }
		params.RespectCanCollide = true
		local direction = centerRay.Direction.Unit
		local hit = Workspace:Raycast(centerRay.Origin, direction * Config.AimDistance, params)
		local target: Model? = nil
		local targetParams = RaycastParams.new()
		targetParams.FilterType = Enum.RaycastFilterType.Exclude
		targetParams.FilterDescendantsInstances = { player.Character or Workspace }
		targetParams.RespectCanCollide = false
		local targetHit = Workspace:Raycast(centerRay.Origin, direction * Config.AimDistance, targetParams)
		if targetHit then
			local model = targetHit.Instance:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then
				target = model
			end
		end
		return direction,
			if hit then hit.Position else centerRay.Origin + direction * Config.AimDistance,
			target,
			if targetHit then targetHit.Instance else nil
	end

	function Camera:SetGameplayMouseLookEnabled(value: boolean)
		enabled = value
		setMouseLocked(
			value
				and player:GetAttribute("MagicLabOpen") ~= true
				and (studioSandbox or player:GetAttribute("CharacterReady") == true)
		)
	end

	RunService:BindToRenderStep("SandboxThirdPersonCamera", Enum.RenderPriority.Camera.Value, function()
		local camera = Workspace.CurrentCamera
		local root = getRoot()
		if not camera or not root then
			return
		end
		camera.CameraType = Enum.CameraType.Scriptable
		local playing = enabled
			and (studioSandbox or player:GetAttribute("CharacterReady") == true)
			and not player:GetAttribute("MagicLabOpen")
			and not player:GetAttribute("InventoryOpen")
			and not player:GetAttribute("UIModalOpen")
		hint.Visible = playing and player:GetAttribute("CursorFreed") == true
		setMouseLocked(playing and player:GetAttribute("CursorFreed") ~= true)
		local character = player.Character
		local rotationLocked = character and character:GetAttribute("MagicRotationLocked") == true
		local delta = if playing and not rotationLocked then UserInputService:GetMouseDelta() else Vector2.zero
		yaw -= delta.X * Config.MouseSensitivity
		pitch = math.clamp(pitch - delta.Y * Config.MouseSensitivity, Config.MinimumPitch, Config.MaximumPitch)
		local target = root.Position + Vector3.new(0, Config.Height, 0)
		local rotation = CFrame.fromOrientation(pitch, yaw, 0)
		local desired = target - rotation.LookVector * Config.Distance + rotation.RightVector * Config.ShoulderOffset
		local offset = desired - target
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character }
		params.RespectCanCollide = true
		local obstruction = Workspace:Raycast(target, offset, params)
		local position = desired
		if obstruction then
			position = target + offset.Unit * math.max(0, obstruction.Distance - Config.ObstructionPadding)
		end
		camera.CFrame = CFrame.lookAt(position, target)
		camera.Focus = CFrame.new(target)
	end)

	UserInputService.TextBoxFocused:Connect(function()
		Camera:SetGameplayMouseLookEnabled(false)
	end)
	UserInputService.TextBoxFocusReleased:Connect(function()
		Camera:SetGameplayMouseLookEnabled(true)
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		Camera:SetGameplayMouseLookEnabled(false)
	end)
	UserInputService.WindowFocused:Connect(function()
		Camera:SetGameplayMouseLookEnabled(true)
	end)
	GuiService.MenuOpened:Connect(function()
		Camera:SetGameplayMouseLookEnabled(false)
	end)
	GuiService.MenuClosed:Connect(function()
		Camera:SetGameplayMouseLookEnabled(true)
	end)

	setMouseLocked(studioSandbox or player:GetAttribute("CharacterReady") == true)
	return {
		GetAim = getAim,
		SetGameplayMouseLookEnabled = function(value: boolean)
			Camera:SetGameplayMouseLookEnabled(value)
		end,
	}
end

return Camera
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="398">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local MeleeConfig = require(Shared:WaitForChild("Configuration"):WaitForChild("MeleeProfiles"))
local Protocol = require(Shared:WaitForChild("Networking"):WaitForChild("Protocol"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local Movement = require(script.Parent.MovementController)
local Debug = require(script.Parent.DebugController)
local Combat = {}
local Feel = MeleeConfig.Feel

local function swing(character: Model, size: Vector3, offset: number, duration: number, heavy: boolean)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local part = Instance.new("Part")
	part.Name = "SwingPreview"
	part.Size = size
	part.CFrame = root.CFrame * CFrame.new(0, 0, -offset)
	part.Anchored = false
	part.Massless = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = Enum.Material.Neon
	part.Color = if heavy then Color3.fromRGB(255, 140, 90) else Color3.fromRGB(240, 195, 135)
	part.Transparency = Config.Debug.SwingTransparency
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
	part.Parent = workspace
	Debris:AddItem(part, duration)
end

local function guardFlash(character: Model, parry: boolean)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local part = Instance.new("Part")
	part.Name = "GuardFlash"
	part.Shape = Enum.PartType.Ball
	part.Size = if parry then Vector3.new(6, 6, 6) else Vector3.new(4, 4, 4)
	part.CFrame = root.CFrame * CFrame.new(0, 0.5, -1.5)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = Enum.Material.ForceField
	part.Color = if parry then Color3.fromRGB(255, 210, 90) else Color3.fromRGB(200, 220, 255)
	part.Parent = workspace
	Debris:AddItem(part, if parry then 0.35 else 0.18)
end

local function playSound(model: Model, soundId: string?)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not soundId or soundId == "" or not root or not root:IsA("BasePart") then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = 0.6
	sound.PlaybackSpeed = 0.95 + math.random() * 0.1 -- Slight variation so repeated hits don't sound identical.
	sound.Parent = root
	sound:Play()
	Debris:AddItem(sound, 3)
end

-- Brief white flash on whatever was hit.
local function flashTarget(target: Model)
	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.35
	highlight.OutlineTransparency = 1
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = target
	Debris:AddItem(highlight, Feel.HitFlash)
end

local frozenUntil = 0
-- Hitstop: freezes the attacker's playing animations for a moment so a hit feels solid.
local function hitstop(character: Model, duration: number)
	local now = os.clock()
	if now < frozenUntil then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = if humanoid then humanoid:FindFirstChildOfClass("Animator") else nil
	if not animator then
		return
	end
	frozenUntil = now + duration
	for _, track in animator:GetPlayingAnimationTracks() do
		local speed = track.Speed
		track:AdjustSpeed(0)
		task.delay(duration, function()
			if track.IsPlaying then
				track:AdjustSpeed(speed)
			end
		end)
	end
end

local loadedTracks: { [Animator]: { [string]: AnimationTrack } } = setmetatable({}, { __mode = "k" }) :: any
-- Plays the weapon's swing animation if one is configured in MeleeProfiles.Feel.Animations.
local function playSwingAnimation(character: Model, weapon: any, heavy: boolean, combo: number)
	local set = Feel.Animations[weapon.Archetype or ""]
	local animationId = if not set then nil elseif heavy then set.Heavy else set.Lights and set.Lights[combo]
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = if humanoid then humanoid:FindFirstChildOfClass("Animator") else nil
	if type(animationId) ~= "string" or not animator then
		return
	end
	local tracks = loadedTracks[animator]
	if not tracks then
		tracks = {}
		loadedTracks[animator] = tracks
	end
	local track = tracks[animationId]
	if not track then
		local animation = Instance.new("Animation")
		animation.AnimationId = animationId
		track = animator:LoadAnimation(animation)
		track.Priority = Enum.AnimationPriority.Action
		tracks[animationId] = track
	end
	track:Play(0.05)
end

-- The flat direction the character faces right now, sent so the server swings where the player saw.
local function facing(character: Model): Vector3?
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	return if flat.Magnitude > 0.001 then flat.Unit else nil
end

function Combat.start(
	send: (string, Types.ActionOptions?) -> number,
	movement: Movement.Controller,
	debug: Debug.Controller,
	hud: any?,
	loadout: (() -> any?)?
)
	local player = Players.LocalPlayer
	local combo = 0
	local readyAt = 0
	local activeUntil = 0 -- End of the current swing's hit; recovery after it can be cancelled by blocking.
	local expires = 0
	local pending = 0
	local pendingSince = 0
	local bufferedUntil = 0
	local blocking = false
	local wantBlock = false -- Block is held, even if the guard couldn't go up yet.
	local blockRetryAt = 0
	local blockSequence = 0

	local function currentLoadout(): any?
		return if loadout then loadout() else nil
	end

	local function canAct(): (Model?, any?)
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		if not character or not humanoid or humanoid.Health <= 0 or movement.IsDashing() or blocking then
			return nil, nil
		end
		local weapon = currentLoadout()
		return if weapon then character else nil, weapon
	end

	local function commit(character: Model, weapon: any, definition: any, heavy: boolean, now: number)
		activeUntil = now + definition.Startup + definition.Active
		readyAt = activeUntil + definition.Recovery
		bufferedUntil = 0
		swing(character, definition.Size, definition.Offset, definition.Startup + definition.Active, heavy)
		playSound(character, if heavy then Feel.HeavySwingSound else Feel.SwingSound)
		playSwingAnimation(character, weapon, heavy, combo)
		pending = send(if heavy then Protocol.Heavy else Protocol.Light, { Direction = facing(character) })
		pendingSince = now
	end

	local function attack()
		local character, weapon = canAct()
		if not character or not weapon then
			return
		end
		local now = workspace:GetServerTimeNow()
		if now < readyAt or pending ~= 0 then
			if readyAt - now <= Config.Combat.InputBuffer then
				bufferedUntil = now + Config.Combat.InputBuffer
			end
			return
		end
		combo = if now > expires or combo < 1 then 1 else combo % #weapon.Lights + 1
		local definition = weapon.Lights[combo]
		commit(character, weapon, definition, false, now)
		expires = readyAt + Config.Combat.ComboReset
	end

	local function heavy()
		local character, weapon = canAct()
		if not character or not weapon then
			return
		end
		local now = workspace:GetServerTimeNow()
		if now < readyAt or pending ~= 0 then
			return
		end
		combo = 0
		expires = 0
		commit(character, weapon, weapon.Heavy, true, now)
	end

	local function raiseGuard()
		local now = workspace:GetServerTimeNow()
		if
			blocking
			or not player.Character
			or not currentLoadout()
			or movement.IsDashing()
			or now < activeUntil
			or now < blockRetryAt
		then
			return
		end
		blocking = true
		bufferedUntil = 0
		-- Raising a guard cancels the rest of the swing's recovery and ends the light chain.
		readyAt = math.min(readyAt, now)
		combo = 0
		expires = 0
		blockSequence = send(Protocol.BlockStart, nil)
		if blockSequence == 0 then
			-- Not sent (the character isn't ready yet); try again while block is held.
			blocking = false
			blockRetryAt = now + 0.05
		end
	end

	local function block(active: boolean)
		wantBlock = active
		if active then
			raiseGuard()
		elseif blocking then
			blocking = false
			-- Mirrors the server's short recovery so the next click is buffered, not rejected.
			readyAt = math.max(readyAt, workspace:GetServerTimeNow() + Config.Combat.BlockReleaseRecovery)
			send(Protocol.BlockEnd, nil)
		end
	end

	RunService.RenderStepped:Connect(function()
		local now = workspace:GetServerTimeNow()
		if pending ~= 0 and now - pendingSince > Config.Combat.PendingTimeout then
			pending = 0 -- The server never answered; stop waiting so melee and dash don't lock up.
		end
		if wantBlock and not blocking then
			raiseGuard()
		end
		if bufferedUntil >= now and pending == 0 and now >= readyAt then
			attack()
		end
		debug.Update(if now > expires then 0 else combo, movement.GetCooldown())
		if hud then
			hud.UpdateCombat(if now > expires then 0 else combo, movement.GetCooldown())
		end
	end)

	return {
		Attack = attack,
		Heavy = heavy,
		Block = block,
		IsBlocking = function(): boolean
			return blocking
		end,
		CanDash = function(): boolean
			return pending == 0 and workspace:GetServerTimeNow() >= readyAt
		end,
		Reset = function()
			combo = 0
			readyAt = 0
			activeUntil = 0
			expires = 0
			pending = 0
			bufferedUntil = 0
			blocking = false
			wantBlock = false
			blockRetryAt = 0
			blockSequence = 0
			debug.Reset()
			if hud then
				hud.Reset()
			end
		end,
		Feedback = function(message: any)
			if message.Kind == "Swing" then
				if
					typeof(message.Character) == "Instance"
					and message.Character:IsA("Model")
					and message.Character ~= player.Character
					and typeof(message.Size) == "Vector3"
					and type(message.Offset) == "number"
					and type(message.Duration) == "number"
				then
					swing(message.Character, message.Size, message.Offset, message.Duration, message.Heavy == true)
					playSound(
						message.Character,
						if message.Heavy == true then Feel.HeavySwingSound else Feel.SwingSound
					)
				end
			elseif message.Kind == "Guard" then
				if typeof(message.Character) == "Instance" and message.Character:IsA("Model") then
					guardFlash(message.Character, message.Result == "Parry")
				end
			elseif message.Kind == "Hit" then
				local target = if typeof(message.Target) == "Instance" and message.Target:IsA("Model")
					then message.Target
					else nil
				debug.Hit(message.Damage, target)
				if target then
					flashTarget(target)
					playSound(target, Feel.HitSound)
				end
				local character = player.Character
				if character then
					hitstop(character, if message.Heavy == true then Feel.HeavyHitstop else Feel.Hitstop)
				end
			elseif message.Kind == "Correction" then
				bufferedUntil = 0
			elseif message.Kind == "Action" then
				if
					(message.Action == Protocol.Light or message.Action == Protocol.Heavy)
					and message.Sequence == pending
				then
					pending = 0
					combo = message.Combo
					-- A guard raised while this reply was in flight already cancelled the recovery.
					readyAt = if blocking then math.min(readyAt, message.ReadyAt) else message.ReadyAt
					expires = if combo > 0 then readyAt + Config.Combat.ComboReset else 0
					if not message.Accepted then
						activeUntil = 0
						bufferedUntil = 0
					end
				elseif
					message.Action == Protocol.BlockStart
					and message.Sequence == blockSequence
					and not message.Accepted
					and blocking
				then
					-- The server still had the swing active; try again shortly while block is held.
					blocking = false
					blockRetryAt = workspace:GetServerTimeNow() + 0.05
				end
			end
		end,
	}
end

return Combat
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="399">
            <Properties>
              <string name="Name">DebugController</string>
              <string name="Source"><![CDATA[--!strict

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Configuration.Sandbox)
local Debug = {}

function Debug.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "SandboxDebug"
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui.Enabled = game:GetService("RunService"):IsStudio() and Config.StressTest.Enabled
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromOffset(760, 216)
	label.Position = UDim2.fromOffset(12, 12)
	label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	label.BackgroundTransparency = 0.25
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextSize = 17
	label.Font = Enum.Font.Code
	label.Parent = gui
	local hitUntil = 0
	local hitText = ""
	local stress: Instance? = nil
	local magicText = ""
	local magicUntil = 0
	local summonText = ""
	local summonUntil = 0
	local generatedText = ""
	local function waveText(): string
		if not Config.StressTest.Enabled then
			return ""
		end
		if not stress or not stress.Parent then
			stress = workspace:FindFirstChild("SandboxStressTest")
		end
		if not stress then
			return "Stress test starting..."
		end
		local phase = stress:GetAttribute("Status")
		if phase == "Complete" then
			return "Stress test complete | Living 0"
		end
		if phase == "Blocked" then
			return "Waiting for a clear enemy spawn area"
		end
		local wave = stress:GetAttribute("Wave") or 0
		local total = stress:GetAttribute("TotalWaves") or 0
		local living = stress:GetAttribute("LivingEnemies") or 0
		if phase == "Waiting" then
			local seconds =
				math.max(0, math.ceil((stress:GetAttribute("NextWaveAt") or 0) - workspace:GetServerTimeNow()))
			return string.format("Wave %d/%d | Living %d | Next in %ds", wave, total, living, seconds)
		end
		return string.format("Wave %d/%d | Living %d", wave, total, living)
	end
	local function locusTestText(): string
		return "Locus stats fixed for unrestricted testing"
	end
	local function companionSpellText(): string
		local summons = workspace:FindFirstChild("MagicSummons")
		if not summons then
			return ""
		end
		local owned = {}
		for _, model in summons:GetChildren() do
			if model:IsA("Model") and model:GetAttribute("MagicSummonOwnerUserId") == Players.LocalPlayer.UserId then
				table.insert(owned, {
					Id = model:GetAttribute("MagicSummonId") or 0,
					Slot = model:GetAttribute("MagicSummonSpellSlot") or 0,
					Status = model:GetAttribute("MagicSummonSpellStatus") or "SEARCHING",
					Reason = model:GetAttribute("MagicSummonSpellReason") or "",
					Target = model:GetAttribute("MagicSummonSpellTarget") or "",
				})
			end
		end
		if #owned == 0 then
			return ""
		end
		local selectedId = Players.LocalPlayer:GetAttribute("MagicSelectedSummonId")
		table.sort(owned, function(first, second)
			if (first.Id == selectedId) ~= (second.Id == selectedId) then
				return first.Id == selectedId
			end
			return first.Id < second.Id
		end)
		local rows = {}
		for index = 1, math.min(#owned, 3) do
			local companion = owned[index]
			local detail = if companion.Target ~= "" then " → " .. companion.Target else ""
			if companion.Reason ~= "" then
				detail ..= " · " .. companion.Reason
			end
			table.insert(
				rows,
				string.format(
					"%s#%s slot %s: %s%s",
					if companion.Id == selectedId then "▶ " else "",
					companion.Id,
					companion.Slot,
					companion.Status,
					detail
				)
			)
		end
		return "Companion spells | " .. table.concat(rows, "   |   ")
	end
	local numberSequence = 0
	local function showNumber(kind: string, amount: number, target: Model?)
		if not target or not target:IsDescendantOf(workspace) or amount <= 0 then
			return
		end
		local anchor = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
		if not anchor or not anchor:IsA("BasePart") then
			return
		end
		numberSequence += 1
		local number = Instance.new("BillboardGui")
		number.Name = "SandboxCombatNumber" .. numberSequence
		number.Adornee = anchor
		number.Size = UDim2.fromOffset(150, 36)
		number.StudsOffset = Vector3.new((numberSequence % 3 - 1) * 0.4, 3.5, 0)
		number.AlwaysOnTop = true
		number.MaxDistance = 140
		number.Parent = target
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.GothamBold
		text.TextSize = 25
		text.TextStrokeTransparency = 0.15
		text.TextTransparency = 0
		text.Text = if kind == "Damage"
			then string.format("-%g", amount)
			elseif kind == "Transformation" then string.format("×%.2f SIZE", amount)
			elseif kind == "TimeDilation" then string.format("×%.2f TIME", amount)
			elseif kind == "Displacement" then string.format("%g STUDS", amount)
			elseif kind == "Shield" then string.format("+%g SHIELD", amount)
			elseif kind == "Control" then string.format("%g CONTROL", amount)
			else string.format("+%g", amount)
		text.TextColor3 = if kind == "Heal"
			then Color3.fromRGB(111, 255, 153)
			elseif kind == "Transformation" then Color3.fromRGB(232, 174, 255)
			elseif kind == "TimeDilation" then Color3.fromRGB(176, 155, 255)
			elseif kind == "Displacement" then Color3.fromRGB(212, 180, 255)
			elseif kind == "Shield" then Color3.fromRGB(112, 222, 255)
			elseif kind == "Control" then Color3.fromRGB(206, 146, 255)
			elseif kind == "Damage" then Color3.fromRGB(255, 119, 96)
			else Color3.fromRGB(255, 240, 140)
		text.Parent = number
		TweenService:Create(number, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			StudsOffset = number.StudsOffset + Vector3.new(0, 1.15, 0),
		}):Play()
		TweenService
			:Create(text, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0.15), {
				TextTransparency = 1,
				TextStrokeTransparency = 1,
			})
			:Play()
		Debris:AddItem(number, 1.1)
	end
	return {
		Hit = function(damage: number, target: Model?)
			local name = if target then (target:GetAttribute("SandboxLabel") or target.Name) else "Target"
			hitText = string.format("HIT %s  -%g HP", name, damage)
			hitUntil = os.clock() + Config.Debug.HitDuration
			if not target or not target:IsDescendantOf(workspace) then
				return
			end
			-- The highlight is local; floating numbers arrive through replicated server feedback.
			for _, effectName in { "SandboxConfirmedHit" } do
				local previous = target:FindFirstChild(effectName)
				if previous then
					previous:Destroy()
				end
			end
			local flash = Instance.new("Highlight")
			flash.Name = "SandboxConfirmedHit"
			flash.Adornee = target
			flash.FillTransparency = 0.6
			flash.FillColor = Color3.fromRGB(255, 255, 255)
			flash.OutlineColor = Color3.fromRGB(255, 255, 255)
			flash.OutlineTransparency = 0
			flash.DepthMode = Enum.HighlightDepthMode.Occluded
			flash.Parent = target
			Debris:AddItem(flash, Config.Debug.TargetFlashDuration)
		end,
		Reset = function()
			hitUntil = 0
		end,
		Magic = function(message: any)
			magicText = string.format(
				"Magic %s %s | mana %s/%s (cost %s) | strain %s/%s | complexity %s/%s%s%s%s",
				tostring(message.Name or ""),
				tostring(message.Result or ""),
				tostring(message.Mana or "-"),
				tostring(message.Capacity or "-"),
				tostring(message.ManaDemand or "-"),
				tostring(message.Strain or "-"),
				tostring(message.StrainTolerance or "-"),
				tostring(message.Complexity or "-"),
				tostring(message.ComplexityCapacity or "-"),
				if message.Damage then " | damage " .. tostring(message.Damage) else "",
				if message.Reason then " | " .. tostring(message.Reason) else "",
				if message.Effect
					then " | " .. tostring(message.Effect) .. " " .. tostring(message.Amount or "")
					else ""
			)
			magicUntil = os.clock() + 2.5
		end,
		SummonCommand = function(message: any)
			summonText = if message.Accepted
				then "Summons: " .. tostring(message.Reason or message.Mode or "Order set")
				else "Summons: " .. tostring(message.Reason or "Command rejected")
			summonUntil = os.clock() + 3
		end,
		Number = showNumber,
		Generated = function(text: string)
			generatedText = text
		end,
		Update = function(combo: number, cooldown: number)
			label.Text = string.format(
				"Combo %d/3  |  Dash %.1fs\n%s\n%s\n%s\n%s\n%s\n%s\n%s\nV2: 4 Lance | 5 Ground | 6 Reinforcement | 7 Raise\nSummons: N Select | Z Follow | X Protect | C Attack | B Move | J Patrol | H Hold | G Support | V Dismiss",
				combo,
				cooldown,
				if os.clock() < hitUntil then hitText else "",
				if os.clock() < magicUntil then magicText else "",
				if os.clock() < summonUntil then summonText else "",
				companionSpellText(),
				generatedText,
				waveText(),
				locusTestText()
			)
		end,
	}
end

export type Controller = typeof(Debug.start())
return Debug
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="400">
            <Properties>
              <string name="Name">EquipmentController</string>
              <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Protocol = require(Shared.Networking.Protocol)
local Types = require(Shared.Types.CombatTypes)
local Equipment = {}

-- Melee: primary fires a light attack on press (the chain length depends on the weapon),
-- the heavy key fires a heavy, and holding secondary blocks (its opening is the parry window).
function Equipment.start(send: (string, Types.ActionOptions?) -> number, combat: any, magicAction: (string) -> ())
	local player = game:GetService("Players").LocalPlayer
	local activeSlot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
	player:GetAttributeChangedSignal("ActiveEquipmentSlot"):Connect(function()
		activeSlot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
	end)

	local function releaseAll()
		combat.Block(false)
	end

	return {
		Use = function(action: string, phase: string?)
			local began = phase ~= "End"
			if activeSlot == "SecondaryWeapon" then
				if action == "Primary" and began then
					combat.Attack()
				elseif action == "Heavy" and began then
					combat.Heavy()
				elseif action == "Area" then
					combat.Block(began)
				end
			elseif activeSlot == "PrimaryWeapon" and began and action ~= "Heavy" then
				magicAction(action)
			end
		end,
		Switch = function()
			releaseAll()
			local slot = if activeSlot == "PrimaryWeapon" then "SecondaryWeapon" else "PrimaryWeapon"
			send(Protocol.EquipmentSwitch, { EquipmentSlot = slot })
		end,
		Feedback = function(message: any)
			if
				message.Kind == "Equipment"
				and (message.ActiveSlot == "PrimaryWeapon" or message.ActiveSlot == "SecondaryWeapon")
			then
				if message.ActiveSlot ~= activeSlot then
					releaseAll()
				end
				activeSlot = message.ActiveSlot
			end
		end,
		Reset = function()
			activeSlot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
		end,
	}
end

return Equipment
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="401">
            <Properties>
              <string name="Name">GeneratedSpellController</string>
              <string name="Source"><![CDATA[--!strict

-- Development-only keyboard harness for the controlled generated registry.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.Sandbox).DevelopmentSpellStress
local Generated = require(Shared.Configuration.GeneratedSpellStress)
local GeneratedController = {}

function GeneratedController.start(magic: any, debug: any)
	local selected = 1
	local function announce()
		if not Config.Enabled or #Generated.Order == 0 then
			return
		end
		local id = Generated.Order[selected]
		debug.Generated(string.format("Generated %d/%d | %s", selected, #Generated.Order, Generated.Descriptions[id]))
	end
	announce()
	return {
		Cycle = function()
			if not Config.Enabled or #Generated.Order == 0 then
				return
			end
			selected = selected % #Generated.Order + 1
			announce()
		end,
		Begin = function()
			if not Config.Enabled or #Generated.Order == 0 then
				return
			end
			local id = Generated.Order[selected]
			local mode = Generated.Definitions[id].Casting.Mode
			magic.Cast(id, mode == "Charged" or mode == "HoldAndRelease")
		end,
		Release = function()
			magic.Release()
		end,
	}
end

return GeneratedController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="402">
            <Properties>
              <string name="Name">GrimoireConditionTreeEditor</string>
              <string name="Source"><![CDATA[--!strict
-- Grimoire editor section for condition trees (spell and step conditions).
-- Extracted from MagicLabController (Phase 1.7). The Grimoire passes its form
-- widgets in `ctx`; this module only lays them out and edits `holder[key]`.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ConditionSpec = require(Shared.Modules.MagicConditionSpec)
local ConditionTree = require(Shared.Modules.MagicConditionTree)
local Theme = require(script.Parent.Parent.UI.SpellForgeTheme).Book
local ConditionTreeEditor = {}

export type Widgets = {
	button: any,
	card: any,
	estimate: any,
	info: any,
	numeric: any,
	rebuild: any,
	row: any,
	select: any,
	toggle: any,
}

function ConditionTreeEditor.render(ctx: Widgets, holder: any, key: string, label: string?)
	local button, card, estimate, info, numeric, rebuild, row, select, toggle =
		ctx.button, ctx.card, ctx.estimate, ctx.info, ctx.numeric, ctx.rebuild, ctx.row, ctx.select, ctx.toggle
	local propertyChoices = {}
	for family, properties in ConditionSpec.Properties do
		for property in properties do
			table.insert(propertyChoices, family .. "." .. property)
		end
	end
	table.sort(propertyChoices)
	local function replaceNode(parent, index, replacement)
		local ok, root = ConditionTree.replace(holder[key], parent, index, replacement)
		if ok and not parent then
			holder[key] = root
		end
	end
	local function defaultFor(descriptor)
		return if descriptor.Kind == "Boolean" then true elseif descriptor.Kind == "Number" then descriptor.Min else ""
	end
	local function renderNode(node, parent, index, depth)
		local path = (if label then label .. " · " else "")
			.. (if parent then "Nested " .. tostring(index) else "Root")
		if ConditionTree.isGroup(node) then
			if node.Operator == "NOT" then
				info(path .. " group · NOT (the child result must fail)", 34)
				local unwrapRow = row("Remove NOT wrapper")
				button(unwrapRow, "UNWRAP", function()
					replaceNode(parent, index, ConditionTree.unwrapNot(node))
					rebuild()
					estimate()
				end)
			else
				select("Group logic · " .. path, node.Operator, { "ALL", "ANY" }, function(value)
					node.Operator = value
				end, function(value)
					return if value == "ALL" then "Require all children" else "Allow any child"
				end, "ALL requires every child. ANY passes when at least one child passes.")
				card(
					"Invert group · " .. path,
					"Wrap this group in NOT.",
					false,
					function()
						local wrapped = ConditionTree.wrapNot(node)
						if wrapped then
							replaceNode(parent, index, wrapped)
						end
					end,
					depth + ConditionTree.maxDepth(node) <= ConditionSpec.MaxDepth
						and ConditionTree.countNodes(holder[key]) < ConditionSpec.MaxNodes
				)
			end
			for childIndex, child in ipairs(node.Conditions or {}) do
				renderNode(child, node, childIndex, depth + 1)
			end
			if node.Operator ~= "NOT" then
				local nodeCount = ConditionTree.countNodes(holder[key])
				local canAddRule = #node.Conditions < ConditionSpec.MaxChildren
					and nodeCount + 1 <= ConditionSpec.MaxNodes
					and depth < ConditionSpec.MaxDepth
				local canAddGroup = #node.Conditions < ConditionSpec.MaxChildren
					and nodeCount + 2 <= ConditionSpec.MaxNodes
					and depth + 1 < ConditionSpec.MaxDepth
				card("Add rule · " .. path, "Add one explicitly exposed server value.", false, function()
					ConditionTree.addRule(node, ConditionSpec.MaxChildren, ConditionSpec.MaxNodes, holder[key])
				end, canAddRule, "This group, depth, or tree has reached its safe limit.")
				card(
					"Add nested ALL group · " .. path,
					"Create a subgroup whose every rule must pass.",
					false,
					function()
						ConditionTree.addGroup(
							node,
							"ALL",
							ConditionSpec.MaxChildren,
							ConditionSpec.MaxNodes,
							holder[key]
						)
					end,
					canAddGroup,
					"This group, depth, or tree has reached its safe limit."
				)
				card(
					"Add nested ANY group · " .. path,
					"Create a subgroup where any one rule may pass.",
					false,
					function()
						ConditionTree.addGroup(
							node,
							"ANY",
							ConditionSpec.MaxChildren,
							ConditionSpec.MaxNodes,
							holder[key]
						)
					end,
					canAddGroup,
					"This group, depth, or tree has reached its safe limit."
				)
			end
			if parent and parent.Operator ~= "NOT" then
				card("Remove group · " .. path, "Remove this nested condition and its children.", false, function()
					ConditionTree.remove(parent, index)
				end, #parent.Conditions > 1, "Condition groups must keep at least one child.")
			end
			return
		end

		local descriptor = ConditionSpec.Properties[node.Family]
			and ConditionSpec.Properties[node.Family][node.Property]
		if not descriptor then
			info(path .. " has an unsupported saved rule; remove it and add a valid one.", 42)
			if parent and parent.Operator ~= "NOT" then
				local removeInvalidRow = row("Remove invalid rule · " .. path)
				button(removeInvalidRow, "REMOVE", function()
					ConditionTree.remove(parent, index)
					rebuild()
				end)
			end
			return
		end
		info("Rule · " .. path, 26)
		select("Runtime property · " .. path, node.Family .. "." .. node.Property, propertyChoices, function(value)
			local family, property = string.match(value, "^([^%.]+)%.(.+)$")
			local nextDescriptor = ConditionSpec.Properties[family][property]
			node.Family, node.Property = family, property
			node.Operator = nextDescriptor.Operators[1]
			node.Value = defaultFor(nextDescriptor)
		end, nil, "Only whitelisted server-resolved values are available.")
		select("Comparison · " .. path, node.Operator, descriptor.Operators, function(value)
			node.Operator = value
		end)
		if descriptor.Kind == "Number" then
			numeric("Number value · " .. path, node, "Value", "Compare against this bounded runtime value.")
		elseif descriptor.Kind == "Boolean" then
			toggle("Value is true · " .. path, node.Value, function(value)
				node.Value = value
			end)
		else
			local valueRow = row("Text value · " .. path)
			local box = Instance.new("TextBox")
			box.Size = UDim2.new(0.4, 0, 1, 0)
			box.Position = UDim2.new(0.59, 0, 0, 0)
			box.BackgroundColor3 = Theme.Surface
			box.TextColor3 = Theme.Ink
			box.BorderColor3, box.BorderSizePixel = Theme.Border, 1
			box.TextSize = 14
			box.ClearTextOnFocus = false
			box.Text = tostring(node.Value or "")
			box.Parent = valueRow
			box.FocusLost:Connect(function()
				node.Value = string.sub(box.Text, 1, descriptor.MaxLength)
				estimate()
			end)
		end
		if parent and parent.Operator ~= "NOT" then
			card("Remove rule · " .. path, "Remove this condition rule.", false, function()
				ConditionTree.remove(parent, index)
			end, #parent.Conditions > 1, "Condition groups must keep at least one child.")
		end
		if depth < ConditionSpec.MaxDepth then
			local canWrap = depth + 1 <= ConditionSpec.MaxDepth
				and ConditionTree.countNodes(holder[key]) < ConditionSpec.MaxNodes
			card("Invert rule · " .. path, "Wrap this rule in NOT.", false, function()
				local wrapped = ConditionTree.wrapNot(node)
				if wrapped then
					replaceNode(parent, index, wrapped)
				end
			end, canWrap)
			card("Nest rule in ALL · " .. path, "Place this rule inside a new ALL group.", false, function()
				local nested = ConditionTree.newGroup("ALL")
				if nested then
					nested.Conditions[1] = node
					replaceNode(parent, index, nested)
				end
			end, canWrap)
		end
	end
	renderNode(holder[key], nil, nil, 1)
end

return ConditionTreeEditor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="403">
            <Properties>
              <string name="Name">GrimoireGeometryPreview</string>
              <string name="Source"><![CDATA[--!strict
-- Debug geometry for the Grimoire: draws a spell's aim, range, area and construct
-- shapes in the world while "debug geometry" is on. Extracted from
-- MagicLabController (Phase 1.7); pure drawing, no Grimoire state.
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Geometry = require(Shared.Modules.MagicGeometry)
local ConstructGeometrySpec = require(Shared.Modules.MagicConstructGeometrySpec)
local GeometryPreview = {}

-- Draws into `drawFolder` (already cleared by the caller) for `draft` cast by `player`.
function GeometryPreview.draw(
	drawFolder: Folder,
	player: Player,
	draft: any,
	direction: Vector3,
	point: Vector3?,
	target: any
)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local function anchor(name, position)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = Vector3.one * 0.05
		part.CFrame = CFrame.new(position)
		part.Anchored = true
		part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
		part.Transparency = 1
		part.Parent = drawFolder
		Debris:AddItem(part, 1.5)
		return part
	end
	local function sphere(name, center, radius, color, transparency)
		if radius <= 0 then
			return
		end
		local adornee = anchor(name .. "Anchor", center)
		local adornment = Instance.new("SphereHandleAdornment")
		adornment.Name = name
		adornment.Adornee = adornee
		adornment.Radius = radius
		adornment.Color3 = color
		adornment.Transparency = transparency
		adornment.AlwaysOnTop = false
		adornment.ZIndex = 1
		adornment.Parent = adornee
	end
	local function areaShape(name, center, shape, area, color)
		if shape == "Sphere" then
			sphere(name, center, area.Radius, color, 0.72)
			return
		end
		if shape == "Capsule" then
			local radius = area.Radius
			local stemHeight = math.max(area.Height - radius * 2, 0.05)
			local function capsulePart(partName, partShape, size, cframe)
				local part = Instance.new("Part")
				part.Name = partName
				part.Shape = partShape
				part.Size = size
				part.CFrame = cframe
				part.Anchored = true
				part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
				part.Material, part.Color, part.Transparency = Enum.Material.Neon, color, 0.78
				part.Parent = drawFolder
				Debris:AddItem(part, 1.5)
			end
			local frame = CFrame.new(center) * CFrame.Angles(0, math.rad(area.Yaw or 0), 0)
			capsulePart(
				name .. "CapsuleBody",
				Enum.PartType.Cylinder,
				Vector3.new(stemHeight, radius * 2, radius * 2),
				frame * CFrame.Angles(0, 0, math.rad(90))
			)
			for _, sign in { -1, 1 } do
				capsulePart(
					name .. "CapsuleCap",
					Enum.PartType.Ball,
					Vector3.one * radius * 2,
					frame * CFrame.new(0, sign * stemHeight / 2, 0)
				)
			end
			return
		end
		if shape == "Ring" then
			local anchor = Instance.new("Part")
			anchor.Name = name .. "RingAnchor"
			anchor.Size = Vector3.one * 0.1
			anchor.CFrame = CFrame.new(center)
			anchor.Anchored = true
			anchor.Transparency = 1
			anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = false, false, false
			anchor.Parent = drawFolder
			local function edge(first: Vector3, second: Vector3)
				local a, b = Instance.new("Attachment"), Instance.new("Attachment")
				a.Position, b.Position = first, second
				a.Parent, b.Parent = anchor, anchor
				local beam = Instance.new("Beam")
				beam.Name = name .. "RingBoundary"
				beam.Attachment0, beam.Attachment1 = a, b
				beam.Color = ColorSequence.new(color)
				beam.Transparency = NumberSequence.new(0.2)
				beam.Width0, beam.Width1 = 0.06, 0.06
				beam.FaceCamera = false
				beam.Parent = anchor
			end
			local function circle(radius: number, y: number)
				local segments = 24
				for index = 0, segments - 1 do
					local firstAngle = index / segments * math.pi * 2
					local secondAngle = (index + 1) / segments * math.pi * 2
					edge(
						Vector3.new(math.cos(firstAngle) * radius, y, math.sin(firstAngle) * radius),
						Vector3.new(math.cos(secondAngle) * radius, y, math.sin(secondAngle) * radius)
					)
				end
			end
			local halfHeight = area.Height / 2
			for _, y in { -halfHeight, halfHeight } do
				circle(area.InnerRadius, y)
				circle(area.OuterRadius, y)
			end
			for _, angle in { 0, math.pi / 2, math.pi, math.pi * 1.5 } do
				local x, z = math.cos(angle), math.sin(angle)
				for _, y in { -halfHeight, halfHeight } do
					edge(
						Vector3.new(x * area.InnerRadius, y, z * area.InnerRadius),
						Vector3.new(x * area.OuterRadius, y, z * area.OuterRadius)
					)
				end
				edge(
					Vector3.new(x * area.InnerRadius, -halfHeight, z * area.InnerRadius),
					Vector3.new(x * area.InnerRadius, halfHeight, z * area.InnerRadius)
				)
				edge(
					Vector3.new(x * area.OuterRadius, -halfHeight, z * area.OuterRadius),
					Vector3.new(x * area.OuterRadius, halfHeight, z * area.OuterRadius)
				)
			end
			Debris:AddItem(anchor, 1.5)
			return
		end
		if shape == "Cone" then
			local frame = CFrame.new(center) * CFrame.Angles(0, math.rad(area.Yaw or 0), 0)
			local anchor = Instance.new("Part")
			anchor.Name = name .. "ConeAnchor"
			anchor.Size = Vector3.one * 0.1
			anchor.CFrame = frame
			anchor.Anchored = true
			anchor.Transparency = 1
			anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = false, false, false
			anchor.Parent = drawFolder
			local halfHeight = area.Height / 2
			local halfWidth = area.Range * math.tan(math.rad(area.Angle / 2))
			local function edge(first: Vector3, second: Vector3)
				local a, b = Instance.new("Attachment"), Instance.new("Attachment")
				a.Position, b.Position = first, second
				a.Parent, b.Parent = anchor, anchor
				local beam = Instance.new("Beam")
				beam.Name = name .. "ConeEdge"
				beam.Attachment0, beam.Attachment1 = a, b
				beam.Color = ColorSequence.new(color)
				beam.Transparency = NumberSequence.new(0.2)
				beam.Width0, beam.Width1 = 0.06, 0.06
				beam.FaceCamera = false
				beam.Parent = anchor
			end
			for _, y in { -halfHeight, halfHeight } do
				local apex = Vector3.new(0, y, 0)
				local left = Vector3.new(-halfWidth, y, -area.Range)
				local right = Vector3.new(halfWidth, y, -area.Range)
				edge(apex, left)
				edge(apex, right)
				edge(left, right)
			end
			edge(Vector3.new(0, -halfHeight, 0), Vector3.new(0, halfHeight, 0))
			edge(Vector3.new(-halfWidth, -halfHeight, -area.Range), Vector3.new(-halfWidth, halfHeight, -area.Range))
			edge(Vector3.new(halfWidth, -halfHeight, -area.Range), Vector3.new(halfWidth, halfHeight, -area.Range))
			Debris:AddItem(anchor, 1.5)
			return
		end
		local size = Geometry.areaSize(shape, area)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = if shape == "Cylinder" then Vector3.new(size.Y, size.X, size.Z) else size
		part.CFrame = CFrame.new(center)
			* CFrame.Angles(0, math.rad(area.Yaw or 0), 0)
			* (if shape == "Line" then CFrame.new(0, 0, -area.Range / 2) else CFrame.identity)
			* (if shape == "Cylinder" then CFrame.Angles(0, 0, math.rad(90)) else CFrame.identity)
		part.Shape = if shape == "Cylinder" then Enum.PartType.Cylinder else Enum.PartType.Block
		part.Anchored = true
		part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
		part.Material, part.Color, part.Transparency = Enum.Material.Neon, color, 0.82
		part.Parent = drawFolder
		Debris:AddItem(part, 1.5)
	end
	local function beamBetween(first, second, name)
		local a = Instance.new("Attachment")
		a.Parent = first
		local b = Instance.new("Attachment")
		b.Parent = second
		local beam = Instance.new("Beam")
		beam.Name = name
		beam.Attachment0, beam.Attachment1 = a, b
		beam.Width0, beam.Width1 = 0.08, 0.08
		beam.Color = ColorSequence.new(draft.Visual.Color)
		beam.Transparency = NumberSequence.new(0.2)
		beam.LightEmission = 0.55
		beam.FaceCamera = true
		beam.Parent = drawFolder
		Debris:AddItem(beam, 1.5)
	end
	local castOrigin = root.Position + Vector3.new(0, 1.5, 0)
	local targetRoot = if target and target:IsA("Model") then target:FindFirstChild("HumanoidRootPart") else nil
	local previewPoint = if targetRoot and targetRoot:IsA("BasePart") then targetRoot.Position else point
	local unitDirection = if direction.Magnitude > 0.001 then direction.Unit else root.CFrame.LookVector
	local aimFrame = CFrame.lookAt(castOrigin, castOrigin + unitDirection)
	if draft.Projectile then
		local position = castOrigin + unitDirection * 3
		-- The green sphere is the server hit radius; the colored core is appearance-only.
		sphere("ProjectileCollisionRadius", position, draft.Projectile.Radius, Color3.fromRGB(105, 230, 185), 0.45)
		local shape = draft.Visual.CoreShape or "Sphere"
		local appearanceScale = draft.Visual.ProjectileScale or 1
		local radius = draft.Projectile.Radius * appearanceScale
		local appearance = Instance.new(if shape == "Wedge" then "WedgePart" else "Part")
		appearance.Name = "ProjectileAppearance"
		if appearance:IsA("Part") then
			appearance.Shape =
				Enum.PartType[if shape == "Sphere" then "Ball" elseif shape == "Crystal" then "Block" else shape]
		end
		appearance.Size = Vector3.one * radius * 2
		appearance.CFrame = CFrame.new(position)
			* (if shape == "Crystal" then CFrame.Angles(math.rad(45), math.rad(45), math.rad(45)) else CFrame.identity)
		appearance.Anchored = true
		appearance.CanCollide, appearance.CanTouch, appearance.CanQuery = false, false, false
		appearance.Material = visualMaterial(draft)
		appearance.Color = draft.Visual.Color
		appearance.Transparency = 1 - (draft.Visual.Opacity or 0.85)
		appearance.Parent = drawFolder
		Debris:AddItem(appearance, 1.5)
	elseif draft.Beam then
		local maximumScale = math.max(draft.Beam.GrowthStartScale or 1, draft.Beam.GrowthEndScale or 1)
		local range = math.min(draft.Beam.Range * maximumScale, draft.TargetRules.Range)
		local width = math.max(0.12, draft.Beam.Width * maximumScale)
		local part = Instance.new("Part")
		part.Name = "BeamHitVolumePreview"
		part.Size = Vector3.new(width, width, range)
		part.CFrame = CFrame.lookAt(castOrigin + unitDirection * range / 2, castOrigin + unitDirection * range)
		part.Anchored = true
		part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
		part.Material = visualMaterial(draft)
		part.Color = draft.Visual.Color
		part.Transparency = 1 - (draft.Visual.Opacity or 0.85)
		part.Parent = drawFolder
		Debris:AddItem(part, 1.5)
	elseif draft.Field then
		areaShape("FieldHitVolume", previewPoint, draft.Geometry, draft.Field, draft.Visual.Color)
	elseif draft.Aura then
		local center = if draft.Targeting == "EntityTarget" or draft.Targeting == "ObjectTarget"
			then previewPoint
			else root.Position
		areaShape("AuraHitVolume", center, draft.Geometry, draft.Aura, draft.Visual.Color)
	elseif draft.Wave then
		local maximumScale = math.max(draft.Wave.GrowthStartScale or 1, draft.Wave.GrowthEndScale or 1)
		local previewRange = draft.Wave.Range * maximumScale
		if draft.Geometry == "Sphere" then
			sphere("WaveSphere", root.Position, previewRange, draft.Visual.Color, 0.82)
		else
			local count = 10
			local halfAngle = math.acos(math.clamp(draft.Wave.Dot, -1, 1))
			local ring = {}
			local originAnchor = anchor("WaveConeOrigin", castOrigin)
			local originAttachment = Instance.new("Attachment")
			originAttachment.Parent = originAnchor
			for index = 1, count do
				local angle = (index - 1) / count * math.pi * 2
				local radial = aimFrame.RightVector * math.cos(angle) + aimFrame.UpVector * math.sin(angle)
				local edgeDirection = unitDirection * math.cos(halfAngle) + radial * math.sin(halfAngle)
				local edgeAnchor = anchor("WaveConeEdge", castOrigin + edgeDirection * previewRange)
				local edgeAttachment = Instance.new("Attachment")
				edgeAttachment.Parent = edgeAnchor
				local spoke = Instance.new("Beam")
				spoke.Name = "WaveConeBoundary"
				spoke.Attachment0, spoke.Attachment1 = originAttachment, edgeAttachment
				spoke.Width0, spoke.Width1 = 0.08, 0.08
				spoke.Color = ColorSequence.new(draft.Visual.Color)
				spoke.Transparency = NumberSequence.new(0.2)
				spoke.FaceCamera = true
				spoke.Parent = drawFolder
				Debris:AddItem(spoke, 1.5)
				ring[index] = edgeAnchor
			end
			for index = 1, count do
				beamBetween(ring[index], ring[index % count + 1], "WaveConeRim")
			end
		end
	elseif draft.Construct then
		local center = if draft.Targeting == "WorldPoint"
			then point
			else castOrigin + unitDirection * draft.Construct.Distance
		local flatDirection = Vector3.new(unitDirection.X, 0, unitDirection.Z)
		if flatDirection.Magnitude < 0.001 then
			flatDirection = Vector3.new(0, 0, -1)
		end
		local frame = CFrame.lookAt(center, center + flatDirection.Unit)
		local components = ConstructGeometrySpec.components(
			draft.Geometry,
			draft.Construct.Width,
			draft.Construct.Height,
			draft.Construct.Depth,
			draft.Construct.Components
		)
		local previewScale = if draft.Construct.GrowthDuration and draft.Construct.GrowthDuration > 0
			then draft.Construct.GrowthStartScale or 1
			else 1
		for index, component in ipairs(components or {}) do
			local part = Instance.new(if component.Shape == "Wedge" then "WedgePart" else "Part")
			part.Name = string.format("ConstructGeometryPreview%02d", index)
			part.Size = Vector3.new(component.Size[1], component.Size[2], component.Size[3]) * previewScale
			if part:IsA("Part") then
				part.Shape = Enum.PartType[component.Shape]
			end
			local rotation = component.RotationDegrees
			part.CFrame = frame
				* CFrame.new(
					component.Offset[1] * previewScale,
					component.Offset[2] * previewScale,
					component.Offset[3] * previewScale
				)
				* CFrame.Angles(math.rad(rotation[1]), math.rad(rotation[2]), math.rad(rotation[3]))
			part.Anchored = true
			part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
			part.Material, part.Color, part.Transparency = Enum.Material.Neon, draft.Visual.Color, 0.84
			part.Parent = drawFolder
			Debris:AddItem(part, 1.5)
		end
	end
	for triggerEvent, steps in pairs(draft.Triggers or {}) do
		for _, step in ipairs(steps or {}) do
			if step.Behavior == "Explode" then
				local explosionCenter = if triggerEvent == "OnCast" and draft.Form == "Wave"
					then root.Position
					else previewPoint
				sphere(
					"ExplosionRadiusAt" .. triggerEvent,
					explosionCenter,
					step.Radius,
					Color3.fromRGB(255, 167, 89),
					0.78
				)
			end
		end
	end
	if draft.TargetRules then
		sphere("TargetingRange", root.Position, draft.TargetRules.Range, Color3.fromRGB(255, 221, 105), 0.94)
	end
end

return GeometryPreview
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="404">
            <Properties>
              <string name="Name">GrimoireLauncher</string>
              <string name="Source"><![CDATA[--!strict
-- Small client entry point that can render before server remotes are ready.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local InputMode = require(script.Parent.Parent.UI.Kit.InputMode)

local Launcher = {}

function Launcher.start()
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = "GrimoireLauncher"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 200
	gui.Parent = player:WaitForChild("PlayerGui")

	local button = Instance.new("TextButton")
	button.Name = "OpenGrimoire"
	button.AnchorPoint = Vector2.new(1, 1)
	button.Position = UDim2.new(1, -24, 1, -84)
	button.Size = UDim2.fromOffset(224, 54)
	-- Spell Forge palette (SpellForgeTheme), inlined so this renders before UI modules load.
	button.BackgroundColor3 = Color3.fromRGB(21, 18, 24)
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Font = Enum.Font.GothamBold
	button.Text = "◆  SPELLS  ·  P"
	button.TextColor3 = Color3.fromRGB(238, 228, 212)
	button.TextSize = 16
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = button
	local edge = Instance.new("UIStroke")
	edge.Color = Color3.fromRGB(218, 174, 96)
	edge.Transparency = 0.3
	edge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	edge.Parent = button
	button.ZIndex = 10
	-- Hidden: the HUD spell bar's ✦ button opens the Grimoire now (P / View still work).
	button.Visible = false
	button.Parent = gui

	local callback: (() -> ())? = nil
	local pending = false
	local function activate()
		if callback then
			callback()
		else
			pending = true
			button.Text = "CONNECTING…"
		end
	end
	button.Activated:Connect(activate)
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.P and not processed and not UserInputService:GetFocusedTextBox() then
			activate()
		end
	end)
	-- Gamepad: the View/Select button opens and closes the Grimoire.
	ContextActionService:BindAction("GrimoireToggleGamepad", function(_, state)
		if state == Enum.UserInputState.Begin then
			activate()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.ButtonSelect)
	local function label(): string
		local glyph = InputMode.glyph("Grimoire", InputMode.get())
		return if glyph == "" then "◆  SPELLS" else "◆  SPELLS  ·  " .. glyph
	end
	InputMode.Changed:Connect(function()
		if callback then
			button.Text = label()
		end
	end)

	return {
		-- Lets the HUD spell bar open the Grimoire exactly like the P key does.
		Open = function(_)
			activate()
		end,
		Bind = function(_, open: () -> ())
			callback = open
			button.Text = label()
			if pending then
				pending = false
				task.defer(callback)
			end
		end,
		SetOpen = function(_, _open: boolean) end,
		SetError = function(_, message: string)
			button.Text = "GRIMOIRE ERROR · VIEW OUTPUT"
			warn("Grimoire launcher: " .. message)
		end,
	}
end

return Launcher
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="405">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local player = game:GetService("Players").LocalPlayer
local SummonConfig = require(game:GetService("ReplicatedStorage").Shared.Configuration.MagicSummons)
local Input = {}
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local studioSandbox = RunService:IsStudio() and require(Shared.Configuration.DevelopmentSandbox).Enabled
local development = studioSandbox

local function uiOpen(player: Player): boolean
	return player:GetAttribute("MagicLabOpen") == true
		or player:GetAttribute("InventoryOpen") == true
		or player:GetAttribute("UIModalOpen") == true
end

local function canControl(player: Player): boolean
	return studioSandbox or player:GetAttribute("CharacterReady") == true
end

function Input.start(
	sprint: (boolean) -> (),
	dash: () -> (),
	magicStart: (string, boolean?) -> (),
	magicRelease: () -> (),
	useEquipment: (string, string?) -> (),
	switchEquipment: () -> (),
	cycleGenerated: () -> (),
	startGenerated: () -> (),
	releaseGenerated: () -> (),
	cycleSummonSelection: () -> (),
	summonCommand: (string) -> ()
)
	ContextActionService:BindAction("SandboxSprint", function(_, state)
		if not canControl(player) or uiOpen(player) then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprint(false)
		elseif state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			sprint(true)
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:BindAction("SandboxDash", function(_, state)
		if not canControl(player) or uiOpen(player) then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			dash()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)
	ContextActionService:BindAction("SandboxPrimaryAttack", function(_, state)
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			-- Releases always pass through so a held heavy or block never sticks.
			useEquipment("Primary", "End")
			return Enum.ContextActionResult.Pass
		end
		if not canControl(player) or uiOpen(player) then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			useEquipment("Primary", "Begin")
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
	ContextActionService:BindAction("SandboxHeavyAttack", function(_, state)
		if not canControl(player) or uiOpen(player) then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			useEquipment("Heavy", "Begin")
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
	for mode, keyName in pairs(SummonConfig.CommandKeys) do
		local key = Enum.KeyCode[keyName]
		ContextActionService:BindAction("SandboxSummon" .. mode, function(_, state)
			if not canControl(player) or uiOpen(player) then
				return Enum.ContextActionResult.Pass
			end
			if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
				summonCommand(mode)
			end
			return Enum.ContextActionResult.Sink
		end, false, key)
	end
	ContextActionService:BindAction("SandboxEquipmentArea", function(_, state)
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			-- Releases always pass through so a held heavy or block never sticks.
			useEquipment("Area", "End")
			return Enum.ContextActionResult.Pass
		end
		if not canControl(player) or uiOpen(player) then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			useEquipment("Area", "Begin")
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
	ContextActionService:BindAction("SandboxSummonSelect", function(_, state)
		if not canControl(player) or uiOpen(player) then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			cycleSummonSelection()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode[SummonConfig.SelectionKey])
	ContextActionService:BindAction("SandboxEquipmentSwitch", function(_, state)
		if not canControl(player) or uiOpen(player) then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			switchEquipment()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.E, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("SandboxSprint", "SPRINT")
	ContextActionService:SetTitle("SandboxDash", "DASH")
	ContextActionService:SetTitle("SandboxPrimaryAttack", "ATTACK")
	ContextActionService:SetTitle("SandboxHeavyAttack", "HEAVY")
	ContextActionService:SetTitle("SandboxEquipmentArea", "AREA/BLOCK")
	ContextActionService:SetTitle("SandboxEquipmentSwitch", "SWITCH")
	ContextActionService:SetPosition("SandboxSprint", UDim2.new(1, -240, 1, -230))
	ContextActionService:SetPosition("SandboxDash", UDim2.new(1, -165, 1, -230))
	ContextActionService:SetPosition("SandboxPrimaryAttack", UDim2.new(1, -90, 1, -170))
	ContextActionService:SetPosition("SandboxHeavyAttack", UDim2.new(1, -90, 1, -245))
	ContextActionService:SetPosition("SandboxEquipmentArea", UDim2.new(1, -165, 1, -150))
	ContextActionService:SetPosition("SandboxEquipmentSwitch", UDim2.new(1, -240, 1, -150))
	for spellId, key in
		{
			Fireball = Enum.KeyCode.One,
			BodyBurst = Enum.KeyCode.Two,
			StoneShot = Enum.KeyCode.Three,
			LightningLance = Enum.KeyCode.Four,
			BurningGround = Enum.KeyCode.Five,
			BodyReinforcement = Enum.KeyCode.Six,
			StoneRaise = Enum.KeyCode.Seven,
		}
	do
		ContextActionService:BindAction("Sandbox" .. spellId, function(_, state)
			if not development then
				return Enum.ContextActionResult.Pass
			end
			if not canControl(player) or uiOpen(player) then
				return Enum.ContextActionResult.Pass
			end
			if UserInputService:GetFocusedTextBox() then
				return Enum.ContextActionResult.Sink
			end
			if state == Enum.UserInputState.Begin then
				magicStart(spellId, spellId == "StoneShot")
			elseif
				spellId == "StoneShot" and (state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel)
			then
				magicRelease()
			end
			return Enum.ContextActionResult.Sink
		end, false, key)
	end
	ContextActionService:BindAction("SandboxGeneratedCycle", function(_, state)
		if not development then
			return Enum.ContextActionResult.Pass
		end
		if not canControl(player) or uiOpen(player) then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			cycleGenerated()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.F)
	ContextActionService:BindAction("SandboxGeneratedCast", function(_, state)
		-- R is the melee heavy attack, so the Studio cast key only takes it while the Magic Focus is out.
		if not development or (player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon") ~= "PrimaryWeapon" then
			return Enum.ContextActionResult.Pass
		end
		if not canControl(player) or uiOpen(player) then
			return Enum.ContextActionResult.Pass
		end
		if UserInputService:GetFocusedTextBox() then
			return Enum.ContextActionResult.Sink
		end
		if state == Enum.UserInputState.Begin then
			startGenerated()
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			releaseGenerated()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.R)
	UserInputService.WindowFocusReleased:Connect(function()
		sprint(false)
	end)
	UserInputService.TextBoxFocused:Connect(function()
		sprint(false)
	end)
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="406">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[--!strict

-- Client mirror of the server inventory. It never mutates items locally: every
-- change is a request, and the server answers with a full snapshot.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Protocol = require(Shared.Networking.Protocol)
local Rules = require(Shared.Modules.ItemRules)
local Model = require(Shared.Modules.InventoryModel)
local InventoryController = {}

local Keys = {
	Toggle = Enum.KeyCode.I,
	Quick = { Enum.KeyCode.Y, Enum.KeyCode.U },
}
InventoryController.Keys = Keys

function InventoryController.start()
	local player = Players.LocalPlayer
	local remote = Shared:WaitForChild(Protocol.Folder):WaitForChild(Protocol.Inventory) :: RemoteEvent
	local changed = Instance.new("BindableEvent")
	local noticed = Instance.new("BindableEvent")
	local inventory = Model.blank()
	local loaded = false

	local controller = {}
	controller.Changed = changed.Event
	controller.Notice = noticed.Event
	controller.Keys = Keys

	function controller.Get(): Model.Inventory
		return inventory
	end

	function controller.Loaded(): boolean
		return loaded
	end

	function controller.Request(message: { [string]: any })
		remote:FireServer(message)
	end

	-- Predicted melee loadout for the active weapon; the server re-resolves it authoritatively.
	function controller.MeleeLoadout(): any?
		if (player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon") ~= "SecondaryWeapon" then
			return nil
		end
		return Rules.meleeLoadout(inventory.Equip.MainHand)
	end

	remote.OnClientEvent:Connect(function(message)
		if type(message) ~= "table" then
			return
		end
		if message.Kind == "Snapshot" then
			inventory = Model.deserialize(message.Items)
			loaded = true
			changed:Fire()
		elseif message.Kind == "Notice" and type(message.Text) == "string" then
			noticed:Fire(message.Text)
		elseif message.Kind == "Rejected" then
			local reasons = {
				Rejected = "That item does not fit there",
				SwapRejected = "Those items cannot swap places",
				Full = "Inventory full",
				CannotDrop = "That item cannot be dropped",
			}
			local text = reasons[message.Reason]
			if text then
				noticed:Fire(text)
			end
		end
	end)

	local view = require(script.Parent.Parent.UI.InventoryView).new(controller)
	controller.View = view

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Keys.Toggle then
			if player:GetAttribute("MagicLabOpen") ~= true then
				view.SetOpen(not view.IsOpen())
			end
		elseif input.KeyCode == Enum.KeyCode.Escape and view.IsOpen() then
			view.SetOpen(false)
		else
			for index, key in Keys.Quick do
				if input.KeyCode == key and player:GetAttribute("MagicLabOpen") ~= true then
					if inventory.Quick[index] then
						controller.Request({ Op = "Use", From = "Quick:" .. index })
					end
				end
			end
		end
	end)
	-- Gamepad: D-pad down toggles the inventory (outside the Grimoire).
	game:GetService("ContextActionService"):BindAction("InventoryToggleGamepad", function(_, state)
		if state ~= Enum.UserInputState.Begin or player:GetAttribute("MagicLabOpen") == true then
			return Enum.ContextActionResult.Pass
		end
		view.SetOpen(not view.IsOpen())
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.DPadDown)
	player:GetAttributeChangedSignal("MagicLabOpen"):Connect(function()
		if player:GetAttribute("MagicLabOpen") == true then
			view.SetOpen(false)
		end
	end)
	player:GetAttributeChangedSignal("ActiveEquipmentSlot"):Connect(function()
		changed:Fire()
	end)

	controller.Request({ Op = "Refresh" })
	return controller
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="407">
            <Properties>
              <string name="Name">LanternController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Lantern = {}

function Lantern.start()
	local player = Players.LocalPlayer
	local attachment: Attachment? = nil
	local function clear()
		if attachment then
			attachment:Destroy()
			attachment = nil
		end
	end
	local function bind(character: Model)
		clear()
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if player.Character ~= character or not root or not root:IsA("BasePart") then
			return
		end
		local anchor = Instance.new("Attachment")
		anchor.Name = "LocalFieldLantern"
		anchor.Position = Vector3.new(0, 2.2, -1.4)
		anchor.Parent = root
		attachment = anchor
		local light = Instance.new("PointLight")
		light.Name = "FieldLantern"
		light.Color = Color3.fromRGB(255, 203, 146)
		light.Range, light.Brightness, light.Shadows = 36, 3.25, true
		light.Parent = anchor
	end
	player.CharacterRemoving:Connect(clear)
	player.CharacterAdded:Connect(bind)
	if player.Character then
		task.spawn(bind, player.Character)
	end
end

return Lantern
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="408">
            <Properties>
              <string name="Name">MagicAerialController</string>
              <string name="Source"><![CDATA[--!strict

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Controller = {}

function Controller.start(remote: RemoteEvent)
	local player = Players.LocalPlayer
	local character: Model? = nil
	local active = false
	local ascending = false
	local descending = false
	local lastSent = 0
	local attributeConnection: RBXScriptConnection? = nil
	local sendInterval = 0.1

	local function showTouchControls(value: boolean)
		for _, actionName in { "MagicAerialAscend", "MagicAerialDescend" } do
			local button = ContextActionService:GetButton(actionName)
			if button then
				button.Visible = value
			end
		end
	end

	local function setActive(value: boolean)
		active = value
		showTouchControls(value)
		if not active then
			ascending = false
			descending = false
		end
	end

	local function bindCharacter(nextCharacter: Model)
		if attributeConnection then
			attributeConnection:Disconnect()
			attributeConnection = nil
		end
		character = nextCharacter
		setActive((nextCharacter:GetAttribute("MagicAerialSpeed") or 0) > 0)
		attributeConnection = nextCharacter:GetAttributeChangedSignal("MagicAerialSpeed"):Connect(function()
			setActive((nextCharacter:GetAttribute("MagicAerialSpeed") or 0) > 0)
		end)
	end

	local function verticalAction(direction: number, inputState: Enum.UserInputState)
		if not active then
			return Enum.ContextActionResult.Pass
		end
		local pressed = inputState == Enum.UserInputState.Begin
		if direction > 0 then
			ascending = pressed
		else
			descending = pressed
		end
		if inputState == Enum.UserInputState.Cancel then
			ascending = false
			descending = false
		end
		return Enum.ContextActionResult.Sink
	end

	ContextActionService:BindActionAtPriority("MagicAerialAscend", function(_, state)
		return verticalAction(1, state)
	end, true, 3000, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	ContextActionService:SetTitle("MagicAerialAscend", "Rise")
	ContextActionService:BindActionAtPriority("MagicAerialDescend", function(_, state)
		return verticalAction(-1, state)
	end, true, 3000, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("MagicAerialDescend", "Descend")

	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		bindCharacter(player.Character)
	end

	RunService.Heartbeat:Connect(function()
		if not active or not character or player.Character ~= character or UserInputService:GetFocusedTextBox() then
			return
		end
		local now = os.clock()
		if now - lastSent < sendInterval then
			return
		end
		lastSent = now
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		local move = humanoid.MoveDirection
		local interfaceOpen = player:GetAttribute("MagicLabOpen") == true
		local direction = if interfaceOpen
			then Vector3.zero
			else Vector3.new(move.X, (if ascending then 1 else 0) - (if descending then 1 else 0), move.Z)
		if direction.Magnitude > 1 then
			direction = direction.Unit
		end
		remote:FireServer(character, direction)
	end)

	return {
		Reset = function()
			setActive(false)
		end,
	}
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="409">
            <Properties>
              <string name="Name">MagicController</string>
              <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Protocol = require(Shared.Networking.Protocol)
local Types = require(Shared.Types.CombatTypes)
local Magic = {}
local function handOrigin()
	local character = game:GetService("Players").LocalPlayer.Character
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	return if hand and hand:IsA("BasePart")
		then hand.Position - hand.CFrame.UpVector * hand.Size.Y * 0.35 + Vector3.yAxis * 0.9
		else nil
end

function Magic.start(
	send: (string, Types.ActionOptions?) -> number,
	aim: () -> (Vector3, Vector3, Model?, Instance?),
	launcher: any?
)
	-- Start the editor independently of observer presentation. The presentation
	-- transport may arrive late or fail to initialize; neither condition should
	-- prevent the Grimoire from binding its launcher.
	task.spawn(function()
		local grimoireOk, grimoireError = pcall(function()
			require(script.Parent.MagicLabController).start(send, aim, launcher)
		end)
		if not grimoireOk then
			warn("Grimoire failed to start: " .. tostring(grimoireError))
			if launcher then
				launcher:SetError(tostring(grimoireError))
			end
		end
	end)
	local presentationOk, presentationError = pcall(function()
		require(script.Parent.MagicPresentationController).start()
	end)
	if not presentationOk then
		warn("Magic presentation failed to start: " .. tostring(presentationError))
	end
	local activeSpell: string? = nil
	local function cast(spellId: string, charged: boolean?)
		local direction, point, target, targetInstance = aim()
		activeSpell = if charged then spellId else nil
		send(Protocol.MagicStart, {
			SpellId = spellId,
			AimDirection = direction,
			WorldPoint = point,
			TargetModel = target,
			TargetInstance = targetInstance,
			CastOrigin = handOrigin(),
		})
	end
	return {
		Cast = cast,
		Release = function()
			if not activeSpell then
				return
			end
			local direction, point, target, targetInstance = aim()
			send(Protocol.MagicRelease, {
				SpellId = activeSpell,
				AimDirection = direction,
				WorldPoint = point,
				TargetModel = target,
				TargetInstance = targetInstance,
				CastOrigin = handOrigin(),
			})
			activeSpell = nil
		end,
		WeaponAction = function(action: string)
			local direction, point, target, targetInstance = aim()
			send(Protocol.EquipmentUse, {
				EquipmentAction = action,
				AimDirection = direction,
				WorldPoint = point,
				TargetModel = target,
				TargetInstance = targetInstance,
			})
		end,
		Reset = function()
			activeSpell = nil
		end,
	}
end

return Magic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="410">
            <Properties>
              <string name="Name">MagicLabController</string>
              <string name="Source"><![CDATA[--!strict
-- Development spell library editor. Slot persistence is server-owned; casts stay authoritative.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local UIS = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.MagicLab)
local Spec = require(Shared.Modules.SpellSpec)
local VisualAssets = require(Shared.Configuration.MagicVisualAssets)
local Schema = require(Shared.Configuration.MagicSchema)
local Geometry = require(Shared.Modules.MagicGeometry)
local ProjectileBehaviorSpec = require(Shared.Modules.ProjectileBehaviorSpec)
local ConditionSpec = require(Shared.Modules.MagicConditionSpec)
local ConditionTree = require(Shared.Modules.MagicConditionTree)
local LifetimeSpec = require(Shared.Modules.MagicLifetimeSpec)
local CastingSpec = require(Shared.Modules.MagicCastingSpec)
local MaterialSpec = require(Shared.Modules.MagicMaterialSpec)
local ConstructGeometrySpec = require(Shared.Modules.MagicConstructGeometrySpec)
local SpecialResourceSpec = require(Shared.Modules.MagicSpecialResourceSpec)
local SpecialResourceDefinitions = require(Shared.Configuration.MagicLocus).SpecialResources
local EnvironmentRequirementSpec = require(Shared.Modules.MagicEnvironmentRequirementSpec)
local SpellIdentitySpec = require(Shared.Modules.MagicSpellIdentitySpec)
local GamepadNav = require(script.Parent.Parent.UI.Kit.GamepadNav)
local InputMode = require(script.Parent.Parent.UI.Kit.InputMode)
local Responsive = require(script.Parent.Parent.UI.Kit.Responsive)
local Tokens = require(script.Parent.Parent.UI.Kit.Tokens)
local GeometryPreview = require(script.Parent.GrimoireGeometryPreview)
local ConditionTreeEditor = require(script.Parent.GrimoireConditionTreeEditor)
local VisualSpec = require(Shared.Modules.MagicVisualSpec)
local CompanionSpellPolicy = require(Shared.Modules.MagicCompanionSpellPolicy)
local Protocol = require(Shared.Networking.Protocol)
local Elements = require(Shared.Configuration.MagicElements)
local Slots = require(Shared.Modules.MagicSlots)
local ProgressionRules = require(Shared.Modules.SpellProgressionRules)
local DevelopmentSandbox = require(Shared.Configuration.DevelopmentSandbox)
local Camera = require(script.Parent.CameraController)
ConditionSpec.configureSpecialResources(SpecialResourceDefinitions)
-- Every spell screen uses the Spell Forge palette and components.
local Theme = require(script.Parent.Parent.UI.SpellForgeTheme).Book
local K = require(script.Parent.Parent.UI.SpellForgeComponents)
local Hub = require(script.Parent.Parent.UI.SpellHub)
-- True while Advanced section editors draw into the forge inspector.
local forgeHosted = false
local SpellVisual = require(script.Parent.Parent.UI.GrimoireSpellVisual)
local VFXAnalyzer = require(Shared.SpellVFXSystem.Core.SpellVFXAnalyzer)
local VFXComposer = require(Shared.SpellVFXSystem.Core.SpellVFXComposer)
local LibraryView = require(script.Parent.Parent.UI.GrimoireLibraryView)
local Summary = require(Shared.Modules.GrimoireSummary)
local ActionFlow = require(Shared.Modules.MagicActionFlow)
local GuidedForge = require(script.Parent.Parent.UI.GuidedSpellForge)
local Lab = {}
local function ensureVisualDefaults(definition)
	definition.Visual = definition.Visual or {}
	for key, value in VisualSpec.Defaults do
		if definition.Visual[key] == nil then
			definition.Visual[key] = value
		end
	end
end
local function visualMaterial(definition)
	local name = definition.Visual.MaterialAppearance
	if not name or name == "Auto" then
		name = VisualSpec.autoMaterial(definition.Source.Principle, definition.Source.Expression, definition.Form)
	end
	return Enum.Material[name] or Enum.Material.Neon
end
function Lab.start(send, aim, launcher)
	if not Config.Enabled or not (RunService:IsStudio() or (not Config.StudioOnly and Config.AllowLive)) then
		return
	end
	launcher = launcher or require(script.Parent.GrimoireLauncher).start()
	local player = Players.LocalPlayer
	local remotes = Shared:WaitForChild(Protocol.Folder, 15)
	assert(remotes, "Action remotes did not start within 15 seconds")
	local request = remotes:WaitForChild("MagicLabRequest", 15)
	assert(request, "Grimoire editor remote did not start within 15 seconds")
	local response = remotes:WaitForChild("MagicLabResponse", 15)
	assert(response, "Grimoire response remote did not start within 15 seconds")
	local trainingRequest = remotes:WaitForChild("TrainingDummyRequest", 15) :: RemoteEvent?
	assert(trainingRequest, "Training dummy remote did not start within 15 seconds")
	local trainingResponse = remotes:WaitForChild("TrainingDummyResponse", 15) :: RemoteEvent?
	assert(trainingResponse, "Training response remote did not start within 15 seconds")
	-- Validate every response event before building the editor. Waiting for these
	-- events later in the 5,000-line UI setup could leave the launcher stuck in
	-- its connecting state forever if a server bootstrap regresses.
	local grimoireResponse = remotes:WaitForChild("GrimoireResponse", 15)
	assert(
		grimoireResponse and grimoireResponse:IsA("RemoteEvent"),
		"Grimoire library response remote did not start within 15 seconds"
	)
	local actionFeedback = remotes:WaitForChild(Protocol.Feedback, 15)
	assert(
		actionFeedback and actionFeedback:IsA("RemoteEvent"),
		"Action feedback remote did not start within 15 seconds"
	)
	local consentAttribute = "MagicAcceptsTargetedSpells"
	local consentEnabled = player:GetAttribute(consentAttribute) == true
	player:GetAttributeChangedSignal(consentAttribute):Connect(function()
		consentEnabled = player:GetAttribute(consentAttribute) == true
	end)
	local gui = Instance.new("ScreenGui")
	local heldAimSlot: number? = nil
	local aimUpdateElapsed = 0
	gui.Name = "MagicLab"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 80
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.Parent = player:WaitForChild("PlayerGui")
	-- Roblox switches to its pointing-hand cursor over GuiButtons. Keep the
	-- grimoire's pointer visually steady by drawing one cursor above the UI.
	local cursorGui = Instance.new("ScreenGui")
	cursorGui.Name = "GrimoireStableCursor"
	cursorGui.ResetOnSpawn = false
	cursorGui.IgnoreGuiInset = true
	cursorGui.DisplayOrder = 200
	cursorGui.Parent = player.PlayerGui
	local cursor = Instance.new("TextLabel")
	cursor.Name = "Pointer"
	cursor.AnchorPoint = Vector2.new(0.15, 0.12)
	cursor.Size = UDim2.fromOffset(24, 24)
	cursor.BackgroundTransparency = 1
	cursor.Font = Enum.Font.GothamBold
	cursor.Text = "↖"
	cursor.TextSize = 21
	cursor.TextColor3 = Theme.Gold
	cursor.TextStrokeColor3 = Theme.Ink
	cursor.TextStrokeTransparency = 0.1
	cursor.ZIndex = 100
	cursor.Visible = false
	cursor.Parent = cursorGui
	RunService.RenderStepped:Connect(function()
		if cursor.Visible then
			local mouse = UIS:GetMouseLocation()
			cursor.Position = UDim2.fromOffset(mouse.X, mouse.Y)
		end
	end)
	local panel = Instance.new("Frame")
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Size = UDim2.new(0.96, 0, 0.96, 0)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.BackgroundColor3 = Color3.new(1, 1, 1)
	panel.ClipsDescendants = true
	panel.Visible = false
	panel.Parent = gui
	local panelConstraint = Instance.new("UISizeConstraint")
	panelConstraint.MinSize = Vector2.new(0, 0)
	panelConstraint.MaxSize = Vector2.new(1120, 940)
	panelConstraint.Parent = panel
	local headerTitle = Instance.new("TextLabel")
	headerTitle.Size = UDim2.new(1, -72, 0, 28)
	headerTitle.Position = UDim2.fromOffset(18, 9)
	headerTitle.BackgroundTransparency = 1
	headerTitle.Font = Enum.Font.Garamond
	headerTitle.TextSize = 24
	headerTitle.TextColor3 = Theme.Ink
	headerTitle.TextXAlignment = Enum.TextXAlignment.Left
	headerTitle.Parent = panel
	local headerSummary = Instance.new("TextLabel")
	headerSummary.Size = UDim2.new(1, -72, 0, 24)
	headerSummary.Position = UDim2.fromOffset(19, 38)
	headerSummary.BackgroundTransparency = 1
	headerSummary.TextSize = 14
	headerSummary.TextColor3 = Theme.MutedInk
	headerSummary.TextXAlignment = Enum.TextXAlignment.Left
	headerSummary.TextTruncate = Enum.TextTruncate.AtEnd
	headerSummary.Parent = panel
	local navigation = Instance.new("ScrollingFrame")
	navigation.Size = UDim2.new(1, -24, 0, 40)
	navigation.Position = UDim2.fromOffset(12, 68)
	navigation.BackgroundTransparency = 1
	navigation.BorderSizePixel = 0
	navigation.ScrollBarThickness = 3
	navigation.CanvasSize = UDim2.new()
	navigation.ScrollingDirection = Enum.ScrollingDirection.X
	navigation.Parent = panel
	local closeButton = Instance.new("TextButton")
	closeButton.Size = UDim2.fromOffset(34, 30)
	closeButton.Position = UDim2.new(1, -46, 0, 8)
	closeButton.BackgroundColor3 = Theme.Accent
	closeButton.Text = "×"
	closeButton.TextColor3 = Theme.OnAccent
	closeButton.TextSize = 21
	closeButton.Font = Enum.Font.GothamBold
	closeButton.ZIndex = 3
	closeButton.Parent = panel
	local homeButton = Instance.new("TextButton")
	homeButton.Name = "ReturnToGrimoireHome"
	homeButton.Size = UDim2.fromOffset(36, 36)
	homeButton.BackgroundColor3 = Theme.Surface
	homeButton.BorderSizePixel = 0
	homeButton.Text = ""
	homeButton.ZIndex = 20
	homeButton.Visible = false
	homeButton.Parent = panel
	local homeCorner = Instance.new("UICorner")
	homeCorner.CornerRadius = UDim.new(0, 5)
	homeCorner.Parent = homeButton
	local homeEdge = Instance.new("UIStroke")
	homeEdge.Color = Theme.TileEdge
	homeEdge.Thickness = 2
	homeEdge.Parent = homeButton
	local roof = Instance.new("Frame")
	roof.Name = "HouseRoof"
	roof.Position = UDim2.fromOffset(11, 7)
	roof.Size = UDim2.fromOffset(14, 14)
	roof.Rotation = 45
	roof.BackgroundColor3 = Theme.Accent
	roof.BorderSizePixel = 0
	roof.ZIndex = 21
	roof.Parent = homeButton
	local house = Instance.new("Frame")
	house.Name = "HouseBody"
	house.Position = UDim2.fromOffset(8, 15)
	house.Size = UDim2.fromOffset(20, 15)
	house.BackgroundColor3 = Theme.Accent
	house.BorderSizePixel = 0
	house.ZIndex = 22
	house.Parent = homeButton
	local door = Instance.new("Frame")
	door.Name = "HouseDoor"
	door.Position = UDim2.fromOffset(15, 22)
	door.Size = UDim2.fromOffset(6, 8)
	door.BackgroundColor3 = Theme.PageHighlight
	door.BorderSizePixel = 0
	door.ZIndex = 23
	door.Parent = homeButton
	local function positionHomeButton()
		homeButton.Position = if panel.AbsoluteSize.X >= 500 then UDim2.fromOffset(40, 22) else UDim2.fromOffset(12, 14)
	end
	panel:GetPropertyChangedSignal("AbsoluteSize"):Connect(positionHomeButton)
	positionHomeButton()
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -24, 1, -260)
	scroll.Position = UDim2.fromOffset(12, 116)
	scroll.BackgroundTransparency = 1
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.ScrollBarThickness = 6
	scroll.Parent = panel
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 5)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = scroll
	local status = Instance.new("TextLabel")
	status.Size = UDim2.new(1, -24, 0, 58)
	status.Position = UDim2.new(0, 12, 1, -142)
	status.BackgroundTransparency = 1
	status.TextWrapped = true
	status.TextSize = 13
	status.TextColor3 = Theme.Ink
	status.Parent = panel
	local draft = Spec.createDraft("Projectile", "Energy")
	local event = Schema.Forms[draft.Form].DefaultEvent
	local selectedSlot = 1
	local equipped = {}
	local draftsBySlot = {}
	local libraryDrafts = {}
	local standaloneWorkingDraft: any = nil
	local lastLibraryDraftId: string? = nil
	local lastWorkingDraftKind: string? = nil
	local dirtySlots = {}
	local persistenceState = "NOT LOADED"
	local libraryLoaded = false
	local libraryLoading = false
	local pageMode = "Slots"
	local standaloneDraft = false
	local editingLibraryRecord = false
	local editingLibraryId: string? = nil
	local authoringMode = "Guided"
	local selectedStepByEvent = {}
	local expertSearch = ""
	local activeSection = "Setup"
	local visualSubpage = "Composer"
	local visualPage = 1
	local visualStudioFrame: Frame? = nil
	local visualLayoutConnection: RBXScriptConnection? = nil
	local EffectCategoryOrder = { "Damage", "Healing", "Defense", "Control", "Movement", "Summoning", "Utility" }
	local function effectCategory(kind: string): string
		if kind == "Damage" or kind == "DamageOverTime" then
			return "Damage"
		elseif kind == "Heal" or kind == "Restoration" then
			return "Healing"
		elseif kind == "Shield" or kind == "ModifyAttribute" or kind == "Enhancement" then
			return "Defense"
		elseif kind == "AerialMovement" then
			return "Movement"
		elseif kind == "Summon" then
			return "Summoning"
		elseif kind == "Reveal" or kind == "Manipulation" or kind == "Transformation" then
			return "Utility"
		end
		return "Control"
	end
	local applyingDraft, applyingSlot
	local function refreshBar()
		-- The persistent launcher owns its own label and lives outside this panel.
	end
	refreshBar()
	local pendingCast = false
	local applying = false
	local dirty = true
	local revision = 0
	local appliedRevision = -1
	local debugGeometry = false
	local drawFolder = Instance.new("Folder")
	drawFolder.Name = "MagicLabLocalPreview"
	drawFolder.Parent = workspace
	local toast = Instance.new("TextLabel")
	toast.Name = "CastFeedback"
	toast.AnchorPoint = Vector2.new(0.5, 0)
	toast.Position = UDim2.fromScale(0.5, 0.15)
	toast.Size = UDim2.new(0.7, 0, 0, 44)
	toast.BackgroundColor3 = K.C.Panel
	toast.BackgroundTransparency = 0.05
	toast.TextColor3 = Theme.Ink
	toast.Font = Enum.Font.GothamBold
	toast.TextSize = 14
	toast.TextWrapped = true
	K.corner(toast, 10)
	K.pad(toast, 14, 6)
	toast.ZIndex = 90
	toast.Visible = false
	toast.Parent = gui
	local toastEdge = Instance.new("UIStroke")
	toastEdge.Color = K.C.Gold
	toastEdge.Thickness = 1
	toastEdge.Transparency = 0.4
	toastEdge.Parent = toast
	local toastUntil = 0
	local toastToken = 0
	local feedbackVisible = true
	local function refreshToast()
		toast.Visible = feedbackVisible and os.clock() < toastUntil
	end
	local function creatorFacingText(text)
		local value = tostring(text)
		local lowered = string.lower(value)
		if
			string.find(lowered, "principle", 1, true)
			or string.find(lowered, "expression", 1, true)
			or string.find(lowered, "source", 1, true)
		then
			return "One or more selected effects or settings conflict with this combination. Remove or adjust an effect, then review again."
		end
		return value
	end
	local function message(text, ok, warning)
		text = creatorFacingText(text)
		status.Text = text
		toast.Text = text
		toastUntil = os.clock() + 3
		toastToken += 1
		local token = toastToken
		refreshToast()
		task.delay(3, function()
			if token == toastToken then
				toast.Visible = false
			end
		end)
		status.TextColor3 = if warning then Theme.Warning elseif ok then Theme.Success else Theme.Error
		toast.TextColor3 = status.TextColor3
	end
	local updateHeader
	local forgeApi = nil
	local editorPreview
	local mobileEditorPreview
	local liveIconPreview
	local function estimate()
		if forgeApi and not forgeHosted then
			task.defer(forgeApi.refresh)
		end
		panel:SetAttribute("SpellSummary", draft.Name .. "\n" .. draft.Form .. "  ·  " .. draft.Element)
		if editorPreview then
			SpellVisual.render(editorPreview, draft, false)
		end
		if mobileEditorPreview then
			SpellVisual.render(mobileEditorPreview, draft, false)
		end
		if liveIconPreview and liveIconPreview.Parent then
			SpellVisual.render(liveIconPreview, draft, true)
		end
		revision += 1
		dirty = true
		if pageMode == "Editor" and standaloneDraft then
			standaloneWorkingDraft = Spec.copy(draft)
			lastWorkingDraftKind = "Standalone"
		elseif pageMode == "Editor" and not editingLibraryRecord then
			draftsBySlot[selectedSlot] = draft
			dirtySlots[selectedSlot] = true
		elseif pageMode == "Editor" and editingLibraryRecord and editingLibraryId then
			libraryDrafts[editingLibraryId] = Spec.copy(draft)
			lastLibraryDraftId = editingLibraryId
			lastWorkingDraftKind = "Library"
		end
		if updateHeader then
			updateHeader()
		end
		local ok, reason = Spec.validate(draft)
		if not ok then
			if reason == "Specify 1–8 payloads across triggers" then
				message("Blank draft ready · choose a compatible effect on the Effects page before equipping.", true)
				return
			end
			message(reason, false)
			return
		end
		local priced = Spec.copy(draft)
		local publicCombat = not (RunService:IsStudio() and DevelopmentSandbox.Enabled)
		local cost = if publicCombat
			then ProgressionRules.reprice(priced, Spec.estimate, Spec.copy)
			else Spec.estimate(draft)
		if publicCombat then
			cost.ManaUpkeepPerSecond = priced.Casting.ManaUpkeepPerSecond or 0
			cost.StrainPerSecond = priced.Casting.StrainPerSecond or 0
		end
		local specialCostLabels = {}
		for _, resourceId in ipairs(SpecialResourceSpec.order(SpecialResourceDefinitions)) do
			local amount = draft.Cost.SpecialResources and draft.Cost.SpecialResources[resourceId]
			if amount and amount > 0 then
				table.insert(specialCostLabels, SpecialResourceDefinitions[resourceId].Label .. " " .. tostring(amount))
			end
		end
		local specialCostText = if #specialCostLabels > 0 then " · " .. table.concat(specialCostLabels, ", ") else ""
		message(
			string.format(
				"ESTIMATE · mana %d · strain %d · complexity %d · cooldown %.2fs · while active: %g mana/s, %g strain/s%s\nServer checks unlocks and spell rank before equipping.",
				cost.ManaDemand,
				cost.Strain,
				cost.Complexity,
				priced.Casting.Cooldown,
				cost.ManaUpkeepPerSecond,
				cost.StrainPerSecond,
				specialCostText
			),
			true
		)
	end
	local function visibility(open)
		panel.Visible = open
		if open then
			GamepadNav.open(panel, function()
				visibility(false)
			end)
		else
			GamepadNav.close(panel)
		end
		launcher:SetOpen(open)
		player:SetAttribute("MagicLabOpen", open)
		Camera:SetGameplayMouseLookEnabled(not open)
		cursor.Visible = open and UIS.MouseEnabled
		if open then
			UIS.MouseIconEnabled = false
		end
		if open then
			send("Sprint", { Sprinting = false })
			if not libraryLoaded and not libraryLoading then
				libraryLoading = true
				request:FireServer("Load")
			end
		end
	end
	closeButton.Activated:Connect(function()
		visibility(false)
	end)
	local rebuild
	-- Server responses can arrive in bursts or while the lab is closed. Opening
	-- the lab always rebuilds, so hidden updates are skipped and visible ones
	-- are coalesced into a single rebuild on the next resumption point.
	local rebuildQueued = false
	local function requestRebuild()
		if rebuildQueued then
			return
		end
		rebuildQueued = true
		task.defer(function()
			rebuildQueued = false
			if panel.Visible then
				rebuild()
			end
		end)
	end
	local apply
	local cast
	local actions
	local saveLibraryButton
	local saveSlotButton
	local footerButtons = {}
	local pendingLibrarySaveMode: string? = nil
	local pendingStandaloneSave = false
	local order = 0
	local currentGroup
	local cardPairHolder
	local cardPairCount = 0
	local cardPairCards = {}
	local cardPairLayout
	local expandedGroups = {}
	local expandedChoiceKey: string? = nil
	local advancedGroups = {
		["OPTIONAL CASTER REQUIREMENTS"] = true,
		["SPECIAL RESOURCE COSTS"] = true,
		["ENVIRONMENT REQUIREMENTS"] = true,
		["OPTIONAL CAST RULES"] = true,
		["TRIGGER BEHAVIORS"] = true,
		["PROJECTILE TRAVEL BEHAVIORS"] = true,
		["TIMED MOTION PHASES"] = true,
		["ACTIVE PROXIMITY"] = true,
		["SPATIAL AUDIO"] = true,
	}
	local choiceScrollRestoreRevision = 0
	local function rebuildPreservingScroll()
		local previousCanvasPosition = scroll.CanvasPosition
		local restorePageMode, restoreSection, restoreSlot = pageMode, activeSection, selectedSlot
		rebuild()
		choiceScrollRestoreRevision += 1
		local restoreRevision = choiceScrollRestoreRevision
		task.defer(function()
			-- Rebuilding briefly removes the scroll content, so wait for its
			-- automatic canvas size to settle before restoring the position.
			RunService.Heartbeat:Wait()
			if
				restoreRevision == choiceScrollRestoreRevision
				and pageMode == restorePageMode
				and activeSection == restoreSection
				and selectedSlot == restoreSlot
				and scroll.Parent
			then
				scroll.CanvasPosition = previousCanvasPosition
			end
		end)
	end
	local function layoutFooterButtons()
		local visible = {}
		for _, item in ipairs(footerButtons) do
			if item and item.Visible then
				table.insert(visible, item)
			end
		end
		local width = 1 / math.max(1, #visible)
		for index, item in ipairs(visible) do
			item.Size = UDim2.new(width, -4, 1, 0)
			item.Position = UDim2.new((index - 1) * width, 2, 0, 0)
		end
	end
	local libraryView
	local pendingLibraryEdit
	local helpSeen = false
	-- Section helpers. Every screen (Library, Training, Help, and the Advanced
	-- editors hosted in the forge inspector) is drawn with these, so they build
	-- Spell Forge components rather than their own styling.
	local function confirm(text, accept)
		if panel:FindFirstChild("Confirmation") then
			return
		end
		local shade = K.new("TextButton", {
			Name = "Confirmation",
			Size = UDim2.fromScale(1, 1),
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			ZIndex = 60,
		}, panel)
		local sheet = K.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0.9, 0, 0, 200),
			BackgroundColor3 = K.C.Panel,
			Active = true,
			ZIndex = 61,
		}, shade)
		K.new("UISizeConstraint", { MaxSize = Vector2.new(480, 260) }, sheet)
		K.corner(sheet, 14)
		K.stroke(sheet, K.C.Gold, 1, 0.4)
		K.text(sheet, "CONFIRM", 12, K.C.Gold, Enum.Font.GothamBlack, {
			Position = UDim2.fromOffset(20, 14),
			Size = UDim2.new(1, -40, 0, 18),
			ZIndex = 62,
		})
		K.text(sheet, text, 15, K.C.Ink, Enum.Font.GothamMedium, {
			Position = UDim2.fromOffset(20, 38),
			Size = UDim2.new(1, -40, 1, -110),
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 62,
		})
		for i, caption in { "CANCEL", "CONFIRM" } do
			local b = K.pill(sheet, caption, function()
				shade:Destroy()
				if i == 2 then
					accept()
				end
			end, if i == 2 then "accent" else nil)
			b.Size, b.Position = UDim2.new(0.5, -26, 0, 42), UDim2.new((i - 1) * 0.5, if i == 1 then 20 else 6, 1, -58)
			b.ZIndex = 62
		end
	end
	local function visibleNow(label)
		local groupVisible = not currentGroup
			or expandedGroups[currentGroup] == true
			or (authoringMode == "Expert" and expertSearch ~= "")
		local searchVisible = authoringMode ~= "Expert"
			or expertSearch == ""
			or string.find(string.lower(label), string.lower(expertSearch), 1, true) ~= nil
		return groupVisible and searchVisible
	end
	local function row(label)
		cardPairHolder, cardPairCount, cardPairCards, cardPairLayout = nil, 0, {}, nil
		order += 1
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, -8, 0, 44)
		frame.BackgroundTransparency = 1
		frame.LayoutOrder = order
		frame.Visible = visibleNow(label)
		frame.Parent = scroll
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(0.56, 0, 1, 0)
		title.BackgroundTransparency = 1
		title.TextWrapped = true
		title.Text = label
		title.TextColor3 = K.C.Ink
		title.Font = Enum.Font.GothamMedium
		title.TextSize = 13
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.Parent = frame
		return frame
	end
	local function canvasBlock(height)
		cardPairHolder, cardPairCount, cardPairCards, cardPairLayout = nil, 0, {}, nil
		order += 1
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, -8, 0, height)
		frame.BackgroundTransparency = 1
		frame.LayoutOrder = order
		frame.Parent = scroll
		return frame
	end
	local function creationChoiceGrid(options)
		local gridHost = scroll
		local holder = canvasBlock(gridHost.AbsoluteSize.Y)
		holder.Name = "SpellChoiceGrid"
		local tiles = {}
		for index, option in ipairs(options) do
			local tile = K.new("TextButton", {
				Name = "Choice_" .. tostring(option.Id or index),
				BackgroundColor3 = K.C.Card,
				Text = "",
				AutoButtonColor = false,
			}, holder)
			K.corner(tile, 12)
			local edge =
				K.stroke(tile, if option.Selected then K.C.Gold else K.C.PanelEdge, if option.Selected then 2 else 1)
			K.hover(tile, K.C.Card, K.C.CardHover)
			tile.SelectionGained:Connect(function()
				edge.Color = K.C.Gold
			end)
			tile.SelectionLost:Connect(function()
				edge.Color = if option.Selected then K.C.Gold else K.C.PanelEdge
			end)
			local icon = K.new("Frame", {
				Name = "ChoiceIcon",
				Position = UDim2.fromScale(0.29, 0.14),
				Size = UDim2.fromScale(0.42, 0.43),
				BackgroundColor3 = K.C.Input,
			}, tile)
			K.corner(icon, 10)
			if option.Preview then
				SpellVisual.render(icon, option.Preview, true)
			else
				K.text(icon, option.Symbol or "◆", 26, K.C.Gold, Enum.Font.GothamBold, {
					Size = UDim2.fromScale(1, 1),
					TextXAlignment = Enum.TextXAlignment.Center,
				})
			end
			K.text(tile, option.Label, 14, K.C.Ink, Enum.Font.GothamBold, {
				Name = "ChoiceName",
				Position = UDim2.fromScale(0.06, 0.6),
				Size = UDim2.fromScale(0.88, 0.16),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			K.text(tile, option.Hint or "", 11, K.C.Muted, Enum.Font.Gotham, {
				Name = "ChoiceDetail",
				Position = UDim2.fromScale(0.06, 0.77),
				Size = UDim2.fromScale(0.88, 0.18),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			if option.Badge then
				K.text(tile, option.Badge, 10, if option.Selected then K.C.Gold else K.C.Faint, Enum.Font.GothamBlack, {
					Name = "ChoiceBadge",
					Position = UDim2.fromScale(0.07, 0.03),
					Size = UDim2.fromScale(0.86, 0.1),
					TextXAlignment = Enum.TextXAlignment.Center,
				})
			end
			tile.Activated:Connect(option.Action)
			table.insert(tiles, tile)
		end
		local function layoutGrid()
			local width = holder.AbsoluteSize.X
			local gap = 10
			local columns = math.max(2, math.min(4, math.floor((width + gap) / 150)))
			local cell = math.max(72, math.floor((width - gap * (columns - 1)) / columns))
			cell = math.min(cell, 190)
			local left = math.floor((width - (cell * columns + gap * (columns - 1))) / 2)
			for index, tile in ipairs(tiles) do
				local column = (index - 1) % columns
				local rowIndex = math.floor((index - 1) / columns)
				tile.Position = UDim2.fromOffset(left + column * (cell + gap), rowIndex * (cell + gap))
				tile.Size = UDim2.fromOffset(cell, cell)
			end
			holder.Size = UDim2.new(1, -8, 0, math.ceil(#tiles / columns) * (cell + gap))
		end
		holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutGrid)
		local resizeConnection = gridHost:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutGrid)
		holder.Destroying:Connect(function()
			resizeConnection:Disconnect()
		end)
		layoutGrid()
	end
	local function heading(text)
		if not (currentGroup == "TRIGGER BEHAVIORS" and string.find(text, " in blast", 1, true)) then
			currentGroup = nil
		end
		local frame = row(text)
		frame.Size = UDim2.new(1, -8, 0, 34)
		local label = frame:FindFirstChildOfClass("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBlack
		label.TextSize = 12
		label.TextColor3 = K.C.Gold
		label.TextYAlignment = Enum.TextYAlignment.Bottom
		if advancedGroups[text] then
			label.Text = (if expandedGroups[text] then "▼   " else "▶   ") .. text
			currentGroup = text
			frame.Size = UDim2.new(1, -8, 0, 40)
			label.Position = UDim2.fromOffset(14, 0)
			label.Size = UDim2.new(1, -28, 1, 0)
			label.Font = Enum.Font.GothamBold
			label.TextColor3 = K.C.Ink
			label.TextYAlignment = Enum.TextYAlignment.Center
			frame.BackgroundColor3 = K.C.Card
			frame.BackgroundTransparency = 0
			K.stroke(frame, K.C.PanelEdge)
			K.corner(frame, 8)
			local reveal = K.new("TextButton", {
				Name = "AdvancedTriggerBar",
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
			}, frame)
			reveal.Activated:Connect(function()
				expandedGroups[text] = not expandedGroups[text]
				rebuildPreservingScroll()
			end)
		end
	end
	local function info(text, _height)
		cardPairHolder, cardPairCount, cardPairCards, cardPairLayout = nil, 0, {}, nil
		order += 1
		local label = K.text(scroll, text, 12, K.C.Muted, Enum.Font.Gotham, {
			Size = UDim2.new(1, -8, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 0,
			BackgroundColor3 = Color3.fromRGB(27, 23, 30),
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = order,
		})
		K.pad(label, 12, 9)
		K.corner(label, 8)
		label.Visible = visibleNow(text)
		return label
	end
	local function card(title, description, enabled, onChange, canEdit, unavailableReason)
		canEdit = if canEdit == nil then true else canEdit
		if not visibleNow(title .. " " .. description) then
			return nil
		end
		if not cardPairHolder or cardPairCount >= 2 then
			order += 1
			cardPairHolder = Instance.new("Frame")
			cardPairHolder.Name = "EffectChoicePair"
			cardPairHolder.Size = UDim2.new(1, -8, 0, 128)
			cardPairHolder.BackgroundTransparency = 1
			cardPairHolder.LayoutOrder = order
			cardPairHolder.Parent = scroll
			cardPairCount, cardPairCards = 0, {}
			local holder = cardPairHolder
			local cards = cardPairCards
			local function layoutPair()
				local width = holder.AbsoluteSize.X
				local columns = if width >= 295 then 2 else 1
				local gap = 10
				local cellWidth = if columns == 2 then math.floor((width - gap) / 2) else width
				for index, choice in ipairs(cards) do
					choice.Size = UDim2.fromOffset(cellWidth, 120)
					choice.Position = if columns == 2
						then UDim2.fromOffset((index - 1) * (cellWidth + gap), 0)
						else UDim2.fromOffset(0, (index - 1) * (120 + gap))
				end
				holder.Size = UDim2.new(1, -8, 0, if columns == 2 then 120 else #cards * (120 + gap) - gap)
			end
			holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutPair)
			local resizeConnection = scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutPair)
			holder.Destroying:Connect(function()
				resizeConnection:Disconnect()
			end)
			cardPairLayout = layoutPair
		end
		local base = if canEdit then K.C.Card else Color3.fromRGB(24, 21, 26)
		local frame = K.new("TextButton", {
			Name = "EffectChoice",
			BackgroundColor3 = base,
			Text = "",
			AutoButtonColor = false,
		}, cardPairHolder)
		cardPairCount += 1
		table.insert(cardPairCards, frame)
		K.corner(frame, 12)
		K.stroke(frame, if enabled then K.C.Gold else K.C.PanelEdge, if enabled then 2 else 1)
		if canEdit then
			K.hover(frame, base, K.C.CardHover)
		end
		K.text(frame, title, 13, if canEdit then K.C.Ink else K.C.Faint, Enum.Font.GothamBold, {
			Position = UDim2.fromOffset(12, 10),
			Size = UDim2.new(1, -24, 0, 18),
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		K.text(
			frame,
			if canEdit then description else tostring(unavailableReason or "Unavailable"),
			11,
			K.C.Muted,
			Enum.Font.Gotham,
			{
				Position = UDim2.fromOffset(12, 30),
				Size = UDim2.new(1, -24, 1, -76),
				TextYAlignment = Enum.TextYAlignment.Top,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}
		)
		local add = K.pill(
			frame,
			if not canEdit then "UNAVAILABLE" elseif enabled then "ADDED" else "+ ADD",
			function() end,
			if enabled and canEdit then "accent" else nil
		)
		add.Size, add.Position = UDim2.new(1, -24, 0, 32), UDim2.new(0, 12, 1, -42)
		if not canEdit then
			add.TextColor3 = K.C.Faint
		end
		if canEdit then
			local function choose()
				onChange(not enabled)
				rebuild()
				estimate()
			end
			frame.Activated:Connect(choose)
			add.Activated:Connect(choose)
		end
		if cardPairLayout then
			cardPairLayout()
		end
		return frame
	end
	local function button(parent, text, callback)
		local b = K.pill(parent, text, callback)
		b.Size = UDim2.new(0.42, 0, 0, 36)
		b.Position = UDim2.new(0.58, 0, 0.5, -18)
		b.TextSize = 12
		b.TextWrapped = true
		return b
	end
	local function inputBox(r, value, placeholder)
		local box = K.new("TextBox", {
			Size = UDim2.new(0.42, 0, 0, 36),
			Position = UDim2.new(0.58, 0, 0.5, -18),
			BackgroundColor3 = K.C.Input,
			TextColor3 = K.C.Ink,
			PlaceholderColor3 = K.C.Faint,
			PlaceholderText = placeholder or "",
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			ClearTextOnFocus = false,
			Text = value,
		}, r)
		K.corner(box, 8)
		K.stroke(box, K.C.PanelEdge)
		return box
	end
	local function select(label, value, options, change, labelFor, help, isAvailable, lockedReason, presentationOnly)
		local r = row(label)
		local function display(option)
			return if labelFor then labelFor(option) else tostring(option)
		end
		local function pick(option)
			expandedChoiceKey = nil
			change(option)
			rebuildPreservingScroll()
			if not presentationOnly then
				estimate()
			end
		end
		local title = r:FindFirstChildOfClass("TextLabel")
		if #options <= 8 then
			-- Few choices: show them all as chips under the label.
			r.AutomaticSize = Enum.AutomaticSize.Y
			r.Size = UDim2.new(1, -8, 0, 0)
			title.Size = UDim2.new(1, 0, 0, 22)
			local holder = K.new("Frame", {
				Position = UDim2.fromOffset(0, 26),
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
			}, r)
			K.new("UIPadding", { PaddingBottom = UDim.new(0, 6) }, holder)
			K.chips(holder, options, value, pick, display, isAvailable)
		else
			button(r, display(value) .. "  ▼", function()
				expandedChoiceKey = if expandedChoiceKey == label then nil else label
				rebuildPreservingScroll()
			end)
			if expandedChoiceKey == label then
				title.Size = UDim2.new(0.56, 0, 0, 44)
				local menuHeight = math.min(240, #options * 38 + 4)
				r.Size = UDim2.new(1, -8, 0, 48 + menuHeight)
				local choices = K.new("ScrollingFrame", {
					Name = "Choices",
					Position = UDim2.fromOffset(0, 48),
					Size = UDim2.new(1, 0, 0, menuHeight),
					BackgroundColor3 = K.C.Input,
					BorderSizePixel = 0,
					ScrollBarThickness = 4,
					ScrollBarImageColor3 = K.C.Rail,
					AutomaticCanvasSize = Enum.AutomaticSize.Y,
					CanvasSize = UDim2.new(),
				}, r)
				K.corner(choices, 8)
				K.pad(choices, 4, 4)
				K.list(choices, 4)
				for index, option in ipairs(options) do
					local available = not isAvailable or isAvailable(option)
					local b = K.pill(
						choices,
						display(option) .. (if available then "" else "  ·  UNAVAILABLE"),
						function()
							if available then
								pick(option)
							end
						end
					)
					b.Size = UDim2.new(1, -4, 0, 34)
					b.LayoutOrder = index
					b.TextXAlignment = Enum.TextXAlignment.Left
					K.pad(b, 12, 0)
					if option == value then
						b.BackgroundColor3, b.TextColor3 = K.C.Gold, K.C.Backdrop
					elseif not available then
						b.TextColor3 = K.C.Faint
					end
				end
			end
		end
		if help then
			info(help, 34)
		end
		if lockedReason then
			info(lockedReason, 34)
		end
	end
	local function numeric(label, object, key, help)
		local r = row(label)
		local box = inputBox(r, tostring(object[key] or 0))
		box.FocusLost:Connect(function()
			local value = tonumber(box.Text)
			if not value then
				object[key] = nil
				revision += 1
				dirty = true
				message(label .. ": enter a finite number", false)
				return
			end
			object[key] = value
			estimate()
		end)
		if help then
			info(help, 34)
		end
	end
	local function tagList(label, object, key, help)
		local r = row(label)
		local box = inputBox(r, table.concat(object[key] or {}, ", "), "comma-separated tags")
		box.TextSize = 12
		box.FocusLost:Connect(function()
			if object == draft and key == "Tags" then
				local tags, reason = SpellIdentitySpec.parse(box.Text)
				if not tags then
					message(label .. ": " .. tostring(reason), false)
					box.Text = table.concat(object[key] or {}, ", ")
					return
				end
				object[key] = tags
				estimate()
				return
			end
			local tags = {}
			local seen = {}
			for token in string.gmatch(box.Text, "[^,;]+") do
				local tag = string.lower(string.gsub(token, "^%s*(.-)%s*$", "%1"))
				if tag ~= "" and not seen[tag] then
					table.insert(tags, tag)
					seen[tag] = true
				end
			end
			if #tags > EnvironmentRequirementSpec.MaxTags then
				message(label .. ": use at most " .. EnvironmentRequirementSpec.MaxTags .. " tags", false)
				box.Text = table.concat(object[key] or {}, ", ")
				return
			end
			object[key] = tags
			estimate()
		end)
		if help then
			info(help, 34)
		end
	end
	local function assetId(label, object, key, help)
		local r = row(label)
		local box = inputBox(r, object[key] or "", "blank = silent")
		box.FocusLost:Connect(function()
			local value = string.gsub(box.Text, "^%s*(.-)%s*$", "%1")
			if value ~= "" and (#value > 20 or not string.match(value, "^%d+$")) then
				message(label .. ": enter a numeric Roblox audio asset ID", false)
				box.Text = object[key] or ""
				return
			end
			object[key] = value
			revision += 1
			dirty = true
			estimate()
		end)
		if help then
			info(help, 34)
		end
	end
	local function toggle(label, value, change, help)
		local r = row(label)
		local b = K.switch(r, value, function(nextValue)
			change(nextValue)
			rebuild()
			estimate()
		end)
		b.Size = UDim2.new(0, 72, 0, 32)
		b.Position = UDim2.new(1, -72, 0.5, -16)
		if help then
			info(help, 34)
		end
	end
	local function slider(label, object, key, minimum, maximum, help, canEdit)
		local r = row(label)
		local valueLabel = K.text(r, "", 13, K.C.Ink, Enum.Font.GothamBold, {
			Size = UDim2.new(0.12, 0, 1, 0),
			Position = UDim2.new(0.88, 0, 0, 0),
			TextXAlignment = Enum.TextXAlignment.Right,
		})
		local track = K.new("TextButton", {
			Size = UDim2.new(0.27, 0, 0, 8),
			Position = UDim2.new(0.58, 0, 0.5, -4),
			BackgroundColor3 = K.C.Input,
			Text = "",
			AutoButtonColor = false,
			Active = canEdit,
		}, r)
		K.corner(track, 4)
		local fill = K.new("Frame", {
			BackgroundColor3 = if canEdit then K.C.Ember else K.C.Faint,
			Size = UDim2.fromScale(0, 1),
		}, track)
		K.corner(fill, 4)
		local knob = K.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			Position = UDim2.new(0, 0, 0.5, 0),
			BackgroundColor3 = K.C.Gold,
		}, track)
		K.corner(knob, 8)
		local function refresh()
			local alpha = math.clamp((object[key] - minimum) / (maximum - minimum), 0, 1)
			fill.Size = UDim2.new(alpha, 0, 1, 0)
			knob.Position = UDim2.new(alpha, 0, 0.5, 0)
			valueLabel.Text = if minimum >= 1
				then string.format("%.1fx", object[key])
				else string.format("%d%%", math.floor(object[key] * 100 + 0.5))
		end
		refresh()
		if canEdit then
			local dragging = false
			local touchInput
			local function update(positionX)
				local alpha = math.clamp((positionX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				object[key] =
					math.clamp(math.round((minimum + alpha * (maximum - minimum)) * 10) / 10, minimum, maximum)
				refresh()
				estimate()
			end
			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = true
					update(input.Position.X)
				elseif input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					touchInput = input
					update(input.Position.X)
				end
			end)
			local changed = UIS.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input == touchInput) then
					update(input.Position.X)
				end
			end)
			local ended = UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input == touchInput then
					dragging = false
					touchInput = nil
				end
			end)
			track.Destroying:Connect(function()
				changed:Disconnect()
				ended:Disconnect()
			end)
		end
		if help then
			info(help, 38)
		end
	end
	local function hasPayloadAnywhere(kind, excludedEvent)
		for triggerEvent, steps in draft.Triggers or {} do
			if triggerEvent ~= "OnBreak" and triggerEvent ~= excludedEvent then
				for _, step in steps or {} do
					for _, value in step.Payloads or {} do
						if value.Kind == kind then
							return true
						end
					end
				end
			end
		end
		return false
	end
	local function hasConflictingInternalRequirement(principle: string): boolean
		local targetRequiresMatter = draft.Form == "Manipulation"
			or draft.Targeting == "MaterialTarget"
			or (draft.Targeting == "ObjectTarget" and hasPayloadAnywhere("Manipulation"))
		if targetRequiresMatter and principle ~= "Matter" then
			return true
		end
		for _, steps in pairs(draft.Triggers or {}) do
			for _, step in ipairs(steps or {}) do
				for _, value in ipairs(step.Payloads or {}) do
					local definition = Schema.Payloads[value.Kind]
					if definition and definition.Principle and definition.Principle ~= principle then
						return true
					end
					if
						value.DamageChannel == "Physical" and principle ~= "Body"
						or value.DamageChannel == "Soul" and principle ~= "Soul"
					then
						return true
					end
				end
			end
		end
		return false
	end
	local function setInternalDefault(principle: string, expression: string?): boolean
		if not Schema.supportsPrincipleForm(principle, draft.Form) or hasConflictingInternalRequirement(principle) then
			return false
		end
		local selectedExpression = expression or draft.Source.Expression
		if not Schema.expressionMatches(principle, selectedExpression) then
			selectedExpression = Schema.defaultExpression(principle)
		end
		if not selectedExpression then
			return false
		end
		draft.Source.Principle = principle
		draft.Source.Expression = selectedExpression
		return true
	end
	local function supportedEffectEventsForDraft()
		local result = Schema.eventsForEffects(draft.Form, draft.Casting.Mode, draft.Targeting)
		for index = #result, 1, -1 do
			if result[index] == "OnBreak" and not hasPayloadAnywhere("Shield") then
				table.remove(result, index)
			elseif result[index] == "OnCommand" and not hasPayloadAnywhere("Summon", "OnCommand") then
				table.remove(result, index)
			end
		end
		return result
	end
	local function effectEventsForDraft()
		local result = supportedEffectEventsForDraft()
		local available = {}
		for _, eventName in result do
			available[eventName] = true
		end
		for _, eventName in Schema.EventOrder do
			local steps = draft.Triggers[eventName]
			if type(steps) == "table" and #steps > 0 and not available[eventName] then
				table.insert(result, eventName)
				available[eventName] = true
			end
		end
		local unknownEvents = {}
		for eventName, steps in draft.Triggers do
			if type(eventName) == "string" and type(steps) == "table" and #steps > 0 and not available[eventName] then
				table.insert(unknownEvents, eventName)
			end
		end
		table.sort(unknownEvents)
		for _, eventName in unknownEvents do
			table.insert(result, eventName)
		end
		return result
	end
	local function primary()
		draft.Triggers[event] = draft.Triggers[event] or {}
		local selectedIndex = selectedStepByEvent[event]
		local selected = selectedIndex and draft.Triggers[event][selectedIndex]
		if selected and not selected.Behavior then
			return selected
		end
		for _, step in draft.Triggers[event] do
			if not step.Behavior then
				return step
			end
		end
		return nil
	end
	local function payload(kind)
		local step = primary()
		if step then
			for _, p in step.Payloads do
				if p.Kind == kind then
					return p
				end
			end
		end
	end
	local function setPayload(kind, on)
		if
			kind == "Summon"
			and on
			and draft.Form == "Projectile"
			and event == "OnImpact"
			and not hasPayloadAnywhere("Summon")
		then
			-- Projectile drafts default to impact effects. For a first Summon,
			-- prefer the cast event so the configured Caster placement appears
			-- immediately instead of silently waiting for a collision.
			event = "OnCast"
		end
		local step = primary()
		if not step and on then
			step = { Payloads = {} }
			if event == "OnThreshold" then
				step.HealthPercent = 50
			end
			table.insert(draft.Triggers[event], 1, step)
		end
		if not step then
			return
		end
		for i = #step.Payloads, 1, -1 do
			if step.Payloads[i].Kind == kind then
				table.remove(step.Payloads, i)
			end
		end
		if on then
			local definition = Schema.Payloads[kind]
			if definition then
				local requiredPrinciple = definition.Principle or (kind == "Manipulation" and "Matter")
				if requiredPrinciple and requiredPrinciple ~= draft.Source.Principle then
					setInternalDefault(requiredPrinciple, if requiredPrinciple == "Matter" then "Earth" else nil)
				end
				local value = Spec.copy(definition.Defaults)
				value.Kind = kind
				table.insert(step.Payloads, value)
			end
		end
		if #step.Payloads == 0 then
			for i, s in draft.Triggers[event] do
				if s == step then
					table.remove(draft.Triggers[event], i)
					break
				end
			end
		end
		if kind == "Summon" and not on and not hasPayloadAnywhere("Summon", "OnCommand") then
			draft.Triggers.OnCommand = nil
			if event == "OnCommand" then
				event = (Schema.Forms[draft.Form] and Schema.Forms[draft.Form].DefaultEvent) or "OnCast"
			end
		end
		if
			draft.Targeting == "ObjectTarget"
			and (
				draft.Form == "Manipulation"
				or draft.Form == "Projectile"
				or draft.Form == "Beam"
				or draft.Form == "Wave"
			)
		then
			if hasPayloadAnywhere("Manipulation") then
				local options = MaterialSpec.options("Matter", "Earth", draft.Form, draft.Targeting)
				if options[1] then
					draft.Material = draft.Material or { SearchRadius = 12 }
					draft.Material.Material = draft.Material.Material or options[1]
					draft.Material.SearchRadius = draft.Material.SearchRadius or 12
				end
			elseif draft.Material then
				draft.Material.Material = nil
			end
		end
	end
	local function behavior(kind)
		for _, step in draft.Triggers[event] or {} do
			if step.Behavior == kind then
				return step
			end
		end
		return nil
	end
	local function setBehavior(kind, on)
		local steps = draft.Triggers[event] or {}
		draft.Triggers[event] = steps
		for i = #steps, 1, -1 do
			if steps[i].Behavior == kind then
				table.remove(steps, i)
			end
		end
		if not on then
			return
		end
		local definition = Schema.Behaviors[kind]
		if not definition then
			return
		end
		local payloads = {}
		for _, payloadKind in definition.DefaultPayloadKinds or definition.PayloadKinds or {} do
			local payloadDefinition = Schema.Payloads[payloadKind]
			local payloadValue = Spec.copy(payloadDefinition.Defaults)
			payloadValue.Kind = payloadKind
			table.insert(payloads, payloadValue)
		end
		local step = { Behavior = kind, Payloads = payloads }
		for key, value in definition.Defaults do
			step[key] = value
		end
		if kind == "SpawnEffect" then
			step.Effect = Spec.defaultSpawnEffect("Field", draft.Source.Principle)
		end
		table.insert(steps, step)
	end
	-- Which timing of a spawned effect the editor is showing, per SpawnEffect step.
	local spawnedEventFor = setmetatable({}, { __mode = "k" })
	local function projectileBehavior(kind)
		if not draft.Projectile then
			return nil
		end
		for _, behavior in ipairs(draft.Projectile.Behaviors or {}) do
			if behavior.Kind == kind then
				return behavior
			end
		end
		return nil
	end
	local function setProjectileBehavior(kind, on)
		draft.Projectile.Behaviors = draft.Projectile.Behaviors or {}
		for i = #draft.Projectile.Behaviors, 1, -1 do
			if draft.Projectile.Behaviors[i].Kind == kind then
				table.remove(draft.Projectile.Behaviors, i)
			end
		end
		if not on then
			return
		end
		local behavior = ProjectileBehaviorSpec.copyDefaults(kind)
		if behavior then
			table.insert(draft.Projectile.Behaviors, behavior)
		end
	end
	local function mainEvent(form)
		return (Schema.Forms[form] and Schema.Forms[form].DefaultEvent) or "OnCast"
	end
	local function migrateEffects(previous, target)
		-- Keep the user's chosen effects and timing intact. The editor marks any
		-- newly incompatible entry so it can be repaired without losing its work.
		target.Triggers = Spec.copy(previous.Triggers)
	end
	local backButton = button(navigation, "‹  SLOTS", function()
		if standaloneDraft or editingLibraryRecord then
			pageMode = "Library"
		else
			draftsBySlot[selectedSlot] = draft
			pageMode = "Slots"
		end
		scroll.CanvasPosition = Vector2.zero
		rebuild()
	end)
	backButton.Size = UDim2.new(0.16, -4, 1, 0)
	backButton.Position = UDim2.new(0, 0, 0, 0)
	backButton.Font = Enum.Font.GothamBold
	local navigateTab
	local layoutBook = Hub.mountShell(panel, {
		scroll = scroll,
		title = headerTitle,
		summary = headerSummary,
		status = status,
		navigation = navigation,
		closeButton = closeButton,
		homeButton = homeButton,
	}, function(tab)
		navigateTab(tab)
	end)
	local overview = panel:FindFirstChild("LiveSpellSummary")
	if overview then
		editorPreview = Instance.new("Frame")
		editorPreview.Name = "LiveSpellVisualPreview"
		editorPreview.Position = UDim2.fromOffset(12, 38)
		editorPreview.Size = UDim2.new(1, -24, 1, -52)
		editorPreview.Parent = overview
		SpellVisual.render(editorPreview, draft, false)
	end
	updateHeader = function()
		homeButton.Visible = false
		navigation.Visible = false
		backButton.Visible = false
		if actions then
			actions.Visible = false
		end
		if pageMode == "Editor" then
			layoutBook("Editor")
			return
		end
		closeButton.Visible = true
		headerTitle.Visible = true
		headerTitle.Text = if pageMode == "Slots"
			then "Home"
			elseif pageMode == "Library" then (if libraryView.ChoosingSlot
				then "Choose a spell for slot " .. libraryView.ChoosingSlot
				else "Spell library")
			elseif pageMode == "Help" then "How spell creation works"
			elseif pageMode == "Training" then "Training & targets"
			else "Spellcraft"
		headerSummary.Text = if pageMode == "Slots"
			then "Your nine equipped spells and quick actions."
			elseif pageMode == "Training" then "Spawn targets and manage your practice session."
			elseif pageMode == "Help" then "Build spells from actions, triggers, and effects."
			else persistenceState .. "  ·  Library spells are separate from your equipped slots."
		headerSummary.Visible = true
		status.Visible = false
		layoutBook(if pageMode == "Library" and libraryView.Selected then "LibraryDetail" else pageMode)
		scroll.ScrollingEnabled = pageMode ~= "Library" or libraryView.Selected ~= nil
	end
	local function renderField(object, field)
		local options = field.Options
		if options then
			select(field.Label, object[field.Key] or options[1], options, function(value)
				object[field.Key] = value
				if field.Key == "DamageChannel" then
					if value == "Physical" then
						setInternalDefault("Body")
					elseif value == "Soul" then
						setInternalDefault("Soul")
					end
				end
			end, nil, field.Help)
		else
			numeric(
				field.Label,
				object,
				field.Key,
				(field.Help and field.Help .. "  " or "")
					.. string.format("Allowed: %s to %s", tostring(field.Min), tostring(field.Max))
			)
		end
	end
	-- Editor for a whitelisted ALL/ANY/NOT condition tree stored at holder[key].
	-- Used for spell-level conditions and per-step trigger conditions.
	local function renderConditionTree(holder, key, label)
		-- Widgets are read at call time: `rebuild` is assigned after this point.
		return ConditionTreeEditor.render({
			button = button,
			card = card,
			estimate = estimate,
			info = info,
			numeric = numeric,
			rebuild = rebuild,
			row = row,
			select = select,
			toggle = toggle,
		}, holder, key, label)
	end
	local function internalDefaultForForm(formName: string): string
		if Schema.supportsPrincipleForm("Energy", formName) then
			return "Energy"
		end
		for _, value in ipairs(Schema.Principles) do
			if Schema.supportsPrincipleForm(value, formName) then
				return value
			end
		end
		return "Matter"
	end
	local function resetForForm(formName: string, principle: string?, confirmed: boolean?)
		if not confirmed and formName ~= draft.Form and dirtySlots[selectedSlot] then
			confirm(
				"Change the spell Form? Shape settings reset. Existing effects and their timing stay in place; incompatible entries will be flagged for repair.",
				function()
					resetForForm(formName, principle, true)
					rebuild()
					estimate()
				end
			)
			return
		end
		local previous = draft
		local selectedPrinciple = principle or draft.Source.Principle
		if not Schema.supportsPrincipleForm(selectedPrinciple, formName) then
			selectedPrinciple = internalDefaultForForm(formName)
		end
		local nextDraft = Spec.createDraft(formName, selectedPrinciple)
		if not nextDraft then
			return
		end
		nextDraft.Name = previous.Name
		nextDraft.Element = previous.Element
		nextDraft.Visual.Color = previous.Visual.Color
		nextDraft.Visual.ProjectileScale = previous.Visual.ProjectileScale or 1
		nextDraft.Audio = previous.Audio or nextDraft.Audio
		nextDraft.Casting = Spec.copy(previous.Casting)
		if
			formName ~= "Beam"
			and formName ~= "Projectile"
			and formName ~= "Wave"
			and formName ~= "Field"
			and formName ~= "Aura"
			and formName ~= "SelfEnhancement"
			and nextDraft.Casting.Mode == "Channeled"
		then
			nextDraft.Casting.Mode = "Instant"
			nextDraft.Casting.MinimumCharge = nil
			nextDraft.Casting.MaximumCharge = nil
			nextDraft.Casting.ManaUpkeepPerSecond = nil
			nextDraft.Casting.StrainPerSecond = nil
		end
		if nextDraft.Casting.Mode == "Toggle" then
			if CastingSpec.supportsToggle(formName) then
				nextDraft.Lifetime = { Mode = "UntilToggledOff" }
			else
				nextDraft.Casting.Mode = "Instant"
			end
		end
		if nextDraft.Casting.Mode == "CommandCast" and not CastingSpec.supportsCommandCast(formName) then
			nextDraft.Casting.Mode = "Instant"
		end
		if nextDraft.Casting.Mode == "Sustained" and not CastingSpec.supportsSustained(formName) then
			nextDraft.Casting.Mode = "Instant"
			nextDraft.Casting.ManaUpkeepPerSecond = nil
			nextDraft.Casting.StrainPerSecond = nil
		end
		nextDraft.TargetRules = Spec.copy(previous.TargetRules)
		nextDraft.Conditions = Spec.copy(previous.Conditions)
		if nextDraft.Targeting == previous.Targeting then
			if previous.Material then
				nextDraft.Material = Spec.copy(previous.Material)
			end
			if previous.TargetPolicy then
				nextDraft.TargetPolicy = previous.TargetPolicy
			end
		end
		if nextDraft.Lifetime.Mode == "Instantaneous" then
			nextDraft.Casting.ManaUpkeepPerSecond = nil
			nextDraft.Casting.StrainPerSecond = nil
		end
		if formName == previous.Form and previous.Projectile then
			nextDraft.Projectile.Behaviors = Spec.copy(previous.Projectile.Behaviors)
			nextDraft.Projectile.MotionPhases = Spec.copy(previous.Projectile.MotionPhases or {})
		end
		migrateEffects(previous, nextDraft)
		draft = nextDraft
		event = mainEvent(formName)
	end

	local function openSlot(slot)
		standaloneDraft, editingLibraryRecord, editingLibraryId = false, false, nil
		selectedSlot = slot
		draft = draftsBySlot[slot]
			or (equipped[slot] and Spec.copy(equipped[slot]))
			or Spec.createDraft("Projectile", "Energy")
		ensureVisualDefaults(draft)
		draftsBySlot[slot] = draft
		if not equipped[slot] then
			dirtySlots[slot] = true
		end
		dirty = dirtySlots[slot] == true
		event = mainEvent(draft.Form)
		pageMode, activeSection = "Editor", "Setup"
		revision += 1
		appliedRevision = if dirty then -1 else revision
		scroll.CanvasPosition = Vector2.zero
		rebuild()
	end
	local function libraryPage(mode)
		pageMode = mode
		scroll.CanvasPosition = Vector2.zero
		rebuild()
	end
	local function beginCreation(forLibrary, fresh)
		if forLibrary and standaloneWorkingDraft and not fresh then
			draft = Spec.copy(standaloneWorkingDraft)
			ensureVisualDefaults(draft)
			standaloneDraft = true
			editingLibraryRecord, editingLibraryId = false, nil
			event = mainEvent(draft.Form)
			authoringMode = "Guided"
			pageMode, activeSection = "Editor", "Setup"
			dirty = true
			revision += 1
			appliedRevision = -1
			rebuild()
			message("Resumed your unsaved spell draft.", true)
			return
		end
		standaloneDraft = forLibrary
		editingLibraryRecord, editingLibraryId = false, nil
		authoringMode = "Guided"
		local principle = internalDefaultForForm("Projectile")
		draft = Spec.createDraft("Projectile", principle)
		ensureVisualDefaults(draft)
		-- Starter: a projectile that deals damage on impact, ready to test.
		local starterDamage = Spec.copy(Schema.Payloads.Damage.Defaults or {})
		starterDamage.Kind = "Damage"
		draft.Triggers.OnImpact = { { Payloads = { starterDamage } } }
		draft.Name = "New Spell"
		event = mainEvent(draft.Form)
		if standaloneDraft then
			standaloneWorkingDraft = Spec.copy(draft)
			lastWorkingDraftKind = "Standalone"
		else
			draftsBySlot[selectedSlot], dirtySlots[selectedSlot] = draft, true
		end
		pageMode, activeSection = "Editor", "Setup"
		revision += 1
		appliedRevision = -1
		scroll.CanvasPosition = Vector2.zero
		rebuild()
	end

	local function editLibraryRecord(id, definition)
		if standaloneDraft and dirty then
			standaloneWorkingDraft = Spec.copy(draft)
		end
		editingLibraryRecord, editingLibraryId = true, id
		standaloneDraft = false
		draft = Spec.copy(libraryDrafts[id] or definition)
		ensureVisualDefaults(draft)
		event = mainEvent(draft.Form)
		pageMode, activeSection = "Editor", "Setup"
		revision += 1
		dirty = libraryDrafts[id] ~= nil
		appliedRevision = if dirty then -1 else revision
		if dirty then
			lastLibraryDraftId = id
			lastWorkingDraftKind = "Library"
		end
		expertSearch = ""
		scroll.CanvasPosition = Vector2.zero
		rebuild()
	end
	-- "New spell" always starts fresh; a kept draft is resumed separately.
	local function startNewSpell()
		if standaloneWorkingDraft then
			confirm(
				"Start a new spell? Your unsaved draft “"
					.. tostring(standaloneWorkingDraft.Name)
					.. "” will be discarded. Use Resume draft to keep working on it.",
				function()
					standaloneWorkingDraft = nil
					if lastWorkingDraftKind == "Standalone" then
						lastWorkingDraftKind = nil
					end
					beginCreation(true, true)
				end
			)
		else
			beginCreation(true, true)
		end
	end
	local function hasWorkingDraft()
		return standaloneWorkingDraft ~= nil or (lastLibraryDraftId ~= nil and libraryDrafts[lastLibraryDraftId] ~= nil)
	end
	local function resumeWorkingDraft()
		local record = lastLibraryDraftId and libraryView.Catalog.Records[lastLibraryDraftId]
		if lastWorkingDraftKind == "Standalone" and standaloneWorkingDraft then
			draft = Spec.copy(standaloneWorkingDraft)
			standaloneDraft = true
			editingLibraryRecord, editingLibraryId = false, nil
			dirty = true
			event = mainEvent(draft.Form)
			revision += 1
			appliedRevision = -1
			pageMode, activeSection = "Editor", "Setup"
			rebuild()
		elseif record and lastLibraryDraftId and libraryDrafts[lastLibraryDraftId] then
			editLibraryRecord(lastLibraryDraftId, record.Definition)
		else
			pageMode, activeSection = "Library", "Setup"
			rebuild()
		end
	end
	libraryView = LibraryView.new({
		row = row,
		block = canvasBlock,
		width = function()
			return scroll.AbsoluteSize.X
		end,
		height = function()
			return scroll.AbsoluteSize.Y
		end,
		button = button,
		heading = heading,
		select = select,
		info = info,
		showPreview = function(definition)
			if editorPreview then
				SpellVisual.render(editorPreview, definition, false)
			end
			panel:SetAttribute(
				"SpellSummary",
				definition.Name .. "\n" .. definition.Form .. "  ·  " .. definition.Element
			)
		end,
		-- The library draws its own preview; the old book side panel is gone.
		hasSidePreview = function()
			return false
		end,
		confirm = confirm,
		schema = Schema,
		spec = Spec,
		request = request,
		message = message,
		createNew = function()
			libraryView.ChoosingSlot = nil
			startNewSpell()
		end,
		editRecord = editLibraryRecord,
		hasWorkingDraft = function()
			return standaloneWorkingDraft ~= nil or next(libraryDrafts) ~= nil
		end,
		resumeDraft = function()
			resumeWorkingDraft()
		end,
		isDirtyRecord = function(id)
			return libraryDrafts[id] ~= nil
		end,
		rebuild = function()
			rebuild()
		end,
		top = function()
			scroll.CanvasPosition = Vector2.zero
		end,
		slots = function()
			libraryPage("Slots")
		end,
		help = function()
			libraryPage("Help")
		end,
		pendingEdit = function(slot)
			pendingLibraryEdit = slot
		end,
	})
	navigateTab = function(tab)
		if tab == "Forge" then
			if pageMode == "Editor" then
				return
			end
			if hasWorkingDraft() then
				resumeWorkingDraft()
			else
				beginCreation(true, true)
			end
			return
		end
		libraryView.Selected = nil
		libraryView.ChoosingSlot = nil
		pageMode = if tab == "Home"
			then "Slots"
			elseif tab == "Library" then "Library"
			elseif tab == "Training" then "Training"
			else "Help"
		scroll.CanvasPosition = Vector2.zero
		rebuild()
	end
	homeButton.Activated:Connect(function()
		libraryView.Selected = nil
		libraryView.ChoosingSlot = nil
		pageMode = "Slots"
		scroll.CanvasPosition = Vector2.zero
		rebuild()
	end)
	grimoireResponse.OnClientEvent:Connect(function(ok, text, catalog, slots, changedSlot)
		libraryView.receive(ok, text, catalog)
		local completedSlotChoice = ok and changedSlot ~= nil and changedSlot == libraryView.ChoosingSlot
		if completedSlotChoice then
			libraryView.ChoosingSlot = nil
			libraryView.Selected = nil
		end
		local saveMode = pendingLibrarySaveMode
		pendingLibrarySaveMode = nil
		if ok and saveMode == "SaveNew" then
			editingLibraryId = tostring(libraryView.Catalog.NextId - 1)
			editingLibraryRecord = true
			standaloneDraft = false
			if pendingStandaloneSave then
				standaloneWorkingDraft = nil
				if lastWorkingDraftKind == "Standalone" then
					lastWorkingDraftKind = nil
				end
			end
			libraryDrafts[editingLibraryId] = nil
			dirty, appliedRevision = false, revision
		elseif ok and saveMode == "Update" then
			if editingLibraryId then
				libraryDrafts[editingLibraryId] = nil
			end
			dirty, appliedRevision = false, revision
		end
		-- A saved spell is finished: close the forge and drop its working draft
		-- so the next "New spell" starts fresh. Slot work returns Home (the slot
		-- keeps its own draft until equipped); library work returns to My spells.
		local closeAfterSave = ok and saveMode ~= nil and pageMode == "Editor"
		local savedFromSlot = saveMode == "SaveNew" and not pendingStandaloneSave
		if closeAfterSave then
			if lastWorkingDraftKind == "Library" and lastLibraryDraftId == editingLibraryId then
				lastWorkingDraftKind = nil
			end
			editingLibraryRecord, editingLibraryId, standaloneDraft = false, nil, false
			libraryView.Selected = nil
			libraryView.ChoosingSlot = nil
			libraryView.Shelf = "Mine"
			pageMode = if savedFromSlot then "Slots" else "Library"
			scroll.CanvasPosition = Vector2.zero
		end
		pendingStandaloneSave = false
		persistenceState = catalog.SaveState or persistenceState
		for slot = 1, Slots.Count do
			equipped[slot] = slots[tostring(slot)]
			if draftsBySlot[slot] and not dirtySlots[slot] and not applying then
				draftsBySlot[slot] = equipped[slot] and Spec.copy(equipped[slot]) or nil
				if slot == selectedSlot and draftsBySlot[slot] then
					draft = draftsBySlot[slot]
				end
			end
		end
		if ok and changedSlot then
			draftsBySlot[changedSlot], dirtySlots[changedSlot] = nil, nil
		end
		refreshBar()
		if not helpSeen and libraryLoaded then
			helpSeen = true
		end
		if completedSlotChoice then
			pageMode = "Slots"
			scroll.CanvasPosition = Vector2.zero
			requestRebuild()
		elseif pendingLibraryEdit then
			local slot = pendingLibraryEdit
			pendingLibraryEdit = nil
			if ok and changedSlot == slot then
				openSlot(slot)
			end
		elseif pageMode ~= "Editor" then
			requestRebuild()
		end
		updateHeader()
		message(text, ok)
	end)

	rebuild = function()
		mobileEditorPreview = nil
		if not forgeHosted then
			forgeApi = nil
			-- The forge hides the book page; every other page needs it back.
			scroll.Visible = true
			local existingForge = panel:FindFirstChild("GuidedSpellForge")
			if existingForge then
				existingForge:Destroy()
			end
			for _, child in scroll:GetChildren() do
				if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
					child:Destroy()
				end
			end
		end
		visualStudioFrame = nil
		if visualLayoutConnection then
			visualLayoutConnection:Disconnect()
			visualLayoutConnection = nil
		end
		if not forgeHosted then
			order = 0
		end
		currentGroup = nil
		cardPairHolder, cardPairCount, cardPairCards, cardPairLayout = nil, 0, {}, nil
		local function renderTraining()
			heading("TRAINING TARGETS")
			if not RunService:IsStudio() then
				info("Training targets and resource reset controls are available in Studio practice sessions.", 60)
				return
			end
			info(
				"Spawn stationary Humanoid targets on nearby clear ground. Target relationship and other target rules determine which targets your spell can affect.",
				48
			)
			for _, option in
				{
					{ Label = "Spawn ally dummy", Action = "SpawnAlly" },
					{ Label = "Spawn enemy dummy", Action = "SpawnEnemy" },
					{ Label = "Restore my dummies", Action = "ResetMine" },
					{ Label = "Remove my dummies", Action = "ClearMine" },
					{ Label = "Restore health and magic resources", Action = "RestorePlayer" },
					{ Label = "Clear my spells and reset cooldowns", Action = "ClearEffects" },
					{ Label = "Respawn my character", Action = "ResetPlayer" },
					{ Label = "Return to practice start", Action = "ReturnToStart" },
				}
			do
				if option.Action ~= "ReturnToStart" or require(Shared.Configuration.DevelopmentSandbox).Enabled then
					local control = row(option.Label)
					local controlButton = button(control, "RUN", function()
						if option.Action == "ResetPlayer" or option.Action == "ClearEffects" then
							confirm(
								"Run “"
									.. option.Label
									.. "”? Active spells may end through their normal expiry behavior.",
								function()
									trainingRequest:FireServer(option.Action)
								end
							)
						else
							trainingRequest:FireServer(option.Action)
						end
					end)
					controlButton.Font = Enum.Font.GothamBold
				end
			end
			heading("SANDBOX CONTROLS")
			toggle(
				"Show combat feedback messages",
				feedbackVisible,
				function(value)
					feedbackVisible = value
					refreshToast()
				end,
				"Shows damage and invalid-cast feedback briefly during combat. Health bars stay visible on training dummies."
			)
			info(
				"Training dummies are stationary targets. Their health bars show damage and healing; test movement on a movable object or another player. Ending active spells may trigger their On expire effects. Testing continues while this screen is open.",
				96
			)
		end
		if pageMode == "Training" then
			updateHeader()
			renderTraining()
			return
		end
		if pageMode == "Library" then
			updateHeader()
			libraryView.render()
			return
		elseif pageMode == "Help" then
			updateHeader()
			heading("HOW SPELL CREATION WORKS")
			info(
				[[1. NEW SPELL opens the Spell Forge with a starter projectile.
2. The left panel is your spell: what it creates, its triggers (WHEN IT HITS...), and the effects each trigger runs.
3. Select any card to edit only its properties on the right. Use + to attach triggers and effects.
4. ADVANCED adds casting, targeting, condition and appearance cards and shows every setting, with search.
5. TEST SPELL casts it for real; SAVE SPELL stores it in your library; EQUIP puts it in a slot.]],
				180
			)
			info(
				"Guided and Advanced edit the same spell and use the same validation. Keep Draft keeps a session copy; Save Spell stores a valid library record. P returns you to play; open P again to continue.",
				100
			)
			button(row("Start or skip this guide"), "OPEN HOME", function()
				libraryView.dismissHelp()
				libraryPage("Slots")
			end)
			button(row("Browse saved magic"), "OPEN LIBRARY", function()
				libraryPage("Library")
			end)
			heading("TRY A REAL EXAMPLE")
			info(
				"These examples use the same Forms, default effects and validation as your own spells. They create an unsaved draft in the first empty slot and never replace existing work.",
				64
			)
			for _, example in
				{
					{ "Projectile", "Energy", "Damage", "OnImpact", "Practice bolt" },
					{ "Beam", "Body", "Heal", "OnCast", "Healing beam" },
				}
			do
				button(row(example[5]), "CREATE EXAMPLE", function()
					local slot
					for i = 1, libraryView.slotLimit() do
						if not equipped[i] and not draftsBySlot[i] then
							slot = i
							break
						end
					end
					if not slot then
						message("All slots contain work. Save and unequip a slot from the Library first.", false)
						return
					end
					local sample = Spec.createDraft(example[1], example[2])
					sample.Name = example[5]
					local effect = Spec.copy(Schema.Payloads[example[3]].Defaults)
					effect.Kind = example[3]
					sample.Triggers[example[4]] = { { Payloads = { effect } } }
					draftsBySlot[slot], dirtySlots[slot] = sample, true
					openSlot(slot)
					estimate()
				end)
			end
			return
		end
		if pageMode == "Slots" then
			updateHeader()
			local slotData = {}
			for slot = 1, Slots.Count do
				table.insert(slotData, {
					Number = slot,
					Spell = draftsBySlot[slot] or equipped[slot],
					Locked = slot > libraryView.slotLimit(),
					Draft = equipped[slot] == nil and draftsBySlot[slot] ~= nil,
					Selected = slot == selectedSlot and (draftsBySlot[slot] or equipped[slot]) ~= nil,
				})
			end
			order += 1
			Hub.home(scroll, {
				Slots = slotData,
				ResumeDraft = hasWorkingDraft(),
			}, {
				create = startNewSpell,
				resume = resumeWorkingDraft,
				library = function()
					navigateTab("Library")
				end,
				training = function()
					navigateTab("Training")
				end,
				openSlot = function(slotId)
					if slotId > libraryView.slotLimit() then
						message("This loadout slot unlocks with more mission XP.", false)
						return
					end
					if draftsBySlot[slotId] or equipped[slotId] then
						openSlot(slotId)
					else
						selectedSlot = slotId
						libraryView.chooseForSlot(slotId)
						pageMode = "Library"
						scroll.CanvasPosition = Vector2.zero
						rebuild()
					end
				end,
			}, Schema, Spec)
			return
		end
		if pageMode == "Editor" and not forgeHosted then
			updateHeader()
			navigation.Visible = false
			backButton.Visible = false
			if actions then
				actions.Visible = false
			end
			status.Visible = false
			headerTitle.Visible = false
			headerSummary.Visible = false
			homeButton.Visible = false
			closeButton.Visible = false
			scroll.Visible = false
			local _, api = GuidedForge.mount(panel, draft, Schema, Spec, {
				mode = authoringMode,
				-- Draws the real Advanced section editors into a forge inspector
				-- host. Section helpers append to `scroll`, so it points at the
				-- host for one pass and the page state is restored afterwards.
				renderSections = function(host, sections, sectionEvent, search, startOrder)
					local savedScroll, savedSection, savedEvent, savedSearch =
						scroll, activeSection, event, expertSearch
					local savedOrder, savedGroup = order, currentGroup
					local savedMode = authoringMode
					forgeHosted = true
					authoringMode = "Expert"
					scroll = host
					expertSearch = search or ""
					order = startOrder or 0
					local finalOrder = order
					local ok, failure = pcall(function()
						for _, sectionId in sections do
							activeSection = sectionId
							if sectionEvent then
								event = sectionEvent
							end
							currentGroup = nil
							cardPairHolder, cardPairCount, cardPairCards, cardPairLayout = nil, 0, {}, nil
							rebuild()
						end
						finalOrder = order
					end)
					scroll, activeSection, expertSearch = savedScroll, savedSection, savedSearch
					if not sectionEvent then
						event = savedEvent
					end
					order, currentGroup = savedOrder, savedGroup
					authoringMode = savedMode
					forgeHosted = false
					if not ok then
						warn("Spell Forge advanced section failed: " .. tostring(failure))
					end
					return finalOrder
				end,
				change = function()
					estimate()
					updateHeader()
				end,
				changeForm = function(formName, principle)
					local previousDraft = draft
					resetForForm(formName, principle, true)
					if draft ~= previousDraft then
						local replacement = draft
						table.clear(previousDraft)
						for key, value in pairs(replacement) do
							previousDraft[key] = value
						end
						draft = previousDraft
					end
					estimate()
				end,
				save = function()
					if saveLibraryButton then
						saveLibraryButton:Activate()
					end
				end,
				keep = function()
					if standaloneDraft then
						standaloneWorkingDraft = Spec.copy(draft)
						lastWorkingDraftKind = "Standalone"
					elseif editingLibraryRecord and editingLibraryId then
						libraryDrafts[editingLibraryId] = Spec.copy(draft)
						lastLibraryDraftId = editingLibraryId
						lastWorkingDraftKind = "Library"
					else
						draftsBySlot[selectedSlot] = Spec.copy(draft)
						dirtySlots[selectedSlot] = true
					end
					dirty = true
					message("Draft kept for this session. Resume it from Home or the Forge tab.", true)
				end,
				load = function()
					libraryView.Selected = nil
					libraryPage("Library")
				end,
				advanced = function()
					authoringMode = if authoringMode == "Expert" then "Guided" else "Expert"
					expertSearch = ""
					rebuild()
				end,
				test = function()
					apply(true)
				end,
				equip = if not standaloneDraft and not editingLibraryRecord
					then function()
						apply(false)
					end
					else nil,
				equipLabel = "EQUIP · SLOT " .. tostring(selectedSlot),
				close = function()
					visibility(false)
				end,
				spawnTarget = if trainingRequest and RunService:IsStudio()
					then function()
						trainingRequest:FireServer("SpawnEnemy")
					end
					else nil,
				back = function()
					if standaloneDraft then
						standaloneWorkingDraft = Spec.copy(draft)
						lastWorkingDraftKind = "Standalone"
					elseif editingLibraryRecord and editingLibraryId then
						libraryDrafts[editingLibraryId] = Spec.copy(draft)
					end
					libraryView.Selected = nil
					libraryView.ChoosingSlot = nil
					pageMode = "Slots"
					rebuild()
				end,
			})
			forgeApi = api
			return
		end
		local form = Schema.Forms[draft.Form]
		if not form then
			activeSection = "Setup"
			info("This spell Form has no editor definition yet.")
			updateHeader()
			return
		end
		local effectEvents = effectEventsForDraft()
		if #effectEvents > 0 and not table.find(effectEvents, event) then
			event = form.DefaultEvent or effectEvents[1]
		end
		updateHeader()
		panel:SetAttribute("SpellSummary", draft.Name .. "\n" .. draft.Form .. "  ·  " .. draft.Element)
		if editorPreview then
			SpellVisual.render(editorPreview, draft, false)
		end
		-- Editor sections run only hosted inside the Spell Forge inspector
		-- (see renderSections); the forge owns Form choice, search and validation.

		local function showFields(object, fields)
			for _, field in fields do
				renderField(object, field)
			end
		end
		if activeSection == "Setup" or activeSection == "Casting" then
			if activeSection == "Setup" then
				heading("NAME & ORGANIZATION")
				local nameRow = row("Spell name")
				local nameBox = Instance.new("TextBox")
				nameBox.Size = UDim2.new(0.4, 0, 1, 0)
				nameBox.Position = UDim2.new(0.59, 0, 0, 0)
				nameBox.Text = draft.Name
				nameBox.ClearTextOnFocus = false
				nameBox.TextSize = 14
				nameBox.TextColor3 = Theme.Ink
				nameBox.BackgroundColor3 = Theme.Surface
				nameBox.BorderColor3, nameBox.BorderSizePixel = Theme.Border, 1
				nameBox.Parent = nameRow
				nameBox.FocusLost:Connect(function()
					draft.Name = SpellIdentitySpec.normalizeName(nameBox.Text) or draft.Name
					nameBox.Text = draft.Name
					estimate()
					updateHeader()
				end)
				tagList(
					"Spell tags",
					draft,
					"Tags",
					"Optional labels to organize spells, such as fire or support. These do not add effects. Up to 16 tags, 48 characters each."
				)
				select(
					"Element",
					draft.Element,
					Schema.Elements,
					function(value)
						draft.Element = value
						draft.Visual.Color = Elements[value]
					end,
					nil,
					"If the spell deals Elemental damage, this decides which resistance protects the target: Fire resistance reduces Fire damage, for example. It also sets the main color. Choosing an Element does not add damage or burning; add effects separately."
				)
			end
			if activeSection == "Casting" then
				heading("CASTING STYLE")
				local castStyles = { "Instant", "Charged", "HoldAndRelease" }
				if CastingSpec.supportsChannel(draft.Form) then
					table.insert(castStyles, "Channeled")
				end
				if CastingSpec.supportsToggle(draft.Form) then
					table.insert(castStyles, "Toggle")
				end
				if CastingSpec.supportsCommandCast(draft.Form) then
					table.insert(castStyles, "CommandCast")
				end
				if CastingSpec.supportsSustained(draft.Form) then
					table.insert(castStyles, "Sustained")
				end
				select(
					"Cast style",
					draft.Casting.Mode,
					castStyles,
					function(value)
						local previousMode = draft.Casting.Mode
						draft.Casting.Mode = value
						if value ~= "Instant" and draft.Beam and draft.Beam.Pattern == "Cascade" then
							draft.Beam.Pattern = "Single"
						end
						if CastingSpec.isChargeMode(value) then
							draft.Casting.MinimumCharge = 0.2
							draft.Casting.MaximumCharge = 1.2
							if CastingSpec.isHeldMode(previousMode) then
								draft.Casting.ManaUpkeepPerSecond = nil
								draft.Casting.StrainPerSecond = nil
							end
							if draft.Form == "Beam" or draft.Form == "Wave" then
								draft.Lifetime = { Mode = "Instantaneous" }
								draft.Casting.ManaUpkeepPerSecond = nil
								draft.Casting.StrainPerSecond = nil
							end
						elseif value == "Channeled" then
							draft.Casting.MinimumCharge = nil
							draft.Casting.MaximumCharge = nil
							draft.Casting.ManaUpkeepPerSecond = 45
							draft.Lifetime = { Mode = "FixedDuration", Duration = 5 }
						elseif value == "Toggle" then
							local endWhen = draft.Lifetime.EndWhen
							draft.Casting.MinimumCharge = nil
							draft.Casting.MaximumCharge = nil
							if CastingSpec.isHeldMode(previousMode) then
								draft.Casting.ManaUpkeepPerSecond = nil
								draft.Casting.StrainPerSecond = nil
							end
							draft.Lifetime = { Mode = "UntilToggledOff", EndWhen = endWhen }
						elseif value == "CommandCast" then
							draft.Casting.MinimumCharge = nil
							draft.Casting.MaximumCharge = nil
							if CastingSpec.isHeldMode(previousMode) then
								draft.Casting.ManaUpkeepPerSecond = nil
								draft.Casting.StrainPerSecond = nil
							end
							if draft.Form == "Beam" or draft.Form == "Wave" then
								draft.Lifetime = { Mode = "Instantaneous" }
							end
						elseif value == "Sustained" then
							draft.Casting.MinimumCharge = nil
							draft.Casting.MaximumCharge = nil
							if CastingSpec.isHeldMode(previousMode) then
								draft.Casting.ManaUpkeepPerSecond = nil
								draft.Casting.StrainPerSecond = nil
							end
							draft.Casting.ManaUpkeepPerSecond = 45
							draft.Lifetime = { Mode = "FixedDuration", Duration = 5 }
						else
							draft.Casting.MinimumCharge = nil
							draft.Casting.MaximumCharge = nil
							if CastingSpec.isHeldMode(previousMode) then
								draft.Casting.ManaUpkeepPerSecond = nil
								draft.Casting.StrainPerSecond = nil
							end
							if draft.Form == "Beam" or draft.Form == "Wave" then
								draft.Lifetime = { Mode = "Instantaneous" }
								draft.Casting.ManaUpkeepPerSecond = nil
								draft.Casting.StrainPerSecond = nil
							end
						end
					end,
					nil,
					"Instant resolves on press. Charged auto-releases at full charge; HoldAndRelease waits for key-up at full charge (up to 8 seconds). Channeled repeats while held. Sustained holds a Construct in the world until release or expiry. Toggle starts a supported persistent effect; cast the same slot again to stop it. CommandCast is summon-only and runs on owner Attack/Support orders."
				)
				if draft.Casting.Mode == "CommandCast" then
					info(
						"Assign this spell through a Summon payload's companion slot. Summons wait without acquiring targets until you issue Attack or Support. Direct player casting is rejected by the server.",
						48
					)
				end
				toggle("Interrupt windup if damaged", draft.Casting.InterruptOnDamage == true, function(value)
					draft.Casting.InterruptOnDamage = value
				end, "Cancels a charged or gathering cast if the caster takes health damage before release.")
				numeric(
					"Movement interrupt distance (0 disables)",
					draft.Casting,
					"InterruptMoveDistance",
					"Cancels a gathering cast if the caster moves farther than this many studs before it resolves."
				)
				toggle(
					"Allow movement while casting",
					draft.Casting.CanMoveWhileCasting ~= false,
					function(value)
						draft.Casting.CanMoveWhileCasting = value
					end,
					"When off, the server temporarily prevents walking, jumping, and dashing during charge, gather, and held channels."
				)
				numeric(
					"Movement penalty (0–0.9)",
					draft.Casting,
					"MovementPenalty",
					"Reduces normal and sprint speed by this fraction while casting when movement is allowed. It composes with sprint and Body Enhancement."
				)
				toggle(
					"Allow rotation while casting",
					draft.Casting.CanRotateWhileCasting ~= false,
					function(value)
						draft.Casting.CanRotateWhileCasting = value
					end,
					"Turn off to lock your aim while preparing or holding this spell. Turn on to keep aiming as you cast."
				)
				toggle("Requires a free hand", draft.Casting.RequiresFreeHand == true, function(value)
					draft.Casting.RequiresFreeHand = value
				end, "When on, you need at least one free hand to start and keep using this spell.")
				heading("SPECIAL RESOURCE COSTS")
				info(
					"Optional named resource costs are separate from Mana and Strain. The server checks and spends each configured pool when this spell is cast.",
					44
				)
				draft.Cost.SpecialResources = draft.Cost.SpecialResources or {}
				for _, resourceId in ipairs(SpecialResourceSpec.order(SpecialResourceDefinitions)) do
					local resource = SpecialResourceDefinitions[resourceId]
					numeric(
						resource.Label .. " cost (0 disables)",
						draft.Cost.SpecialResources,
						resourceId,
						"Spends this amount from the caster's "
							.. resource.Label
							.. " pool. Current pool value is available as the "
							.. resource.Attribute
							.. " player attribute."
					)
				end
				heading("ENVIRONMENT REQUIREMENTS")
				info(
					"Optional server-checked cast limits. Zone tags come from tagged MagicEnvironmentZone parts; time windows may cross midnight.",
					48
				)
				draft.EnvironmentRequirements = draft.EnvironmentRequirements or {}
				local environmentRequirements = draft.EnvironmentRequirements
				toggle("Require solid ground", environmentRequirements.RequireGrounded == true, function(value)
					environmentRequirements.RequireGrounded = if value then true else nil
				end, "Rejects casts while the caster is airborne.")
				toggle(
					"Limit by time of day",
					environmentRequirements.ClockTime ~= nil,
					function(value)
						environmentRequirements.ClockTime = if value then { Start = 6, End = 18 } else nil
					end,
					"Uses Lighting.ClockTime from the server. If the start is later than the end, the window crosses midnight."
				)
				if environmentRequirements.ClockTime then
					numeric(
						"Time window start (0–24)",
						environmentRequirements.ClockTime,
						"Start",
						"Inclusive Roblox clock hour."
					)
					numeric(
						"Time window end (0–24)",
						environmentRequirements.ClockTime,
						"End",
						"Inclusive Roblox clock hour."
					)
				end
				environmentRequirements.ZoneTags = environmentRequirements.ZoneTags or { Required = {}, Forbidden = {} }
				tagList(
					"Required zone tags",
					environmentRequirements.ZoneTags,
					"Required",
					"Comma-separated tags that must exist on the caster's current MagicEnvironmentZone."
				)
				tagList(
					"Forbidden zone tags",
					environmentRequirements.ZoneTags,
					"Forbidden",
					"Comma-separated tags that block casting in matching zones."
				)
				if CastingSpec.isChargeMode(draft.Casting.Mode) then
					info(
						if draft.Casting.Mode == "Charged"
							then "The spell releases automatically at maximum charge."
							else "The spell holds at maximum charge until key-up; it cancels if not released within 8 seconds.",
						38
					)
					numeric(
						"Minimum charge time",
						draft.Casting,
						"MinimumCharge",
						"Minimum hold time before the spell can be released."
					)
					numeric(
						"Maximum charge time",
						draft.Casting,
						"MaximumCharge",
						"Charged releases at this time; HoldAndRelease waits here until you release the key."
					)
				end
				if
					LifetimeSpec.supports(draft.Form, "UntilToggledOff")
					and draft.Casting.Mode ~= "Channeled"
					and draft.Casting.Mode ~= "Toggle"
					and draft.Casting.Mode ~= "Sustained"
				then
					toggle(
						"Remain active until toggled off",
						draft.Lifetime.Mode == "UntilToggledOff",
						function(value)
							local endWhen = draft.Lifetime.EndWhen
							draft.Lifetime = if value
								then { Mode = "UntilToggledOff", EndWhen = endWhen }
								else { Mode = "FixedDuration", Duration = 10, EndWhen = endWhen }
						end,
						"Fields, Auras, Self Enhancements, and Constructs stay active until you cast the same spell again."
					)
				end
				if
					LifetimeSpec.supports(draft.Form, "UntilDestroyed")
					and not CastingSpec.isHeldMode(draft.Casting.Mode)
				then
					local destroyedLabel = if draft.Form == "Construct"
						then "Remain active until the Construct is destroyed"
						else "Remain active until the area marker is destroyed"
					local destroyedHelp = if draft.Form == "Construct"
						then "The server keeps this Construct until its model is removed, the caster is cleaned up, or another active lifetime condition ends it."
						else "The server keeps this Field/Aura active until its world marker is removed, the caster is cleaned up, or another active lifetime condition ends it."
					toggle(destroyedLabel, draft.Lifetime.Mode == "UntilDestroyed", function(value)
						local endWhen = draft.Lifetime.EndWhen
						draft.Lifetime = if value
							then { Mode = "UntilDestroyed", EndWhen = endWhen }
							else { Mode = "FixedDuration", Duration = 10, EndWhen = endWhen }
					end, destroyedHelp)
				end
				if draft.Form == "Construct" and not CastingSpec.isHeldMode(draft.Casting.Mode) then
					toggle(
						"Persist in this place between servers",
						draft.Lifetime.Mode == "Persistent",
						function(value)
							draft.Lifetime = if value
								then { Mode = "Persistent" }
								else { Mode = "FixedDuration", Duration = 10 }
						end,
						"Saves this static Construct to this place's server DataStore and restores it when a server starts. It has no gameplay triggers; destroy its model in Workspace to remove the saved record."
					)
				end
				if
					LifetimeSpec.supports(draft.Form, "UntilResourceDepleted")
					and not CastingSpec.isHeldMode(draft.Casting.Mode)
				then
					toggle(
						"Remain active until mana is depleted",
						draft.Lifetime.Mode == "UntilResourceDepleted",
						function(value)
							local endWhen = draft.Lifetime.EndWhen
							draft.Lifetime = if value
								then { Mode = "UntilResourceDepleted", EndWhen = endWhen }
								else { Mode = "FixedDuration", Duration = 10, EndWhen = endWhen }
						end,
						"The server pays mana upkeep while active and runs this Form's normal expiry cleanup when mana runs out. Set Mana upkeep per second above zero."
					)
				end
				local conditionBoundChannel = draft.Casting.Mode == "Channeled"
				if
					LifetimeSpec.supports(draft.Form, "UntilConditionFails")
					and (not CastingSpec.isHeldMode(draft.Casting.Mode) or conditionBoundChannel)
				then
					toggle(
						"Remain active while a condition stays true",
						draft.Lifetime.Mode == "UntilConditionFails",
						function(value)
							local endWhen = draft.Lifetime.EndWhen
							local duration = if draft.Lifetime.Mode == "UntilConditionFails"
								then draft.Lifetime.Duration
								else nil
							if value and endWhen == nil then
								endWhen = { Family = "Resource", Property = "Mana", Operator = ">", Value = 0 }
							end
							draft.Lifetime = if value
								then {
									Mode = "UntilConditionFails",
									EndWhen = endWhen,
									Duration = if draft.Form == "Projectile"
										then duration or 3
										elseif conditionBoundChannel then duration or 10
										else duration,
								}
								else { Mode = "FixedDuration", Duration = 10, EndWhen = endWhen }
						end,
						"This active effect is kept alive only while its server-checked condition remains true. The condition must already be true when you cast."
					)
				end
				local canEndOnTargetLoss = LifetimeSpec.supportsTargeting(
					draft.Form,
					"UntilTargetLost",
					draft.Targeting,
					draft.Form == "Field" and draft.Field.FollowTarget == true,
					draft.TargetPolicy == "MaintainTarget"
				)
				if canEndOnTargetLoss and not CastingSpec.isHeldMode(draft.Casting.Mode) then
					toggle(
						"Remain active until its target is lost",
						draft.Lifetime.Mode == "UntilTargetLost",
						function(value)
							local endWhen = draft.Lifetime.EndWhen
							draft.Lifetime = if value
								then { Mode = "UntilTargetLost", EndWhen = endWhen }
								else { Mode = "FixedDuration", Duration = 10, EndWhen = endWhen }
						end,
						"Follow the selected character/object and run ordinary expiry cleanup when it is removed or no longer valid. Fields require Follow selected target to be enabled."
					)
				end
				if draft.Lifetime.Mode == "FixedDuration" then
					numeric(
						"Active duration (seconds)",
						draft.Lifetime,
						"Duration",
						"How long this enhancement remains active after casting."
					)
				elseif draft.Lifetime.Mode == "UntilConditionFails" then
					if draft.Form == "Projectile" or conditionBoundChannel then
						numeric(
							if draft.Form == "Projectile"
								then "Maximum flight time (seconds)"
								else "Maximum channel duration (seconds)",
							draft.Lifetime,
							"Duration",
							if draft.Form == "Projectile"
								then "Hard safety cap for this projectile, even while its keep-alive condition remains true."
								else "Hard safety cap for this channel, even while its keep-alive condition remains true."
						)
					else
						toggle(
							"Also expire after a maximum duration",
							draft.Lifetime.Duration ~= nil,
							function(value)
								draft.Lifetime.Duration = if value then 10 else nil
							end,
							"Combine the keep-alive condition with a hard time limit. Either ending rule expires the effect."
						)
						if draft.Lifetime.Duration ~= nil then
							numeric(
								"Maximum active duration (seconds)",
								draft.Lifetime,
								"Duration",
								"The first of this timer or the keep-alive condition ending expires the effect."
							)
						end
					end
				end
				if draft.Lifetime.Mode ~= "Instantaneous" and draft.Lifetime.Mode ~= "Persistent" then
					local endRule = draft.Lifetime.EndWhen
					local simpleRule = endRule and endRule.Operator == nil and endRule.Family ~= nil
					local mustRemainTrue = draft.Lifetime.Mode == "UntilConditionFails"
					if mustRemainTrue then
						info(
							"Required keep-alive condition: this spell can only start while the condition is true, then expires when it becomes false.",
							42
						)
					else
						toggle("End when a condition is met", endRule ~= nil, function(value)
							if value then
								draft.Lifetime.EndWhen = endRule
									or {
										Family = "Caster",
										Property = "HealthPercent",
										Operator = "<=",
										Value = 0.25,
									}
							else
								draft.Lifetime.EndWhen = nil
							end
						end, "The effect checks this server-side while active, then runs its normal expiry cleanup.")
					end
					if endRule and simpleRule then
						local propertyOptions = {}
						for familyName, family in ConditionSpec.Properties do
							if ConditionSpec.EndConditionFamilies[familyName] then
								for propertyName, descriptor in family do
									if
										descriptor.Kind == "Number"
										or descriptor.Kind == "Boolean"
										or descriptor.Kind == "String"
									then
										table.insert(propertyOptions, { Family = familyName, Property = propertyName })
									end
								end
							end
						end
						table.sort(propertyOptions, function(a, b)
							return a.Family == b.Family and a.Property < b.Property or a.Family < b.Family
						end)
						select(
							"Condition",
							{ Family = endRule.Family, Property = endRule.Property },
							propertyOptions,
							function(option)
								local descriptor = ConditionSpec.Properties[option.Family][option.Property]
								draft.Lifetime.EndWhen = {
									Family = option.Family,
									Property = option.Property,
									Operator = if descriptor.Kind == "Number" then "<=" else "==",
									Value = if descriptor.Kind == "Number"
										then (descriptor.Min or 0)
										elseif descriptor.Kind == "Boolean" then true
										else "",
								}
							end,
							function(option)
								return option.Family .. " · " .. option.Property
							end
						)
						local descriptor = ConditionSpec.Properties[endRule.Family]
							and ConditionSpec.Properties[endRule.Family][endRule.Property]
						if descriptor then
							select("Comparison", endRule.Operator, descriptor.Operators, function(option)
								endRule.Operator = option
							end)
							if descriptor.Kind == "Number" then
								numeric("Value", endRule, "Value", "Compare against this number.")
							elseif descriptor.Kind == "Boolean" then
								toggle("Value is true", endRule.Value == true, function(value)
									endRule.Value = value
								end)
							else
								local valueRow = row("Text value")
								local box = Instance.new("TextBox")
								box.Size = UDim2.new(0.4, 0, 1, 0)
								box.Position = UDim2.new(0.59, 0, 0, 0)
								box.BackgroundColor3 = Theme.Surface
								box.TextColor3 = Theme.Ink
								box.BorderColor3, box.BorderSizePixel = Theme.Border, 1
								box.TextSize = 14
								box.ClearTextOnFocus = false
								box.Text = tostring(endRule.Value or "")
								box.Parent = valueRow
								box.FocusLost:Connect(function()
									endRule.Value = string.sub(box.Text, 1, descriptor.MaxLength)
									revision += 1
									dirty = true
								end)
							end
						end
					elseif endRule then
						info(
							if mustRemainTrue
								then "This saved keep-alive condition uses a grouped rule. Edit its condition tree in the Conditions section."
								else "This saved condition uses a grouped rule. Disable it to replace it with a single editable condition.",
							42
						)
					end
				end
			end
		end
		if activeSection == "Setup" then
			heading("FORM SETTINGS · SIZE, REACH & MOVEMENT")
			if draft.Form == "Field" or draft.Form == "Aura" then
				local area = draft[draft.Form]
				select("Area geometry", draft.Geometry, form.GeometryOptions, function(shape)
					local interval = area.Interval
					local yaw = area.Yaw or 0
					local followTarget = area.FollowTarget == true
					local debugHeight = if draft.Form == "Field" then area.DebugHeight else nil
					draft.Geometry = shape
					if shape == "Sphere" then
						area = { Radius = 8, Interval = interval, Yaw = yaw, FollowTarget = followTarget }
					elseif shape == "Capsule" then
						area = { Radius = 3, Height = 14, Interval = interval, Yaw = yaw, FollowTarget = followTarget }
					elseif shape == "Cylinder" then
						area = { Radius = 8, Height = 6, Interval = interval, Yaw = yaw, FollowTarget = followTarget }
					elseif shape == "Cone" then
						area = {
							Range = 12,
							Angle = 70,
							Height = 6,
							Interval = interval,
							Yaw = yaw,
							FollowTarget = followTarget,
						}
					elseif shape == "Ring" then
						area = {
							InnerRadius = 3,
							OuterRadius = 8,
							Height = 6,
							Interval = interval,
							Yaw = yaw,
							FollowTarget = followTarget,
						}
					elseif shape == "Plane" then
						area = {
							Width = 12,
							Height = 8,
							Thickness = 1,
							Interval = interval,
							Yaw = yaw,
							FollowTarget = followTarget,
						}
					elseif shape == "Line" then
						area = {
							Width = 4,
							Height = 6,
							Range = 16,
							Interval = interval,
							Yaw = yaw,
							FollowTarget = followTarget,
						}
					else
						area = {
							Width = 12,
							Height = 6,
							Depth = 12,
							Interval = interval,
							Yaw = yaw,
							FollowTarget = followTarget,
						}
					end
					if draft.Form == "Field" then
						area.DebugHeight = debugHeight or 0.2
					end
					draft[draft.Form] = area
				end, nil, "Choose the server hit shape. Visual scale does not change these dimensions.")
				if draft.Geometry == "Sphere" then
					numeric("Radius", area, "Radius")
				elseif draft.Geometry == "Capsule" then
					numeric("Radius", area, "Radius", "Radius of the rounded ends and cylindrical center.")
					numeric(
						"Overall height",
						area,
						"Height",
						"Total height including both rounded ends. Must be at least twice the radius."
					)
				elseif draft.Geometry == "Cylinder" then
					numeric("Radius", area, "Radius")
					numeric("Height", area, "Height")
				elseif draft.Geometry == "Cone" then
					numeric("Reach", area, "Range", "Forward distance from the area origin.")
					numeric("Angle", area, "Angle", "Full horizontal cone angle in degrees (5–120).")
					numeric("Height", area, "Height", "Vertical thickness of the cone volume.")
				elseif draft.Geometry == "Ring" then
					numeric("Safe center radius", area, "InnerRadius", "Targets inside this radius are excluded.")
					numeric("Outer radius", area, "OuterRadius", "Maximum distance from the center affected.")
					numeric("Height", area, "Height", "Vertical thickness of the ring volume.")
				elseif draft.Geometry == "Plane" then
					numeric("Width", area, "Width", "Horizontal width of the vertical hit volume.")
					numeric("Height", area, "Height", "Vertical height of the hit volume.")
					numeric("Thickness", area, "Thickness", "Depth of the hit volume; this does not block movement.")
				elseif draft.Geometry == "Line" then
					numeric("Corridor width", area, "Width", "Side-to-side width of the forward corridor.")
					numeric("Corridor height", area, "Height", "Vertical thickness of the forward corridor.")
					numeric("Reach", area, "Range", "Forward distance from the area origin.")
				else
					numeric("Width", area, "Width")
					numeric("Height", area, "Height")
					numeric("Depth", area, "Depth")
				end
				numeric("Pulse interval", area, "Interval")
				if
					draft.Geometry == "Box"
					or draft.Geometry == "Cone"
					or draft.Geometry == "Plane"
					or draft.Geometry == "Line"
				then
					numeric(
						"Yaw (degrees)",
						area,
						"Yaw",
						"Rotate the hit volume around world vertical (-180° to 180°)."
					)
				end
				if draft.Form == "Field" then
					if draft.Targeting == "EntityTarget" or draft.Targeting == "ObjectTarget" then
						toggle(
							"Follow selected target",
							area.FollowTarget == true,
							function(value)
								area.FollowTarget = value
								if not value and draft.Lifetime.Mode == "UntilTargetLost" then
									draft.Lifetime = {
										Mode = "FixedDuration",
										Duration = 10,
										EndWhen = draft.Lifetime.EndWhen,
									}
								end
								dirty = true
								revision += 1
								estimate()
							end,
							"Attach this Field to the selected character or surface. It ends safely if that target is removed or invalidated."
						)
					end
					numeric(
						"Debug marker height",
						area,
						"DebugHeight",
						"Presentation only; it does not change hit detection."
					)
				end
			elseif draft.Form == "Construct" then
				select(
					"Construct geometry",
					draft.Geometry,
					form.GeometryOptions,
					function(shape)
						draft.Geometry = shape
						if shape == "Custom" and #(draft.Construct.Components or {}) == 0 then
							draft.Construct.Components = { Spec.copy(ConstructGeometrySpec.DefaultCustomComponent) }
						end
					end,
					nil,
					"Choose a primitive or bounded multi-part template. Width, Height, and Depth set its overall size."
				)
				showFields(draft.Construct, form.Mechanics)
				if draft.Construct.GrowthDuration and draft.Construct.GrowthDuration > 0 then
					info(
						"The solid construct grows over time. The server pauses growth when its expanded collision bounds would enter another solid or character.",
						42
					)
				end
				if draft.Geometry == "Custom" then
					draft.Construct.Components = draft.Construct.Components or {}
					info(
						"Compose up to five primitive parts inside the Construct envelope. Size and offset values are fractions of its Width, Height, and Depth; rotated bounds must stay inside the envelope.",
						48
					)
					for index, component in ipairs(draft.Construct.Components) do
						heading("CUSTOM PART " .. index)
						local componentRow = row("Primitive")
						button(componentRow, "REMOVE", function()
							table.remove(draft.Construct.Components, index)
							dirty = true
							revision += 1
							rebuild()
							estimate()
						end)
						select("Part shape", component.Shape, ConstructGeometrySpec.PrimitiveOrder, function(value)
							component.Shape = value
						end)
						for axis, label in ipairs({ "X", "Y", "Z" }) do
							numeric(
								label .. " size fraction",
								component,
								"Size" .. label,
								"Part dimension as a fraction of the matching envelope dimension (0.05–1)."
							)
							numeric(
								label .. " center offset",
								component,
								"Offset" .. label,
								"Part center as a fraction of the envelope dimension (-0.5–0.5)."
							)
							numeric(
								label .. " rotation",
								component,
								"Rotation" .. label,
								"Part rotation in degrees (-180–180)."
							)
						end
						local componentDuration = component.Duration ~= nil
						card(
							"Independent part expiry",
							"Expire this primitive before the rest of the Construct.",
							componentDuration,
							function(enabled)
								component.Duration = if enabled then 3 else nil
							end
						)
						if componentDuration then
							numeric(
								"Part lifetime (seconds)",
								component,
								"Duration",
								"This primitive disappears independently after 0.1–"
									.. ConstructGeometrySpec.MaxComponentLifetime
									.. " seconds. Blank it to inherit the Construct lifetime."
							)
						end
					end
					local customComponents = draft.Construct.Components
					local addComponentRow = row("Add custom primitive")
					button(
						addComponentRow,
						#customComponents < ConstructGeometrySpec.MaxCustomComponents and "ADD PART" or "LIMIT",
						function()
							if #customComponents >= ConstructGeometrySpec.MaxCustomComponents then
								return
							end
							table.insert(customComponents, Spec.copy(ConstructGeometrySpec.DefaultCustomComponent))
							dirty = true
							rebuild()
							estimate()
						end
					)
				end
			elseif draft.Form == "Beam" then
				select(
					"Beam pattern",
					draft.Beam.Pattern or "Single",
					if draft.Casting.Mode == "Instant" then { "Single", "Cascade" } else { "Single" },
					function(pattern)
						draft.Beam.Pattern = pattern
						dirty = true
					end,
					nil,
					"Single is one aimed Beam. Cascade sends a short, server-timed sequence of vertical Beams around the aim point. Every strike uses world obstruction and the same OnImpact effects."
				)
				local fields = {}
				for _, field in form.Mechanics do
					if field.Key == "Range" or field.Key == "Width" or field.Key == "DebugDuration" then
						table.insert(fields, field)
					elseif field.Key == "Interval" and draft.Casting.Mode == "Channeled" then
						table.insert(fields, field)
					elseif
						field.Key == "GrowthStartScale"
						or field.Key == "GrowthEndScale"
						or field.Key == "GrowthDuration"
					then
						if draft.Casting.Mode == "Channeled" then
							table.insert(fields, field)
						end
					elseif field.Key == "Pattern" then
						-- Pattern is selected above so its help stays visible without duplicating the selector.
					elseif draft.Beam.Pattern == "Cascade" and draft.Casting.Mode == "Instant" then
						table.insert(fields, field)
					end
				end
				showFields(draft.Beam, fields)
			elseif draft.Form == "Wave" then
				select(
					"Wave shape",
					draft.Geometry,
					form.GeometryOptions,
					function(shape)
						draft.Geometry = shape
						revision += 1
						dirty = true
					end,
					nil,
					"Cone follows your aim. Sphere reaches equally in every direction for Humanoid targets. ObjectTarget continues to use its validated aim ray."
				)
				local fields = {}
				for _, field in form.Mechanics do
					if field.Key ~= "Dot" or draft.Geometry == "Cone" then
						if field.Key ~= "Interval" or draft.Casting.Mode == "Channeled" then
							table.insert(fields, field)
						end
					end
				end
				showFields(draft.Wave, fields)
			elseif #form.Mechanics > 0 then
				for _, field in form.Mechanics do
					if
						(field.Key ~= "Interval" and field.Key ~= "ChannelInterval")
						or draft.Casting.Mode == "Channeled"
						or draft.Form == "Field"
						or draft.Form == "Aura"
					then
						showFields(draft[field.Object], { field })
					end
				end
			else
				info("This Form has no extra shape or movement settings.", 38)
			end
		elseif activeSection == "Targeting" then
			heading("TARGETING")
			info(form.Description, 48)
			heading("TARGETING MODES")
			for _, mode in Schema.TargetingModeOrder do
				local definition = Schema.TargetingModes[mode]
				local available = form.Targeting[mode] == true
				local unavailableReason = "This Form does not support this targeting mode."
				local materialObjectTarget = mode == "ObjectTarget"
					and draft.Form ~= "Construct"
					and draft.Form ~= "Field"
					and draft.Form ~= "Aura"
				local objectPhysicsTarget = mode == "ObjectTarget"
					and (draft.Form == "Projectile" or draft.Form == "Beam" or draft.Form == "Wave")
				if mode == "MaterialTarget" or (materialObjectTarget and not objectPhysicsTarget) then
					available = available and #MaterialSpec.options("Matter", "Earth", draft.Form, mode) > 0
					if form.Targeting[mode] and not available then
						unavailableReason = "This Form cannot act on this kind of tagged material object."
					end
				end
				card(definition.Label, definition.Description, draft.Targeting == mode, function()
					draft.Targeting = mode
					if mode == "MaterialTarget" or (mode == "ObjectTarget" and draft.Form == "Manipulation") then
						setInternalDefault("Matter", "Earth")
					end
					draft.TargetPolicy = if mode == "EntityTarget" then "Aim" else nil
					if
						not LifetimeSpec.supportsTargeting(
							draft.Form,
							draft.Lifetime.Mode,
							mode,
							draft.Form == "Field" and draft.Field.FollowTarget == true
						)
					then
						local endWhen = draft.Lifetime.EndWhen
						draft.Lifetime = { Mode = "FixedDuration", Duration = 10, EndWhen = endWhen }
					end
					if mode == "ObjectTarget" and draft.Form == "Manipulation" then
						draft.Material = if hasPayloadAnywhere("Manipulation")
							then {
								Material = MaterialSpec.options("Matter", "Earth", draft.Form, mode)[1],
								SearchRadius = 12,
							}
							else { SearchRadius = 12 }
					elseif objectPhysicsTarget then
						local options = MaterialSpec.options("Matter", "Earth", draft.Form, mode)
						draft.Material = if hasPayloadAnywhere("Manipulation") and options[1]
							then { Material = options[1], SearchRadius = 12 }
							else nil
					elseif
						mode == "ObjectTarget"
						and (draft.Form == "Construct" or draft.Form == "Field" or draft.Form == "Aura")
					then
						draft.Material = nil
					elseif mode == "MaterialTarget" or mode == "ObjectTarget" then
						draft.Material = {
							Material = MaterialSpec.options("Matter", "Earth", draft.Form, mode)[1],
							Amount = if draft.Form ~= "Manipulation" then 1 else nil,
							SearchRadius = 12,
						}
					else
						draft.Material = nil
					end
				end, available, unavailableReason)
			end
			if draft.Targeting == "EntityTarget" then
				local targetPolicies = if draft.Form == "Projectile"
					then Schema.TargetPolicyOrder
					else { "Aim", "LockOn", "AimOrLockOn" }
				select("Entity target policy", draft.TargetPolicy or "Aim", targetPolicies, function(value)
					draft.TargetPolicy = value
					if value ~= "MaintainTarget" and draft.Lifetime.Mode == "UntilTargetLost" then
						draft.Lifetime = {
							Mode = "FixedDuration",
							Duration = draft.Lifetime.Duration or 3,
							EndWhen = draft.Lifetime.EndWhen,
						}
					end
				end, function(value)
					return value
				end, Schema.TargetPolicies[draft.TargetPolicy or "Aim"])
				if draft.TargetPolicy == "MaintainTarget" then
					info(
						"Requires Homing. The projectile keeps the selected target without reacquiring; choose UntilTargetLost if it should expire when the target disappears.",
						42
					)
				end
			end
			if
				draft.Targeting == "ObjectTarget"
				and (draft.Form == "Projectile" or draft.Form == "Beam" or draft.Form == "Wave")
			then
				info(
					"The server affects only the exact authorized object under your aim, within TargetRules and Form reach. Force and Physical control need a movable tagged part. Material manipulation uses only Raise and also needs matching MagicMaterial and MagicRaise authorization.",
					48
				)
			end
			if draft.Material then
				local genericObjectPhysicsTarget = (
					draft.Form == "Manipulation"
					or draft.Form == "Projectile"
					or draft.Form == "Beam"
					or draft.Form == "Wave"
				)
					and draft.Targeting == "ObjectTarget"
					and draft.Material.Material == nil
				if genericObjectPhysicsTarget then
					info(
						"Force and Physical control can target a movable, non-character part tagged MagicManipulable. The server checks reach, aim, and obstruction.",
						48
					)
					numeric(
						"Movable object reach",
						draft.Material,
						"SearchRadius",
						"Maximum distance to the exact selected object; the server checks aim and obstruction."
					)
				else
					local materialOptions = MaterialSpec.options("Matter", "Earth", draft.Form, draft.Targeting)
					if #materialOptions > 0 then
						select(
							"Required material",
							draft.Material.Material,
							materialOptions,
							function(value)
								draft.Material.Material = value
							end,
							MaterialSpec.label,
							if draft.Targeting == "ObjectTarget"
								then "The selected part must carry this exact MagicMaterial tag and MagicRaise authorization."
								else "A nearby tagged object must have this material type and enough remaining amount."
						)
					else
						info("This Form and target mode have no compatible tagged material objects.", 38)
					end
					numeric(
						"Material search radius",
						draft.Material,
						"SearchRadius",
						"How far from the aim point the spell searches for usable material."
					)
					if draft.Targeting == "MaterialTarget" and draft.Form ~= "Manipulation" then
						numeric(
							"Material consumed",
							draft.Material,
							"Amount",
							"Amount of eligible material consumed when this cast succeeds."
						)
					end
				end
			end
			if form.TargetRules then
				heading("TARGET LIMITS")
				numeric(
					"Maximum reach (studs)",
					draft.TargetRules,
					"Range",
					"Farthest distance this spell may affect a target."
				)
				numeric(
					"Maximum targets",
					draft.TargetRules,
					"MaxTargets",
					"How many characters can be affected at once. Repeating spells check again on later pulses."
				)
				toggle("Require clear line of sight", draft.TargetRules.RequiresLineOfSight, function(value)
					draft.TargetRules.RequiresLineOfSight = value
				end, "When enabled, blocking world geometry prevents the spell from reaching a target.")
				select(
					"Target relationship",
					draft.TargetRules.Relationship or "Any",
					Schema.TargetRelationshipOrder,
					function(value)
						draft.TargetRules.Relationship = value
					end,
					function(value)
						return value
					end,
					Schema.TargetRelationships[draft.TargetRules.Relationship or "Any"]
				)
				if form.CanIncludeCaster then
					toggle("Include yourself in this area", draft.TargetRules.IncludeCaster, function(value)
						draft.TargetRules.IncludeCaster = value
					end, "Allows area payloads, including damage or control, to affect your own character.")
				end
				toggle(
					"Require target consent",
					draft.TargetRules.RequiresConsent,
					function(value)
						draft.TargetRules.RequiresConsent = value
					end,
					"When enabled, player characters are affected only if they have opted in. NPCs and training dummies are not gated."
				)
			end
			if draft.Proximity then
				heading("ACTIVE PROXIMITY")
				numeric(
					"Approach radius (studs)",
					draft.Proximity,
					"Radius",
					"Maximum distance from the active Self Enhancement's caster or Construct where a target can trigger OnProximity."
				)
				numeric(
					"Proximity sample interval (seconds)",
					draft.Proximity,
					"Interval",
					"Minimum time between server target queries for this active effect."
				)
				numeric(
					"Maximum proximity targets",
					draft.Proximity,
					"MaxTargets",
					"Maximum distinct Humanoids that can trigger OnProximity for this active effect."
				)
			end
		elseif activeSection == "Conditions" then
			local applicable = {}
			for _, condition in Schema.Conditions do
				if condition.Forms[draft.Form] then
					table.insert(applicable, condition)
				end
			end
			if #applicable > 0 then
				heading("OPTIONAL CAST RULES")
				if draft.Conditions.Operator == nil then
					for _, condition in applicable do
						local enabled = table.find(draft.Conditions, condition.Id) ~= nil
						card(condition.Label, condition.Description, enabled, function(value)
							local index = table.find(draft.Conditions, condition.Id)
							if index then
								table.remove(draft.Conditions, index)
							end
							if value then
								table.insert(draft.Conditions, condition.Id)
							end
						end)
					end
					card(
						"Use advanced condition rules",
						"Build server-checked ALL/ANY/NOT rules from safe runtime properties such as health, relationship, resources, status, material, and distance.",
						false,
						function()
							draft.Conditions = ConditionTree.newGroup("ALL")
						end
					)
				else
					info(
						"Environment.ZoneTags reads the selected MagicEnvironmentZone part's MagicZoneTags attribute (comma/semicolon separated). Status rules include shield, slow, bind, reveal, and MagicArmor.",
						44
					)
					renderConditionTree(draft, "Conditions")
					card(
						"Return to simple cast rules",
						"Discard this advanced condition tree and return to the simple cast rules.",
						false,
						function()
							draft.Conditions = {}
						end
					)
				end
			end
		elseif activeSection == "ChooseEffects" or activeSection == "ConfigureEffects" then
			local configuring = activeSection == "ConfigureEffects"
			heading(if configuring then "SPELL EFFECT COMPOSER" else "CHOOSE COMPATIBLE EFFECTS")
			if configuring then
				info(
					"Read the spell from top to bottom. WHEN starts a timing; ALSO means another independent step runs at that same timing. IF marks a conditional branch. The server validates and executes these exact saved steps.",
					56
				)
				heading("ACTION MAP")
				local actionBlocks = ActionFlow.build(draft, Schema, effectEventsForDraft())
				for _, block in ipairs(actionBlocks) do
					local selected = event == block.Event and selectedStepByEvent[block.Event] == block.StepIndex
					local label = string.format(
						"%s · %s  ›  %s%s",
						block.Relation,
						string.upper(block.EventLabel),
						block.Title,
						if block.HasCondition then "  ·  " .. block.ConditionLabel else ""
					)
					local actionNode = row(label)
					actionNode.Name = "ActionBlock_" .. block.Event .. "_" .. tostring(block.StepIndex)
					local editAction = button(actionNode, if selected then "SELECTED" else "EDIT", function()
						event = block.Event
						selectedStepByEvent[block.Event] = block.StepIndex
						rebuildPreservingScroll()
					end)
					editAction.Size = UDim2.fromOffset(92, 30)
				end
				if #actionBlocks == 0 then
					info("No actions yet. Choose a timing and add an effect to create the first action block.", 36)
				end
				local compositionCount = 0
				local orderedEvents = effectEventsForDraft()
				for _, eventName in ipairs(orderedEvents) do
					local steps = draft.Triggers[eventName] or {}
					local eventPayloadCount = 0
					for _, step in ipairs(steps) do
						for _, selectedPayload in ipairs(step.Payloads or {}) do
							eventPayloadCount += 1
						end
					end
					if eventPayloadCount > 0 then
						compositionCount += eventPayloadCount
						local eventLabel = Schema.EventLabels[eventName] or eventName
						local node = row(
							"WHEN · "
								.. string.upper(eventLabel)
								.. "   ›   "
								.. tostring(eventPayloadCount)
								.. " effect(s)"
						)
						node.Size = UDim2.new(1, -8, 0, 42)
						local jump = button(node, if event == eventName then "SELECTED" else "EDIT NODE", function()
							event = eventName
							rebuildPreservingScroll()
						end)
						jump.Size = UDim2.fromOffset(106, 30)
						for _, step in ipairs(steps) do
							for _, selectedPayload in ipairs(step.Payloads or {}) do
								local definition = Schema.Payloads[selectedPayload.Kind]
								local title = definition and definition.Label or selectedPayload.Kind or "Effect"
								local effectNode = row("      └  " .. tostring(title))
								effectNode.Size = UDim2.new(1, -8, 0, 34)
								local edit = button(effectNode, "EDIT", function()
									event = eventName
									activeSection = "ConfigureEffects"
									rebuildPreservingScroll()
								end)
								edit.Size = UDim2.fromOffset(70, 28)
							end
						end
					end
				end
				if compositionCount == 0 then
					info(
						"No gameplay effects yet. Choose an event below, then switch to Choose Effects to add compatible outcomes.",
						40
					)
				end
			end
			if configuring then
				heading("SELECTED EVENT NODE")
			end
			local supportedEvents = supportedEffectEventsForDraft()
			local availableEvents = effectEventsForDraft()
			select(
				"Effect timing",
				event,
				availableEvents,
				function(value)
					event = value
				end,
				function(value)
					local label = Schema.EventLabels[value] or value
					return if table.find(supportedEvents, value) then label else "Unavailable: " .. label
				end,
				if configuring
					then "The selected effects below run at this timing. Choose another timing to configure its effects, or return to Choose Effects to add outcomes."
					else "Choose when something should happen, then add one or more outcomes below. For example, On impact can make a Projectile damage a target when it hits."
			)
			if not table.find(supportedEvents, event) then
				info(
					"This saved timing is unsupported by the current Form/targeting mode. Remove its effects here or restore a compatible targeting mode before saving.",
					44
				)
			end
			if configuring then
				info(Schema.EventDescriptions[event] or "Effects run when this Form resolves its target.", 40)
				local steps = draft.Triggers[event] or {}
				local selectedIndex = selectedStepByEvent[event]
				if not selectedIndex or not steps[selectedIndex] then
					for index, step in ipairs(steps) do
						if not step.Behavior then
							selectedStepByEvent[event] = index
							selectedIndex = index
							break
						end
					end
				end
				local selectedStep = selectedIndex and steps[selectedIndex]
				if selectedStep and not selectedStep.Behavior then
					local stepTools = row("EDITING ACTION " .. tostring(selectedIndex) .. " OF " .. tostring(#steps))
					if selectedIndex > 1 then
						local moveUp = button(stepTools, "MOVE UP", function()
							steps[selectedIndex], steps[selectedIndex - 1] =
								steps[selectedIndex - 1], steps[selectedIndex]
							selectedStepByEvent[event] = selectedIndex - 1
							estimate()
							rebuildPreservingScroll()
						end)
						moveUp.Size = UDim2.fromOffset(86, 30)
					end
					local removeStep = button(stepTools, "REMOVE", function()
						table.remove(steps, selectedIndex)
						selectedStepByEvent[event] = math.max(1, selectedIndex - 1)
						estimate()
						rebuildPreservingScroll()
					end)
					removeStep.Size = UDim2.fromOffset(78, 30)
				end
				local canAdd, addReason = ActionFlow.canAddStep(draft, event, Config.MaxSteps)
				local addRow = row("Add another independent action at this same timing")
				local addStep = button(addRow, if canAdd then "+ ADD ALSO" else "STEP LIMIT", function()
					if not canAdd then
						message(addReason or "No more actions can be added here.", false)
						return
					end
					local sourceStep = primary()
					local added = if sourceStep then Spec.copy(sourceStep) else { Payloads = {} }
					added.Condition = nil
					table.insert(steps, added)
					selectedStepByEvent[event] = #steps
					estimate()
					rebuildPreservingScroll()
				end)
				addStep.Size = UDim2.fromOffset(124, 32)
				-- Branches are ordinary steps with a Condition: the IF branch
				-- starts as a copy of the selected step; OTHERWISE copies it with
				-- the exact inverse condition, so exactly one of the pair runs.
				local branchSource = (selectedIndex and steps[selectedIndex]) or primary()
				local branchRow = row("Add a conditional branch at this timing")
				local addBranch = button(branchRow, if canAdd then "+ ADD IF" else "STEP LIMIT", function()
					if not canAdd then
						message(addReason or "No more actions can be added here.", false)
						return
					end
					local added = if branchSource then Spec.copy(branchSource) else { Payloads = {} }
					added.Condition = ActionFlow.branchCondition()
					table.insert(steps, added)
					selectedStepByEvent[event] = #steps
					estimate()
					rebuildPreservingScroll()
				end)
				addBranch.Size = UDim2.fromOffset(110, 32)
				if branchSource and branchSource.Condition then
					local otherwiseCondition, otherwiseReason =
						ActionFlow.otherwise(branchSource.Condition, ConditionSpec.MaxDepth)
					local otherwiseRow = row("Add the opposite branch: runs when this step's condition fails")
					local addOtherwise = button(
						otherwiseRow,
						if canAdd and otherwiseCondition then "+ OTHERWISE" else "UNAVAILABLE",
						function()
							if not canAdd or not otherwiseCondition then
								message(otherwiseReason or addReason or "No more actions can be added here.", false)
								return
							end
							local added = Spec.copy(branchSource)
							added.Condition = otherwiseCondition
							table.insert(steps, added)
							selectedStepByEvent[event] = #steps
							estimate()
							rebuildPreservingScroll()
						end
					)
					addOtherwise.Size = UDim2.fromOffset(124, 32)
				end
				if not canAdd then
					info(addReason or "This timing cannot accept another action.", 34)
				end
			end
			if configuring and event == "OnThreshold" then
				local thresholdStep = primary()
				if thresholdStep then
					numeric(
						"Health threshold percent",
						thresholdStep,
						"HealthPercent",
						"This step runs once when its spell damage crosses from above this target-health percentage to at or below it. Use a unique whole percentage for each step."
					)
				else
					info("Add a payload below to create a threshold step, then set its health percentage.", 34)
				end
			end
			if configuring and event == "OnCommand" then
				local commandStep = primary()
				if commandStep then
					local options = { "Any" }
					for _, command in Schema.CommandOrder do
						table.insert(options, command)
					end
					select("Command filter", commandStep.Command or "Any", options, function(value)
						commandStep.Command = if value == "Any" then nil else value
					end, function(value)
						return value
					end, "Any runs for each accepted order; choose one order to run this step only for that command.")
				else
					info("Add a payload to create a command-trigger step, then optionally filter by command.", 34)
				end
			end
			if configuring and event == "OnTargetDeath" then
				local deathStep = primary()
				if deathStep then
					select(
						"Death cause",
						deathStep.DeathMode or "Either",
						Schema.TargetDeathModes,
						function(value)
							deathStep.DeathMode = if value == "Either" then nil else value
						end,
						nil,
						"Choose whether this step runs when this spell gets the defeating blow, when another cause kills someone this active spell affected, or either way."
					)
				else
					info("Add a payload below to create an OnTargetDeath step and choose its cause.", 34)
				end
			end
			if not configuring then
				info(Schema.EventDescriptions[event] or "Effects run when this Form resolves its target.", 40)
			end
			for _, category in ipairs(EffectCategoryOrder) do
				local kinds = {}
				for kind, definition in Schema.Payloads do
					if effectCategory(kind) == category then
						table.insert(kinds, kind)
					end
				end
				table.sort(kinds)
				local hasSelectedEffect = false
				for _, kind in ipairs(kinds) do
					if payload(kind) then
						hasSelectedEffect = true
						break
					end
				end
				if not configuring or hasSelectedEffect then
					heading(string.upper(category))
					if not configuring then
						local categoryDescriptions = {
							Damage = "Hurt targets immediately or over time.",
							Healing = "Restore health or help a target recover.",
							Defense = "Shield targets or improve defensive attributes.",
							Control = "Push, pull, slow, bind, or otherwise limit movement.",
							Movement = "Change how a target moves through the world.",
							Summoning = "Create a companion with a bounded lifetime and behavior.",
							Utility = "Reveal, transform, or interact with prepared objects.",
						}
						info(
							categoryDescriptions[category] or "Effects describe the gameplay outcomes of the spell.",
							34
						)
					end
					for _, kind in kinds do
						local definition = Schema.Payloads[kind]
						local value = payload(kind)
						if not configuring or value ~= nil then
							local objectInteractionOnly = draft.Targeting == "ObjectTarget"
								and (draft.Form == "Projectile" or draft.Form == "Beam" or draft.Form == "Wave")
							local formAndTargetCompatible = (
								not objectInteractionOnly
								or kind == "Force"
								or kind == "Control"
								or kind == "Manipulation"
							)
								and (
									kind ~= "Manipulation"
									or draft.Form == "Manipulation"
									or draft.Targeting == "ObjectTarget"
								)
							local capabilityCompatible = Schema.supportsPayloadCapability(kind, draft.Form, event)
							local available = (capabilityCompatible and formAndTargetCompatible) or value ~= nil
							local reason = if kind == "Manipulation"
									and (draft.Form == "Projectile" or draft.Form == "Beam" or draft.Form == "Wave")
									and draft.Targeting ~= "ObjectTarget"
								then "Requires ObjectTarget so the server can validate the exact manipulated part."
								elseif
									objectInteractionOnly
									and kind ~= "Force"
									and kind ~= "Control"
									and kind ~= "Manipulation"
								then "Aimed object Forms allow Force, Control, or authorized material Manipulation."
								elseif
									not definition.TargetIndependent
									and (not form.TargetTypes or not form.TargetTypes.Humanoid)
								then "This Form does not resolve Humanoid targets."
								elseif
									definition.Events[draft.Form]
								then "Available on a different event for this Form."
								else "This effect cannot run with the current Form, target mode, or timing. Choose a compatible combination."
							if not configuring then
								card(definition.Label, definition.Description, value ~= nil, function(enabled)
									setPayload(kind, enabled)
								end, available, reason)
							elseif value then
								heading(definition.Label)
								info(definition.Description, 38)
								if not capabilityCompatible or not formAndTargetCompatible then
									info(
										"This selected effect is incompatible with the current Form, target mode, or timing. "
											.. reason,
										52
									)
								end
							end
							if configuring and value then
								if kind == "Summon" then
									heading("HOW SUMMONS WORK")
									info(
										"CURRENT TRIGGER: "
											.. event
											.. (if draft.Form == "Projectile" and event == "OnImpact"
												then " — waits for the projectile to collide. Choose OnCast to summon as soon as you cast."
												else " — the summon appears when this event occurs.")
											.. " Spawn position (Caster or Event) controls where it appears, not when. Repeated Event triggers add members up to the cap; Caster placement refreshes one group. Assign a spell slot and choose Hunter to let companions seek visible hostiles near their spawn points.",
										76
									)
									for _, field in definition.Fields do
										if
											(field.Key ~= "Duration" and field.Key ~= "RespawnPolicy")
											or (field.Key == "Duration" and (value.LifetimeMode or "FixedDuration") == "FixedDuration")
											or (
												field.Key == "RespawnPolicy"
												and (value.LifetimeMode or "FixedDuration") == "UntilCommanded"
											)
										then
											if field.Key == "LifetimeMode" then
												local previous = value.LifetimeMode or "FixedDuration"
												select(field.Label, previous, field.Options, function(selected)
													value.LifetimeMode = selected
													if selected == "UntilCommanded" then
														value.Duration = nil
														value.RespawnPolicy = value.RespawnPolicy or "DismissOnDeath"
													elseif value.Duration == nil then
														value.Duration = 30
														value.RespawnPolicy = "DismissOnDeath"
													end
												end, nil, field.Help)
											elseif field.Key == "SpellSlot" then
												select(
													field.Label,
													value.SpellSlot or "None",
													field.Options,
													function(selected)
														value.SpellSlot = if selected == "None" then nil else selected
													end,
													nil,
													field.Help
												)
											else
												renderField(value, field)
											end
										end
									end
									local companionSlot = tonumber(value.SpellSlot)
									local companion = if companionSlot then equipped[companionSlot] else nil
									local assignedProfile, assignedReason = nil, nil
									if companion then
										assignedProfile, assignedReason =
											CompanionSpellPolicy.classify(Spec.normalize(companion))
									end
									if not companionSlot then
										local noSpellHelp = if value.Role == "Medic"
											then "No companion spell assigned. Medic stays idle until you choose an equipped Ally spell with Heal, Restoration, or Shield."
											elseif
												value.Role == "Controller"
											then "No companion spell assigned. Controller stays idle until you choose an equipped hostile-control spell."
											else "No companion spell assigned. This is valid: Guardian/Hunter uses its basic attack. Choose an equipped spell slot only if you want it to cast magic."
										info(noSpellHelp, 54)
									elseif not companion then
										info(
											string.format(
												"Slot %d is empty. Equip a spell there in the spell slots, or choose None.",
												companionSlot
											),
											48
										)
									elseif not assignedProfile then
										info(
											string.format(
												"Slot %d · %s cannot be cast by a companion: %s",
												companionSlot,
												companion.Name,
												assignedReason or "incompatible spell"
											),
											54
										)
									elseif
										value.Role == "Medic"
										and (
											assignedProfile.Mode ~= "Ally"
											or (
												not assignedProfile.CanHeal
												and not assignedProfile.CanShield
												and not assignedProfile.CanModifyAttribute
											)
										)
									then
										info(
											string.format(
												"Slot %d · %s is not a healing/protection spell. Medic requires an Ally spell with Heal, Restoration, Shield, or a positive armor modifier.",
												companionSlot,
												companion.Name
											),
											54
										)
									elseif value.Role == "Controller" and not assignedProfile.CanControl then
										info(
											string.format(
												"Slot %d · %s does not have a control effect. Controller requires hostile Slow, Bind, Control, or Displacement.",
												companionSlot,
												companion.Name
											),
											54
										)
									else
										info(
											string.format(
												"Ready · slot %d: %s (%s, %s target). Use Protect/Attack for hostile spells or Support for Ally spells. Companions use your normal magic resource limits.",
												companionSlot,
												companion.Name,
												companion.Form,
												assignedProfile.Mode
											),
											54
										)
									end
								else
									showFields(value, definition.Fields)
								end
							end
						end
					end
				end
			end
			if configuring then
				local conditionSteps = draft.Triggers[event] or {}
				local conditionIndex = selectedStepByEvent[event]
				if not conditionIndex or not conditionSteps[conditionIndex] then
					conditionIndex = if #conditionSteps > 0 then 1 else nil
				end
				local selectedConditionStep = conditionIndex and conditionSteps[conditionIndex]
				if selectedConditionStep then
					local step = selectedConditionStep
					local stepIndex = conditionIndex :: number
					local behaviorDefinition = step.Behavior and Schema.Behaviors[step.Behavior]
					local stepLabel = (if behaviorDefinition then behaviorDefinition.Label else "Effects")
						.. " step "
						.. tostring(stepIndex)
					heading("STEP CONDITION · " .. string.upper(stepLabel))
					if step.Condition then
						info(
							"This step only runs for event targets that pass. Target rules check each target; caster and spell rules apply to the whole step.",
							40
						)
						renderConditionTree(step, "Condition", stepLabel)
						card(
							"Remove step condition · " .. stepLabel,
							"Run this step unconditionally again.",
							false,
							function()
								step.Condition = nil
							end
						)
					else
						card(
							"Only when a condition passes · " .. stepLabel,
							"Branch this step on target health, relationship, status, resources, or spell state.",
							false,
							function()
								step.Condition = ConditionTree.newGroup("ALL")
							end
						)
					end
				end
			end
			local behaviorKinds = {}
			for kind in Schema.Behaviors do
				table.insert(behaviorKinds, kind)
			end
			table.sort(behaviorKinds)
			if not configuring then
				heading("TRIGGER BEHAVIORS")
				info("Optional behavior choices change how compatible effects resolve.", 42)
			end
			for _, kind in behaviorKinds do
				local definition = Schema.Behaviors[kind]
				local objectPhysicsOnly = draft.Targeting == "ObjectTarget"
					and (draft.Form == "Projectile" or draft.Form == "Beam" or draft.Form == "Wave")
				local current = behavior(kind)
				local available = (not objectPhysicsOnly and Schema.supportsBehavior(kind, draft.Form, event))
					or current ~= nil
				local reason = if not table.find(form.Events, event)
					then "This Form does not run effects at this timing."
					else "This behavior is incompatible with the current Form or timing."
				if not configuring then
					card(definition.Label, definition.Description, current ~= nil, function(enabled)
						setBehavior(kind, enabled)
					end, available, reason)
				elseif current then
					heading(definition.Label)
					info(definition.Description, 38)
					showFields(current, definition.Fields)
					current.Payloads = current.Payloads or {}
					if kind == "SpawnEffect" then
						current.Effect = current.Effect or Spec.defaultSpawnEffect("Field", draft.Source.Principle)
						local spawnForms = {}
						for _, formName in Spec.SpawnForms do
							if Schema.supportsPrincipleForm(draft.Source.Principle, formName) then
								table.insert(spawnForms, formName)
							end
						end
						select("Spawned Form", current.Effect.Form, spawnForms, function(value)
							if value ~= current.Effect.Form then
								current.Effect = Spec.defaultSpawnEffect(value, draft.Source.Principle)
								spawnedEventFor[current] = nil
							end
						end, function(value)
							return Schema.Forms[value].Label
						end, "A Projectile travels on its own, a Field stays and pulses, and a Wave sweeps once.")
						local effect = current.Effect
						local childForm = Schema.Forms[effect.Form]
						heading("SPAWNED " .. string.upper(childForm.Label) .. " SETTINGS")
						for _, field in childForm.Mechanics or {} do
							if
								field.Object == effect.Form
								and effect[effect.Form]
								and effect[effect.Form][field.Key] ~= nil
							then
								renderField(effect[effect.Form], field)
							end
						end
						if effect.Lifetime.Mode == "FixedDuration" then
							numeric(
								"Spawned duration",
								effect.Lifetime,
								"Duration",
								string.format(
									"Seconds the spawned effect lasts. Allowed: 0.1 to %s",
									tostring(Config.MaxDuration)
								)
							)
						end
						local childEvents = Schema.eventsForEffects(effect.Form, "Instant")
						local childEvent = spawnedEventFor[current]
						if not table.find(childEvents, childEvent) then
							childEvent = if table.find(childEvents, childForm.DefaultEvent)
								then childForm.DefaultEvent
								else childEvents[1]
						end
						spawnedEventFor[current] = childEvent
						select("Spawned effect timing", childEvent, childEvents, function(value)
							spawnedEventFor[current] = value
						end, function(value)
							return Schema.EventLabels[value] or value
						end, "The spawned effect has its own timings and effects, separate from this spell.")
						if childEvent then
							effect.Triggers = effect.Triggers or {}
							local function childPayload(payloadKind)
								for _, step in ipairs(effect.Triggers[childEvent] or {}) do
									if not step.Behavior then
										for index, value in ipairs(step.Payloads or {}) do
											if value.Kind == payloadKind then
												return value, step, index
											end
										end
									end
								end
								return nil, nil, nil
							end
							for _, payloadKind in Schema.payloadsFor(effect.Form, childEvent) do
								local payloadDefinition = Schema.Payloads[payloadKind]
								local fits = payloadKind ~= "Summon"
									and (
										payloadDefinition.Principle == nil
										or payloadDefinition.Principle == draft.Source.Principle
									)
								local value = childPayload(payloadKind)
								if fits or value then
									toggle(payloadDefinition.Label .. " · spawned", value ~= nil, function(on)
										local existing, owner, at = childPayload(payloadKind)
										if on and not existing then
											local steps = effect.Triggers[childEvent] or {}
											effect.Triggers[childEvent] = steps
											local target = nil
											for _, candidate in ipairs(steps) do
												if not candidate.Behavior then
													target = candidate
													break
												end
											end
											if not target then
												target = { Payloads = {} }
												table.insert(steps, 1, target)
											end
											if #target.Payloads < Config.MaxPayloads then
												local added = Spec.copy(payloadDefinition.Defaults or {})
												added.Kind = payloadKind
												table.insert(target.Payloads, added)
											end
										elseif not on and existing and owner and at then
											table.remove(owner.Payloads, at)
											if #owner.Payloads == 0 then
												local steps = effect.Triggers[childEvent]
												table.remove(steps, table.find(steps, owner))
												if #steps == 0 then
													effect.Triggers[childEvent] = nil
												end
											end
										end
										dirty = true
										revision += 1
									end)
									if value then
										showFields(value, payloadDefinition.Fields)
									end
								end
							end
						end
					end
					local function blastPayload(payloadKind)
						for index, value in current.Payloads do
							if value.Kind == payloadKind then
								return value, index
							end
						end
						return nil, nil
					end
					for _, payloadKind in definition.PayloadKinds or {} do
						local payloadDefinition = Schema.Payloads[payloadKind]
						local value, index = blastPayload(payloadKind)
						local fitsSpell = payloadDefinition
							and payloadDefinition.Forms[draft.Form] == true
							and (
								payloadDefinition.Principle == nil
								or payloadDefinition.Principle == draft.Source.Principle
							)
						local full = #current.Payloads >= Config.MaxPayloads
						local last = #current.Payloads <= (definition.MinimumPayloads or 0)
						if value or (fitsSpell and not full) then
							toggle(payloadDefinition.Label .. " in blast", value ~= nil, function(on)
								local existing, at = blastPayload(payloadKind)
								if on and not existing and #current.Payloads < Config.MaxPayloads then
									local added = Spec.copy(payloadDefinition.Defaults or {})
									added.Kind = payloadKind
									table.insert(current.Payloads, added)
								elseif not on and at and not last then
									table.remove(current.Payloads, at)
								end
								dirty = true
								revision += 1
							end)
						end
						if value and index then
							showFields(value, payloadDefinition.Fields)
						end
					end
				end
			end
			if not configuring then
				heading("PROJECTILE TRAVEL BEHAVIORS")
				info("These change how a Projectile travels, selects targets, or persists after impact.", 42)
			end
			for _, kind in ProjectileBehaviorSpec.Order do
				local current = if draft.Form == "Projectile" then projectileBehavior(kind) else nil
				local definition = ProjectileBehaviorSpec.get(kind)
				local objectPhysicsOnly = draft.Targeting == "ObjectTarget" and draft.Form == "Projectile"
				local available = (draft.Form == "Projectile" and not objectPhysicsOnly) or current ~= nil
				if not configuring then
					card(
						definition.Label or kind,
						definition.Description or "Composes this behavior with the Projectile.",
						current ~= nil,
						function(enabled)
							setProjectileBehavior(kind, enabled)
						end,
						available,
						"Travel behaviors require the Projectile Form."
					)
				elseif current then
					heading(definition.Label or kind)
					info(definition.Description or "Changes how the Projectile behaves while travelling.", 38)
					for _, field in definition.Fields do
						renderField(current, field)
					end
				end
			end
			if configuring and draft.Form == "Projectile" then
				heading("TIMED MOTION PHASES")
				info(
					"Phases run in order over time. Their final settings remain active after the last phase; collision and damage still use the ordinary server projectile path.",
					48
				)
				draft.Projectile.MotionPhases = draft.Projectile.MotionPhases or {}
				for index, phase in ipairs(draft.Projectile.MotionPhases) do
					local phaseRow = row("Phase " .. index)
					button(phaseRow, "REMOVE", function()
						table.remove(draft.Projectile.MotionPhases, index)
						dirty = true
						revision += 1
						message("Motion phase removed", false)
						rebuild()
						estimate()
					end)
					select(
						"Motion mode",
						phase.Mode or "Linear",
						Config.ProjectileMotionModes,
						function(value)
							phase.Mode = value
							if value == "Arcing" then
								phase.ArcHeight = phase.ArcHeight or 8
							elseif value == "Bezier" then
								phase.BezierSide = phase.BezierSide or 8
								phase.BezierHeight = phase.BezierHeight or 0
								phase.Acceleration = 0
								phase.Gravity = 0
							elseif value == "Orbiting" then
								phase.OrbitRadius = phase.OrbitRadius or 3
								phase.OrbitAngularSpeed = phase.OrbitAngularSpeed or 3
							elseif value == "Expanding" then
								phase.ExpandMultiplier = phase.ExpandMultiplier or 3
							elseif value == "Falling" then
								phase.Gravity = phase.Gravity or 40
							end
						end,
						nil,
						"Linear preserves velocity; Arcing adds a bounded vertical arc; Bezier follows a bounded curved path; Falling applies gravity; Orbiting curves around the flight path; Stationary samples in place; Expanding grows hit and visual radius; Attached needs Linger."
					)
					numeric(
						"Duration (seconds)",
						phase,
						"Duration",
						"How long this motion phase lasts before the next one begins."
					)
					numeric(
						"Speed multiplier",
						phase,
						"SpeedMultiplier",
						"Sets speed to base projectile speed times this value at the phase boundary."
					)
					if (phase.Mode or "Linear") == "Linear" or phase.Mode == "Arcing" then
						numeric(
							"Acceleration override",
							phase,
							"Acceleration",
							"Acceleration along flight direction. Set 0 to stop accelerating in this phase."
						)
						numeric(
							"Gravity override",
							phase,
							"Gravity",
							"Additional downward acceleration during this phase."
						)
					elseif phase.Mode == "Falling" then
						numeric("Downward gravity", phase, "Gravity", "Gravity applied during this falling phase.")
					end
					if phase.Mode == "Arcing" then
						numeric(
							"Arc height",
							phase,
							"ArcHeight",
							"Peak vertical offset for the projectile's parabolic arc."
						)
					elseif phase.Mode == "Bezier" then
						numeric(
							"Side curve (studs)",
							phase,
							"BezierSide",
							"Offsets both inner cubic control points sideways. Negative values bend the other way; the server sweeps the full curved segment."
						)
						numeric(
							"Vertical curve (studs)",
							phase,
							"BezierHeight",
							"Offsets both inner cubic control points vertically. Use this with Side curve for a compound path."
						)
					elseif phase.Mode == "Orbiting" then
						numeric("Orbit radius", phase, "OrbitRadius", "Radius around the forward flight path.")
						numeric(
							"Orbit speed",
							phase,
							"OrbitAngularSpeed",
							"Signed radians per second around the flight path."
						)
					elseif phase.Mode == "Expanding" then
						numeric(
							"Final hit-radius multiplier",
							phase,
							"ExpandMultiplier",
							"Collision and projectile appearance grow from 1× to this value."
						)
					end
				end
				local addPhaseRow = row("Add motion phase")
				button(
					addPhaseRow,
					#draft.Projectile.MotionPhases < Config.MaxProjectileMotionPhases and "ADD" or "LIMIT",
					function()
						if #draft.Projectile.MotionPhases >= Config.MaxProjectileMotionPhases then
							return
						end
						table.insert(draft.Projectile.MotionPhases, {
							Mode = "Linear",
							Duration = 0.5,
							SpeedMultiplier = 1,
							Acceleration = draft.Projectile.Acceleration or 0,
							Gravity = draft.Projectile.Gravity or 0,
						})
						dirty = true
						rebuild()
						estimate()
					end
				)
			end
			local selectedEffectCount = 0
			for _, steps in pairs(draft.Triggers or {}) do
				for _, step in ipairs(steps or {}) do
					for _, value in ipairs(step.Payloads or {}) do
						selectedEffectCount += 1
					end
				end
			end
			currentGroup = nil
			if configuring then
				if selectedEffectCount == 0 then
					info("No effects are selected yet. Choose compatible outcomes before configuring this spell.", 44)
				end
				button(row("Review the live summary, validation, and save actions"), "REVIEW SPELL ›", function()
					activeSection = "Test"
					scroll.CanvasPosition = Vector2.zero
					rebuild()
				end)
			else
				button(
					row(
						string.format(
							"%d effect%s selected · next, configure only these",
							selectedEffectCount,
							if selectedEffectCount == 1 then "" else "s"
						)
					),
					"CONFIGURE EFFECTS ›",
					function()
						activeSection = "ConfigureEffects"
						scroll.CanvasPosition = Vector2.zero
						rebuild()
					end
				)
			end
		elseif activeSection == "Cost" then
			heading("CAST TIMING")
			info(
				"These controls tune when the spell resolves and how often it can be used. Values are checked again by the server when saved and cast.",
				48
			)
			numeric(
				"Cooldown (seconds)",
				draft.Casting,
				"Cooldown",
				"Time before this equipped spell can be cast again."
			)
			numeric(
				"Cast time (seconds)",
				draft.Casting,
				"CastTime",
				"Delay before the spell resolves after activation."
			)
			numeric("Recovery (seconds)", draft.Casting, "RecoveryTime", "Brief lockout after resolving.")
			if draft.Lifetime.Mode ~= "Instantaneous" then
				heading("ONGOING RESOURCE USE")
				info(
					"Mana and strain are spent over time while a lasting effect remains active. A zero upkeep value means no recurring mana cost.",
					44
				)
				numeric(
					"Mana upkeep per second",
					draft.Casting,
					"ManaUpkeepPerSecond",
					"For a channel, this must be positive; the server stops the effect if payment cannot continue."
				)
				numeric(
					"Strain per second",
					draft.Casting,
					"StrainPerSecond",
					"Ongoing Locus strain accumulated during the active lifetime."
				)
			end
			local cost = Spec.estimate(draft)
			heading("SERVER-ESTIMATED CAST DEMAND")
			info(
				string.format(
					"Estimated per cast: %d mana · %d strain · complexity %d\nWhile active: %g mana/s · %g strain/s\nThese are authored spell estimates; caster state and target defenses still affect actual results.",
					cost.ManaDemand,
					cost.Strain,
					cost.Complexity,
					cost.ManaUpkeepPerSecond or 0,
					cost.StrainPerSecond or 0
				),
				78
			)
			heading("ADVANCED LIMITS")
			info(
				"Optional caster, environment, and lifetime rules are available in Casting and specialist controls. They remain server-validated.",
				52
			)
		elseif activeSection == "Presentation" and visualSubpage == "Composer" then
			heading("SPELL VISUAL STUDIO")
			info(
				"Automatic composes element, form, shape and behavior. Presets override the motif; Advanced tunes colors, core, opacity and trails. Preview, then save.",
				48
			)
			local options = {}
			local visualCards = {
				{ Id = "None", Label = "Automatic", Hint = "Infer from element, form and behavior", Symbol = "◇" },
				{ Id = "FireProjectile", Label = "Fire", Hint = "Rotating ember core", Symbol = "✦" },
				{ Id = "FrostProjectile", Label = "Frost", Hint = "Spinning ice crystal", Symbol = "❄" },
				{ Id = "ArcaneProjectile", Label = "Arcane", Hint = "Violet arcane core", Symbol = "✧" },
				{ Id = "FireBurst", Label = "Fire Burst", Hint = "Impact flash and ring", Symbol = "☼" },
				{ Id = "FrostCharge", Label = "Frost Charge", Hint = "Shrinking crystal charge", Symbol = "❅" },
				{ Id = "ArcaneTrail", Label = "Arcane Trail", Hint = "Purple trail and motes", Symbol = "〰" },
			}
			local pageSize = 6
			local pageCount = math.ceil(#visualCards / pageSize)
			visualPage = math.clamp(visualPage, 1, pageCount)
			local firstCard = (visualPage - 1) * pageSize + 1
			local lastCard = math.min(#visualCards, firstCard + pageSize - 1)
			for index = firstCard, lastCard do
				local visualCard = visualCards[index]
				local card = table.clone(visualCard)
				card.Selected = (draft.Visual.VFXDefinition or "None") == card.Id
				card.Action = function()
					draft.Visual.VFXDefinition = card.Id
					estimate()
					rebuildPreservingScroll()
				end
				table.insert(options, card)
			end
			table.insert(options, {
				Id = "AdvancedAppearance",
				Label = "Advanced",
				Hint = "Legacy color, audio and component controls",
				Symbol = "⚙",
				Action = function()
					visualSubpage = "Advanced"
					rebuild()
				end,
			})
			creationChoiceGrid(options)
			visualStudioFrame = scroll:FindFirstChild("SpellChoiceGrid") :: Frame?
			local previewBlock = canvasBlock(112)
			local previewFrame = Instance.new("Frame")
			previewFrame.Name = "VisualPreviewTile"
			previewFrame.Position = UDim2.fromOffset(0, 0)
			previewFrame.Size = UDim2.new(1, -8, 1, -8)
			previewFrame.BackgroundColor3 = Theme.Surface
			previewFrame.BorderSizePixel = 0
			previewFrame.Parent = previewBlock
			local iconPreview = Instance.new("Frame")
			iconPreview.Name = "LiveSpellIconPreview"
			iconPreview.Position = UDim2.fromOffset(12, 12)
			iconPreview.Size = UDim2.fromOffset(72, 72)
			iconPreview.Parent = previewFrame
			liveIconPreview = iconPreview
			SpellVisual.render(iconPreview, draft, true)
			local previewEdge = Instance.new("UIStroke")
			previewEdge.Color = Theme.TileEdge
			previewEdge.Thickness = 2
			previewEdge.Parent = previewFrame
			local previewTitle = Instance.new("TextLabel")
			previewTitle.BackgroundTransparency = 1
			previewTitle.Position = UDim2.fromOffset(96, 9)
			previewTitle.Size = UDim2.new(1, -258, 0, 26)
			previewTitle.Font = Enum.Font.Garamond
			previewTitle.TextSize = 14
			previewTitle.TextTruncate = Enum.TextTruncate.AtEnd
			previewTitle.TextColor3 = Theme.Ink
			previewTitle.TextXAlignment = Enum.TextXAlignment.Left
			previewTitle.Text = VFXAnalyzer.resolve(draft).Label
			previewTitle.Parent = previewFrame
			local previewHint = Instance.new("TextLabel")
			previewHint.BackgroundTransparency = 1
			previewHint.Position = UDim2.fromOffset(96, 38)
			previewHint.Size = UDim2.new(1, -258, 0, 44)
			previewHint.Font = Enum.Font.Gotham
			previewHint.TextSize = 14
			previewHint.TextWrapped = true
			previewHint.TextColor3 = Theme.MutedInk
			previewHint.TextXAlignment = Enum.TextXAlignment.Left
			previewHint.Text = VFXAnalyzer.resolve(draft).Source
				.. " · "
				.. VFXAnalyzer.resolve(draft).Accents
				.. ". Advanced overrides palette, core, opacity, emission and trails."
			previewHint.Parent = previewFrame
			local previewButton = Instance.new("TextButton")
			previewButton.AnchorPoint = Vector2.new(1, 0.5)
			previewButton.Position = UDim2.new(1, -12, 0.5, 0)
			previewButton.Size = UDim2.fromOffset(128, 44)
			previewButton.BackgroundColor3 = Theme.Accent
			previewButton.TextColor3 = Theme.OnAccent
			previewButton.Text = "PLAY PREVIEW"
			previewButton.TextSize = 14
			previewButton.Font = Enum.Font.GothamBold
			previewButton.Parent = previewFrame
			previewButton.Activated:Connect(function()
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if not root then
					message("Character is not ready for preview.", false)
					return
				end
				VFXComposer.preview(draft, root.CFrame * CFrame.new(0, 0, -12))
				message("Previewing " .. VFXAnalyzer.resolve(draft).Label .. ".", true)
			end)
			if pageCount > 1 then
				local pager = row("VISUAL PAGE")
				pager.Name = "VISUAL PAGE"
				local pageLabel = pager:FindFirstChildOfClass("TextLabel")
				if pageLabel then
					pageLabel.Text = "VISUAL PAGE " .. tostring(visualPage) .. " / " .. tostring(pageCount)
				end
				pager.Size = UDim2.new(1, -8, 0, 42)
				local previous = button(pager, "‹ PREVIOUS", function()
					visualPage = math.max(1, visualPage - 1)
					rebuild()
				end)
				previous.Position = UDim2.new(0.08, 0, 0, 0)
				previous.Size = UDim2.new(0.36, 0, 1, 0)
				local nextPage = button(pager, "NEXT ›", function()
					visualPage = math.min(pageCount, visualPage + 1)
					rebuild()
				end)
				nextPage.Position = UDim2.new(0.56, 0, 0, 0)
				nextPage.Size = UDim2.new(0.36, 0, 1, 0)
			end
			-- Captured: inside the Spell Forge this lays out the inspector host.
			local studioHost, studioHosted = scroll, forgeHosted
			local function layoutVisualStudio()
				if not visualStudioFrame or not visualStudioFrame.Parent then
					return
				end
				local width, height = studioHost.AbsoluteSize.X, studioHost.AbsoluteSize.Y
				local gap = 10
				local cell = math.floor(math.clamp(math.min((width - 24) / 3, (height - 160) / 2), 78, 148))
				local gridWidth = cell * 3 + gap * 2
				visualStudioFrame.Position = UDim2.fromOffset(math.max(0, (width - gridWidth) / 2), 0)
				visualStudioFrame.Size = UDim2.fromOffset(gridWidth, cell * 2 + gap)
				local tileIndex = 0
				for _, tile in visualStudioFrame:GetChildren() do
					if tile:IsA("TextButton") then
						tile.Position =
							UDim2.fromOffset((tileIndex % 3) * (cell + gap), math.floor(tileIndex / 3) * (cell + gap))
						tile.Size = UDim2.fromOffset(cell, cell)
						tileIndex += 1
					end
				end
				local preview = studioHost:FindFirstChild("VisualPreviewTile", true)
				if preview and preview:IsA("Frame") then
					preview.Position = UDim2.fromOffset(0, cell * 2 + gap + 6)
					preview.Size = UDim2.new(1, -8, 0, 100)
				end
				local pagerFrame = studioHost:FindFirstChild("VISUAL PAGE", true)
				if pagerFrame and pagerFrame:IsA("Frame") then
					pagerFrame.Position = UDim2.fromOffset(0, cell * 2 + gap + 112)
					pagerFrame.Size = UDim2.new(1, -8, 0, 38)
				end
				if not studioHosted then
					visualStudioFrame.Parent.Size = UDim2.new(1, -8, 0, cell * 2 + gap + 118)
				end
			end
			layoutVisualStudio()
			visualLayoutConnection = studioHost:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutVisualStudio)
			task.defer(layoutVisualStudio)
		elseif activeSection == "Presentation" then
			heading("ADVANCED APPEARANCE")
			local back = row("Return to the visual composition editor")
			button(back, "‹ VISUAL STUDIO", function()
				visualSubpage = "Composer"
				rebuild()
			end)
			heading("CAST PRESENTATION")
			info(
				"Change how the spell looks and sounds. Colors and particles do not add damage, and a larger visual does not make the spell hit a larger area.",
				42
			)
			select("Casting profile", draft.Visual.Profile or "Auto", Schema.PresentationProfiles, function(value)
				draft.Visual.Profile = value
			end)
			heading("APPEARANCE")
			info(
				"Combine a starting look with independent shape, surface, particle, trail, impact, casting, and ambient components. These are cosmetic layers; they do not alter spell behavior or hit geometry.",
				56
			)
			heading("MIX AND MATCH STARTERS")
			for _, preset in ipairs(VisualAssets.Presets) do
				local presetRow = row(preset.Label .. " · " .. preset.Description)
				presetRow.Size = UDim2.new(1, -8, 0, 56)
				button(presetRow, "APPLY", function()
					local composed, reason = VisualAssets.apply(draft.Visual, preset.Id)
					if composed then
						draft.Visual = composed
						rebuild()
						message("Visual starter applied. Adjust any component below.", true)
					else
						message(reason or "Could not apply visual starter.", false)
					end
				end)
			end
			heading("COMPONENT LIBRARY")
			for _, group in ipairs(VisualAssets.Groups) do
				local slot = group.Slot
				local current = draft.Visual[slot]
				if slot ~= "MaterialAppearance" or draft.Form == "Projectile" or draft.Form == "Construct" then
					select(group.Label, current or "None", group.Options, function(value)
						local composed, reason = VisualAssets.set(draft.Visual, slot, value)
						if composed then
							draft.Visual = composed
						else
							message(reason or "Could not set visual component.", false)
						end
					end)
				end
			end
			if draft.Form == "Projectile" then
				select(
					"Projectile core shape",
					draft.Visual.CoreShape,
					Schema.VisualOptions.CoreShapes,
					function(value)
						draft.Visual.CoreShape = value
					end,
					function(value)
						return value
					end,
					"Changes the visible projectile core. Collision radius is set by Projectile size in Setup. All core shapes are available for testing."
				)
			end
			if draft.Form == "Projectile" or draft.Form == "Construct" then
				select(
					"Material appearance",
					draft.Visual.MaterialAppearance,
					Schema.VisualOptions.Materials,
					function(value)
						draft.Visual.MaterialAppearance = value
					end,
					nil,
					"Auto uses this Form's established appearance. Construct Auto keeps the established Slate look."
				)
			end
			select(
				"Visual palette",
				draft.Visual.Palette or "LegacyCustom",
				Schema.VisualOptions.Palettes,
				function(value)
					draft.Visual.Palette = value
					local palette = VisualSpec.PaletteDefinitions[value]
					if palette then
						draft.Visual.Color = palette.Colors[1]
						draft.Visual.SecondaryColor = palette.Colors[2]
						draft.Visual.AccentColor = palette.Colors[3]
					end
				end,
				function(value)
					local palette = VisualSpec.PaletteDefinitions[value]
					if not palette then
						return "Custom (current colors)"
					end
					return palette.Label
				end,
				"Sets the primary, secondary, and accent colors. Custom keeps the current RGB colors. All palettes are available for testing."
			)
			slider(
				"Opacity",
				draft.Visual,
				"Opacity",
				0.2,
				1,
				"A minimum opacity keeps the spell's core visible.",
				true
			)
			slider("Emission", draft.Visual, "Emission", 0, 1, "Controls particle and beam glow only.", true)
			select("Particles", draft.Visual.ParticleStyle, Schema.VisualOptions.ParticleStyles, function(value)
				draft.Visual.ParticleStyle = value
			end)
			if draft.Form == "Field" or draft.Form == "Aura" then
				slider(
					"Camera distortion",
					draft.Visual,
					"Distortion",
					0,
					1,
					"Optional local camera blur/color shift near this active area. It is subtle and does not affect other clients or gameplay.",
					true
				)
				select(
					"Environmental layer",
					draft.Visual.EnvironmentalVisual or "None",
					Schema.VisualOptions.EnvironmentalVisuals,
					function(value)
						draft.Visual.EnvironmentalVisual = value
					end,
					function(value)
						return if value == "Motes"
							then "Low-rate drifting motes around the active area."
							elseif value == "GroundMist" then "Subtle smoke-textured haze around the active area."
							else "No additional environmental particles."
					end,
					"Cosmetic only. Uses the shared particle budget and never changes hit geometry, damage, or visibility rules."
				)
			end
			if draft.Form == "Projectile" then
				select("Projectile trail", draft.Visual.TrailStyle, Schema.VisualOptions.TrailStyles, function(value)
					draft.Visual.TrailStyle = value
				end, nil, "Trail presentation does not change projectile collision or range.")
				select(
					"Surface impact behavior",
					draft.Visual.SurfaceBehavior,
					Schema.VisualOptions.SurfaceBehaviors,
					function(value)
						draft.Visual.SurfaceBehavior = value
					end,
					nil,
					"Adds a brief cosmetic pulse aligned to world surfaces. It does not persist or change gameplay."
				)
			end
			select("Impact effect", draft.Visual.ImpactStyle, Schema.VisualOptions.ImpactStyles, function(value)
				draft.Visual.ImpactStyle = value
			end)
			select("Casting effect", draft.Visual.CastingStyle, Schema.VisualOptions.CastingStyles, function(value)
				draft.Visual.CastingStyle = value
			end)
			heading("SPATIAL AUDIO")
			info(
				"Optional Roblox audio asset IDs. Travel and active-effect cues loop and stop with their server-owned effect; blank cues remain silent.",
				44
			)
			for _, cue in Schema.AudioCues do
				assetId(cue.Label .. (if cue.Mode == "Loop" then " · loop" else ""), draft.Audio, cue.Key)
			end
			numeric("Audio volume (0–1)", draft.Audio, "Volume", "Spatial sound loudness for this spell.")
			numeric(
				"Audio distance (10–250 studs)",
				draft.Audio,
				"RollOffMaxDistance",
				"Maximum spatial distance for this spell's sounds."
			)
			slider(
				"Projectile appearance scale",
				draft.Visual,
				"ProjectileScale",
				1,
				4,
				"Scales the projectile core, particles, and trail only. Its Projectile size controls collision and hit detection.",
				draft.Form == "Projectile"
			)
			heading("ELEMENT COLOR")
			local swatch = row("Current element: " .. tostring(draft.Element))
			local color = Instance.new("Frame")
			color.Size = UDim2.fromOffset(40, 20)
			color.Position = UDim2.new(0.59, 0, 0.5, -10)
			color.BackgroundColor3 = draft.Visual.Color
			color.Parent = swatch
			info("Choose the element on Setup; it supplies this spell's magic damage type and presentation color.", 38)
			card(
				"Local geometry preview",
				"Approximates the next test cast's Form geometry; projectile appearance scale stays separate from collision size.",
				debugGeometry,
				function(value)
					debugGeometry = value
				end
			)
		else
			heading("REVIEW YOUR SPELL")
			info(Summary.describe(draft, Schema, Spec), 200)
			info(
				"Lab resource rules: Channeled and Sustained casts spend mana and strain. Other Lab cast styles bypass that spending. Special-resource costs still apply, and running spells can charge upkeep. These existing testing rules are separate from the estimates above.",
				100
			)
			info(
				"Numbers above are authored values and estimates, not guaranteed damage. Target defenses, charge and your caster stats can change the result. Test against the health bars on dummies and check cast feedback.",
				72
			)
			heading(string.format("TEST SLOT %d · %s", selectedSlot, equipped[selectedSlot] and "EQUIPPED" or "EMPTY"))
			info(
				"Test casts the spell currently equipped in this slot. Equip your valid edits first, then return here to test them.",
				44
			)
			heading("MULTIPLAYER CONSENT")
			toggle("Allow consent-gated spells to affect me", consentEnabled, function(value)
				consentEnabled = value
				send(Protocol.MagicConsent, { AllowsTargetedSpells = value })
			end, "This session setting is off by default and applies only when a spell explicitly requires consent.")
			local castRow = row("Test equipped spell")
			local castButton = button(castRow, "TEST EQUIPPED", function()
				if cast then
					cast(selectedSlot)
				end
			end)
			castButton.Font = Enum.Font.GothamBold
			local cost = Spec.estimate(draft)
			local specialCostLabels = {}
			for _, resourceId in ipairs(SpecialResourceSpec.order(SpecialResourceDefinitions)) do
				local amount = draft.Cost.SpecialResources and draft.Cost.SpecialResources[resourceId]
				if amount and amount > 0 then
					table.insert(
						specialCostLabels,
						SpecialResourceDefinitions[resourceId].Label .. " " .. tostring(amount)
					)
				end
			end
			local specialCostText = if #specialCostLabels > 0
				then " · " .. table.concat(specialCostLabels, ", ")
				else ""
			info(
				string.format(
					"Editing: %s · %s · %s element. Estimate: demand %d · strain %d · complexity %d · upkeep %g mana/s, %g strain/s%s.",
					draft.Name,
					form.Label,
					draft.Element,
					cost.ManaDemand,
					cost.Strain,
					cost.Complexity,
					cost.ManaUpkeepPerSecond,
					cost.StrainPerSecond,
					specialCostText
				),
				48
			)
			renderTraining()
		end
	end
	local function preview(direction, point, target)
		drawFolder:ClearAllChildren()
		if debugGeometry then
			GeometryPreview.draw(drawFolder, player, draft, direction, point, target)
		end
	end
	local function releaseSlot(slot)
		local id = Slots.id(slot)
		if not id then
			return
		end
		local direction, point, target, targetInstance = aim()
		send(Protocol.MagicRelease, {
			SpellId = id,
			AimDirection = direction,
			WorldPoint = point,
			TargetModel = target,
			TargetInstance = targetInstance,
		})
	end
	cast = function(slot, heldInput)
		slot = slot or selectedSlot
		if not libraryLoaded then
			message("Load the spell library before casting.", false)
			return
		end
		if not equipped[slot] then
			message("This slot is empty. Select a slot and press EQUIP.", false)
			return
		end
		if equipped[slot].Casting.Mode == "CommandCast" then
			message("This is summon-only. Assign it to a Summon payload, then issue Attack or Support.", false)
			return
		end
		if
			(
				CastingSpec.isHeldMode(equipped[slot].Casting.Mode)
				or CastingSpec.isChargeMode(equipped[slot].Casting.Mode)
			) and not heldInput
		then
			message("Hold the spell's number key, then release it to finish this cast.", false)
			return
		end
		visibility(false)
		local direction, point, target, targetInstance = aim()
		local editing = draft
		draft = equipped[slot]
		preview(direction, point, target)
		draft = editing
		request:FireServer("Cast", {
			AimDirection = direction,
			WorldPoint = point,
			TargetModel = target,
			TargetInstance = targetInstance,
			Character = player.Character,
		}, slot)
	end
	apply = function(andCast)
		if applying then
			return
		end
		if not libraryLoaded then
			message("Load the spell library before saving a slot.", false)
			return
		end
		local focused = UIS:GetFocusedTextBox()
		if focused then
			focused:ReleaseFocus()
		end
		local ok, reason = Spec.validate(draft)
		if not ok then
			message(reason, false)
			return
		end
		applying = true
		appliedRevision = revision
		pendingCast = andCast
		applyingSlot, applyingDraft = selectedSlot, Spec.copy(draft)
		request:FireServer("Apply", applyingDraft, applyingSlot)
	end
	actions = Instance.new("Frame")
	actions.Size = UDim2.new(1, -24, 0, 42)
	actions.Position = UDim2.new(0, 12, 1, -54)
	actions.BackgroundTransparency = 1
	actions.Parent = panel
	local function action(label, index, callback)
		local b = button(actions, label, callback)
		b.Size = UDim2.new(0.19, -4, 1, 0)
		b.Position = UDim2.new(index * 0.2, 0, 0, 0)
		b.Font = Enum.Font.GothamBold
		b.TextSize = 12
		b.BackgroundColor3 = if index == 2 then Theme.Accent elseif index == 3 then Theme.AccentAlt else Theme.Surface
		b.TextColor3 = if index == 2 or index == 3 then Theme.OnAccent else Theme.Ink
		footerButtons[index + 1] = b
		return b
	end
	action("BACK", 0, function()
		if standaloneDraft or editingLibraryRecord then
			pageMode = "Library"
		else
			draftsBySlot[selectedSlot] = draft
			pageMode = "Slots"
		end
		scroll.CanvasPosition = Vector2.zero
		rebuild()
	end)
	action("SAVE DRAFT", 1, function()
		if standaloneDraft then
			standaloneWorkingDraft = Spec.copy(draft)
			lastWorkingDraftKind = "Standalone"
		elseif editingLibraryRecord and editingLibraryId then
			libraryDrafts[editingLibraryId] = Spec.copy(draft)
			lastLibraryDraftId = editingLibraryId
			lastWorkingDraftKind = "Library"
		else
			draftsBySlot[selectedSlot] = Spec.copy(draft)
			dirtySlots[selectedSlot] = true
		end
		dirty = true
		message("Draft kept for this session. Save Spell adds a valid copy to your library.", true)
		updateHeader()
	end)
	saveLibraryButton = action("SAVE SPELL", 2, function()
		if not libraryLoaded then
			message("Load the spell library before saving.", false)
			return
		end
		local valid, reason = Spec.validate(draft)
		if not valid then
			message(reason, false)
			return
		end
		local saveMode = if editingLibraryRecord then "Update" else "SaveNew"
		pendingLibrarySaveMode = saveMode
		pendingStandaloneSave = standaloneDraft
		request:FireServer("Library", {
			Action = saveMode,
			Id = editingLibraryId,
			Definition = Spec.copy(draft),
		})
	end)
	saveSlotButton = action("EQUIP", 3, function()
		apply(false)
	end)
	action("CLOSE · P", 4, function()
		visibility(false)
	end)
	response.OnClientEvent:Connect(function(ok, text, cost, actionName, slot)
		if actionName == "Library" then
			libraryView.Busy = false
			pendingLibraryEdit = nil
			message(text, ok)
			return
		end
		if actionName == "Load" then
			libraryLoading = false
			if ok and type(cost) == "table" then
				equipped = {}
				for key, definition in pairs(cost) do
					local index = tonumber(key)
					if
						index
						and index % 1 == 0
						and index >= 1
						and index <= Slots.Count
						and type(definition) == "table"
					then
						equipped[index] = definition
					end
				end
				draftsBySlot, dirtySlots = {}, {}
				libraryLoaded = true
				refreshBar()
				requestRebuild()
			end
			message(text, ok)
			return
		end
		if actionName == "Save" then
			persistenceState = if ok then "SAVED" else "SAVE FAILED · SESSION COPY"
			libraryView.Catalog.SaveState = persistenceState
			updateHeader()
			message(text, ok)
			return
		end
		if actionName ~= "Apply" then
			message(text, ok)
			return
		end
		if slot ~= applyingSlot then
			return
		end
		if ok then
			equipped[slot] = applyingDraft
			if slot == selectedSlot and appliedRevision == revision then
				draftsBySlot[slot] = Spec.copy(applyingDraft)
				dirtySlots[slot] = nil
			elseif not dirtySlots[slot] then
				draftsBySlot[slot] = Spec.copy(applyingDraft)
			end
			refreshBar()
		end
		applying = false
		message(text, ok)
		if ok and appliedRevision == revision then
			dirty = false
			dirtySlots[slot] = nil
		end
		if ok and pendingCast then
			pendingCast = false
			task.delay(0.12, function()
				cast(slot)
			end)
		else
			pendingCast = false
		end
		if ok then
			requestRebuild()
		end
	end)
	trainingResponse.OnClientEvent:Connect(function(ok, text, count, limit)
		message(string.format("%s  (%d / %d owned)", text, count or 0, limit or 0), ok)
	end)
	actionFeedback.OnClientEvent:Connect(function(data)
		if data.Kind == "Magic" then
			message(
				(data.Result or "")
					.. " · "
					.. (data.Reason or data.Name or "")
					.. (data.Damage and (" damage " .. data.Damage) or "")
					.. (data.Mana and (" · mana " .. math.floor(data.Mana) .. "/" .. tostring(data.Capacity or "?")) or "")
					.. (data.Strain and (" · strain " .. math.floor(data.Strain)) or ""),
				data.Result ~= "IMPOSSIBLE",
				data.Result == "UNSAFE"
			)
		end
	end)
	launcher:Bind(function()
		if panel.Visible then
			visibility(false)
		else
			rebuild()
			visibility(true)
		end
	end)
	local slotKeys = {
		Enum.KeyCode.One,
		Enum.KeyCode.Two,
		Enum.KeyCode.Three,
		Enum.KeyCode.Four,
		Enum.KeyCode.Five,
		Enum.KeyCode.Six,
		Enum.KeyCode.Seven,
		Enum.KeyCode.Eight,
		Enum.KeyCode.Nine,
	}
	local function sendAimUpdate(spell)
		if not spell or not CastingSpec.supportsAimUpdate(spell.Form, spell.Casting.Mode) then
			return
		end
		local direction, point = aim()
		if direction.Magnitude < 0.9 then
			return
		end
		send(Protocol.MagicAimUpdate, { SpellId = spell.SpellId, AimDirection = direction.Unit, WorldPoint = point })
	end
	-- One handler per slot; keyboard keys 1–9 and the gamepad RB route through it.
	local function slotAction(slot: number)
		local held = false
		return function(_, state)
			if (state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel) and held then
				held = false
				releaseSlot(slot)
				if heldAimSlot == slot then
					heldAimSlot = nil
				end
				return Enum.ContextActionResult.Sink
			end
			if UIS:GetFocusedTextBox() then
				return Enum.ContextActionResult.Pass
			end
			if panel.Visible then
				return Enum.ContextActionResult.Sink
			end
			if
				state == Enum.UserInputState.Begin
				and (
					player:GetAttribute("CharacterReady")
					or (RunService:IsStudio() and require(Shared.Configuration.DevelopmentSandbox).Enabled)
				)
			then
				cast(slot, true)
				held = equipped[slot] ~= nil
				if
					held
					and equipped[slot]
					and CastingSpec.supportsAimUpdate(equipped[slot].Form, equipped[slot].Casting.Mode)
				then
					heldAimSlot = slot
					aimUpdateElapsed = Config.AimUpdateInterval
					-- Do not wait for the periodic refresh before correcting the initial
					-- cast direction. Continue refreshing below for the full held channel.
					sendAimUpdate(equipped[slot])
				end
			end
			return Enum.ContextActionResult.Sink
		end
	end
	local slotHandlers = {}
	for slot, key in slotKeys do
		slotHandlers[slot] = slotAction(slot)
		ContextActionService:BindActionAtPriority(
			"MagicLabSlot" .. slot,
			slotHandlers[slot],
			false,
			Enum.ContextActionPriority.High.Value + 1,
			key
		)
	end
	-- Gamepad: D-pad left/right chooses an equipped slot, RB casts (hold for held spells).
	local gamepadSlot = 1
	local gamepadCastSlot: number? = nil
	player:SetAttribute("GamepadSpellSlot", gamepadSlot)
	-- The HUD spell bar (UI/HUD/SpellBar) highlights the slot RB will cast.
	local function updateSlotLabel() end
	local function cycleGamepadSlot(step: number)
		for offset = 1, #slotKeys do
			local candidate = (gamepadSlot - 1 + step * offset) % #slotKeys + 1
			if equipped[candidate] then
				gamepadSlot = candidate
				break
			end
		end
		player:SetAttribute("GamepadSpellSlot", gamepadSlot)
		updateSlotLabel()
	end
	ContextActionService:BindActionAtPriority("MagicLabGamepadCast", function(action, state, input)
		if state == Enum.UserInputState.Begin then
			gamepadCastSlot = gamepadSlot
		end
		local slot = gamepadCastSlot or gamepadSlot
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			gamepadCastSlot = nil
		end
		return slotHandlers[slot](action, state, input)
	end, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.ButtonR1)
	ContextActionService:BindAction("MagicLabGamepadSlot", function(_, state, input)
		if state ~= Enum.UserInputState.Begin or panel.Visible or player:GetAttribute("InventoryOpen") then
			return Enum.ContextActionResult.Pass
		end
		cycleGamepadSlot(if input.KeyCode == Enum.KeyCode.DPadLeft then -1 else 1)
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadRight)
	RunService.RenderStepped:Connect(function(delta)
		local slot = heldAimSlot
		local spell = slot and equipped[slot]
		if panel.Visible or not spell or not CastingSpec.supportsAimUpdate(spell.Form, spell.Casting.Mode) then
			aimUpdateElapsed = 0
			return
		end
		aimUpdateElapsed += delta
		if aimUpdateElapsed < Config.AimUpdateInterval then
			return
		end
		aimUpdateElapsed %= Config.AimUpdateInterval
		sendAimUpdate(spell)
	end)
	player.CharacterRemoving:Connect(function()
		visibility(false)
		drawFolder:ClearAllChildren()
		pendingCast = false
		heldAimSlot = nil
	end)
	rebuild()
	if pageMode == "Editor" then
		estimate()
	end
end
return Lab
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="411">
            <Properties>
              <string name="Name">MagicPresentationController</string>
              <string name="Source"><![CDATA[--!strict
-- Post-Animator procedural overlays for Motor6D and AnimationConstraint rigs.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.MagicPresentation)
local Protocol = require(Shared.Networking.Protocol)
local Controller = {}
local started = false
local Rig = require(Shared.Modules.MagicRig)
local PoseSpec = require(Shared.Modules.MagicPoseSpec)
function Controller.start()
	if started then
		return
	end
	started = true
	local casts = {}
	local applied = {}
	local warned = setmetatable({}, { __mode = "k" })
	local function restoreTransforms()
		for joint, previous in applied do
			if joint.Parent and joint.Transform == previous.Output then
				joint.Transform = previous.Base
			end
		end
		table.clear(applied)
	end
	RunService.PreAnimation:Connect(restoreTransforms)
	local function restore(character)
		local cast = casts[character]
		if cast then
			for _, entry in cast.Joints do
				local previous = applied[entry.Joint]
				if previous and entry.Joint.Parent and entry.Joint.Transform == previous.Output then
					entry.Joint.Transform = previous.Base
				end
				applied[entry.Joint] = nil
			end
		end
		casts[character] = nil
	end
	local remotes = Shared:WaitForChild(Protocol.Folder, 15)
	assert(remotes, "Magic presentation remote folder did not start within 15 seconds")
	local presentation = remotes:WaitForChild("MagicPresentation", 15)
	assert(
		presentation and presentation:IsA("RemoteEvent"),
		"Magic presentation remote did not start within 15 seconds"
	)
	presentation.OnClientEvent:Connect(function(character, profile, phase, duration, gather)
		if typeof(character) ~= "Instance" or not character:IsA("Model") then
			return
		end
		if phase == "Cancel" then
			restore(character)
			return
		end
		if phase == "Release" then
			local existing = casts[character]
			if existing then
				existing.Phase = "Release"
				existing.Start = os.clock()
				existing.Duration = math.max(0.25, duration)
				existing.Gather = 0
			end
			return
		end
		if phase == "Sustain" then
			local existing = casts[character]
			if existing then
				existing.Phase = "Sustain"
				existing.Start = os.clock()
				existing.Duration = math.huge
				existing.Gather = 0
				return
			end
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local camera = workspace.CurrentCamera
		if
			not root
			or not humanoid
			or humanoid.Health <= 0
			or not camera
			or (root.Position - camera.CFrame.Position).Magnitude > Config.ObserverDistance
		then
			return
		end
		local count = 0
		for _ in casts do
			count += 1
		end
		if not casts[character] and count >= Config.MaxObservedCasts then
			return
		end
		restore(character)
		local joints = {}
		for _, joint in character:GetDescendants() do
			local entry = Rig.describe(joint)
			if entry then
				table.insert(joints, entry)
			end
		end
		character:SetAttribute("MagicPoseJointCount", #joints)
		character:SetAttribute("MagicPoseProfile", profile)
		if #joints == 0 and not warned[character] then
			warned[character] = true
			warn("Magic casting: no supported body joints found in " .. character.Name)
		end
		casts[character] = {
			Profile = profile,
			Phase = phase,
			Start = os.clock(),
			Duration = if phase == "Sustain" then math.huge else math.clamp(duration, 0.1, Config.MaxPoseDuration),
			Gather = math.clamp(gather or 0.1, 0.05, Config.MaxPoseDuration),
			Joints = joints,
		}
	end)
	local distortionCamera: Camera? = nil
	local distortionBlur: BlurEffect? = nil
	local distortionColor: ColorCorrectionEffect? = nil
	local function bindDistortionEffects(camera: Camera?)
		if distortionCamera == camera then
			return
		end
		if distortionBlur then
			distortionBlur:Destroy()
			distortionBlur = nil
		end
		if distortionColor then
			distortionColor:Destroy()
			distortionColor = nil
		end
		distortionCamera = camera
		if not camera then
			return
		end
		distortionBlur = Instance.new("BlurEffect")
		distortionBlur.Name = "MagicLocalDistortionBlur"
		distortionBlur.Size = 0
		distortionBlur.Enabled = false
		distortionBlur.Parent = camera
		distortionColor = Instance.new("ColorCorrectionEffect")
		distortionColor.Name = "MagicLocalDistortionColor"
		distortionColor.Contrast = 0
		distortionColor.Saturation = 0
		distortionColor.Enabled = false
		distortionColor.Parent = camera
	end
	local distortionAccumulator = 0
	local distortionConfig = Config.LocalDistortion
	RunService.Heartbeat:Connect(function(deltaTime)
		distortionAccumulator += deltaTime
		if distortionAccumulator < distortionConfig.UpdateInterval then
			return
		end
		distortionAccumulator %= distortionConfig.UpdateInterval
		local camera = workspace.CurrentCamera
		bindDistortionEffects(camera)
		if not camera or not distortionBlur or not distortionColor then
			return
		end
		local strongest = 0
		local cameraPosition = camera.CFrame.Position
		for _, marker in CollectionService:GetTagged("MagicDistortionArea") do
			if not marker:IsA("BasePart") or not marker:IsDescendantOf(workspace) then
				continue
			end
			local authored = marker:GetAttribute("MagicVisualDistortion")
			local radius = marker:GetAttribute("MagicDistortionRadius")
			if type(authored) ~= "number" or type(radius) ~= "number" then
				continue
			end
			local distance = (cameraPosition - marker.Position).Magnitude
			local falloff = if distance <= radius
				then 1
				else math.clamp(1 - (distance - radius) / distortionConfig.FalloffDistance, 0, 1)
			strongest = math.max(strongest, math.clamp(authored, 0, 1) * falloff)
		end
		distortionBlur.Size = strongest * distortionConfig.MaxBlur
		distortionBlur.Enabled = strongest > 0.01
		distortionColor.Contrast = strongest * distortionConfig.MaxContrast
		distortionColor.Saturation = -strongest * distortionConfig.MaxDesaturation
		distortionColor.Enabled = strongest > 0.01
	end)
	RunService.PreSimulation:Connect(function()
		local now = os.clock()
		for character, cast in casts do
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local elapsed = now - cast.Start
			local t = elapsed / cast.Duration
			local strength
			local releasing = cast.Phase == "Release"
			if cast.Phase == "Charge" then
				strength = 0.88
			elseif cast.Phase == "Sustain" then
				strength = 0.76 + math.sin(elapsed * 1.8) * 0.035
			elseif releasing then
				strength = math.min(elapsed / 0.12, 1) * math.min((cast.Duration - elapsed) / 0.2, 1)
				strength = strength * strength * (3 - 2 * strength)
			elseif elapsed < cast.Gather then
				local rise = math.min(elapsed / 0.22, 1)
				strength = 0.82 * rise * rise * (3 - 2 * rise)
			else
				strength = 0.82 * math.min((cast.Duration - elapsed) / 0.2, 1)
			end
			if
				not character:IsDescendantOf(workspace)
				or not humanoid
				or humanoid.Health <= 0
				or (cast.Phase ~= "Charge" and cast.Phase ~= "Sustain" and t >= 1)
			then
				restore(character)
				continue
			end
			strength = math.clamp(strength, 0, 1)
			for _, entry in cast.Joints do
				if not entry.Joint.Parent then
					continue
				end
				local x, y, z = PoseSpec.angles(cast.Profile, entry.Role, cast.Phase)
				-- Rotate in the parent body's axes, not the differently oriented R6/R15 joint axes.
				local offset = CFrame.Angles(math.rad(x) * strength, math.rad(y) * strength, math.rad(z) * strength)
				local frame = entry.Frame.Rotation
				local localOffset = frame:Inverse() * offset * frame
				local base = entry.Joint.Transform
				local output = localOffset * base
				applied[entry.Joint] = { Base = base, Output = output }
				entry.Joint.Transform = output
			end
		end
	end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="412">
            <Properties>
              <string name="Name">MagicRevealController</string>
              <string name="Source"><![CDATA[--!strict

-- Renders server-authored reveal expiries locally for the owning caster only.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Controller = {}
local TAG = "MagicRevealedTarget"
local REFRESH_INTERVAL = 0.2
local started = false

function Controller.start()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	local userId = tostring(player.UserId)
	local untilAttribute = "MagicRevealUntil_" .. userId
	local colorAttribute = "MagicRevealColor_" .. userId
	local highlights: { [Model]: Highlight } = setmetatable({}, { __mode = "k" }) :: any
	local elapsed = 0

	local function remove(model: Model)
		local highlight = highlights[model]
		if highlight then
			highlight:Destroy()
			highlights[model] = nil
		end
	end

	RunService.Heartbeat:Connect(function(delta)
		elapsed += delta
		if elapsed < REFRESH_INTERVAL then
			return
		end
		elapsed = 0
		local now = workspace:GetServerTimeNow()
		local tagged = CollectionService:GetTagged(TAG)
		local current: { [Model]: boolean } = {}
		for _, instance in tagged do
			if not instance:IsA("Model") or not instance:IsDescendantOf(workspace) then
				continue
			end
			local expiresAt = instance:GetAttribute(untilAttribute)
			if type(expiresAt) ~= "number" or expiresAt <= now then
				remove(instance)
				continue
			end
			current[instance] = true
			local highlight = highlights[instance]
			if not highlight then
				highlight = Instance.new("Highlight")
				highlight.Name = "MagicReveal_" .. userId
				highlight.Adornee = instance
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillTransparency = 0.92
				highlight.OutlineTransparency = 0.05
				highlight.Parent = instance
				highlights[instance] = highlight
			end
			local color = instance:GetAttribute(colorAttribute)
			if typeof(color) ~= "Color3" then
				color = Color3.fromRGB(255, 194, 90)
			end
			highlight.FillColor = color
			highlight.OutlineColor = color
		end
		for model in highlights do
			if not current[model] or not CollectionService:HasTag(model, TAG) then
				remove(model)
			end
		end
	end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="413">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox")).Movement
local Protocol = require(Shared:WaitForChild("Networking"):WaitForChild("Protocol"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local Speed = require(Shared.Modules.MovementSpeed)
local Movement = {}

function Movement.start(send: (string, Types.ActionOptions?) -> number)
	local player = Players.LocalPlayer
	local readyAt = 0
	local sprinting = false
	local dashSequence = 0
	local sprintSequence = 0
	local stopDash: (() -> ())? = nil
	local speedConnection: RBXScriptConnection? = nil
	local multiplierConnection: RBXScriptConnection? = nil
	local slowConnection: RBXScriptConnection? = nil
	local boundConnection: RBXScriptConnection? = nil
	local castingConnection: RBXScriptConnection? = nil
	local blockingConnection: RBXScriptConnection? = nil

	local function applyPredictedSpeed()
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		if humanoid and humanoid.Health > 0 then
			local bonus = character:GetAttribute("MagicWalkSpeedBonus")
			local multiplier = character:GetAttribute("MagicSpeedMultiplier")
			local slow = character:GetAttribute("MagicSlowMultiplier")
			local casting = character:GetAttribute("MagicCastingMultiplier")
			local blocking = character:GetAttribute("MeleeBlocking") == true
			local scale = (if blocking then Config.BlockWalkMultiplier else 1)
				* (if typeof(slow) == "number" then slow else 1)
				* (if typeof(casting) == "number" then casting else 1)
			humanoid.WalkSpeed = Speed.calculate(
				Config.WalkSpeed,
				Config.SprintSpeed,
				sprinting and not blocking,
				if typeof(bonus) == "number" then bonus else 0,
				if typeof(multiplier) == "number" then multiplier else 1
			) * scale
		end
	end

	local function bindCharacter(character: Model)
		if multiplierConnection then
			multiplierConnection:Disconnect()
		end
		if slowConnection then
			slowConnection:Disconnect()
		end
		if boundConnection then
			boundConnection:Disconnect()
		end
		if castingConnection then
			castingConnection:Disconnect()
		end
		if speedConnection then
			speedConnection:Disconnect()
		end
		if blockingConnection then
			blockingConnection:Disconnect()
		end
		speedConnection = character:GetAttributeChangedSignal("MagicWalkSpeedBonus"):Connect(applyPredictedSpeed)
		multiplierConnection = character:GetAttributeChangedSignal("MagicSpeedMultiplier"):Connect(applyPredictedSpeed)
		slowConnection = character:GetAttributeChangedSignal("MagicSlowMultiplier"):Connect(applyPredictedSpeed)
		boundConnection = character:GetAttributeChangedSignal("MagicMovementBound"):Connect(applyPredictedSpeed)
		castingConnection = character:GetAttributeChangedSignal("MagicCastingMultiplier"):Connect(applyPredictedSpeed)
		blockingConnection = character:GetAttributeChangedSignal("MeleeBlocking"):Connect(applyPredictedSpeed)
		applyPredictedSpeed()
	end
	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		bindCharacter(player.Character)
	end

	local function cancel()
		if stopDash then
			stopDash()
		end
	end

	local function sprint(enabled: boolean)
		if sprinting == enabled then
			return
		end
		sprinting = enabled
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		if humanoid and humanoid.Health > 0 then
			applyPredictedSpeed()
			sprintSequence = send(Protocol.Sprint, { Sprinting = enabled })
		end
	end

	local function dash(): boolean
		local now = workspace:GetServerTimeNow()
		if now < readyAt or stopDash then
			return false
		end
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if
			not character
			or character:GetAttribute("MagicMovementBound") == true
			or character:GetAttribute("MagicCastingLocked") == true
			or not humanoid
			or humanoid.Health <= 0
			or not root
			or not root:IsA("BasePart")
		then
			return false
		end
		local move = humanoid.MoveDirection
		local direction = Vector3.new(move.X, 0, move.Z)
		if direction.Magnitude < Config.DirectionEpsilon then
			local facing = root.CFrame.LookVector
			direction = Vector3.new(facing.X, 0, facing.Z)
		end
		if direction.Magnitude < Config.DirectionEpsilon then
			return false
		end
		direction = direction.Unit
		readyAt = now + Config.DashCooldown
		local attachment = Instance.new("Attachment")
		attachment.Name = "PredictedDashAttachment"
		attachment.Parent = root
		local velocity = Instance.new("LinearVelocity")
		velocity.Name = "PredictedDashVelocity"
		velocity.Attachment0 = attachment
		velocity.RelativeTo = Enum.ActuatorRelativeTo.World
		velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		velocity.PrimaryTangentAxis = Vector3.xAxis
		velocity.SecondaryTangentAxis = Vector3.zAxis
		velocity.ForceLimitsEnabled = false
		local speed = Config.DashDistance / Config.DashDuration
		velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * speed
		velocity.Parent = root
		local rotate = humanoid.AutoRotate
		humanoid.AutoRotate = false
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		params.RespectCanCollide = true
		local connection: RBXScriptConnection? = nil
		stopDash = function()
			if connection then
				connection:Disconnect()
			end
			velocity:Destroy()
			attachment:Destroy()
			humanoid.AutoRotate = rotate
			stopDash = nil
		end
		connection = RunService.PreSimulation:Connect(function(dt)
			if
				player.Character ~= character
				or humanoid.Health <= 0
				or not root.Parent
				or character:GetAttribute("MagicCastingLocked") == true
			then
				cancel()
				return
			end
			if workspace:GetServerTimeNow() >= now + Config.DashDuration then
				cancel()
				local normal = humanoid.MoveDirection * humanoid.WalkSpeed
				root.AssemblyLinearVelocity = Vector3.new(normal.X, root.AssemblyLinearVelocity.Y, normal.Z)
				return
			end
			local result = workspace:Blockcast(
				root.CFrame,
				Config.DashCollisionSize,
				direction * (speed * dt + Config.WallPadding),
				params
			)
			if result then
				cancel()
				root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
			end
		end)
		-- Prediction is already active before the request leaves the client.
		dashSequence = send(Protocol.Dash, { Direction = direction })
		return true
	end

	return {
		Sprint = sprint,
		Dash = dash,
		Cancel = cancel,
		IsDashing = function(): boolean
			return stopDash ~= nil
		end,
		GetCooldown = function(): number
			return math.max(0, readyAt - workspace:GetServerTimeNow())
		end,
		Reset = function()
			cancel()
			readyAt = 0
			sprinting = false
			dashSequence = 0
			sprintSequence = 0
		end,
		Feedback = function(message: any)
			if message.Kind == "Correction" then
				cancel()
			end
			if message.Kind ~= "Action" then
				return
			end
			if message.Action == Protocol.Dash and message.Sequence == dashSequence then
				readyAt = message.DashReadyAt
				if not message.Accepted then
					local wasDashing = stopDash ~= nil
					cancel()
					local character = player.Character
					local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
					if wasDashing and root and root:IsA("BasePart") then
						root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
					end
				end
			elseif message.Action == Protocol.Sprint and message.Sequence == sprintSequence then
				-- Apply only the latest sprint acknowledgement.
				sprinting = message.Sprinting
				applyPredictedSpeed()
			end
		end,
	}
end

export type Controller = typeof(Movement.start(function()
	return 0
end))
return Movement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="414">
            <Properties>
              <string name="Name">SpellVFXController</string>
              <string name="Source"><![CDATA[--!strict
-- Plays allowlisted cosmetic definitions received from the server and owns their lifecycle.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
-- Rojo maps src/shared beneath ReplicatedStorage.Shared.
local Shared = ReplicatedStorage:WaitForChild("Shared")
local System = Shared:WaitForChild("SpellVFXSystem")
local Service = require(System.Core.VFXService)
local Definitions = require(System.Data.VFXDefinitions)
local Analyzer = require(System.Core.SpellVFXAnalyzer)
local Composer = require(System.Core.SpellVFXComposer)
local Signatures = require(System.Signature.SignatureRenderer)
local CollectionService = game:GetService("CollectionService")
local Controller = {}
local started = false

-- Visual quality: "SpellVFXQuality" player attribute (Low/Medium/High) wins; otherwise touch
-- devices and low graphics levels start lower. Gameplay-critical layers render at every tier.
local QUALITY = { Low = true, Medium = true, High = true }
local function applyQuality()
	local player = game:GetService("Players").LocalPlayer
	local chosen = player and player:GetAttribute("SpellVFXQuality")
	local quality = if type(chosen) == "string" and QUALITY[chosen] then chosen else nil
	if not quality then
		local level = 10
		pcall(function()
			local saved = UserSettings():GetService("UserGameSettings").SavedQualityLevel
			if saved ~= Enum.SavedQualitySetting.Automatic then
				level = saved.Value
			end
		end)
		local touch = game:GetService("UserInputService").TouchEnabled
		quality = if level <= 3 then "Low" elseif level <= 6 or touch then "Medium" else "High"
	end
	Composer.Quality = quality
	Signatures.Quality = quality
end
Controller.applyQuality = applyQuality

function Controller.start(remotes: Instance)
	if started then
		return
	end
	started = true
	-- Generated asset layers (Fire, Body...) join the procedural composer for every anchor and preview.
	Composer.Signatures = Signatures
	Signatures.start()
	applyQuality()
	local localPlayer = game:GetService("Players").LocalPlayer
	localPlayer:GetAttributeChangedSignal("SpellVFXQuality"):Connect(applyQuality)
	local active = {}
	local composed = {}
	local function reconcile()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local candidates = {}
		for _, part in CollectionService:GetTagged("ComposedSpellVFX") do
			if part:IsA("BasePart") and part:IsDescendantOf(workspace) then
				local distance = (camera.CFrame.Position - part.Position).Magnitude
				if distance < 180 and part:GetAttribute("VFXPhase") ~= "End" then
					table.insert(candidates, { Part = part, Distance = distance })
				end
			end
		end
		table.sort(candidates, function(a, b)
			return a.Distance < b.Distance
		end)
		local selected = {}
		for index = 1, math.min(28, #candidates) do
			selected[candidates[index].Part] = true
		end
		for part, session in pairs(composed) do
			if not selected[part] then
				session:Finish()
				composed[part] = nil
			end
		end
		for part in pairs(selected) do
			if not composed[part] then
				composed[part] = Composer.attach(part, Analyzer.read(part))
			end
		end
	end
	CollectionService:GetInstanceAddedSignal("ComposedSpellVFX"):Connect(reconcile)
	CollectionService:GetInstanceRemovedSignal("ComposedSpellVFX"):Connect(function(part)
		if composed[part] then
			composed[part]:Finish()
			composed[part] = nil
		end
	end)
	local elapsed = 0
	game:GetService("RunService").Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed >= 0.25 then
			elapsed = 0
			reconcile()
		end
	end)
	reconcile()
	remotes:WaitForChild("SpellVFX").OnClientEvent:Connect(function(id, target, context)
		if type(id) ~= "string" or not Definitions[id] then
			return
		end
		if typeof(target) ~= "Vector3" and typeof(target) ~= "Instance" then
			return
		end
		local visualContext = type(context) == "table" and table.clone(context) or {}
		local session = Service:Play(Definitions[id], target, visualContext)
		table.insert(active, session)
		local duration = if id == "FireBurst" then 1.5 elseif id == "FrostCharge" then 1.8 else 3
		task.delay(duration, function()
			session:Stop()
			local index = table.find(active, session)
			if index then
				table.remove(active, index)
			end
		end)
	end)
	game:GetService("Players").LocalPlayer.CharacterRemoving:Connect(function()
		for _, session in active do
			session:Stop()
		end
		table.clear(active)
	end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="415">
            <Properties>
              <string name="Name">SpellVFXShowcase</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Studio-only spell VFX showcase (toggle with F8). Purely local and cosmetic: it builds anchors the
-- same way the server presentation does (Analyzer.stamp), so the real SpellVFXController, composer
-- and signature renderer draw them. Nothing is sent to the server; no damage or hits occur.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Showcase = {}

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[k] = deepCopy(v)
	end
	return out
end

function Showcase.start()
	local Shared = ReplicatedStorage:WaitForChild("Shared")
	if not (RunService:IsStudio() and require(Shared.Configuration.DevelopmentSandbox).Enabled) then
		return nil
	end
	local System = Shared:WaitForChild("SpellVFXSystem")
	local Analyzer = require(System.Core.SpellVFXAnalyzer)
	local Renderer = require(System.Signature.SignatureRenderer)
	local Assets = require(System.Assets.VFXAssets)
	local Manifest = require(System.Assets.VFXAssetManifest)
	local Spells = require(Shared.Configuration.Spells)
	local player = Players.LocalPlayer

	-- Showcase variables. Each maps onto real spell fields, then the analyzer re-derives features.
	local SCHOOLS = {
		{ "Fire", { Principle = "Energy", Expression = "Fire" }, nil },
		{ "Ice", { Principle = "Matter", Expression = "Water" }, "Ice" },
		{ "Lightning", { Principle = "Energy", Expression = "Lightning" }, nil },
		{ "Water", { Principle = "Matter", Expression = "Water" }, nil },
		{ "Earth", { Principle = "Matter", Expression = "Earth" }, nil },
		{ "Wind", { Principle = "Energy", Expression = "Force" }, "Wind" },
		{ "Poison", { Principle = "Body", Expression = "BodyEnhancement" }, "Poison" },
		{ "Arcane", { Principle = "Energy", Expression = "Unawakened" }, nil },
		{ "Force", { Principle = "Energy", Expression = "Force" }, nil },
		{ "Body", { Principle = "Body", Expression = "BodyEnhancement" }, nil },
		{ "Spirit", { Principle = "Soul", Expression = "Spirit" }, nil },
		{ "Space", { Principle = "Space", Expression = "SpatialFold" }, nil },
		{ "Time", { Principle = "Time", Expression = "TemporalShift" }, nil },
	}
	local FORMS = { "Projectile", "Beam", "Wave", "Field", "Aura", "SelfEnhancement", "Construct", "Manipulation" }
	local vars = {
		School = 1,
		Form = 1,
		Radius = 1.1,
		Damage = 10,
		Speed = 72,
		Charge = 0,
		Explode = 7,
		Homing = 0,
		Force = 54,
		Range = 10,
		Count = 1,
		Repeat = false,
		Dark = false,
		SlowMotion = false,
	}
	local function schoolName()
		return SCHOOLS[vars.School][1]
	end
	local function formName()
		return FORMS[vars.Form]
	end

	-- A complete spell of the chosen school and form; the curated Fireball / Body Burst are used
	-- as-is for their own school+form so their tuned definitions are what you see.
	local function buildSpell()
		local school, form = SCHOOLS[vars.School], formName()
		local spell
		if school[1] == "Fire" and form == "Projectile" then
			spell = deepCopy(Spells.Fireball)
		elseif school[1] == "Body" and form == "Wave" then
			spell = deepCopy(Spells.BodyBurst)
		else
			spell = {
				Form = form,
				Targeting = "AimDirection",
				Geometry = "Sphere",
				Motion = "Linear",
				Source = table.clone(school[2]),
				Element = school[3],
				Casting = { Mode = "Instant", Cooldown = 0.5 },
				Lifetime = { Mode = "FixedDuration", Duration = 3 },
				Visual = {},
				Triggers = {},
			}
			local hit = { { Kind = "Damage", Amount = vars.Damage }, { Kind = "Force", Magnitude = vars.Force } }
			if form == "Projectile" then
				spell.Projectile = { Speed = vars.Speed, Radius = vars.Radius }
				spell.Triggers.OnImpact = {
					{ Payloads = { { Kind = "Damage", Amount = vars.Damage } } },
					{ Behavior = "Explode", Radius = vars.Explode, Payloads = {} },
				}
			elseif form == "Beam" then
				spell.Beam = { Width = vars.Radius, Range = vars.Range * 2.4, Payloads = hit }
			elseif form == "Wave" then
				spell.Geometry = "Cone"
				spell.Wave = { Range = vars.Range, Dot = 0.35, Payloads = hit }
			elseif form == "Field" then
				spell.Geometry = "Cylinder"
				spell.Field = {
					Radius = vars.Range * 0.6,
					Height = 4,
					Payloads = { { Kind = "DamageOverTime", Amount = vars.Damage * 0.3, Interval = 0.5, Duration = 3 } },
				}
			elseif form == "Aura" then
				spell.Aura = { Radius = 5, Payloads = hit }
			elseif form == "Construct" or form == "Manipulation" then
				spell.Construct = { Width = 8, Height = 5, Depth = 1.5 }
			end
		end
		if spell.Projectile then
			spell.Projectile.Radius = vars.Radius
			spell.Projectile.Speed = vars.Speed
			if spell.Triggers.OnImpact and spell.Triggers.OnImpact[1].Payloads[1] then
				spell.Triggers.OnImpact[1].Payloads[1].Amount = vars.Damage
			end
			if spell.Triggers.OnImpact and spell.Triggers.OnImpact[2] then
				spell.Triggers.OnImpact[2].Radius = vars.Explode
			end
			if vars.Homing > 0 then
				spell.Projectile.Behaviors = { { Kind = "Homing", SearchRadius = 30, TurnRate = vars.Homing } }
			end
		elseif spell.Wave and spell.Wave.Payloads[2] then
			spell.Wave.Range = vars.Range
			spell.Wave.Payloads[1].Amount = vars.Damage
			spell.Wave.Payloads[2].Magnitude = vars.Force
		end
		if vars.Charge > 0 then
			spell.Casting = { Mode = "Charged", MinimumCharge = 0.1, MaximumCharge = vars.Charge, Cooldown = 0.5 }
		end
		return spell
	end

	-- Local stage: a dark enclosed room far from the map, or in front of the player.
	local stage
	local function darkRoom()
		if stage then
			return stage
		end
		local model = Instance.new("Model")
		model.Name = "SpellVFXShowcaseRoom"
		local function slab(size, cframe, color)
			local p = Instance.new("Part")
			p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, true, true, false
			p.Size, p.CFrame, p.Color = size, cframe, color
			p.Material = Enum.Material.Concrete
			p.Parent = model
			return p
		end
		local origin = CFrame.new(0, 900, 0)
		slab(Vector3.new(160, 1, 160), origin, Color3.fromRGB(22, 20, 22))
		slab(Vector3.new(160, 60, 1), origin * CFrame.new(0, 30, -60), Color3.fromRGB(12, 11, 13))
		slab(Vector3.new(1, 60, 160), origin * CFrame.new(-60, 30, 0), Color3.fromRGB(14, 12, 14))
		slab(Vector3.new(1, 60, 160), origin * CFrame.new(60, 30, 0), Color3.fromRGB(14, 12, 14))
		slab(Vector3.new(160, 60, 1), origin * CFrame.new(0, 30, 80), Color3.fromRGB(12, 11, 13))
		model.Parent = workspace
		stage = { Model = model, Origin = origin * CFrame.new(0, 3.5, 25) }
		return stage
	end

	local function casterFrame(index)
		local spread = (index - (vars.Count + 1) / 2) * 7
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local base = if root then root.CFrame else CFrame.new(0, 5, 0)
		-- The caster is you: cast cues sit at your hands exactly as in a real cast.
		return base * CFrame.new(spread, 0, 0)
	end

	local function anchor(name, cframe, size)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
		p.Transparency = 1
		p.Size = size or Vector3.one
		p.CFrame = cframe
		p.Parent = workspace
		return p
	end

	local timeScale = function()
		return if vars.SlowMotion then 0.25 else 1
	end

	local function wait(seconds)
		task.wait(seconds / timeScale())
	end

	-- Mirrors MagicPresentation.gather/release/projectile/impact/wave/finish for one cast.
	local function castOnce(index, onlyPhase)
		local spell = buildSpell()
		local frame = casterFrame(index)
		-- "Charge" always shows a charge-up: with Charge at 0 it borrows 1.5 s.
		local chargeTime = if onlyPhase == "Charge" and vars.Charge <= 0 then 1.5 else vars.Charge
		if onlyPhase == "Charge" and vars.Charge <= 0 then
			spell.Casting = { Mode = "Charged", MinimumCharge = 0.1, MaximumCharge = chargeTime, Cooldown = 0.5 }
		end
		if (onlyPhase == nil or onlyPhase == "Charge") and chargeTime > 0 then
			local gather = anchor("SpellGatherComposition", frame, Vector3.one)
			Analyzer.stamp(gather, spell, Vector3.new(3, 4, 3), "Gather")
			wait(chargeTime)
			gather:Destroy()
			if onlyPhase == "Charge" then
				return
			end
		end
		if onlyPhase == nil or onlyPhase == "Release" then
			local release = anchor("SpellReleaseComposition", frame)
			Analyzer.stamp(release, spell, Vector3.new(5, 6, 5), "Release")
			task.delay(0.6, function()
				release:Destroy()
			end)
			if onlyPhase == "Release" then
				return
			end
		end
		local form = formName()
		local function hold(part, seconds)
			wait(seconds)
			if part.Parent then
				part:SetAttribute("VFXPhase", "End")
				task.delay(0.7, function()
					part:Destroy()
				end)
			end
		end
		if form == "Wave" then
			local wave = anchor("MagicWaveComposition", frame * CFrame.new(0, 0, -1))
			Analyzer.stamp(wave, spell, Vector3.new(spell.Wave.Range * 2, 5, spell.Wave.Range), "Release")
			task.delay(0.65, function()
				wave:Destroy()
			end)
			return
		elseif form == "Beam" then
			-- Mirrors Presentation.beam: anchor at the origin looking down the beam, size (w, w, length).
			local origin = frame * CFrame.new(0, 0.5, -1.5)
			local width, length = spell.Beam.Width, spell.Beam.Range
			local path = anchor("MagicBeamPath", origin, Vector3.one * 0.1)
			Analyzer.stamp(path, spell, Vector3.new(width, width, 0.5), "Sustain")
			local start = os.clock()
			local grow
			grow = RunService.Heartbeat:Connect(function()
				local k = math.min(1, (os.clock() - start) * timeScale() / 0.2)
				path:SetAttribute("VFXSize", Vector3.new(width, width, math.max(0.5, length * k)))
				if k >= 1 or not path.Parent then
					grow:Disconnect()
				end
			end)
			local impact = anchor(
				"MagicElementImpact",
				CFrame.new((origin * CFrame.new(0, 0, -length)).Position),
				Vector3.one * 0.1
			)
			Analyzer.stamp(impact, spell, Vector3.one * 5, "Impact")
			task.delay(0.8, function()
				impact:Destroy()
			end)
			hold(path, 2.4)
			return
		elseif form == "Field" then
			local d = spell.Field.Radius * 2
			local area = anchor("MagicAreaMarker", frame * CFrame.new(0, -1, -(d * 0.5 + 4)), Vector3.new(d, 4, d))
			Analyzer.stamp(area, spell, area.Size, "Sustain")
			hold(area, 3.5)
			return
		elseif form == "Aura" or form == "SelfEnhancement" then
			local size = if form == "Aura" then Vector3.new(10, 6, 10) else Vector3.new(5, 6, 5)
			local aura = anchor("SpellSustainedComposition", frame, size)
			Analyzer.stamp(aura, spell, size, "Sustain")
			hold(aura, 3.5)
			return
		elseif form == "Construct" or form == "Manipulation" then
			-- A visible stand-in object; constructs are real parts the composition dresses.
			local wall = anchor("MagicConstruct", frame * CFrame.new(0, -0.5, -12), Vector3.new(8, 0.4, 1.5))
			wall.Transparency = 0
			wall.Material = if form == "Construct" then Enum.Material.Slate else Enum.Material.WoodPlanks
			wall.Color = Color3.fromRGB(60, 54, 58)
			Analyzer.stamp(wall, spell, wall.Size, "Sustain")
			local base = wall.CFrame
			for step = 1, 12 do
				local h = 0.4 + 4.6 * step / 12
				wall.Size = Vector3.new(8, h, 1.5)
				wall.CFrame = base * CFrame.new(0, h * 0.5, 0)
				wait(0.025)
			end
			hold(wall, 3)
			return
		end
		local impactAt
		if onlyPhase ~= "Impact" then
			local radius = spell.Projectile.Radius
			local projectile = anchor("MagicProjectile", frame * CFrame.new(0, 0.5, -2), Vector3.one * radius * 2)
			Analyzer.stamp(projectile, spell, projectile.Size)
			local position = projectile.Position
			local heading = frame.LookVector
			local travelled, maxDistance = 0, 70
			local target = (frame * CFrame.new(18, 0, -55)).Position
			while travelled < maxDistance and projectile.Parent do
				local dt = RunService.Heartbeat:Wait() * timeScale()
				if vars.Homing > 0 then
					local desired = (target - position).Unit
					local turn = math.rad(vars.Homing) * dt
					local angle = math.acos(math.clamp(heading:Dot(desired), -1, 1))
					if angle > 1e-3 then
						heading = heading:Lerp(desired, math.min(1, turn / angle)).Unit
					end
				end
				local stepDistance = spell.Projectile.Speed * dt
				position += heading * stepDistance
				travelled += stepDistance
				projectile.CFrame = CFrame.lookAt(position, position + heading)
				if vars.Homing > 0 and (target - position).Magnitude < 2 then
					break
				end
			end
			impactAt = position
			projectile:SetAttribute("VFXPhase", "End")
			task.delay(0.7, function()
				projectile:Destroy()
			end)
		else
			impactAt = (frame * CFrame.new(0, -1.5, -20)).Position
		end
		local impact = anchor("MagicElementImpact", CFrame.new(impactAt), Vector3.one * 0.1)
		Analyzer.stamp(impact, spell, Vector3.one * 5, "Impact")
		task.delay(0.8, function()
			impact:Destroy()
		end)
	end

	local function play(onlyPhase)
		for index = 1, vars.Count do
			task.spawn(castOnce, index, onlyPhase)
		end
	end

	-- UI -------------------------------------------------------------------------------------
	local PHASES = {
		{ nil, "Full cast", "charge (if Charge > 0), release, then the spell itself" },
		{ "Charge", "Charge-up only", "the gather/charge effect at your hands" },
		{ "Release", "Release only", "the cast flash at your hands" },
		{ "Impact", "Spell + hit only", "skips the cast cue; projectiles jump to the hit" },
	}
	local QUALITIES = { "Auto", "Low", "Medium", "High" }
	local diagnose
	local ui = { Phase = 1, Quality = 1, LastPlayed = "nothing yet" }

	local gui = Instance.new("ScreenGui")
	gui.Name = "SpellVFXShowcase"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local panel = Instance.new("Frame")
	panel.Size = UDim2.fromOffset(360, 0)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.Position = UDim2.new(1, -372, 0, 12)
	panel.BackgroundColor3 = Color3.fromRGB(16, 14, 16)
	panel.BackgroundTransparency = 0.08
	panel.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 5)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = panel
	local pad = Instance.new("UIPadding")
	pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10)
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
	pad.Parent = panel
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	local function label(text, height, size, color, font)
		local l = Instance.new("TextLabel")
		l.LayoutOrder = nextOrder()
		l.Size = UDim2.new(1, 0, 0, height or 18)
		l.BackgroundTransparency = 1
		l.TextColor3 = color or Color3.fromRGB(225, 215, 200)
		l.Font = font or Enum.Font.Gotham
		l.TextSize = size or 13
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextYAlignment = Enum.TextYAlignment.Top
		l.TextWrapped = true
		l.Text = text
		l.Parent = panel
		return l
	end
	local function row(height)
		local r = Instance.new("Frame")
		r.LayoutOrder = nextOrder()
		r.Size = UDim2.new(1, 0, 0, height or 28)
		r.BackgroundTransparency = 1
		r.Parent = panel
		local l = Instance.new("UIListLayout")
		l.FillDirection = Enum.FillDirection.Horizontal
		l.Padding = UDim.new(0, 4)
		l.VerticalAlignment = Enum.VerticalAlignment.Center
		l.Parent = r
		return r
	end
	local function button(parent, text, width, callback, color)
		local b = Instance.new("TextButton")
		b.Size = if width then UDim2.new(0, width, 1, 0) else UDim2.fromScale(1, 1)
		b.BackgroundColor3 = color or Color3.fromRGB(58, 40, 34)
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.GothamBold
		b.TextSize = 13
		b.Text = text
		b.AutoButtonColor = true
		b.Parent = parent
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 4)
		c.Parent = b
		b.Activated:Connect(callback)
		return b
	end
	local function valueBox(parent, width)
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(0, width, 1, 0)
		l.BackgroundColor3 = Color3.fromRGB(30, 26, 30)
		l.TextColor3 = Color3.fromRGB(255, 236, 200)
		l.Font = Enum.Font.GothamBold
		l.TextSize = 14
		l.Parent = parent
		return l
	end

	-- One Output line per PLAY that checks each stage of the pipeline, so a silent failure is visible.
	local CollectionService = game:GetService("CollectionService")
	local Composer = require(System.Core.SpellVFXComposer)
	local Planner = require(System.Signature.SignaturePlanner)
	diagnose = function()
		local tagged = #CollectionService:GetTagged("ComposedSpellVFX")
		local spell = buildSpell()
		local okPlan, planResult = pcall(function()
			local resolved = Planner.plan(Analyzer.resolve(spell), "Sustain")
			return if resolved then (resolved.Signature .. " " .. #resolved.Layers .. " layers") else "no signature"
		end)
		local probe = anchor("SpellVFXTesterProbe", casterFrame(1) * CFrame.new(0, 3, -6), Vector3.one * 2)
		Analyzer.stamp(probe, spell, probe.Size)
		-- Untag so the live controller ignores it; this attach is the tester's own direct test.
		CollectionService:RemoveTag(probe, "ComposedSpellVFX")
		local okAttach, attachResult = pcall(function()
			local session = Renderer.attach(probe, Analyzer.read(probe), {})
			if session then
				local n = #session.Entries
				session:Stop()
				return n .. " entries built"
			end
			return "attach returned nil (disabled or budget)"
		end)
		probe:Destroy()
		local stats = Renderer.stats()
		print(
			string.format(
				"[SpellVFX Tester] diag: tagged anchors=%d | renderer hooked=%s enabled=%s | plan=%s | direct attach=%s | live sessions=%d emitters=%d meshes=%d",
				tagged,
				tostring(Composer.Signatures ~= nil),
				tostring(Renderer.Enabled),
				if okPlan then planResult else ("ERROR " .. tostring(planResult)),
				if okAttach then attachResult else ("ERROR " .. tostring(attachResult)),
				stats.Sessions,
				stats.Emitters,
				stats.Meshes
			)
		)
	end

	local refreshers = {}
	local function refresh()
		for _, fn in refreshers do
			fn()
		end
	end
	-- "< value >" selector.
	local function selector(title, getText, step)
		local r = row()
		local t = Instance.new("TextLabel")
		t.Size = UDim2.new(0, 64, 1, 0)
		t.BackgroundTransparency = 1
		t.TextColor3 = Color3.fromRGB(200, 190, 180)
		t.Font = Enum.Font.Gotham
		t.TextSize = 13
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.Text = title
		t.Parent = r
		button(r, "<", 34, function()
			step(-1)
			refresh()
		end)
		local box = valueBox(r, 178)
		button(r, ">", 34, function()
			step(1)
			refresh()
		end)
		table.insert(refreshers, function()
			box.Text = getText()
		end)
	end
	local function toggle(parent, name, get, set)
		local b
		b = button(parent, "", 83, function()
			set(not get())
			refresh()
		end)
		table.insert(refreshers, function()
			b.Text = name .. (if get() then ": ON" else ": OFF")
			b.BackgroundColor3 = if get() then Color3.fromRGB(150, 70, 40) else Color3.fromRGB(58, 40, 34)
		end)
	end

	label("SPELL VFX TESTER", 22, 17, Color3.fromRGB(255, 220, 170), Enum.Font.GothamBold)
	label(
		"Pick a school and a form, then press PLAY. Effects appear just in front of you (or in the Dark room). F8 hides this panel.",
		34,
		12,
		Color3.fromRGB(180, 170, 160)
	)
	selector("School", function()
		return schoolName()
	end, function(d)
		vars.School = (vars.School - 1 + d) % #SCHOOLS + 1
	end)
	selector("Form", function()
		return formName()
	end, function(d)
		vars.Form = (vars.Form - 1 + d) % #FORMS + 1
	end)
	selector("Shows", function()
		return PHASES[ui.Phase][2]
	end, function(d)
		ui.Phase = (ui.Phase - 1 + d) % #PHASES + 1
	end)
	local phaseHint = label("", 16, 11, Color3.fromRGB(160, 150, 140))
	table.insert(refreshers, function()
		phaseHint.Text = "  " .. PHASES[ui.Phase][3]
	end)
	local playRow = row(40)
	button(playRow, "PLAY", nil, function()
		ui.LastPlayed = schoolName() .. " " .. formName() .. " (" .. PHASES[ui.Phase][2] .. ")"
		print("[SpellVFX Tester] playing " .. ui.LastPlayed)
		play(PHASES[ui.Phase][1])
		task.delay(0.35, diagnose)
		refresh()
	end, Color3.fromRGB(170, 70, 30))

	local r = row()
	toggle(r, "Repeat", function()
		return vars.Repeat
	end, function(v)
		vars.Repeat = v
	end)
	toggle(r, "Slow-mo", function()
		return vars.SlowMotion
	end, function(v)
		vars.SlowMotion = v
	end)
	toggle(r, "5 casters", function()
		return vars.Count > 1
	end, function(v)
		vars.Count = if v then 5 else 1
	end)
	toggle(r, "Dark room", function()
		return vars.Dark
	end, function(v)
		-- The game's camera controller owns the camera every frame, so the dark room moves you
		-- instead: your character stands in an enclosed black room facing its far wall.
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		if v then
			ui.ReturnTo = root.CFrame
			root.AssemblyLinearVelocity = Vector3.zero
			player.Character:PivotTo(darkRoom().Origin)
		elseif ui.ReturnTo then
			root.AssemblyLinearVelocity = Vector3.zero
			player.Character:PivotTo(ui.ReturnTo)
		end
		vars.Dark = v
	end)
	selector("Quality", function()
		return QUALITIES[ui.Quality]
	end, function(d)
		ui.Quality = (ui.Quality - 1 + d) % #QUALITIES + 1
		player:SetAttribute("SpellVFXQuality", if ui.Quality == 1 then nil else QUALITIES[ui.Quality])
	end)
	selector("Art", function()
		return if Assets.UseCustom then "Custom assets" else "Built-in fallback"
	end, function()
		Assets.UseCustom = not Assets.UseCustom
	end)

	label(
		"SPELL VARIABLES  (change the spell, so the look follows)",
		20,
		12,
		Color3.fromRGB(255, 220, 170),
		Enum.Font.GothamBold
	)
	local function stepper(name, key, step, minimum, maximum, fmt)
		local rr = row(24)
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(0, 196, 1, 0)
		l.BackgroundTransparency = 1
		l.TextColor3 = Color3.fromRGB(205, 195, 185)
		l.Font = Enum.Font.Gotham
		l.TextSize = 12
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.Parent = rr
		button(rr, "-", 70, function()
			vars[key] = math.clamp(vars[key] - step, minimum, maximum)
			refresh()
		end)
		button(rr, "+", 70, function()
			vars[key] = math.clamp(vars[key] + step, minimum, maximum)
			refresh()
		end)
		table.insert(refreshers, function()
			l.Text = string.format("%s: " .. (fmt or "%d"), name, vars[key])
		end)
	end
	stepper("Size (hit radius)", "Radius", 0.4, 0.3, 4, "%.1f")
	stepper("Potency (damage)", "Damage", 10, 0, 120)
	stepper("Projectile speed", "Speed", 20, 20, 200)
	stepper("Charge time (s)", "Charge", 0.5, 0, 3, "%.1f")
	stepper("Explode radius", "Explode", 3, 0, 20)
	stepper("Homing (deg/s)", "Homing", 90, 0, 540)
	stepper("Push force", "Force", 15, 0, 100)
	stepper("Range / area", "Range", 3, 4, 30)

	local status = label("", 46, 11, Color3.fromRGB(160, 150, 140), Enum.Font.Code)
	table.insert(refreshers, function()
		local custom = 0
		for name in pairs(Manifest.Meshes) do
			custom += if Assets.hasCustomMesh(name) then 1 else 0
		end
		local stats = Renderer.stats()
		status.Text = string.format(
			"Last played: %s\nLive: %d effects, %d emitters, %d meshes, %d lights | meshes loaded %d",
			ui.LastPlayed,
			stats.Sessions,
			stats.Emitters,
			stats.Meshes,
			stats.Lights,
			custom
		)
	end)
	refresh()

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.F8 then
			gui.Enabled = not gui.Enabled
			refresh()
		end
	end)
	task.spawn(function()
		while gui.Parent do
			if gui.Enabled then
				refresh()
				if vars.Repeat then
					play(PHASES[ui.Phase][1])
					task.wait(2.5 + vars.Charge)
				else
					task.wait(0.5)
				end
			else
				task.wait(0.5)
			end
		end
	end)
	return Showcase
end

return Showcase
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="416">
            <Properties>
              <string name="Name">SummonCommandController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local SummonConfig = require(game:GetService("ReplicatedStorage").Shared.Configuration.MagicSummons)
local studioSandbox = game:GetService("RunService"):IsStudio()
	and require(game:GetService("ReplicatedStorage").Shared.Configuration.DevelopmentSandbox).Enabled
local Controller = {}

local commandLabels = {
	Follow = "Follow",
	Protect = "Protect",
	Attack = "Attack target",
	Move = "Move here",
	Patrol = "Patrol point",
	Hold = "Hold",
	Support = "Support",
	Dismiss = "Dismiss all",
}
local commandButtons = {}
for _, mode in ipairs(SummonConfig.CommandOrder) do
	local label = commandLabels[mode]
	local key = SummonConfig.CommandKeys[mode]
	assert(label and key, "Missing summon command UI metadata for " .. mode)
	table.insert(commandButtons, { Mode = mode, Label = label, Key = key })
end

local function makeLabel(parent: Instance, text: string, size: number, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.Text = text
	label.TextColor3 = color
	label.TextSize = size
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextWrapped = true
	label.Parent = parent
	return label
end

local function ownedSummons(): { Model }
	local folder = workspace:FindFirstChild("MagicSummons")
	local owned = {}
	if not folder then
		return owned
	end
	for _, model in folder:GetChildren() do
		if
			model:IsA("Model")
			and model:GetAttribute("MagicSummonOwnerUserId") == player.UserId
			and type(model:GetAttribute("MagicSummonId")) == "number"
		then
			table.insert(owned, model)
		end
	end
	return owned
end

function Controller.start(sendCommand: (string) -> (), cycleSelection: () -> ())
	local gui = Instance.new("ScreenGui")
	gui.Name = "SummonCommandInterface"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 12
	gui.Parent = player:WaitForChild("PlayerGui")

	local panel = Instance.new("Frame")
	panel.Name = "OrdersPanel"
	panel.AnchorPoint = if UserInputService.TouchEnabled then Vector2.zero else Vector2.new(1, 1)
	panel.Position = if UserInputService.TouchEnabled then UDim2.fromOffset(12, 52) else UDim2.new(1, -18, 1, -94)
	panel.Size = UDim2.fromOffset(292, 310)
	panel.BackgroundColor3 = Color3.fromRGB(21, 25, 30)
	panel.BackgroundTransparency = 0.08
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = gui
	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 8)
	panelCorner.Parent = panel
	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = Color3.fromRGB(101, 122, 138)
	panelStroke.Transparency = 0.45
	panelStroke.Parent = panel

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Position = UDim2.fromOffset(8, 8)
	header.Size = UDim2.new(1, -16, 0, 34)
	header.BackgroundTransparency = 1
	header.Parent = panel
	local title = makeLabel(header, "SUMMON ORDERS", 13, Color3.fromRGB(218, 229, 237))
	title.Size = UDim2.new(1, -110, 1, 0)
	local cycleButton = Instance.new("TextButton")
	cycleButton.Name = "SelectNext"
	cycleButton.AnchorPoint = Vector2.new(1, 0)
	cycleButton.Position = UDim2.new(1, -32, 0, 0)
	cycleButton.Size = UDim2.fromOffset(68, 32)
	cycleButton.BackgroundColor3 = Color3.fromRGB(50, 67, 78)
	cycleButton.BorderSizePixel = 0
	cycleButton.Font = Enum.Font.GothamBold
	cycleButton.Text = "NEXT · " .. SummonConfig.SelectionKey
	cycleButton.TextColor3 = Color3.fromRGB(237, 245, 250)
	cycleButton.TextSize = 11
	cycleButton.Parent = header
	local cycleCorner = Instance.new("UICorner")
	cycleCorner.CornerRadius = UDim.new(0, 5)
	cycleCorner.Parent = cycleButton
	cycleButton.Activated:Connect(cycleSelection)

	local status = makeLabel(panel, "Cast a Summon spell to call a companion.", 12, Color3.fromRGB(195, 207, 216))
	status.Name = "SelectedStatus"
	status.Position = UDim2.fromOffset(10, 48)
	status.Size = UDim2.new(1, -20, 0, 58)
	status.TextYAlignment = Enum.TextYAlignment.Top
	local feedback = makeLabel(panel, "", 11, Color3.fromRGB(173, 220, 202))
	feedback.Name = "CommandFeedback"
	feedback.Position = UDim2.fromOffset(10, 108)
	feedback.Size = UDim2.new(1, -20, 0, 24)

	local grid = Instance.new("Frame")
	grid.Name = "CommandButtons"
	grid.Position = UDim2.fromOffset(8, 134)
	grid.Size = UDim2.new(1, -16, 0, 144)
	grid.BackgroundTransparency = 1
	grid.Parent = panel
	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.new(0.5, -3, 0, 32)
	gridLayout.CellPadding = UDim2.fromOffset(6, 4)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = grid

	local buttons: { [string]: TextButton } = {}
	for index, command in ipairs(commandButtons) do
		local button = Instance.new("TextButton")
		button.Name = command.Mode
		button.LayoutOrder = index
		button.BackgroundColor3 = if command.Mode == "Dismiss"
			then Color3.fromRGB(89, 49, 47)
			else Color3.fromRGB(42, 51, 59)
		button.BorderSizePixel = 0
		button.Font = Enum.Font.GothamMedium
		button.Text = string.format("%s   ·   %s", command.Label, command.Key)
		button.TextColor3 = Color3.fromRGB(228, 234, 239)
		button.TextSize = 11
		button.Parent = grid
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = button
		button.Activated:Connect(function()
			if #ownedSummons() == 0 then
				return
			end
			sendCommand(command.Mode)
			feedback.Text = "Sending " .. command.Label .. " order…"
		end)
		buttons[command.Mode] = button
	end

	local hint = makeLabel(
		panel,
		"Attack uses your aimed target · Move uses your crosshair · Patrol needs two points",
		10,
		Color3.fromRGB(153, 169, 180)
	)
	hint.Position = UDim2.fromOffset(10, 292)
	hint.Size = UDim2.new(1, -20, 0, 12)

	local toggle = Instance.new("TextButton")
	toggle.Name = "OrdersToggle"
	toggle.AnchorPoint = if UserInputService.TouchEnabled then Vector2.zero else Vector2.new(1, 1)
	toggle.Position = if UserInputService.TouchEnabled then UDim2.fromOffset(12, 12) else UDim2.new(1, -18, 1, -94)
	toggle.Size = UDim2.fromOffset(132, 34)
	toggle.BackgroundColor3 = Color3.fromRGB(34, 44, 51)
	toggle.BackgroundTransparency = 0.08
	toggle.BorderSizePixel = 0
	toggle.Font = Enum.Font.GothamSemibold
	toggle.Text = "SUMMONS · 0"
	toggle.TextColor3 = Color3.fromRGB(220, 232, 240)
	toggle.TextSize = 12
	toggle.Parent = gui
	local toggleCorner = Instance.new("UICorner")
	toggleCorner.CornerRadius = UDim.new(0, 7)
	toggleCorner.Parent = toggle
	local closeButton = Instance.new("TextButton")
	closeButton.Name = "CloseOrders"
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, 0, 0, 0)
	closeButton.Size = UDim2.fromOffset(28, 32)
	closeButton.BackgroundColor3 = Color3.fromRGB(46, 56, 64)
	closeButton.BorderSizePixel = 0
	closeButton.Font = Enum.Font.GothamBold
	closeButton.Text = "×"
	closeButton.TextColor3 = Color3.fromRGB(225, 233, 239)
	closeButton.TextSize = 18
	closeButton.Visible = false
	closeButton.Parent = header
	closeButton.Activated:Connect(function()
		panel.Visible = false
		toggle.Visible = true
		closeButton.Visible = false
	end)

	local function openPanel()
		panel.Visible = true
		toggle.Visible = false
		closeButton.Visible = true
	end
	toggle.Activated:Connect(openPanel)

	local feedbackRevision = 0
	local function refresh()
		local owned = ownedSummons()
		local selectedId = player:GetAttribute("MagicSelectedSummonId")
		local selected = nil
		for _, model in ipairs(owned) do
			if model:GetAttribute("MagicSummonId") == selectedId then
				selected = model
				break
			end
		end
		toggle.Text = string.format("SUMMONS · %d", #owned)
		if #owned == 0 then
			status.Text = "Cast a Summon spell to call a companion."
		elseif selected then
			local archetype = selected:GetAttribute("MagicSummonArchetype") or "Companion"
			local role = selected:GetAttribute("MagicSummonRole") or "Guardian"
			local spellStatus = selected:GetAttribute("MagicSummonSpellStatus") or "SEARCHING"
			local spellSlot = selected:GetAttribute("MagicSummonSpellSlot") or 0
			local spellReason = selected:GetAttribute("MagicSummonSpellReason")
			local spellTarget = selected:GetAttribute("MagicSummonSpellTarget")
			local guidance = spellReason
			if not guidance or guidance == "" then
				guidance = if spellStatus == "UNASSIGNED"
					then "Basic attack active · assign a companion spell in the Summon effect to use magic"
					elseif
						spellStatus == "SEARCHING"
					then "Looking for a visible target · Guardian protects nearby; Hunter searches farther"
					elseif
						spellStatus == "FOLLOWING"
					then "Following you · choose Protect or Attack to resume target acquisition"
					elseif spellStatus == "HOLDING" then "Holding position · choose another order to resume"
					elseif spellStatus == "PATROL SET" then "Choose Patrol again to set its second point"
					else ""
			end
			status.Text = string.format(
				"%d active · #%s %s (%s) · %s%s%s",
				#owned,
				tostring(selectedId),
				archetype,
				role,
				spellStatus,
				if spellSlot > 0 then " · spell slot " .. spellSlot else "",
				if spellTarget and spellTarget ~= "" then " · target " .. spellTarget else ""
			)
			if guidance ~= "" then
				status.Text ..= "\n" .. guidance
			end
		else
			status.Text = string.format("%d active · press NEXT or N to select one", #owned)
		end
		cycleButton.Active = #owned > 0
		cycleButton.AutoButtonColor = #owned > 0
		for _, button in pairs(buttons) do
			button.Active = #owned > 0
			button.AutoButtonColor = #owned > 0
			button.TextTransparency = if #owned > 0 then 0 else 0.45
		end
		gui.Enabled = (studioSandbox or player:GetAttribute("CharacterReady") == true)
			and player:GetAttribute("MagicLabOpen") ~= true
	end

	local watchedModels: { [Instance]: boolean } = {}
	local function watchModel(model: Instance)
		if watchedModels[model] then
			return
		end
		watchedModels[model] = true
		model:GetAttributeChangedSignal("MagicSummonOwnerUserId"):Connect(refresh)
		model:GetAttributeChangedSignal("MagicSummonId"):Connect(refresh)
		model:GetAttributeChangedSignal("MagicSummonRole"):Connect(refresh)
		model:GetAttributeChangedSignal("MagicSummonSpellStatus"):Connect(refresh)
		model:GetAttributeChangedSignal("MagicSummonSpellReason"):Connect(refresh)
		model:GetAttributeChangedSignal("MagicSummonSpellSlot"):Connect(refresh)
		model:GetAttributeChangedSignal("MagicSummonSpellTarget"):Connect(refresh)
	end
	local function watchFolder(folder: Instance)
		folder.ChildAdded:Connect(function(child)
			watchModel(child)
			refresh()
		end)
		folder.ChildRemoved:Connect(refresh)
		for _, model in folder:GetChildren() do
			watchModel(model)
		end
		refresh()
	end

	workspace.ChildAdded:Connect(function(child)
		if child.Name == "MagicSummons" then
			watchFolder(child)
		end
	end)
	local existingFolder = workspace:FindFirstChild("MagicSummons")
	if existingFolder then
		watchFolder(existingFolder)
	end
	player:GetAttributeChangedSignal("MagicSelectedSummonId"):Connect(refresh)
	player:GetAttributeChangedSignal("CharacterReady"):Connect(refresh)
	player:GetAttributeChangedSignal("MagicLabOpen"):Connect(refresh)

	return {
		Feedback = function(message: any)
			feedbackRevision += 1
			local currentRevision = feedbackRevision
			feedback.TextColor3 = if message.Accepted
				then Color3.fromRGB(173, 220, 202)
				else Color3.fromRGB(255, 174, 158)
			feedback.Text = tostring(
				message.Reason or message.Mode or if message.Accepted then "Order accepted" else "Order rejected"
			)
			task.delay(3, function()
				if feedbackRevision == currentRevision then
					feedback.Text = ""
				end
			end)
		end,
		Refresh = refresh,
	}
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="417">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
-- Owns the in-game HUD (UI/HUD/*): combat vitals, spell bar, mission tracker,
-- lobby/results and world prompts. Gameplay hooks (remotes, attributes) are
-- unchanged; this is presentation only.
--
-- Cursor rule: while any HUD modal (lobby, results) is open the player
-- attribute "UIModalOpen" is true. CameraController then never locks the mouse,
-- and a Modal GuiButton keeps the Roblox cursor free, so clicks cannot re-lock it.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local SpellProgression = require(Shared.Configuration.SpellProgression)
local Config = require(Shared.Configuration.DefendTheWalls)
local HUD = script.Parent.Parent.UI.HUD
local C = require(HUD.Components)

local UIController = {}
local verbose = RunService:IsStudio()

local function nextUnlockText(message: any): string
	if not message.Saved then
		return "SAVE FAILED: REWARDS NOT CONFIRMED"
	end
	local profile = message.Profile
	if type(profile) ~= "table" then
		return "PROGRESS SAVED"
	end
	local nextName, nextXP = nil, math.huge
	for _, milestone in ipairs(SpellProgression.SlotMilestones) do
		if profile.XP < milestone.XP and milestone.XP < nextXP then
			nextName, nextXP = tostring(milestone.Slots) .. " SLOTS", milestone.XP
		end
	end
	for _, id in ipairs(SpellProgression.UnlockOrder) do
		local offer = SpellProgression.Unlocks[id]
		if not (profile.Unlocks and profile.Unlocks[id]) and profile.XP < offer.XP and offer.XP < nextXP then
			nextName, nextXP = offer.Name, offer.XP
		end
	end
	return if nextName
		then string.format("SAVED · NEXT %s AT %d XP", string.upper(nextName), nextXP)
		else "PROGRESS SAVED · CHECK GRIMOIRE UPGRADES"
end

function UIController.start(launcher: any?)
	local player = Players.LocalPlayer
	local remotes = Shared:WaitForChild("SandboxRemotes")
	local remote = remotes:WaitForChild("MissionRemote") :: RemoteEvent

	-- Modal bookkeeping and the cursor guarantee.
	local modals: { [string]: boolean } = {}
	local modalGui = C.screen("UIModalCursor", 300)
	local modalButton = C.new("TextButton", {
		Name = "ModalCursor",
		Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 1,
		Text = "",
		Modal = true,
		Visible = false,
		Selectable = false,
	}, modalGui)
	local function setModal(name: string, open: boolean)
		modals[name] = if open then true else nil
		local any = next(modals) ~= nil
		modalButton.Visible = any
		if player:GetAttribute("UIModalOpen") ~= any then
			player:SetAttribute("UIModalOpen", any)
		end
		if any then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end
	end

	local SpellState = require(HUD.SpellState)
	task.spawn(SpellState.start)
	local combat = require(HUD.CombatHUD).new(C.screen("CombatHUD", 10))
	local function openSpellbook()
		if launcher and launcher.Open then
			launcher:Open()
		end
	end
	-- Above the Grimoire (DisplayOrder 80) so its cards can be dropped on the bar.
	local bar = require(HUD.SpellBar).new(C.screen("SpellBarHUD", 90), openSpellbook)
	local tracker = require(HUD.MissionTracker).new(C.screen("MissionHUD", 12))
	local lobby = require(HUD.Lobby).new(C.screen("LobbyUI", 60), {
		Request = function(action: string)
			remote:FireServer(action)
		end,
		SetModal = setModal,
	})
	require(HUD.WorldUI).start(C.screen("WorldPrompts", 20))

	local currentId, previousIntegrity, previousWall = "", 1, 1
	remote.OnClientEvent:Connect(function(message)
		if type(message) ~= "table" then
			return
		end
		if message.Kind == "Notice" and type(message.Text) == "string" then
			if verbose then
				print("[Mission/client] server notice:", message.Text)
			end
			lobby.Notice(message.Text)
		elseif message.Kind == "Ack" then
			lobby.Ack(message)
		elseif message.Kind == "MissionResult" then
			lobby.Result(message, nextUnlockText(message))
		elseif message.Kind == "MissionState" then
			if message.Id ~= currentId then
				currentId, previousIntegrity, previousWall = message.Id, 1, 1
			end
			local ratio = (message.Gateway or 0) / math.max(1, message.GatewayMax or 1)
			if message.State == "ACTIVE" then
				for _, threshold in Config.GatewayWarnings do
					if previousIntegrity > threshold and ratio <= threshold then
						tracker.Warn(string.format("GATEWAY CRITICAL: %d%%", math.floor(ratio * 100)))
					end
				end
			end
			previousIntegrity = ratio
			local wallLevel = message.WallLevel or 1
			if message.State == "ACTIVE" and wallLevel > previousWall then
				local count = message.WallCount or 3
				tracker.Warn(
					if wallLevel > count
						then "THE INNER BASTION HAS FALLEN — HOLD THE GATE"
						else string.format("WALL %d BREACHED — FALL BACK TO WALL %d", wallLevel - 1, wallLevel),
					5
				)
			end
			previousWall = wallLevel
			local level = tracker.Update(message)
			if level then
				combat.SetLevel(level)
			end
			lobby.State(message)
		end
	end)
	remote:FireServer("State")

	-- M / D-pad up reopens the mission lobby after "Explore".
	ContextActionService:BindAction("HUDLobbyToggle", function(_, state)
		if state ~= Enum.UserInputState.Begin or UserInputService:GetFocusedTextBox() then
			return Enum.ContextActionResult.Pass
		end
		if player:GetAttribute("MagicLabOpen") == true then
			return Enum.ContextActionResult.Pass
		end
		lobby.Toggle()
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.M, Enum.KeyCode.DPadUp)

	local inventoryLinks: { RBXScriptConnection } = {}
	local hud = {}
	function hud.UpdateCombat(step: number, dashCooldown: number)
		bar.UpdateCombo(step, dashCooldown)
	end
	function hud.Reset()
		bar.UpdateCombo(0, 0)
	end
	-- Weapon and quick slots on the bar mirror the inventory.
	function hud.BindInventory(inventory: any)
		for _, link in inventoryLinks do
			link:Disconnect()
		end
		local Rules = require(Shared.Modules.ItemRules)
		local function update()
			local data = inventory.Get()
			for index = 1, 2 do
				local item = data.Quick[index]
				local key = inventory.Keys.Quick[index]
				local keyText = if key then key.Name else tostring(index)
				bar.SetConsumable(
					index,
					keyText,
					if item then Rules.displayName(item) else nil,
					if item then item.Count else nil
				)
			end
			local slot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
			local active = if slot == "PrimaryWeapon" then data.Equip.MagicFocus else data.Equip.MainHand
			bar.SetWeapon(
				if active then Rules.displayName(active) else nil,
				if active then Rules.rarity(active.Rarity).Color else nil
			)
		end
		table.insert(inventoryLinks, inventory.Changed:Connect(update))
		update()
	end
	return hud
end

return UIController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="418">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="419">
            <Properties>
              <string name="Name">ForgePreviewPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Spell Forge preview panel: the schematic arena, sigil and sequence readout,
-- redrawn from the draft and animated every frame. Extracted from GuidedSpellForge
-- (Phase 1.7); owns only its own widgets inside `previewPanel`.
local SpellVisual = require(script.Parent.GrimoireSpellVisual)
local C = require(script.Parent.SpellForgeTheme).C
local K = require(script.Parent.SpellForgeComponents)
local CategoryColor = K.CategoryColor
local ElementColor = K.ElementColor
local FormIcon = K.FormIcon
local FormVerb = K.FormVerb
local PayloadVerb = K.PayloadVerb
local EventPhrase = K.EventPhrase
local fmt = K.fmt
local new = K.new
local corner = K.corner
local stroke = K.stroke
local text = K.text
local list = K.list
local PreviewPanel = {}

-- Returns { render = redraw from the draft, step = per-frame animation }.
function PreviewPanel.mount(previewPanel: Frame, draft: any, schema: any, payloadSummary: (any) -> string)
	local arena, previewInfo, sigilFrame, anim
	do
		local headerFrame = new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1 }, previewPanel)
		text(headerFrame, "PREVIEW", 13, C.Gold, Enum.Font.GothamBlack, {
			Position = UDim2.fromOffset(16, 6),
			Size = UDim2.new(1, -32, 0, 18),
		})
		text(
			headerFrame,
			"Schematic drawn from your spell's data · Test Spell casts it for real",
			12,
			C.Faint,
			Enum.Font.Gotham,
			{
				Position = UDim2.fromOffset(16, 23),
				Size = UDim2.new(1, -32, 0, 16),
				TextTruncate = Enum.TextTruncate.AtEnd,
			}
		)
		arena = new("Frame", {
			Name = "Arena",
			Position = UDim2.fromOffset(12, 50),
			Size = UDim2.new(1, -24, 0.62, -104),
			BackgroundColor3 = Color3.fromRGB(13, 11, 16),
			BorderSizePixel = 0,
			ClipsDescendants = true,
		}, previewPanel)
		corner(arena, 10)
		stroke(arena, C.PanelEdge)
		new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(40, 26, 34), Color3.fromRGB(10, 9, 12)),
			Rotation = 90,
		}, arena)
		sigilFrame = new("Frame", {
			Size = UDim2.fromOffset(84, 84),
			Position = UDim2.new(1, -94, 0, 10),
			BackgroundTransparency = 1,
			ZIndex = 4,
		}, arena)
		previewInfo = new("ScrollingFrame", {
			Name = "Sequence",
			Position = UDim2.new(0, 12, 0.62, 8),
			Size = UDim2.new(1, -24, 0.38, -20),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
		}, previewPanel)
		list(previewInfo, 6)
	end

	local function arenaShape(name, size, color, round, z)
		local item = new("Frame", {
			Name = name,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = size,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = z or 2,
		}, arena)
		if round then
			corner(item, 999)
		end
		return item
	end

	local function mainEvent(scope)
		local form = schema.Forms[scope.Form] or {}
		local preferred = form.DefaultEvent
		if preferred and scope.Triggers and scope.Triggers[preferred] and #scope.Triggers[preferred] > 0 then
			return preferred
		end
		for _, eventName in schema.EventOrder do
			if scope.Triggers and scope.Triggers[eventName] and #scope.Triggers[eventName] > 0 then
				return eventName
			end
		end
		return nil
	end

	local function renderPreview()
		for _, child in arena:GetChildren() do
			if child:IsA("GuiObject") and child ~= sigilFrame then
				child:Destroy()
			end
		end
		for _, child in sigilFrame:GetChildren() do
			child:Destroy()
		end
		pcall(SpellVisual.render, sigilFrame, draft, true)
		local color = ElementColor[draft.Element] or C.Arcane
		local ground = arenaShape("Ground", UDim2.new(1, 0, 0, 2), C.Rail, false, 1)
		ground.Position = UDim2.fromScale(0.5, 0.78)
		local caster = text(arena, "●", 34, C.Ink, Enum.Font.GothamBold, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.14, 0.78),
			Size = UDim2.fromOffset(40, 44),
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 3,
		})
		local dummy = text(arena, "■", 34, C.Blood, Enum.Font.GothamBold, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.82, 0.78),
			Size = UDim2.fromOffset(40, 44),
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 3,
		})
		text(arena, "YOU", 10, C.Faint, Enum.Font.GothamBlack, {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.14, 0.8),
			Size = UDim2.fromOffset(60, 14),
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		text(arena, "TARGET", 10, C.Faint, Enum.Font.GothamBlack, {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.82, 0.8),
			Size = UDim2.fromOffset(60, 14),
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		local event = mainEvent(draft)
		local pops = {}
		local explodeRadius, spawnForm
		for _, step in (event and draft.Triggers[event]) or {} do
			if step.Behavior == "Explode" then
				explodeRadius = step.Radius or 7
			elseif step.Behavior == "SpawnEffect" and step.Effect then
				spawnForm = step.Effect.Form
			end
			for _, payload in step.Payloads or {} do
				if #pops < 4 then
					local label = if payload.Kind == "Damage"
						then "−" .. fmt(payload.Amount or 0)
						else string.upper(PayloadVerb[payload.Kind] or payload.Kind)
					local definition = schema.Payloads[payload.Kind] or {}
					table.insert(pops, { Text = label, Color = CategoryColor[definition.Category] or C.Ink })
				end
			end
		end
		local popLabels = {}
		for index, pop in pops do
			popLabels[index] = text(arena, pop.Text, 13, pop.Color, Enum.Font.GothamBlack, {
				AnchorPoint = Vector2.new(0.5, 1),
				Size = UDim2.fromOffset(160, 18),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextTransparency = 1,
				TextStrokeTransparency = 1,
				TextStrokeColor3 = C.Backdrop,
				ZIndex = 6,
			})
		end
		local mechanics = draft[draft.Form] or {}
		local orb = arenaShape("Orb", UDim2.fromOffset(16, 16), color, true, 5)
		local glow = arenaShape("Glow", UDim2.fromOffset(34, 34), color, true, 4)
		glow.BackgroundTransparency = 0.7
		local ring = arenaShape("Burst", UDim2.fromOffset(10, 10), color, true, 3)
		ring.BackgroundTransparency = 1
		local ringStroke = stroke(ring, color, 3)
		local area = arenaShape("Area", UDim2.fromOffset(10, 10), color, true, 2)
		area.BackgroundTransparency = 0.85
		local areaStroke = stroke(area, color, 2, 0.3)
		local beam = arenaShape("Beam", UDim2.fromOffset(10, 6), color, false, 4)
		local spawned = arenaShape("Spawned", UDim2.fromOffset(10, 10), C.Gold, true, 2)
		spawned.BackgroundTransparency = 0.85
		stroke(spawned, C.Gold, 2, 0.3)
		local speed = mechanics.Speed or 80
		anim = {
			Form = draft.Form,
			Travel = math.clamp(70 / math.max(speed, 1), 0.25, 1.8),
			Size = math.clamp((mechanics.Radius or 1) * 8 + 8, 8, 40),
			AreaSize = math.clamp((mechanics.Radius or 10) / 30, 0.15, 0.6),
			Explode = explodeRadius and math.clamp(explodeRadius / 25, 0.12, 0.7) or nil,
			Spawn = spawnForm,
			Event = event,
			Orb = orb,
			Glow = glow,
			Ring = ring,
			RingStroke = ringStroke,
			Area = area,
			AreaStroke = areaStroke,
			Beam = beam,
			Spawned = spawned,
			Pops = popLabels,
			Dummy = dummy,
			Caster = caster,
			Start = os.clock(),
		}
		-- Sequence readout: the same chain as the tree, in reading order.
		for _, child in previewInfo:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local lineOrder = 0
		local function line(value, colorValue, font, indent)
			lineOrder += 1
			text(previewInfo, value, 13, colorValue, font or Enum.Font.GothamMedium, {
				Size = UDim2.new(1, -(indent or 0), 0, 0),
				Position = UDim2.fromOffset(indent or 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = lineOrder,
			})
		end
		line("SEQUENCE", C.Faint, Enum.Font.GothamBlack)
		local function describe(scope, prefix)
			line(
				prefix .. (FormIcon[scope.Form] or "◆") .. "  " .. (FormVerb[scope.Form] or scope.Form),
				C.Ink,
				Enum.Font.GothamBold
			)
			for _, eventName in schema.EventOrder do
				local steps = scope.Triggers and scope.Triggers[eventName]
				if steps and #steps > 0 then
					line(prefix .. "   ◆ " .. (EventPhrase[eventName] or eventName), C.Gold)
					for _, step in steps do
						if step.Behavior == "SpawnEffect" and type(step.Effect) == "table" then
							describe(step.Effect, prefix .. "      ")
						elseif step.Behavior then
							line(
								prefix .. "      * " .. ((schema.Behaviors[step.Behavior] or {}).Label or step.Behavior),
								C.Warn
							)
						end
						if step.Behavior ~= "SpawnEffect" then
							for _, payload in step.Payloads or {} do
								line(
									prefix
										.. (if step.Behavior then "         " else "      ")
										.. "→ "
										.. (PayloadVerb[payload.Kind] or payload.Kind)
										.. " · "
										.. payloadSummary(payload),
									C.Muted
								)
							end
						end
					end
				end
			end
		end
		describe(draft, "")
	end

	local function stepAnimation()
		if not anim or not arena.Parent or not arena.Visible then
			return
		end
		local width, height = arena.AbsoluteSize.X, arena.AbsoluteSize.Y
		if width < 10 then
			return
		end
		local t = os.clock() - anim.Start
		local form = anim.Form
		local cx, cy = 0.14, 0.62
		local tx, ty = 0.82, 0.62
		local travel = if form == "Projectile" then anim.Travel elseif form == "Beam" then 0.15 else 0.6
		local period = travel + 1.6
		local phase = t % period
		local hit = phase >= travel
		local after = math.max(0, phase - travel)
		local orb, glow, ring, area, beam, spawned = anim.Orb, anim.Glow, anim.Ring, anim.Area, anim.Beam, anim.Spawned
		orb.Visible, glow.Visible, beam.Visible = false, false, false
		ring.Visible, area.Visible, spawned.Visible = false, false, false
		if form == "Projectile" then
			local alpha = math.clamp(phase / travel, 0, 1)
			local x = cx + (tx - cx) * alpha
			orb.Visible, glow.Visible = not hit, not hit
			orb.Size = UDim2.fromOffset(anim.Size, anim.Size)
			glow.Size = UDim2.fromOffset(anim.Size * 2.2, anim.Size * 2.2)
			orb.Position = UDim2.fromScale(x, cy)
			glow.Position = orb.Position
		elseif form == "Beam" then
			beam.Visible = phase < travel + 0.35
			beam.Position = UDim2.fromScale((cx + tx) / 2, cy)
			beam.Size = UDim2.new(tx - cx, 0, 0, 6)
			beam.BackgroundTransparency = math.clamp((phase - travel) / 0.35, 0, 1)
		elseif form == "Wave" then
			local alpha = math.clamp(phase / (travel + 0.5), 0, 1)
			ring.Visible = true
			ring.Position = UDim2.fromScale(cx, cy)
			local d = alpha * width * 1.6
			ring.Size = UDim2.fromOffset(d, d)
			anim.RingStroke.Transparency = alpha
		elseif form == "Field" or form == "Aura" or form == "Construct" or form == "SelfEnhancement" then
			local centerX = if form == "Field" then tx else cx
			area.Visible = true
			area.Position = UDim2.fromScale(centerX, cy)
			local d = anim.AreaSize * height * 2 * (1 + 0.06 * math.sin(t * 4))
			area.Size = UDim2.fromOffset(d, d)
			hit = form == "Field" or form == "Aura"
			after = (t % 1.2)
		else
			orb.Visible = true
			orb.Position = UDim2.fromScale(tx, cy)
		end
		if hit and form ~= "Wave" then
			if anim.Explode then
				ring.Visible = true
				ring.Position = UDim2.fromScale(tx, cy)
				local grow = math.clamp(after / 0.5, 0, 1)
				local d = grow * anim.Explode * height * 2
				ring.Size = UDim2.fromOffset(d, d)
				anim.RingStroke.Transparency = grow * 0.8
			end
			if anim.Spawn then
				spawned.Visible = true
				spawned.Position = UDim2.fromScale(tx, cy)
				local d = math.clamp(after / 0.3, 0, 1) * height * 0.5
				spawned.Size = UDim2.fromOffset(d, d)
			end
			anim.Dummy.TextColor3 = if after < 0.2 then C.Ink else C.Blood
		else
			anim.Dummy.TextColor3 = C.Blood
		end
		for index, pop in anim.Pops do
			local local_t = after - (index - 1) * 0.12
			local visible = hit and local_t > 0
			local fade = math.clamp(local_t / 1.2, 0, 1)
			pop.TextTransparency = if visible then fade else 1
			pop.TextStrokeTransparency = if visible then 0.3 + fade * 0.7 else 1
			pop.Position = UDim2.new(tx, 0, cy - 0.16 - fade * 0.12, -(index - 1) * 18)
		end
	end
	return { render = renderPreview, step = stepAnimation }
end

return PreviewPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="420">
            <Properties>
              <string name="Name">GrimoireLibraryLayout</string>
              <string name="Source"><![CDATA[--!strict
-- Nine square cards per physical page: 18 per wide spread, nine when stacked.
local Layout = {}
function Layout.compute(width: number, height: number, columns: number, count: number)
	local gap = 8
	local areaHeight = math.max(0, height - 44)
	local twoPages = columns == 6
	local pageWidth = if twoPages then width / 2 else width
	local cell = math.max(0, math.floor(math.min((pageWidth - 26 - gap * 2) / 3, (areaHeight - gap * 2) / 3)))
	local gridSize = cell * 3 + gap * 2
	local top = math.max(0, math.floor((areaHeight - gridSize) / 2))
	local positions = {}
	for index = 1, count do
		local side = if twoPages then math.floor((index - 1) / 9) else 0
		local onPage = (index - 1) % 9
		positions[index] = {
			X = side * pageWidth + math.floor((pageWidth - gridSize) / 2) + (onPage % 3) * (cell + gap),
			Y = top + math.floor(onPage / 3) * (cell + gap),
		}
	end
	return { Cell = cell, Positions = positions, ArrowY = height - 38, LabelY = height - 36 }
end
return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="421">
            <Properties>
              <string name="Name">GrimoireLibraryView</string>
              <string name="Source"><![CDATA[--!strict
-- The library owns presentation state only. The server owns every saved record and equip.
local Shared = game:GetService("ReplicatedStorage").Shared
local Library = require(Shared.Modules.GrimoireLibrary)
local Summary = require(Shared.Modules.GrimoireSummary)
local Starters = require(Shared.Modules.GrimoireStarters)
local Theme = require(script.Parent.SpellForgeTheme).Book
local K = require(script.Parent.SpellForgeComponents)
local SpellVisual = require(script.Parent.GrimoireSpellVisual)
local LibraryLayout = require(script.Parent.GrimoireLibraryLayout)
local ProgressionConfig = require(Shared.Configuration.SpellProgression)
local ProgressionRules = require(Shared.Modules.SpellProgressionRules)

local View = {}

local function label(parent, value, size, color, position, dimensions, font)
	local item = Instance.new("TextLabel")
	item.BackgroundTransparency = 1
	item.Text = value
	item.TextColor3 = color
	item.TextSize = size
	item.Font = font or Enum.Font.Gotham
	item.TextWrapped = true
	item.TextXAlignment = Enum.TextXAlignment.Left
	item.TextYAlignment = Enum.TextYAlignment.Center
	item.Position = position
	item.Size = dimensions
	item.Parent = parent
	return item
end

local function outline(parent, color, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness or 1
	stroke.Parent = parent
	return stroke
end

function View.new(ctx)
	local descriptions = {}
	for _, build in ipairs({ Starters.buildShowcase, Starters.buildShowcaseExpansion }) do
		for _, template in ipairs(build()) do
			descriptions[template.Definition.Name] = template.Description
		end
	end
	local self = {
		Catalog = Library.empty(),
		Query = { Search = "", Sort = "Name", Status = "Active", Collection = "All", Form = "All", Element = "All" },
		Selected = nil,
		DetailTab = "Overview",
		Slot = 1,
		Busy = false,
		Page = 1,
		ChoosingSlot = nil,
		ProgressionPage = false,
		-- "Mine" = spells the player made; "Curated" = seeded starter/showcase spells.
		Shelf = "Mine",
	}
	function self.slotLimit(): number
		if self.Catalog.Unrestricted then
			return 9
		end
		return ProgressionRules.slots(self.Catalog.Progression or { XP = 0 })
	end
	function self.chooseForSlot(slot)
		self.ChoosingSlot = slot
		self.Slot = slot
		self.Selected = nil
		self.Page = 1
		self.Query =
			{ Search = "", Sort = "Name", Status = "Active", Collection = "All", Form = "All", Element = "All" }
	end
	local function command(action, extra)
		if self.Busy then
			ctx.message("Waiting for the library update…", false)
			return
		end
		local data = extra or {}
		data.Action = action
		data.Id = data.Id or self.Selected
		self.Busy = true
		ctx.request:FireServer("Library", data)
	end
	local function purchase(action, id, expectedRank)
		if self.Busy then
			return
		end
		self.Busy = true
		ctx.request:FireServer("Progression", { Action = action, Id = id, ExpectedRank = expectedRank })
	end
	function self.receive(ok, message, catalog)
		self.Busy = false
		self.Catalog = catalog
		if self.Selected and not catalog.Records[self.Selected] then
			self.Selected = nil
		end
		ctx.message(message, ok)
	end
	local function action(description, caption, callback)
		return ctx.button(ctx.row(description), caption, callback)
	end
	local function field(description, value, change)
		local frame = ctx.row(description)
		local title = frame:FindFirstChildOfClass("TextLabel")
		if title then
			title.Size = UDim2.new(0.42, 0, 1, 0)
		end
		local box = Instance.new("TextBox")
		box.Size = UDim2.new(0.55, 0, 1, 0)
		box.Position = UDim2.fromScale(0.44, 0)
		box.BackgroundColor3 = K.C.Input
		box.TextColor3 = Theme.Ink
		box.BorderColor3 = Theme.Border
		box.BorderSizePixel = 1
		box.Font = Enum.Font.GothamMedium
		box.Text = value
		box.TextSize = 13
		box.ClearTextOnFocus = false
		box.Parent = frame
		box.Focused:Connect(function()
			box.BorderColor3, box.BorderSizePixel = Theme.Gold, 2
		end)
		box.FocusLost:Connect(function()
			box.BorderColor3, box.BorderSizePixel = Theme.Border, 1
			change(box.Text)
		end)
	end
	local function cycle(label, value, options, change)
		ctx.select(label, value, options, change, nil, nil, nil, nil, true)
	end
	local function isCurated(record)
		for _, tag in ipairs(Library.SystemTags) do
			if string.find(record.Tags, tag, 1, true) then
				return true
			end
		end
		return false
	end
	local function openRecord(id)
		self.Selected = id
		self.DetailTab = "Overview"
		ctx.rebuild()
		ctx.top()
	end
	local function card(parent, result, index, columns)
		local item = Instance.new("TextButton")
		item.Name = "SpellCard_" .. result.Id
		item.Size = UDim2.fromOffset(120, 120)
		item.BackgroundColor3 = Theme.Surface
		item.BorderSizePixel = 0
		item.Text = ""
		item.AutoButtonColor = false
		item.Parent = parent
		K.corner(item, 12)
		local edge = outline(item, Theme.Border, 1)
		K.hover(item, Theme.Surface, K.C.CardHover)
		item.SelectionGained:Connect(function()
			edge.Color = Theme.Gold
		end)
		item.SelectionLost:Connect(function()
			edge.Color = Theme.Border
		end)
		local d = result.Record.Definition
		-- Press-and-drag a card onto an open spell bar slot to equip it there.
		item.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				-- Lazy so the library view still loads where the HUD is absent (tests).
				local hud = script.Parent:FindFirstChild("HUD")
				if hud then
					require(hud:WaitForChild("SpellState") :: any).pressCard(result.Id, d)
				end
			end
		end)
		local accent = K.ElementColor[d.Element] or Theme.Gold
		local icon = K.text(item, K.FormIcon[d.Form] or "◆", 22, accent, Enum.Font.GothamBold, {
			Name = "GeneratedSpellIcon",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.1),
			Size = UDim2.fromScale(0.4, 0.4),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = K.C.Input,
		})
		K.new("UIAspectRatioConstraint", {}, icon)
		K.corner(icon, 999)
		K.stroke(icon, accent, 1, 0.5)
		local nameLabel = label(
			item,
			d.Name,
			14,
			Theme.Ink,
			UDim2.fromScale(0.06, 0.54),
			UDim2.fromScale(0.88, 0.2),
			Enum.Font.GothamBold
		)
		nameLabel.TextScaled = true
		local nameLimit = Instance.new("UITextSizeConstraint")
		nameLimit.MinTextSize, nameLimit.MaxTextSize = 9, 16
		nameLimit.Parent = nameLabel
		label(
			item,
			d.Form .. "  ·  " .. d.Element,
			11,
			Theme.MutedInk,
			UDim2.fromScale(0.06, 0.74),
			UDim2.fromScale(0.88, 0.11)
		).TextXAlignment =
			Enum.TextXAlignment.Center
		local ok, estimate = pcall(ctx.spec.estimate, d)
		label(
			item,
			if ok and estimate
				then K.fmt(estimate.ManaDemand or 0) .. " mana · " .. K.fmt(estimate.Strain or 0) .. " strain"
				else "",
			10,
			Color3.fromRGB(120, 170, 255),
			UDim2.fromScale(0.06, 0.86),
			UDim2.fromScale(0.88, 0.1),
			Enum.Font.GothamBold
		).TextXAlignment =
			Enum.TextXAlignment.Center
		item.Activated:Connect(function()
			openRecord(result.Id)
		end)
		return item
	end
	local function tabButton(parent, name, index, columns)
		local item = Instance.new("TextButton")
		local gap = 8
		local cell = if columns == 4 then 104 else 84
		local gridWidth = columns * cell + (columns - 1) * gap
		item.Position = UDim2.new(0.5, -gridWidth / 2 + (index - 1) * (cell + gap), 0, 0)
		item.Size = UDim2.fromOffset(cell, cell)
		item.BackgroundColor3 = if self.DetailTab == name then Theme.Accent else Theme.Surface
		item.TextColor3 = if self.DetailTab == name then Theme.OnAccent else Theme.Ink
		item.BorderSizePixel = 0
		item.Text = name:upper()
		item.TextSize = 13
		item.TextWrapped = true
		item.Font = Enum.Font.GothamBold
		item.Parent = parent
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = item
		local edge = outline(item, if self.DetailTab == name then Theme.Gold else Theme.Border, 1)
		item.SelectionGained:Connect(function()
			edge.Color, edge.Thickness = Theme.Gold, 3
		end)
		item.SelectionLost:Connect(function()
			edge.Color, edge.Thickness = if self.DetailTab == name then Theme.Gold else Theme.Border, 1
		end)
		item.Activated:Connect(function()
			self.DetailTab = name
			ctx.rebuild()
		end)
	end
	local function details(record)
		local d = record.Definition
		if self.DetailTab == "Overview" then
			ctx.info(Summary.describe(d, ctx.schema, ctx.spec), 180)
		elseif self.DetailTab == "Effects" then
			local lines = {}
			for _, event in ipairs(ctx.schema.EventOrder) do
				for _, step in ipairs(d.Triggers[event] or {}) do
					local effects = {}
					for _, payload in ipairs(step.Payloads or {}) do
						table.insert(
							effects,
							(ctx.schema.Payloads[payload.Kind] and ctx.schema.Payloads[payload.Kind].Label)
								or payload.Kind
						)
					end
					if step.Behavior then
						table.insert(effects, step.Behavior)
					end
					if #effects > 0 then
						table.insert(
							lines,
							(ctx.schema.EventLabels[event] or event) .. "  →  " .. table.concat(effects, ", ")
						)
					end
				end
			end
			ctx.info(#lines > 0 and table.concat(lines, "\n") or "No effects configured.", 110)
		elseif self.DetailTab == "Requirements" then
			local rules = d.TargetRules or {}
			ctx.info(
				"Target: "
					.. tostring(d.Targeting)
					.. "\nRange: "
					.. tostring(rules.Range or "form default")
					.. "\nRelationship: "
					.. tostring(rules.Relationship or "Any")
					.. "\nLine of sight: "
					.. (rules.RequiresLineOfSight and "required" or "not required")
					.. "\nMaterial: "
					.. (d.Material and tostring(d.Material.Material or "eligible tagged object") or "none"),
				120
			)
		else
			ctx.info(
				"Element: "
					.. tostring(d.Element)
					.. "\nVisual palette: "
					.. tostring((d.Visual or {}).Palette or "custom")
					.. "\nCasting mode: "
					.. tostring((d.Casting or {}).Mode or "Instant")
					.. "\nForm: "
					.. tostring(d.Form),
				110
			)
		end
	end
	local function renderRecord(record)
		local d = record.Definition
		ctx.showPreview(d)
		local sidePreview = ctx.hasSidePreview()
		if self.ChoosingSlot then
			action(
				"Place this premade spell in slot " .. self.ChoosingSlot,
				"EQUIP IN SLOT " .. self.ChoosingSlot,
				function()
					command("Equip", { Slot = self.ChoosingSlot })
				end
			)
		end
		action("Return to the spell collection", "‹ ALL SPELLS", function()
			self.Selected = nil
			ctx.rebuild()
			ctx.top()
		end)
		local hero = ctx.block(if sidePreview then 110 else 164)
		hero.BackgroundColor3 = Theme.Surface
		hero.BackgroundTransparency = 0
		local heroCorner = Instance.new("UICorner")
		heroCorner.CornerRadius = UDim.new(0, 8)
		heroCorner.Parent = hero
		outline(hero, Theme.Border, 1)
		if not sidePreview then
			local icon = Instance.new("Frame")
			icon.Name = "GeneratedSpellPreview"
			icon.Position = UDim2.fromOffset(15, 15)
			icon.Size = UDim2.fromOffset(125, 132)
			icon.Parent = hero
			SpellVisual.render(icon, d, false)
		end
		local textLeft = if sidePreview then 14 else 154
		local textMargin = if sidePreview then 28 else 168
		label(
			hero,
			d.Name,
			26,
			Theme.Ink,
			UDim2.fromOffset(textLeft, 9),
			UDim2.new(1, -textMargin, 0, 42),
			Enum.Font.GothamBold
		)
		label(
			hero,
			(if isCurated(record) then "CURATED SPELL" else "YOUR SPELL") .. "  ·  " .. d.Form .. "  ·  " .. d.Element,
			11,
			Theme.Gold,
			UDim2.fromOffset(textLeft, 50),
			UDim2.new(1, -textMargin, 0, 24),
			Enum.Font.GothamBold
		)
		label(
			hero,
			descriptions[d.Name] or "A saved spell in your library.",
			12,
			Theme.MutedInk,
			UDim2.fromOffset(textLeft, 75),
			UDim2.new(1, -textMargin, 0, if sidePreview then 30 else 70)
		)
		local assigned = {}
		for slot, id in pairs(self.Catalog.Assignments) do
			if id == self.Selected then
				table.insert(assigned, slot)
			end
		end
		table.sort(assigned)
		ctx.info(
			if #assigned > 0
				then "EQUIPPED IN SLOT " .. table.concat(assigned, ", ")
				else "SAVED IN LIBRARY · NOT EQUIPPED",
			34
		)
		if not self.Catalog.Unrestricted and self.Catalog.Progression then
			local profile = self.Catalog.Progression
			local rank = ProgressionRules.rank(profile, self.Selected)
			local priced = ctx.spec.copy(d)
			local values = ProgressionRules.reprice(priced, ctx.spec.estimate, ctx.spec.copy)
			local usable, reason = ProgressionRules.canUse(profile, d, self.Selected, ctx.spec.estimate)
			ctx.info(
				string.format(
					"COMBAT RANK %d / 3 · %d MANA · %d STRAIN · %d COMPLEXITY · %.2fs COOLDOWN\n%s",
					rank,
					values.ManaDemand,
					values.Strain,
					values.Complexity,
					priced.Casting.Cooldown,
					if usable then "READY FOR LIVE COMBAT" else reason
				),
				68
			)
			if rank < #ProgressionConfig.RankPrices then
				local nextRank = rank + 1
				local price = ProgressionConfig.RankPrices[nextRank]
				local xp = ProgressionConfig.RankXP[nextRank]
				action(
					string.format(
						"Rank %d raises this spell's limits to %d mana, %d strain and %d complexity. Edit it to use the added room. Requires %d XP and %d Marks",
						nextRank,
						ProgressionConfig.RankManaLimits[nextRank + 1],
						ProgressionConfig.RankStrainLimits[nextRank + 1],
						ProgressionConfig.RankComplexityLimits[nextRank + 1],
						xp,
						price
					),
					"UPGRADE SPELL",
					function()
						ctx.confirm(
							"Spend " .. price .. " Marks to upgrade “" .. d.Name .. "” to rank " .. nextRank .. "?",
							function()
								purchase("Rank", self.Selected, rank)
							end
						)
					end
				)
			end
		end
		local columns = if ctx.width() >= 470 then 4 else 2
		for row = 1, math.ceil(4 / columns) do
			local tabs = ctx.block((if columns == 4 then 104 else 84) + 4)
			for column = 1, columns do
				local index = (row - 1) * columns + column
				local names = { "Overview", "Effects", "Requirements", "Appearance" }
				if names[index] then
					tabButton(tabs, names[index], column, columns)
				end
			end
		end
		details(record)
		if self.ChoosingSlot then
			return
		end
		ctx.heading("USE THIS SPELL")
		action("Edit as a working copy. Saving updates this library record.", "EDIT SPELL", function()
			ctx.editRecord(self.Selected, record.Definition)
		end)
		action("Make a separate saved copy", "DUPLICATE", function()
			command("Duplicate")
		end)
		if record.Archived then
			action("Return this spell to the active library", "RESTORE", function()
				command("Restore")
			end)
		else
			cycle("Combat destination", self.Slot, { 1, 2, 3, 4, 5, 6, 7, 8, 9 }, function(value)
				self.Slot = value
			end)
			action("Explicitly place this saved spell in a combat slot", "EQUIP & EDIT…", function()
				ctx.confirm(
					"Replace slot "
						.. self.Slot
						.. " with “"
						.. d.Name
						.. "”? Unsaved edits in that slot will be discarded. The library spell remains saved.",
					function()
						ctx.pendingEdit(self.Slot)
						command("Equip", { Slot = self.Slot })
					end
				)
			end)
			for _, slot in ipairs(assigned) do
				action("Equipped in slot " .. slot, "UNEQUIP…", function()
					ctx.confirm("Unequip slot " .. slot .. "? Its saved spell remains in the library.", function()
						command("Unequip", { Slot = tonumber(slot) })
					end)
				end)
			end
		end
		ctx.heading("ORGANIZE")
		field("Name (Enter)", d.Name, function(value)
			if value ~= d.Name then
				command("Rename", { Name = value })
			end
		end)
		field("Labels (Enter)", Library.labels(record), function(value)
			if value ~= Library.labels(record) then
				command("Tags", { Tags = value })
			end
		end)
		cycle("Collection", record.Collection, self.Catalog.Collections, function(value)
			command("Move", { Collection = value })
		end)
		action("Keep this spell close", record.Favorite and "REMOVE BOOKMARK" or "BOOKMARK", function()
			command("Favorite")
		end)
		if record.Archived then
			action("Remove this archived spell forever", "DELETE…", function()
				ctx.confirm("Permanently delete “" .. d.Name .. "”? This cannot be undone.", function()
					command("Delete")
				end)
			end)
		else
			action("Keep this spell in the archive", "ARCHIVE…", function()
				ctx.confirm("Archive “" .. d.Name .. "”? Unequip it first if it is in a combat slot.", function()
					command("Archive")
				end)
			end)
		end
	end
	local function renderCatalog()
		local mine, curated = {}, {}
		for _, result in ipairs(Library.query(self.Catalog, self.Query)) do
			table.insert(if isCurated(result.Record) then curated else mine, result)
		end
		local results = if self.Shelf == "Curated" then curated else mine
		local shelfBar = ctx.block(44)
		shelfBar.Name = "LibraryShelves"
		for index, shelf in ipairs({
			{ Id = "Mine", Label = "MY SPELLS", Count = #mine },
			{ Id = "Curated", Label = "CURATED SPELLS", Count = #curated },
		}) do
			local active = self.Shelf == shelf.Id
			local tab = K.pill(shelfBar, shelf.Label .. "  ·  " .. shelf.Count, function()
				if not active then
					self.Shelf, self.Page = shelf.Id, 1
					ctx.rebuild()
				end
			end)
			tab.Name = "Shelf_" .. shelf.Id
			tab.Size = UDim2.new(0.5, -5, 0, 38)
			tab.Position = UDim2.new((index - 1) * 0.5, if index == 1 then 0 else 5, 0, 2)
			tab.BackgroundColor3 = if active then K.C.Gold else K.C.Card
			tab.TextColor3 = if active then K.C.Backdrop else K.C.Ink
		end
		local columns = if ctx.width() >= 620 then 6 else 3
		local pageSize = columns * 3
		local spellPages = math.max(1, math.ceil(#results / pageSize))
		local function nextValue(value, choices)
			local index = table.find(choices, value) or 0
			return choices[index % #choices + 1]
		end
		local toolOptions = {}
		local function tool(labelText, detailText, symbol, actionCallback, inputValue, onInput)
			table.insert(toolOptions, {
				Label = labelText,
				Detail = detailText,
				Symbol = symbol,
				Action = actionCallback,
				Input = inputValue,
				OnInput = onInput,
			})
		end
		tool("UPGRADES", "Unlock spellcraft and view loadout growth", "✦", function()
			self.ProgressionPage = true
			ctx.rebuild()
		end)
		tool("SEARCH", "Find a spell by name", "⌕", nil, self.Query.Search, function(value)
			self.Query.Search, self.Page = value, 1
			ctx.rebuild()
		end)
		local statuses = { "Active", "Favorites", "Equipped", "Unequipped", "Archived" }
		tool("SHOW", self.Query.Status, "◉", function()
			self.Query.Status, self.Page = nextValue(self.Query.Status, statuses), 1
			ctx.rebuild()
		end)
		local sorts = { "Name", "Recent", "Cost" }
		tool("SORT", self.Query.Sort, "↕", function()
			self.Query.Sort, self.Page = nextValue(self.Query.Sort, sorts), 1
			ctx.rebuild()
		end)
		local collections = { "All" }
		for _, name in ipairs(self.Catalog.Collections) do
			table.insert(collections, name)
		end
		tool("COLLECTION", self.Query.Collection, "▦", function()
			self.Query.Collection, self.Page = nextValue(self.Query.Collection, collections), 1
			ctx.rebuild()
		end)
		local forms = { "All" }
		for _, name in ipairs(ctx.schema.FormOrder) do
			table.insert(forms, name)
		end
		tool("FORM", self.Query.Form, "◇", function()
			self.Query.Form, self.Page = nextValue(self.Query.Form, forms), 1
			ctx.rebuild()
		end)
		local elements = { "All" }
		for _, name in ipairs(ctx.schema.Elements) do
			table.insert(elements, name)
		end
		tool("ELEMENT", self.Query.Element, "✦", function()
			self.Query.Element, self.Page = nextValue(self.Query.Element, elements), 1
			ctx.rebuild()
		end)
		tool("RESET FILTERS", "Show every active spell", "↺", function()
			self.Query =
				{ Search = "", Sort = "Name", Status = "Active", Collection = "All", Form = "All", Element = "All" }
			self.Page = 1
			ctx.rebuild()
		end)
		tool("NEW COLLECTION", "Name a collection", "+", nil, "", function(value)
			if value ~= "" then
				command("Collection", { Name = value })
			end
		end)
		tool("NEW SPELL", "Create without a combat slot", "+", ctx.createNew)
		if ctx.hasWorkingDraft() then
			tool("RESUME DRAFT", "Continue your saved work", "↗", ctx.resumeDraft)
		end
		tool("EQUIPPED", "Return to the nine slots", "◇", ctx.slots)
		tool("HELP", "Read the spell guide", "?", ctx.help)
		tool("SAVE LIBRARY", self.Catalog.SaveState or "Save your collection", "✧", function()
			command("RetrySave")
		end)
		local toolPages = math.ceil(#toolOptions / pageSize)
		local totalPages = spellPages + toolPages
		self.Page = math.clamp(self.Page, 1, totalPages)
		local holder = ctx.block(ctx.height())
		holder.Name = "LibrarySpread"
		holder.Size = UDim2.new(1, -8, 1, -54)
		local tiles = {}
		local showingSpells = self.Page <= spellPages
		if showingSpells then
			for offset = 1, pageSize do
				local result = results[(self.Page - 1) * pageSize + offset]
				if result then
					table.insert(tiles, card(holder, result, offset, columns))
				end
			end
		else
			local toolPage = self.Page - spellPages
			for offset = 1, pageSize do
				local option = toolOptions[(toolPage - 1) * pageSize + offset]
				if option then
					local tile = Instance.new("TextButton")
					tile.Name = "LibraryTool_" .. option.Label
					tile.Size = UDim2.fromOffset(120, 120)
					tile.BackgroundColor3 = Theme.Surface
					tile.BorderSizePixel = 0
					tile.Text = ""
					tile.Parent = holder
					local corner = Instance.new("UICorner")
					corner.CornerRadius = UDim.new(0, 10)
					corner.Parent = tile
					outline(tile, Theme.Border, 1)
					label(
						tile,
						option.Symbol,
						33,
						Theme.Gold,
						UDim2.fromScale(0.1, 0.08),
						UDim2.fromScale(0.8, 0.32),
						Enum.Font.GothamBold
					).TextXAlignment =
						Enum.TextXAlignment.Center
					label(
						tile,
						option.Label,
						13,
						Theme.Ink,
						UDim2.fromScale(0.05, 0.45),
						UDim2.fromScale(0.9, 0.2),
						Enum.Font.GothamBold
					).TextXAlignment =
						Enum.TextXAlignment.Center
					if option.OnInput then
						local box = Instance.new("TextBox")
						box.Position = UDim2.fromScale(0.08, 0.7)
						box.Size = UDim2.fromScale(0.84, 0.22)
						box.BackgroundColor3 = K.C.Input
						box.TextColor3 = Theme.Ink
						box.BorderColor3 = Theme.TileEdge
						box.TextSize = 12
						box.ClearTextOnFocus = false
						box.PlaceholderText = option.Detail
						box.Text = option.Input or ""
						box.Parent = tile
						box.FocusLost:Connect(function()
							option.OnInput(box.Text)
						end)
					else
						label(
							tile,
							option.Detail,
							11,
							Theme.MutedInk,
							UDim2.fromScale(0.07, 0.7),
							UDim2.fromScale(0.86, 0.2),
							Enum.Font.Gotham
						).TextXAlignment =
							Enum.TextXAlignment.Center
						if option.Action then
							tile.Activated:Connect(option.Action)
						end
					end
					table.insert(tiles, tile)
				end
			end
		end
		local function turn(direction)
			self.Page = math.clamp(self.Page + direction, 1, totalPages)
			ctx.rebuild()
			ctx.top()
		end
		local function arrow(symbol, nextPage)
			local button = Instance.new("TextButton")
			button.Name = if nextPage then "NextLibraryPage" else "PreviousLibraryPage"
			button.Size = UDim2.fromOffset(40, 35)
			button.BackgroundColor3 = Theme.Accent
			button.TextColor3 = Theme.OnAccent
			button.Text = symbol
			button.TextSize = 27
			button.Font = Enum.Font.GothamBold
			button.Parent = holder
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 10)
			corner.Parent = button
			button.Activated:Connect(function()
				turn(if nextPage then 1 else -1)
			end)
			return button
		end
		local previous = if self.Page > 1 then arrow("‹", false) else nil
		local nextPage = if self.Page < totalPages then arrow("›", true) else nil
		if showingSpells and #results == 0 then
			label(
				holder,
				if self.Shelf == "Curated"
					then "No curated spells match these filters."
					else "You haven't saved any spells yet. Use NEW SPELL, or open a curated spell and duplicate it to make it yours.",
				13,
				Theme.MutedInk,
				UDim2.fromScale(0.1, 0.3),
				UDim2.fromScale(0.8, 0.2),
				Enum.Font.GothamMedium
			).TextXAlignment =
				Enum.TextXAlignment.Center
		end
		local pageLabel = label(
			holder,
			(
				if showingSpells
					then tostring(#results) .. (if self.Shelf == "Curated" then " CURATED" else " OF YOURS")
					else "LIBRARY TOOLS"
			)
				.. "  ·  PAGE "
				.. self.Page
				.. " / "
				.. totalPages,
			11,
			Theme.Ink,
			UDim2.new(),
			UDim2.fromOffset(170, 30),
			Enum.Font.GothamBold
		)
		pageLabel.TextXAlignment = Enum.TextXAlignment.Center
		local function layoutSpread()
			local width, height = holder.AbsoluteSize.X, holder.AbsoluteSize.Y
			local geometry = LibraryLayout.compute(width, height, columns, #tiles)
			for index, tile in ipairs(tiles) do
				local position = geometry.Positions[index]
				tile.Position = UDim2.fromOffset(position.X, position.Y)
				tile.Size = UDim2.fromOffset(geometry.Cell, geometry.Cell)
			end
			if previous then
				previous.Position = UDim2.fromOffset(3, geometry.ArrowY)
			end
			if nextPage then
				nextPage.Position = UDim2.fromOffset(width - 43, geometry.ArrowY)
			end
			pageLabel.Position = UDim2.fromOffset(math.floor((width - 170) / 2), geometry.LabelY)
		end
		holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutSpread)
		layoutSpread()
	end

	function self.render()
		if self.ProgressionPage then
			action("Return to saved spells", "‹ ALL SPELLS", function()
				self.ProgressionPage = false
				ctx.rebuild()
			end)
			local profile = self.Catalog.Progression
			if self.Catalog.Unrestricted then
				ctx.info("Studio test mode: all spell options and slots are available.", 60)
			elseif not profile then
				ctx.info("Combat progression is unavailable. Reopen the spell screen to retry.", 60)
			else
				ctx.heading("COMBAT PROGRESSION")
				ctx.info(
					string.format(
						"%d XP · %d MARKS · %d / 9 LOADOUT SLOTS",
						profile.XP,
						profile.Marks,
						ProgressionRules.slots(profile)
					),
					54
				)
				for _, milestone in ipairs(ProgressionConfig.SlotMilestones) do
					ctx.info(
						string.format(
							"%d slots at %d XP · %s",
							milestone.Slots,
							milestone.XP,
							if profile.XP >= milestone.XP then "UNLOCKED" else "LOCKED"
						),
						38
					)
				end
				ctx.heading("SPELLCRAFT UNLOCKS")
				for _, id in ipairs(ProgressionConfig.UnlockOrder) do
					local offer = ProgressionConfig.Unlocks[id]
					if profile.Unlocks and profile.Unlocks[id] then
						ctx.info(offer.Name .. " · UNLOCKED\n" .. offer.Label, 50)
					else
						action(
							string.format("%s · requires %d XP and %d Marks", offer.Label, offer.XP, offer.Marks),
							"UNLOCK " .. string.upper(offer.Name),
							function()
								ctx.confirm(
									"Spend " .. offer.Marks .. " Marks to unlock " .. offer.Name .. "?",
									function()
										purchase("Unlock", id, nil)
									end
								)
							end
						)
					end
				end
			end
			return
		end
		local record = self.Selected and self.Catalog.Records[self.Selected]
		if self.Busy and record then
			ctx.info("Updating the library…", 34)
		end
		if record then
			renderRecord(record)
		else
			renderCatalog()
		end
	end
	function self.dismissHelp()
		command("DismissHelp")
	end
	return self
end
return View
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="422">
            <Properties>
              <string name="Name">GrimoireSpellVisual</string>
              <string name="Source"><![CDATA[--!strict
-- Lightweight procedural spell art, derived from an existing SpellSpec.
-- It previews form and element without claiming to simulate combat geometry.
-- Spell art draws light marks on a dark plate in the Spell Forge palette.
local Forge = require(script.Parent.SpellForgeTheme).C
local Theme = {
	Binding = Color3.fromRGB(16, 13, 19),
	Page = Forge.Ink,
	Gold = Forge.Gold,
	PageEdge = Forge.PanelEdge,
}
local Shared = game:GetService("ReplicatedStorage").Shared
local VisualSpec = require(Shared.Modules.MagicVisualSpec)
local ElementColors = require(Shared.Configuration.MagicElements)
local Analyzer = require(Shared.SpellVFXSystem.Core.SpellVFXAnalyzer)
local Visual = {}
local elementSecondaries = {
	Neutral = Color3.fromRGB(235, 225, 190),
	Fire = Color3.fromRGB(255, 210, 92),
	Water = Color3.fromRGB(174, 239, 235),
	Ice = Color3.fromRGB(235, 255, 255),
	Lightning = Color3.fromRGB(255, 246, 155),
	Earth = Color3.fromRGB(198, 190, 131),
	Wind = Color3.fromRGB(229, 255, 238),
	Poison = Color3.fromRGB(211, 245, 103),
}
local effectLabels = {
	Damage = "DMG",
	DamageOverTime = "DOT",
	Heal = "HEAL",
	Restoration = "HEAL",
	Shield = "WARD",
	Slow = "SLOW",
	Bind = "BIND",
	Reveal = "SEEK",
	Summon = "ALLY",
	Enhancement = "BOOST",
	AerialMovement = "FLIGHT",
	Displacement = "PUSH",
	Manipulation = "MOVE",
	TimeDilation = "TIME",
	ElementalMark = "MARK",
	ConsumeElementalMark = "BURST",
}
local effectOrder = {
	Damage = 1,
	DamageOverTime = 2,
	Heal = 3,
	Restoration = 4,
	Shield = 5,
	Bind = 6,
	Slow = 7,
	Displacement = 8,
	Manipulation = 9,
	Summon = 10,
	Enhancement = 11,
	AerialMovement = 12,
	Reveal = 13,
	TimeDilation = 14,
	ElementalMark = 15,
	ConsumeElementalMark = 16,
}
local behaviorLabels = {
	Homing = "HOME",
	Chain = "CHAIN",
	Bounce = "BOUNCE",
	Split = "SPLIT",
	Pierce = "PIERCE",
	Orbit = "ORBIT",
}
local function shape(parent, size, position, color, round, transparency, rotation)
	local frame = Instance.new("Frame")
	frame.Size = size
	frame.Position = position
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.BorderSizePixel = 0
	frame.Rotation = rotation or 0
	frame.Parent = parent
	if round then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = frame
	end
	return frame
end
local function ring(parent, diameter, color, transparency)
	local circle = shape(parent, UDim2.fromScale(diameter, diameter), UDim2.fromScale(0.5, 0.43), color, true, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 2
	stroke.Transparency = transparency or 0
	stroke.Parent = circle
end
local function outline(parent, size, position, color, transparency, rounded, rotation)
	local frame = shape(parent, size, position, color, rounded, 1, rotation)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 2
	stroke.Transparency = transparency or 0
	stroke.Parent = frame
	return frame
end
local function drawElementMotif(parent, element, color, accent)
	-- Small, repeatable marks make the element legible even when several spells
	-- share a Form. They are vector UI parts, so cards and live previews match.
	if element == "Fire" then
		shape(parent, UDim2.fromScale(0.045, 0.15), UDim2.fromScale(0.2, 0.28), accent, false, 0.02, 28)
		shape(parent, UDim2.fromScale(0.04, 0.12), UDim2.fromScale(0.82, 0.55), color, false, 0.08, -32)
		shape(parent, UDim2.fromScale(0.035, 0.1), UDim2.fromScale(0.32, 0.77), accent, false, 0.16, 24)
	elseif element == "Water" then
		outline(parent, UDim2.fromScale(0.1, 0.14), UDim2.fromScale(0.18, 0.29), accent, 0.08, true)
		outline(parent, UDim2.fromScale(0.07, 0.1), UDim2.fromScale(0.84, 0.27), color, 0.12, true)
		shape(parent, UDim2.fromScale(0.2, 0.025), UDim2.fromScale(0.2, 0.68), accent, true, 0.08, -12)
	elseif element == "Ice" then
		shape(parent, UDim2.fromScale(0.075, 0.16), UDim2.fromScale(0.18, 0.29), accent, false, 0.02, 45)
		shape(parent, UDim2.fromScale(0.065, 0.14), UDim2.fromScale(0.83, 0.28), color, false, 0.05, 45)
		shape(parent, UDim2.fromScale(0.06, 0.14), UDim2.fromScale(0.82, 0.67), accent, false, 0.16, 45)
	elseif element == "Lightning" then
		for index = 1, 3 do
			local x = 0.15 + index * 0.075
			shape(
				parent,
				UDim2.fromScale(0.035, 0.12),
				UDim2.fromScale(x, 0.24 + index * 0.04),
				accent,
				false,
				0.02,
				28
			)
			shape(
				parent,
				UDim2.fromScale(0.035, 0.12),
				UDim2.fromScale(x + 0.045, 0.32 + index * 0.04),
				color,
				false,
				0.06,
				-28
			)
		end
	elseif element == "Earth" then
		shape(parent, UDim2.fromScale(0.1, 0.1), UDim2.fromScale(0.18, 0.31), color, false, 0.04, 12)
		shape(parent, UDim2.fromScale(0.08, 0.09), UDim2.fromScale(0.83, 0.28), accent, false, 0.08, 35)
		shape(parent, UDim2.fromScale(0.12, 0.08), UDim2.fromScale(0.82, 0.67), color, false, 0.14, -18)
	elseif element == "Wind" then
		outline(parent, UDim2.fromScale(0.2, 0.065), UDim2.fromScale(0.2, 0.27), accent, 0.04, true, -18)
		outline(parent, UDim2.fromScale(0.16, 0.05), UDim2.fromScale(0.82, 0.66), color, 0.12, true, -18)
		shape(parent, UDim2.fromScale(0.1, 0.035), UDim2.fromScale(0.19, 0.72), accent, true, 0.12, 12)
	elseif element == "Poison" then
		outline(parent, UDim2.fromScale(0.1, 0.1), UDim2.fromScale(0.18, 0.29), accent, 0.06, true)
		outline(parent, UDim2.fromScale(0.07, 0.07), UDim2.fromScale(0.83, 0.28), color, 0.1, true)
		shape(parent, UDim2.fromScale(0.12, 0.12), UDim2.fromScale(0.83, 0.68), color, true, 0.36)
	else
		ring(parent, 0.14, color, 0.2)
		shape(parent, UDim2.fromScale(0.045, 0.045), UDim2.fromScale(0.82, 0.28), accent, false, 0.04, 45)
	end
end
local function drawAreaGeometry(parent, geometry, color, secondary)
	if geometry == "Ring" then
		ring(parent, 0.78, color, 0.08)
		ring(parent, 0.38, secondary, 0.02)
	elseif geometry == "Capsule" then
		outline(parent, UDim2.fromScale(0.36, 0.68), UDim2.fromScale(0.5, 0.43), color, 0.05, true)
		shape(parent, UDim2.fromScale(0.12, 0.48), UDim2.fromScale(0.5, 0.43), secondary, true, 0.12)
	elseif geometry == "Cylinder" then
		outline(parent, UDim2.fromScale(0.46, 0.58), UDim2.fromScale(0.5, 0.43), color, 0.08, false)
		outline(parent, UDim2.fromScale(0.46, 0.19), UDim2.fromScale(0.5, 0.16), secondary, 0.04, true)
		outline(parent, UDim2.fromScale(0.46, 0.19), UDim2.fromScale(0.5, 0.70), color, 0.2, true)
	elseif geometry == "Cone" then
		for index = 1, 5 do
			local width = 0.12 + index * 0.105
			local band = shape(
				parent,
				UDim2.fromScale(width, 0.035),
				UDim2.fromScale(0.5, 0.18 + index * 0.105),
				if index == 5 then secondary else color,
				true,
				0.12 + index * 0.08
			)
			band.Rotation = 0
		end
	elseif geometry == "Plane" then
		outline(parent, UDim2.fromScale(0.72, 0.24), UDim2.fromScale(0.5, 0.43), color, 0.05, false)
		shape(parent, UDim2.fromScale(0.62, 0.04), UDim2.fromScale(0.5, 0.43), secondary, true, 0.08)
	elseif geometry == "Line" then
		outline(parent, UDim2.fromScale(0.18, 0.72), UDim2.fromScale(0.5, 0.43), color, 0.02, true, -25)
		shape(parent, UDim2.fromScale(0.08, 0.62), UDim2.fromScale(0.5, 0.43), secondary, true, 0.08, -25)
	elseif geometry == "Box" then
		outline(parent, UDim2.fromScale(0.64, 0.48), UDim2.fromScale(0.5, 0.43), color, 0.04, false)
		shape(parent, UDim2.fromScale(0.5, 0.04), UDim2.fromScale(0.5, 0.43), secondary, true, 0.05)
	else
		ring(parent, 0.72, color, 0.08)
		ring(parent, 0.44, secondary, 0.12)
	end
end
local function drawConstructGeometry(parent, geometry, color, secondary)
	if geometry == "Arch" then
		shape(parent, UDim2.fromScale(0.13, 0.52), UDim2.fromScale(0.30, 0.47), color, false, 0.04)
		shape(parent, UDim2.fromScale(0.13, 0.52), UDim2.fromScale(0.70, 0.47), color, false, 0.04)
		shape(parent, UDim2.fromScale(0.53, 0.13), UDim2.fromScale(0.5, 0.20), secondary, false, 0.05)
	elseif geometry == "Pillar" then
		shape(parent, UDim2.fromScale(0.48, 0.12), UDim2.fromScale(0.5, 0.19), secondary, false, 0.03)
		shape(parent, UDim2.fromScale(0.32, 0.52), UDim2.fromScale(0.5, 0.46), color, false, 0.05)
		shape(parent, UDim2.fromScale(0.52, 0.12), UDim2.fromScale(0.5, 0.73), secondary, false, 0.03)
	elseif geometry == "Stairs" then
		for index = 1, 4 do
			shape(
				parent,
				UDim2.fromScale(0.25 + index * 0.1, 0.08),
				UDim2.fromScale(0.5, 0.70 - index * 0.12),
				if index % 2 == 0 then secondary else color,
				false,
				0.03
			)
		end
	elseif geometry == "Bridge" then
		shape(parent, UDim2.fromScale(0.72, 0.16), UDim2.fromScale(0.5, 0.53), color, false, 0.04)
		shape(parent, UDim2.fromScale(0.72, 0.06), UDim2.fromScale(0.5, 0.34), secondary, false, 0.04)
		shape(parent, UDim2.fromScale(0.06, 0.22), UDim2.fromScale(0.19, 0.43), color, false, 0.04)
		shape(parent, UDim2.fromScale(0.06, 0.22), UDim2.fromScale(0.81, 0.43), color, false, 0.04)
	else
		local round = geometry == "Sphere" or geometry == "Cylinder"
		local rotation = if geometry == "Wedge" then 45 else 0
		shape(parent, UDim2.fromScale(0.52, 0.42), UDim2.fromScale(0.5, 0.43), color, round, 0.08, rotation)
		shape(parent, UDim2.fromScale(0.25, 0.2), UDim2.fromScale(0.5, 0.43), secondary, round, 0.08, rotation)
	end
end
local function effects(spell)
	local kinds = {}
	for _, steps in pairs(spell.Triggers or {}) do
		for _, step in ipairs(steps) do
			for _, payload in ipairs(step.Payloads or {}) do
				if payload.Kind and not table.find(kinds, payload.Kind) then
					table.insert(kinds, payload.Kind)
				end
			end
		end
	end
	table.sort(kinds, function(first, second)
		local firstOrder, secondOrder = effectOrder[first] or math.huge, effectOrder[second] or math.huge
		return if firstOrder == secondOrder then first < second else firstOrder < secondOrder
	end)
	return kinds
end
local function features(spell, effectNames)
	local result = {}
	for _, name in ipairs(effectNames) do
		local label = effectLabels[name]
		if label and not table.find(result, label) then
			table.insert(result, label)
		end
	end
	for _, behavior in ipairs((spell.Projectile and spell.Projectile.Behaviors) or {}) do
		local label = behaviorLabels[behavior.Kind]
		if label and not table.find(result, label) then
			table.insert(result, label)
		end
	end
	return result
end
function Visual.render(parent, spell, compact)
	for _, child in ipairs(parent:GetChildren()) do
		child:Destroy()
	end
	parent.BackgroundColor3 = Theme.Binding
	parent.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = parent
	local composition = Analyzer.resolve(spell)
	local color = ElementColors[composition.Element] or ElementColors.Neutral
	local secondary = elementSecondaries[spell.Element] or Color3.fromRGB(255, 244, 212)
	local accent = secondary
	local visual = spell.Visual
	if visual then
		local useElementDefaults = visual.Palette == "Origin" and visual.Color == VisualSpec.Defaults.Color
		local palette = VisualSpec.PaletteDefinitions[visual.Palette]
		if palette then
			color, secondary, accent = palette.Colors[1], palette.Colors[2], palette.Colors[3]
		end
		-- Untouched Origin defaults mean "use this spell's element". Explicit
		-- palette and custom color choices remain authoritative.
		if useElementDefaults then
			color = ElementColors[spell.Element] or ElementColors.Neutral
			secondary = elementSecondaries[spell.Element] or secondary
			accent = secondary
		end
		if typeof(visual.Color) == "Color3" and not useElementDefaults then
			color = visual.Color
		end
		if typeof(visual.SecondaryColor) == "Color3" and not useElementDefaults then
			secondary = visual.SecondaryColor
		end
		if typeof(visual.AccentColor) == "Color3" and not useElementDefaults then
			accent = visual.AccentColor
		end
	end
	local vignette = Instance.new("UIGradient")
	vignette.Rotation = 90
	vignette.Color = ColorSequence.new(Theme.Binding, Color3.fromRGB(10, 9, 12))
	vignette.Parent = parent
	local window = parent
	local art = Instance.new("Frame")
	art.AnchorPoint = Vector2.new(0.5, 0.5)
	art.Position = UDim2.fromScale(0.5, if compact then 0.5 else 0.43)
	art.Size = UDim2.fromScale(0.9, if compact then 0.9 else 0.74)
	art.BackgroundTransparency = 1
	art.Parent = parent
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1
	aspect.DominantAxis = Enum.DominantAxis.Height
	aspect.Parent = art
	parent = art
	drawElementMotif(parent, composition.Element, color, accent)
	if not visual or visual.ParticleStyle ~= "None" then
		for i = 1, 4 do
			shape(
				parent,
				UDim2.fromOffset(
					if visual and visual.ParticleStyle == "Smoke" then 5 else 2,
					if visual and visual.ParticleStyle == "Smoke" then 5 else 2
				),
				UDim2.fromScale(0.13 + i * 0.18, 0.16 + (i % 2) * 0.52),
				if visual and visual.ParticleStyle == "Embers" then color else Theme.Page,
				true,
				0.55
			)
		end
	end
	local form = spell.Form
	if form == "Projectile" then
		if not visual or visual.TrailStyle ~= "None" then
			shape(parent, UDim2.fromScale(0.5, 0.025), UDim2.fromScale(0.44, 0.49), color, true, 0.42, -15)
		end
		ring(parent, 0.44, color, 0.57)
		local coreShape = visual and visual.CoreShape or "Sphere"
		local round = coreShape == "Sphere" or coreShape == "Cylinder"
		local rotation = if coreShape == "Crystal" or coreShape == "Wedge" then 45 else 0
		shape(parent, UDim2.fromScale(0.25, 0.25), UDim2.fromScale(0.58, 0.43), color, round, 0, rotation)
		shape(parent, UDim2.fromScale(0.11, 0.11), UDim2.fromScale(0.58, 0.43), accent, round, 0.12, rotation)
	elseif form == "Beam" then
		shape(parent, UDim2.fromScale(0.77, 0.14), UDim2.fromScale(0.5, 0.43), color, true, 0.32, -24)
		shape(parent, UDim2.fromScale(0.77, 0.045), UDim2.fromScale(0.5, 0.43), Theme.Page, true, 0.1, -24)
	elseif form == "Wave" then
		for i = 1, 3 do
			ring(parent, 0.25 + i * 0.16, if i == 3 then secondary else color, 0.1 + i * 0.18)
		end
		if spell.Geometry == "Sphere" then
			drawAreaGeometry(parent, "Sphere", color, secondary)
		else
			shape(parent, UDim2.fromScale(0.11, 0.11), UDim2.fromScale(0.5, 0.43), accent, true)
		end
	elseif form == "Field" then
		drawAreaGeometry(parent, spell.Geometry or "Sphere", color, secondary)
	elseif form == "Aura" then
		drawAreaGeometry(parent, spell.Geometry or "Sphere", color, secondary)
		shape(parent, UDim2.fromScale(0.16, 0.16), UDim2.fromScale(0.5, 0.43), accent, true)
	elseif form == "SelfEnhancement" then
		shape(parent, UDim2.fromScale(0.36, 0.36), UDim2.fromScale(0.5, 0.43), color, false, 0.18, 45)
		shape(parent, UDim2.fromScale(0.17, 0.17), UDim2.fromScale(0.5, 0.43), Theme.Page, false, 0, 45)
		ring(parent, 0.66, color, 0.28)
	elseif form == "Construct" then
		drawConstructGeometry(parent, spell.Geometry or "Box", color, secondary)
	elseif form == "Manipulation" then
		for i = 1, 3 do
			shape(
				parent,
				UDim2.fromScale(0.5 - i * 0.07, 0.065),
				UDim2.fromScale(0.5, 0.25 + i * 0.15),
				color,
				false,
				0.1 + i * 0.13
			)
		end
	else
		ring(parent, 0.55, color, 0)
	end
	local names = effects(spell)
	local featureLabels = features(spell, names)
	for index = 1, math.min(#featureLabels, 2) do
		local badge = Instance.new("TextLabel")
		badge.AnchorPoint = Vector2.new(0.5, 0.5)
		badge.Position = UDim2.fromScale(if index == 1 then 0.72 else 0.28, 0.78)
		badge.Size = UDim2.fromScale(0.38, 0.13)
		badge.BackgroundColor3 = Theme.Gold
		badge.BorderSizePixel = 0
		badge.TextColor3 = Theme.Page
		badge.Text = featureLabels[index]
		badge.TextScaled = true
		badge.Font = Enum.Font.GothamBold
		badge.ZIndex = 3
		badge.Parent = parent
		local badgeStroke = Instance.new("UIStroke")
		badgeStroke.Color = Theme.PageEdge
		badgeStroke.Thickness = 1
		badgeStroke.Parent = badge
	end
	if not compact then
		local caption = Instance.new("TextLabel")
		caption.BackgroundTransparency = 1
		caption.Position = UDim2.fromScale(0.04, 0.78)
		caption.Size = UDim2.fromScale(0.92, 0.18)
		caption.Text = tostring(form)
			.. "  ·  "
			.. tostring(spell.Element)
			.. (names[1] and "  ·  " .. table.concat(names, " + ") or "")
			.. (
				visual
					and "\n" .. tostring(spell.Geometry or visual.CoreShape or "Sphere") .. " · " .. tostring(
						visual.ParticleStyle or "Sparks"
					) .. " · " .. tostring(visual.TrailStyle or "Ribbon")
				or ""
			)
		caption.TextColor3 = Theme.Page
		caption.TextSize = 11
		caption.Font = Enum.Font.GothamSemibold
		caption.TextWrapped = true
		caption.Parent = window
	end
end
return Visual
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="423">
            <Properties>
              <string name="Name">GrimoireTheme</string>
              <string name="Source"><![CDATA[-- Warm parchment surfaces over the notebook art, with dark ink for readability.
return {
	Page = Color3.fromRGB(247, 229, 197),
	PageShade = Color3.fromRGB(225, 193, 148),
	PageHighlight = Color3.fromRGB(255, 240, 210),
	Binding = Color3.fromRGB(34, 54, 48),
	BindingEdge = Color3.fromRGB(74, 97, 88),
	PageEdge = Color3.fromRGB(137, 96, 52),
	Ink = Color3.fromRGB(23, 32, 42),
	MutedInk = Color3.fromRGB(57, 71, 86),
	SubtleInk = Color3.fromRGB(75, 89, 104),
	Gold = Color3.fromRGB(105, 76, 20),
	Accent = Color3.fromRGB(35, 88, 68),
	AccentAlt = Color3.fromRGB(49, 78, 105),
	AccentSoft = Color3.fromRGB(215, 226, 199),
	Surface = Color3.fromRGB(239, 214, 174),
	SurfaceMuted = Color3.fromRGB(248, 230, 198),
	SurfaceDisabled = Color3.fromRGB(211, 196, 171),
	Border = Color3.fromRGB(143, 105, 63),
	TileEdge = Color3.fromRGB(104, 72, 42),
	DisabledInk = Color3.fromRGB(71, 84, 98),
	OnAccent = Color3.fromRGB(255, 255, 255),
	Success = Color3.fromRGB(24, 104, 70),
	Warning = Color3.fromRGB(133, 72, 8),
	WarningSurface = Color3.fromRGB(255, 244, 220),
	Error = Color3.fromRGB(166, 36, 36),
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="424">
            <Properties>
              <string name="Name">GuidedSpellForge</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Spell Forge: the default player-facing spell creator.
--
-- The spell is shown as what it does: the cast creates a Form, the Form's
-- triggers ("When it hits") fire actions, and actions can open their own
-- branches (blasts, spawned effects). Every card is a live view of the
-- canonical SpellSpec draft; nothing here keeps a second spell model, so the
-- Advanced workshop, saving, and server validation all see the same table.
--
-- Responsibilities inside this module:
--   Toolbar          name, undo/redo, Guided/Advanced, library, keep, save
--   ActionTree       cards, trigger blocks, connector rails, attach buttons
--   ActionPicker     "What do you want to happen?" (schema-derived choices)
--   Inspector        only the selected node's fields
--   Preview          data-driven schematic + real server Test Spell
--   ValidationBar    SpellSpec.validate / SpellSpec.estimate results
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ProjectileBehaviorSpec = require(Shared.Modules.ProjectileBehaviorSpec)
local SpellIdentitySpec = require(Shared.Modules.MagicSpellIdentitySpec)
local SpellVisual = require(script.Parent.GrimoireSpellVisual)
local PreviewPanel = require(script.Parent.ForgePreviewPanel)

local Forge = {}
-- Guided and Advanced are one forge: Advanced shows every field, adds the
-- spell-wide setting cards, and hosts the controller's full section editors.

local C = require(script.Parent.SpellForgeTheme).C

local K = require(script.Parent.SpellForgeComponents)
local CategoryColor = K.CategoryColor
local ElementColor = K.ElementColor
local FormIcon = K.FormIcon
local FormVerb = K.FormVerb
local PayloadIcon = K.PayloadIcon
local PayloadVerb = K.PayloadVerb
local EventPhrase = K.EventPhrase

-- Player-intent groups for the action picker. Members are resolved from the
-- live schema each time, so a group only lists what the engine can run here.
local Intents = {
	{
		Id = "Target",
		Icon = "×",
		Title = "Affect a target",
		Blurb = "Harm, heal, shield, mark, or reveal whoever this reaches.",
		Categories = { Impact = true, Support = true, Detection = true },
		Color = C.Ember,
	},
	{
		Id = "Move",
		Icon = "←",
		Title = "Move or hold something",
		Blurb = "Push, slow, bind, displace, control, or bend time.",
		Categories = { Control = true, Movement = true, Temporal = true },
		Color = C.Arcane,
	},
	{
		Id = "Area",
		Icon = "*",
		Title = "Affect an area",
		Blurb = "Burst at this spot and apply effects to everything inside.",
		Behaviors = { Explode = true },
		Color = C.Warn,
	},
	{
		Id = "Create",
		Icon = "◆",
		Title = "Create something",
		Blurb = "Launch a new projectile, open a field, summon, or shape matter.",
		Behaviors = { SpawnEffect = true },
		Categories = { Summoning = true, ["World interaction"] = true },
		Color = C.Gold,
	},
	{
		Id = "Trigger",
		Icon = "◆",
		Title = "Trigger another action",
		Blurb = "Add a different moment, like when it ends or every pulse.",
		Trigger = true,
		Color = C.Frost,
	},
}

local states = setmetatable({}, { __mode = "k" })

local fmt = K.fmt
local new = K.new
local corner = K.corner
local stroke = K.stroke
local pad = K.pad
local text = K.text
local hover = K.hover
local pill = K.pill
local list = K.list
local clearChildren = K.clearChildren

-- Walks the canonical draft so selections that no longer exist (after undo,
-- removals, or a Form change) fall back to the spell root instead of erroring.
local function collect(container, live)
	live[container] = true
	local projectile = container.Projectile
	if projectile and projectile.Behaviors then
		for _, behavior in projectile.Behaviors do
			live[behavior] = true
		end
	end
	for _, steps in pairs(container.Triggers or {}) do
		for _, step in steps do
			live[step] = true
			for _, payload in step.Payloads or {} do
				live[payload] = true
			end
			if type(step.Effect) == "table" then
				collect(step.Effect, live)
			end
		end
	end
end

function Forge.mount(parent, draft, schema, spec, callbacks)
	local old = parent:FindFirstChild("GuidedSpellForge")
	if old then
		old:Destroy()
	end
	local state = states[draft]
	if not state then
		state = { Selection = { Kind = "Form", Scope = draft }, Undo = {}, Redo = {}, Tab = "Build", More = {} }
		states[draft] = state
	end
	local function principle()
		return draft.Source and draft.Source.Principle
	end
	local function castingMode(scope)
		return if scope == draft then draft.Casting and draft.Casting.Mode else nil
	end
	local function supportedEvents(scope)
		return schema.eventsForEffects(scope.Form, castingMode(scope), if scope == draft then draft.Targeting else nil)
	end
	local function eventSupported(scope, eventName)
		return table.find(supportedEvents(scope), eventName) ~= nil
	end
	local function stepFits(scope, eventName, step)
		if step.Behavior then
			return schema.supportsBehavior(step.Behavior, scope.Form, eventName)
		end
		for _, payload in step.Payloads or {} do
			if not schema.supportsPayload(payload.Kind, scope.Form, eventName, principle()) then
				return false
			end
		end
		return true
	end
	-- The moment a shape naturally acts: its default event when it can run effects there.
	local function homeEvent(scope)
		local events = supportedEvents(scope)
		local preferred = (schema.Forms[scope.Form] or {}).DefaultEvent
		return if preferred and table.find(events, preferred) then preferred else events[1]
	end
	-- After a shape or principle change, effects on moments the new shape never
	-- reaches (a Wave never "hits") move to its natural moment when they fit
	-- there. Anything that cannot move stays put and is flagged on its card.
	local function relocate(scope, onlyEvent)
		local target = homeEvent(scope)
		if not target or not scope.Triggers then
			return
		end
		for _, eventName in schema.EventOrder do
			local steps = scope.Triggers[eventName]
			if
				steps
				and eventName ~= target
				and (eventName == onlyEvent or (onlyEvent == nil and not eventSupported(scope, eventName)))
			then
				local keep = {}
				for _, step in steps do
					if stepFits(scope, target, step) then
						scope.Triggers[target] = scope.Triggers[target] or {}
						table.insert(scope.Triggers[target], step)
					else
						table.insert(keep, step)
					end
				end
				scope.Triggers[eventName] = if #keep > 0 then keep else nil
			end
		end
	end

	local root = new("Frame", {
		Name = "GuidedSpellForge",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Backdrop,
		BorderSizePixel = 0,
		-- Above the Grimoire book chrome (ZIndex 10), which stays parented to the panel.
		ZIndex = 50,
		ClipsDescendants = true,
	}, parent)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(28, 20, 26), Color3.fromRGB(10, 9, 12)),
		Rotation = 90,
	}, root)

	local advanced = callbacks.mode == "Expert"
	local render
	local function deepEqual(a, b)
		if a == b then
			return true
		end
		if type(a) ~= "table" or type(b) ~= "table" then
			return false
		end
		for key, value in a do
			if not deepEqual(value, b[key]) then
				return false
			end
		end
		for key in b do
			if a[key] == nil then
				return false
			end
		end
		return true
	end
	-- Undo history is recorded by comparing against the last rendered draft,
	-- so edits made in hosted Advanced editors are undoable like forge edits.
	local function track()
		if state.Last ~= nil and not deepEqual(state.Last, draft) then
			table.insert(state.Undo, state.Last)
			if #state.Undo > 60 then
				table.remove(state.Undo, 1)
			end
			table.clear(state.Redo)
		end
		state.Last = spec.copy(draft)
	end
	local function changed()
		callbacks.change()
		render()
	end
	local function commit(mutator)
		mutator()
		changed()
	end
	local function restore(from, to)
		if #from == 0 then
			return
		end
		table.insert(to, spec.copy(draft))
		local snap = table.remove(from)
		table.clear(draft)
		for key, value in spec.copy(snap) do
			draft[key] = value
		end
		state.Last = spec.copy(draft)
		state.Selection = { Kind = "Form", Scope = draft }
		state.Picker = nil
		changed()
	end
	local function select(selection)
		state.Selection = selection
		state.Picker = nil
		state.InspectorScroll = nil
		if state.Mobile then
			state.Tab = "Inspect"
		end
		render()
	end

	------------------------------------------------------------------ toolbar
	local toolbar = new("Frame", {
		Name = "SpellToolbar",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
	}, root)
	stroke(toolbar, C.PanelEdge)
	corner(toolbar, 12)
	local back = pill(toolbar, "‹  BACK", callbacks.back)
	local sigil = text(toolbar, "◆", 22, C.Gold, Enum.Font.GothamBold, {
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local nameBox = new("TextBox", {
		Name = "SpellName",
		Text = draft.Name,
		PlaceholderText = "Name this spell",
		ClearTextOnFocus = false,
		TextSize = 22,
		Font = Enum.Font.Garamond,
		TextColor3 = C.Ink,
		PlaceholderColor3 = C.Faint,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundColor3 = C.Input,
		BorderSizePixel = 0,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, toolbar)
	corner(nameBox, 8)
	stroke(nameBox, C.PanelEdge)
	pad(nameBox, 10, 0)
	nameBox:GetPropertyChangedSignal("Text"):Connect(function()
		local length = utf8.len(nameBox.Text)
		if length and length > SpellIdentitySpec.MaxNameLength then
			nameBox.Text = string.sub(
				nameBox.Text,
				1,
				(utf8.offset(nameBox.Text, SpellIdentitySpec.MaxNameLength + 1) :: number) - 1
			)
		end
	end)
	nameBox.FocusLost:Connect(function()
		local value = SpellIdentitySpec.normalizeName(nameBox.Text)
		if value and value ~= draft.Name then
			commit(function()
				draft.Name = value
			end)
		else
			nameBox.Text = draft.Name
		end
	end)
	local undoButton = pill(toolbar, "UNDO", function()
		restore(state.Undo, state.Redo)
	end)
	local redoButton = pill(toolbar, "REDO", function()
		restore(state.Redo, state.Undo)
	end)
	undoButton.TextSize, redoButton.TextSize = 12, 12
	local modeSwitch = new("Frame", { BackgroundColor3 = C.Input, BorderSizePixel = 0 }, toolbar)
	corner(modeSwitch, 8)
	stroke(modeSwitch, C.PanelEdge)
	local guidedTab = new("TextButton", {
		Text = "GUIDED",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = if advanced then C.Muted else C.Backdrop,
		BackgroundColor3 = C.Gold,
		BackgroundTransparency = if advanced then 1 else 0,
		AutoButtonColor = false,
		Size = UDim2.new(0.5, -3, 1, -6),
		Position = UDim2.fromOffset(3, 3),
	}, modeSwitch)
	corner(guidedTab, 6)
	local advancedTab = new("TextButton", {
		Text = "ADVANCED",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = if advanced then C.Backdrop else C.Muted,
		BackgroundColor3 = C.Gold,
		BackgroundTransparency = if advanced then 0 else 1,
		AutoButtonColor = false,
		Size = UDim2.new(0.5, -3, 1, -6),
		Position = UDim2.new(0.5, 0, 0, 3),
	}, modeSwitch)
	corner(advancedTab, 6)
	advancedTab.Activated:Connect(function()
		if not advanced then
			callbacks.advanced()
		end
	end)
	guidedTab.Activated:Connect(function()
		if advanced then
			callbacks.advanced()
		end
	end)
	local loadButton = pill(toolbar, "LOAD", callbacks.load)
	local keepButton = pill(toolbar, "KEEP DRAFT", callbacks.keep)
	local saveButton = pill(toolbar, "SAVE SPELL", callbacks.save, "accent")
	local closeButton = if callbacks.close then pill(toolbar, "×", callbacks.close) else nil
	if closeButton then
		closeButton.Name = "CloseSpells"
		closeButton.TextSize = 20
	end
	-- Slot drafts can be equipped directly; library spells equip from the Library.
	local equipButton = if callbacks.equip then pill(toolbar, callbacks.equipLabel or "EQUIP", callbacks.equip) else nil

	------------------------------------------------------------------ regions
	local function region(name, title, subtitle)
		local frame = new("Frame", { Name = name, BackgroundColor3 = C.Panel, BorderSizePixel = 0 }, root)
		corner(frame, 12)
		stroke(frame, C.PanelEdge)
		local header = new("Frame", {
			Name = "Header",
			Size = UDim2.new(1, 0, 0, 44),
			BackgroundTransparency = 1,
		}, frame)
		text(header, title, 13, C.Gold, Enum.Font.GothamBlack, {
			Position = UDim2.fromOffset(16, 6),
			Size = UDim2.new(1, -32, 0, 18),
		})
		local sub = text(header, subtitle, 12, C.Faint, Enum.Font.Gotham, {
			Position = UDim2.fromOffset(16, 23),
			Size = UDim2.new(1, -32, 0, 16),
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		new("Frame", {
			Size = UDim2.new(1, -24, 0, 1),
			Position = UDim2.new(0, 12, 1, -1),
			BackgroundColor3 = C.PanelEdge,
			BorderSizePixel = 0,
		}, header)
		local body = new("ScrollingFrame", {
			Name = "Body",
			Position = UDim2.fromOffset(0, 46),
			Size = UDim2.new(1, 0, 1, -46),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 6,
			ScrollBarImageColor3 = C.Rail,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			ScrollingDirection = Enum.ScrollingDirection.Y,
		}, frame)
		return frame, body, sub
	end
	local treePanel, tree = region("SpellConstruction", "SPELL CONSTRUCTION", "What happens, when, and what follows")
	pad(tree, 12, 10)
	list(tree, 0)
	local previewPanel = new("Frame", {
		Name = "SpellPreview",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
	}, root)
	corner(previewPanel, 12)
	stroke(previewPanel, C.PanelEdge)
	local inspectPanel, inspector, inspectSub = region("ContextualInspector", "PROPERTIES", "Select a card to shape it")
	pad(inspector, 14, 10)
	list(inspector, 10)

	local tabs = new("Frame", { Name = "MobileTabs", BackgroundTransparency = 1, Visible = false }, root)
	local tabButtons = {}
	for index, info in { { "Build", "SPELL" }, { "Preview", "PREVIEW" }, { "Inspect", "PROPERTIES" } } do
		local tab = pill(tabs, info[2], function()
			state.Tab = info[1]
			render()
		end)
		tab.Size = UDim2.new(1 / 3, -6, 1, 0)
		tab.Position = UDim2.new((index - 1) / 3, 3, 0, 0)
		tabButtons[info[1]] = tab
	end

	------------------------------------------------------------------ bottom bar
	local bottom = new("Frame", {
		Name = "ValidationPanel",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
	}, root)
	corner(bottom, 12)
	stroke(bottom, C.PanelEdge)
	local testButton = pill(bottom, "▶  TEST SPELL", callbacks.test, "accent")
	testButton.TextSize = 15
	local statusIcon = text(bottom, "●", 18, C.Ok, Enum.Font.GothamBold, {
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local statusText = text(bottom, "", 13, C.Ink, Enum.Font.GothamMedium, {
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
	})
	local statsHolder = new("Frame", { BackgroundTransparency = 1 }, bottom)
	local statsLayout = list(statsHolder, 8, true)
	statsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	statsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	local function stat(label, color)
		local holder = new("Frame", {
			BackgroundColor3 = C.Input,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 0, 40),
		}, statsHolder)
		corner(holder, 8)
		pad(holder, 10, 2)
		list(holder, 0)
		local value = text(holder, "0", 17, color, Enum.Font.GothamBlack, {
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 20),
			TextWrapped = false,
		})
		text(holder, label, 10, C.Faint, Enum.Font.GothamBold, {
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 14),
			TextWrapped = false,
		})
		return value, holder
	end
	local manaValue = stat("MANA", Color3.fromRGB(120, 170, 255))
	local strainValue = stat("STRAIN", C.Ember)
	local complexityValue = stat("COMPLEXITY", C.Arcane)
	local upkeepValue, upkeepHolder = stat("UPKEEP / S", C.Warn)

	------------------------------------------------------------------ layout
	local function layout()
		local width = root.AbsoluteSize.X
		local mobile = width < 760
		state.Mobile = mobile
		local m = 10
		local barH = if mobile then 104 else 60
		toolbar.Position = UDim2.fromOffset(m, m)
		toolbar.Size = UDim2.new(1, -m * 2, 0, barH)
		if mobile then
			back.Text, keepButton.Text, saveButton.Text = "‹", "KEEP", "SAVE"
			back.Position, back.Size = UDim2.fromOffset(8, 8), UDim2.fromOffset(40, 40)
			sigil.Visible = false
			nameBox.Position, nameBox.Size =
				UDim2.fromOffset(54, 8), UDim2.new(1, -(if closeButton then 108 else 62), 0, 40)
			if closeButton then
				closeButton.Position, closeButton.Size = UDim2.new(1, -48, 0, 8), UDim2.fromOffset(40, 40)
			end
			local row = { undoButton, redoButton, modeSwitch, loadButton, keepButton, saveButton }
			local weights = { 0.1, 0.1, 0.3, 0.14, 0.16, 0.2 }
			if equipButton then
				row = { undoButton, redoButton, modeSwitch, keepButton, saveButton, equipButton }
				weights = { 0.1, 0.1, 0.26, 0.15, 0.19, 0.2 }
				loadButton.Visible = false
				equipButton.Text = "EQUIP"
			end
			local x = 0
			for index, control in row do
				control.Position = UDim2.new(x, 8, 0, 56)
				control.Size = UDim2.new(weights[index], -8, 0, 40)
				x += weights[index]
			end
			guidedTab.Text, advancedTab.Text = "GUIDED", "ADV"
		else
			back.Text, keepButton.Text, saveButton.Text = "‹  BACK", "KEEP DRAFT", "SAVE SPELL"
			sigil.Visible = true
			back.Position, back.Size = UDim2.fromOffset(10, 10), UDim2.fromOffset(112, 40)
			sigil.Position, sigil.Size = UDim2.fromOffset(128, 10), UDim2.fromOffset(28, 40)
			loadButton.Visible = true
			local equipWidth = (if equipButton then 132 + 8 else 0) + (if closeButton then 48 else 0)
			if equipButton then
				equipButton.Text = callbacks.equipLabel or "EQUIP"
			end
			local rightWidth = 64 + 64 + 196 + 84 + 112 + 124 + 6 * 8 + 10 + equipWidth
			nameBox.Position = UDim2.fromOffset(160, 10)
			nameBox.Size = UDim2.new(1, -160 - rightWidth, 0, 40)
			local x = -10
			if closeButton then
				x -= 40
				closeButton.Position = UDim2.new(1, x, 0, 10)
				closeButton.Size = UDim2.fromOffset(40, 40)
				x -= 8
			end
			if equipButton then
				x -= 132
				equipButton.Position = UDim2.new(1, x, 0, 10)
				equipButton.Size = UDim2.fromOffset(132, 40)
				x -= 8
			end
			for _, entry in
				{
					{ saveButton, 124 },
					{ keepButton, 112 },
					{ loadButton, 84 },
					{ modeSwitch, 196 },
					{ redoButton, 44 },
					{ undoButton, 44 },
				}
			do
				x -= entry[2]
				entry[1].Position = UDim2.new(1, x, 0, 10)
				entry[1].Size = UDim2.fromOffset(entry[2], 40)
				x -= 8
			end
			guidedTab.Text, advancedTab.Text = "GUIDED", "ADVANCED"
		end
		local bottomH = if mobile then 112 else 66
		bottom.Position = UDim2.new(0, m, 1, -m - bottomH)
		bottom.Size = UDim2.new(1, -m * 2, 0, bottomH)
		if mobile then
			testButton.Position, testButton.Size = UDim2.fromOffset(8, 8), UDim2.new(0.42, -8, 0, 44)
			statsHolder.Position, statsHolder.Size = UDim2.new(0.42, 8, 0, 8), UDim2.new(0.58, -16, 0, 44)
			statusIcon.Position, statusIcon.Size = UDim2.fromOffset(8, 60), UDim2.fromOffset(24, 44)
			statusText.Position, statusText.Size = UDim2.fromOffset(34, 60), UDim2.new(1, -42, 0, 44)
			statusText.TextWrapped = true
		else
			testButton.Position, testButton.Size = UDim2.fromOffset(10, 10), UDim2.fromOffset(170, 46)
			statusIcon.Position, statusIcon.Size = UDim2.fromOffset(190, 10), UDim2.fromOffset(24, 46)
			statusText.Position, statusText.Size = UDim2.fromOffset(216, 10), UDim2.new(1, -216 - 420, 0, 46)
			statusText.TextWrapped = true
			statsHolder.Position, statsHolder.Size = UDim2.new(1, -414, 0, 10), UDim2.fromOffset(404, 46)
		end
		local top = m + barH + m
		local bodyH = -(top + bottomH + m * 2)
		tabs.Visible = mobile
		if mobile then
			tabs.Position, tabs.Size = UDim2.fromOffset(m - 3, top), UDim2.new(1, -m * 2 + 6, 0, 40)
			for name, tab in tabButtons do
				local active = state.Tab == name
				tab.BackgroundColor3 = if active then C.Gold else C.Card
				tab.TextColor3 = if active then C.Backdrop else C.Ink
			end
			local y = top + 48
			for _, entry in { { treePanel, "Build" }, { previewPanel, "Preview" }, { inspectPanel, "Inspect" } } do
				entry[1].Position = UDim2.fromOffset(m, y)
				entry[1].Size = UDim2.new(1, -m * 2, 1, bodyH - 48)
				entry[1].Visible = state.Tab == entry[2]
			end
		else
			local leftW = if width < 1100 then 0.38 else 0.34
			local rightW = if width < 1100 then 0.3 else 0.27
			treePanel.Visible, previewPanel.Visible, inspectPanel.Visible = true, true, true
			treePanel.Position = UDim2.fromOffset(m, top)
			treePanel.Size = UDim2.new(leftW, -m * 1.5, 1, bodyH)
			previewPanel.Position = UDim2.new(leftW, m * 0.5, 0, top)
			previewPanel.Size = UDim2.new(1 - leftW - rightW, -m, 1, bodyH)
			inspectPanel.Position = UDim2.new(1 - rightW, m * 0.5, 0, top)
			inspectPanel.Size = UDim2.new(rightW, -m * 1.5, 1, bodyH)
		end
	end
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		local wasMobile = state.Mobile
		layout()
		if wasMobile ~= state.Mobile then
			render()
		end
	end)

	------------------------------------------------------------------ summaries
	local function payloadSummary(payload)
		local definition = schema.Payloads[payload.Kind]
		if payload.Kind == "Damage" then
			local channel = payload.DamageChannel or "Elemental"
			local element = if channel == "Elemental" then tostring(draft.Element) else channel
			return fmt(payload.Amount or 0) .. " " .. element .. " damage"
		end
		local parts = {}
		for _, field in (definition and definition.Fields) or {} do
			local value = payload[field.Key]
			if value ~= nil and type(value) ~= "table" and (field.Required or #parts == 0) then
				table.insert(parts, field.Label .. " " .. fmt(value))
			end
			if #parts >= 2 then
				break
			end
		end
		return if #parts > 0 then table.concat(parts, " · ") else (definition and definition.Description or "")
	end
	local function formSummary(scope)
		local form = schema.Forms[scope.Form]
		local parts = {}
		if scope == draft then
			table.insert(parts, tostring(principle()))
			table.insert(parts, tostring(draft.Element))
		end
		local mechanics = scope[scope.Form]
		for _, field in (form and form.Mechanics) or {} do
			if field.Object == scope.Form and mechanics and type(mechanics[field.Key]) == "number" then
				local short = string.gsub(field.Label, "^Maximum ", "Max ")
				table.insert(parts, short .. " " .. fmt(mechanics[field.Key]))
			end
			if #parts >= 4 then
				break
			end
		end
		return table.concat(parts, " · ")
	end
	local function eventTitle(eventName)
		return string.upper(EventPhrase[eventName] or schema.EventLabels[eventName] or eventName)
	end

	------------------------------------------------------------------ tree
	local INDENT = 26
	local order = 0
	local function row(depth, height, rails)
		order += 1
		local frame = new("Frame", {
			Size = UDim2.new(1, 0, 0, height),
			BackgroundTransparency = 1,
			LayoutOrder = order,
		}, tree)
		for level = 1, depth do
			if rails == nil or rails[level] ~= false then
				new("Frame", {
					Size = UDim2.new(0, 2, 1, 0),
					Position = UDim2.fromOffset(level * INDENT - 15, 0),
					BackgroundColor3 = C.Rail,
					BorderSizePixel = 0,
				}, frame)
			end
		end
		if depth > 0 then
			new("Frame", {
				Size = UDim2.fromOffset(13, 2),
				Position = UDim2.new(0, depth * INDENT - 15, 0.5, -1),
				BackgroundColor3 = C.Rail,
				BorderSizePixel = 0,
			}, frame)
		end
		return frame
	end

	local function actionCard(opts)
		local height = opts.Height or 66
		local frame = row(opts.Depth, height + 8)
		local x = opts.Depth * INDENT
		local base = if opts.Selected then C.CardSelected else C.Card
		local cardButton = new("TextButton", {
			Name = "SpellActionCard",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = base,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(x, 4),
			Size = UDim2.new(1, -x, 0, height),
		}, frame)
		corner(cardButton, 10)
		stroke(cardButton, if opts.Selected then C.Gold else C.PanelEdge, if opts.Selected then 2 else 1)
		hover(cardButton, base, if opts.Selected then base else C.CardHover)
		cardButton.Activated:Connect(opts.OnSelect)
		new("Frame", {
			Size = UDim2.new(0, 4, 1, -16),
			Position = UDim2.fromOffset(0, 8),
			BackgroundColor3 = opts.Color,
			BorderSizePixel = 0,
		}, cardButton)
		local iconSize = height - 22
		local icon = text(cardButton, opts.Icon, math.floor(iconSize * 0.55), opts.Color, Enum.Font.GothamBold, {
			Position = UDim2.new(0, 12, 0.5, -iconSize / 2),
			Size = UDim2.fromOffset(iconSize, iconSize),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Input,
		})
		corner(icon, iconSize // 2)
		stroke(icon, opts.Color, 1, 0.55)
		local textX = 12 + iconSize + 10
		local rightPad = if opts.OnAdd then 46 else 10
		local title = text(cardButton, opts.Title, 14, C.Ink, Enum.Font.GothamBold, {
			Position = UDim2.fromOffset(textX, 9),
			Size = UDim2.new(1, -textX - rightPad, 0, 18),
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		if opts.Tag then
			local tag = text(cardButton, opts.Tag, 10, opts.TagColor or C.Faint, Enum.Font.GothamBlack, {
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 16),
				Position = UDim2.new(1, -rightPad, 0, 10),
				AnchorPoint = Vector2.new(1, 0),
				TextWrapped = false,
				BackgroundTransparency = 0,
				BackgroundColor3 = C.Input,
			})
			pad(tag, 6, 0)
			corner(tag, 4)
			title.Size = UDim2.new(1, -textX - rightPad - 70, 0, 18)
		end
		text(cardButton, opts.Summary or "", 12, C.Muted, Enum.Font.Gotham, {
			Position = UDim2.fromOffset(textX, 28),
			Size = UDim2.new(1, -textX - rightPad, 1, -34),
			TextYAlignment = Enum.TextYAlignment.Top,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		if opts.OnAdd then
			local add = new("TextButton", {
				Name = "Attach",
				Text = "+",
				TextSize = 20,
				Font = Enum.Font.GothamBold,
				TextColor3 = C.Gold,
				BackgroundColor3 = C.Input,
				AutoButtonColor = false,
				Size = UDim2.fromOffset(32, 32),
				Position = UDim2.new(1, -40, 0.5, -16),
			}, cardButton)
			corner(add, 16)
			stroke(add, C.GoldDeep)
			hover(add, C.Input, C.CardHover)
			add.Activated:Connect(opts.OnAdd)
		end
		return cardButton
	end

	local function triggerBlock(depth, eventName, selected, onSelect, onAdd, unsupportedBy)
		local frame = row(depth, 40)
		local x = depth * INDENT
		local base = if selected then C.CardSelected else Color3.fromRGB(26, 22, 28)
		local tone = if unsupportedBy then C.Error else C.Gold
		local block = new("TextButton", {
			Name = "TriggerBlock",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = base,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(x, 4),
			Size = UDim2.new(1, -x, 0, 32),
		}, frame)
		corner(block, 16)
		stroke(
			block,
			if selected then C.Gold elseif unsupportedBy then C.Error else C.GoldDeep,
			if selected then 2 else 1
		)
		hover(block, base, C.CardHover)
		block.Activated:Connect(onSelect)
		text(block, if unsupportedBy then "!" else "◆", 14, tone, Enum.Font.GothamBold, {
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.fromOffset(18, 32),
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		text(
			block,
			eventTitle(eventName)
				.. (if unsupportedBy then "  ·  A " .. string.upper(unsupportedBy) .. " CAN'T DO THIS" else ""),
			12,
			tone,
			Enum.Font.GothamBlack,
			{
				Position = UDim2.fromOffset(32, 0),
				Size = UDim2.new(1, -110, 1, 0),
				TextWrapped = false,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}
		)
		local add = new("TextButton", {
			Text = "+ ADD",
			TextSize = 11,
			Font = Enum.Font.GothamBlack,
			TextColor3 = C.Gold,
			BackgroundColor3 = C.Input,
			AutoButtonColor = false,
			Size = UDim2.fromOffset(62, 24),
			Position = UDim2.new(1, -68, 0.5, -12),
		}, block)
		corner(add, 12)
		hover(add, C.Input, C.CardHover)
		add.Activated:Connect(onAdd)
	end

	local function ghost(depth, label, callback)
		local frame = row(depth, 38)
		local x = depth * INDENT
		local item = new("TextButton", {
			Name = "AddAction",
			Text = label,
			TextSize = 12,
			Font = Enum.Font.GothamBold,
			TextColor3 = C.Faint,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundColor3 = C.Panel,
			AutoButtonColor = false,
			Position = UDim2.fromOffset(x, 4),
			Size = UDim2.new(1, -x, 0, 30),
		}, frame)
		corner(item, 8)
		stroke(item, C.Rail, 1, 0.2)
		pad(item, 12, 0)
		item.MouseEnter:Connect(function()
			item.TextColor3 = C.Gold
		end)
		item.MouseLeave:Connect(function()
			item.TextColor3 = C.Faint
		end)
		item.Activated:Connect(callback)
	end

	local function isSel(kind, a, b)
		local s = state.Selection
		if s.Kind ~= kind then
			return false
		end
		if kind == "Form" then
			return s.Scope == a
		elseif kind == "Trigger" then
			return s.Scope == a and s.Event == b
		elseif kind == "Payload" then
			return s.Payload == a
		elseif kind == "Behavior" then
			return s.Step == a
		elseif kind == "Motion" then
			return s.Motion == a
		end
		return false
	end

	local function openPicker(picker)
		picker.Stage = picker.Stage or "Intent"
		state.Picker = picker
		render()
	end

	local renderScope
	renderScope = function(scope, depth, parentStep)
		local form = schema.Forms[scope.Form]
		local isRoot = scope == draft
		local formTitle = string.upper(
			if isRoot
				then "Create " .. (form and form.Label or tostring(scope.Form))
				else "Spawn " .. (form and form.Label or tostring(scope.Form))
		)
		actionCard({
			Depth = depth,
			Icon = FormIcon[scope.Form] or "◆",
			Color = ElementColor[draft.Element] or C.Gold,
			Title = formTitle,
			Summary = formSummary(scope)
				.. (if parentStep and (parentStep.Count or 1) > 1 then " · ×" .. fmt(parentStep.Count) else ""),
			Tag = if isRoot then "CREATES" else "NEW EFFECT",
			TagColor = C.Gold,
			Selected = isSel("Form", scope),
			Height = 72,
			OnSelect = function()
				select({ Kind = "Form", Scope = scope, Step = parentStep })
			end,
			OnAdd = function()
				openPicker({ Mode = "Trigger", Scope = scope })
			end,
		})
		local projectile = scope.Projectile
		if scope.Form == "Projectile" and projectile then
			if #(projectile.Behaviors or {}) == 0 then
				local frame = row(depth + 1, 26)
				text(frame, "→  Travels forward along your aim", 12, C.Faint, Enum.Font.GothamMedium, {
					Position = UDim2.fromOffset((depth + 1) * INDENT, 0),
					Size = UDim2.new(1, -(depth + 1) * INDENT, 1, 0),
				})
			end
			for _, behavior in projectile.Behaviors or {} do
				local definition = ProjectileBehaviorSpec.get(behavior.Kind)
				local parts = {}
				for _, field in (definition and definition.Fields) or {} do
					if behavior[field.Key] ~= nil and #parts < 2 then
						table.insert(parts, field.Label .. " " .. fmt(behavior[field.Key]))
					end
				end
				actionCard({
					Depth = depth + 1,
					Icon = "»",
					Color = C.Frost,
					Title = string.upper(definition and definition.Label or behavior.Kind),
					Summary = table.concat(parts, " · "),
					Tag = "WHILE TRAVELING",
					TagColor = C.Frost,
					Height = 58,
					Selected = isSel("Motion", behavior),
					OnSelect = function()
						select({ Kind = "Motion", Scope = scope, Motion = behavior })
					end,
				})
			end
		end
		local anyTrigger = false
		for _, eventName in schema.EventOrder do
			local steps = scope.Triggers and scope.Triggers[eventName]
			if steps and #steps > 0 then
				anyTrigger = true
				local eventOk = eventSupported(scope, eventName)
				local formLabel = (schema.Forms[scope.Form] or {}).Label or scope.Form
				triggerBlock(depth + 1, eventName, isSel("Trigger", scope, eventName), function()
					select({ Kind = "Trigger", Scope = scope, Event = eventName })
				end, function()
					openPicker({ Mode = "Action", Scope = scope, Event = eventName })
				end, if eventOk then nil else formLabel)
				local count = 0
				for _, step in steps do
					count += #(step.Payloads or {}) + (if step.Behavior then 1 else 0)
				end
				local index = 0
				local function relation()
					index += 1
					if count <= 1 then
						return "THEN", C.Faint
					end
					return if index == 1 then "TOGETHER" else "+ AT ONCE", C.Faint
				end
				for _, step in steps do
					local conditional = step.Condition ~= nil
					if step.Behavior then
						local behavior = schema.Behaviors[step.Behavior]
						local tag, tagColor = relation()
						if conditional then
							tag, tagColor = "IF", C.Arcane
						end
						local isSpawn = step.Behavior == "SpawnEffect"
						actionCard({
							Depth = depth + 2,
							Icon = if isSpawn then "◆" else "*",
							Color = if isSpawn then C.Gold else C.Warn,
							Title = string.upper(
								if isSpawn
									then "Start a new effect here"
									else (behavior and behavior.Label or step.Behavior)
							),
							Summary = if isSpawn
								then "Spawns a "
									.. tostring(step.Effect and step.Effect.Form or "?")
									.. " with its own triggers"
								else "Radius " .. fmt(step.Radius or 0) .. " · applies the effects below to all inside",
							Tag = tag,
							TagColor = tagColor,
							Selected = isSel("Behavior", step),
							OnSelect = function()
								select({ Kind = "Behavior", Scope = scope, Event = eventName, Step = step })
							end,
							OnAdd = if isSpawn
								then nil
								else function()
									openPicker({ Mode = "Action", Scope = scope, Event = eventName, Step = step })
								end,
						})
						if isSpawn and type(step.Effect) == "table" then
							renderScope(step.Effect, depth + 3, step)
						else
							for _, payload in step.Payloads or {} do
								local definition = schema.Payloads[payload.Kind]
								actionCard({
									Depth = depth + 3,
									Icon = PayloadIcon[payload.Kind] or "▲",
									Color = CategoryColor[definition and definition.Category] or C.Muted,
									Title = string.upper(
										PayloadVerb[payload.Kind] or (definition and definition.Label) or payload.Kind
									),
									Summary = payloadSummary(payload),
									Tag = "INSIDE",
									Height = 58,
									Selected = isSel("Payload", payload),
									OnSelect = function()
										select({
											Kind = "Payload",
											Scope = scope,
											Event = eventName,
											Step = step,
											Payload = payload,
										})
									end,
								})
							end
						end
					else
						for _, payload in step.Payloads or {} do
							local definition = schema.Payloads[payload.Kind]
							local tag, tagColor = relation()
							if conditional then
								tag, tagColor = "IF", C.Arcane
							end
							if
								not eventOk
								or not schema.supportsPayload(payload.Kind, scope.Form, eventName, principle())
							then
								tag, tagColor = "UNSUPPORTED", C.Error
							end
							actionCard({
								Depth = depth + 2,
								Icon = PayloadIcon[payload.Kind] or "▲",
								Color = CategoryColor[definition and definition.Category] or C.Muted,
								Title = string.upper(
									PayloadVerb[payload.Kind] or (definition and definition.Label) or payload.Kind
								),
								Summary = payloadSummary(payload),
								Tag = tag,
								TagColor = tagColor,
								Selected = isSel("Payload", payload),
								OnSelect = function()
									select({
										Kind = "Payload",
										Scope = scope,
										Event = eventName,
										Step = step,
										Payload = payload,
									})
								end,
							})
						end
					end
				end
				ghost(depth + 2, "+  Add another effect at this moment", function()
					openPicker({ Mode = "Action", Scope = scope, Event = eventName })
				end)
			end
		end
		ghost(
			depth + 1,
			if anyTrigger then "◆  Add another trigger" else "◆  Choose when something happens",
			function()
				openPicker({ Mode = "Trigger", Scope = scope })
			end
		)
	end

	local function renderTree()
		clearChildren(tree, "UIListLayout")
		order = 0
		local head = row(0, 44)
		local castChip = text(head, "▶  ON CAST", 13, C.Ink, Enum.Font.GothamBlack, {
			Position = UDim2.fromOffset(0, 6),
			Size = UDim2.fromOffset(120, 32),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Blood,
		})
		corner(castChip, 16)
		local casting = draft.Casting or {}
		text(
			head,
			string.format(
				"%s cast · cooldown %ss%s",
				tostring(casting.Mode or "Instant"),
				fmt(casting.Cooldown or 0),
				if (casting.CastTime or 0) > 0 then " · " .. fmt(casting.CastTime) .. "s wind-up" else ""
			),
			12,
			C.Faint,
			Enum.Font.Gotham,
			{ Position = UDim2.fromOffset(132, 6), Size = UDim2.new(1, -132, 0, 32) }
		)
		if advanced then
			for _, entry in Forge.settingsCards(draft, schema) do
				actionCard({
					Depth = 1,
					Icon = entry.Icon,
					Color = entry.Color,
					Title = entry.Title,
					Summary = entry.Summary,
					Tag = entry.Tag,
					TagColor = entry.TagColor,
					Height = 58,
					Selected = state.Selection.Kind == "Section" and state.Selection.Id == entry.Id,
					OnSelect = function()
						select({ Kind = "Section", Scope = draft, Id = entry.Id })
					end,
				})
			end
		end
		renderScope(draft, 1, nil)
		local legend = row(0, 56)
		text(
			legend,
			"◆ trigger · cards below a trigger run together when it fires · IF cards run only when their condition passes",
			11,
			C.Faint,
			Enum.Font.Gotham,
			{ Size = UDim2.new(1, 0, 1, -8), Position = UDim2.fromOffset(0, 8) }
		)
	end

	------------------------------------------------------------------ picker
	local function payloadKinds()
		local kinds = table.clone(schema.PayloadOrder)
		local extra = {}
		for kind in schema.Payloads do
			if not table.find(kinds, kind) then
				table.insert(extra, kind)
			end
		end
		table.sort(extra)
		for _, kind in extra do
			table.insert(kinds, kind)
		end
		return kinds
	end

	-- Every option is checked against the schema for this Form, moment, and
	-- Principle. Capability matches blocked only by Principle stay visible but
	-- disabled so players learn why, instead of the choice silently vanishing.
	local function optionsFor(picker, intent)
		local scope, eventName = picker.Scope, picker.Event
		local formName = scope.Form
		local options = {}
		if picker.Step then
			local behavior = schema.Behaviors[picker.Step.Behavior]
			for _, kind in (behavior and behavior.PayloadKinds) or {} do
				local definition = schema.Payloads[kind]
				if definition and (definition.Principle == nil or definition.Principle == principle()) then
					table.insert(options, { Kind = "Payload", Id = kind, Enabled = true })
				end
			end
			return options
		end
		for _, kind in payloadKinds() do
			local definition = schema.Payloads[kind]
			if intent.Categories and intent.Categories[definition.Category] then
				if schema.supportsPayload(kind, formName, eventName, principle()) then
					table.insert(options, { Kind = "Payload", Id = kind, Enabled = true })
				elseif schema.supportsPayloadCapability(kind, formName, eventName) then
					table.insert(options, {
						Kind = "Payload",
						Id = kind,
						Enabled = false,
						Reason = "Needs the " .. tostring(definition.Principle) .. " principle",
					})
				end
			end
		end
		for kind in intent.Behaviors or {} do
			if schema.supportsBehavior(kind, formName, eventName) then
				if kind == "SpawnEffect" then
					for _, spawnForm in spec.SpawnForms do
						-- Offer only spawned effects the validator would accept as created.
						local supported, reason = false, tostring(principle()) .. " cannot create this"
						local effect = schema.supportsPrincipleForm(principle(), spawnForm)
							and spec.defaultSpawnEffect(spawnForm, principle())
						local child = effect and spec.expandSpawnEffect(draft, effect)
						if child then
							local lifetime = child.Lifetime and child.Lifetime.Mode
							if lifetime ~= "FixedDuration" and lifetime ~= "Instantaneous" then
								reason = "Spawned effects need a limited lifetime"
							else
								local valid, why = spec.validate(child, 1)
								supported, reason = valid, if valid then nil else tostring(why)
							end
						end
						table.insert(options, {
							Kind = "Spawn",
							Id = spawnForm,
							Enabled = supported,
							Reason = reason,
						})
					end
				else
					table.insert(options, { Kind = "Behavior", Id = kind, Enabled = true })
				end
			end
		end
		return options
	end

	local function addOption(picker, option)
		local scope, eventName = picker.Scope, picker.Event
		commit(function()
			scope.Triggers = scope.Triggers or {}
			local steps = scope.Triggers[eventName] or {}
			scope.Triggers[eventName] = steps
			if option.Kind == "Payload" then
				local payload = spec.copy(schema.Payloads[option.Id].Defaults or {})
				payload.Kind = option.Id
				if picker.Step then
					picker.Step.Payloads = picker.Step.Payloads or {}
					table.insert(picker.Step.Payloads, payload)
					state.Selection =
						{ Kind = "Payload", Scope = scope, Event = eventName, Step = picker.Step, Payload = payload }
				else
					local step = { Payloads = { payload } }
					table.insert(steps, step)
					state.Selection =
						{ Kind = "Payload", Scope = scope, Event = eventName, Step = step, Payload = payload }
				end
			elseif option.Kind == "Behavior" then
				local definition = schema.Behaviors[option.Id]
				local step = spec.copy(definition.Defaults or {})
				step.Behavior = option.Id
				step.Payloads = {}
				for _, kind in definition.DefaultPayloadKinds or {} do
					local payloadDefinition = schema.Payloads[kind]
					if payloadDefinition then
						local payload = spec.copy(payloadDefinition.Defaults or {})
						payload.Kind = kind
						table.insert(step.Payloads, payload)
					end
				end
				table.insert(steps, step)
				state.Selection = { Kind = "Behavior", Scope = scope, Event = eventName, Step = step }
			elseif option.Kind == "Spawn" then
				local definition = schema.Behaviors.SpawnEffect
				local step = spec.copy(definition.Defaults or {})
				step.Behavior = "SpawnEffect"
				step.Payloads = {}
				step.Effect = spec.defaultSpawnEffect(option.Id, principle())
				table.insert(steps, step)
				state.Selection = { Kind = "Form", Scope = step.Effect, Step = step }
			end
			state.Picker = nil
			if state.Mobile then
				state.Tab = "Inspect"
			end
		end)
	end

	local function renderPicker()
		local existing = root:FindFirstChild("ActionPicker")
		if existing then
			existing:Destroy()
		end
		local picker = state.Picker
		if not picker then
			return
		end
		local shade = new("TextButton", {
			Name = "ActionPicker",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 40,
		}, root)
		shade.Activated:Connect(function()
			state.Picker = nil
			render()
		end)
		local sheet = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(if state.Mobile then 1 else 0.62, -20, if state.Mobile then 0.9 else 0.78, 0),
			BackgroundColor3 = C.Panel,
			BorderSizePixel = 0,
			Active = true,
		}, shade)
		new("UISizeConstraint", { MaxSize = Vector2.new(860, 720) }, sheet)
		corner(sheet, 14)
		stroke(sheet, C.Gold, 1, 0.4)
		local sheetScale = new("UIScale", { Scale = 0.96 }, sheet)
		TweenService:Create(sheetScale, TweenInfo.new(0.14, Enum.EasingStyle.Quad), { Scale = 1 }):Play()
		local formLabel = (schema.Forms[picker.Scope.Form] or {}).Label or picker.Scope.Form
		local heading, subheading
		if picker.Mode == "Trigger" then
			heading = "When should something happen?"
			subheading = "Moments your " .. formLabel .. " can react to"
		elseif picker.Mode == "Motion" then
			heading = "How should it travel?"
			subheading = "Movement behaviors supported for projectiles"
		elseif picker.Step then
			heading = "What happens inside the blast?"
			subheading = eventTitle(picker.Event) .. "  ·  applies to everything in the radius"
		elseif picker.Stage == "Intent" then
			heading = "What do you want to happen?"
			subheading = eventTitle(picker.Event) .. "  ·  " .. formLabel
		else
			heading = picker.Intent.Title
			subheading = eventTitle(picker.Event) .. "  ·  " .. formLabel
		end
		text(sheet, heading, 26, C.Ink, Enum.Font.Garamond, {
			Position = UDim2.fromOffset(22, 14),
			Size = UDim2.new(1, -120, 0, 34),
		})
		text(sheet, subheading, 12, C.Gold, Enum.Font.GothamBold, {
			Position = UDim2.fromOffset(22, 48),
			Size = UDim2.new(1, -120, 0, 18),
		})
		local close = pill(sheet, "×", function()
			state.Picker = nil
			render()
		end)
		close.Position, close.Size = UDim2.new(1, -52, 0, 16), UDim2.fromOffset(36, 36)
		if picker.Mode == "Action" and picker.Stage == "Options" and not picker.Step then
			local backButton = pill(sheet, "‹ BACK", function()
				picker.Stage = "Intent"
				render()
			end)
			backButton.Position, backButton.Size = UDim2.new(1, -140, 0, 16), UDim2.fromOffset(80, 36)
		end
		local body = new("ScrollingFrame", {
			Position = UDim2.fromOffset(0, 78),
			Size = UDim2.new(1, 0, 1, -86),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 6,
			ScrollBarImageColor3 = C.Rail,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
		}, sheet)
		pad(body, 18, 6)
		local grid = new("UIGridLayout", {
			CellPadding = UDim2.fromOffset(12, 12),
			CellSize = UDim2.new(if state.Mobile then 1 else 0.5, -8, 0, 84),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, body)
		local function tile(icon, color, title, blurb, enabled, callback, badge)
			local base = if enabled then C.Card else Color3.fromRGB(24, 21, 26)
			local item = new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = base,
				BorderSizePixel = 0,
			}, body)
			corner(item, 12)
			stroke(item, if enabled then C.PanelEdge else C.Panel)
			if enabled then
				hover(item, base, C.CardHover)
				item.Activated:Connect(callback)
			end
			local glyph = text(item, icon, 26, if enabled then color else C.Faint, Enum.Font.GothamBold, {
				Position = UDim2.fromOffset(12, 14),
				Size = UDim2.fromOffset(54, 54),
				TextXAlignment = Enum.TextXAlignment.Center,
				BackgroundTransparency = 0,
				BackgroundColor3 = C.Input,
			})
			corner(glyph, 27)
			stroke(glyph, color, 1, if enabled then 0.5 else 0.85)
			text(item, title, 15, if enabled then C.Ink else C.Faint, Enum.Font.GothamBold, {
				Position = UDim2.fromOffset(78, 12),
				Size = UDim2.new(1, -90, 0, 20),
				TextWrapped = false,
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			text(item, blurb, 12, if enabled then C.Muted else C.Faint, Enum.Font.Gotham, {
				Position = UDim2.fromOffset(78, 34),
				Size = UDim2.new(1, -90, 0, 42),
				TextYAlignment = Enum.TextYAlignment.Top,
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			if badge then
				text(item, badge, 10, if enabled then C.Gold else C.Faint, Enum.Font.GothamBlack, {
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -10, 0, 12),
					Size = UDim2.fromOffset(120, 14),
					TextXAlignment = Enum.TextXAlignment.Right,
				})
			end
			return item
		end
		if picker.Mode == "Trigger" then
			local scope = picker.Scope
			local events =
				schema.eventsForEffects(scope.Form, castingMode(scope), if scope == draft then draft.Targeting else nil)
			for _, eventName in events do
				local used = scope.Triggers and scope.Triggers[eventName] and #scope.Triggers[eventName] > 0
				tile(
					"◆",
					C.Gold,
					EventPhrase[eventName] or schema.EventLabels[eventName] or eventName,
					schema.EventDescriptions[eventName] or "",
					true,
					function()
						openPicker({ Mode = "Action", Scope = scope, Event = eventName })
					end,
					if used then "IN SPELL" else nil
				)
			end
			if #events == 0 then
				tile("—", C.Faint, "No triggers available", "This form has no supported moments for effects.", false)
			end
			if scope.Form == "Projectile" and scope.Projectile then
				tile(
					"»",
					C.Frost,
					"Change how it travels",
					"Homing, piercing, bouncing, splitting and more.",
					true,
					function()
						openPicker({ Mode = "Motion", Scope = scope, Stage = "Options" })
					end
				)
			end
		elseif picker.Mode == "Motion" then
			local behaviors = picker.Scope.Projectile.Behaviors or {}
			for _, kind in ProjectileBehaviorSpec.Order do
				local definition = ProjectileBehaviorSpec.get(kind)
				local present = false
				for _, existingBehavior in behaviors do
					if existingBehavior.Kind == kind then
						present = true
					end
				end
				tile("»", C.Frost, definition.Label, definition.Description, not present, function()
					commit(function()
						picker.Scope.Projectile.Behaviors = picker.Scope.Projectile.Behaviors or {}
						local behavior = ProjectileBehaviorSpec.copyDefaults(kind)
						table.insert(picker.Scope.Projectile.Behaviors, behavior)
						state.Selection = { Kind = "Motion", Scope = picker.Scope, Motion = behavior }
						state.Picker = nil
					end)
				end, if present then "ALREADY ADDED" else nil)
			end
		elseif picker.Stage == "Intent" and not picker.Step then
			for _, intent in Intents do
				if intent.Trigger then
					tile(intent.Icon, intent.Color, intent.Title, intent.Blurb, true, function()
						openPicker({ Mode = "Trigger", Scope = picker.Scope })
					end)
				else
					local options = optionsFor(picker, intent)
					local available = 0
					for _, option in options do
						if option.Enabled then
							available += 1
						end
					end
					tile(
						intent.Icon,
						intent.Color,
						intent.Title,
						if available > 0
							then intent.Blurb
							else "Not supported at this moment for a " .. formLabel .. ".",
						available > 0,
						function()
							picker.Stage, picker.Intent = "Options", intent
							render()
						end,
						if available > 0 then available .. " AVAILABLE" else "UNAVAILABLE"
					)
				end
			end
		else
			local options = optionsFor(picker, picker.Intent or {})
			for _, option in options do
				local icon, color, title, blurb
				if option.Kind == "Payload" then
					local definition = schema.Payloads[option.Id]
					icon = PayloadIcon[option.Id] or "▲"
					color = CategoryColor[definition.Category] or C.Muted
					title = PayloadVerb[option.Id] or definition.Label
					blurb = definition.Description
				elseif option.Kind == "Spawn" then
					local definition = schema.Forms[option.Id]
					icon, color = FormIcon[option.Id] or "◆", C.Gold
					title = FormVerb[option.Id] or ("Create " .. definition.Label)
					blurb = "Starts a separate " .. definition.Label .. " here. It gets its own triggers and effects."
				else
					local definition = schema.Behaviors[option.Id]
					icon, color, title, blurb = "*", C.Warn, definition.Label, definition.Description
				end
				tile(icon, color, title, if option.Enabled then blurb else option.Reason, option.Enabled, function()
					addOption(picker, option)
				end, if option.Enabled then nil else "UNAVAILABLE")
			end
			if #options == 0 then
				tile("—", C.Faint, "Nothing available", "The engine has no supported actions for this moment.", false)
			end
		end
		grid.Parent = body
	end

	------------------------------------------------------------------ inspector
	local inspectOrder = 0
	local function nextOrder()
		inspectOrder += 1
		return inspectOrder
	end
	local function section(title)
		local label = text(inspector, title, 11, C.Faint, Enum.Font.GothamBlack, {
			Size = UDim2.new(1, 0, 0, 22),
			LayoutOrder = nextOrder(),
			TextYAlignment = Enum.TextYAlignment.Bottom,
		})
		return label
	end
	local function note(value, color)
		return text(inspector, value, 12, color or C.Muted, Enum.Font.Gotham, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = nextOrder(),
			TextYAlignment = Enum.TextYAlignment.Top,
		})
	end
	local function header(icon, color, title, description)
		local frame = new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = C.Card,
			BorderSizePixel = 0,
			LayoutOrder = nextOrder(),
		}, inspector)
		corner(frame, 10)
		stroke(frame, color, 1, 0.5)
		pad(frame, 12, 12)
		local glyph = text(frame, icon, 24, color, Enum.Font.GothamBold, {
			Size = UDim2.fromOffset(46, 46),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Input,
		})
		corner(glyph, 23)
		text(frame, title, 20, C.Ink, Enum.Font.Garamond, {
			Position = UDim2.fromOffset(58, 0),
			Size = UDim2.new(1, -58, 0, 24),
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		text(frame, description or "", 12, C.Muted, Enum.Font.Gotham, {
			Position = UDim2.fromOffset(58, 26),
			Size = UDim2.new(1, -58, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
	end
	local function chips(parent, values, current, onPick, labeler)
		local holder = new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
		}, parent)
		local layout = list(holder, 6, true)
		layout.Wraps = true
		for index, value in values do
			local active = value == current
			local chip = new("TextButton", {
				Text = if labeler then labeler(value) else tostring(value),
				TextSize = 12,
				Font = Enum.Font.GothamBold,
				TextColor3 = if active then C.Backdrop else C.Ink,
				BackgroundColor3 = if active then C.Gold else C.Input,
				AutoButtonColor = false,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 32),
				LayoutOrder = index,
			}, holder)
			corner(chip, 16)
			stroke(chip, if active then C.Gold else C.PanelEdge)
			pad(chip, 12, 0)
			if not active then
				hover(chip, C.Input, C.CardHover)
				chip.Activated:Connect(function()
					onPick(value)
				end)
			end
		end
		return holder
	end
	local function fieldBox(label, help)
		local frame = new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = nextOrder(),
		}, inspector)
		list(frame, 6)
		text(frame, label, 13, C.Ink, Enum.Font.GothamBold, {
			Size = UDim2.new(1, 0, 0, 18),
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = 1,
		})
		if help and help ~= "" then
			text(frame, help, 11, C.Faint, Enum.Font.Gotham, {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 2,
			})
		end
		return frame
	end
	local function choiceField(label, help, values, current, onPick, labeler)
		local frame = fieldBox(label, help)
		chips(frame, values, current, function(value)
			commit(function()
				onPick(value)
			end)
		end, labeler).LayoutOrder =
			3
	end
	local function numberField(target, field)
		local frame = fieldBox(field.Label, field.Help)
		local lo = field.Min or 0
		local hi = field.Max or math.max(lo + 1, (target[field.Key] or 0) * 2, 10)
		local current = target[field.Key]
		local controls = new("Frame", {
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundTransparency = 1,
			LayoutOrder = 3,
		}, frame)
		local track = new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.new(1, -92, 0, 8),
			Position = UDim2.new(0, 0, 0.5, -4),
			BackgroundColor3 = C.Input,
			BorderSizePixel = 0,
		}, controls)
		corner(track, 4)
		local fill = new("Frame", { BackgroundColor3 = C.Ember, BorderSizePixel = 0 }, track)
		corner(fill, 4)
		local knob = new("Frame", {
			Size = UDim2.fromOffset(18, 18),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = C.Gold,
			BorderSizePixel = 0,
		}, track)
		corner(knob, 9)
		stroke(knob, C.Backdrop, 2)
		local box = new("TextBox", {
			Text = if current == nil then "" else fmt(current),
			PlaceholderText = "default",
			PlaceholderColor3 = C.Faint,
			ClearTextOnFocus = false,
			TextSize = 14,
			Font = Enum.Font.GothamBold,
			TextColor3 = C.Ink,
			BackgroundColor3 = C.Input,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(80, 34),
			Position = UDim2.new(1, -80, 0, 0),
		}, controls)
		corner(box, 8)
		stroke(box, C.PanelEdge)
		local function normalize(value)
			value = math.clamp(value, lo, hi)
			if field.Integer then
				value = math.round(value)
			elseif hi - lo > 20 then
				value = math.round(value * 10) / 10
			else
				value = math.round(value * 100) / 100
			end
			return value
		end
		local function show(value)
			local alpha = if hi > lo then ((value or lo) - lo) / (hi - lo) else 0
			fill.Size = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
			knob.Position = UDim2.fromScale(math.clamp(alpha, 0, 1), 0.5)
			box.Text = if value == nil then "" else fmt(value)
		end
		show(current)
		box.FocusLost:Connect(function()
			local value = tonumber(box.Text)
			if value and normalize(value) ~= target[field.Key] then
				commit(function()
					target[field.Key] = normalize(value)
				end)
			else
				show(target[field.Key])
			end
		end)
		local dragging = nil
		local function fromInput(position)
			local alpha = (position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X)
			return normalize(lo + math.clamp(alpha, 0, 1) * (hi - lo))
		end
		track.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				dragging = input
				target[field.Key] = fromInput(input.Position)
				show(target[field.Key])
			end
		end)
		local moved = UIS.InputChanged:Connect(function(input)
			if
				dragging
				and (
					input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
				)
			then
				target[field.Key] = fromInput(input.Position)
				show(target[field.Key])
			end
		end)
		local ended = UIS.InputEnded:Connect(function(input)
			if
				dragging
				and (
					input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
				)
			then
				dragging = nil
				task.defer(changed)
			end
		end)
		frame.Destroying:Connect(function()
			moved:Disconnect()
			ended:Disconnect()
		end)
	end
	local function genericField(target, field)
		local value = target[field.Key]
		if field.Options then
			choiceField(field.Label, field.Help, field.Options, value, function(choice)
				target[field.Key] = choice
			end)
		elseif type(value) == "boolean" then
			choiceField(field.Label, field.Help, { true, false }, value, function(choice)
				target[field.Key] = choice
			end, function(choice)
				return if choice then "ON" else "OFF"
			end)
		elseif field.Min ~= nil or field.Max ~= nil or type(value) == "number" then
			numberField(target, field)
		elseif type(value) == "string" or value == nil then
			local frame = fieldBox(field.Label, field.Help)
			local box = new("TextBox", {
				Text = value or "",
				ClearTextOnFocus = false,
				TextSize = 13,
				Font = Enum.Font.Gotham,
				TextColor3 = C.Ink,
				BackgroundColor3 = C.Input,
				Size = UDim2.new(1, 0, 0, 34),
				LayoutOrder = 3,
			}, frame)
			corner(box, 8)
			box.FocusLost:Connect(function()
				if box.Text ~= (value or "") then
					commit(function()
						target[field.Key] = if box.Text == "" then nil else box.Text
					end)
				end
			end)
		end
	end
	local function matches(label)
		local query = string.lower(state.Search or "")
		return query == "" or string.find(string.lower(tostring(label)), query, 1, true) ~= nil
	end
	local function fieldGroup(target, fields, key)
		fields = fields or {}
		local primary, extra = {}, {}
		for _, field in fields or {} do
			if not matches(field.Label) then
				continue
			end
			if field.Required == false and #fields > 3 and not advanced then
				table.insert(extra, field)
			else
				table.insert(primary, field)
			end
		end
		for _, field in primary do
			genericField(target, field)
		end
		if #extra > 0 then
			local open = state.More[key] == true
			local toggle = pill(
				inspector,
				(if open then "▼  Fewer options" else "▶  More options") .. "  (" .. #extra .. ")",
				function()
					state.More[key] = not open
					render()
				end
			)
			toggle.Size = UDim2.new(1, 0, 0, 34)
			toggle.LayoutOrder = nextOrder()
			if open then
				for _, field in extra do
					genericField(target, field)
				end
			end
		end
	end
	local function removeButton(label, callback)
		local item = pill(inspector, label, function()
			commit(callback)
		end, "danger")
		item.Size = UDim2.new(1, 0, 0, 38)
		item.LayoutOrder = nextOrder()
	end
	local function actionButton(label, callback)
		local item = pill(inspector, label, callback)
		item.Size = UDim2.new(1, 0, 0, 40)
		item.LayoutOrder = nextOrder()
		item.TextColor3 = C.Gold
		return item
	end
	local function pruneStep(scope, eventName, step)
		local steps = scope.Triggers[eventName]
		if step and #(step.Payloads or {}) == 0 and not step.Behavior then
			local index = table.find(steps, step)
			if index then
				table.remove(steps, index)
			end
		end
		if steps and #steps == 0 then
			scope.Triggers[eventName] = nil
		end
	end

	local function renderInspector()
		clearChildren(inspector, "UIListLayout")
		inspectOrder = 0
		if state.Mobile then
			local backToSpell = pill(inspector, "‹  Back to spell", function()
				state.Tab = "Build"
				render()
			end)
			backToSpell.Size = UDim2.new(1, 0, 0, 40)
			backToSpell.LayoutOrder = nextOrder()
		end
		if advanced then
			local search = new("TextBox", {
				Name = "FieldSearch",
				Text = state.Search or "",
				PlaceholderText = "Search every setting on this card",
				PlaceholderColor3 = C.Faint,
				ClearTextOnFocus = false,
				TextSize = 13,
				Font = Enum.Font.Gotham,
				TextColor3 = C.Ink,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundColor3 = C.Input,
				Size = UDim2.new(1, 0, 0, 36),
				LayoutOrder = nextOrder(),
			}, inspector)
			corner(search, 8)
			stroke(search, C.PanelEdge)
			pad(search, 12, 0)
			search.FocusLost:Connect(function()
				if search.Text ~= (state.Search or "") then
					state.Search = search.Text
					render()
				end
			end)
		end
		local s = state.Selection
		-- Advanced: below the card's own fields, host the controller's full
		-- section editor for that part of the spell (every remaining setting).
		local function hosted(sections, eventName)
			if not advanced or not callbacks.renderSections then
				return
			end
			for _, sectionId in sections do
				local finalOrder =
					callbacks.renderSections(inspector, { sectionId }, eventName, state.Search, inspectOrder + 1)
				inspectOrder = math.max(inspectOrder + 1, (finalOrder or inspectOrder) + 1)
			end
		end
		local function rootEvent(target)
			for _, eventName in schema.EventOrder do
				for _, step in (draft.Triggers and draft.Triggers[eventName]) or {} do
					local live = {}
					collect({ Triggers = { [eventName] = { step } } }, live)
					if live[target] then
						return eventName
					end
				end
			end
			local form = schema.Forms[draft.Form] or {}
			return form.DefaultEvent
		end
		if s.Kind == "Section" then
			local entry = Forge.settingsCard(draft, schema, s.Id)
			inspectSub.Text = "Spell-wide settings"
			header(entry.Icon, entry.Color, entry.Label, entry.Description)
			hosted(entry.Sections)
		elseif s.Kind == "Form" then
			local scope = s.Scope
			local form = schema.Forms[scope.Form] or {}
			local isRoot = scope == draft
			inspectSub.Text = if isRoot then "What this spell creates" else "The effect this action starts"
			header(
				FormIcon[scope.Form] or "◆",
				ElementColor[draft.Element] or C.Gold,
				form.Label or scope.Form,
				form.Description
			)
			if isRoot then
				section("WHAT DOES THIS SPELL CREATE?")
				local compatible = {}
				for _, formName in schema.FormOrder or {} do
					if schema.supportsPrincipleForm(principle(), formName) then
						table.insert(compatible, formName)
					end
				end
				local frame =
					fieldBox("Shape", "Changing the shape keeps your effects; any the new shape can't run are flagged.")
				chips(frame, compatible, draft.Form, function(value)
					callbacks.changeForm(value, principle())
					relocate(draft)
					state.Selection = { Kind = "Form", Scope = draft }
					changed()
				end, function(value)
					return (FormIcon[value] or "") .. "  " .. schema.Forms[value].Label
				end).LayoutOrder =
					3
				section("MAGIC")
				local principles = {}
				for _, candidate in schema.Principles do
					if schema.supportsPrincipleForm(candidate, draft.Form) then
						table.insert(principles, candidate)
					end
				end
				local principleBox =
					fieldBox("Magical principle", (schema.PrincipleDefinitions[principle()] or {}).Description)
				chips(principleBox, principles, principle(), function(value)
					callbacks.changeForm(draft.Form, value)
					relocate(draft)
					changed()
				end).LayoutOrder =
					3
				choiceField("Element", nil, schema.Elements, draft.Element, function(value)
					draft.Element = value
				end)
				local targeting = {}
				for _, mode in schema.TargetingModeOrder do
					if form.Targeting and form.Targeting[mode] then
						table.insert(targeting, mode)
					end
				end
				if #targeting > 1 then
					choiceField(
						"Targeting",
						(schema.TargetingModes[draft.Targeting] or {}).Description,
						targeting,
						draft.Targeting,
						function(value)
							draft.Targeting = value
						end,
						function(value)
							return schema.TargetingModes[value].Label
						end
					)
				end
				if draft.TargetRules then
					choiceField(
						"Who it affects",
						schema.TargetRelationships[draft.TargetRules.Relationship],
						schema.TargetRelationshipOrder,
						draft.TargetRules.Relationship,
						function(value)
							draft.TargetRules.Relationship = value
						end
					)
				end
			else
				section("WHAT DOES IT START?")
				local spawnForms = {}
				for _, formName in spec.SpawnForms do
					if schema.supportsPrincipleForm(principle(), formName) then
						table.insert(spawnForms, formName)
					end
				end
				local frame = fieldBox("Shape", "Changing this resets the new effect's own triggers.")
				chips(frame, spawnForms, scope.Form, function(value)
					commit(function()
						local fresh = spec.defaultSpawnEffect(value, principle())
						if fresh and s.Step then
							s.Step.Effect = fresh
							state.Selection = { Kind = "Form", Scope = fresh, Step = s.Step }
						end
					end)
				end, function(value)
					return (FormIcon[value] or "") .. "  " .. schema.Forms[value].Label
				end).LayoutOrder =
					3
				if s.Step then
					fieldGroup(s.Step, (schema.Behaviors.SpawnEffect or {}).Fields, "spawn")
				end
			end
			local mechanics = scope[scope.Form]
			if mechanics then
				section("SHAPE & MOVEMENT")
				local fields = {}
				for _, field in form.Mechanics or {} do
					if field.Object == scope.Form and (isRoot or mechanics[field.Key] ~= nil) then
						table.insert(fields, field)
					end
				end
				fieldGroup(mechanics, fields, "mech:" .. tostring(scope.Form))
			end
			if scope.Lifetime and scope.Lifetime.Mode == "FixedDuration" then
				numberField(scope.Lifetime, {
					Key = "Duration",
					Label = "Lasts for (seconds)",
					Min = 0.1,
					Max = 60,
					Help = "How long it remains before it ends.",
				})
			end
			if scope.Form == "Projectile" and scope.Projectile then
				section("MOVEMENT BEHAVIOR")
				if #(scope.Projectile.Behaviors or {}) == 0 then
					note("Travels straight along your aim.")
				end
				for _, behavior in scope.Projectile.Behaviors or {} do
					local definition = ProjectileBehaviorSpec.get(behavior.Kind)
					local item = pill(
						inspector,
						"»  " .. (definition and definition.Label or behavior.Kind),
						function()
							select({ Kind = "Motion", Scope = scope, Motion = behavior })
						end
					)
					item.Size, item.LayoutOrder = UDim2.new(1, 0, 0, 36), nextOrder()
					item.TextXAlignment = Enum.TextXAlignment.Left
					pad(item, 12, 0)
				end
				actionButton("+  Change how it travels", function()
					openPicker({ Mode = "Motion", Scope = scope, Stage = "Options" })
				end)
			end
			section("WHAT HAPPENS NEXT")
			actionButton("◆  Add a trigger", function()
				openPicker({ Mode = "Trigger", Scope = scope })
			end)
			if not isRoot and s.Step then
				removeButton("Remove this effect", function()
					-- Locate the owning trigger list anywhere in the draft.
					local function strip(container)
						for eventName, steps in pairs(container.Triggers or {}) do
							local index = table.find(steps, s.Step)
							if index then
								table.remove(steps, index)
								if #steps == 0 then
									container.Triggers[eventName] = nil
								end
								return true
							end
							for _, step in steps do
								if type(step.Effect) == "table" and strip(step.Effect) then
									return true
								end
							end
						end
						return false
					end
					strip(draft)
					state.Selection = { Kind = "Form", Scope = draft }
				end)
			end
			if s.Scope == draft then
				hosted({ "Setup" })
			else
				hosted({ "ConfigureEffects" }, rootEvent(s.Step))
			end
		elseif s.Kind == "Trigger" then
			inspectSub.Text = "A moment this spell reacts to"
			header("◆", C.Gold, EventPhrase[s.Event] or s.Event, schema.EventDescriptions[s.Event])
			local steps = s.Scope.Triggers[s.Event] or {}
			if not eventSupported(s.Scope, s.Event) then
				local formLabel = (schema.Forms[s.Scope.Form] or {}).Label or s.Scope.Form
				note(
					"A "
						.. formLabel
						.. " never reaches this moment, so the spell can't be tested or saved until these effects move or are removed.",
					C.Error
				)
				local target = homeEvent(s.Scope)
				if target then
					actionButton("Move effects to: " .. (EventPhrase[target] or target), function()
						commit(function()
							relocate(s.Scope, s.Event)
							state.Selection = { Kind = "Trigger", Scope = s.Scope, Event = target }
						end)
					end)
				end
			end
			section("RUNS " .. (if #steps > 1 then "THESE TOGETHER" else "THIS"))
			for _, step in steps do
				for _, payload in step.Payloads or {} do
					if not step.Behavior then
						local item = pill(
							inspector,
							(PayloadIcon[payload.Kind] or "▲") .. "  " .. (PayloadVerb[payload.Kind] or payload.Kind),
							function()
								select({
									Kind = "Payload",
									Scope = s.Scope,
									Event = s.Event,
									Step = step,
									Payload = payload,
								})
							end
						)
						item.Size, item.LayoutOrder = UDim2.new(1, 0, 0, 36), nextOrder()
						item.TextXAlignment = Enum.TextXAlignment.Left
						pad(item, 12, 0)
					end
				end
				if step.Behavior then
					local item = pill(
						inspector,
						"*  " .. ((schema.Behaviors[step.Behavior] or {}).Label or step.Behavior),
						function()
							select({ Kind = "Behavior", Scope = s.Scope, Event = s.Event, Step = step })
						end
					)
					item.Size, item.LayoutOrder = UDim2.new(1, 0, 0, 36), nextOrder()
					item.TextXAlignment = Enum.TextXAlignment.Left
					pad(item, 12, 0)
				end
			end
			actionButton("+  Add an effect at this moment", function()
				openPicker({ Mode = "Action", Scope = s.Scope, Event = s.Event })
			end)
			removeButton("Remove this trigger and its effects", function()
				s.Scope.Triggers[s.Event] = nil
				state.Selection = { Kind = "Form", Scope = s.Scope }
			end)
			hosted({ "ConfigureEffects" }, if s.Scope == draft then s.Event else rootEvent(s.Scope))
		elseif s.Kind == "Payload" then
			local payload = s.Payload
			local definition = schema.Payloads[payload.Kind] or {}
			inspectSub.Text = eventTitle(s.Event)
			header(
				PayloadIcon[payload.Kind] or "▲",
				CategoryColor[definition.Category] or C.Muted,
				PayloadVerb[payload.Kind] or definition.Label or payload.Kind,
				definition.Description
			)
			if s.Step.Condition then
				note(
					"IF · This effect only runs when its condition passes. Edit the condition in Advanced view; Guided keeps it intact.",
					C.Arcane
				)
			end
			if payload.Kind == "Damage" and (payload.DamageChannel or "Elemental") == "Elemental" then
				note("Elemental damage uses the spell's element: " .. tostring(draft.Element) .. ".")
			end
			section("PROPERTIES")
			fieldGroup(payload, definition.Fields, "payload:" .. payload.Kind)
			section("")
			removeButton("Remove this effect", function()
				local index = table.find(s.Step.Payloads, payload)
				if index then
					table.remove(s.Step.Payloads, index)
				end
				pruneStep(s.Scope, s.Event, s.Step)
				state.Selection = { Kind = "Form", Scope = s.Scope }
			end)
			hosted({ "ConfigureEffects" }, rootEvent(s.Step))
		elseif s.Kind == "Behavior" then
			local step = s.Step
			local definition = schema.Behaviors[step.Behavior] or {}
			inspectSub.Text = eventTitle(s.Event)
			header("*", C.Warn, definition.Label or step.Behavior, definition.Description)
			if step.Condition then
				note("IF · Runs only when its condition passes. Edit the condition in Advanced view.", C.Arcane)
			end
			section("PROPERTIES")
			fieldGroup(step, definition.Fields, "behavior:" .. tostring(step.Behavior))
			section("AFFECTS EVERYTHING INSIDE WITH")
			if #(step.Payloads or {}) == 0 then
				note("Nothing yet — a blast needs at least one effect.", C.Warn)
			end
			for _, payload in step.Payloads or {} do
				local item = pill(
					inspector,
					(PayloadIcon[payload.Kind] or "▲") .. "  " .. (PayloadVerb[payload.Kind] or payload.Kind),
					function()
						select({ Kind = "Payload", Scope = s.Scope, Event = s.Event, Step = step, Payload = payload })
					end
				)
				item.Size, item.LayoutOrder = UDim2.new(1, 0, 0, 36), nextOrder()
				item.TextXAlignment = Enum.TextXAlignment.Left
				pad(item, 12, 0)
			end
			actionButton("+  Add an effect inside", function()
				openPicker({ Mode = "Action", Scope = s.Scope, Event = s.Event, Step = step, Stage = "Options" })
			end)
			removeButton("Remove this blast", function()
				local index = table.find(s.Scope.Triggers[s.Event], step)
				if index then
					table.remove(s.Scope.Triggers[s.Event], index)
				end
				pruneStep(s.Scope, s.Event, nil)
				state.Selection = { Kind = "Form", Scope = s.Scope }
			end)
			hosted({ "ConfigureEffects" }, rootEvent(s.Step))
		elseif s.Kind == "Motion" then
			local behavior = s.Motion
			local definition = ProjectileBehaviorSpec.get(behavior.Kind) or {}
			inspectSub.Text = "While the projectile travels"
			header("»", C.Frost, definition.Label or behavior.Kind, definition.Description)
			section("PROPERTIES")
			fieldGroup(behavior, definition.Fields, "motion:" .. tostring(behavior.Kind))
			removeButton("Remove this movement", function()
				local index = table.find(s.Scope.Projectile.Behaviors, behavior)
				if index then
					table.remove(s.Scope.Projectile.Behaviors, index)
				end
				state.Selection = { Kind = "Form", Scope = s.Scope }
			end)
			hosted({ "ConfigureEffects" }, rootEvent(s.Scope))
		end
	end

	------------------------------------------------------------------ preview
	local previewView = PreviewPanel.mount(previewPanel, draft, schema, payloadSummary)
	local renderPreview, stepAnimation = previewView.render, previewView.step
	local heartbeat = RunService.Heartbeat:Connect(stepAnimation)
	root.Destroying:Connect(function()
		heartbeat:Disconnect()
	end)

	local spawnButton
	do
		local controls = new("Frame", {
			Position = UDim2.new(0, 12, 0.62, -46),
			Size = UDim2.new(1, -24, 0, 40),
			BackgroundTransparency = 1,
			ZIndex = 5,
		}, previewPanel)
		local cast = pill(controls, "▶  Test cast", callbacks.test, "accent")
		cast.Size = UDim2.new(0.5, -4, 1, 0)
		cast.ZIndex = 6
		if callbacks.spawnTarget then
			spawnButton = pill(controls, "■  Spawn target dummy", callbacks.spawnTarget)
		else
			spawnButton = pill(controls, "Target dummies: Studio only", function() end)
			spawnButton.TextColor3 = C.Faint
		end
		spawnButton.Size = UDim2.new(0.5, -4, 1, 0)
		spawnButton.Position = UDim2.new(0.5, 4, 0, 0)
		spawnButton.ZIndex = 6
	end

	------------------------------------------------------------------ status
	local function renderStatus()
		local ok, reason = spec.validate(draft)
		local cost = spec.estimate(draft)
		statusIcon.Text = if ok then "●" else "!"
		statusIcon.TextColor3 = if ok then C.Ok else C.Warn
		statusText.Text = if ok
			then "Ready to test. Every action here is supported by the spell engine."
			else "Needs attention: " .. tostring(reason)
		statusText.TextColor3 = if ok then C.Ok else C.Warn
		manaValue.Text = fmt(cost.ManaDemand or 0)
		strainValue.Text = fmt(cost.Strain or 0)
		complexityValue.Text = fmt(cost.Complexity or 0)
		upkeepValue.Text = fmt(cost.ManaUpkeepPerSecond or 0)
		upkeepHolder.Visible = (cost.ManaUpkeepPerSecond or 0) > 0
		testButton.BackgroundColor3 = if ok then C.Ember else C.Card
		undoButton.TextColor3 = if #state.Undo > 0 then C.Ink else C.Faint
		redoButton.TextColor3 = if #state.Redo > 0 then C.Ink else C.Faint
		if not nameBox:IsFocused() then
			nameBox.Text = draft.Name
		end
	end

	render = function()
		track()
		local live = {}
		collect(draft, live)
		local s = state.Selection
		if
			not live[s.Scope]
			or (s.Step and not live[s.Step])
			or (s.Payload and not live[s.Payload])
			or (s.Motion and not live[s.Motion])
			or (s.Kind == "Trigger" and not (s.Scope.Triggers and s.Scope.Triggers[s.Event]))
		then
			state.Selection = { Kind = "Form", Scope = draft }
		end
		if state.Picker and not live[state.Picker.Scope] then
			state.Picker = nil
		end
		layout()
		renderTree()
		renderInspector()
		local keep = state.InspectorScroll
		if keep then
			task.defer(function()
				inspector.CanvasPosition = keep
			end)
		end
		renderPreview()
		renderStatus()
		renderPicker()
	end

	inspector:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		state.InspectorScroll = inspector.CanvasPosition
	end)
	render()
	return root,
		{
			-- Called by the controller after edits made in hosted editors.
			refresh = function()
				if root.Parent then
					track()
					renderTree()
					renderPreview()
					renderStatus()
				end
			end,
		}
end

-- Spell-wide cards shown only in Advanced. Each hosts controller sections.
local SettingsCards = {
	{
		Id = "Casting",
		Icon = "■",
		Label = "Casting & costs",
		Description = "How the cast starts, channels, interrupts, recovers, and what it costs.",
		Sections = { "Casting", "Cost", "Test" },
	},
	{
		Id = "Targeting",
		Icon = "○",
		Label = "Targeting",
		Description = "Where it aims, who it may affect, range, limits, and proximity.",
		Sections = { "Targeting" },
	},
	{
		Id = "Conditions",
		Icon = "◇",
		Label = "Cast conditions",
		Description = "The full rule tree that decides whether this spell may be cast.",
		Sections = { "Conditions" },
	},
	{
		Id = "Appearance",
		Icon = "▲",
		Label = "Appearance & sound",
		Description = "Colors, materials, particles, trails, impacts, presentation, and audio.",
		Sections = { "Presentation" },
	},
}

function Forge.settingsCard(_draft, _schema, id)
	for _, entry in SettingsCards do
		if entry.Id == id then
			return entry
		end
	end
	return SettingsCards[1]
end

function Forge.settingsCards(draft, schema)
	local casting = draft.Casting or {}
	local rules = draft.TargetRules or {}
	local conditionCount = 0
	if type(draft.Conditions) == "table" then
		for _ in draft.Conditions do
			conditionCount += 1
		end
	end
	local visual = draft.Visual or {}
	local summaries = {
		Casting = string.format(
			"%s · cooldown %ss · cast %ss",
			tostring(casting.Mode or "Instant"),
			tostring(casting.Cooldown or 0),
			tostring(casting.CastTime or 0)
		),
		Targeting = string.format(
			"%s · %s · range %s",
			tostring((schema.TargetingModes[draft.Targeting] or {}).Label or draft.Targeting),
			tostring(rules.Relationship or "Any"),
			tostring(rules.Range or "-")
		),
		Conditions = if conditionCount > 0
			then conditionCount .. " rule" .. (if conditionCount == 1 then "" else "s") .. " guard this cast"
			else "Always castable",
		Appearance = string.format(
			"%s · %s",
			tostring(visual.Palette or visual.Material or "Default look"),
			tostring(draft.Element or "Neutral")
		),
	}
	local cards = {}
	for _, entry in SettingsCards do
		table.insert(cards, {
			Id = entry.Id,
			Icon = entry.Icon,
			Color = if entry.Id == "Conditions" then C.Arcane else C.Gold,
			Title = string.upper(entry.Label),
			Summary = summaries[entry.Id],
			Tag = if entry.Id == "Conditions" and conditionCount > 0 then "IF" else "SPELL",
			TagColor = if entry.Id == "Conditions" then C.Arcane else C.Faint,
		})
	end
	return cards
end

return Forge
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="425">
            <Properties>
              <string name="Name">HUD</string>
            </Properties>
            <Item class="ModuleScript" referent="426">
              <Properties>
                <string name="Name">CombatHUD</string>
                <string name="Source"><![CDATA[--!strict
-- Bottom-centre vitals, stacked just above the spell bar: level badge, Health
-- (widest, with current/max), Mana beneath it, Strain as 10 pips that pulse red
-- near the cap. Also flashes the screen edges when the player takes damage.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local CombatHUD = {}
local Color = Theme.Color

function CombatHUD.new(gui: ScreenGui)
	local player = Players.LocalPlayer
	local root = C.root(gui)
	local health, mana = Theme.Size.HealthBar, Theme.Size.ManaBar
	local cluster = C.new("Frame", {
		Name = "Vitals",
		AnchorPoint = Vector2.new(0.5, 1),
		-- Sits directly above the spell bar (slot height + bottom margin + gap).
		Position = UDim2.new(0.5, 0, 1, -(16 + Theme.Size.Slot + 8)),
		Size = UDim2.fromOffset(health.X + Theme.Size.LevelBadge + 10, 44),
		BackgroundTransparency = 1,
	}, root)

	local badge = C.panel(cluster, {
		Name = "Level",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(Theme.Size.LevelBadge, Theme.Size.LevelBadge),
		Rotation = 0,
	})
	C.new("UIAspectRatioConstraint", { AspectRatio = 1 }, badge)
	C.text(badge, "LV", Theme.TextSize.Tiny, Color.Muted, Theme.Font.Strong, {
		Position = UDim2.fromOffset(0, 3),
		Size = UDim2.new(1, 0, 0, 12),
	})
	local level = C.text(badge, "1", Theme.TextSize.Label + 2, Color.Gold, Theme.Font.Number, {
		Position = UDim2.fromOffset(0, 15),
		Size = UDim2.new(1, 0, 1, -18),
	})

	local x = Theme.Size.LevelBadge + 10
	local healthBar = C.bar(cluster, health, Color.Health, true)
	healthBar.Frame.Position = UDim2.fromOffset(x, 4)
	local manaBar = C.bar(cluster, mana, Color.Mana, false)
	manaBar.Frame.Position = UDim2.fromOffset(x, 4 + health.Y + 5)
	local manaText = C.text(cluster, "", Theme.TextSize.Tiny, Color.Mana, Theme.Font.Number, {
		Position = UDim2.fromOffset(x + mana.X + 6, 4 + health.Y + 2),
		Size = UDim2.fromOffset(health.X - mana.X - 6, 16),
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	-- Strain: segmented meter to the right of the health bar.
	local strain = C.new("Frame", {
		Name = "Strain",
		Position = UDim2.fromOffset(x + health.X + 8, 4),
		Size = UDim2.fromOffset(Theme.Size.StrainPips * 9, health.Y + 16),
		BackgroundTransparency = 1,
	}, cluster)
	local pips: { Frame } = {}
	for index = 1, Theme.Size.StrainPips do
		local pip = C.new("Frame", {
			Position = UDim2.fromOffset((index - 1) * 9, 0),
			Size = UDim2.fromOffset(7, health.Y),
			BackgroundColor3 = Color.Track,
			BackgroundTransparency = Theme.Transparency.Track,
			BorderSizePixel = 0,
		}, strain)
		C.new("UIStroke", { Color = Color.Brass, Transparency = 0.55 }, pip)
		pips[index] = pip
	end
	C.text(strain, "STRAIN", Theme.TextSize.Tiny, Color.Strain, Theme.Font.Strong, {
		Position = UDim2.fromOffset(0, health.Y + 2),
		Size = UDim2.new(1, 0, 0, 13),
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	-- Edge flash on hit: four gradients hugging the screen border.
	local flash = C.new("Frame", {
		Name = "HitFlash",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 0,
	}, gui)
	local edges: { Frame } = {}
	for _, side in { 0, 90, 180, 270 } do
		local vertical = side == 0 or side == 180
		local edge = C.new("Frame", {
			AnchorPoint = Vector2.new(if side == 180 then 1 else 0, if side == 270 then 1 else 0),
			Position = UDim2.fromScale(if side == 180 then 1 else 0, if side == 270 then 1 else 0),
			Size = if vertical then UDim2.fromScale(0.12, 1) else UDim2.fromScale(1, 0.14),
			BackgroundColor3 = Color.Health,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
		}, flash)
		C.new("UIGradient", {
			Rotation = side,
			Transparency = NumberSequence.new(0, 1),
		}, edge)
		edges[#edges + 1] = edge
	end
	-- Rotation per side: 0 fades left→right, 180 right→left, 90 top→bottom, 270 bottom→top.
	local function hit(strength: number)
		for _, edge in edges do
			edge.BackgroundTransparency = math.clamp(1 - strength, 0.35, 0.85)
			TweenService:Create(edge, Theme.Motion.Flash, { BackgroundTransparency = 1 }):Play()
		end
	end

	local lastHealth: number? = nil
	local humanoidLinks: { RBXScriptConnection } = {}
	local function watch(character: Model)
		for _, link in humanoidLinks do
			link:Disconnect()
		end
		table.clear(humanoidLinks)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") then
			return
		end
		lastHealth = humanoid.Health
		local function update()
			local value, maximum = humanoid.Health, math.max(1, humanoid.MaxHealth)
			healthBar.Set(value / maximum, string.format("%d / %d", math.ceil(value), math.ceil(maximum)))
			if lastHealth and value < lastHealth - 0.5 then
				hit(math.clamp((lastHealth - value) / maximum * 4, 0.2, 0.65))
			end
			lastHealth = value
		end
		table.insert(humanoidLinks, humanoid.HealthChanged:Connect(update))
		table.insert(humanoidLinks, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update))
		update()
	end
	player.CharacterAdded:Connect(watch)
	if player.Character then
		task.spawn(watch, player.Character)
	end

	local function updateMana()
		local value, capacity = player:GetAttribute("MagicMana"), player:GetAttribute("MagicCapacity")
		if type(value) == "number" and type(capacity) == "number" and capacity > 0 then
			manaBar.Set(value / capacity)
			manaText.Text = string.format("%d / %d", math.floor(value), math.floor(capacity))
		else
			manaText.Text = "…"
		end
	end
	local strainRatio = 0
	local function updateStrain()
		local value, tolerance = player:GetAttribute("MagicStrain"), player:GetAttribute("MagicStrainTolerance")
		strainRatio = if type(value) == "number"
				and type(tolerance) == "number"
				and tolerance > 0
			then math.clamp(value / tolerance, 0, 1)
			else 0
		local lit = math.ceil(strainRatio * #pips - 0.001)
		for index, pip in pips do
			pip.BackgroundColor3 = if index <= lit then Color.Strain else Color.Track
		end
	end
	for _, name in { "MagicMana", "MagicCapacity" } do
		player:GetAttributeChangedSignal(name):Connect(updateMana)
	end
	for _, name in { "MagicStrain", "MagicStrainTolerance" } do
		player:GetAttributeChangedSignal(name):Connect(updateStrain)
	end
	updateMana()
	updateStrain()

	local visible = true
	RunService.RenderStepped:Connect(function()
		cluster.Visible = visible and player:GetAttribute("MagicLabOpen") ~= true
		if strainRatio >= Theme.Motion.StrainPulseAt then
			local pulse = (math.sin(os.clock() * 8) + 1) / 2
			local tint = Color.Strain:Lerp(Color.StrainHot, pulse)
			for _, pip in pips do
				if pip.BackgroundColor3 ~= Color.Track then
					pip.BackgroundColor3 = tint
				end
			end
		end
	end)

	return {
		SetLevel = function(value: number)
			level.Text = tostring(value)
		end,
		SetVisible = function(value: boolean)
			visible = value
		end,
	}
end

return CombatHUD
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="427">
              <Properties>
                <string name="Name">Components</string>
                <string name="Source"><![CDATA[--!strict
-- Small builders shared by every HUD screen. All looks come from Theme.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Theme = require(script.Parent.Theme)

local C = {}
local Color = Theme.Color

function C.new(className: string, props: { [string]: any }, parent: Instance?): any
	local object = Instance.new(className)
	for key, value in props do
		(object :: any)[key] = value
	end
	if parent then
		object.Parent = parent
	end
	return object
end

function C.screen(name: string, order: number): ScreenGui
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	return C.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		DisplayOrder = order,
	}, playerGui)
end

-- Full-screen root with a UIScale fitted to the viewport (and 10-foot boost on console).
function C.root(gui: ScreenGui): Frame
	local root = C.new("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
	}, gui)
	local scale = C.new("UIScale", {}, root)
	local player = Players.LocalPlayer
	local function update()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		local fit = math.min(viewport.X / Theme.ReferenceSize.X, viewport.Y / Theme.ReferenceSize.Y)
		local setting = player:GetAttribute("UIScaleSetting")
		local user = if type(setting) == "number" then math.clamp(setting, 0.75, 1.5) else 1
		local tenFoot = if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled
			then Theme.TenFootScale
			else 1
		local value = math.clamp(fit * user * tenFoot, Theme.MinScale, Theme.MaxScale)
		scale.Scale = value
		-- The root is authored in reference units; stretch it so Scale children still fill the screen.
		root.Size = UDim2.fromScale(1 / value, 1 / value)
	end
	local function watch()
		local camera = workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		end
		update()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watch)
	player:GetAttributeChangedSignal("UIScaleSetting"):Connect(update)
	watch()
	return root
end

-- Near-black translucent panel, brass hairline, rivets in the corners.
function C.panel(parent: Instance, props: { [string]: any }?): Frame
	local frame = C.new("Frame", {
		BackgroundColor3 = Color.Panel,
		BackgroundTransparency = Theme.Transparency.Panel,
		BorderSizePixel = 0,
	}, parent)
	for key, value in props or {} do
		(frame :: any)[key] = value
	end
	C.new("UICorner", { CornerRadius = UDim.new(0, Theme.Size.Corner) }, frame)
	C.new("UIStroke", {
		Name = "Edge",
		Color = Color.Brass,
		Transparency = Theme.Transparency.Stroke,
		Thickness = Theme.Size.Stroke,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, frame)
	C.new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 0.25),
		}),
		Color = ColorSequence.new(Color3.fromRGB(255, 245, 230), Color3.fromRGB(170, 160, 150)),
	}, frame)
	C.rivets(frame)
	return frame
end

-- Diamond studs on the four corners read as an angled/bevelled metal frame.
function C.rivets(frame: GuiObject)
	local size = Theme.Size.Rivet
	for _, corner in { Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1) } do
		C.new("Frame", {
			Name = "Rivet",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(corner.X, corner.Y),
			Size = UDim2.fromOffset(size, size),
			Rotation = 45,
			BackgroundColor3 = Color.Gold,
			BorderSizePixel = 0,
			ZIndex = frame.ZIndex + 2,
		}, frame)
	end
end

function C.text(
	parent: Instance,
	text: string,
	size: number,
	color: Color3,
	font: Enum.Font?,
	props: { [string]: any }?
): TextLabel
	local label = C.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		TextColor3 = color,
		Font = font or Theme.Font.Body,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
	for key, value in props or {} do
		(label :: any)[key] = value
	end
	return label
end

export type Bar = {
	Frame: Frame,
	Fill: Frame,
	Ghost: Frame,
	Text: TextLabel?,
	Set: (ratio: number, text: string?) -> (),
}

-- Eased bar with a delayed "ghost" chip that drains after damage.
function C.bar(parent: Instance, size: Vector2, color: Color3, withText: boolean): Bar
	local frame = C.new("Frame", {
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = Color.Track,
		BackgroundTransparency = Theme.Transparency.Track,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, parent)
	C.new("UICorner", { CornerRadius = UDim.new(0, 2) }, frame)
	C.new("UIStroke", { Color = Color.Brass, Transparency = 0.5, Thickness = 1 }, frame)
	local ghost = C.new("Frame", {
		Name = "Ghost",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color.Ghost,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
	}, frame)
	local fill = C.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, frame)
	C.new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150)),
	}, fill)
	local label = if withText
		then C.text(frame, "", math.max(11, size.Y - 6), Color.Text, Theme.Font.Number, {
			Size = UDim2.fromScale(1, 1),
			ZIndex = 3,
			TextStrokeTransparency = 0.3,
		})
		else nil
	local current = 1
	local ghostToken = 0
	local bar: Bar = {
		Frame = frame,
		Fill = fill,
		Ghost = ghost,
		Text = label,
		Set = function(ratio: number, text: string?)
			ratio = math.clamp(if ratio == ratio then ratio else 0, 0, 1)
			if label and text then
				label.Text = text
			end
			if math.abs(ratio - current) < 0.0005 then
				return
			end
			local dropped = ratio < current
			current = ratio
			TweenService:Create(fill, Theme.Motion.Bar, { Size = UDim2.fromScale(ratio, 1) }):Play()
			if dropped then
				ghostToken += 1
				local token = ghostToken
				task.delay(Theme.Motion.GhostDelay, function()
					if token == ghostToken then
						TweenService:Create(ghost, Theme.Motion.Ghost, { Size = UDim2.fromScale(current, 1) }):Play()
					end
				end)
			else
				ghost.Size = UDim2.fromScale(ratio, 1)
			end
		end,
	}
	return bar
end

-- Slight scale-up on hover/selection; works for mouse and gamepad focus.
function C.hover(button: GuiButton)
	local scale = button:FindFirstChildOfClass("UIScale") or C.new("UIScale", {}, button)
	local function to(value: number)
		TweenService:Create(scale, Theme.Motion.Hover, { Scale = value }):Play()
	end
	button.MouseEnter:Connect(function()
		to(Theme.Motion.HoverScale)
	end)
	button.MouseLeave:Connect(function()
		to(1)
	end)
	button.SelectionGained:Connect(function()
		to(Theme.Motion.HoverScale)
	end)
	button.SelectionLost:Connect(function()
		to(1)
	end)
end

function C.button(parent: Instance, text: string, props: { [string]: any }?): TextButton
	local button = C.new("TextButton", {
		BackgroundColor3 = Color.PanelRaised,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Active = true,
		Selectable = true,
		Text = text,
		TextColor3 = Color.Gold,
		TextSize = Theme.TextSize.Label,
		Font = Theme.Font.Display,
	}, parent)
	for key, value in props or {} do
		(button :: any)[key] = value
	end
	C.new("UICorner", { CornerRadius = UDim.new(0, Theme.Size.Corner) }, button)
	C.new("UIStroke", {
		Color = Color.Brass,
		Transparency = 0.2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, button)
	C.rivets(button)
	C.hover(button)
	return button
end

return C
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="428">
              <Properties>
                <string name="Name">Lobby</string>
                <string name="Source"><![CDATA[--!strict
-- Centred lobby: large mode cards shown while the player is idle, hidden once
-- they join a match. Also hosts the end-of-mission results card.
-- While visible it holds a UI modal so the cursor stays free (see UIController).
local RunService = game:GetService("RunService")
local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)
local GamepadNav = require(script.Parent.Parent.Kit.GamepadNav)

local Lobby = {}
local Color = Theme.Color
local verbose = RunService:IsStudio()

local function log(...: any)
	if verbose then
		print("[Mission/client]", ...)
	end
end

export type Hooks = {
	Request: (action: string) -> (),
	SetModal: (name: string, open: boolean) -> (),
}

function Lobby.new(gui: ScreenGui, hooks: Hooks)
	local root = C.root(gui)
	local shade = C.new("Frame", {
		Name = "Shade",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Visible = false,
	}, root)
	local panel = C.new("Frame", {
		Name = "Lobby",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(Theme.Size.Card.X * 2 + 40, Theme.Size.Card.Y + 150),
		BackgroundTransparency = 1,
	}, shade)
	C.text(panel, "ENFLESHED", Theme.TextSize.Hero, Color.Gold, Theme.Font.Display, {
		Size = UDim2.new(1, 0, 0, 46),
	})
	C.text(panel, "Choose your battle", Theme.TextSize.Body, Color.Muted, Theme.Font.Body, {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 20),
	})
	local cards = C.new("Frame", {
		Position = UDim2.fromOffset(0, 80),
		Size = UDim2.new(1, 0, 0, Theme.Size.Card.Y),
		BackgroundTransparency = 1,
	}, panel)
	C.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 40),
	}, cards)

	local function card(
		order: number,
		titleText: string,
		body: string,
		actionText: string
	): (Frame, TextButton, TextLabel)
		local frame = C.panel(cards, {
			LayoutOrder = order,
			Size = UDim2.fromOffset(Theme.Size.Card.X, Theme.Size.Card.Y),
		})
		C.new("UIAspectRatioConstraint", { AspectRatio = Theme.Size.Card.X / Theme.Size.Card.Y }, frame)
		C.text(frame, titleText, Theme.TextSize.Title, Color.Gold, Theme.Font.Display, {
			Position = UDim2.fromOffset(14, 10),
			Size = UDim2.new(1, -28, 0, 32),
		})
		local detail = C.text(frame, body, Theme.TextSize.Small, Color.Bone, Theme.Font.Body, {
			Position = UDim2.fromOffset(16, 48),
			Size = UDim2.new(1, -32, 0, 64),
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		local button = C.button(frame, actionText, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -14),
			Size = UDim2.new(1, -40, 0, 48),
			TextSize = Theme.TextSize.Label + 2,
		})
		return frame, button, detail
	end

	local _, begin = card(
		1,
		"Defend the Walls",
		"Hold the Gateway against the Nascent tide. Waves grow, approaches multiply. Repair the gate at the console.",
		"BEGIN MISSION"
	)
	local _, explore = card(
		2,
		"Explore the Keep",
		"Wander the hub, enter the practice gate for the combat sandbox, or forge spells in your Grimoire.",
		"EXPLORE"
	)
	local status = C.text(panel, "", Theme.TextSize.Body, Color.Bone, Theme.Font.Strong, {
		Position = UDim2.fromOffset(0, 80 + Theme.Size.Card.Y + 14),
		Size = UDim2.new(1, 0, 0, 22),
	})
	local hint = C.text(root, "M · MISSIONS", Theme.TextSize.Small, Color.Gold, Theme.Font.Strong, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(200, 18),
		Visible = false,
	})

	-- Results card (end of mission).
	local results = C.panel(root, {
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, 250),
		Visible = false,
	})
	local outcome = C.text(results, "", Theme.TextSize.Title + 4, Color.Gold, Theme.Font.Display, {
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.new(1, 0, 0, 36),
	})
	local earned = C.text(results, "", Theme.TextSize.Body, Color.Text, Theme.Font.Number, {
		Position = UDim2.fromOffset(20, 60),
		Size = UDim2.new(1, -40, 0, 50),
		TextWrapped = true,
	})
	local saved = C.text(results, "", Theme.TextSize.Small, Color.Muted, Theme.Font.Strong, {
		Position = UDim2.fromOffset(20, 116),
		Size = UDim2.new(1, -40, 0, 36),
		TextWrapped = true,
	})
	local replay = C.button(results, "PLAY AGAIN", {
		Position = UDim2.new(0, 20, 1, -70),
		Size = UDim2.new(0.5, -30, 0, 50),
	})
	local hub = C.button(results, "RETURN TO HUB", {
		Position = UDim2.new(0.5, 10, 1, -70),
		Size = UDim2.new(0.5, -30, 0, 50),
	})

	local dismissed = false
	local lastState: any = nil
	local pending: number? = nil
	local actionName = "Start"

	local function setStatus(text: string, color: Color3?)
		status.Text = text
		status.TextColor3 = color or Color.Bone
	end

	local function refreshVisible()
		local message = lastState
		local joined = message ~= nil and message.Joined == true
		local open = not dismissed and not joined and not results.Visible and message ~= nil
		if shade.Visible ~= open then
			shade.Visible = open
			if open then
				GamepadNav.open(panel, function()
					dismissed = true
					refreshVisible()
				end, begin)
			else
				GamepadNav.close(panel)
			end
		end
		hooks.SetModal("Lobby", open)
		hint.Visible = dismissed and not joined and not results.Visible
	end

	local function send(action: string)
		actionName = action
		local token = os.clock()
		pending = token
		begin.Text = "STARTING…"
		setStatus("Starting…", Color.Gold)
		log("click → FireServer", action)
		hooks.Request(action)
		task.delay(5, function()
			if pending == token then
				pending = nil
				begin.Text = "BEGIN MISSION"
				setStatus("No response from the mission server. Check the Output window.", Color.Error)
				warn("[Mission/client] no server reply to", action)
			end
		end)
	end

	begin.Activated:Connect(function()
		log("Begin button activated; label =", begin.Text)
		local state = lastState and lastState.State
		send(
			if state == "PREPARING" or state == "ACTIVE"
				then "Join"
				elseif state == "READY_FOR_REPLAY" then "Replay"
				else "Start"
		)
	end)
	explore.Activated:Connect(function()
		dismissed = true
		refreshVisible()
	end)
	replay.Activated:Connect(function()
		replay.Text = "READY"
		hooks.Request("Replay")
	end)
	local function goHub()
		hooks.Request("Hub")
		results.Visible = false
		GamepadNav.close(results)
		hooks.SetModal("Results", false)
		refreshVisible()
	end
	hub.Activated:Connect(goHub)

	return {
		Toggle = function()
			if lastState and lastState.Joined then
				return
			end
			dismissed = not dismissed
			refreshVisible()
		end,
		Notice = function(text: string)
			pending = nil
			begin.Text = "BEGIN MISSION"
			setStatus(text, Color.Error)
		end,
		Ack = function(message: any)
			pending = nil
			log("server ack", message.Action, message.Ok, message.Text)
			if message.Ok then
				setStatus(message.Text or "Mission starting", Color.Ok)
			else
				begin.Text = "BEGIN MISSION"
				setStatus(message.Text or "Could not start the mission", Color.Error)
			end
		end,
		State = function(message: any)
			local state = message.State
			lastState = message
			if message.Joined then
				dismissed = false
				if pending then
					pending = nil
					log("mission joined; state", state, "after", actionName)
				end
			end
			if state == "PREPARING" and message.Joined and results.Visible then
				results.Visible = false
				GamepadNav.close(results)
				hooks.SetModal("Results", false)
			end
			if not pending then
				begin.Text = if state == "PREPARING" or state == "ACTIVE"
					then "JOIN DEFENSE"
					elseif state == "READY_FOR_REPLAY" then "PLAY AGAIN"
					else "BEGIN MISSION"
				if status.TextColor3 ~= Color.Error then
					setStatus(
						if state == "ACTIVE" or state == "PREPARING"
							then string.format("A defense is under way · %d defending", message.Participants or 0)
							else ""
					)
				end
			end
			refreshVisible()
		end,
		Result = function(message: any, nextText: string)
			outcome.Text = if message.Victory then "GATEWAY HELD" else "GATEWAY LOST"
			outcome.TextColor3 = if message.Victory then Color.Gold else Color.Health
			local reward = message.Reward or {}
			earned.Text = string.format(
				"+%d XP  ·  +%d MARKS\n%d KILLS  ·  %d REPAIRS  ·  %d DEATHS",
				reward.XP or 0,
				reward.Marks or 0,
				reward.Kills or 0,
				reward.Repairs or 0,
				reward.Deaths or 0
			)
			saved.Text = nextText
			replay.Text = "PLAY AGAIN"
			results.Visible = true
			hooks.SetModal("Results", true)
			GamepadNav.open(results, goHub, replay)
			refreshVisible()
		end,
	}
end

return Lobby
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="429">
              <Properties>
                <string name="Name">MissionTracker</string>
                <string name="Source"><![CDATA[--!strict
-- Compact top-centre banner (mode, phase, timer, active wall "WALL 2 / 3" with its
-- HP bar, Gateway (final doors) HP bar, defender + guard and enemy counters) plus the thin XP bar along the very bottom edge.
local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local MissionTracker = {}
local Color = Theme.Color

-- Pure: total XP → (level, xp into level, xp needed). Matches the old mission panel curve.
function MissionTracker.level(totalXP: number): (number, number, number)
	local xp, level, threshold = math.max(0, totalXP), 1, 100
	while level < 100 and xp >= threshold do
		xp -= threshold
		level += 1
		threshold = 100 + (level - 1) * 50
	end
	return level, xp, threshold
end

function MissionTracker.new(gui: ScreenGui)
	local root = C.root(gui)
	local size = Theme.Size.Banner
	local banner = C.panel(root, {
		Name = "MissionBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(size.X, size.Y),
		Visible = false,
	})
	local title = C.text(banner, "DEFEND THE WALLS", Theme.TextSize.Body, Color.Gold, Theme.Font.Display, {
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(0.5, -12, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local phase = C.text(banner, "", Theme.TextSize.Small, Color.Bone, Theme.Font.Strong, {
		Position = UDim2.new(0.5, 0, 0, 5),
		Size = UDim2.new(0.5, -70, 0, 16),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local timer = C.text(banner, "00:00", Theme.TextSize.Label, Color.Text, Theme.Font.Number, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 3),
		Size = UDim2.fromOffset(56, 20),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	-- Active wall row, then the final doors ("Gateway") row.
	local wallLabel = C.text(banner, "WALL 1 / 3", Theme.TextSize.Tiny, Color.Gold, Theme.Font.Strong, {
		Position = UDim2.fromOffset(12, 26),
		Size = UDim2.fromOffset(78, 14),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local wall = C.bar(banner, Vector2.new(size.X - 230, 12), Color.Gold, true)
	wall.Frame.Position = UDim2.fromOffset(92, 27)
	local gate = C.bar(banner, Vector2.new(size.X - 230, 12), Color.Bone, true)
	gate.Frame.Position = UDim2.fromOffset(92, 44)
	C.text(banner, "GATEWAY", Theme.TextSize.Tiny, Color.Muted, Theme.Font.Strong, {
		Position = UDim2.fromOffset(12, 43),
		Size = UDim2.fromOffset(78, 14),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local repairs = C.text(banner, "", Theme.TextSize.Tiny, Color.Muted, Theme.Font.Number, {
		Position = UDim2.fromOffset(12, 60),
		Size = UDim2.fromOffset(160, 14),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local function counter(icon: string, tint: Color3, x: number): TextLabel
		C.text(banner, icon, Theme.TextSize.Body, tint, Theme.Font.Strong, {
			Position = UDim2.new(1, x, 0, 26),
			Size = UDim2.fromOffset(18, 18),
		})
		return C.text(banner, "0", Theme.TextSize.Body, Color.Text, Theme.Font.Number, {
			Position = UDim2.new(1, x + 18, 0, 26),
			Size = UDim2.fromOffset(44, 18),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
	end
	local defenders = counter("⛨", Color.Ally, -128)
	local enemies = counter("☠", Color.Health, -62)
	local warning = C.text(root, "", Theme.TextSize.Label, Color.Error, Theme.Font.Display, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10 + size.Y + 6),
		Size = UDim2.fromOffset(size.X, 22),
		TextStrokeTransparency = 0.2,
	})

	-- Thin XP bar on the very bottom edge.
	local xpBar = C.bar(root, Vector2.new(0, Theme.Size.XPBar), Color.Gold, false)
	xpBar.Frame.AnchorPoint = Vector2.new(0, 1)
	xpBar.Frame.Position = UDim2.fromScale(0, 1)
	xpBar.Frame.Size = UDim2.new(1, 0, 0, Theme.Size.XPBar)
	local xpText = C.text(root, "", Theme.TextSize.Tiny, Color.Gold, Theme.Font.Number, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -Theme.Size.XPBar - 2),
		Size = UDim2.fromOffset(300, 14),
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	local warningToken = 0
	return {
		Warn = function(text: string, seconds: number?)
			warningToken += 1
			local token = warningToken
			warning.Text = text
			task.delay(seconds or 4, function()
				if token == warningToken then
					warning.Text = ""
				end
			end)
		end,
		-- Returns the player's level so the vitals badge can show it.
		Update = function(message: any): number?
			local state = message.State
			banner.Visible = message.Joined == true and (state == "PREPARING" or state == "ACTIVE")
			title.Text = string.upper((string.gsub(tostring(message.Mode or "DefendTheWalls"), "(%l)(%u)", "%1 %2")))
			phase.Text = string.upper(tostring(message.PhaseName or state or ""))
				.. (if message.Phase then "  ·  WAVE " .. tostring(message.Phase) else "")
			local remaining = tonumber(message.Remaining) or 0
			timer.Text = string.format("%02d:%02d", math.floor(remaining / 60), remaining % 60)
			local count = message.WallCount or 3
			local level = message.WallLevel or 1
			if level > count then
				wallLabel.Text = "FINAL GATE"
				wall.Set(0, "BREACHED")
			else
				wallLabel.Text = string.format("WALL %d / %d", level, count)
				local hp, top = message.WallHP or 0, math.max(1, message.WallMax or 1)
				wall.Set(hp / top, string.format("%d / %d", math.ceil(hp), top))
			end
			local gateway, maximum = message.Gateway or 0, math.max(1, message.GatewayMax or 1)
			gate.Set(gateway / maximum, string.format("%d / %d", math.ceil(gateway), maximum))
			repairs.Text = string.format("REPAIRS %d", message.Repairs or 0)
			-- Players, plus living guards when the squad is out.
			defenders.Text = tostring(message.Participants or 0)
				.. (if (message.GuardsAlive or 0) > 0 then "+" .. tostring(message.GuardsAlive) else "")
			enemies.Text = tostring(message.Enemies or 0)
			local profile = message.Profile
			if type(profile) ~= "table" then
				return nil
			end
			local playerLevel, xp, needed = MissionTracker.level(profile.XP or 0)
			xpBar.Set(xp / needed)
			xpText.Text = string.format(
				"LV %d  ·  %d / %d XP  ·  %d MARKS%s",
				playerLevel,
				xp,
				needed,
				profile.Marks or 0,
				if message.SaveAvailable == false then "  ·  SAVE UNAVAILABLE" else ""
			)
			return playerLevel
		end,
	}
end

return MissionTracker
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="430">
              <Properties>
                <string name="Name">SpellBar</string>
                <string name="Source"><![CDATA[--!strict
-- Bottom-centre hotbar: [melee combo] [spell slots 1–6] [spellbook] [consumable].
-- Slots show glyph, keybind, mana cost, cooldown sweep and selection. Grimoire
-- library cards can be dragged onto any unlocked slot to equip them.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)
local SpellState = require(script.Parent.SpellState)
local InputMode = require(script.Parent.Parent.Kit.InputMode)

local SpellBar = {}
local Color = Theme.Color
local DragThreshold = 8

local function glyph(name: string): string
	local letters = {}
	for word in string.gmatch(name, "%a+") do
		table.insert(letters, string.upper(string.sub(word, 1, 1)))
		if #letters == 2 then
			break
		end
	end
	return if #letters > 0 then table.concat(letters) else "◆"
end

type Slot = {
	Button: TextButton,
	Glyph: TextLabel,
	Key: TextLabel,
	Cost: TextLabel,
	Sweep: Frame,
	Seconds: TextLabel,
	Stroke: UIStroke,
	Dim: Frame,
}

function SpellBar.new(gui: ScreenGui, openSpellbook: () -> ())
	local player = Players.LocalPlayer
	local root = C.root(gui)
	local size, gap = Theme.Size.Slot, Theme.Size.SlotGap
	local count = Theme.Size.SlotsShown
	local row = C.new("Frame", {
		Name = "SpellBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(0, size),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
	}, root)
	C.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, row)

	-- Melee combo (3 pips) on the left end.
	local combo = C.panel(row, { Name = "Combo", LayoutOrder = 0, Size = UDim2.fromOffset(62, size) })
	C.text(combo, "COMBO", Theme.TextSize.Tiny, Color.Muted, Theme.Font.Strong, {
		Position = UDim2.fromOffset(0, 4),
		Size = UDim2.new(1, 0, 0, 12),
	})
	local pips: { Frame } = {}
	for index = 1, 3 do
		local pip = C.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, (index - 2) * 17, 0, 30),
			Size = UDim2.fromOffset(11, 11),
			Rotation = 45,
			BackgroundColor3 = Color.Track,
			BorderSizePixel = 0,
		}, combo)
		C.new("UIStroke", { Color = Color.Brass, Transparency = 0.3 }, pip)
		pips[index] = pip
	end
	local dash = C.text(combo, "", Theme.TextSize.Tiny, Color.Bone, Theme.Font.Number, {
		Position = UDim2.new(0, 0, 1, -15),
		Size = UDim2.new(1, 0, 0, 12),
	})

	local slots: { Slot } = {}
	for index = 1, count do
		local button = C.new("TextButton", {
			Name = "Slot" .. index,
			LayoutOrder = index,
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = Color.Panel,
			BackgroundTransparency = Theme.Transparency.Panel,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			Selectable = false,
		}, row)
		C.new("UIAspectRatioConstraint", { AspectRatio = 1 }, button)
		C.new("UICorner", { CornerRadius = UDim.new(0, Theme.Size.Corner) }, button)
		local stroke = C.new("UIStroke", {
			Color = Color.Brass,
			Transparency = Theme.Transparency.Stroke,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, button)
		C.rivets(button)
		C.hover(button)
		local glyphLabel = C.text(button, "+", Theme.TextSize.Title, Color.Faint, Theme.Font.Display, {
			Size = UDim2.fromScale(1, 1),
		})
		local sweep = C.new("Frame", {
			Name = "Cooldown",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			ZIndex = 3,
		}, button)
		local seconds = C.text(button, "", Theme.TextSize.Label, Color.Text, Theme.Font.Number, {
			Size = UDim2.fromScale(1, 1),
			ZIndex = 4,
			TextStrokeTransparency = 0.2,
		})
		local dim = C.new("Frame", {
			Name = "NoMana",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(40, 40, 48),
			BackgroundTransparency = 0.45,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 2,
		}, button)
		local key = C.text(button, Theme.SlotKeys[index], Theme.TextSize.Tiny, Color.Bone, Theme.Font.Number, {
			Position = UDim2.fromOffset(3, 1),
			Size = UDim2.fromOffset(22, 13),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 5,
		})
		local cost = C.text(button, "", Theme.TextSize.Tiny, Color.Mana, Theme.Font.Number, {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -3, 1, -1),
			Size = UDim2.fromOffset(30, 13),
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 5,
		})
		button.Activated:Connect(function()
			if not SpellState.Slots[index] and index <= SpellState.SlotLimit then
				openSpellbook()
			end
		end)
		slots[index] = {
			Button = button,
			Glyph = glyphLabel,
			Key = key,
			Cost = cost,
			Sweep = sweep,
			Seconds = seconds,
			Stroke = stroke,
			Dim = dim,
		}
	end

	local book = C.button(row, "✦", {
		Name = "Spellbook",
		LayoutOrder = count + 1,
		Size = UDim2.fromOffset(30, size),
		TextSize = Theme.TextSize.Label,
		Font = Theme.Font.Strong,
	})
	book.Activated:Connect(openSpellbook)

	-- Quick consumable slots (Y, U) on the right end.
	type Quick = { Key: TextLabel, Name: TextLabel, Count: TextLabel }
	local quicks: { Quick } = {}
	for index = 1, 2 do
		local quick = C.panel(row, {
			Name = "Consumable" .. index,
			LayoutOrder = count + 1 + index,
			Size = UDim2.fromOffset(size + 34, size),
		})
		quicks[index] = {
			Key = C.text(quick, "", Theme.TextSize.Tiny, Color.Gold, Theme.Font.Number, {
				Position = UDim2.fromOffset(4, 3),
				Size = UDim2.new(1, -8, 0, 13),
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Name = C.text(quick, "Empty", Theme.TextSize.Tiny, Color.Faint, Theme.Font.Body, {
				Position = UDim2.fromOffset(4, 17),
				Size = UDim2.new(1, -8, 0, 22),
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
			}),
			Count = C.text(quick, "", Theme.TextSize.Small, Color.Bone, Theme.Font.Number, {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -4, 1, -2),
				Size = UDim2.fromOffset(40, 15),
				TextXAlignment = Enum.TextXAlignment.Right,
			}),
		}
	end

	-- Active weapon (E switches) on the far left.
	local weapon = C.panel(row, { Name = "Weapon", LayoutOrder = -1, Size = UDim2.fromOffset(size + 46, size) })
	C.text(weapon, "[E] WEAPON", Theme.TextSize.Tiny, Color.Gold, Theme.Font.Number, {
		Position = UDim2.fromOffset(4, 3),
		Size = UDim2.new(1, -8, 0, 13),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local weaponName = C.text(weapon, "Unarmed", Theme.TextSize.Tiny, Color.Faint, Theme.Font.Body, {
		Position = UDim2.fromOffset(4, 17),
		Size = UDim2.new(1, -8, 1, -20),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	})

	-- Drag ghost that follows the pointer while dragging a Grimoire card.
	local ghost = C.panel(gui, {
		Name = "DragGhost",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		Visible = false,
		ZIndex = 20,
	})
	local ghostText = C.text(ghost, "", Theme.TextSize.Title, Color.Gold, Theme.Font.Display, {
		Size = UDim2.fromScale(1, 1),
		ZIndex = 21,
	})

	local function slotUnder(point: Vector2): number?
		for index, slot in slots do
			local at, extent = slot.Button.AbsolutePosition, slot.Button.AbsoluteSize
			if point.X >= at.X and point.X <= at.X + extent.X and point.Y >= at.Y and point.Y <= at.Y + extent.Y then
				return index
			end
		end
		return nil
	end

	local function refresh()
		local gamepad = InputMode.get() == "Gamepad"
		for index, slot in slots do
			local info = SpellState.Slots[index]
			local locked = index > SpellState.SlotLimit
			local selected = gamepad and SpellState.Selected == index and info ~= nil
			slot.Key.Text = if gamepad then (if selected then Theme.GamepadCastGlyph else "") else Theme.SlotKeys[index]
			if info then
				slot.Glyph.Text = glyph(info.Name)
				slot.Glyph.TextColor3 = info.Color or Color.Gold
				slot.Cost.Text = if info.ManaCost > 0 then tostring(math.floor(info.ManaCost)) else ""
			else
				slot.Glyph.Text = if locked then "✕" else "+"
				slot.Glyph.TextColor3 = Color.Faint
				slot.Cost.Text = ""
			end
			slot.Button.BackgroundTransparency = if locked then 0.6 else Theme.Transparency.Panel
			slot.Stroke.Color = if selected then Color.Gold else Color.Brass
			slot.Stroke.Thickness = if selected then 2 else 1
			slot.Stroke.Transparency = if selected then 0 else Theme.Transparency.Stroke
		end
	end
	SpellState.Changed:Connect(refresh)
	InputMode.Changed:Connect(refresh)
	refresh()

	local releaseConnection = UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end
		local drag = SpellState.Drag
		if not drag then
			return
		end
		if drag.Active then
			local target = slotUnder(UserInputService:GetMouseLocation())
			if target and target <= SpellState.SlotLimit then
				SpellState.equip(drag.Id, target)
			end
		end
		SpellState.endDrag()
	end)

	local visible = true
	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		local mana = player:GetAttribute("MagicMana")
		local drag = SpellState.Drag
		local pointer = UserInputService:GetMouseLocation()
		if drag and not drag.Active and (pointer - drag.Start).Magnitude >= DragThreshold then
			drag.Active = true
			ghostText.Text = glyph(drag.Name)
			ghostText.TextColor3 = drag.Color or Color.Gold
		end
		local dragging = drag ~= nil and drag.Active
		-- While the Grimoire is open the bar only appears as a drop target.
		row.Visible = visible and (player:GetAttribute("MagicLabOpen") ~= true or dragging)
		ghost.Visible = dragging
		if dragging then
			ghost.Position = UDim2.fromOffset(pointer.X, pointer.Y)
		end
		local hovered = if dragging then slotUnder(pointer) else nil
		for index, slot in slots do
			local info = SpellState.Slots[index]
			local ends = SpellState.CooldownEnds[index]
			local remaining = if ends then ends - now else 0
			if info and remaining > 0 and info.Cooldown > 0 then
				slot.Sweep.Size = UDim2.fromScale(1, math.clamp(remaining / info.Cooldown, 0, 1))
				slot.Seconds.Text = if remaining >= 10
					then string.format("%d", math.ceil(remaining))
					else string.format("%.1f", remaining)
			else
				slot.Sweep.Size = UDim2.fromScale(1, 0)
				slot.Seconds.Text = ""
			end
			slot.Dim.Visible = info ~= nil and type(mana) == "number" and mana < info.ManaCost
			if hovered == index then
				slot.Stroke.Color = if index <= SpellState.SlotLimit then Color.Ok else Color.Error
				slot.Stroke.Thickness = 2
			elseif dragging then
				slot.Stroke.Color = Color.Brass
				slot.Stroke.Thickness = 1
			end
		end
	end)

	return {
		Root = root,
		SetVisible = function(value: boolean)
			visible = value
		end,
		UpdateCombo = function(step: number, dashCooldown: number)
			for index, pip in pips do
				pip.BackgroundColor3 = if step > 0 and index <= step then Color.Gold else Color.Track
			end
			dash.Text = if dashCooldown > 0 then string.format("Q %.1f", dashCooldown) else ""
		end,
		SetConsumable = function(index: number, keyText: string, name: string?, amount: number?)
			local quick = quicks[index]
			if not quick then
				return
			end
			quick.Key.Text = "[" .. keyText .. "]"
			quick.Name.Text = name or "Empty"
			quick.Name.TextColor3 = if name then Color.Text else Color.Faint
			quick.Count.Text = if amount and amount > 1 then "×" .. amount else ""
		end,
		SetWeapon = function(name: string?, color: Color3?)
			weaponName.Text = name or "Unarmed"
			weaponName.TextColor3 = if name then color or Color.Text else Color.Faint
		end,
		Destroy = function()
			releaseConnection:Disconnect()
		end,
	}
end

return SpellBar
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="431">
              <Properties>
                <string name="Name">SpellState</string>
                <string name="Source"><![CDATA[--!strict
-- Client mirror of the equipped spell slots for the HUD spell bar, plus the
-- drag-and-drop hand-off from Grimoire library cards to open bar slots.
-- Server owns slots: equipping goes through MagicLabRequest("Library", Equip).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Slots = require(Shared.Modules.MagicSlots)

local State = {}
local changed = Instance.new("BindableEvent")
State.Changed = changed.Event

export type SlotInfo = {
	Name: string,
	Element: string?,
	Color: Color3?,
	ManaCost: number,
	Cooldown: number,
	SpellId: string?,
}
State.Slots = {} :: { [number]: SlotInfo }
State.SlotLimit = 4
State.Selected = 1
State.CooldownEnds = {} :: { [number]: number }
State.Drag = nil :: { Id: string, Name: string, Color: Color3?, Start: Vector2, Active: boolean }?

local costCache: { [any]: number } = setmetatable({}, { __mode = "k" }) :: any
local function manaCost(definition: any): number
	local cached = costCache[definition]
	if cached then
		return cached
	end
	local ok, cost = pcall(function()
		local Spec = require(Shared.Modules.SpellSpec)
		return Spec.estimate(definition).ManaDemand
	end)
	local value = if ok and type(cost) == "number" then cost else 0
	costCache[definition] = value
	return value
end

local function describe(definition: any): SlotInfo?
	if type(definition) ~= "table" then
		return nil
	end
	local visual = definition.Visual
	return {
		Name = tostring(definition.Name or "Spell"),
		Element = definition.Element,
		Color = if visual and typeof(visual.Color) == "Color3" then visual.Color else nil,
		ManaCost = manaCost(definition),
		Cooldown = if definition.Casting and type(definition.Casting.Cooldown) == "number"
			then definition.Casting.Cooldown
			else 0,
		SpellId = definition.SpellId,
	}
end

local request: RemoteEvent? = nil

function State.equip(libraryId: string, slot: number)
	if request and slot >= 1 and slot <= State.SlotLimit then
		request:FireServer("Library", { Action = "Equip", Id = libraryId, Slot = slot })
	end
end

-- Called by a Grimoire library card on press; becomes a drag once the pointer moves.
function State.pressCard(libraryId: string, definition: any)
	local location = UserInputService:GetMouseLocation()
	local info = describe(definition)
	State.Drag = {
		Id = libraryId,
		Name = if info then info.Name else "Spell",
		Color = if info then info.Color else nil,
		Start = location,
		Active = false,
	}
end

function State.endDrag()
	State.Drag = nil
	changed:Fire("Drag")
end

function State.start()
	local player = Players.LocalPlayer
	local remotes = Shared:WaitForChild("SandboxRemotes")
	request = remotes:WaitForChild("MagicLabRequest", 15) :: RemoteEvent?
	local response = remotes:WaitForChild("GrimoireResponse", 15) :: RemoteEvent?
	local feedback = remotes:WaitForChild("ActionFeedback", 15) :: RemoteEvent?
	if response then
		response.OnClientEvent:Connect(function(_, _, catalog, slots)
			if type(catalog) == "table" then
				if catalog.Unrestricted then
					State.SlotLimit = Slots.Count
				elseif type(catalog.Progression) == "table" then
					local ok, limit = pcall(function()
						return require(Shared.Modules.SpellProgressionRules).slots(catalog.Progression)
					end)
					if ok and type(limit) == "number" then
						State.SlotLimit = limit
					end
				end
			end
			if type(slots) == "table" then
				for slot = 1, Slots.Count do
					State.Slots[slot] = describe(slots[tostring(slot)])
				end
			end
			changed:Fire("Slots")
		end)
	end
	if feedback then
		feedback.OnClientEvent:Connect(function(message)
			if type(message) ~= "table" or message.Kind ~= "Magic" or message.Result == "IMPOSSIBLE" then
				return
			end
			for slot, info in State.Slots do
				if info.SpellId and info.SpellId == message.SpellId and info.Cooldown > 0 then
					State.CooldownEnds[slot] = os.clock() + info.Cooldown
				end
			end
		end)
	end
	local function selected()
		local value = player:GetAttribute("GamepadSpellSlot")
		State.Selected = if type(value) == "number" then value else 1
		changed:Fire("Selected")
	end
	player:GetAttributeChangedSignal("GamepadSpellSlot"):Connect(selected)
	selected()
	-- Load the library so the bar shows equipped spells before the Grimoire is ever opened.
	if request then
		request:FireServer("Load")
	end
end

return State
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="432">
              <Properties>
                <string name="Name">Theme</string>
                <string name="Source"><![CDATA[--!strict
-- Single source of truth for the in-game HUD look: colors, fonts, sizes, motion.
-- Dark fantasy: near-black translucent panels, thin brass strokes, rivet corners.
local Theme = {}

Theme.Color = {
	Panel = Color3.fromRGB(10, 8, 11),
	PanelRaised = Color3.fromRGB(22, 18, 22),
	Track = Color3.fromRGB(28, 22, 26),
	Brass = Color3.fromRGB(176, 142, 82),
	Bone = Color3.fromRGB(226, 214, 186),
	Gold = Color3.fromHex("E8C77A"),
	Text = Color3.fromRGB(240, 230, 210),
	Muted = Color3.fromRGB(150, 138, 124),
	Faint = Color3.fromRGB(92, 82, 78),
	Health = Color3.fromHex("C8323C"),
	Mana = Color3.fromHex("3C8CFF"),
	Strain = Color3.fromHex("FF8A2A"),
	StrainHot = Color3.fromRGB(255, 52, 40),
	Ghost = Color3.fromRGB(255, 226, 190),
	Ok = Color3.fromRGB(122, 204, 142),
	Error = Color3.fromRGB(236, 96, 88),
	Ally = Color3.fromRGB(139, 205, 237),
}

Theme.Transparency = {
	Panel = 0.25,
	Stroke = 0.35,
	Track = 0.15,
}

Theme.Font = {
	Display = Enum.Font.Fantasy,
	Body = Enum.Font.GothamMedium,
	Strong = Enum.Font.GothamBold,
	-- Monospaced digits keep counters from jittering as values change.
	Number = Enum.Font.RobotoMono,
}

Theme.TextSize = { Tiny = 11, Small = 13, Body = 15, Label = 18, Title = 26, Hero = 40 }

-- Layout sizes are authored at Theme.ReferenceSize; a UIScale per screen does the rest.
Theme.ReferenceSize = Vector2.new(1280, 720)
Theme.Size = {
	Corner = 3,
	Stroke = 1,
	Rivet = 5,
	HealthBar = Vector2.new(420, 20),
	ManaBar = Vector2.new(340, 11),
	StrainPips = 10,
	Slot = 54,
	SlotGap = 6,
	SlotsShown = 6,
	LevelBadge = 46,
	XPBar = 5,
	Banner = Vector2.new(460, 78),
	Card = Vector2.new(300, 190),
}

-- Gamepad-only players sit across the room: scale everything up a step.
Theme.TenFootScale = 1.2
Theme.MinScale = 0.65
Theme.MaxScale = 1.6

Theme.Motion = {
	Bar = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	GhostDelay = 0.45,
	Ghost = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
	Hover = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	HoverScale = 1.06,
	Flash = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	StrainPulseAt = 0.8,
}

-- Hotbar keybinds by input mode (gamepad casts the selected slot with RB).
Theme.SlotKeys = { "1", "2", "3", "4", "5", "6" }
Theme.GamepadCastGlyph = "RB"

return Theme
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="433">
              <Properties>
                <string name="Name">WorldUI</string>
                <string name="Source"><![CDATA[--!strict
-- World-space presentation: themed ProximityPrompts and client-only target
-- health bars (shown only when the target is on screen and unobstructed).
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local WorldUI = {}
local Color = Theme.Color
local player = Players.LocalPlayer

local function keyText(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): string
	if inputType == Enum.ProximityPromptInputType.Gamepad then
		return (string.gsub(prompt.GamepadKeyCode.Name, "^Button", ""))
	elseif inputType == Enum.ProximityPromptInputType.Touch then
		return "TAP"
	end
	return prompt.KeyboardKeyCode.Name
end

local function startPrompts(container: Instance)
	local function adopt(prompt: Instance)
		if prompt:IsA("ProximityPrompt") then
			prompt.Style = Enum.ProximityPromptStyle.Custom
		end
	end
	for _, prompt in workspace:GetDescendants() do
		adopt(prompt)
	end
	workspace.DescendantAdded:Connect(adopt)

	ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
			return
		end
		local board = C.new("BillboardGui", {
			Name = "ThemedPrompt",
			Adornee = prompt.Parent,
			AlwaysOnTop = true,
			Size = UDim2.fromOffset(250, 52),
			StudsOffset = Vector3.new(0, 2.6, 0),
			Active = true,
			ResetOnSpawn = false,
		}, container)
		local frame = C.panel(board, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
		C.new("UIScale", { Scale = 0.85 }, frame)
		local key = C.new("TextButton", {
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.fromOffset(36, 36),
			BackgroundColor3 = Color.PanelRaised,
			Text = keyText(prompt, inputType),
			TextColor3 = Color.Gold,
			Font = Theme.Font.Number,
			TextSize = Theme.TextSize.Label,
			TextScaled = false,
			AutoButtonColor = true,
		}, frame)
		C.new("UICorner", { CornerRadius = UDim.new(0, 3) }, key)
		C.new("UIStroke", { Color = Color.Gold, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, key)
		local hold = C.new("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = Color.Gold,
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
		}, key)
		C.text(frame, prompt.ActionText, Theme.TextSize.Body, Color.Text, Theme.Font.Strong, {
			Position = UDim2.fromOffset(52, 7),
			Size = UDim2.new(1, -60, 0, 20),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		C.text(frame, prompt.ObjectText, Theme.TextSize.Small, Color.Muted, Theme.Font.Body, {
			Position = UDim2.fromOffset(52, 27),
			Size = UDim2.new(1, -60, 0, 16),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		-- Touch / click: drive the prompt directly.
		key.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				prompt:InputHoldBegin()
			end
		end)
		key.InputEnded:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				prompt:InputHoldEnd()
			end
		end)
		local holding: Tween? = nil
		local links = {
			prompt.PromptButtonHoldBegan:Connect(function()
				holding =
					TweenService:Create(hold, TweenInfo.new(prompt.HoldDuration), { Size = UDim2.fromScale(1, 1) })
				if holding then
					holding:Play()
				end
			end),
			prompt.PromptButtonHoldEnded:Connect(function()
				if holding then
					holding:Cancel()
				end
				hold.Size = UDim2.fromScale(1, 0)
			end),
			prompt.Triggered:Connect(function()
				hold.Size = UDim2.fromScale(1, 0)
			end),
		}
		prompt.PromptHidden:Once(function()
			for _, link in links do
				link:Disconnect()
			end
			board:Destroy()
		end)
	end)
end

local function healthTint(ratio: number): Color3
	return Color.Health:Lerp(Color3.fromRGB(214, 168, 70), math.clamp((ratio - 0.25) * 1.5, 0, 1))
end

local function resolveModel(instance: Instance): Model?
	if instance:IsA("Model") and instance:FindFirstChildOfClass("Humanoid") then
		return instance
	end
	local ancestor = instance:FindFirstAncestorOfClass("Model")
	if ancestor and ancestor:FindFirstChildOfClass("Humanoid") then
		return ancestor
	end
	return nil
end

local function relationship(model: Model): string?
	local ownerId = model:GetAttribute("MagicSummonOwnerUserId")
	if type(ownerId) == "number" then
		local owner = Players:GetPlayerByUserId(ownerId)
		if owner then
			if owner == player then
				return "Ally"
			end
			if player.Team and owner.Team then
				return if player.Team == owner.Team then "Ally" else "Enemy"
			end
			return "Enemy"
		end
	end
	local alignment = model:GetAttribute("SandboxAlignment") or model:GetAttribute("MagicAlignment")
	if alignment == "Ally" or alignment == "Enemy" then
		return alignment
	end
	if CollectionService:HasTag(model, "MagicAllyTarget") then
		return "Ally"
	end
	if CollectionService:HasTag(model, "MagicHostileTarget") then
		return "Enemy"
	end
	local targetPlayer = Players:GetPlayerFromCharacter(model)
	if targetPlayer then
		if targetPlayer == player then
			return nil
		end
		if player.Team and targetPlayer.Team then
			return if player.Team == targetPlayer.Team then "Ally" else "Enemy"
		end
		return "Enemy"
	end
	return nil
end

local function candidates(): { Model }
	local found: { [Model]: boolean } = {}
	local result = {}
	local function add(instance: Instance)
		local model = resolveModel(instance)
		if model and not found[model] and relationship(model) then
			found[model] = true
			table.insert(result, model)
		end
	end
	for _, tag in { "MagicHostileTarget", "MagicAllyTarget" } do
		for _, instance in CollectionService:GetTagged(tag) do
			add(instance)
		end
	end
	for _, other in Players:GetPlayers() do
		if other.Character then
			add(other.Character)
		end
	end
	local summons = workspace:FindFirstChild("MagicSummons")
	if summons then
		for _, model in summons:GetChildren() do
			add(model)
		end
	end
	return result
end

local function targetBar(model: Model, humanoid: Humanoid, anchor: BasePart, alignment: string): BillboardGui
	local gui = C.new("BillboardGui", {
		Name = "ClientTargetHealth",
		Adornee = anchor,
		Size = UDim2.fromOffset(170, 34),
		StudsOffset = Vector3.new(0, 2.8, 0),
		AlwaysOnTop = false,
		MaxDistance = 180,
		Enabled = false,
	}, model)
	local name = C.text(
		gui,
		"",
		Theme.TextSize.Small,
		if alignment == "Ally" then Color.Ally else Color.Bone,
		Theme.Font.Display,
		{
			Size = UDim2.new(1, 0, 0, 16),
			TextStrokeTransparency = 0.35,
		}
	)
	local bar = C.bar(gui, Vector2.new(150, 10), Color.Health, false)
	bar.Frame.Position = UDim2.fromOffset(10, 19)
	local function update()
		if not humanoid.Parent or not gui.Parent then
			return
		end
		local ratio = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
		bar.Set(ratio)
		bar.Fill.BackgroundColor3 = if alignment == "Ally" then Color.Ok else healthTint(ratio)
		name.Text = model:GetAttribute("SandboxLabel") or model.Name
	end
	humanoid.HealthChanged:Connect(update)
	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update)
	model:GetAttributeChangedSignal("SandboxLabel"):Connect(update)
	update()
	return gui
end

local function startTargetBars()
	local active: { [Model]: { Gui: BillboardGui, Humanoid: Humanoid } } = {}
	local lastDiscover, lastVisibility, cursor = 0, 0, 1
	local function add(model: Model)
		if model == player.Character or active[model] or not model:IsDescendantOf(workspace) then
			return
		end
		local team = relationship(model)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local anchor = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
		if not team or not humanoid or not anchor or not anchor:IsA("BasePart") or humanoid.Health <= 0 then
			return
		end
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BillboardGui") and descendant.Name ~= "ClientTargetHealth" then
				descendant.Enabled = false
			end
		end
		active[model] = { Gui = targetBar(model, humanoid, anchor, team), Humanoid = humanoid }
	end
	local function clear(model: Model)
		local record = active[model]
		if record then
			record.Gui:Destroy()
			active[model] = nil
		end
	end
	workspace.DescendantRemoving:Connect(function(instance)
		if instance:IsA("Model") then
			clear(instance)
		end
	end)
	RunService.RenderStepped:Connect(function()
		local hidden = player:GetAttribute("MagicLabOpen") == true
		local now = os.clock()
		if now - lastDiscover >= 0.7 then
			lastDiscover = now
			for _, model in candidates() do
				add(model)
			end
			for model in active do
				if not model:IsDescendantOf(workspace) or not model:FindFirstChildOfClass("Humanoid") then
					clear(model)
				end
			end
		end
		if now - lastVisibility < 0.1 then
			return
		end
		lastVisibility = now
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local models = {}
		for model in active do
			table.insert(models, model)
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character :: Instance }
		params.IgnoreWater = true
		params.RespectCanCollide = false
		for _ = 1, math.min(#models, 14) do
			if cursor > #models then
				cursor = 1
			end
			local model = models[cursor]
			cursor += 1
			local record = active[model]
			local anchor = record and record.Gui.Adornee
			if record and anchor and anchor:IsA("BasePart") then
				local visible = not hidden and record.Humanoid.Health > 0
				if visible then
					local screen, onScreen = camera:WorldToViewportPoint(anchor.Position + Vector3.new(0, 0.4, 0))
					local offset = anchor.Position - camera.CFrame.Position
					visible = onScreen and screen.Z > 0 and offset.Magnitude <= 180
					if visible then
						local hit = workspace:Raycast(camera.CFrame.Position, offset, params)
						visible = hit == nil or hit.Instance:IsDescendantOf(model)
					end
				end
				record.Gui.Enabled = visible
			end
		end
	end)
end

function WorldUI.start(container: Instance)
	startPrompts(container)
	startTargetBars()
end

return WorldUI
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="434">
            <Properties>
              <string name="Name">InventoryView</string>
              <string name="Source"><![CDATA[--!strict

-- Inventory panel (bag grid, equipment column, tooltip, context menu, drag and
-- drop) plus an always-visible kit strip showing the active weapon and quick slots.
local Players = game:GetService("Players")
local GamepadNav = require(script.Parent.Kit.GamepadNav)
local InputMode = require(script.Parent.Kit.InputMode)
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules = require(Shared.Modules.ItemRules)
local Model = require(Shared.Modules.InventoryModel)
local Theme = require(script.Parent.GrimoireTheme)

local View = {}

local CELL = 64
local GAP = 6
local COLUMNS = 6
local SLOT_HEIGHT = 46
local EQUIP_WIDTH = 200
local PAD = 18

local equipLabels = {
	{ Location = "Equip:MainHand", Label = "Main Hand" },
	{ Location = "Equip:MagicFocus", Label = "Focus" },
	{ Location = "Equip:Head", Label = "Head" },
	{ Location = "Equip:Body", Label = "Body" },
	{ Location = "Equip:Legs", Label = "Legs" },
	{ Location = "Quick:1", Label = "Quick (Y)" },
	{ Location = "Quick:2", Label = "Quick (U)" },
}

local function make(className: string, properties: { [string]: any }, parent: Instance?): any
	local object = Instance.new(className) :: any
	for key, value in properties do
		object[key] = value
	end
	if parent then
		object.Parent = parent
	end
	return object
end

local function corner(parent: Instance, radius: number)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(parent: Instance, color: Color3, thickness: number): UIStroke
	return make(
		"UIStroke",
		{ Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border },
		parent
	)
end

local function text(parent: Instance, properties: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextColor3 = Theme.Ink,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}
	for key, value in properties do
		defaults[key] = value
	end
	return make("TextLabel", defaults, parent)
end

function View.new(controller: any)
	local player = Players.LocalPlayer
	local gui = make("ScreenGui", {
		Name = "EnfleshedInventory",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))

	local bagRows = math.ceil(Model.BagSize / COLUMNS)
	local gridWidth = COLUMNS * CELL + (COLUMNS - 1) * GAP
	local gridHeight = bagRows * CELL + (bagRows - 1) * GAP
	local equipHeight = #equipLabels * (SLOT_HEIGHT + GAP) - GAP
	local bodyHeight = math.max(gridHeight, equipHeight)
	local panel = make("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(PAD * 3 + EQUIP_WIDTH + gridWidth, 56 + bodyHeight + 44),
		BackgroundColor3 = Theme.Page,
		Visible = false,
	}, gui)
	corner(panel, 10)
	stroke(panel, Theme.PageEdge, 3)
	make("UISizeConstraint", { MinSize = Vector2.new(300, 300) }, panel)
	-- Shrink to fit small screens while keeping pixel layout math simple.
	local scale = make("UIScale", {}, panel)
	local function fit()
		local camera = workspace.CurrentCamera
		if camera then
			local viewport = camera.ViewportSize
			local size = panel.Size
			scale.Scale = math.min(1, (viewport.X - 32) / size.X.Offset, (viewport.Y - 32) / size.Y.Offset)
		end
	end
	fit()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end

	text(panel, {
		Text = "Kit & Pack",
		Font = Enum.Font.GothamBold,
		TextSize = 22,
		Position = UDim2.fromOffset(PAD, 12),
		Size = UDim2.new(1, -PAD * 2 - 40, 0, 30),
	})
	local close = make("TextButton", {
		Text = "×",
		Font = Enum.Font.GothamBold,
		TextSize = 22,
		TextColor3 = Theme.Ink,
		BackgroundColor3 = Theme.Surface,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -PAD, 0, 12),
		Size = UDim2.fromOffset(30, 30),
		AutoButtonColor = true,
	}, panel)
	corner(close, 6)
	text(panel, {
		Text = "Drag to move · Right-click for actions · Shift-click splits a stack · Drag outside to drop · [I] close",
		TextColor3 = Theme.MutedInk,
		TextSize = 12,
		Position = UDim2.new(0, PAD, 1, -36),
		Size = UDim2.new(1, -PAD * 2, 0, 28),
	})

	local cells: { [string]: any } = {}
	local function makeCell(location: string, parent: Instance, position: UDim2, size: UDim2, label: string?)
		local button = make("TextButton", {
			Name = location,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Theme.Surface,
			Position = position,
			Size = size,
		}, parent)
		button:SetAttribute("InvLocation", location)
		corner(button, 6)
		local border = stroke(button, Theme.Border, 1.5)
		local iconSize = if label then SLOT_HEIGHT - 10 else CELL - 14
		local icon = make("Frame", {
			Position = UDim2.fromOffset(5, 5),
			Size = if label then UDim2.fromOffset(iconSize, iconSize) else UDim2.new(1, -10, 1, -10),
			BackgroundColor3 = Theme.SurfaceMuted,
			BackgroundTransparency = 1,
		}, button)
		corner(icon, 4)
		local glyph = text(icon, {
			Size = UDim2.fromScale(1, 1),
			Font = Enum.Font.GothamBlack,
			TextSize = if label then 12 else 15,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = Theme.Ink,
			Text = "",
		})
		local count = text(button, {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -4, 1, -2),
			Size = UDim2.fromOffset(40, 16),
			TextXAlignment = Enum.TextXAlignment.Right,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			Text = "",
		})
		local caption = nil
		if label then
			caption = text(button, {
				Position = UDim2.fromOffset(iconSize + 12, 4),
				Size = UDim2.new(1, -iconSize - 16, 1, -8),
				TextSize = 13,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = label,
			})
		end
		cells[location] = {
			Button = button,
			Border = border,
			Icon = icon,
			Glyph = glyph,
			Count = count,
			Caption = caption,
			Label = label,
		}
		return button
	end

	local equipColumn = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(PAD, 56),
		Size = UDim2.fromOffset(EQUIP_WIDTH, bodyHeight),
	}, panel)
	for index, slot in equipLabels do
		makeCell(
			slot.Location,
			equipColumn,
			UDim2.fromOffset(0, (index - 1) * (SLOT_HEIGHT + GAP)),
			UDim2.fromOffset(EQUIP_WIDTH, SLOT_HEIGHT),
			slot.Label
		)
	end
	local grid = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(PAD * 2 + EQUIP_WIDTH, 56),
		Size = UDim2.fromOffset(gridWidth, gridHeight),
	}, panel)
	for index = 1, Model.BagSize do
		local column = (index - 1) % COLUMNS
		local row = math.floor((index - 1) / COLUMNS)
		makeCell(
			"Bag:" .. index,
			grid,
			UDim2.fromOffset(column * (CELL + GAP), row * (CELL + GAP)),
			UDim2.fromOffset(CELL, CELL),
			nil
		)
	end

	-- Tooltip
	local tooltip = make("Frame", {
		Name = "Tooltip",
		BackgroundColor3 = Theme.Binding,
		BackgroundTransparency = 0.04,
		Size = UDim2.fromOffset(250, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 50,
	}, gui)
	corner(tooltip, 6)
	local tooltipStroke = stroke(tooltip, Theme.BindingEdge, 2)
	make("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	}, tooltip)
	make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, tooltip)
	local function tooltipLine(order: number, size: number, font: Enum.Font): TextLabel
		return text(tooltip, {
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextSize = size,
			Font = font,
			TextColor3 = Theme.PageHighlight,
			ZIndex = 51,
		})
	end
	local tipTitle = tooltipLine(1, 16, Enum.Font.GothamBold)
	local tipSubtitle = tooltipLine(2, 12, Enum.Font.GothamMedium)
	local tipLines = tooltipLine(3, 13, Enum.Font.Gotham)
	local tipCompare = tooltipLine(4, 12, Enum.Font.GothamMedium)
	local tipDescription = tooltipLine(5, 12, Enum.Font.Gotham)
	tipSubtitle.TextColor3 = Theme.AccentSoft
	tipDescription.TextColor3 = Theme.PageShade

	-- Context menu
	local menu = make("Frame", {
		Name = "Menu",
		BackgroundColor3 = Theme.Surface,
		Size = UDim2.fromOffset(130, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 60,
	}, gui)
	corner(menu, 6)
	stroke(menu, Theme.Border, 1.5)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, menu)

	-- Drag ghost and notices
	local ghost = make("Frame", {
		Size = UDim2.fromOffset(CELL - 12, CELL - 12),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 0.2,
		Visible = false,
		ZIndex = 70,
	}, gui)
	corner(ghost, 4)
	local ghostText = text(ghost, {
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamBlack,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 71,
	})
	local notice = text(gui, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(420, 28),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextColor3 = Theme.PageHighlight,
		TextStrokeTransparency = 0.4,
		Text = "",
		Visible = false,
		ZIndex = 80,
	})
	local noticeSerial = 0
	controller.Notice:Connect(function(message: string)
		noticeSerial += 1
		local serial = noticeSerial
		notice.Text = message
		notice.Visible = true
		task.delay(2.2, function()
			if serial == noticeSerial then
				notice.Visible = false
			end
		end)
	end)

	-- Kit strip (always visible while the panel is closed)
	local strip = make("Frame", {
		Name = "KitStrip",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(360, 40),
		BackgroundColor3 = Theme.Binding,
		BackgroundTransparency = 0.25,
	}, gui)
	strip.Visible = false
	corner(strip, 8)
	stroke(strip, Theme.BindingEdge, 1.5)
	local stripWeapon = text(strip, {
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.55, -12, 1, 0),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		TextColor3 = Theme.PageHighlight,
	})
	local stripQuick = text(strip, {
		Position = UDim2.new(0.55, 0, 0, 0),
		Size = UDim2.new(0.45, -12, 1, 0),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		TextColor3 = Theme.PageShade,
	})

	local open = false
	local dragFrom: string? = nil
	local hovered: string? = nil

	local function itemAt(location: string): Rules.Instance?
		local parsed = Model.parse(location)
		return if parsed then Model.get(controller.Get(), parsed) else nil
	end

	local function compareText(instance: Rules.Instance): string
		local definition = Rules.definition(instance.ItemId)
		local equipped = controller.Get().Equip.MainHand
		if not definition or definition.WeaponType ~= "Melee" or not equipped or equipped.Uid == instance.Uid then
			return ""
		end
		local mine, theirs = Rules.meleeLoadout(instance), Rules.meleeLoadout(equipped)
		if not mine or not theirs then
			return ""
		end
		local function total(loadout: any): number
			local sum = 0
			for _, attack in loadout.Lights do
				sum += attack.Damage
			end
			return sum
		end
		local function signed(value: number): string
			return if value >= 0 then "+" .. tostring(value) else tostring(value)
		end
		return string.format(
			"vs equipped: combo %s · heavy %s · reach %s",
			signed(total(mine) - total(theirs)),
			signed(mine.Heavy.Damage - theirs.Heavy.Damage),
			string.format("%+.1f", mine.Lights[1].Reach - theirs.Lights[1].Reach)
		)
	end

	local function showTooltip(location: string?)
		local instance = if location and not dragFrom and not menu.Visible then itemAt(location) else nil
		if not instance then
			tooltip.Visible = false
			return
		end
		local info = Rules.describe(instance)
		tipTitle.Text = info.Title
		tipTitle.TextColor3 = info.Color
		tooltipStroke.Color = info.Color
		tipSubtitle.Text = info.Subtitle
		tipLines.Text = table.concat(info.Lines, "\n")
		tipLines.Visible = #info.Lines > 0
		local compare = compareText(instance)
		tipCompare.Text = compare
		tipCompare.Visible = compare ~= ""
		tipDescription.Text = info.Description
		tipDescription.Visible = info.Description ~= ""
		tooltip.Visible = true
	end

	local function render()
		local inventory = controller.Get()
		for location, cell in cells do
			local instance = itemAt(location)
			local definition = if instance then Rules.definition(instance.ItemId) else nil
			if instance and definition then
				local rarity = Rules.rarity(instance.Rarity)
				cell.Border.Color = rarity.Color
				cell.Border.Thickness = if rarity.Affixes > 0 then 2.5 else 1.5
				cell.Icon.BackgroundTransparency = 0
				cell.Icon.BackgroundColor3 = if definition.Icon then definition.Icon.Color else Theme.SurfaceMuted
				cell.Glyph.Text = if definition.Icon then definition.Icon.Text else string.sub(instance.ItemId, 1, 3)
				local luminance = cell.Icon.BackgroundColor3.R * 0.3
					+ cell.Icon.BackgroundColor3.G * 0.59
					+ cell.Icon.BackgroundColor3.B * 0.11
				cell.Glyph.TextColor3 = if luminance > 0.5 then Theme.Ink else Theme.PageHighlight
				cell.Count.Text = if instance.Count > 1 then tostring(instance.Count) else ""
				if cell.Caption then
					cell.Caption.Text = cell.Label .. "\n" .. Rules.displayName(instance)
					cell.Caption.TextColor3 = Theme.Ink
				end
			else
				cell.Border.Color = Theme.Border
				cell.Border.Thickness = 1.5
				cell.Icon.BackgroundTransparency = 1
				cell.Glyph.Text = ""
				cell.Count.Text = ""
				if cell.Caption then
					cell.Caption.Text = cell.Label .. "\n—"
					cell.Caption.TextColor3 = Theme.SubtleInk
				end
			end
			cell.Button.BackgroundColor3 = if location == dragFrom then Theme.SurfaceDisabled else Theme.Surface
		end
		local activeSlot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
		local active = if activeSlot == "PrimaryWeapon" then inventory.Equip.MagicFocus else inventory.Equip.MainHand
		if active then
			stripWeapon.Text = "[E] " .. Rules.displayName(active)
			stripWeapon.TextColor3 = Rules.rarity(active.Rarity).Color
		else
			stripWeapon.Text = "[E] Unarmed"
			stripWeapon.TextColor3 = Theme.PageShade
		end
		local quick = {}
		for index = 1, Model.QuickSize do
			local instance = inventory.Quick[index]
			local key = controller.Keys.Quick[index]
			local keyName = if key then key.Name else tostring(index)
			table.insert(
				quick,
				string.format(
					"[%s] %s",
					keyName,
					if instance then string.format("%s ×%d", Rules.displayName(instance), instance.Count) else "—"
				)
			)
		end
		stripQuick.Text = table.concat(quick, "   ")
		showTooltip(hovered)
	end

	local function closeMenu()
		menu.Visible = false
		for _, child in menu:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
	end

	local function firstEmptyBag(): string?
		local index = Model.firstEmptyBag(controller.Get())
		return if index then "Bag:" .. index else nil
	end

	local function equipTarget(instance: Rules.Instance): string?
		local definition = Rules.definition(instance.ItemId)
		if not definition then
			return nil
		end
		if definition.EquipSlot then
			return "Equip:" .. definition.EquipSlot
		elseif definition.Category == "Consumable" then
			local inventory = controller.Get()
			for index = 1, Model.QuickSize do
				local existing = inventory.Quick[index]
				if not existing or Rules.canStack(existing, instance) then
					return "Quick:" .. index
				end
			end
			return "Quick:1"
		end
		return nil
	end

	local function openMenu(location: string, position: Vector2)
		closeMenu()
		local instance = itemAt(location)
		local definition = if instance then Rules.definition(instance.ItemId) else nil
		if not instance or not definition then
			return
		end
		local options = {}
		local inBag = string.sub(location, 1, 4) == "Bag:"
		if inBag then
			local target = equipTarget(instance)
			if target then
				table.insert(options, {
					Label = if definition.Category == "Consumable" then "To quick slot" else "Equip",
					Run = function()
						controller.Request({ Op = "Move", From = location, To = target })
					end,
				})
			end
		else
			table.insert(options, {
				Label = "Unequip",
				Run = function()
					local target = firstEmptyBag()
					if target then
						controller.Request({ Op = "Move", From = location, To = target })
					end
				end,
			})
		end
		if definition.Category == "Consumable" then
			table.insert(options, {
				Label = "Use",
				Run = function()
					controller.Request({ Op = "Use", From = location })
				end,
			})
		end
		if instance.Count > 1 then
			table.insert(options, {
				Label = "Split half",
				Run = function()
					controller.Request({ Op = "Split", From = location, Amount = math.floor(instance.Count / 2) })
				end,
			})
		end
		if definition.Droppable ~= false then
			table.insert(options, {
				Label = "Drop",
				Run = function()
					controller.Request({ Op = "Drop", From = location })
				end,
			})
		end
		for order, option in options do
			local button = make("TextButton", {
				LayoutOrder = order,
				Text = "  " .. option.Label,
				TextXAlignment = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamMedium,
				TextSize = 14,
				TextColor3 = Theme.Ink,
				BackgroundColor3 = Theme.Surface,
				BackgroundTransparency = 0,
				AutoButtonColor = true,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 30),
				ZIndex = 61,
			}, menu)
			button.Activated:Connect(function()
				closeMenu()
				option.Run()
			end)
		end
		menu.Position = UDim2.fromOffset(position.X + 4, position.Y + 4)
		menu.Visible = #options > 0
		tooltip.Visible = false
	end

	local function locationUnder(position: Vector2): string?
		for _, object in player.PlayerGui:GetGuiObjectsAtPosition(position.X, position.Y) do
			local location = object:GetAttribute("InvLocation")
			if type(location) == "string" then
				return location
			end
		end
		return nil
	end

	local function insidePanel(position: Vector2): boolean
		local topLeft, size = panel.AbsolutePosition, panel.AbsoluteSize
		return position.X >= topLeft.X
			and position.Y >= topLeft.Y
			and position.X <= topLeft.X + size.X
			and position.Y <= topLeft.Y + size.Y
	end

	local function guiMouse(): Vector2
		-- GetMouseLocation includes the top bar inset; GUI objects here do not.
		local inset = game:GetService("GuiService"):GetGuiInset()
		return UserInputService:GetMouseLocation() - inset
	end

	for location, cell in cells do
		local button = cell.Button
		button.MouseEnter:Connect(function()
			hovered = location
			showTooltip(location)
		end)
		button.MouseLeave:Connect(function()
			if hovered == location then
				hovered = nil
				showTooltip(nil)
			end
		end)
		-- Gamepad: A on a focused slot opens the same context menu as right-click.
		button.Activated:Connect(function()
			if open and InputMode.get() == "Gamepad" and itemAt(location) then
				openMenu(location, button.AbsolutePosition + button.AbsoluteSize / 2)
				if menu.Visible then
					game:GetService("GuiService").SelectedObject = GamepadNav.firstSelectable(menu)
				end
			end
		end)
		button.InputBegan:Connect(function(input)
			if not open then
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				closeMenu()
				local instance = itemAt(location)
				if not instance then
					return
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and instance.Count > 1 then
					controller.Request({ Op = "Split", From = location, Amount = math.floor(instance.Count / 2) })
					return
				end
				dragFrom = location
				local definition = Rules.definition(instance.ItemId)
				ghost.BackgroundColor3 = if definition and definition.Icon
					then definition.Icon.Color
					else Theme.SurfaceMuted
				ghostText.Text = if definition and definition.Icon then definition.Icon.Text else ""
				ghost.Visible = true
				tooltip.Visible = false
				render()
			elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
				openMenu(location, guiMouse())
			end
		end)
	end

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not dragFrom then
			return
		end
		local from = dragFrom
		dragFrom = nil
		ghost.Visible = false
		local position = guiMouse()
		local target = locationUnder(position)
		if target and target ~= from then
			controller.Request({ Op = "Move", From = from, To = target })
		elseif not target and not insidePanel(position) then
			local instance = itemAt(from)
			local definition = if instance then Rules.definition(instance.ItemId) else nil
			if definition and definition.Droppable ~= false then
				controller.Request({ Op = "Drop", From = from })
			end
		end
		render()
	end)
	UserInputService.InputBegan:Connect(function(input)
		if menu.Visible and input.UserInputType == Enum.UserInputType.MouseButton1 then
			-- Defer so menu buttons receive their Activated first.
			task.defer(function()
				if menu.Visible then
					local position = guiMouse()
					local topLeft, size = menu.AbsolutePosition, menu.AbsoluteSize
					if
						position.X < topLeft.X
						or position.Y < topLeft.Y
						or position.X > topLeft.X + size.X
						or position.Y > topLeft.Y + size.Y
					then
						closeMenu()
					end
				end
			end)
		end
	end)
	RunService.RenderStepped:Connect(function()
		if not open then
			return
		end
		local position = guiMouse()
		if dragFrom then
			ghost.Position = UDim2.fromOffset(position.X, position.Y)
		end
		if tooltip.Visible then
			local viewport = gui.AbsoluteSize
			local size = tooltip.AbsoluteSize
			local x = if position.X + 18 + size.X > viewport.X then position.X - size.X - 12 else position.X + 18
			local y = math.clamp(position.Y + 12, 0, math.max(0, viewport.Y - size.Y))
			tooltip.Position = UDim2.fromOffset(x, y)
		end
	end)

	local view = {}
	function view.IsOpen(): boolean
		return open
	end
	function view.SetOpen(value: boolean)
		open = value
		panel.Visible = value
		if value then
			GamepadNav.open(panel, function()
				view.SetOpen(false)
			end)
		else
			GamepadNav.close(panel)
		end
		-- The HUD spell bar now shows the active weapon and quick slots.
		strip.Visible = false
		player:SetAttribute("InventoryOpen", value or nil)
		if not value then
			dragFrom = nil
			hovered = nil
			ghost.Visible = false
			tooltip.Visible = false
			closeMenu()
		end
		render()
	end
	close.Activated:Connect(function()
		view.SetOpen(false)
	end)
	controller.Changed:Connect(render)
	render()
	return view
end

return View
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="435">
            <Properties>
              <string name="Name">Kit</string>
            </Properties>
            <Item class="ModuleScript" referent="436">
              <Properties>
                <string name="Name">GamepadNav</string>
                <string name="Source"><![CDATA[--!strict
-- Gamepad focus for menus. `open(root)` makes every button/text box inside the
-- panel selectable, keeps selection inside the panel (SelectionGroup), selects a
-- sensible first item, and binds B to close it. Panels stack: closing one returns
-- selection to the panel underneath. With keyboard/mouse this is invisible.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Nav = {}
Nav.ClosePriority = Enum.ContextActionPriority.High.Value + 100

type Entry = { Root: GuiObject, OnClose: () -> (), Previous: GuiObject?, Connection: RBXScriptConnection }
local stack: { Entry } = {}

local function interactive(item: Instance): boolean
	return item:IsA("GuiButton") or item:IsA("TextBox")
end

-- Pure-ish helper (no services): the first visible interactive descendant, preferring `preferred`.
function Nav.firstSelectable(root: GuiObject, preferred: GuiObject?): GuiObject?
	if preferred and preferred:IsDescendantOf(root) and preferred.Visible then
		return preferred
	end
	local best: GuiObject? = nil
	for _, item in root:GetDescendants() do
		if interactive(item) and (item :: GuiObject).Visible then
			local gui = item :: GuiObject
			if
				not best
				or gui.AbsolutePosition.Y < (best :: GuiObject).AbsolutePosition.Y
				or (
					gui.AbsolutePosition.Y == (best :: GuiObject).AbsolutePosition.Y
					and gui.AbsolutePosition.X < (best :: GuiObject).AbsolutePosition.X
				)
			then
				best = gui
			end
		end
	end
	return best
end

local function makeSelectable(item: Instance)
	if interactive(item) then
		(item :: GuiObject).Selectable = true
	end
end

local function bindClose()
	ContextActionService:BindActionAtPriority("UIKitClose", function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		local top = stack[#stack]
		if not top then
			return Enum.ContextActionResult.Pass
		end
		top.OnClose()
		return Enum.ContextActionResult.Sink
	end, false, Nav.ClosePriority, Enum.KeyCode.ButtonB)
end

function Nav.isOpen(root: GuiObject?): boolean
	for _, entry in stack do
		if root == nil or entry.Root == root then
			return true
		end
	end
	return false
end

function Nav.open(root: GuiObject, onClose: () -> (), preferred: GuiObject?)
	if Nav.isOpen(root) then
		return
	end
	root.SelectionGroup = true
	for _, item in root:GetDescendants() do
		makeSelectable(item)
	end
	table.insert(stack, {
		Root = root,
		OnClose = onClose,
		Previous = GuiService.SelectedObject,
		Connection = root.DescendantAdded:Connect(makeSelectable),
	})
	if #stack == 1 then
		bindClose()
	end
	if UserInputService.GamepadEnabled then
		task.defer(function()
			if Nav.isOpen(root) then
				GuiService.SelectedObject = Nav.firstSelectable(root, preferred)
			end
		end)
	end
end

function Nav.close(root: GuiObject)
	for index = #stack, 1, -1 do
		local entry = stack[index]
		if entry.Root == root then
			entry.Connection:Disconnect()
			table.remove(stack, index)
			local selected = GuiService.SelectedObject
			if selected and selected:IsDescendantOf(root) then
				local below = stack[#stack]
				GuiService.SelectedObject = if below then Nav.firstSelectable(below.Root, entry.Previous) else nil
			end
			break
		end
	end
	if #stack == 0 then
		ContextActionService:UnbindAction("UIKitClose")
	end
end

-- Re-select inside the top panel after a rebuild destroyed the selected button.
function Nav.refresh()
	local top = stack[#stack]
	if top and UserInputService.GamepadEnabled then
		local selected = GuiService.SelectedObject
		if not selected or not selected:IsDescendantOf(top.Root) then
			GuiService.SelectedObject = Nav.firstSelectable(top.Root)
		end
	end
end

-- A rebuild that destroys the focused button clears the selection; restore it.
GuiService:GetPropertyChangedSignal("SelectedObject"):Connect(function()
	if GuiService.SelectedObject == nil and #stack > 0 then
		task.defer(Nav.refresh)
	end
end)

return Nav
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="437">
              <Properties>
                <string name="Name">InputMode</string>
                <string name="Source"><![CDATA[--!strict
-- Tracks the player's current input device and gives prompt glyph text for it,
-- so prompts read "P", "View" or a tap hint depending on what the player uses.
local UserInputService = game:GetService("UserInputService")

local InputMode = {}
export type Mode = "Keyboard" | "Gamepad" | "Touch"

-- Pure: input type → mode (nil = does not change the mode, e.g. focus events).
function InputMode.classify(inputType: Enum.UserInputType): Mode?
	local name = inputType.Name
	if string.sub(name, 1, 7) == "Gamepad" then
		return "Gamepad"
	elseif inputType == Enum.UserInputType.Touch then
		return "Touch"
	elseif inputType == Enum.UserInputType.Keyboard or string.sub(name, 1, 5) == "Mouse" then
		return "Keyboard"
	end
	return nil
end

-- Prompt labels per action. Keep in sync with the bindings (docs/CONTROLS.md).
InputMode.Glyphs = {
	Grimoire = { Keyboard = "P", Gamepad = "View", Touch = "" },
	Inventory = { Keyboard = "I", Gamepad = "D-pad ↓", Touch = "" },
	Close = { Keyboard = "Esc", Gamepad = "B", Touch = "" },
	Confirm = { Keyboard = "Click", Gamepad = "A", Touch = "Tap" },
	CastSpell = { Keyboard = "1–9", Gamepad = "RB", Touch = "" },
	NextSpell = { Keyboard = "", Gamepad = "D-pad ←/→", Touch = "" },
}

function InputMode.glyph(action: string, mode: Mode): string
	local entry = InputMode.Glyphs[action]
	return if entry then entry[mode] or "" else ""
end

local current: Mode = if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled
	then "Gamepad"
	elseif UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "Touch"
	else "Keyboard"
local changed = Instance.new("BindableEvent")
InputMode.Changed = changed.Event -- (mode)

function InputMode.get(): Mode
	return current
end

UserInputService.LastInputTypeChanged:Connect(function(inputType)
	local mode = InputMode.classify(inputType)
	if mode and mode ~= current then
		current = mode
		changed:Fire(mode)
	end
end)

return InputMode
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="438">
              <Properties>
                <string name="Name">Responsive</string>
                <string name="Source"><![CDATA[--!strict
-- Scales a screen to the player's viewport from the reference design size, keeps
-- it inside the device safe area, and respects the player's UI scale setting
-- (Player attribute "UIScaleSetting", 0.75–1.5; Phase 2 settings menu writes it).
local Players = game:GetService("Players")
local Tokens = require(script.Parent.Tokens)

local Responsive = {}
Responsive.MinScale = 0.6
Responsive.MaxScale = 1.4

-- Pure: scale for a viewport (fits the reference size, clamped).
function Responsive.scaleFor(viewport: Vector2, setting: number?): number
	if viewport.X <= 0 or viewport.Y <= 0 then
		return 1
	end
	local fit = math.min(viewport.X / Tokens.ReferenceSize.X, viewport.Y / Tokens.ReferenceSize.Y)
	local user = if type(setting) == "number" and setting == setting then math.clamp(setting, 0.75, 1.5) else 1
	return math.clamp(fit * user, Responsive.MinScale, Responsive.MaxScale)
end

-- Adds (or reuses) a UIScale on `root` and keeps it updated. Returns a cleanup function.
function Responsive.attach(gui: ScreenGui, root: GuiObject): () -> ()
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	local scale = root:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = root
	local player = Players.LocalPlayer
	local connections: { RBXScriptConnection } = {}
	local function update()
		local camera = workspace.CurrentCamera
		if camera then
			(scale :: UIScale).Scale = Responsive.scaleFor(camera.ViewportSize, player:GetAttribute("UIScaleSetting"))
		end
	end
	local function watchCamera()
		local camera = workspace.CurrentCamera
		if camera then
			table.insert(connections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(update))
		end
		update()
	end
	table.insert(connections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera))
	table.insert(connections, player:GetAttributeChangedSignal("UIScaleSetting"):Connect(update))
	watchCamera()
	return function()
		for _, connection in connections do
			connection:Disconnect()
		end
	end
end

return Responsive
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="439">
              <Properties>
                <string name="Name">Tokens</string>
                <string name="Source"><![CDATA[--!strict
-- Shared design tokens for every screen. Colors come from the Spell Forge palette
-- (the game's dark-fantasy look); new UI should use these instead of literals.
local Forge = require(script.Parent.Parent.SpellForgeTheme)

local Tokens = {}
Tokens.Color = Forge.C
Tokens.Font = {
	Display = Enum.Font.Garamond,
	Body = Enum.Font.Gotham,
	Strong = Enum.Font.GothamBold,
	Mono = Enum.Font.Code,
}
Tokens.TextSize = { Caption = 12, Body = 14, Label = 16, Title = 22, Display = 30 }
Tokens.Space = { XS = 4, S = 8, M = 12, L = 18, XL = 28 }
Tokens.Radius = { S = 4, M = 8, L = 14 }
Tokens.Stroke = 1
-- Minimum touch/gamepad target (Roblox guideline ≈ 44 px at 1x scale).
Tokens.MinTarget = 44
-- Design resolution the layouts are authored at; Responsive scales from it.
Tokens.ReferenceSize = Vector2.new(1280, 720)

return Tokens
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="440">
            <Properties>
              <string name="Name">SpellForgeComponents</string>
              <string name="Source"><![CDATA[--!strict
-- Shared building blocks for every spell UI screen (forge, home, library,
-- training, dialogs). Colors come from SpellForgeTheme; glyphs are limited to
-- ones the Gotham font renders.
local C = require(script.Parent.SpellForgeTheme).C
local K = { C = C }

local CategoryColor = {
	Impact = C.Ember,
	Support = C.Verdant,
	Control = C.Arcane,
	Detection = C.Frost,
	Movement = C.Frost,
	Temporal = C.Arcane,
	["World interaction"] = C.Gold,
	Summoning = C.Blood,
}

local ElementColor = {
	Fire = Color3.fromRGB(240, 120, 60),
	Water = Color3.fromRGB(80, 150, 230),
	Ice = Color3.fromRGB(160, 220, 245),
	Frost = Color3.fromRGB(160, 220, 245),
	Lightning = Color3.fromRGB(245, 225, 110),
	Earth = Color3.fromRGB(170, 130, 80),
	Wind = Color3.fromRGB(170, 230, 190),
	Air = Color3.fromRGB(170, 230, 190),
	Light = Color3.fromRGB(255, 236, 170),
	Dark = Color3.fromRGB(150, 90, 200),
	Shadow = Color3.fromRGB(150, 90, 200),
	Blood = Color3.fromRGB(200, 40, 60),
	Nature = Color3.fromRGB(120, 200, 110),
	Poison = Color3.fromRGB(150, 210, 80),
}

local FormIcon = {
	Projectile = "→",
	Beam = "—",
	Wave = "~",
	Field = "○",
	Aura = "*",
	SelfEnhancement = "▲",
	Construct = "■",
	Manipulation = "◇",
}
local FormVerb = {
	Projectile = "Launch a projectile",
	Beam = "Fire a beam",
	Wave = "Send out a wave",
	Field = "Create a field",
	Aura = "Surround yourself with an aura",
	SelfEnhancement = "Empower yourself",
	Construct = "Build a construct",
	Manipulation = "Manipulate the world",
}

local PayloadIcon = {
	Damage = "×",
	DamageOverTime = "~",
	Force = "→",
	Heal = "+",
	Restoration = "↑",
	Shield = "■",
	ModifyAttribute = "±",
	Transformation = "◇",
	Slow = "▼",
	Bind = "□",
	Reveal = "○",
	Control = "◆",
	Displacement = "←",
	TimeDilation = "◀",
	Enhancement = "▲",
	AerialMovement = "↑",
	Manipulation = "◇",
	Summon = "●",
	ElementalMark = "*",
	ConsumeElementalMark = "!",
}
local PayloadVerb = {
	Damage = "Deal damage",
	DamageOverTime = "Damage over time",
	Force = "Push or pull targets",
	Heal = "Heal",
	Restoration = "Restore resources",
	Shield = "Grant a shield",
	ModifyAttribute = "Change an attribute",
	Transformation = "Transform the target",
	Slow = "Slow targets",
	Bind = "Bind in place",
	Reveal = "Reveal targets",
	Control = "Take control",
	Displacement = "Displace targets",
	TimeDilation = "Bend time",
	Enhancement = "Empower the caster",
	AerialMovement = "Take flight",
	Manipulation = "Manipulate matter",
	Summon = "Summon a companion",
	ElementalMark = "Mark with an element",
	ConsumeElementalMark = "Detonate a mark",
}

local EventPhrase = {
	OnCast = "As it is cast",
	OnSpawn = "When it appears",
	OnImpact = "When it hits",
	OnProximity = "When a target comes close",
	OnDamageDealt = "After it deals damage",
	OnDamageTaken = "When you take damage",
	OnThreshold = "When a target's health drops past a threshold",
	OnBreak = "When the shield breaks",
	OnTargetDeath = "When a target dies",
	OnCasterDeath = "When you die",
	OnCommand = "When you give a command",
	OnEnter = "When a target enters",
	OnExit = "When a target leaves",
	OnInterval = "Every interval",
	OnTick = "Every pulse",
	OnExpire = "When it ends",
}

local function fmt(value)
	if type(value) ~= "number" then
		return tostring(value)
	end
	if math.abs(value - math.round(value)) < 1e-4 then
		return tostring(math.round(value))
	end
	local text = string.format("%.2f", value)
	text = string.gsub(text, "0+$", "")
	return (string.gsub(text, "%.$", ""))
end

local function new(class, props, parent)
	local item = Instance.new(class)
	for key, value in props do
		item[key] = value
	end
	item.Parent = parent
	return item
end

local function corner(gui, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, gui)
end

local function stroke(gui, color, thickness, transparency)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, gui)
end

local function pad(gui, x, y)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, x),
		PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y or x),
		PaddingBottom = UDim.new(0, y or x),
	}, gui)
end

local function text(parent, value, size, color, font, props)
	local item = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = value,
		TextSize = size or 14,
		TextColor3 = color or C.Ink,
		Font = font or Enum.Font.Gotham,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, parent)
	for key, v in props or {} do
		item[key] = v
	end
	return item
end

local function hover(buttonGui, base, over)
	buttonGui.MouseEnter:Connect(function()
		buttonGui.BackgroundColor3 = over
	end)
	buttonGui.MouseLeave:Connect(function()
		buttonGui.BackgroundColor3 = base
	end)
end

local function pill(parent, label, callback, style)
	local accent = style == "accent"
	local danger = style == "danger"
	local base = if accent then C.Ember elseif danger then Color3.fromRGB(60, 26, 30) else C.Card
	local item = new("TextButton", {
		Text = label,
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextColor3 = if accent then Color3.fromRGB(255, 244, 230) elseif danger then C.Error else C.Ink,
		BackgroundColor3 = base,
		AutoButtonColor = false,
		BorderSizePixel = 0,
	}, parent)
	corner(item, 8)
	stroke(item, if accent then C.Gold elseif danger then C.Blood else C.PanelEdge, 1, if accent then 0.3 else 0)
	hover(
		item,
		base,
		if accent then Color3.fromRGB(232, 116, 74) elseif danger then Color3.fromRGB(84, 32, 38) else C.CardHover
	)
	item.Activated:Connect(callback)
	return item
end

local function list(parent, padding, horizontal)
	return new("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
	}, parent)
end

local function clearChildren(frame, keepClass)
	for _, child in frame:GetChildren() do
		if not (keepClass and child:IsA(keepClass)) and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

K.CategoryColor = CategoryColor
K.ElementColor = ElementColor
K.FormIcon = FormIcon
K.FormVerb = FormVerb
K.PayloadIcon = PayloadIcon
K.PayloadVerb = PayloadVerb
K.EventPhrase = EventPhrase
K.fmt = fmt
K.new = new
K.corner = corner
K.stroke = stroke
K.pad = pad
K.text = text
K.hover = hover
K.pill = pill
K.list = list
K.clearChildren = clearChildren

-- Toggle styled as a pill switch.
function K.switch(parent, on, callback)
	local item = pill(parent, if on then "ON" else "OFF", function()
		callback(not on)
	end)
	item.BackgroundColor3 = if on then C.Ember else C.Input
	item.TextColor3 = if on then Color3.fromRGB(255, 244, 230) else C.Muted
	return item
end

-- Wrapping chip row; the active value is gold. `labeler` formats values.
function K.chips(parent, values, current, onPick, labeler, available)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, parent)
	local layout = list(holder, 6, true)
	layout.Wraps = true
	for index, value in values do
		local active = value == current
		local enabled = available == nil or available(value)
		local chip = new("TextButton", {
			Text = if labeler then labeler(value) else tostring(value),
			TextSize = 12,
			Font = Enum.Font.GothamBold,
			TextColor3 = if active then C.Backdrop elseif enabled then C.Ink else C.Faint,
			BackgroundColor3 = if active then C.Gold else C.Input,
			AutoButtonColor = false,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 32),
			LayoutOrder = index,
		}, holder)
		corner(chip, 16)
		stroke(chip, if active then C.Gold else C.PanelEdge)
		pad(chip, 12, 0)
		if not active and enabled then
			hover(chip, C.Input, C.CardHover)
			chip.Activated:Connect(function()
				onPick(value)
			end)
		end
	end
	return holder
end

-- One-line description of what a spell does, e.g. "On impact: Deal damage, Explode".
function K.sequence(definition, schema)
	local parts = {}
	for _, eventName in schema.EventOrder do
		local steps = definition.Triggers and definition.Triggers[eventName]
		if steps and #steps > 0 then
			local actions = {}
			for _, step in steps do
				if step.Behavior == "SpawnEffect" then
					table.insert(actions, "spawn " .. tostring(step.Effect and step.Effect.Form or "effect"))
				elseif step.Behavior then
					table.insert(actions, "explode")
				end
				for _, payload in step.Payloads or {} do
					if step.Behavior ~= "SpawnEffect" then
						table.insert(actions, string.lower(PayloadVerb[payload.Kind] or payload.Kind))
					end
				end
			end
			table.insert(parts, (EventPhrase[eventName] or eventName) .. ": " .. table.concat(actions, ", "))
		end
	end
	return if #parts > 0 then table.concat(parts, " · ") else "No effects yet"
end

return K
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="441">
            <Properties>
              <string name="Name">SpellForgeTheme</string>
              <string name="Source"><![CDATA[--!strict
-- Dark fantasy palette shared by the Spell Forge (Guided and Advanced).
-- `Book` maps the parchment GrimoireTheme keys onto this palette so the
-- Advanced section editors can draw inside the forge without their own colors.
local C = {
	Backdrop = Color3.fromRGB(11, 9, 13),
	Panel = Color3.fromRGB(21, 18, 24),
	PanelEdge = Color3.fromRGB(62, 48, 52),
	Card = Color3.fromRGB(33, 28, 36),
	CardHover = Color3.fromRGB(44, 37, 47),
	CardSelected = Color3.fromRGB(56, 42, 38),
	Input = Color3.fromRGB(15, 13, 18),
	Ink = Color3.fromRGB(238, 228, 212),
	Muted = Color3.fromRGB(168, 155, 146),
	Faint = Color3.fromRGB(110, 99, 97),
	Rail = Color3.fromRGB(78, 62, 60),
	Gold = Color3.fromRGB(218, 174, 96),
	GoldDeep = Color3.fromRGB(122, 88, 40),
	Ember = Color3.fromRGB(214, 96, 58),
	Blood = Color3.fromRGB(170, 48, 60),
	Arcane = Color3.fromRGB(150, 118, 230),
	Verdant = Color3.fromRGB(104, 184, 128),
	Frost = Color3.fromRGB(112, 176, 220),
	Ok = Color3.fromRGB(122, 204, 142),
	Warn = Color3.fromRGB(236, 168, 76),
	Error = Color3.fromRGB(232, 96, 96),
}

local Book = {
	Page = C.Panel,
	PageShade = C.Card,
	PageHighlight = C.CardSelected,
	Binding = C.Backdrop,
	BindingEdge = C.PanelEdge,
	PageEdge = C.PanelEdge,
	Ink = C.Ink,
	MutedInk = C.Muted,
	SubtleInk = C.Faint,
	Gold = C.Gold,
	Accent = C.Ember,
	AccentAlt = C.Arcane,
	AccentSoft = Color3.fromRGB(70, 38, 32),
	Surface = C.Card,
	SurfaceMuted = Color3.fromRGB(27, 23, 30),
	SurfaceDisabled = Color3.fromRGB(24, 21, 26),
	Border = C.PanelEdge,
	TileEdge = C.Rail,
	DisabledInk = C.Faint,
	OnAccent = Color3.fromRGB(255, 244, 230),
	Success = C.Ok,
	Warning = C.Warn,
	WarningSurface = Color3.fromRGB(52, 38, 24),
	Error = C.Error,
}

return { C = C, Book = Book }
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="442">
            <Properties>
              <string name="Name">SpellHub</string>
              <string name="Source"><![CDATA[--!nonstrict
-- App shell and Home screen for the spell UI, in the Spell Forge design.
-- Presentation only: the controller owns spell data, slots, and persistence.
local K = require(script.Parent.SpellForgeComponents)
local C = K.C
local new, corner, stroke, pad, text, pill, list, fmt = K.new, K.corner, K.stroke, K.pad, K.text, K.pill, K.list, K.fmt

local Hub = {}

local Tabs = {
	{ Id = "Home", Label = "HOME", Mobile = "HOME" },
	{ Id = "Library", Label = "LIBRARY", Mobile = "LIBRARY" },
	{ Id = "Forge", Label = "SPELL FORGE", Mobile = "FORGE" },
	{ Id = "Training", Label = "TRAINING", Mobile = "TRAIN" },
}
Hub.TabForPage = {
	Slots = "Home",
	Library = "Library",
	LibraryDetail = "Library",
	Editor = "Forge",
	Training = "Training",
	Help = "Help",
}

-- Restyles the controller's panel into the app shell. `ui` holds the existing
-- panel children (scroll, title, summary, status, navigation, close, home)
-- so controller code that writes to them keeps working.
function Hub.mountShell(panel, ui, onTab)
	panel.BackgroundColor3 = C.Backdrop
	panel.BorderSizePixel = 0
	corner(panel, 14)
	stroke(panel, C.PanelEdge, 1)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(28, 20, 26), Color3.fromRGB(10, 9, 12)),
		Rotation = 90,
	}, panel)
	local toolbar = new("Frame", {
		Name = "HubToolbar",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, panel)
	corner(toolbar, 12)
	stroke(toolbar, C.PanelEdge)
	local brand = text(toolbar, "◆  SPELLCRAFT", 15, C.Gold, Enum.Font.GothamBlack, {
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.fromOffset(170, 52),
		TextWrapped = false,
		ZIndex = 3,
	})
	local tabButtons = {}
	for _, tab in Tabs do
		local item = pill(toolbar, tab.Label, function()
			onTab(tab.Id)
		end)
		item.Name = "Tab_" .. tab.Id
		item.ZIndex = 3
		tabButtons[tab.Id] = item
	end
	local help = pill(toolbar, "?", function()
		onTab("Help")
	end)
	help.Name = "Tab_Help"
	help.ZIndex = 3
	tabButtons.Help = help
	local close = ui.closeButton
	close.Parent = toolbar
	close.Text = "×"
	close.TextSize = 20
	close.Font = Enum.Font.GothamBold
	close.BackgroundColor3 = C.Card
	close.TextColor3 = C.Ink
	close.AutoButtonColor = true
	close.ZIndex = 3
	corner(close, 8)
	stroke(close, C.PanelEdge)
	ui.homeButton.Visible = false
	ui.navigation.Visible = false

	local content = new("Frame", {
		Name = "HubContent",
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		ZIndex = 1,
	}, panel)
	corner(content, 12)
	stroke(content, C.PanelEdge)
	local title, summary, status, scroll = ui.title, ui.summary, ui.status, ui.scroll
	title.Font = Enum.Font.GothamBold
	title.TextSize = 20
	title.TextColor3 = C.Ink
	title.ZIndex = 3
	summary.Font = Enum.Font.Gotham
	summary.TextSize = 12
	summary.TextColor3 = C.Muted
	summary.ZIndex = 3
	status.Font = Enum.Font.GothamMedium
	status.TextSize = 12
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.ZIndex = 3
	scroll.ZIndex = 3
	scroll.ScrollBarImageColor3 = C.Rail
	scroll.BorderSizePixel = 0

	local active = "Home"
	local function layout(page)
		active = Hub.TabForPage[page] or active
		local width = panel.AbsoluteSize.X
		local mobile = width < 760
		local m = 10
		local barH = if mobile then 100 else 52
		toolbar.Position, toolbar.Size = UDim2.fromOffset(m, m), UDim2.new(1, -m * 2, 0, barH)
		brand.Visible = true
		brand.Position = UDim2.fromOffset(16, 0)
		brand.Size = UDim2.fromOffset(170, 52)
		close.Position, close.Size = UDim2.new(1, -48, 0, 8), UDim2.fromOffset(38, 36)
		help.Position, help.Size = UDim2.new(1, -94, 0, 8), UDim2.fromOffset(38, 36)
		local x, y = if mobile then 8 else 196, if mobile then 56 else 8
		local tabWidth = if mobile then (width - m * 2 - 16 - 6 * 3) / 4 else 128
		for _, tab in Tabs do
			local item = tabButtons[tab.Id]
			item.Text = if mobile then tab.Mobile else tab.Label
			item.Position = UDim2.fromOffset(x, y)
			item.Size = UDim2.fromOffset(tabWidth, 36)
			x += tabWidth + 6
		end
		for id, item in tabButtons do
			local on = id == active
			item.BackgroundColor3 = if on then C.Gold else C.Card
			item.TextColor3 = if on then C.Backdrop else C.Ink
		end
		local top = m + barH + 10
		title.Position, title.Size = UDim2.fromOffset(m + 8, top), UDim2.new(1, -m * 2 - 16, 0, 26)
		summary.Position, summary.Size = UDim2.fromOffset(m + 8, top + 26), UDim2.new(1, -m * 2 - 16, 0, 18)
		local contentTop = top + (if summary.Visible and summary.Text ~= "" then 50 else 34)
		content.Position = UDim2.fromOffset(m, contentTop)
		content.Size = UDim2.new(1, -m * 2, 1, -contentTop - m - (if status.Visible then 36 else 0))
		scroll.Position = UDim2.fromOffset(m + 12, contentTop + 12)
		scroll.Size = UDim2.new(1, -m * 2 - 24, 1, -contentTop - m - 24 - (if status.Visible then 36 else 0))
		status.Position, status.Size = UDim2.new(0, m + 8, 1, -m - 30), UDim2.new(1, -m * 2 - 16, 0, 28)
	end
	panel:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		layout(nil)
	end)
	layout("Slots")
	return layout
end

-- Spell card used on Home: form glyph, name, form · element, cost, sequence.
function Hub.spellCard(parent, definition, opts)
	local schema, spec = opts.Schema, opts.Spec
	local locked = opts.Locked
	local base = if locked then Color3.fromRGB(24, 21, 26) else C.Card
	local card = new("TextButton", {
		Name = opts.Name or "SpellCard",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = base,
		BorderSizePixel = 0,
		LayoutOrder = opts.Order or 0,
	}, parent)
	corner(card, 12)
	local edge = stroke(card, if opts.Selected then C.Gold else C.PanelEdge, if opts.Selected then 2 else 1)
	if not locked then
		K.hover(card, base, C.CardHover)
	end
	card.Activated:Connect(opts.OnClick)
	local accent = if definition then K.ElementColor[definition.Element] or C.Gold else C.Faint
	new("Frame", {
		Size = UDim2.new(0, 4, 1, -20),
		Position = UDim2.fromOffset(0, 10),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
	}, card)
	local glyph = text(
		card,
		if definition then K.FormIcon[definition.Form] or "◆" elseif locked then "■" else "+",
		24,
		accent,
		Enum.Font.GothamBold,
		{
			Position = UDim2.fromOffset(14, 14),
			Size = UDim2.fromOffset(48, 48),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Input,
		}
	)
	corner(glyph, 24)
	stroke(glyph, accent, 1, 0.5)
	if opts.Number then
		local number = text(card, tostring(opts.Number), 11, C.Backdrop, Enum.Font.GothamBlack, {
			Name = "SlotNumber",
			Position = UDim2.fromOffset(48, 10),
			Size = UDim2.fromOffset(20, 20),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Gold,
		})
		corner(number, 10)
	end
	local title = if definition then definition.Name elseif locked then "LOCKED SLOT" else "EMPTY SLOT"
	text(card, title, 15, if locked then C.Faint else C.Ink, Enum.Font.GothamBold, {
		Name = "SpellName",
		Position = UDim2.fromOffset(74, 12),
		Size = UDim2.new(1, -84 - (if opts.Badge then 64 else 0), 0, 20),
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	if opts.Badge then
		local badge = text(card, opts.Badge, 10, opts.BadgeColor or C.Gold, Enum.Font.GothamBlack, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 14),
			Size = UDim2.fromOffset(60, 16),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Input,
		})
		corner(badge, 4)
	end
	local detail, cost, sequence
	if definition then
		local form = schema.Forms[definition.Form]
		detail = (form and form.Label or tostring(definition.Form)) .. "  ·  " .. tostring(definition.Element)
		local ok, estimate = pcall(spec.estimate, definition)
		cost = if ok and estimate
			then fmt(estimate.ManaDemand or 0) .. " mana  ·  " .. fmt(estimate.Strain or 0) .. " strain"
			else ""
		sequence = K.sequence(definition, schema)
	else
		detail = if locked then "Unlocks with more mission XP" else "Choose a spell from your library"
		cost, sequence = "", ""
	end
	text(card, detail, 12, C.Muted, Enum.Font.GothamMedium, {
		Position = UDim2.fromOffset(74, 33),
		Size = UDim2.new(1, -84, 0, 16),
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	text(card, cost, 11, Color3.fromRGB(120, 170, 255), Enum.Font.GothamBold, {
		Position = UDim2.fromOffset(74, 50),
		Size = UDim2.new(1, -84, 0, 14),
		TextWrapped = false,
	})
	text(card, sequence, 11, C.Faint, Enum.Font.Gotham, {
		Name = "Sequence",
		Position = UDim2.fromOffset(14, 72),
		Size = UDim2.new(1, -28, 1, -78),
		TextYAlignment = Enum.TextYAlignment.Top,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	return card, edge
end

-- Home: quick actions plus the nine equipped slots.
-- data = { Slots = {{Number, Spell, Locked, Draft, Selected}}, ResumeDraft = bool }
-- actions = { create, library, training, openSlot(number) }
function Hub.home(scroll, data, actions, schema, spec)
	local root = new("Frame", {
		Name = "HubHome",
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
	}, scroll)
	list(root, 14)
	local quick = new("Frame", {
		Name = "QuickActions",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
	}, root)
	local quickGrid = new("UIGridLayout", {
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, quick)
	local function action(order, icon, color, title, blurb, callback, name)
		local item = new("TextButton", {
			Name = name,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = C.Card,
			LayoutOrder = order,
		}, quick)
		corner(item, 12)
		stroke(item, if order == 1 then C.Gold else C.PanelEdge, 1, if order == 1 then 0.3 else 0)
		K.hover(item, C.Card, C.CardHover)
		item.Activated:Connect(callback)
		local glyph = text(item, icon, 22, color, Enum.Font.GothamBold, {
			Position = UDim2.new(0, 14, 0.5, -22),
			Size = UDim2.fromOffset(44, 44),
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Input,
		})
		corner(glyph, 22)
		stroke(glyph, color, 1, 0.5)
		text(item, title, 15, C.Ink, Enum.Font.GothamBold, {
			Position = UDim2.fromOffset(70, 14),
			Size = UDim2.new(1, -80, 0, 20),
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		text(item, blurb, 12, C.Muted, Enum.Font.Gotham, {
			Position = UDim2.fromOffset(70, 36),
			Size = UDim2.new(1, -80, 1, -42),
			TextYAlignment = Enum.TextYAlignment.Top,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
	end
	action(
		1,
		"+",
		C.Ember,
		"NEW SPELL",
		"Open the Spell Forge with a starter projectile.",
		actions.create,
		"CreateNewSpell"
	)
	if data.ResumeDraft then
		action(
			4,
			"»",
			C.Warn,
			"RESUME DRAFT",
			"Pick up the unsaved spell you were forging.",
			actions.resume,
			"ResumeDraft"
		)
	end
	action(
		2,
		"■",
		C.Gold,
		"SPELL LIBRARY",
		"Browse, edit, duplicate, and equip saved spells.",
		actions.library,
		"OpenLibrary"
	)
	action(
		3,
		"●",
		C.Frost,
		"TRAINING & TARGETS",
		"Spawn dummies, reset resources, and sandbox controls.",
		actions.training,
		"OpenTrainingTargets"
	)
	text(root, "EQUIPPED SPELLS  ·  PRESS 1-9 TO CAST", 11, C.Faint, Enum.Font.GothamBlack, {
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 2,
	})
	local slots = new("Frame", {
		Name = "NineEquippedSlots",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
	}, root)
	local slotGrid = new("UIGridLayout", {
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, slots)
	for _, slot in data.Slots do
		Hub.spellCard(slots, slot.Spell, {
			Name = "EquippedSlot_" .. slot.Number,
			Number = slot.Number,
			Order = slot.Number,
			Locked = slot.Locked,
			Selected = slot.Selected,
			Badge = if slot.Locked then "LOCKED" elseif slot.Draft then "DRAFT" else nil,
			BadgeColor = if slot.Locked then C.Faint else C.Gold,
			Schema = schema,
			Spec = spec,
			OnClick = function()
				actions.openSlot(slot.Number)
			end,
		})
	end
	local function relayout()
		local width = root.AbsoluteSize.X
		local columns = if width >= 860 then 3 elseif width >= 520 then 2 else 1
		quickGrid.CellSize = UDim2.new(1 / columns, -10 * (columns - 1) / columns, 0, 84)
		slotGrid.CellSize = UDim2.new(1 / columns, -10 * (columns - 1) / columns, 0, 118)
	end
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout)
	relayout()
	return root
end

return Hub
