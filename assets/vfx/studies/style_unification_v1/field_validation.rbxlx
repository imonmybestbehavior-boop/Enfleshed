          <Properties>
            <string name="Name">CombatBattleMap</string>
            <string name="Source"><![CDATA[--!strict
-- Seeded Studio battle-map tuning. The world footprint stays near 1024 square studs.
return {
	Enabled = true,
	Seed = 420731,
	HalfExtent = 512,
	GroundY = 0,
	CastleRadius = 92,
	MoatInnerRadius = 112,
	MoatOuterRadius = 154,
	MoatDepth = 12,
	OutskirtsCoverSpacing = 46,
	CoverJitter = 16,
	SpawnRadius = 390,
	Spawn = Vector3.new(0, 5, 390),
	PracticeTargets = Vector3.new(0, 0, 0),
	SpawnCount = 8,
	LandmarkCount = 8,
	CoverProbability = 0.72,
	HillCount = 36,
	RockClusterCount = 42,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">DefendTheWalls</string>
            <string name="Source"><![CDATA[--!strict
-- Provisional mission tuning. Studio acceleration never writes real progression.
return {
	Duration = 600,
	Preparation = 20,
	Results = 12,
	MaxParticipants = 4,
	-- Staging courtyard behind the inner bastion; the first defender line is wall 1.
	-- The live defender spawn follows the active wall (Workspace.DefendTheWalls.DefenderSpawn).
	Hub = Vector3.new(0, 6, 1362),
	Defender = Vector3.new(0, 6, 1140),
	Gateway = Vector3.new(0, 5, 1389), -- the final doors; their HP is still reported as Gateway
	GatewayIntegrity = 1000,
	-- Integrity of walls 1-3. All gates of one wall share its pool; only the doors lose the mission.
	Walls = { Integrity = { 650, 800, 950 }, Count = 3 },
	Map = {
		Seed = 1693,
		BranchChance = 0.3, -- chance an enemy targets another lane's gate via the crossroads
		Lighting = {
			ClockTime = 0.4,
			Brightness = 1.4,
			Exposure = 0.35, -- lifted for handheld screens; Steam Deck checked at this value
			Ambient = Color3.fromRGB(34, 38, 48),
			OutdoorAmbient = Color3.fromRGB(58, 66, 84),
			FogDensity = 0.38,
		},
	},
	-- Guard squads per wall. Spawned at preparation, never respawn within a round,
	-- fall back to the next wall when theirs is breached.
	Guards = {
		PerWall = {
			{ Spearman = 4, Crossbowman = 2 },
			{ Spearman = 3, Crossbowman = 3 },
			{ Spearman = 2, Crossbowman = 4 },
		},
		MaxTotal = 18,
		ThinkInterval = 0.3,
		RetreatTimeout = 14,
		Spearman = { Health = 240, Damage = 16, Range = 7, Cooldown = 1.3, Leash = 24, WalkSpeed = 15 },
		Crossbowman = { Health = 150, Damage = 20, Range = 85, Cooldown = 2.4, Leash = 0, WalkSpeed = 14 },
	},
	GatewayWarnings = { 0.75, 0.5, 0.25 },
	GatewayDamageScale = { Basic = 0.25, Swift = 0.2, Brute = 0.65, Elite = 1.1 },
	RepairCharges = 2,
	RepairAmount = 180,
	RepairDistance = 12,
	StuckTimeout = 32,
	Phases = {
		{ At = 0, Name = "INITIAL INCURSION", Interval = 7, Target = 3, Cap = 9, Budget = 65, Lanes = { 1 } },
		{ At = 120, Name = "MULTIPLE APPROACHES", Interval = 6, Target = 5, Cap = 10, Budget = 65, Lanes = { 1, 2 } },
		{
			At = 240,
			Name = "SUSTAINED ASSAULT",
			Interval = 5.5,
			Target = 6,
			Cap = 10,
			Budget = 65,
			Lanes = { 1, 2, 3 },
		},
		{ At = 360, Name = "BREACH THREAT", Interval = 5, Target = 7, Cap = 10, Budget = 80, Lanes = { 1, 2, 3 } },
		{ At = 510, Name = "LAST STAND", Interval = 4.5, Target = 8, Cap = 11, Budget = 55, Lanes = { 1, 2, 3 } },
	},
	Rewards = { VictoryXP = 120, VictoryMarks = 50, DefeatXP = 30, DefeatMarks = 10, BonusXP = 20, BonusMarks = 10 },
	Studio = { Accelerated = false, Duration = 120, MockProgression = true },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">DefendTheWallsAssets</string>
            <string name="Source"><![CDATA[--!strict
-- Asset manifest for the Defend the Walls siege kit, in the same spirit as the
-- spell VFX manifest. Blockout stage: every piece is built from Parts by
-- DefendTheWallsMap, and MeshId is empty until the Blender kit
-- (tools/vfx_pipeline/blender.sh, sources under assets/siege/) is exported and
-- uploaded. When an entry gets a MeshId the builder can swap the Part blockout
-- for the mesh without touching layout code.
export type Piece = {
	Kit: string, -- builder that places it
	Source: string, -- Blender source / export path, relative to the repo
	MeshId: string, -- rbxassetid:// once uploaded; "" while blockout
	Size: Vector3, -- footprint the layout code reserves
}

local Assets: { [string]: Piece } = {
	WallSegment = {
		Kit = "Walls",
		Source = "assets/siege/wall_segment.fbx",
		MeshId = "",
		Size = Vector3.new(10, 22, 8),
	},
	PalisadeSegment = {
		Kit = "Walls",
		Source = "assets/siege/palisade_segment.fbx",
		MeshId = "",
		Size = Vector3.new(10, 14, 5),
	},
	Tower = { Kit = "Walls", Source = "assets/siege/tower.fbx", MeshId = "", Size = Vector3.new(16, 32, 16) },
	LaneGate = { Kit = "Walls", Source = "assets/siege/lane_gate.fbx", MeshId = "", Size = Vector3.new(20, 16, 2) },
	FinalDoors = { Kit = "Gate", Source = "assets/siege/final_doors.fbx", MeshId = "", Size = Vector3.new(26, 34, 3) },
	HouseWall = { Kit = "Village", Source = "assets/siege/house_wall.fbx", MeshId = "", Size = Vector3.new(16, 9, 1) },
	HouseRoof = { Kit = "Village", Source = "assets/siege/house_roof.fbx", MeshId = "", Size = Vector3.new(18, 7, 8) },
	ChapelRuin = {
		Kit = "Village",
		Source = "assets/siege/chapel_ruin.fbx",
		MeshId = "",
		Size = Vector3.new(26, 30, 38),
	},
	CorridorArch = {
		Kit = "Corridors",
		Source = "assets/siege/corridor_arch.fbx",
		MeshId = "",
		Size = Vector3.new(43, 26, 5),
	},
	CorridorWall = {
		Kit = "Corridors",
		Source = "assets/siege/corridor_wall.fbx",
		MeshId = "",
		Size = Vector3.new(3, 13, 10),
	},
	Brazier = { Kit = "Props", Source = "assets/siege/brazier.fbx", MeshId = "", Size = Vector3.new(4, 5, 4) },
	Cart = { Kit = "Props", Source = "assets/siege/cart.fbx", MeshId = "", Size = Vector3.new(5, 4, 8) },
	Gallows = { Kit = "Props", Source = "assets/siege/gallows.fbx", MeshId = "", Size = Vector3.new(12, 14, 8) },
	DeadTree = { Kit = "Props", Source = "assets/siege/dead_tree.fbx", MeshId = "", Size = Vector3.new(10, 18, 10) },
}

return Assets
]]></string>
          </Properties>
        </Item>
