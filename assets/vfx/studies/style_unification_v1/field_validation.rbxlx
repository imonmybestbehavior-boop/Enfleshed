				Light = 1,
			},
			Drivers = { { "Rate", "Potency", 20 }, { "Rate", "Size", 8 } },
		}),
		layer({
			Id = "Fire.Ambient.Smoke",
			Slot = "Ambient",
			Kind = "Emitter",
			Priority = 3,
			Texture = "smoke_billow",
			Colors = { "Ash", "Soot" },
			Params = {
				Rate = 3,
				Lifetime = 0.9,
				Speed = 0.5,
				Spread = 30,
				Direction = "Back",
				Size = 1.2,
				SizeEnd = 2.4,
				Rise = 1.5,
				Light = 0,
				OneShot = 1,
				Opacity = 0.55,
			},
			Drivers = { { "Rate", "Lifetime", 6 } },
		}),
		layer({
			Id = "Fire.Ambient.Light",
			Slot = "Ambient",
			Kind = "Light",
			Priority = 2,
			Colors = "Body",
			Params = { Brightness = 1.3, Range = 10 },
			Drivers = { { "Brightness", "Potency", 1 }, { "Range", "Size", 6 } },
		}),
		-- Impact: brief flash, lobed explosion, separately readable shockwave, embers, debris.
		layer({
			Id = "Fire.Impact.Flash",
			Roles = { Impact = true },
			Slot = "Impact",
			Kind = "Burst",
			Priority = 1,
			Texture = "glow_soft",
			Colors = { "WhiteHot", "Hot" },
			Params = { Count = 1, Lifetime = 0.12, Speed = 0, Size = 5, SizeEnd = 7, Light = 1 },
			Drivers = { { "Size", "Area", 4 } },
		}),
		layer({
			Id = "Fire.Impact.Star",
