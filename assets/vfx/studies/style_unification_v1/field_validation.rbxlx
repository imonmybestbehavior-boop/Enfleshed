		wind_funnel = table.freeze({ Id = "rbxassetid://133194397915751", Fallback = "Cylinder", Size = Vector3.new(2.38, 3.25, 2.298), Triangles = 480, Source = "assets/vfx/meshes/wind_funnel.fbx" }),
