        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">SpellProgression</string>
            <string name="Source"><![CDATA[--!strict
-- Public combat progression. Studio's unrestricted spell workshop is separate.
return {
	StartingSlots = 4,
	SlotMilestones = { { Slots = 6, XP = 500 }, { Slots = 9, XP = 1800 } },
	Unlocks = {
		AdvancedForms = { Name = "Advanced Forms", XP = 250, Marks = 80, Label = "Fields, auras, waves and constructs" },
		AdvancedBehaviors = {
			Name = "Advanced Behaviors",
			XP = 600,
			Marks = 140,
			Label = "Projectile behaviors and complex triggers",
		},
		AdvancedEffects = {
			Name = "Advanced Effects",
			XP = 1000,
			Marks = 200,
			Label = "Control, summons and specialist effects",
		},
		VisualCraft = { Name = "Visual Craft", XP = 350, Marks = 60, Label = "Expanded spell appearance" },
	},
	UnlockOrder = { "AdvancedForms", "AdvancedBehaviors", "AdvancedEffects", "VisualCraft" },
	RankPrices = { 100, 200, 350 },
	RankXP = { 0, 450, 1200 },
	-- Server-calculated limits for a spell's total upfront cost and complexity.
	RankManaLimits = { 45, 70, 105, 160 },
	RankStrainLimits = { 25, 40, 65, 100 },
	RankComplexityLimits = { 8, 12, 17, 26 },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">SpellStatCaps</string>
            <string name="Source"><![CDATA[--!strict
-- Stat-cap profiles applied when a spell resolves against a target. The profile
-- depends on who is hit (see Modules/SpellStatCaps): NPCs/world → PvE, players in
-- an open zone or duel → PvPOpen, players in a ranked zone → PvPRanked.
-- Caps limit the *final* value after potency. Omitted caps are unlimited.
-- Starting values; tune from PvP playtests and SpellUsage analytics.
return {
	PvE = {}, -- identity: PvE balance is governed by rank budgets and MagicLab limits
	PvPOpen = {
		DamageMultiplier = 0.6, -- every damage source (spells, DoT, melee, summons) vs players
		MaxDamagePerHit = 35,
		MaxDotPerTick = 4,
		MaxHealPerHit = 30,
		MaxShield = 40,
		MinSlowMultiplier = 0.5, -- at most a 50% slow
		MaxEffectDuration = 4, -- slow, bind, control, reveal, time dilation, transformation, marks, stat changes
		MaxBindDuration = 1,
		MaxControlAcceleration = 16,
		MaxDisplacement = 8,
		MaxForce = 40,
		MinTimeRate = 0.6,
		MaxTransformScale = 1.2,
		MinTransformScale = 0.85,
		MaxAttributeChange = 25,
	},
	PvPRanked = {
		DamageMultiplier = 0.5,
		MaxDamagePerHit = 30,
		MaxDotPerTick = 3,
		MaxHealPerHit = 25,
		MaxShield = 30,
		MinSlowMultiplier = 0.6,
		MaxEffectDuration = 3,
		MaxBindDuration = 0.75,
		MaxControlAcceleration = 12,
		MaxDisplacement = 6,
		MaxForce = 30,
		MinTimeRate = 0.7,
		MaxTransformScale = 1.15,
		MinTransformScale = 0.9,
		MaxAttributeChange = 20,
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Spells</string>
            <string name="Source"><![CDATA[--!strict

-- Registered data interpreted by MagicService. New V1 projectile spells should
-- normally add data here, not another spell-specific service.
local Sandbox = require(script.Parent.Sandbox)
local V2 = Sandbox.Magic.V2

return table.freeze({
	Fireball = {
		SpellId = "Fireball",
		Name = "Fireball",
		Version = 1,
		Tags = { "Energy", "Fire" },
		Source = { Principle = "Energy", Expression = "Fire" },
		Form = "Projectile",
		Targeting = "AimDirection",
		Geometry = "Sphere",
		Motion = "Linear",
		Casting = { Mode = "Instant", Cooldown = 0.45 },
		Lifetime = { Mode = "FixedDuration", Duration = 2.2 },
		Cost = { ManaDemand = 18, Strain = 8, Complexity = 2 },
		Projectile = { Speed = 72, Radius = 1.1 },
		Visual = { Color = Color3.fromRGB(255, 105, 50) },
		Triggers = {
			OnImpact = {
				{ Payloads = { { Kind = "Damage", Amount = 10 } } },
				{ Behavior = "Explode", Radius = 7, Payloads = { { Kind = "Damage", Amount = 18 } } },
			},
		},
	},
	BodyBurst = {
		SpellId = "BodyBurst",
		Name = "Body Burst",
		Version = 1,
		Tags = { "Body", "Enhancement" },
		Source = { Principle = "Body", Expression = "BodyEnhancement" },
		Form = "Wave",
		Targeting = "Self",
		Geometry = "Cone",
		Motion = "Stationary",
		Casting = { Mode = "Instant", Cooldown = 1.2 },
		Lifetime = { Mode = "Instantaneous" },
		Cost = { ManaDemand = 22, Strain = 14, Complexity = 3 },
		Wave = {
			Range = 10,
			Dot = 0.35,
			DebugDuration = 0.18,
			Payloads = {
				{ Kind = "Damage", Amount = 16 },
				{ Kind = "Force", Magnitude = 54, Upward = 8 },
			},
		},
		Triggers = { OnCast = true },
	},
	StoneShot = {
