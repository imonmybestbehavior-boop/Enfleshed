          <Item class="ModuleScript" referent="281">
            <Properties>
              <string name="Name">VFXDefinitions</string>
              <string name="Source"><![CDATA[-- Allowlisted, asset-free authored presets. All use the shared composition grammar.
local presets = {
	FireBurst = { Element = "Fire", Form = "Field", Phase = "Impact", Duration = 1 },
	FireProjectile = { Element = "Fire", Form = "Projectile" },
	FrostCharge = { Element = "Ice", Form = "Aura", Phase = "Gather", Duration = 1.2 },
	FrostProjectile = { Element = "Ice", Form = "Projectile" },
	ArcaneTrail = { Element = "Neutral", Form = "Aura" },
	ArcaneProjectile = { Element = "Neutral", Form = "Projectile" },
}
local definitions = {}
for id, config in pairs(presets) do
	config.Preset = id
	definitions[id] = { Effects = { { Type = "Composition", Config = config } } }
end
return definitions
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="282">
          <Properties>
            <string name="Name">Effects</string>
          </Properties>
          <Item class="ModuleScript" referent="283">
            <Properties>
              <string name="Name">Animation</string>
              <string name="Source"><![CDATA[--!strict
-- Plays an Animation asset on the target's Animator; caller owns animation permissions/assets.
local function animatorFor(target)
	if typeof(target) ~= "Instance" then
		return nil
	end
	local model = if target:IsA("Model") then target else target:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		return humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	end
	local controller = model:FindFirstChildOfClass("AnimationController")
	if controller then
		return controller:FindFirstChildOfClass("Animator") or Instance.new("Animator", controller)
	end
	return nil
end
return {
	Run = function(session, config, target)
		local animator = animatorFor(target)
		if not animator or type(config.AnimationId) ~= "string" then
			return
		end
		local animation = Instance.new("Animation")
		animation.AnimationId = config.AnimationId
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if not ok or not track then
			animation:Destroy()
			return
		end
		track:Play(config.FadeTime or 0.1, config.Weight or 1, config.Speed or 1)
		session:AddCleanup(function()
			pcall(function()
				track:Stop(config.FadeTime or 0.1)
				track:Destroy()
			end)
			animation:Destroy()
		end)
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="284">
            <Properties>
              <string name="Name">Attachment</string>
              <string name="Source"><![CDATA[--!strict
-- Creates a named attachment on a target BasePart or Model root.
return {
	Run = function(session, config, target)
		local parent = target
		if typeof(target) == "Instance" and target:IsA("Model") then
			parent = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
		end
		if typeof(parent) ~= "Instance" or not parent:IsA("BasePart") then
			return
		end
		local attachment = Instance.new("Attachment")
		attachment.Name = config.Name or "VFXAttachment"
		attachment.Position = config.Position or Vector3.zero
		attachment.Parent = parent
		session:AddCleanup(function()
			if attachment.Parent then
				attachment:Destroy()
			end
		end)
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="285">
            <Properties>
              <string name="Name">Beam</string>
              <string name="Source"><![CDATA[--!strict
-- Connects named attachments or a target attachment to a temporary point endpoint.
local RunService = game:GetService("RunService")
return {
	Run = function(session, config, target, context)
		if typeof(target) ~= "Instance" then
			return
		end
		local function getAttachment(name)
			local found = target:FindFirstChild(name or "", true)
			return if found and found:IsA("Attachment") then found else nil
		end
		local from = getAttachment(config.From or config.Attachment0)
		local to = getAttachment(config.To or config.Attachment1)
		if not from then
			return
		end
		local endpoint
		if not to and typeof(config.Point) == "Vector3" then
			local holder = Instance.new("Part")
			holder.Name = "VFXBeamEndpoint"
			holder.Anchored, holder.Transparency = true, 1
			holder.CanCollide, holder.CanTouch, holder.CanQuery = false, false, false
			holder.Size, holder.Position, holder.Parent = Vector3.one * 0.05, config.Point, session.Holder
			endpoint = Instance.new("Attachment")
			endpoint.Parent = holder
			to = endpoint
		end
		if not to then
			return
		end
		local beam = Instance.new("Beam")
		beam.Attachment0, beam.Attachment1 = from, to
		beam.Color = ColorSequence.new(config.Color or context.Color or Color3.new(1, 1, 1))
		beam.Width0, beam.Width1 = config.Width0 or 0.4, config.Width1 or 0.05
		beam.Texture, beam.TextureSpeed = config.Texture or "", config.TextureSpeed or 0
		beam.Parent = from.Parent
		session:AddCleanup(function()
			if beam.Parent then
				beam:Destroy()
			end
		end)
		if config.Duration then
			local started = os.clock()
			local connection = RunService.Heartbeat:Connect(function()
				if os.clock() - started >= math.clamp(config.Duration, 0.05, 30) and beam.Parent then
					beam:Destroy()
					connection:Disconnect()
				end
			end)
			session:AddConnection(connection)
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="286">
            <Properties>
              <string name="Name">CameraShake</string>
              <string name="Source"><![CDATA[--!strict
-- Local-only bounded camera impulse. Remote delivery is handled by the server bridge.
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
return {
	Run = function(session, config, target)
		if not RunService:IsClient() then
			return
		end
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local origin = if typeof(target) == "Vector3"
			then target
			elseif typeof(target) == "Instance" and target:IsA("BasePart") then target.Position
			else nil
		local distance = if origin
				and Players.LocalPlayer.Character
				and Players.LocalPlayer.Character.PrimaryPart
			then (Players.LocalPlayer.Character.PrimaryPart.Position - origin).Magnitude
			else 0
		local maxDistance = math.max(1, config.Falloff or 100)
		local strength = math.clamp(config.Magnitude or 0.3, 0, 5) * math.clamp(1 - distance / maxDistance, 0, 1)
		local duration = math.clamp(config.Duration or 0.25, 0.02, 5)
		local started = os.clock()
		local connection
		connection = RunService.RenderStepped:Connect(function()
			local elapsed = os.clock() - started
			if elapsed >= duration or not camera.Parent then
				connection:Disconnect()
				return
			end
			local fade = 1 - elapsed / duration
			local offset = Vector3.new((math.random() - 0.5) * 2, (math.random() - 0.5) * 2, 0) * strength * fade * 0.08
			camera.CFrame *= CFrame.new(offset)
		end)
		session:AddConnection(connection)
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="287">
            <Properties>
              <string name="Name">Color</string>
              <string name="Source"><![CDATA[--!strict
-- Tints supported visual descendants immediately or over time; never changes gameplay state.
local TweenService = game:GetService("TweenService")
return {
	Run = function(session, config, target, context)
		if typeof(target) ~= "Instance" then
			return
		end
		local color = config.Color or context.Color
		if typeof(color) ~= "Color3" then
			return
		end
		local duration = math.clamp(tonumber(config.Duration) or 0, 0, 10)
		local targets = {}
		if target:IsA("ParticleEmitter") or target:IsA("Beam") or target:IsA("Trail") or target:IsA("Light") then
			table.insert(targets, target)
		end
		for _, item in target:GetDescendants() do
			if item:IsA("ParticleEmitter") or item:IsA("Beam") or item:IsA("Trail") or item:IsA("Light") then
				table.insert(targets, item)
			end
		end
		for _, item in targets do
			local property = if item:IsA("Light") then "Color" else "Color"
			if duration == 0 then
				item[property] = color
			else
				local goal = if item:IsA("Beam")
						or item:IsA("Trail")
						or item:IsA("ParticleEmitter")
					then { Color = ColorSequence.new(color) }
					else { Color = color }
				local tween = TweenService:Create(item, TweenInfo.new(duration), goal)
				session:AddTween(tween):Play()
			end
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="288">
            <Properties>
              <string name="Name">Composition</string>
              <string name="Source"><![CDATA[-- Existing preset playback routes through the same composer; no missing template assets.
local Analyzer = require(script.Parent.Parent.Core.SpellVFXAnalyzer)
local Composer = require(script.Parent.Parent.Core.SpellVFXComposer)
return {
	Run = function(session, config, target, context)
		local anchor = target
		if typeof(target) == "Vector3" then
			anchor = Instance.new("Part")
			anchor.Anchored, anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = true, false, false, false
			anchor.Transparency = 1
			anchor.Position = target
			anchor.Parent = session.Holder
		elseif target:IsA("Model") then
			anchor = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
		end
		if not anchor or not anchor:IsA("BasePart") then
			return
		end
		local plan = Analyzer.resolve({
			Form = config.Form,
			Element = config.Element,
			Visual = { Color = context.Color, VFXDefinition = config.Preset },
		})
		plan.Phase = config.Phase
		local effect = Composer.attach(
			anchor,
			plan,
			{ Parent = session.Holder, Duration = config.Duration or 3, Size = Vector3.one * 3 }
		)
		if effect then
			session:AddCleanup(function()
				effect:Stop()
			end)
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="289">
            <Properties>
              <string name="Name">Light</string>
              <string name="Source"><![CDATA[--!strict
-- Creates a short-lived point/spot light and fades its brightness and range.
local TweenService = game:GetService("TweenService")
return {
	Run = function(session, config, target, context)
		local parent = if typeof(target) == "Instance" then target else nil
		if parent and parent:IsA("Model") then
			parent = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
		end
		if not parent or not parent:IsA("BasePart") then
			if typeof(target) ~= "Vector3" then
				return
			end
			local part = Instance.new("Part")
			part.Anchored, part.Transparency, part.CanCollide = true, 1, false
			part.Size, part.Position, part.Parent = Vector3.one * 0.1, target, session.Holder
			parent = part
		end
		local light = if config.Spot then Instance.new("SpotLight") else Instance.new("PointLight")
		light.Color = config.Color or context.Color or Color3.new(1, 1, 1)
		light.Range, light.Brightness = math.clamp(config.Range or 12, 0, 60), math.clamp(config.Brightness or 2, 0, 10)
		light.Parent = parent
		local duration = math.clamp(config.Duration or 0.4, 0.05, 10)
		local tween = TweenService:Create(light, TweenInfo.new(duration), { Brightness = 0, Range = 0 })
		session:AddTween(tween):Play()
		task.delay(duration, function()
			if light.Parent then
				light:Destroy()
			end
		end)
		session:AddCleanup(function()
			if light.Parent then
				light:Destroy()
			end
		end)
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="290">
            <Properties>
              <string name="Name">Mesh</string>
              <string name="Source"><![CDATA[--!strict
-- Spawns a configurable decorative MeshPart/SpecialMesh and animates its transform.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local function positionOf(target)
	if typeof(target) == "Vector3" then
		return target
	end
	if typeof(target) == "Instance" then
		if target:IsA("BasePart") then
			return target.Position
		end
		if target:IsA("Attachment") then
			return target.WorldPosition
		end
		if target:IsA("Model") then
			return target:GetPivot().Position
		end
	end
	return nil
end
return {
	Run = function(session, config, target, context)
		local assets = ReplicatedStorage:FindFirstChild(config.AssetsFolder or "SpellVFXAssets")
		local source = assets and assets:FindFirstChild(config.Template or "")
		local part
		if source and source:IsA("BasePart") then
			part = source:Clone()
		else
			part = Instance.new("Part")
			part.Shape = Enum.PartType.Ball
			part.Material = Enum.Material.Neon
			part.Color = config.Color or context.Color or Color3.new(1, 1, 1)
			part.Size = Vector3.one
			if config.InstanceName then
				part.Name = config.InstanceName
			end
		end
		part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
		local position = positionOf(target)
		if not position then
			part:Destroy()
			return
		end
		part.CFrame = CFrame.new(position)
			* CFrame.Angles(
				math.rad(config.RotationX or 0),
				math.rad(config.RotationY or 0),
				math.rad(config.RotationZ or 0)
			)
		part.Parent = session.Holder
		session:AddCleanup(function()
			if part.Parent then
				part:Destroy()
			end
		end)
		if config.Scale then
			part.Size = config.Scale
		end
		if config.Transparency ~= nil then
			part.Transparency = config.Transparency
		end
		local mesh = part:FindFirstChildWhichIsA("SpecialMesh")
		if mesh and config.MeshScale then
			mesh.Scale = config.MeshScale
		end
		if config.SpinRate and config.SpinRate ~= 0 and part.Parent == session.Holder then
			local connection = RunService.Heartbeat:Connect(function(dt)
				if session.Active and part.Parent then
					part.CFrame *= CFrame.Angles(0, (config.SpinRate :: number) * dt, 0)
				end
			end)
			session:AddConnection(connection)
		end
		if config.Lifetime then
			local lifetime = math.clamp(config.Lifetime, 0.05, 30)
			local thread = task.delay(lifetime, function()
				if part.Parent then
					part:Destroy()
				end
			end)
			table.insert(session.Tasks, thread)
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="291">
            <Properties>
              <string name="Name">Particles</string>
              <string name="Source"><![CDATA[--!strict
-- Clones a named ParticleEmitter template and can follow a moving BasePart.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local function findTargetPart(target, name)
	if typeof(target) ~= "Instance" then
		return nil
	end
	if name and name ~= "" then
		local found = target:FindFirstChild(name, true)
		if found and found:IsA("Attachment") then
			return found
		end
	end
	if target:IsA("BasePart") then
		return target
	end
	if target:IsA("Model") then
		return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end
return {
	Run = function(session, config, target, context)
		local assets = ReplicatedStorage:FindFirstChild(config.AssetsFolder or "SpellVFXAssets")
		local template = assets and assets:FindFirstChild(config.Template or "")
		local parent = findTargetPart(target, config.Attachment)
		if not parent then
			return
		end
		local emitter
		if template and template:IsA("ParticleEmitter") then
			emitter = template:Clone()
		else
			emitter = Instance.new("ParticleEmitter")
			local fireTemplate = string.find(config.Template or "", "Fire") ~= nil
			emitter.Texture = if fireTemplate
				then "rbxasset://textures/particles/fire_main.dds"
				else "rbxasset://textures/particles/sparkles_main.dds"
			emitter.Lifetime = if fireTemplate then NumberRange.new(0.3, 0.65) else NumberRange.new(0.35, 0.85)
			emitter.Speed = if fireTemplate then NumberRange.new(0.3, 1.8) else NumberRange.new(4, 12)
			emitter.SpreadAngle = Vector2.new(180, 180)
			emitter.Size = if fireTemplate then NumberSequence.new(1.05, 0) else NumberSequence.new(0.28, 0)
			emitter.Transparency = NumberSequence.new(0.05, 1)
			emitter.LightEmission = 0.9
		end
		if typeof(config.Color or context.Color) == "Color3" then
			emitter.Color = ColorSequence.new(config.Color or context.Color)
		end
		if type(config.Rate) == "number" then
			emitter.Rate = math.clamp(config.Rate, 0, 100)
			emitter.Enabled = emitter.Rate > 0
		end
		if type(config.Count) == "number" then
			emitter:Emit(math.clamp(math.floor(config.Count), 0, 500))
		end
		if config.Speed then
			emitter.Speed = typeof(config.Speed) == "NumberRange" and config.Speed or NumberRange.new(config.Speed)
		end
		if config.Size then
			emitter.Size = typeof(config.Size) == "NumberSequence" and config.Size or NumberSequence.new(config.Size)
		end
		emitter.Parent = parent
		if config.Follow then
			emitter.Parent = parent
			session:AddCleanup(function()
				if emitter.Parent then
					local lifetime = math.clamp(config.Lifetime or 3, 0.1, 30)
					local attachment = Instance.new("Attachment")
					attachment.Name = "ExpiredVFXTrail"
					attachment.Parent = emitter.Parent
					emitter.Parent = attachment
					emitter.Enabled = false
					task.delay(math.clamp(config.Lifetime or 3, 0.1, 30), function()
						if attachment.Parent then
							attachment:Destroy()
						end
					end)
				end
			end)
		else
			Debris:AddItem(emitter, math.clamp(config.Lifetime or 3, 0.1, 30))
			session:AddCleanup(function()
				if emitter.Parent then
					emitter:Destroy()
				end
			end)
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="292">
            <Properties>
              <string name="Name">Scripted</string>
              <string name="Source"><![CDATA[--!strict
-- Safe escape hatch: only functions explicitly registered in ScriptLibrary can run.
local ScriptLibrary = require(script.Parent.Parent.Data.ScriptLibrary)
return {
	Run = function(session, config, target, context)
		local callback = ScriptLibrary[config.Key]
		if type(callback) == "function" and session.Active then
			callback(session, config.Params or {}, target, context)
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="293">
            <Properties>
              <string name="Name">Sound</string>
              <string name="Source"><![CDATA[--!strict
-- Plays a positional sound asset and releases it when the session ends.
local Debris = game:GetService("Debris")
return {
	Run = function(session, config, target)
		local parent
		if typeof(target) == "Instance" then
			parent = target
			if target:IsA("Model") then
				parent = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
			end
		elseif typeof(target) == "Vector3" then
			local part = Instance.new("Part")
			part.Name, part.Anchored, part.Transparency = "VFXSoundPoint", true, 1
			part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
			part.Size, part.Position, part.Parent = Vector3.one * 0.1, target, session.Holder
			parent = part
		end
		if not parent then
			return
		end
		local sound = Instance.new("Sound")
		sound.SoundId = config.SoundId or ""
		sound.Volume = math.clamp(config.Volume or 0.5, 0, 10)
		sound.PlaybackSpeed = math.clamp(config.Pitch or 1, 0.25, 4)
		sound.RollOffMaxDistance = math.clamp(config.Range or 80, 1, 500)
		sound.Parent = parent
		sound:Play()
		Debris:AddItem(sound, math.clamp(config.Lifetime or 10, 0.1, 30))
		session:AddCleanup(function()
			if sound.Parent then
				sound:Stop()
				sound:Destroy()
			end
		end)
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="294">
            <Properties>
              <string name="Name">Trail</string>
              <string name="Source"><![CDATA[--!strict
-- Adds a Trail between named attachments on a BasePart/Model.
return {
	Run = function(session, config, target, context)
		if typeof(target) ~= "Instance" then
			return
		end
		local function attachment(name)
			local item = target:FindFirstChild(name or "", true)
			return if item and item:IsA("Attachment") then item else nil
		end
		local a0, a1 = attachment(config.Attachment0), attachment(config.Attachment1)
		if not a0 or not a1 then
			return
		end
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1 = a0, a1
		trail.Color = ColorSequence.new(config.Color or context.Color or Color3.new(1, 1, 1))
		trail.Lifetime = math.clamp(config.Lifetime or 0.35, 0.05, 10)
		trail.Transparency = config.Transparency or NumberSequence.new(0, 1)
		trail.Parent = a0.Parent
		session:AddCleanup(function()
			if trail.Parent then
				trail:Destroy()
			end
		end)
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="295">
            <Properties>
              <string name="Name">Tween</string>
              <string name="Source"><![CDATA[--!strict
-- Tweens an explicitly named instance property map. Goals are data-only and validated by TweenService.
local TweenService = game:GetService("TweenService")
local function resolve(target, name)
	if typeof(target) ~= "Instance" then
		return nil
	end
	if type(name) ~= "string" or name == "" then
		return target
	end
	return target:FindFirstChild(name, true)
end
return {
	Run = function(session, config, target)
		local instance = if type(config.InstanceName) == "string" and config.InstanceName ~= ""
			then session.Holder:FindFirstChild(config.InstanceName) or resolve(target, config.InstanceName)
			else resolve(target, config.InstanceName)
		if not instance or type(config.Goals) ~= "table" then
			return
		end
		local info = config.TweenInfo or {}
		local tweenInfo = TweenInfo.new(
			math.clamp(info.Duration or 0.35, 0, 30),
			info.EasingStyle or Enum.EasingStyle.Quad,
			info.EasingDirection or Enum.EasingDirection.Out,
			math.clamp(info.RepeatCount or 0, -1, 100),
			info.Reverses == true,
			math.clamp(info.DelayTime or 0, 0, 30)
		)
		local tween = TweenService:Create(instance, tweenInfo, config.Goals)
		session:AddTween(tween):Play()
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="296">
            <Properties>
              <string name="Name">Wait</string>
              <string name="Source"><![CDATA[--!strict
-- Sequential delay that exits as soon as its playback session stops.
return {
	Run = function(session, config)
		session:Await(math.clamp(tonumber(config.Duration) or 0, 0, 30))
	end,
}
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="297">
          <Properties>
            <string name="Name">Signature</string>
          </Properties>
          <Item class="ModuleScript" referent="298">
            <Properties>
              <string name="Name">ArcBeam</string>
              <string name="Source"><![CDATA[-- A connected, flickering polyline. Points are local to the authoritative beam host.
-- This owns cosmetic attachments/beams only; it never computes a hit or sends a remote.
local ArcBeam = {}
ArcBeam.__index = ArcBeam

function ArcBeam.new(host, parent, texture, colors, params, capacity, seed)
	if capacity < 3 then return nil end
	local count = math.clamp(math.floor(params.ArcSegments or 9), 3, math.min(10, capacity))
	local branchCount = math.min(2, math.floor((capacity - count) / 2))
	local self = setmetatable({ Points={}, Beams={}, Branches={}, Seed=seed or 0, Params=params }, ArcBeam)
	local function point()
		local a=Instance.new("Attachment");a.Name="ArcPoint";a.Parent=host
		return a
	end
	local function segment(a,b,branch)
		local beam=Instance.new("Beam");beam.Name=if branch then "ArcBranch" else "ConnectedArc"
		beam.Attachment0=a;beam.Attachment1=b;beam.FaceCamera=true;beam.Segments=1
		-- The existing strip's thin alpha becomes gaps when repeated on short segments.
		-- Solid ribbons keep every joint visibly connected; color comes from the same palette.
		beam.Texture="";beam.TextureMode=Enum.TextureMode.Stretch;beam.TextureSpeed=0
		beam.Color=colors;beam.LightEmission=.2;beam.LightInfluence=.25
		beam.Transparency=NumberSequence.new(if branch then .2 else 0)
		beam.Parent=parent;table.insert(self.Beams,{Beam=beam,Branch=branch})
	end
	for i=1,count+1 do self.Points[i]=point() end
	for i=1,count do segment(self.Points[i],self.Points[i+1],false) end
	for i=1,branchCount do
		local start=math.floor(count*(.25+i*.2))+1
		local mid,tip=point(),point()
		segment(self.Points[start],mid,true);segment(mid,tip,true)
		table.insert(self.Branches,{Start=start,Mid=mid,Tip=tip})
	end
	self.Count=#self.Beams
	return self
end

function ArcBeam:Update(range,width,age,shown,fading)
	local tick=math.floor(age*18)
	if tick~=self.Tick or range~=self.Range or width~=self.Width then
		self.Tick,self.Range,self.Width=tick,range,width
		local random=Random.new((self.Seed+tick*7919)%2147483647)
		local n=#self.Points-1
		local amplitude=math.min(1.6,range*.045,width*.6+.2)
		for i,a in self.Points do
			local u=(i-1)/n
			local spread=math.sin(u*math.pi)*amplitude
			a.Position=Vector3.new(random:NextNumber(-spread,spread),random:NextNumber(-spread,spread),-range*u)
		end
		-- Exact endpoints, including while a beam changes length or its host moves.
		self.Points[1].Position=Vector3.zero
		self.Points[#self.Points].Position=Vector3.new(0,0,-range)
		for i,branch in self.Branches do
			local origin=self.Points[branch.Start].Position
			local side=if i%2==0 then -1 else 1
			branch.Mid.Position=origin+Vector3.new(side*amplitude*.65,amplitude*.45,-range*.06)
			branch.Tip.Position=origin+Vector3.new(side*amplitude*1.3,-amplitude*.3,-range*.12)
		end
	end
	for _,entry in self.Beams do
		local w=math.max(.025,width*(self.Params.Width or .18))*(if entry.Branch then .45 else 1)*(1-fading)
		entry.Beam.Width0=w;entry.Beam.Width1=w*(if entry.Branch then .12 else .8)
		entry.Beam.Enabled=shown and fading<1
	end
end

return ArcBeam
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="299">
            <Properties>
              <string name="Name">ConnectedFire</string>
              <string name="Source"><![CDATA[-- One authored skinned body. The owning signature session supplies movement and lifetime.
-- Surface maps are configured in the asset model, never assigned by gameplay scripts.
local Poses = require(script.Parent.Parent.Assets.ConnectedFirePoses)
local Fire = {}
Fire.__index = Fire
local MAX_ACTIVE, POOL_LIMIT = 12, 8
local active, created = 0, 0
local pool = {}
local warming = false
local timing = { Updates = 0, TotalMS = 0, MaxMS = 0 }
local facing = CFrame.Angles(0, -math.pi / 2, 0)

local function template()
	local model = script.Parent.Parent.Assets:FindFirstChild("ConnectedFireRig")
	local mesh = model and model:FindFirstChild("ConnectedFireVolume")
	local frames = model and model:FindFirstChild("Frames")
	if not mesh or not mesh:IsA("MeshPart") or not frames or #frames:GetChildren() ~= 24 then return nil end
	local root = mesh:FindFirstChild("Root")
	if not root then return nil end
	for _, name in Poses.Names do
		if not root:FindFirstChild(name) then return nil end
	end
	return model
end

function Fire.ready()
	return active < MAX_ACTIVE and template() ~= nil
end

function Fire.prefetch()
	if warming then return end
	warming = true
	task.spawn(function()
		for _ = 1, POOL_LIMIT do
			if active + #pool >= POOL_LIMIT then break end
			local source = template()
			if not source then break end
			local model = source:Clone()
			model.ConnectedFireVolume.Transparency = 1
			table.insert(pool, model)
			created += 1
			task.wait() -- Spread cold skin/material cloning across startup frames.
		end
		warming = false
	end)
end

function Fire.new(parent, bodyScale)
	if active >= MAX_ACTIVE then return nil end
	local source = template()
	if not source then return nil end
	local model = table.remove(pool)
	if not model then model = source:Clone(); created += 1 end
	local mesh = model.ConnectedFireVolume
	model.PrimaryPart = mesh
	-- A 2.2-stud projectile uses a 2.2-stud wide burning mass; its wake trails behind.
	local factor = math.clamp(bodyScale or 1, 0.65, 3.5) * (2.2 / source.ConnectedFireVolume.Size.Y)
	model:ScaleTo(source:GetScale() * factor)
	mesh.Anchored = true
	mesh.CanCollide, mesh.CanTouch, mesh.CanQuery = false, false, false
	mesh.CastShadow = false
	mesh.Transparency = 1
	mesh.LocalTransparencyModifier = 0
	mesh.Color = Color3.new(1, 1, 1)
	local root = mesh.Root
	local bones, frames = {}, {}
	for i, name in Poses.Names do bones[i] = root[name] end
	for i = 1, 24 do frames[i] = model.Frames[string.format("Frame_%03d", i)] end
	model.Name = "ConnectedFireBody"
	model.Parent = parent
	active += 1
	return setmetatable({
		Model = model, Mesh = mesh, Bones = bones, Surfaces = frames, Factor = factor,
		Offset = (Vector3.new(0.4, 0, 0) - source.ConnectedFireVolume.Root.Position) * factor,
		Texture = 0, Pose = 0, NextPoseAt = 0, Destroyed = false,
	}, Fire)
end

function Fire:Update(frame, clock, shown, opacity, quality, distant)
	if self.Destroyed then return end
	local mesh = self.Mesh
	mesh.Transparency = if shown then 1 - math.clamp(opacity, 0, 1) else 1
	if not shown then return end
	local started = os.clock()
	mesh.CFrame = frame * facing * CFrame.new(self.Offset)
	local texture = math.floor(clock * 12) % 24 + 1
	if texture ~= self.Texture then
		if self.Texture > 0 then self.Surfaces[self.Texture].Parent = self.Model.Frames end
		self.Surfaces[texture].Parent = mesh
		self.Texture = texture
	end
	local fps = if distant then 6 elseif quality == "Low" then 12 else 24
	if clock >= self.NextPoseAt then
		self.NextPoseAt = clock + 1 / fps - 0.001
		local pose = math.floor(clock * 24) % 48 + 1
		if pose ~= self.Pose then
			for i, bone in self.Bones do
				bone.Transform = CFrame.new(bone.CFrame:VectorToObjectSpace(Poses.Frames[pose][i] * self.Factor))
			end
			self.Pose = pose
		end
	end
	local cost = (os.clock() - started) * 1000
	timing.Updates += 1; timing.TotalMS += cost; timing.MaxMS = math.max(timing.MaxMS, cost)
end

function Fire:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	active -= 1
	for _, surface in self.Surfaces do surface.Parent = self.Model.Frames end
	for _, bone in self.Bones do bone.Transform = CFrame.identity end
	self.Mesh.Transparency = 1
	self.Model.Parent = nil
	if #pool < POOL_LIMIT then table.insert(pool, self.Model) else self.Model:Destroy() end
end

function Fire.stats()
	return { Active = active, Pooled = #pool, Created = created,
		Updates = timing.Updates, MeanUpdateMS = if timing.Updates > 0 then timing.TotalMS / timing.Updates else 0,
		MaxUpdateMS = timing.MaxMS }
end

function Fire.resetTiming()
	timing.Updates, timing.TotalMS, timing.MaxMS = 0, 0, 0
end

return Fire
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="300">
            <Properties>
              <string name="Name">DirectionalSprite</string>
              <string name="Source"><![CDATA[-- One camera-facing painted body, driven by the session clock and live travel frame.
-- View changes use the same frame index. No independent particle starts or image warping.
local Sprite = {}
Sprite.__index = Sprite

function Sprite.selectView(views, angle, previous)
	local best = views[1]
	for _, view in views do
		if math.abs(view.Angle-angle) < math.abs(best.Angle-angle) then best = view end
	end
	-- A small deadband avoids rapid switching at a view boundary.
	if previous and math.abs(previous.Angle-angle) <= math.abs(best.Angle-angle)+4 then
		return previous
	end
	return best
end

function Sprite.new(host, parent, definition, size)
	local gui = Instance.new("BillboardGui")
	gui.Name = "DirectionalBody"
	gui.Adornee = host
	gui.Size = UDim2.fromScale(size, size)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = 180
	gui.ClipsDescendants = false
	local image = Instance.new("ImageLabel")
	image.Name = "PaintedBody"
	image.AnchorPoint = Vector2.new(.5,.5)
	image.Position = UDim2.fromScale(.5,.5)
	image.Size = UDim2.fromScale(1,1)
	image.BackgroundTransparency = 1
	image.ImageColor3 = Color3.new(1,1,1)
	image.ImageRectSize = Vector2.one * definition.CellSize
	image.Image = definition.Views[1].Image
	image.Parent = gui
	gui.Parent = parent
	return setmetatable({Gui=gui, Image=image, Definition=definition}, Sprite)
end

function Sprite:Update(frame, camera, clock, shown, opacity)
	local definition = self.Definition
	local image = self.Image
	local index = math.floor(clock * definition.Framerate) % definition.Frames
	image.ImageRectOffset = Vector2.new(index % definition.Columns, math.floor(index / definition.Columns)) * definition.CellSize
	if camera then
		local delta = camera.CFrame.Position-frame.Position
		local direction = frame.LookVector
		local angle = if delta.Magnitude > .001 then math.deg(math.acos(math.clamp(direction:Dot(delta.Unit),-1,1))) else 0
		local view = Sprite.selectView(definition.Views, angle, self.View)
		if view ~= self.View then
			self.View = view
			image.Image = view.Image
		end
		local projected = camera.CFrame:VectorToObjectSpace(direction)
		-- Source heads point right. Rotate the whole card to projected travel, without stretching.
		image.Rotation = if projected.X^2+projected.Y^2 > .0025 then math.deg(math.atan2(-projected.Y,projected.X)) else 0
		self.Gui:SetAttribute("View", view.Name)
		self.Gui:SetAttribute("Angle", angle)
	end
	self.Gui.Enabled = shown
	image.ImageTransparency = 1-math.clamp(opacity,0,1)
	self.Gui:SetAttribute("Frame", index+1)
end

return Sprite
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="301">
            <Properties>
              <string name="Name">FieldDynamics</string>
              <string name="Source"><![CDATA[-- Grounded, timed motifs built from existing atlases/meshes. No gameplay or physics ownership.
local Assets=require(script.Parent.Parent.Assets.VFXAssets)
local Manifest=require(script.Parent.Parent.Assets.VFXAssetManifest)
local ArcBeam=require(script.Parent.ArcBeam)
local Dynamics={};Dynamics.__index=Dynamics
local TAU=math.pi*2
local function clamp(x) return math.clamp(x,0,1) end
local function hash(i) return (i*.61803398875)%1 end
local function part(parent,name)
	local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
	p.CastShadow=false;p.Transparency=1;p.Size=Vector3.one*.05;p.Parent=parent;return p
end
local function atlas(image,name,identity)
	local id=Assets.texture(name,identity);local meta=Manifest.Textures[name]
	image.Image=id
	local grid=if meta and meta.Flipbook=="Grid4x4" then 4 elseif meta and meta.Flipbook=="Grid8x8" then 8 else 1
	local cell=if meta then meta.Size.X/grid else 256
	image.ImageRectSize=Vector2.one*cell
	return {Image=image,Grid=grid,Cell=cell,Frames=grid*grid}
end
local function frame(a,index)
	index=math.clamp(index,0,a.Frames-1)
	a.Image.ImageRectOffset=Vector2.new(index%a.Grid,math.floor(index/a.Grid))*a.Cell
end
local function card(parent,name,identity,ground)
	local p=part(parent,"Motif_"..name)
	local gui
	if ground then
		gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Top;gui.CanvasSize=Vector2.one*256
	else
		gui=Instance.new("BillboardGui");gui.Adornee=p;gui.MaxDistance=180
	end
	gui.AlwaysOnTop=false;gui.LightInfluence=.15;gui.Enabled=false;gui.Parent=p
	local image=Instance.new("ImageLabel");image.Size=UDim2.fromScale(1,1);image.BackgroundTransparency=1
	image.ImageColor3=Color3.new(1,1,1);image.Parent=gui
	return {Part=p,Gui=gui,Atlas=atlas(image,name,identity),Ground=ground}
end
local function display(c,cf,size,opacity,index)
	c.Part.CFrame=cf
	if c.Ground then c.Part.Size=Vector3.new(size,.025,size) else c.Gui.Size=UDim2.fromScale(size,size) end
	c.Gui.Enabled=opacity>.001;c.Atlas.Image.ImageTransparency=1-clamp(opacity)
	frame(c.Atlas,index)
end

function Dynamics.new(parent,params,identity,bands,meshCapacity,trailCapacity,quality,seed)
	local self=setmetatable({Parent=parent,Params=params,Mode=params.Mode,Identity=identity,Bands=bands,
		Nodes={},Surfaces={},Meshes=0,Trails=0,Seed=seed or 0},Dynamics)
	local density=if quality=="Low" then .5 elseif quality=="Medium" then .75 else 1
	local mode=self.Mode
	local wanted=if mode=="Crystals" then 34 elseif mode=="Runes" then 48 elseif mode=="Flames" then 30
		elseif mode=="Wisps" then 20 elseif mode=="OrbitWisps" then 12 elseif mode=="Ripples" then 24
		elseif mode=="Void" then 10 elseif mode=="Gusts" then 3 else 2
	local count=math.min(math.max(2,math.floor(wanted*density)),math.max(0,meshCapacity))
	if mode=="Gusts" then count=math.min(count,trailCapacity) end
	if mode=="Storm" then count=math.min(count,math.floor(trailCapacity/3)) end
	if count<1 then return nil end
	local variants={"ice_shard_a","ice_shard_b","ice_cluster","ice_spike"}
	for i=1,count do
		local node={U=hash(i),V=hash(i*3.17),Phase=hash(i*2.31),Yaw=i*2.399963,Index=i}
		if mode=="Crystals" then
			local name=variants[(i-1)%#variants+1]
			node.Part=Assets.acquireMesh(name);node.Part.Color=Color3.new(1,1,1);node.Part.Material=Enum.Material.SmoothPlastic
			node.Part.Transparency=1
			node.Part.Parent=parent;node.Native=Assets.meshSize(name);node.Mesh=true
		elseif mode=="Storm" then
			node.Part=part(parent,"StrikeHost")
			node.Arc=ArcBeam.new(node.Part,parent,"",ColorSequence.new(bands[3]),{Width=.28,ArcSegments=6},
				math.min(6,trailCapacity-self.Trails),i*173)
			if node.Arc then self.Trails+=node.Arc.Count end
		elseif mode=="Gusts" then
			node.Part=part(parent,"GustHost")
			local a,b=Instance.new("Attachment"),Instance.new("Attachment");a.Parent=node.Part;b.Parent=node.Part
			local beam=Instance.new("Beam");beam.Name="AdvectingGust";beam.Attachment0=a;beam.Attachment1=b
			beam.FaceCamera=true;beam.Segments=12;beam.Texture=Assets.texture("gust_strokes",identity)
			beam.TextureMode=Enum.TextureMode.Stretch;beam.TextureSpeed=2;beam.Color=ColorSequence.new(Color3.new(1,1,1))
			beam.LightInfluence=.15;beam.LightEmission=.1;beam.Parent=parent
			node.Beam,node.A,node.B=beam,a,b;self.Trails+=1
		elseif mode=="Void" and i>1 then
			node.Part=Assets.acquireMesh("void_shard");node.Part.Color=Color3.new(1,1,1);node.Part.Material=Enum.Material.SmoothPlastic
			node.Part.Transparency=1
			node.Part.Parent=parent;node.Native=Assets.meshSize("void_shard");node.Mesh=true
		else
			local texture=if mode=="Flames" then "flame_tongue" elseif mode=="Ripples" then "ripple_ring"
				elseif mode=="Runes" then "rune_circle" elseif mode=="Void" then "portal_rings" else "soul_wisp"
			node.Card=card(parent,texture,identity,mode=="Runes" or mode=="Ripples" or (mode=="Void" and params.Ground~=false))
			node.Part=node.Card.Part
		end
		self.Meshes+=1;table.insert(self.Nodes,node)
	end
	if mode=="Flames" or mode=="Ripples" or (mode=="Void" and params.Ground~=false) then
		for i=1,math.min(3,math.max(0,meshCapacity-self.Meshes)) do
			local p=part(parent,"CelGroundBand");p.Shape=Enum.PartType.Cylinder;p.Material=Enum.Material.SmoothPlastic
			p.Color=if mode=="Void" then (if i==1 then bands[1] else bands[5]) else bands[if i==1 then 1 elseif i==2 then 2 else 3]
			table.insert(self.Surfaces,p);self.Meshes+=1
		end
	end
	return self
end

function Dynamics:Update(cf,size,floor,age,shown,fade,role)
	local mode=self.Mode;local opacity=if shown then 1-fade else 0
	local sx,sz=math.max(2,size.X),math.max(2,size.Z)
	local center=Vector3.new(cf.Position.X,floor,cf.Position.Z)
	if mode=="Void" and role~="Field" then
		self.VoidOrigin=self.VoidOrigin or (if self.Params.Ground==false then cf.Position else center)
		center=self.VoidOrigin
	end
	for i,p in self.Surfaces do
		local scale=({1,.87,.48})[i]
		p.Size=Vector3.new(.03,sx*scale,sz*scale)
		p.CFrame=CFrame.new(center+Vector3.new(if i==3 then sx*.12 else 0,.035+i*.025,0))*CFrame.Angles(0,0,math.pi/2)
		p.Transparency=1-opacity*(if mode=="Flames" then .9 else .78)
	end
	for i,node in self.Nodes do
		local angle=node.U*TAU;local radius=math.sqrt(node.V)*.46
		local base=center+Vector3.new(math.cos(angle)*radius*sx,0,math.sin(angle)*radius*sz)
		if role=="Field" and not node.FloorChecked then
			local hit=workspace:Raycast(base+Vector3.yAxis*5,-Vector3.yAxis*15)
			node.GroundY=if hit then hit.Position.Y else floor;node.FloorChecked=true
		end
		base=Vector3.new(base.X,node.GroundY or floor,base.Z)
		local phase=(age/(if mode=="Ripples" then 1.1 elseif mode=="Runes" then 3.5 else 2.6)+node.Phase)%1
		local born=true
		if mode=="Wisps" or mode=="OrbitWisps" then
			local localAge=age-i*.09;born=localAge>=0;phase=(math.max(0,localAge)/(2.2+node.V*.8))%1
		end
		if mode=="Crystals" then
			local scale=.65+node.V*1.7;local v=node.Native*Vector3.new(scale*(.65+node.U*.6),scale,scale*(.6+node.Phase*.8))
			local emerge=clamp((age-i*.006)/.4)
			Assets.place(node.Part,CFrame.new(base+Vector3.yAxis*(v.Y*.45-(1-emerge)*v.Y))*CFrame.Angles(.12*math.sin(i),node.Yaw,.1*math.cos(i)),v)
			node.Part.Transparency=1-opacity
		elseif mode=="Flames" then
			local h=1.8+node.V*1.5
			display(node.Card,CFrame.new(base+Vector3.yAxis*h*.42),h,opacity*(.85+.15*math.sin(age*9+i)),math.floor((age*22+i*5)%node.Card.Atlas.Frames))
		elseif mode=="Runes" then
			local a=clamp(phase/.12)*clamp((1-phase)/.18)
			display(node.Card,CFrame.new(base+Vector3.yAxis*.09)*CFrame.Angles(0,node.Yaw,0),.9+node.V*1.6,opacity*a,0)
		elseif mode=="Ripples" then
			display(node.Card,CFrame.new(base+Vector3.yAxis*.15),1.5+node.V*2.5,opacity*clamp((1-phase)*3),math.floor(phase*(node.Card.Atlas.Frames-1)))
		elseif mode=="Wisps" or mode=="OrbitWisps" then
			local h=1.1+node.V*.7;local pos
			if mode=="Wisps" then
				pos=base+Vector3.yAxis*(-h*.5+phase*(3.5+h))
			else
				local theta=phase*TAU+node.Yaw;local r=math.sin(phase*math.pi)*(1.8+node.V)
				pos=cf.Position+Vector3.new(math.cos(theta)*r,(phase-.5)*math.max(4,size.Y),math.sin(theta)*r)
			end
			local a=clamp((1-phase)/.25)*(if mode=="OrbitWisps" then clamp(phase/.12) else 1)
			display(node.Card,CFrame.new(pos),h,if born then opacity*a else 0,math.floor((age*14+i*3)%node.Card.Atlas.Frames))
		elseif mode=="Storm" then
			local cycle=math.floor(age*1.8+node.Phase)
			local t=(age*1.8+node.Phase)%1
			local x=math.sin(cycle*12.7+i)*sx*.42;local z=math.cos(cycle*5.2+i)*sz*.42
			local target=center+Vector3.new(x,.1,z)
			node.Part.CFrame=CFrame.lookAt(target+Vector3.yAxis*8,target)
			if node.Arc then node.Arc:Update(8,.65,age,shown and t<.26,if t<.26 then t/.26 else 1) end
		elseif mode=="Gusts" then
			local width=math.min(sx,sz)
			local direction=if role=="Field" then cf.RightVector else cf.LookVector
			local p=center+direction*((phase-.5)*sx)+cf.RightVector*((node.V-.5)*sz*.5)+Vector3.yAxis*(1+node.V*2)
			node.Part.CFrame=CFrame.lookAt(p,p+direction)
			node.A.CFrame=CFrame.Angles(0,0,math.pi/2);node.B.CFrame=CFrame.new(0,0,-math.max(3,width*.6))*CFrame.Angles(0,0,math.pi/2)
			node.Beam.Width0=.5+width*.06;node.Beam.Width1=.2;node.Beam.CurveSize0=width*.12;node.Beam.CurveSize1=-width*.1
			node.Beam.Transparency=NumberSequence.new(1-opacity*math.sin(phase*math.pi));node.Beam.Enabled=shown and fade<1
		elseif mode=="Void" then
			local portalSize=math.max(3,math.min(sx,sz)*.85)
			if node.Card then
				local pos=center
				local opened=age
				if role=="Projectile" then
					if not node.Fixed or age-(node.Opened or 0)>1.1 then node.Fixed=cf.Position;node.Opened=age end
					pos=node.Fixed-Vector3.yAxis*.3
					opened=age-node.Opened
				end
				self.PortalPosition=pos
				display(node.Card,CFrame.new(pos+Vector3.yAxis*.14),portalSize*clamp(opened/.25),opacity*(if role=="Projectile" then clamp((1.1-opened)/.2) else 1),0)
			else
				local pos=self.PortalPosition or center
				local a=phase*TAU+node.Yaw;local r=math.sin(phase*math.pi)*portalSize*.3
				local v=node.Native*(.15+node.V*.22)
				Assets.place(node.Part,CFrame.new(pos+Vector3.new(math.cos(a)*r,phase*5,math.sin(a)*r))*CFrame.Angles(0,a,.25),v)
				node.Part.Transparency=1-opacity*clamp((1-phase)/.3)
			end
		end
	end
end

function Dynamics:Destroy()
	for _,node in self.Nodes do
		if node.Mesh then Assets.releaseMesh(node.Part) else node.Part:Destroy() end
	end
	for _,p in self.Surfaces do p:Destroy() end
end

return Dynamics
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="302">
            <Properties>
              <string name="Name">PathGlyphs</string>
              <string name="Source"><![CDATA[-- Existing rune/rift atlases open at fixed stations; nothing is launched along the path.
local PathGlyphs={}
PathGlyphs.__index=PathGlyphs

function PathGlyphs.new(host,texture,layout,colors,params,capacity,frameTexture)
	local perStation=if frameTexture or params.Outflow then 2 else 1
	local count=math.min(params.PathGlyphCount or 7,math.floor(capacity/perStation))
	if count<1 then return nil end
	local self=setmetatable({Stations={},Count=count*perStation,Rate=if params.Outflow then count*5 else 0,Params=params},PathGlyphs)
	for i=1,count do
		local point=Instance.new("Attachment");point.Name="PathStation";point.Parent=host
		local e=Instance.new("ParticleEmitter");e.Name="StationaryPathGlyph"
		e.Texture=texture;e.FlipbookLayout=layout;e.Color=colors
		if layout~=Enum.ParticleFlipbookLayout.None then
			e.FlipbookMode=if params.OpenInPlace then Enum.ParticleFlipbookMode.OneShot else Enum.ParticleFlipbookMode.Random
			e.FlipbookStartRandom=not params.OpenInPlace
		end
		e.Speed=NumberRange.new(0);e.RotSpeed=NumberRange.new(0);e.Rotation=NumberRange.new(0)
		e.LockedToPart=true;e.Acceleration=Vector3.zero;e.Rate=0;e.Enabled=false
		e.Lifetime=NumberRange.new(params.GlyphLifetime or 1.25)
		e.LightEmission=.15;e.LightInfluence=.25;e.Brightness=1
		e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.15,0),
			NumberSequenceKeypoint.new(.75,0),NumberSequenceKeypoint.new(1,1)})
		if params.Endpoints then e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.8,0),NumberSequenceKeypoint.new(1,1)}) end
		e.Parent=point
		local frame
		if frameTexture then
			frame=e:Clone();frame.Name="GeometricRuneEnclosure";frame.Texture=frameTexture
			frame.FlipbookLayout=Enum.ParticleFlipbookLayout.None;frame.ZOffset=-.02;frame.Parent=point
		end
		local outflow
		if params.Outflow then
			outflow=Instance.new("ParticleEmitter");outflow.Name="RiftOutflow"
			outflow.Texture=require(script.Parent.Parent.Assets.VFXAssets).texture("star_mote","Space")
			outflow.Speed=NumberRange.new(1,2.5);outflow.Lifetime=NumberRange.new(.6,1)
			outflow.Rate=5;outflow.SpreadAngle=Vector2.new(55,55);outflow.Size=NumberSequence.new(.18,0)
			outflow.Transparency=NumberSequence.new(0,1);outflow.LightEmission=.2;outflow.Enabled=false;outflow.Parent=point
		end
		table.insert(self.Stations,{Point=point,Emitter=e,Frame=frame,Outflow=outflow,
			U=if params.Endpoints then (i-1)/math.max(1,count-1) else i/(count+1),Next=(i-1)*.035})
	end
	return self
end

function PathGlyphs:Update(range,width,age,shown,ending,canEmit)
	for _,station in self.Stations do
		station.Point.Position=Vector3.new(0,0,-range*station.U)
		if station.Outflow then station.Outflow.Enabled=shown and not ending end
		local spacing=range/(#self.Stations+1)
		local size=math.min(math.clamp(width*(self.Params.GlyphSize or 2),.7,5),spacing*(if station.Frame then .45 else .85))
		if station.Size~=size then
			station.Size=size
			station.Emitter.Size=NumberSequence.new(size)
			if station.Frame then station.Frame.Size=NumberSequence.new(size*1.8) end
		end
		if shown and not ending and age>=station.Next then
			if canEmit(if station.Frame then 2 else 1) then
				station.Emitter:Emit(1)
				if station.Frame then station.Frame:Emit(1) end
			end
			station.Next=age+(self.Params.GlyphLifetime or 1.25)*1.05
		end
	end
end

return PathGlyphs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="303">
            <Properties>
              <string name="Name">SignatureKits</string>
              <string name="Source"><![CDATA[-- Pure data: identity kits and the form templates that turn a kit into signature layers.
-- A kit names its assets per visual role, a four-tone palette and a few motion "feel" numbers.
-- Templates then produce Projectile, Beam, Wave, Field, Aura, SelfEnhancement, Construct,
-- Manipulation, Cast (charge/release), Impact and Dissipate layers for it. Hand-authored
-- signature layers (Fire's projectile, Body's wave) replace the template for the roles they own.
--
-- Art direction: cel-shaded dark fantasy. Bodies render with low light emission so the ink
-- outlines baked into the textures (and the `_ink` hull meshes) stay visible; only sparks,
-- flashes and cores marked Glow stay additive.
local Kits = {}

local function layer(t)
	t.Params = t.Params or {}
	t.Drivers = t.Drivers or {}
	t.Limits = t.Limits or {}
	return t
end
Kits.layer = layer

-- Palette tokens every kit defines: Hi (lit), Mid (body), Lo (shadow), Smoke, plus Ink.
local INK = Color3.fromRGB(14, 10, 14)

-- Template: one entry per (role, visual job). `a` = kit.Assets, `f` = kit.Feel.
local function templates(kit)
	local a, f, id = kit.Assets, kit.Feel, kit.Name
	local L = {}
	local function add(t)
		t.Id = id .. "." .. t.Id
		table.insert(L, layer(t))
	end
	local rise = f.Rise or 2
	local light = f.Light or 0.2
	local spin = f.Spin or 1

	-- Projectile -------------------------------------------------------------------------------
	add({
		Id = "Projectile.Core",
		Slot = "Core",
		Kind = "Sprite",
		Priority = 1,
		Roles = { Projectile = true },
		Texture = a.Core,
		Colors = { "Hi", "Mid" },
		Params = { Size = 1.35, Framerate = f.Framerate or 20, RotSpeed = 40 * spin, Light = light + 0.15 },
		Drivers = { { "Framerate", "Potency", 14 }, { "Size", "Potency", 0.25 } },
	})
	if a.CoreMesh then
		add({
			Id = "Projectile.Body",
			Slot = "Core",
			Kind = "Mesh",
			Priority = 2,
			Roles = { Projectile = true },
			Mesh = a.CoreMesh,
			Colors = "Mid",
			Params = {
				Size = f.CoreMeshSize or 0.5,
				Spin = 2.5 * spin,
				Wobble = 0.05,
				Opacity = 1,
				Material = "SmoothPlastic",
				Orient = "Travel",
				RequireAsset = 1,
				Ink = 1,
			},
			Drivers = { { "Spin", "Potency", 2 }, { "Wobble", "Potency", 0.12 } },
		})
	end
	add({
		Id = "Projectile.Stream",
		Slot = "Shell",
		Kind = "Emitter",
		Priority = 1,
		Roles = { Projectile = true },
		Texture = a.Particle,
		Colors = { "Hi", "Mid", "Lo" },
		Params = {
			Rate = 14,
			Lifetime = 0.36,
			Speed = 2,
			Spread = 24,
			Direction = "Back",
			Size = 1.0,
			SizeEnd = 0.3,
			Framerate = f.Framerate or 24,
			Light = light,
			RotSpeed = 60,
			Drag = f.Drag or 1,
		},
		Drivers = { { "Rate", "Size", 12 }, { "Rate", "Potency", 10 }, { "Speed", "Speed", 5 } },
		Limits = { Rate = { 6, 40 } },
	})
	add({
		Id = "Projectile.Trail",
		Slot = "Trail",
		Kind = "Trail",
		Priority = 1,
		Roles = { Projectile = true },
		Texture = a.Trail,
		Colors = { "Hi", "Mid", "Lo" },
		Params = { Width = 1.1, Lifetime = 0.22, Opacity = 1, Light = light, TextureLength = 4 },
		Drivers = { { "Lifetime", "Homing", 0.35 }, { "Lifetime", "Range", 0.1 } },
		Limits = { Lifetime = { 0.12, 0.6 } },
	})
	add({
		Id = "Projectile.Motes",
		Slot = "Ambient",
		Kind = "Emitter",
		Priority = 2,
		Roles = { Projectile = true },
		Texture = a.Mote,
		Colors = { "Hi", "Mid" },
		Params = {
			Rate = 8,
			Lifetime = 0.6,
			Speed = 3,
			Spread = 70,
			Direction = "Back",
			Size = 0.32,
			SizeEnd = 0.05,
			Drag = 2,
			Rise = rise,
			Light = 0.6,
			Glow = 1,
			RandomRotation = 1,
			Framerate = 0,
		},
		Drivers = { { "Rate", "Potency", 14 } },
	})
	add({
		Id = "Projectile.Light",
		Slot = "Ambient",
		Kind = "Light",
		Priority = 3,
		Roles = { Projectile = true },
		Colors = "Mid",
		Params = { Brightness = 1.1, Range = 9 },
		Drivers = { { "Brightness", "Potency", 0.8 } },
	})

	-- Beam -------------------------------------------------------------------------------------
	if f.PathGlyphs then
		add({Id="Beam.PathGlyphs",Slot="Core",Kind="PathGlyphs",Priority=1,Roles={Beam=true},
			Texture=a.BeamGlyph or a.Particle,FrameTexture=if f.GeometricFrame then a.Sigil else nil,Colors={"Hi","Mid"},
			Params={PathGlyphCount=if f.VoidAll then 3 else 7,GlyphSize=if f.GeometricFrame then 1.6 else 4.5,
				GlyphLifetime=if f.GeometricFrame then 1.6 else 1.25,OpenInPlace=not f.GeometricFrame,
				Outflow=f.VoidAll}})
		if f.GeometricFrame then
			add({Id="Beam.ThroughSigils",Slot="Core",Kind="Beam",Priority=1,Roles={Beam=true},Texture="glow_soft",Colors={"Hi","Mid"},
				Params={ContinuousStream=true,PlainStream=true,BodyWidth=.32,FlowSpeed=3,EndWidth=1}})
		end
	else
	add({
		Id = "Beam.Core",
		Slot = "Core",
		Kind = "Beam",
		Priority = 1,
		Roles = { Beam = true },
		Texture = a.Beam,
		Colors = { "Hi", "Mid" },
		Params = {
			Width = if f.BeamArc then 0.22 else 1,
			Opacity = 1,
			Light = light + 0.2,
			TextureLength = 5,
			Scroll = f.Scroll or 3,
			Wobble = f.Wobble or 0,
			ArcSegments = f.BeamArc,
			ContinuousStream = f.StreamBeam,
			FlowSpeed = f.StreamSpeed,
			FlowLength = f.StreamLength,
			EndWidth = f.StreamEndWidth,
			PlainStream = f.BeamClocks,
		},
	})
	if not f.BeamArc and not f.StreamBeam then
	add({
		Id = "Beam.Outer",
		Slot = "Core",
		Kind = "Beam",
		Priority = 2,
		Roles = { Beam = true },
		Texture = a.Trail,
		Colors = { "Mid", "Lo" },
		Params = {
			Width = 2.1,
			Opacity = 0.7,
			Light = light,
			TextureLength = 7,
			Scroll = -(f.Scroll or 3) * 0.6,
			Wobble = (f.Wobble or 0) * 1.5,
		},
	})
	add({
		Id = "Beam.Origin",
		Slot = "Core",
		Kind = "Sprite",
		Priority = 1,
		Roles = { Beam = true },
		Texture = a.Core,
		Colors = { "Hi", "Mid" },
		Params = { Size = 1.6, Framerate = f.Framerate or 20, Light = light + 0.15 },
	})
	add({
		Id = "Beam.End",
		Slot = "Secondary",
		Kind = "Sprite",
		Priority = 2,
		Roles = { Beam = true },
		Texture = a.Core,
		Colors = { "Hi", "Mid" },
		Params = { Size = 2.2, Framerate = f.Framerate or 20, Light = light + 0.15, Placement = "End" },
	})
	-- Flow: the school's main particle streams from the caster to the beam's end.
	add({
		Id = "Beam.Flow",
		Slot = "Secondary",
		Kind = "Emitter",
		Priority = 1,
		Roles = { Beam = true },
		Texture = a.Flow or a.Particle,
		Colors = { "Hi", "Mid", "Lo" },
		Params = {
			Rate = 9,
			Lifetime = 0.55,
			Speed = 20,
			Spread = 5,
			Direction = "Forward",
			Size = 1.4,
			SizeEnd = 0.9,
			Light = light,
			RangeSpeed = 1,
			RotSpeed = 30,
			Framerate = f.Framerate or 20,
		},
		Drivers = { { "Rate", "Potency", 8 }, { "Size", "Size", 0.8 } },
	})
	add({
		Id = "Beam.Motes",
		Slot = "Ambient",
		Kind = "Emitter",
		Priority = 3,
		Roles = { Beam = true },
		Texture = a.Mote,
		Colors = { "Hi", "Mid" },
		Params = {
			Rate = 6,
			Lifetime = 0.5,
			Speed = 2,
			Spread = 180,
			Size = 0.3,
			SizeEnd = 0.05,
			Light = 0.6,
			Glow = 1,
			Placement = "Line",
			Rise = rise,
			RandomRotation = 1,
			Framerate = 0,
		},
	})
	end -- Connected arcs fill the path; no travelling glyphs or endpoint orbs.
	end -- Path glyphs replace the entire travelling beam template.
	if f.BeamClocks then
		add({Id="Beam.ClockEnds",Slot="Secondary",Kind="PathGlyphs",Priority=1,Roles={Beam=true},Texture=a.Sigil,Colors={"Hi"},
			Params={PathGlyphCount=2,GlyphSize=2.5,GlyphLifetime=.65,Endpoints=true}})
	end
	add({
		Id = "Beam.Light",
		Slot = "Ambient",
		Kind = "Light",
		Priority = 3,
		Roles = { Beam = true },
		Colors = "Mid",
		Params = { Brightness = 1.4, Range = 12, Placement = "End" },
	})

	-- Wave (template; Body overrides with its bespoke cone) ------------------------------------
	add({
		Id = "Wave.Fronts",
		Slot = "Shell",
		Kind = "Burst",
		Priority = 1,
		Roles = { Wave = true },
		Texture = a.Wave,
		Colors = { "Hi", "Mid", "Lo" },
		Params = {
			Count = 3,
			Lifetime = 0.3,
			Speed = 30,
			Spread = 12,
			Direction = "Forward",
			Size = 5,
			SizeEnd = 9,
			Orientation = "VelocityPerpendicular",
			OneShot = 1,
			Light = light,
			Stagger = 0.05,
			RangeSpeed = 1,
		},
		Drivers = { { "Size", "Force", 3 }, { "Count", "Potency", 2 } },
	})
	add({
		Id = "Wave.Body",
		Slot = "Secondary",
		Kind = "Burst",
		Priority = 2,
		Roles = { Wave = true },
		Texture = a.Particle,
		Colors = { "Hi", "Mid", "Lo" },
		Params = {
			Count = 10,
			Lifetime = 0.45,
			Speed = 26,
			Spread = 26,
			Direction = "Forward",
			Size = 1.8,
			SizeEnd = 0.6,
			Light = light,
			RandomRotation = 1,
			Framerate = f.Framerate or 24,
			RangeSpeed = 1,
			ShapeRadius = 1.2,
		},
		Drivers = { { "Count", "Potency", 10 } },
	})
	add({
		Id = "Wave.Front",
		Slot = "Impact",
		Kind = "Mesh",
		Priority = 2,
		Roles = { Wave = true },
		Mesh = "shockwave_ring",
		Colors = "Hi",
		Params = {
			Size = 0.5,
			Grow = 1,
			Duration = 0.32,
			Opacity = 0.85,
			Material = "Neon",
			Orient = "Front",
			Fade = 1,
		},
	})
	add({
		Id = "Wave.Floor",
		Slot = "Ambient",
		Kind = "Burst",
		Priority = 3,
		Roles = { Wave = true },
		Texture = a.Smoke,
		Colors = { "Smoke", "Lo" },
		Params = {
			Count = 5,
			Lifetime = 0.9,
			Speed = 12,
			Spread = 16,
			Direction = "Forward",
			Size = 2,
			SizeEnd = 4,
			Drag = 3,
			Light = 0,
			Opacity = 0.75,
			Floor = 1,
			RandomRotation = 1,
			OneShot = 1,
		},
	})

	-- Field --------------------------------------------------------------------------------------
	if f.FieldMode then
		add({Id="Field.Dynamics",Slot="Secondary",Kind="Dynamics",Priority=1,Roles={Field=true},Colors={"Hi","Mid"},
			Params={Mode=f.FieldMode,Ground=true}})
	else
	add({
		Id = "Field.Ground",
		Slot = "Secondary",
		Kind = "Decal",
		Priority = 1,
		Roles = { Field = true },
		Texture = a.Ground,
		Colors = "Mid",
		Params = { Opacity = 0.9, Spin = 0.08 * spin, Footprint = 1, Pulse = 0.08 },
	})
	add({
		Id = "Field.Edge",
		Slot = "Secondary",
		Kind = "Mesh",
		Priority = 1,
		Roles = { Field = true },
		Mesh = "shockwave_ring",
		Colors = "Hi",
		Params = { Opacity = 0.75, Material = "Neon", Orient = "Footprint", Spin = 0.15 * spin },
	})
	add({
		Id = "Field.Body",
		Slot = "Ambient",
		Kind = "Emitter",
		Priority = 2,
		Roles = { Field = true },
		Texture = a.Particle,
		Colors = { "Hi", "Mid", "Lo" },
		Params = {
			Rate = 24,
			RatePerArea = 0.2,
			Lifetime = 0.9,
			Speed = 2.5,
			Spread = 15,
			Size = 1.6,
			SizeEnd = 0.6,
			Light = light,
			Placement = "Area",
			Direction = "Up",
			Rise = rise,
			Framerate = f.Framerate or 20,
			RotSpeed = 0,
		},
		Drivers = { { "Rate", "Potency", 8 } },
		Limits = { Rate = { 4, 40 } },
	})
	if a.Scatter then
		add({
			Id = "Field.Scatter",
			Slot = "Ambient",
			Kind = "Mesh",
			Priority = 2,
			Roles = { Field = true },
			Mesh = a.Scatter,
			Colors = "Mid",
			Params = {
				Count = 12,
				MaxCount = 24,
				CountPerArea = 0.08,
				Size = f.ScatterSize or 0.9,
				Duration = 0.35,
				Opacity = 1,
				Material = "SmoothPlastic",
				Orient = "Scatter",
				RequireAsset = 1,
				Ink = 1,
			},
		})
	end
	add({
		Id = "Field.Motes",
		Slot = "Ambient",
		Kind = "Emitter",
		Priority = 3,
		Roles = { Field = true },
		Texture = a.Mote,
		Colors = { "Hi", "Mid" },
		Params = {
			Rate = 6,
			RatePerArea = 0.06,
			Lifetime = 1.4,
			Speed = 1.5,
			Spread = 25,
			Size = 0.35,
			SizeEnd = 0.05,
			Light = 0.6,
			Glow = 1,
			Placement = "Area",
			Direction = "Up",
			Rise = rise,
			RandomRotation = 1,
			Framerate = 0,
		},
		Limits = { Rate = { 2, 24 } },
	})
	add({
		Id = "Field.Light",
		Slot = "Ambient",
		Kind = "Light",
		Priority = 3,
		Roles = { Field = true },
		Colors = "Mid",
		Params = { Brightness = 0.9, Range = 14 },
	})
	end

	-- Aura / SelfEnhancement -------------------------------------------------------------------
	if f.SpiritOrbit then
		add({Id="Aura.OrbitSpirits",Slot="Shell",Kind="Dynamics",Priority=1,Roles={Aura=true,SelfEnhancement=true},Colors={"Hi","Mid"},
			Params={Mode="OrbitWisps"}})
	else
	add({
		Id = "Aura.Mantle",
		Slot = "Shell",
		Kind = "Emitter",
		Priority = 1,
		Roles = { Aura = true, SelfEnhancement = true },
		Texture = a.Aura or a.Particle,
		Colors = { "Hi", "Mid", "Lo" },
		Params = {
			Rate = 14,
			Lifetime = 0.8,
			Speed = 2,
			Spread = 10,
			Size = 1.4,
			SizeEnd = 0.4,
			Light = light,
			Placement = "Body",
			Direction = "Up",
			Rise = rise,
			Framerate = f.Framerate or 20,
			RotSpeed = 20,
		},
		Drivers = { { "Rate", "Potency", 8 } },
	})
	add({
		Id = "Aura.Motes",
		Slot = "Ambient",
		Kind = "Emitter",
		Priority = 2,
		Roles = { Aura = true, SelfEnhancement = true },
		Texture = a.Mote,
		Colors = { "Hi", "Mid" },
		Params = {
			Rate = 8,
			Lifetime = 1.2,
			Speed = 1,
			Spread = 40,
			Size = 0.3,
			SizeEnd = 0.05,
			Light = 0.6,
			Glow = 1,
			Placement = "Body",
			Direction = "Up",
			Rise = rise,
			RandomRotation = 1,
			Framerate = 0,
		},
	})
	add({
		Id = "Aura.Ground",
		Slot = "Ambient",
		Kind = "Decal",
		Priority = 2,
		Roles = { Aura = true },
		Texture = a.Sigil or a.Ground,
		Colors = "Mid",
		Params = { Opacity = 0.7, Spin = 0.25 * spin, Footprint = 1 },
	})
	add({
		Id = "Aura.Light",
		Slot = "Ambient",
		Kind = "Light",
		Priority = 3,
		Roles = { Aura = true, SelfEnhancement = true },
		Colors = "Mid",
		Params = { Brightness = 0.8, Range = 10 },
	})
	end

	-- Construct / Manipulation -----------------------------------------------------------------
	add({
		Id = "Construct.Surface",
		Slot = "Ambient",
		Kind = "Emitter",
		Priority = 1,
		Roles = { Construct = true, Manipulation = true },
		Texture = a.Mote,
		Colors = { "Hi", "Mid" },
		Params = {
			Rate = 10,
			RatePerArea = 0.3,
			Lifetime = 0.9,
			Speed = 1,
			Spread = 30,
			Size = 0.4,
			SizeEnd = 0.05,
			Light = 0.6,
			Glow = 1,
			Placement = "Box",
			Rise = rise,
			RandomRotation = 1,
			Framerate = 0,
		},
		Limits = { Rate = { 4, 30 } },
	})
	add({
		Id = "Construct.Crest",
		Slot = "Ambient",
		Kind = "Emitter",
		Priority = 2,
		Roles = { Construct = true, Manipulation = true },
		Texture = a.Particle,
		Colors = { "Hi", "Mid", "Lo" },
		Params = {
			Rate = 6,
			Lifetime = 0.7,
			Speed = 2,
			Spread = 15,
			Size = 1.0,
			SizeEnd = 0.3,
			Light = light,
			Placement = "Top",
			Direction = "Up",
			Rise = rise,
			Framerate = f.Framerate or 20,
		},
	})

	-- Cast: charge (Gather) and release --------------------------------------------------------
	add({
		Id = "Charge.Converge",
		Slot = "Charge",
		Kind = "Emitter",
		Priority = 2,
		Texture = a.Mote,
		Colors = { "Hi", "Mid" },
		Params = {
			Rate = 10,
			Lifetime = 0.35,
			Speed = 9,
			Size = 0.32,
			SizeEnd = 0.05,
			Direction = "In",
			ShapeRadius = 3.2,
			Light = 0.7,
			Glow = 1,
			Ramp = 1,
			OffsetZ = -1.6,
			OffsetY = 0.5,
			Framerate = 0,
			RandomRotation = 1,
		},
		Drivers = { { "Rate", "Charge", 20 } },
	})
	add({
		Id = "Charge.Point",
		Slot = "Charge",
		Kind = "Sprite",
		Priority = 1,
		Texture = a.Core,
		Colors = { "Hi", "Mid" },
		Params = {
			Size = 0.5,
			Grow = 1.3,
			Framerate = f.Framerate or 20,
			Light = light + 0.2,
			Ramp = 1,
			OffsetZ = -1.6,
			OffsetY = 0.5,
		},
		Drivers = { { "Grow", "Charge", 1 } },
	})
	add({
		Id = "Charge.Sigil",
		Slot = "Charge",
		Kind = "Decal",
		Priority = 2,
		Texture = a.Sigil or "rune_circle",
		Colors = "Mid",
		Params = { Size = 4.5, Opacity = 0.85, Spin = 0.9 * spin, Ramp = 1 },
		Drivers = { { "Spin", "Charge", 1.2 } },
	})
	add({
		Id = "Cast.Flash",
		Slot = "Cast",
		Kind = "Burst",
		Priority = 1,
		-- A small flash of the school's core at the hand (not its impact cloud).
		Texture = a.Core,
		Colors = { "Hi", "Mid" },
		Params = {
			Count = 1,
			Lifetime = 0.25,
			Speed = 0,
			Size = 1.4,
			SizeEnd = 2.2,
			Light = light + 0.25,
			Framerate = f.Framerate or 20,
			OffsetZ = -1.8,
			OffsetY = 0.5,
			RandomRotation = 1,
		},
	})
	add({
		Id = "Cast.Spray",
		Slot = "Cast",
		Kind = "Burst",
		Priority = 2,
		Texture = a.Mote,
		Colors = { "Hi", "Mid" },
		Params = {
			Count = 7,
			Lifetime = 0.4,
			Speed = 14,
			Spread = 30,
			Direction = "Forward",
			Size = 0.35,
			SizeEnd = 0.05,
			Drag = 3,
			Light = 0.7,
			Glow = 1,
			OffsetZ = -1.8,
			OffsetY = 0.5,
			RandomRotation = 1,
			Framerate = 0,
		},
	})

	-- Impact & dissipation ---------------------------------------------------------------------
	add({
		Id = "Impact.Flash",
		Slot = "Impact",
		Kind = "Burst",
		Priority = 1,
		Roles = { Impact = true },
		Texture = "impact_frame",
		Colors = { "Hi", "Mid" },
		Params = { Count = 1, Lifetime = 0.1, Speed = 0, Size = 4.5, SizeEnd = 6, Light = 0.3, RandomRotation = 1 },
		Drivers = { { "Size", "Area", 4 } },
	})
	add({
		Id = "Impact.Burst",
		Slot = "Impact",
		Kind = "Burst",
		Priority = 1,
		Roles = { Impact = true },
		Texture = a.Impact,
		Colors = { "Hi", "Mid", "Lo" },
		Params = {
			Count = 1,
			Lifetime = 0.6,
			Speed = 0,
			Size = 6,
			SizeEnd = 8,
			Light = light,
			OneShot = 1,
			RandomRotation = 1,
		},
		Drivers = { { "Size", "Area", 7 }, { "SizeEnd", "Area", 9 }, { "Count", "Potency", 1 } },
	})
	add({
		Id = "Impact.Ring",
		Slot = "Impact",
		Kind = "Burst",
		Priority = 2,
		Roles = { Impact = true },
		Texture = "shockwave_ring",
		Colors = { "Hi", "Mid" },
		Params = { Count = 1, Lifetime = 0.3, Speed = 0, Size = 1, SizeEnd = 11, Light = 0.4, Opacity = 0.95 },
		Drivers = { { "SizeEnd", "Area", 12 } },
	})
	add({
		Id = "Impact.Spray",
		Slot = "Impact",
		Kind = "Burst",
		Priority = 2,
		Roles = { Impact = true },
		Texture = a.Mote,
		Colors = { "Hi", "Mid", "Lo" },
		Params = {
			Count = 12,
			Lifetime = 0.7,
			Speed = 22,
			Spread = 180,
			Direction = "Out",
			Size = 0.4,
			SizeEnd = 0.05,
			Drag = 3.5,
			Rise = -14 + rise,
			Light = 0.6,
			Glow = 1,
			RandomRotation = 1,
			Framerate = 0,
		},
		Drivers = { { "Count", "Potency", 16 } },
	})
	add({
		Id = "Impact.Mark",
		Slot = "Impact",
		Kind = "Decal",
		Priority = 3,
		Roles = { Impact = true },
		Texture = a.Ground,
		Colors = "Lo",
		Params = { Size = 5, Opacity = 0.85, Duration = 1.2, Fade = 1 },
		Drivers = { { "Size", "Area", 6 } },
	})
	if a.Debris then
		add({
			Id = "Impact.Debris",
			Slot = "Impact",
			Kind = "Debris",
			Priority = 3,
			Roles = { Impact = true },
			Meshes = a.Debris,
			Colors = "Mid",
			Params = {
				Count = 3,
				Speed = 18,
				Spread = 70,
				Size = f.DebrisSize or 0.5,
				Gravity = 65,
				Lifetime = 0.9,
				Material = "SmoothPlastic",
				Direction = "Up",
				Ink = 1,
			},
			Drivers = { { "Count", "Potency", 3 } },
		})
	end
	add({
		Id = "Impact.Light",
		Slot = "Impact",
		Kind = "Light",
		Priority = 3,
		Roles = { Impact = true },
		Colors = "Mid",
		Params = { Brightness = 3, Range = 14, Flash = 0.35 },
	})
	add({
		Id = "Dissipate.Smoke",
		Slot = "Dissipate",
		Kind = "Burst",
		Priority = 2,
		Texture = a.Smoke,
		Colors = { "Smoke", "Lo" },
		Params = {
			Count = 3,
			Lifetime = 1.3,
			Speed = 2.5,
			Spread = 180,
			Direction = "Out",
			Size = 2.4,
			SizeEnd = 4.5,
			Rise = 1.5,
			Drag = 1.5,
			Light = 0,
			Opacity = 0.8,
			OneShot = 1,
			Delay = 0.12,
			RandomRotation = 1,
		},
		Drivers = { { "Count", "Area", 3 } },
	})
	return L
end

