        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CombatPolicy</string>
            <string name="Source"><![CDATA[--!strict
-- Who may damage whom. Player-owned combatants (characters and their summons)
-- never damage each other unless both owners stand in an open-PvP zone or have
-- an accepted duel with each other. NPCs, enemies and world targets are not gated.
-- Both attributes are server-owned and set on the Player instance.
local Policy = {}

Policy.ZoneAttribute = "PvPZone" -- "Open" or "Ranked" while inside a PvP area; nil elsewhere
Policy.DuelAttribute = "DuelOpponentUserId" -- UserId of the accepted duel opponent
Policy.OpenZone = "Open"
Policy.RankedZone = "Ranked"

export type Owner = {
	UserId: number,
	Zone: any,
	DuelOpponent: any,
}

-- attacker/target are nil when the combatant is not player-owned.
function Policy.allows(attacker: Owner?, target: Owner?): boolean
	if attacker == nil or target == nil then
		return true
	end
	if attacker.UserId == target.UserId then
		return false
	end
	-- Both players in the same PvP zone (open or ranked).
	if (attacker.Zone == Policy.OpenZone or attacker.Zone == Policy.RankedZone) and attacker.Zone == target.Zone then
		return true
	end
	return attacker.DuelOpponent == target.UserId and target.DuelOpponent == attacker.UserId
end

-- Resolves the owning player's policy state for a combatant model.
function Policy.owner(model: Instance?, players: any): Owner?
	if not model then
		return nil
	end
	local player = players:GetPlayerFromCharacter(model)
	if not player then
		local ownerId = model:GetAttribute("MagicSummonOwnerUserId")
		if type(ownerId) ~= "number" then
			return nil
		end
		player = players:GetPlayerByUserId(ownerId)
		if not player then
			-- Summon of a player who left: still player-owned, never PvP-eligible.
			return { UserId = ownerId, Zone = nil, DuelOpponent = nil }
		end
	end
	return {
		UserId = player.UserId,
		Zone = player:GetAttribute(Policy.ZoneAttribute),
		DuelOpponent = player:GetAttribute(Policy.DuelAttribute),
	}
end

-- Non-damage payloads that harm or impede the target. Damage itself is gated in
-- DamageService; helpful payloads (Heal, Shield, Restoration…) stay unrestricted.
local hostileKinds = {
	DamageOverTime = true,
	Slow = true,
	Bind = true,
	Control = true,
	Force = true,
	Displacement = true,
	Reveal = true,
	Transformation = true,
	ElementalMark = true,
	ConsumeElementalMark = true,
}

function Policy.isHostilePayload(payload: any): boolean
	if type(payload) ~= "table" then
		return false
	end
	local kind = payload.Kind
	if hostileKinds[kind] then
		return true
	elseif kind == "ModifyAttribute" then
		return type(payload.Amount) ~= "number" or payload.Amount < 0
	elseif kind == "TimeDilation" then
		return type(payload.Rate) ~= "number" or payload.Rate < 1
	end
	return false
end

function Policy.canDamage(attacker: Instance?, target: Instance?, players: any): boolean
	return Policy.allows(Policy.owner(attacker, players), Policy.owner(target, players))
end

return Policy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">DefendTheWallsLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Pure, seeded layout for the Defend the Walls siege map. No Roblox APIs, so the
-- plain Luau CLI can test it; the server map builder turns this data into parts.
-- Axes: X is across the front, Z runs from the enemy side (low) to the city (high).
-- Every point is a plain { X, Z } table; heights live with the builders.
local Layout = {}

export type Point = { X: number, Z: number }
export type Lane = {
	Index: number,
	Name: string,
	Color: { number },
	Landmark: string,
	Width: number,
	Points: { Point }, -- spawn → village edge → corridor → crossing → wall 1 gate
	GateX: number,
}
export type Wall = {
	Level: number,
	Name: string,
	Z: number,
	Height: number,
	Thickness: number,
	HalfWidth: number,
	GateWidth: number,
	Walkway: boolean,
	Gates: { { Lane: number, X: number } },
	Fallback: Point, -- defender spawn while this wall is the active line
	Rally: Point, -- where retreating guards regroup: in front of this wall, since its gates stay shut
}

Layout.HalfWidth = 215
Layout.SpawnZ = 610
Layout.VillageMinZ = 640
Layout.VillageMaxZ = 880
Layout.CorridorStartZ = 905
Layout.CorridorEndZ = 1092
Layout.CityZ = 1412
Layout.LaneWidth = 36

-- Park–Miller LCG: identical sequences in Studio and the CLI test runner.
local function rng(seed: number)
	local state = math.max(1, math.floor(seed) % 2147483646)
	local self = {}
	function self.next(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
	function self.range(lo: number, hi: number): number
		return lo + (hi - lo) * self.next()
	end
	return self
end
Layout.rng = rng

-- Shortest distance from p to the polyline.
function Layout.distanceToPath(points: { Point }, p: Point): number
	local best = math.huge
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local dx, dz = b.X - a.X, b.Z - a.Z
		local length2 = dx * dx + dz * dz
		local t = if length2 > 0 then math.clamp(((p.X - a.X) * dx + (p.Z - a.Z) * dz) / length2, 0, 1) else 0
		local cx, cz = a.X + dx * t - p.X, a.Z + dz * t - p.Z
		best = math.min(best, math.sqrt(cx * cx + cz * cz))
	end
	return best
end

-- Proper intersection of segments ab and cd (shared endpoints do not count).
local function segmentsCross(a: Point, b: Point, c: Point, d: Point): Point?
	local rX, rZ, sX, sZ = b.X - a.X, b.Z - a.Z, d.X - c.X, d.Z - c.Z
	local denom = rX * sZ - rZ * sX
	if math.abs(denom) < 1e-9 then
		return nil
	end
	local t = ((c.X - a.X) * sZ - (c.Z - a.Z) * sX) / denom
	local u = ((c.X - a.X) * rZ - (c.Z - a.Z) * rX) / denom
	if t > 1e-6 and t < 1 - 1e-6 and u > 1e-6 and u < 1 - 1e-6 then
		return { X = a.X + rX * t, Z = a.Z + rZ * t }
	end
	return nil
end

-- Every point where two lane centre-lines cross, with the pair of lanes.
function Layout.laneCrossings(lanes: { Lane }): { { Lanes: { number }, Point: Point } }
	local found = {}
	for i = 1, #lanes do
		for j = i + 1, #lanes do
			local a, b = lanes[i].Points, lanes[j].Points
			for s = 1, #a - 1 do
				for t = 1, #b - 1 do
					local hit = segmentsCross(a[s], a[s + 1], b[t], b[t + 1])
					if hit then
						table.insert(found, { Lanes = { i, j }, Point = hit })
					end
				end
			end
		end
	end
	return found
end

local function lanes(): { Lane }
	local w = Layout.LaneWidth
	-- Left and right lanes swing through the centre crossroads and back out, so all
	-- three lanes meet there; the centre lane runs straight. Each ends at its own gate.
	return {
		{
			Index = 1,
			Name = "Left",
			Color = { 92, 196, 214 }, -- cold teal grave-lights
			Landmark = "HangedOak",
			Width = w,
			GateX = -112,
			Points = {
				{ X = -150, Z = Layout.SpawnZ },
				{ X = -150, Z = Layout.CorridorStartZ },
				{ X = 24, Z = 990 },
				{ X = -112, Z = 1072 },
				{ X = -112, Z = 1100 },
			},
		},
		{
			Index = 2,
			Name = "Centre",
			Color = { 236, 142, 64 }, -- ember amber
			Landmark = "BrokenSpire",
			Width = w,
			GateX = 0,
			Points = { { X = 0, Z = Layout.SpawnZ - 15 }, { X = 0, Z = 1100 } },
		},
		{
			Index = 3,
			Name = "Right",
			Color = { 176, 118, 232 }, -- witch-fire violet
			Landmark = "Aqueduct",
			Width = w,
			GateX = 112,
			Points = {
				{ X = 150, Z = Layout.SpawnZ },
				{ X = 150, Z = Layout.CorridorStartZ },
				{ X = -24, Z = 990 },
				{ X = 112, Z = 1072 },
				{ X = 112, Z = 1100 },
			},
		},
	}
end

local function walls(laneList: { Lane }): { Wall }
	local function gates()
		local list = {}
		for _, lane in laneList do
			table.insert(list, { Lane = lane.Index, X = lane.GateX })
		end
		return list
	end
	return {
		{
			Level = 1,
			Name = "OuterPalisade",
			Z = 1110,
			Height = 14,
			Thickness = 5,
			HalfWidth = Layout.HalfWidth,
			GateWidth = 20,
			Walkway = true,
			Gates = gates(),
			Fallback = { X = 0, Z = 1140 },
			Rally = { X = 0, Z = 1092 },
		},
		{
			Level = 2,
			Name = "CurtainWall",
			Z = 1210,
			Height = 22,
			Thickness = 8,
			HalfWidth = Layout.HalfWidth,
			GateWidth = 20,
			Walkway = true,
			Gates = gates(),
			Fallback = { X = 0, Z = 1240 },
			Rally = { X = 0, Z = 1190 },
		},
		{
			Level = 3,
			Name = "InnerBastion",
			Z = 1310,
			Height = 32,
			Thickness = 10,
			HalfWidth = Layout.HalfWidth,
			GateWidth = 20,
			Walkway = true,
			Gates = gates(),
			Fallback = { X = 0, Z = 1362 },
			Rally = { X = 0, Z = 1288 },
		},
	}
end

-- Small seeded scatter that keeps clear of every lane and of earlier picks.
local function scatter(
	random,
	count: number,
	minZ: number,
	maxZ: number,
	clearance: number,
	laneList: { Lane },
	taken: { { X: number, Z: number, R: number } }
): { Point }
	local out = {}
	local tries = 0
	while #out < count and tries < count * 40 do
		tries += 1
		local p = { X = random.range(-Layout.HalfWidth + 18, Layout.HalfWidth - 18), Z = random.range(minZ, maxZ) }
		local ok = true
		for _, lane in laneList do
			if Layout.distanceToPath(lane.Points, p) < lane.Width / 2 + clearance then
				ok = false
				break
			end
		end
		if ok then
			for _, other in taken do
				local dx, dz = other.X - p.X, other.Z - p.Z
				if dx * dx + dz * dz < (other.R + clearance) ^ 2 then
					ok = false
					break
				end
			end
		end
		if ok then
			table.insert(out, p)
			table.insert(taken, { X = p.X, Z = p.Z, R = clearance })
		end
	end
	return out
end

-- The ground between consecutive walls. Each bailey gets two chicane rows of
-- barricades (one per lane, alternating sides so each lane zig-zags but always
-- keeps a gap), buildings on the tower lines between lanes, and raised firing
-- terraces on both flanks with ramps on the city side. All of it collides.
export type Piece = { Kind: string, X: number, Z: number, W: number, D: number, H: number, Yaw: number? }
local function baileys(wallList: { Wall }): { { Level: number, MinZ: number, MaxZ: number, Pieces: { Piece } } }
	local out = {}
	for i = 1, #wallList - 1 do
		local a, b = wallList[i], wallList[i + 1]
		local minZ, maxZ = a.Z + a.Thickness / 2 + 6, b.Z - b.Thickness / 2 - 16
		local depth = maxZ - minZ
		local pieces: { Piece } = {}
		for row, t in { 0.3, 0.62 } do
			local z = minZ + depth * t
			for _, gate in a.Gates do
				local side = if (row + gate.Lane) % 2 == 0 then 1 else -1
				table.insert(pieces, { Kind = "Barricade", X = gate.X + side * 9, Z = z, W = 16, D = 3, H = 4 })
			end
		end
		local building = if i == 1 then "Barracks" else "Armoury"
		local other = if i == 1 then "Stables" else "WardenChapel"
		table.insert(pieces, { Kind = building, X = -56, Z = minZ + depth * 0.46, W = 24, D = 18, H = 13 })
		table.insert(pieces, { Kind = other, X = 56, Z = minZ + depth * 0.46, W = 24, D = 18, H = 13 })
		for _, side in { -1, 1 } do
			table.insert(
				pieces,
				{ Kind = "Terrace", X = side * 182, Z = minZ + depth * 0.45, W = 34, D = depth * 0.55, H = 8 }
			)
			table.insert(
				pieces,
				{ Kind = "Wagon", X = side * 150, Z = minZ + depth * 0.15, W = 6, D = 9, H = 4, Yaw = side * 30 }
			)
		end
		table.insert(out, { Level = i, MinZ = minZ, MaxZ = maxZ, Pieces = pieces })
	end
	return out
end

function Layout.generate(seed: number)
	local random = rng(seed)
	local laneList = lanes()
	local wallList = walls(laneList)
	local taken = {}
	-- Hand-placed village anchors, then seeded houses and clutter around them.
	local chapel = { X = -70, Z = 760, Yaw = 0 }
	local graveyard = { X = -72, Z = 700 }
	local well = { X = 70, Z = 780 }
	local gallows = { X = 78, Z = 700 }
	local pond = { X = 118, Z = 690 }
	for _, anchor in { { chapel, 28 }, { graveyard, 22 }, { well, 8 }, { gallows, 10 }, { pond, 14 } } do
		table.insert(taken, { X = anchor[1].X, Z = anchor[1].Z, R = anchor[2] })
	end
	local houses = {}
	for _, p in scatter(random, 14, Layout.VillageMinZ + 10, Layout.VillageMaxZ - 10, 14, laneList, taken) do
		table.insert(houses, {
			X = p.X,
			Z = p.Z,
			Yaw = math.floor(random.range(0, 4)) * 90 + random.range(-8, 8),
			Width = math.floor(random.range(14, 22)),
			Depth = math.floor(random.range(12, 16)),
			Stories = if random.next() < 0.35 then 2 else 1,
			RoofBroken = random.next() < 0.6,
		})
	end
	local carts = scatter(random, 6, Layout.VillageMinZ, Layout.VillageMaxZ, 6, laneList, taken)
	local deadTrees = scatter(random, 10, Layout.SpawnZ, Layout.CorridorEndZ, 5, laneList, taken)
	local corridorLights = {}
	for _, lane in laneList do
		local pts = lane.Points
		local spacing = 30
		for i = 1, #pts - 1 do
			local a, b = pts[i], pts[i + 1]
			local dx, dz = b.X - a.X, b.Z - a.Z
			local length = math.sqrt(dx * dx + dz * dz)
			local nx, nz = -dz / length, dx / length
			for d = spacing / 2, length, spacing do
				local t = d / length
				local side = if math.floor(d / spacing) % 2 == 0 then 1 else -1
				local offset = lane.Width / 2 - 3
				table.insert(corridorLights, {
					Lane = lane.Index,
					X = a.X + dx * t + nx * offset * side,
					Z = a.Z + dz * t + nz * offset * side,
				})
			end
		end
	end
	return {
		Seed = seed,
		HalfWidth = Layout.HalfWidth,
		Spawns = {
			{ Lane = 1, Name = "Left", X = -150, Z = Layout.SpawnZ },
			{ Lane = 2, Name = "Centre", X = 0, Z = Layout.SpawnZ - 15 },
			{ Lane = 3, Name = "Right", X = 150, Z = Layout.SpawnZ },
		},
		Village = {
			MinZ = Layout.VillageMinZ,
			MaxZ = Layout.VillageMaxZ,
			Houses = houses,
			Chapel = chapel,
			Graveyard = graveyard,
			Well = well,
			Gallows = gallows,
			Pond = pond,
			Carts = carts,
		},
		Lanes = laneList,
		Crossroads = { X = 0, Z = 990, Radius = 48, Monument = 11 },
		Corridor = { StartZ = Layout.CorridorStartZ, EndZ = Layout.CorridorEndZ, WallHeight = 13 },
		CorridorLights = corridorLights,
		DeadTrees = deadTrees,
		Walls = wallList,
		Doors = { X = 0, Z = 1392, Width = 26, Height = 34 },
		Staging = { X = 0, Z = 1362 },
		Baileys = baileys(wallList),
		City = { MinZ = Layout.CityZ },
	}
end

return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">FeatureFlagSpec</string>
            <string name="Source"><![CDATA[--!strict
-- Pure rules for feature flags and spell kill switches; shared by server and client.
local Spec = {}

Spec.EarlyAccessAttribute = "EarlyAccess" -- server-owned Player attribute (granted by purchases later)

export type Feature = { Enabled: boolean, PublicReleaseAt: number? }
export type Flags = {
	RefreshSeconds: number,
	Features: { [string]: Feature },
	DisabledForms: { string },
	DisabledPayloads: { string },
	DisabledBehaviors: { string },
}

local LIST_KEYS = { "DisabledForms", "DisabledPayloads", "DisabledBehaviors" }
local MAX_FEATURES, MAX_LIST, MAX_NAME = 128, 64, 48

local function name(value: any): boolean
	return type(value) == "string" and #value > 0 and #value <= MAX_NAME and not value:find("[^%w_]")
end

-- Merges a stored override document over defaults. Invalid entries are ignored
-- (never trusted), so a bad override can only fail closed to the defaults.
function Spec.merge(defaults: Flags, override: any): Flags
	local result: Flags = {
		RefreshSeconds = defaults.RefreshSeconds,
		Features = {},
		DisabledForms = table.clone(defaults.DisabledForms),
		DisabledPayloads = table.clone(defaults.DisabledPayloads),
		DisabledBehaviors = table.clone(defaults.DisabledBehaviors),
	}
	for key, feature in defaults.Features do
		result.Features[key] = table.clone(feature)
	end
	if type(override) ~= "table" then
		return result
	end
	if type(override.Features) == "table" then
		local count = 0
		for key, feature in override.Features do
			count += 1
			if count > MAX_FEATURES then
				break
			end
			if name(key) and type(feature) == "table" and type(feature.Enabled) == "boolean" then
				local release = feature.PublicReleaseAt
				result.Features[key] = {
					Enabled = feature.Enabled,
					PublicReleaseAt = if type(release) == "number"
							and release == release
							and release > 0
						then release
						else nil,
				}
			end
		end
	end
	for _, listKey in LIST_KEYS do
		local list = override[listKey]
		if type(list) == "table" then
			local clean = {}
			for _, entry in list do
				if name(entry) and #clean < MAX_LIST and not table.find(clean, entry) then
					table.insert(clean, entry)
				end
			end
			(result :: any)[listKey] = clean
		end
	end
	return result
end

-- Unknown features are off: a typo can never enable something.
function Spec.enabled(flags: Flags, feature: string, now: number, earlyAccess: boolean?): boolean
	local entry = flags.Features[feature]
	if not entry or entry.Enabled ~= true then
		return false
	end
	if entry.PublicReleaseAt and now < entry.PublicReleaseAt then
		return earlyAccess == true
	end
	return true
end

-- Returns (allowed, reason). Walks Form, trigger payloads/behaviors and projectile behaviors.
function Spec.spellAllowed(flags: Flags, definition: any): (boolean, string?)
	if type(definition) ~= "table" then
		return false, "Invalid spell"
	end
	if table.find(flags.DisabledForms, definition.Form) then
		return false, tostring(definition.Form) .. " spells are temporarily disabled"
	end
	local function behavior(kind: any): (boolean, string?)
		if kind ~= nil and table.find(flags.DisabledBehaviors, kind) then
			return false, tostring(kind) .. " is temporarily disabled"
		end
		return true, nil
	end
	local projectile = definition.Projectile
	if type(projectile) == "table" and type(projectile.Behaviors) == "table" then
		for _, entry in projectile.Behaviors do
			local ok, reason = behavior(type(entry) == "table" and entry.Kind or nil)
			if not ok then
				return false, reason
			end
		end
	end
	if type(definition.Triggers) == "table" then
		for _, steps in definition.Triggers do
			for _, step in (if type(steps) == "table" then steps else {}) do
				if type(step) == "table" then
					local kind = if type(step.Behavior) == "table" then step.Behavior.Kind else step.Behavior
					local ok, reason = behavior(kind)
					if not ok then
						return false, reason
					end
					for _, payload in (if type(step.Payloads) == "table" then step.Payloads else {}) do
						if type(payload) == "table" and table.find(flags.DisabledPayloads, payload.Kind) then
							return false, tostring(payload.Kind) .. " effects are temporarily disabled"
						end
					end
				end
			end
		end
	end
	return true, nil
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">GrimoireLibrary</string>
            <string name="Source"><![CDATA[--!strict
-- Organization only. Spell definitions remain owned and validated by SpellSpec.
local SpellIdentitySpec = require(script.Parent.MagicSpellIdentitySpec)
local Library = { Version = 2, MaxRecords = 200, MaxCollections = 32 }
local function text(value, limit)
	return type(value) == "string" and #value > 0 and #value <= limit and not value:find("[%c]")
end
local function count(values)
	local n = 0
	for _ in pairs(values) do
		n = n + 1
	end
	return n
end
-- Tags the server uses to recognise seeded spells (GrimoireStarters). They are
-- hidden from player labels and preserved when labels are edited.
Library.SystemTags = { "starter-template", "system-showcase", "combat-starter" }

local function systemTagsOf(record)
	local found = {}
	for _, tag in ipairs(Library.SystemTags) do
		if string.find(record.Tags, tag, 1, true) then
			table.insert(found, tag)
		end
	end
	return found
end

function Library.labels(record)
	local labels = record.Tags
	for _, tag in ipairs(Library.SystemTags) do
		labels = string.gsub(labels, (string.gsub(tag, "%-", "%%-")) .. ",?%s*", "")
	end
	return labels
end
function Library.empty()
	return { Records = {}, Collections = { "Unfiled" }, Assignments = {}, NextId = 1, HelpDismissed = false }
end
function Library.add(catalog, definition, clone, now)
	if count(catalog.Records) >= Library.MaxRecords then
		return nil, "Library is full (200 spells). Archive and permanently delete unused spells first."
	end
	local id = tostring(catalog.NextId)
	catalog.NextId = catalog.NextId + 1
	catalog.Records[id] = {
		Definition = clone(definition),
		Collection = "Unfiled",
		Tags = "",
		Favorite = false,
		Archived = false,
		UpdatedAt = now,
	}
	return id
end
function Library.capture(catalog, slot, definition, clone, now)
	local key = tostring(slot)
	local id = catalog.Assignments[key]
	local record = id and catalog.Records[id]
	if record and not record.Archived then
		record.Definition, record.UpdatedAt = clone(definition), now
		return id
	end
	local reason
	id, reason = Library.add(catalog, definition, clone, now)
	if id then
		catalog.Assignments[key] = id
	end
	return id, reason
end
function Library.update(catalog, id, definition, clone, now)
	local record = type(id) == "string" and catalog.Records[id]
	if not record or record.Archived then
		return false, "Choose an active saved spell to update"
	end
	record.Definition = clone(definition)
	record.UpdatedAt = now
	return true, "Saved spell updated; equipped copies were refreshed"
end
function Library.decode(raw, slots, clone, validate, hydrate)
	local catalog = Library.empty()
	if raw ~= nil and type(raw) ~= "table" then
		return nil, "Invalid library format"
	end
	if raw == nil or raw.Version == 1 then
		for slot = 1, 9 do
			if slots[slot] then
				Library.capture(catalog, slot, slots[slot], clone, 0)
			end
		end
		return catalog
	end
	if raw.Version ~= Library.Version or type(raw.Catalog) ~= "table" then
		return nil, "Unknown library format; saved data was left untouched"
	end
	catalog = clone(raw.Catalog)
	for key in pairs(raw) do
		if key ~= "Version" and key ~= "Slots" and key ~= "Catalog" then
			return nil, "Unknown saved library fields"
		end
	end
	for key in pairs(catalog) do
		if
			key ~= "Records"
			and key ~= "Collections"
			and key ~= "Assignments"
			and key ~= "NextId"
			and key ~= "HelpDismissed"
		then
			return nil, "Unknown catalog fields"
		end
	end
	if
		type(catalog.Records) ~= "table"
		or type(catalog.Collections) ~= "table"
		or type(catalog.Assignments) ~= "table"
		or type(catalog.NextId) ~= "number"
		or catalog.NextId % 1 ~= 0
		or catalog.NextId < 1
		or catalog.NextId > 1e9
		or type(catalog.HelpDismissed) ~= "boolean"
		or count(catalog.Records) > Library.MaxRecords
		or #catalog.Collections < 1
		or #catalog.Collections > Library.MaxCollections
	then
		return nil, "Invalid library metadata"
	end
	local collections = {}
	for index, name in pairs(catalog.Collections) do
		if
			type(index) ~= "number"
			or index % 1 ~= 0
			or index < 1
			or index > #catalog.Collections
			or not text(name, 48)
			or collections[name]
		then
			return nil, "Invalid collection names"
		end
		collections[name] = true
	end
	if not collections.Unfiled then
		return nil, "Default collection is missing"
	end
	for id, record in pairs(catalog.Records) do
		local number = tonumber(id)
		if
			type(id) ~= "string"
			or not number
			or tostring(number) ~= id
			or number % 1 ~= 0
			or number < 1
			or number >= catalog.NextId
			or type(record) ~= "table"
		then
			return nil, "Invalid library entry"
		end
		for key in pairs(record) do
			if
				key ~= "Definition"
				and key ~= "Collection"
				and key ~= "Tags"
				and key ~= "Favorite"
				and key ~= "Archived"
				and key ~= "UpdatedAt"
			then
				return nil, "Unknown entry metadata"
			end
		end
		if
			not collections[record.Collection]
			or type(record.Tags) ~= "string"
			or #record.Tags > 240
			or record.Tags:find("[%c]")
			or type(record.Favorite) ~= "boolean"
			or type(record.Archived) ~= "boolean"
			or type(record.UpdatedAt) ~= "number"
			or record.UpdatedAt ~= record.UpdatedAt
			or record.UpdatedAt < 0
			or record.UpdatedAt > 1e12
		then
			return nil, "Invalid entry metadata"
		end
		if not validate(record.Definition) then
			return nil, "A library spell failed validation; saved data was left untouched"
		end
		if hydrate then
			record.Definition = hydrate(record.Definition, 1, record.Definition.SpellId)
		end
	end
	for slot, id in pairs(catalog.Assignments) do
		local number = tonumber(slot)
		if
			type(slot) ~= "string"
			or not number
			or tostring(number) ~= slot
			or number % 1 ~= 0
			or number < 1
			or number > 9
			or not slots[number]
			or not catalog.Records[id]
			or catalog.Records[id].Archived
		then
			return nil, "Invalid equipped library reference"
		end
	end
	return catalog
end
function Library.mutate(catalog, action, args, clone, now)
	if type(args) ~= "table" then
		return false, "Invalid library request"
	end
	if action == "Collection" then
		local name = args.Name
		if not text(name, 48) then
			return false, "Use a collection name of 1–48 characters"
		end
		if name:lower() == "all" then
			return false, "All is reserved for the collection filter; choose another name"
		end
		for _, existing in ipairs(catalog.Collections) do
			if existing:lower() == name:lower() then
				return false, "A collection with that name already exists"
			end
		end
		if #catalog.Collections >= Library.MaxCollections then
			return false, "Collection limit reached"
		end
		table.insert(catalog.Collections, name)
		return true, "Collection created"
	elseif action == "DismissHelp" then
		catalog.HelpDismissed = true
		return true, "Help is always available from the library"
	end
	local record = type(args.Id) == "string" and catalog.Records[args.Id]
	if not record then
		return false, "Select a library spell first"
	end
	if action == "Duplicate" then
		local id, reason = Library.add(catalog, record.Definition, clone, now)
		if not id then
			return false, reason
		end
		local copy = catalog.Records[id]
		-- A copy of a seeded spell is the player's own: it leaves the curated
		-- collection and drops the system tags seeding uses to manage originals.
		copy.Collection = if #systemTagsOf(record) > 0 or record.Collection == "Starter templates"
			then "Unfiled"
			else record.Collection
		copy.Tags = Library.labels(record)
		local base = SpellIdentitySpec.normalizeName(record.Definition.Name, SpellIdentitySpec.MaxNameLength - 7)
		copy.Definition.Name = (base or SpellIdentitySpec.DefaultName) .. " (copy)"
		return true, "Copy created; the original is unchanged"
	elseif action == "Rename" then
		local nameValid, nameReason = SpellIdentitySpec.validateName(args.Name)
		if not nameValid then
			return false, nameReason
		end
		record.Definition.Name = args.Name
	elseif action == "Move" then
		local found = false
		for _, name in ipairs(catalog.Collections) do
			if name == args.Collection then
				found = true
			end
		end
		if not found then
			return false, "Choose an existing collection"
		end
		record.Collection = args.Collection
	elseif action == "Tags" then
		if type(args.Tags) ~= "string" or #args.Tags > 240 or args.Tags:find("[%c]") then
			return false, "Labels must be at most 240 characters"
		end
		local systemTags = systemTagsOf(record)
		if #systemTags > 0 then
			local prefix = table.concat(systemTags, ", ")
			if #prefix + 2 + #args.Tags > 240 then
				return false, "Starter labels must be at most " .. tostring(238 - #prefix) .. " characters"
			end
			record.Tags = prefix .. (if args.Tags == "" then "" else ", " .. args.Tags)
		else
			record.Tags = args.Tags
		end
	elseif action == "Favorite" then
		record.Favorite = not record.Favorite
	elseif action == "Archive" or action == "Delete" then
		for _, id in pairs(catalog.Assignments) do
			if id == args.Id then
				return false, "Unequip this spell before archiving or deleting it"
			end
		end
		if action == "Delete" then
			if not record.Archived then
				return false, "Archive the spell before permanently deleting it"
			end
			catalog.Records[args.Id] = nil
			return true, "Archived spell permanently deleted"
		end
		record.Archived = true
	elseif action == "Restore" then
		record.Archived = false
	else
		return false, "Unknown library action"
	end
	record.UpdatedAt = now
	return true, "Library updated"
end
function Library.query(catalog, query)
	local results = {}
	local search = string.lower(query.Search or "")
	for id, record in pairs(catalog.Records) do
		local d = record.Definition
		local equipped = false
		for _, assigned in pairs(catalog.Assignments) do
			if assigned == id then
				equipped = true
			end
		end
		local matches = (query.Status == "Archived" and record.Archived)
			or (query.Status ~= "Archived" and not record.Archived)
		matches = matches
			and (query.Status ~= "Favorites" or record.Favorite)
			and (query.Status ~= "Equipped" or equipped)
			and (query.Status ~= "Unequipped" or not equipped)
			and (query.Status ~= "Starter templates" or string.find(record.Tags, "starter-template", 1, true) ~= nil)
		matches = matches
			and (not query.Collection or query.Collection == "All" or query.Collection == record.Collection)
		matches = matches
			and (not query.Form or query.Form == "All" or query.Form == d.Form)
			and (not query.Element or query.Element == "All" or query.Element == d.Element)
		local words = { d.Name, d.Form, d.Element, record.Collection, record.Tags }
		for event, steps in pairs(d.Triggers or {}) do
			table.insert(words, event)
			for _, step in ipairs(steps) do
				for _, payload in ipairs(step.Payloads or {}) do
					table.insert(words, payload.Kind)
				end
			end
		end
		if matches and string.find(string.lower(table.concat(words, " ")), search, 1, true) then
			table.insert(results, { Id = id, Record = record, Equipped = equipped })
		end
	end
	table.sort(results, function(a, b)
		if query.Sort == "Name" and a.Record.Definition.Name ~= b.Record.Definition.Name then
			return a.Record.Definition.Name:lower() < b.Record.Definition.Name:lower()
		end
		if query.Sort == "Cost" then
			local ca, cb =
				(a.Record.Definition.Cost or {}).ManaDemand or 0, (b.Record.Definition.Cost or {}).ManaDemand or 0
			if ca ~= cb then
				return ca < cb
			end
		elseif query.Sort ~= "Name" and a.Record.UpdatedAt ~= b.Record.UpdatedAt then
			return a.Record.UpdatedAt > b.Record.UpdatedAt
		end
		return tonumber(a.Id) < tonumber(b.Id)
	end)
	return results
end
return Library
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">GrimoireStarters</string>
            <string name="Source"><![CDATA[--!strict
-- Authored SpellSpecs. The server validates each one before adding it to a library.
local Schema = require(script.Parent.Parent.Configuration.MagicSchema)
local Spec = require(script.Parent.SpellSpec)
local VisualSpec = require(script.Parent.MagicVisualSpec)
local Starters = {}
Starters.LegacyCollection = "Starter templates"
Starters.LegacyTag = "starter-template"

-- These curated examples deliberately exercise different runtime systems.
Starters.ShowcaseCollection = "Spellcraft Showcase"
Starters.ShowcaseTag = "system-showcase"
Starters.ShowcaseExpansionCollection = Starters.ShowcaseCollection
Starters.LegacyShowcaseExpansionCollection = "Spellcraft Showcase II"
Starters.ShowcaseExpansionTag = "system-showcase"
Starters.CombatCollection = "Combat Starters"
Starters.CombatTag = "combat-starter"

