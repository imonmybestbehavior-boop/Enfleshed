			Params = { Width = 0.45, Lifetime = 0.1, Opacity = 0.8, Light = 1, TextureLength = 3 },
			Drivers = { { "Lifetime", "Homing", 0.25 } },
		}),
		-- Ambient: embers shed behind, a thin smoke wake for long-lived shots, a moving light.
		layer({
			Id = "Fire.Ambient.Embers",
			Slot = "Ambient",
			Kind = "Emitter",
			Priority = 2,
			Texture = "ember_streak",
