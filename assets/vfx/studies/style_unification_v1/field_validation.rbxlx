			Limits = { Lifetime = { 0.12, 0.6 } },
		}),
		layer({
			Id = "Fire.Trail.Heat",
			Roles = { Projectile = true },
			Slot = "Trail",
			Kind = "Trail",
			Priority = 2,
			Texture = "beam_energy",
