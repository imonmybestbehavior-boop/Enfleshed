        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">FeatureFlags</string>
            <string name="Source"><![CDATA[--!strict
-- Default feature flags. Live overrides come from the "EnfleshedFeatureFlags_v1"
-- DataStore (see FeatureFlagService) and are merged over these at runtime.
--   Enabled         false = off for everyone (kill switch)
--   PublicReleaseAt unix seconds; before it only early-access players get the feature
-- Spell kill switches disable a Form, payload Kind or behavior Kind live without a publish.
return {
	RefreshSeconds = 60,
	-- Every feature listed here is checked somewhere; add the check with the flag.
	Features = {
		DefendTheWalls = { Enabled = true }, -- DefendTheWallsService: starting/joining a run
		LootDrops = { Enabled = true }, -- InventoryService.dropLoot
	},
	DisabledForms = {},
	DisabledPayloads = {},
	DisabledBehaviors = {},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">GeneratedSpellStress</string>
            <string name="Source"><![CDATA[--!strict

-- Development-only deterministic data generator. It creates definitions only;
-- MagicService remains the sole executor and clients receive IDs, never data.
local Config = require(script.Parent.Sandbox).DevelopmentSpellStress
local Validator = require(script.Parent.Parent.Modules.SpellDefinitionValidator)

local Generator = {}

local function rng(seed)
	local state = seed
	return function()
		state = (state * 48271) % 2147483647
		return state
	end
end

local function number(nextValue, minimum, maximum)
	return minimum + nextValue() % (maximum - minimum + 1)
end

local function color(nextValue)
	return Color3.fromRGB(number(nextValue, 90, 235), number(nextValue, 90, 235), number(nextValue, 90, 235))
end

function Generator.generate(seed, count)
	local nextValue = rng(seed)
	local definitions = {}
	local order = {}
	local descriptions = {}
	for index = 1, count do
		local id = string.format("GeneratedSpell_%02d", index)
		local charged = index % 3 == 0
		local projectile = index % 2 == 1
		local material = projectile and index % 5 == 0
		local casting
		if charged then
			casting = {
				Mode = "Charged",
				MinimumCharge = 0.1 + number(nextValue, 0, 10) / 100,
				MaximumCharge = 0.7 + number(nextValue, 0, 8) / 10,
				Cooldown = number(nextValue, 3, 12) / 10,
			}
		else
			casting = { Mode = "Instant", Cooldown = number(nextValue, 2, 10) / 10 }
		end
		local definition
		if projectile then
			local payload = { Kind = "Damage", Amount = number(nextValue, 8, 24) }
			local impact = { { Payloads = { payload } } }
			local explode = nextValue() % 2 == 0
			if explode then
				table.insert(impact, {
					Behavior = "Explode",
					Radius = number(nextValue, 4, 8),
					Payloads = { { Kind = "Damage", Amount = number(nextValue, 6, 16) } },
				})
			end
			local source = { Principle = "Energy", Expression = "Unawakened" }
			local targeting = "AimDirection"
			if material then
				source = { Principle = "Matter", Expression = "Earth" }
				targeting = "MaterialTarget"
			end
			definition = {
				SpellId = id,
				Name = id,
				Version = 1,
				Tags = { "DevelopmentGenerated" },
				Source = source,
				Form = "Projectile",
				Targeting = targeting,
				Geometry = "Sphere",
				Motion = "Linear",
				Casting = casting,
				Lifetime = { Mode = "FixedDuration", Duration = number(nextValue, 12, 28) / 10 },
				Cost = {
					ManaDemand = number(nextValue, 5, 22),
					Strain = number(nextValue, 2, 16),
					Complexity = number(nextValue, 1, 4),
				},
				Projectile = { Speed = number(nextValue, 48, 120), Radius = number(nextValue, 3, 12) / 10 },
				Visual = { Color = color(nextValue) },
				Triggers = { OnImpact = impact },
			}
			if material then
				definition.Material = { Material = "Earth", Amount = 1, SearchRadius = 12 }
			end
			local behavior = ""
			if explode then
				behavior = "+ Explode"
			end
			descriptions[id] = string.format(
				"%s / Projectile / Damage%s / %s | dmg %d speed %d radius %.1f life %.1f cd %.1f mana %d strain %d complexity %d",
				definition.Source.Principle,
				behavior,
				casting.Mode,
				payload.Amount,
				definition.Projectile.Speed,
				definition.Projectile.Radius,
				definition.Lifetime.Duration,
				casting.Cooldown,
				definition.Cost.ManaDemand,
				definition.Cost.Strain,
				definition.Cost.Complexity
			)
		else
			local payloads = { { Kind = "Damage", Amount = number(nextValue, 10, 22) } }
			if nextValue() % 2 == 0 then
				table.insert(
					payloads,
					{ Kind = "Force", Magnitude = number(nextValue, 25, 65), Upward = number(nextValue, 0, 14) }
				)
			end
			definition = {
				SpellId = id,
				Name = id,
				Version = 1,
				Tags = { "DevelopmentGenerated" },
				Source = { Principle = "Body", Expression = "BodyEnhancement" },
				Form = "Wave",
				Targeting = "Self",
				Geometry = "Cone",
				Motion = "Stationary",
				Casting = casting,
				Lifetime = { Mode = "Instantaneous" },
				Cost = {
					ManaDemand = number(nextValue, 8, 24),
					Strain = number(nextValue, 3, 16),
					Complexity = number(nextValue, 1, 4),
				},
				Wave = {
					Range = number(nextValue, 6, 12),
					Dot = number(nextValue, -8, 5) / 10,
					DebugDuration = 0.18,
					Payloads = payloads,
				},
				Visual = { Color = color(nextValue) },
				Triggers = { OnCast = true },
			}
			local payloadDescription = "Damage"
			if #payloads == 2 then
				payloadDescription = "Damage+Force"
			end
			descriptions[id] = string.format(
				"Body / Wave / %s / %s | range %d dot %.1f cd %.1f mana %d strain %d complexity %d",
				payloadDescription,
				casting.Mode,
				definition.Wave.Range,
				definition.Wave.Dot,
				casting.Cooldown,
				definition.Cost.ManaDemand,
				definition.Cost.Strain,
				definition.Cost.Complexity
			)
		end
		local valid, reason = Validator.validate(definition)
		assert(valid, "Generated invalid spell " .. id .. ": " .. tostring(reason))
		definitions[id] = definition
		table.insert(order, id)
	end
	return { Definitions = definitions, Order = order, Descriptions = descriptions }
end

local generated = { Definitions = {}, Order = {}, Descriptions = {} }
if Config.Enabled then
	generated = Generator.generate(Config.SpellTestSeed, Config.GeneratedSpellCount)
end
generated.Generate = Generator.generate
return generated
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[--!strict

-- Item definitions. Profiles intentionally resolve magical actions to registered
-- Magic Runtime spell IDs rather than embedding execution logic; melee weapons
-- name a MeleeProfiles archetype. Rolled rarity and affixes live on item
-- instances (see ItemRules), never here.
--
-- Category: Weapon | Armor | Consumable | Material
-- EquipSlot: MainHand | MagicFocus | Head | Body | Legs (Consumables go in Quick slots)

local function blade(offsetZ)
	return CFrame.new(0, -0.75, -offsetZ) * CFrame.Angles(math.rad(90), 0, 0)
end

return table.freeze({
	Items = {
		RecruitMagicWeapon = {
			ItemId = "RecruitMagicWeapon",
			Name = "Recruit Magic Focus",
			Description = "Issued to every recruit who shows the spark. Cracked, but it still channels.",
			Category = "Weapon",
			ItemType = "Weapon",
			WeaponType = "MagicFocus",
			EquipSlot = "MagicFocus",
			HandsOccupied = 1,
			MaxStack = 1,
			Droppable = false,
			-- The Focus casts these registered spells for its Primary and Area actions.
			PrimarySpellId = "RecruitMagicBolt",
			AreaSpellId = "RecruitMagicDischarge",
			Icon = { Text = "FOC", Color = Color3.fromRGB(135, 220, 255) },
			Visual = {
				Name = "Recruit Magic Focus",
				Size = Vector3.new(0.55, 0.55, 3),
				Color = Color3.fromRGB(135, 220, 255),
				Material = Enum.Material.Neon,
				Offset = CFrame.new(0, -0.65, -1.2) * CFrame.Angles(math.rad(90), 0, 0),
				MuzzleOffset = CFrame.new(0, 0, -1.5),
			},
		},
		RecruitMeleeWeapon = {
			ItemId = "RecruitMeleeWeapon",
			Name = "Guard-Issue Arming Sword",
			Description = "Standard issue for the line. Generations of recruits have sharpened it.",
			Category = "Weapon",
			ItemType = "Weapon",
			WeaponType = "Melee",
			Archetype = "Sword",
			EquipSlot = "MainHand",
			HandsOccupied = 1,
			MaxStack = 1,
			Droppable = false,
			Icon = { Text = "SWD", Color = Color3.fromRGB(185, 185, 190) },
			Visual = {
				Name = "Recruit Melee Trainer",
				Size = Vector3.new(0.3, 0.45, 3.2),
				Color = Color3.fromRGB(185, 185, 190),
				Material = Enum.Material.Metal,
				Offset = blade(1.3),
			},
		},
		WallwardLongsword = {
			ItemId = "WallwardLongsword",
			Name = "Wallward Longsword",
			Description = "A wall-sentry's blade, longer and better balanced than recruit steel.",
			Category = "Weapon",
			ItemType = "Weapon",
			WeaponType = "Melee",
			Archetype = "Sword",
			EquipSlot = "MainHand",
			HandsOccupied = 1,
			MaxStack = 1,
			DamageScale = 1.1,
