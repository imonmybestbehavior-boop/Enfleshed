  <Item class="ServerScriptService" referent="334">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="335">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Protocol = require(Shared.Networking.Protocol)

-- Publish the complete client transport before requiring optional gameplay
-- services. The client launcher and editor must never wait on map generation.
local remotes = Shared:FindFirstChild(Protocol.Folder)
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = Protocol.Folder
	remotes.Parent = Shared
end
for _, name in
	{
		Protocol.Request,
		Protocol.Feedback,
		Protocol.AerialControl,
		"MagicLabRequest",
		"MagicLabResponse",
		"GrimoireResponse",
		"TrainingDummyRequest",
		"TrainingDummyResponse",
		"MagicPresentation",
		"SpellVFX",
		"MissionRemote",
		Protocol.Inventory,
	}
do
	if not remotes:FindFirstChild(name) then
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = remotes
	end
end

local function startService(name: string, callback: () -> ())
	local ok, err = pcall(callback)
	if not ok then
		warn(string.format("Combat sandbox service %s failed to start: %s", name, tostring(err)))
	end
end

startService("FeatureFlagService", function()
	require(script.Services.FeatureFlagService).start()
end)
startService("TelemetryService", function()
	require(script.Services.TelemetryService).start()
end)
startService("PlayerProfileService", function()
	require(script.Services.PlayerProfileService).start()
end)
startService("EnemyRuntime", function()
	require(script.Services.EnemyRuntime).start()
end)
startService("ActionRouter", function()
	require(script.Networking.ActionRouter).start()
end)

startService("DefendTheWallsService", function()
	require(script.Services.DefendTheWallsService).start()
end)
startService("CombatSandboxService", function()
	require(script.Services.CombatSandboxService).start()
end)
]]></string>
      </Properties>
      <Item class="Folder" referent="336">
        <Properties>
          <string name="Name">Configuration</string>
        </Properties>
      </Item>
      <Item class="Folder" referent="337">
        <Properties>
          <string name="Name">Networking</string>
        </Properties>
        <Item class="ModuleScript" referent="338">
          <Properties>
            <string name="Name">ActionRouter</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local Protocol = require(Shared:WaitForChild("Networking"):WaitForChild("Protocol"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local TargetConsent = require(Shared.Modules.MagicTargetConsentSpec)
local Services = script.Parent.Parent.Services
local Movement = require(Services.MovementService)
local Combat = require(Services.CombatService)
local Damage = require(Services.DamageService)
local Magic = require(Services.MagicService)
local Equipment = require(Services.EquipmentService)
local Inventory = require(Services.InventoryService)
local Summons = require(Services.SummonService)
local Telemetry = require(Services.TelemetryService)
local StudioSandbox = require(Shared.Configuration.DevelopmentSandbox)
local SandboxSpawn = require(Shared.Configuration.CombatBattleMap).Spawn
local Router = {}

local function playerReady(player: Player): boolean
	return player:GetAttribute("CharacterReady") == true or (RunService:IsStudio() and StudioSandbox.Enabled == true)
end

function Router.start()
	local folder = Shared:FindFirstChild(Protocol.Folder) :: Folder?
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = Protocol.Folder
		folder.Parent = Shared
	end
	local function remote(name: string): RemoteEvent
		local existing = folder:FindFirstChild(name)
		if existing and existing:IsA("RemoteEvent") then
			return existing
		end
		local event = Instance.new("RemoteEvent")
		event.Name, event.Parent = name, folder
		return event
	end
	local request = remote(Protocol.Request)
	local feedback = remote(Protocol.Feedback)
	local aerialControl = remote(Protocol.AerialControl)
	-- Publish core transport before optional services or the battlefield build;
	-- clients can start their camera and launcher even if later startup reports an error.
	Damage.Applied:Connect(function(_attacker: Model, target: Humanoid, amount: number)
		local model = target.Parent
		if model and model:IsA("Model") then
			feedback:FireAllClients({
				Kind = "ImpactNumber",
				Effect = "Damage",
				Amount = amount,
				Target = model,
			})
		end
	end)
	Inventory.start(folder)
	Equipment.start(feedback)

	local states: { [Player]: Types.PlayerState } = {}
	local limits: { [Player]: { Tokens: number, Updated: number, Sequence: number } } = {}
	local connections: { [Player]: { RBXScriptConnection } } = {}
	local aerialInputAt: { [Player]: number } = {}
	local function clearState(player: Player)
		local state = states[player]
		if state then
			Combat.reset(state)
			Movement.unbind(state)
			states[player] = nil
		end
		aerialInputAt[player] = nil
	end

	local function bind(player: Player)
		if player:GetAttribute(TargetConsent.Attribute) == nil then
			player:SetAttribute(TargetConsent.Attribute, false)
		end
		limits[player] = { Tokens = Config.Networking.Burst, Updated = os.clock(), Sequence = 0 }
		Magic.bind(player)
		Equipment.bind(player)
		local function characterAdded(character: Model)
			if player.Character ~= character then
				return
			end
			clearState(player)
			player:SetAttribute("CharacterReady", false)
			Magic.reset(player)
			local humanoid = character:WaitForChild("Humanoid", 10)
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if
				player.Character ~= character
				or not humanoid
				or not humanoid:IsA("Humanoid")
				or not root
				or not root:IsA("BasePart")
				or not limits[player]
			then
				return
			end
			-- CharacterAdded precedes parenting, rig scaling, and final spawn placement.
			-- Do not seed a movement anchor from the provisional character transform.
			local deadline = os.clock() + Config.Movement.CharacterReadyTimeout
			while not root:IsDescendantOf(workspace) do
				if player.Character ~= character or not limits[player] or humanoid.Health <= 0 then
					return
				end
				if os.clock() >= deadline then
					warn("Sandbox: character did not enter Workspace for " .. player.Name)
					return
				end
				RunService.Heartbeat:Wait()
			end
			if player.Character ~= character or not limits[player] or humanoid.Health <= 0 then
				return
			end
			local missionConfig = require(Shared.Configuration.DefendTheWalls)
			-- Defenders respawn behind the wall currently holding (it moves back as walls fall).
			local mission = workspace:FindFirstChild("DefendTheWalls")
			local fallback = mission and mission:GetAttribute("DefenderSpawn")
			local spawn = if player:GetAttribute("MissionDefender") == true
				then (if typeof(fallback) == "Vector3" then fallback else missionConfig.Defender)
				elseif player:GetAttribute("MissionSandbox") == true then SandboxSpawn
				else missionConfig.Hub
			character:PivotTo(CFrame.new(spawn))
			local now = workspace:GetServerTimeNow()
			humanoid.MaxHealth = Config.Player.MaxHealth
			humanoid.Health = Config.Player.MaxHealth
			humanoid.WalkSpeed = Config.Movement.WalkSpeed
			character:SetAttribute("MagicWalkSpeedBonus", 0)
			character:SetAttribute("MagicSpeedMultiplier", 1)
			character:SetAttribute("MagicJumpPowerBonus", 0)
			states[player] = {
				Character = character,
				Humanoid = humanoid,
				Root = root,
				Sprinting = false,
				MagicWalkSpeedBonus = 0,
				MagicSpeedMultiplier = 1,
				MagicSlowMultiplier = 1,
				MagicCastingMultiplier = 1,
				MagicRotationLocked = false,
				MagicCastingDirection = nil,
				MagicBaseJumpHeight = humanoid.JumpHeight,
				MagicJumpPowerBonus = 0,
				MagicAerialSpeed = 0,
				MagicAerialInput = Vector3.zero,
				MagicAerialInputExpiresAt = 0,
				MagicAerialAttachment = nil,
				MagicAerialVelocity = nil,
				DashUntil = 0,
				DashReadyAt = 0,
				DashCheckUntil = 0,
				DashOrigin = nil,
				LastPosition = root.Position,
				LastFramePosition = root.Position,
				LastCheck = now,
				DashAllowance = 0,
				CorrectionUntil = 0,
				SpawnGraceUntil = now + Config.Movement.SpawnValidationGrace,
				Combo = 0,
				ReadyAt = 0,
				ComboExpires = 0,
				Attack = nil,
				ActiveAt = 0,
				ActiveUntil = 0,
				HitTargets = {},
				Heavy = false,
				Blocking = false,
				AttackFacing = nil,
				DamageScale = 1,
				ParryBonusUntil = 0,
			}
			Movement.bind(states[player])
			character:SetAttribute("MagicSlowMultiplier", 1)
			character:SetAttribute("MagicCastingMultiplier", 1)
			character:SetAttribute("MagicCastingLocked", false)
			character:SetAttribute("MagicRotationLocked", false)
			Equipment.characterAdded(player, feedback)
			if require(Services.CombatSandboxService).enabled() then
				Equipment.chooseStarter(player, "Magic", feedback)
			end
			player:SetAttribute("CharacterReady", true)
			Telemetry.onboarding(player, "Spawned")
		end
		connections[player] = {
			player.CharacterAdded:Connect(characterAdded),
			player.CharacterRemoving:Connect(function(character)
				local state = states[player]
				if state and state.Character == character then
					clearState(player)
				end
			end),
		}
		if player.Character then
			task.spawn(characterAdded, player.Character)
		end
	end

	Players.PlayerAdded:Connect(bind)
	Players.PlayerRemoving:Connect(function(player)
		clearState(player)
		limits[player] = nil
		Magic.remove(player)
		Equipment.remove(player)
		for _, connection in connections[player] or {} do
			connection:Disconnect()
		end
		connections[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		bind(player)
	end

	aerialControl.OnServerEvent:Connect(function(player: Player, character: any, direction: any)
		local state = states[player]
		if
			not state
			or not playerReady(player)
			or character ~= state.Character
			or player.Character ~= state.Character
			or state.Humanoid.Health <= 0
			or not state.Root:IsDescendantOf(workspace)
		then
			return
		end
		local now = workspace:GetServerTimeNow()
		if now - (aerialInputAt[player] or 0) < 0.075 then
			return
		end
		aerialInputAt[player] = now
		if typeof(direction) == "Vector3" then
			Movement.aerialInput(state, direction, now)
		end
	end)

	request.OnServerEvent:Connect(function(player: Player, payload: any)
		local limit = limits[player]
		if not limit or not playerReady(player) then
			return
		end
		local clock = os.clock()
		limit.Tokens = math.min(
			Config.Networking.Burst,
			limit.Tokens + (clock - limit.Updated) * Config.Networking.RequestsPerSecond
		)
		limit.Updated = clock
		if limit.Tokens < 1 then
			return
		end
		limit.Tokens -= 1
		if typeof(payload) ~= "table" then
			return
		end
		local sequence = payload.Sequence
		if
			typeof(sequence) ~= "number"
			or sequence ~= sequence
			or sequence % 1 ~= 0
			or sequence <= limit.Sequence
			or sequence > Config.Networking.MaxSequence
		then
			return
		end
		limit.Sequence = sequence
		local action = payload.Action
		if
			action ~= Protocol.Sprint
			and action ~= Protocol.Dash
			and action ~= Protocol.Light
			and action ~= Protocol.Heavy
			and action ~= Protocol.BlockStart
			and action ~= Protocol.BlockEnd
			and action ~= Protocol.MagicStart
			and action ~= Protocol.MagicRelease
			and action ~= Protocol.MagicAimUpdate
			and action ~= Protocol.EquipmentSwitch
			and action ~= Protocol.EquipmentUse
			and action ~= Protocol.SummonCommand
			and action ~= Protocol.MagicConsent
		then
			return
		end
		local state = states[player]
		if
			not state
			or payload.Character ~= state.Character
			or state.Humanoid.Health <= 0
			or not state.Root:IsDescendantOf(workspace)
		then
			if payload.Character == player.Character then
				feedback:FireClient(player, {
					Kind = "Action",
					Action = action,
					Sequence = sequence,
					Character = player.Character,
					Accepted = false,
					Combo = 0,
					ReadyAt = 0,
					DashReadyAt = 0,
					Sprinting = false,
				})
			end
			return
		end
		local now = workspace:GetServerTimeNow()
		local accepted = false
		local validPosition = true
		if action == Protocol.Sprint and typeof(payload.Sprinting) == "boolean" then
			Movement.sprint(state, payload.Sprinting)
			accepted = true
		elseif action == Protocol.Light then
			validPosition = Movement.update(player, state, now, feedback)
			accepted = validPosition and Combat.request(state, now, Equipment.meleeLoadout(player), payload.Direction)
		elseif action == Protocol.Heavy then
			validPosition = Movement.update(player, state, now, feedback)
			accepted = validPosition and Combat.heavy(state, now, Equipment.meleeLoadout(player), payload.Direction)
		elseif action == Protocol.BlockStart then
			accepted = Combat.blockStart(player, state, now, Equipment.meleeLoadout(player), feedback)
		elseif action == Protocol.BlockEnd then
			accepted = Combat.blockEnd(state, now)
		elseif action == Protocol.Dash and validPosition then
			local direction = payload.Direction
			if
				typeof(direction) == "Vector3"
				and direction.X == direction.X
				and direction.Z == direction.Z
				and math.abs(direction.Y) < Config.Movement.DirectionEpsilon
				and direction.Magnitude > 0.9
				and direction.Magnitude < 1.1
			then
				Combat.blockEnd(state, now)
				accepted = Movement.dash(state, now)
				validPosition = Movement.update(player, state, now, feedback)
				accepted = accepted and validPosition
			end
		elseif action == Protocol.MagicStart and RunService:IsStudio() and StudioSandbox.Enabled then
			Magic.start(player, state, payload, feedback)
			accepted = true
		elseif action == Protocol.MagicRelease and RunService:IsStudio() and StudioSandbox.Enabled then
			Magic.release(player, state, payload, feedback)
			accepted = true
		elseif action == Protocol.MagicAimUpdate and RunService:IsStudio() and StudioSandbox.Enabled then
			accepted = Magic.updateAim(player, state, payload)
		elseif action == Protocol.MagicConsent and TargetConsent.valid(payload.AllowsTargetedSpells) then
			player:SetAttribute(TargetConsent.Attribute, payload.AllowsTargetedSpells)
			accepted = true
		elseif action == Protocol.EquipmentSwitch then
			Combat.blockEnd(state, now)
			accepted = Equipment.switch(player, payload.EquipmentSlot, feedback)
		elseif action == Protocol.SummonCommand then
			local commandAccepted, reason =
				Summons.command(player, payload.SummonMode, payload.TargetModel, payload.WorldPoint, payload.SummonId)
			accepted = commandAccepted
			feedback:FireClient(player, {
				Kind = "SummonCommand",
				Mode = payload.SummonMode,
				Accepted = commandAccepted,
				Reason = reason,
			})
		elseif action == Protocol.EquipmentUse and now >= state.DashUntil then
			local spellId, castContext = Equipment.magicCast(player, payload.EquipmentAction)
			if spellId then
				Magic.start(player, state, {
					SpellId = spellId,
					AimDirection = payload.AimDirection,
					WorldPoint = payload.WorldPoint,
					TargetModel = payload.TargetModel,
					TargetInstance = payload.TargetInstance,
				}, feedback, castContext)
				accepted = true
			end
		end
		feedback:FireClient(player, {
			Kind = "Action",
			Action = action,
			Sequence = sequence,
			Character = state.Character,
			Accepted = accepted,
			Combo = state.Combo,
			ReadyAt = state.ReadyAt,
			DashReadyAt = state.DashReadyAt,
			Sprinting = state.Sprinting,
			Blocking = state.Blocking,
		})
		if accepted and (action == Protocol.Light or action == Protocol.Heavy) and state.Attack then
			feedback:FireAllClients({
				Kind = "Swing",
				Character = state.Character,
				Combo = state.Combo,
				Heavy = state.Heavy,
				Size = state.Attack.Size,
				Offset = state.Attack.Offset,
				Duration = state.Attack.Startup + state.Attack.Active,
			})
		end
	end)

	RunService.Heartbeat:Connect(function()
		local now = workspace:GetServerTimeNow()
		for player, state in states do
			if state.Humanoid.Health <= 0 or not state.Root:IsDescendantOf(workspace) then
				clearState(player)
			elseif Movement.update(player, state, now, feedback) then
				Combat.update(player, state, now, feedback)
			end
		end
	end)
	require(Services.MagicLabService).start(folder, function(player)
		return states[player]
	end, feedback)
	require(Services.TrainingDummyService).start(folder, function(player)
		return states[player]
	end)
	require(Services.MagicPresentation).start(folder)
	require(Services.SpellVFXRelay).start(folder)
	Summons.start(Magic.castSummonSpell, Magic.getCompanionSpellProfile, feedback, Magic.executeSummonCommand)
end

return Router
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="339">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="340">
          <Properties>
            <string name="Name">CombatSandboxService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local MapConfig = require(Shared.Configuration.CombatBattleMap)
local MapGenerator = require(script.Parent.MapGenerator)
local SpawnConfig = require(Shared.Configuration.Sandbox)
local Arena = {}
function Arena.enabled()
	return true
end
function Arena.start()
	MapGenerator.Generate(MapConfig.Seed)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name, spawn.Size, spawn.Position =
		"SandboxSpawn", Vector3.new(8, 1, 8), MapConfig.Spawn - Vector3.new(0, 4, 0)
	spawn.Anchored, spawn.Neutral, spawn.Duration = true, true, 0
	spawn.Parent = workspace.Map:FindFirstChild("Props")
	local defaultSpawn = Instance.new("Part")
	defaultSpawn.Name, defaultSpawn.Size, defaultSpawn.CFrame =
		"SandboxDefaultSpawn", Vector3.new(1, 1, 1), CFrame.new(MapConfig.Spawn)
	defaultSpawn.Anchored, defaultSpawn.Transparency, defaultSpawn.CanCollide = true, 1, false
	defaultSpawn.Parent = workspace.Map:FindFirstChild("Props")
	local Physics = game:GetService("PhysicsService")
	local enemyGroup = SpawnConfig.Enemy.VisualCollisionGroup
	if not Physics:IsCollisionGroupRegistered(enemyGroup) then
		Physics:RegisterCollisionGroup(enemyGroup)
	end
	Physics:CollisionGroupSetCollidable(enemyGroup, "Default", false)
	Physics:CollisionGroupSetCollidable(enemyGroup, enemyGroup, false)
	local dummies = workspace:FindFirstChild("TrainingDummies")
	if not dummies then
		dummies = Instance.new("Folder")
		dummies.Name, dummies.Parent = "TrainingDummies", workspace
	end
	local function addPracticeDummy(position: Vector3, index: number): Model
		local model = Instance.new("Model")
		model.Name = string.format("Enfleshed_%02d", index)
		model:SetAttribute("SandboxLabel", string.format("Enfleshed %02d", index))
		local root = Instance.new("Part")
		root.Name, root.Size, root.Position = "HumanoidRootPart", Vector3.new(2, 2, 1), position + Vector3.new(0, 3, 0)
		root.Anchored, root.Transparency, root.CanCollide = false, 1, false
		root.Parent = model
		local body = Instance.new("Part")
		body.Name, body.Size, body.Position = "Torso", Vector3.new(3, 4, 1.5), position + Vector3.new(0, 4, 0)
		body.Anchored, body.CanCollide, body.Color, body.Material =
			false, false, Color3.fromRGB(119, 74, 70), Enum.Material.Slate
		body.Parent = model
		local head = Instance.new("Part")
		head.Name, head.Shape, head.Size, head.Position =
			"Head", Enum.PartType.Ball, Vector3.new(2, 2, 2), position + Vector3.new(0, 7, 0)
		head.Anchored, head.CanCollide, head.Color, head.Material =
			false, false, Color3.fromRGB(160, 132, 111), Enum.Material.Slate
		head.Parent = model
		local torsoWeld = Instance.new("WeldConstraint")
		torsoWeld.Part0, torsoWeld.Part1, torsoWeld.Parent = root, body, body
		local headWeld = Instance.new("WeldConstraint")
		headWeld.Part0, headWeld.Part1, headWeld.Parent = body, head, head
		local humanoid = Instance.new("Humanoid")
		humanoid.MaxHealth, humanoid.Health, humanoid.RequiresNeck =
			SpawnConfig.TrainingDummies.Health, SpawnConfig.TrainingDummies.Health, false
		humanoid.Parent = model
		model.PrimaryPart = root
		game:GetService("CollectionService"):AddTag(model, "MagicHostileTarget")
		model.Parent = dummies
		return model
	end
	local enemies = Instance.new("Folder")
	enemies.Name, enemies.Parent = "BattleEnemies", workspace
	for index = 1, 12 do
		local angle = math.pi * 2 * (index - 1) / 12
		local radius = if index % 2 == 0 then 175 else 205
		local position = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		local handle = require(script.Parent.EnemyService).create(
			position,
			enemies,
			enemyGroup,
			(index - 1) * SpawnConfig.Enemy.ThinkInterval / 12,
			1 / SpawnConfig.StressTest.HitQueryRate
		)
		handle.Model:SetAttribute("SandboxLabel", string.format("Enfleshed %02d", index))
	end
	local function addMaterial(name: string, material: string, position: Vector3)
		local source = Instance.new("Part")
		source.Name, source.Size, source.Position = name, Vector3.new(6, 4, 6), position
		source.Anchored, source.Material, source.Color = true, Enum.Material.Rock, Color3.fromRGB(124, 110, 87)
		source:SetAttribute("MagicMaterial", material)
		source:SetAttribute("AvailableAmount", 50)
		source:SetAttribute("MagicRaise", true)
		source.Parent = workspace.Map:FindFirstChild("Props")
		game:GetService("CollectionService"):AddTag(source, "MagicMaterialSource")
		game:GetService("CollectionService"):AddTag(source, "MagicManipulable")
	end
	for index, material in { "Earth", "Water", "Metal", "Wood" } do
		addMaterial(material .. "Source", material, Vector3.new(28 + index * 8, 2, 360))
	end
	local targetOrigin = MapConfig.PracticeTargets or Vector3.new(0, 0, 0)
	for index = 1, 8 do
		local angle = math.pi * 2 * (index - 1) / 8
		local position = targetOrigin + Vector3.new(math.cos(angle) * 54, 0, math.sin(angle) * 54)
		local enemy = addPracticeDummy(position, index)
		local plate = Instance.new("BillboardGui")
		plate.Name, plate.Size, plate.StudsOffset, plate.AlwaysOnTop =
			"PracticeTargetLabel", UDim2.fromOffset(140, 28), Vector3.new(0, 9, 0), true
		plate.Parent = enemy:FindFirstChild("Head")
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Text, label.TextColor3, label.TextStrokeTransparency =
			"PRACTICE TARGET", Color3.fromRGB(245, 224, 188), 0.25
		label.TextScaled, label.Font = true, Enum.Font.GothamBold
		label.Parent = plate
	end
	local crate = Instance.new("Part")
	crate.Name, crate.Size, crate.Position = "MovablePracticeObject", Vector3.new(4, 4, 4), Vector3.new(-20, 3, 365)
	crate.Anchored, crate.Material, crate.Color = false, Enum.Material.WoodPlanks, Color3.fromRGB(125, 96, 60)
	crate.Parent = workspace.Map:FindFirstChild("Props")
	game:GetService("CollectionService"):AddTag(crate, "MagicManipulable")
end
return Arena
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="341">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict

-- Server-owned melee timing. Attack numbers come from the equipped weapon's
-- resolved loadout (ItemRules.meleeLoadout); the client only predicts them.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local MeleeConfig = require(Shared.Configuration.MeleeProfiles)
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local HitDetection = require(script.Parent.HitDetectionService)
local Damage = require(script.Parent.DamageService)
local Enemy = require(script.Parent.EnemyService)
local Defense = require(script.Parent.MeleeDefenseService)
local Movement = require(script.Parent.MovementService)
local Combat = {}

-- The client sends the flat direction it swung toward, because the server sees the
-- character's rotation late. Accept it only near the server's own facing.
local function attackFacing(state: Types.PlayerState, direction: any): Vector3?
	if
		typeof(direction) ~= "Vector3"
		or direction.X ~= direction.X
		or direction.Z ~= direction.Z
		or math.abs(direction.Y) >= Config.Movement.DirectionEpsilon
		or direction.Magnitude < 0.9
		or direction.Magnitude > 1.1
	then
		return nil
	end
	local look = state.Root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.001 or flat.Unit:Dot(direction.Unit) < Config.Combat.MaxFacingCorrectionDot then
		return nil
	end
	return direction.Unit
end

local function begin(state: Types.PlayerState, attack: Types.Attack, now: number, direction: any)
	state.Attack = attack
	state.ActiveAt = now + attack.Startup
	state.ActiveUntil = state.ActiveAt + attack.Active
	state.ReadyAt = state.ActiveUntil + attack.Recovery
	state.ComboExpires = state.ReadyAt + Config.Combat.ComboReset
	state.HitTargets = {}
	state.AttackFacing = attackFacing(state, direction)
	-- A parry bonus is spent on the first swing that starts inside its window.
	if now <= state.ParryBonusUntil then
		state.DamageScale = MeleeConfig.ParryBonus.Multiplier
		state.ParryBonusUntil = 0
	else
		state.DamageScale = 1
	end
end

local function busy(state: Types.PlayerState, now: number): boolean
	return now < state.ReadyAt or now < state.DashUntil or now < state.CorrectionUntil or state.Blocking
end

function Combat.request(state: Types.PlayerState, now: number, loadout: any, direction: any): boolean
	if not loadout or busy(state, now) then
		return false
	end
	local lights = loadout.Lights
	state.Combo = if now > state.ComboExpires or state.Combo < 1 then 1 else state.Combo % #lights + 1
	state.Heavy = false
	begin(state, lights[state.Combo], now, direction)
	return true
end

function Combat.heavy(state: Types.PlayerState, now: number, loadout: any, direction: any): boolean
	if not loadout or busy(state, now) then
		return false
	end
	state.Combo = 0 -- A heavy ends the light chain.
	state.Heavy = true
	begin(state, loadout.Heavy, now, direction)
	state.ComboExpires = 0
	return true
end

function Combat.blockStart(
	player: Player,
	state: Types.PlayerState,
	now: number,
	loadout: any,
	feedback: RemoteEvent
): boolean
	-- A guard can't interrupt a swing's wind-up or hit, but it cancels the recovery after it.
	if not loadout or state.Blocking or now < state.ActiveUntil or now < state.DashUntil then
		return false
	end
	state.Attack = nil
	state.ReadyAt = math.min(state.ReadyAt, now)
	state.Blocking = true
	state.Combo = 0
	local character = state.Character
	Defense.raise(character, {
		StartedAt = now,
		Reduction = loadout.Block.Reduction,
		ParryWindow = loadout.Block.ParryWindow,
		FacingDot = loadout.Block.FacingDot,
		OnParry = function(attacker: Model)
			local humanoid = attacker:FindFirstChildOfClass("Humanoid")
			if humanoid then
				Enemy.onHit(humanoid, "Major")
			end
			if state.Character == character then
				state.ParryBonusUntil = workspace:GetServerTimeNow() + MeleeConfig.ParryBonus.Window
			end
			feedback:FireAllClients({ Kind = "Guard", Result = "Parry", Character = character, Attacker = attacker })
		end,
		OnBlock = function(attacker: Model, prevented: number)
			feedback:FireAllClients({
				Kind = "Guard",
				Result = "Block",
				Character = character,
				Attacker = attacker,
				Prevented = prevented,
			})
		end,
	})
	Movement.refreshSpeed(state)
	return true
end

function Combat.blockEnd(state: Types.PlayerState, now: number): boolean
	if not state.Blocking then
		return false
	end
	state.Blocking = false
	Defense.lower(state.Character)
	Movement.refreshSpeed(state)
	-- A short recovery stops block-cancelling straight into an attack. The client mirrors it.
	state.ReadyAt = math.max(state.ReadyAt, now + Config.Combat.BlockReleaseRecovery)
	return true
end

function Combat.reset(state: Types.PlayerState)
	if state.Blocking then
		state.Blocking = false
		Defense.lower(state.Character)
	end
end

function Combat.update(player: Player, state: Types.PlayerState, now: number, feedback: RemoteEvent)
	local attack = state.Attack
	if not attack then
		return
	end
	if now > state.ActiveUntil then
		state.Attack = nil
		return
	end
	if now < state.ActiveAt then
		return
	end
	local position = state.Root.Position
	local origin = if state.AttackFacing
		then CFrame.lookAt(position, position + state.AttackFacing)
		else state.Root.CFrame
	for _, target in
		HitDetection.find(state.Character, origin, origin * CFrame.new(0, 0, -attack.Offset), attack.Size, {
			OverlapCollisionGroup = Config.Combat.OverlapCollisionGroup,
			MaxDistance = attack.Reach,
			MinimumFacingDot = Config.Combat.MinimumFacingDot,
			RequireLineOfSight = true,
			-- Swings cleave: other bodies in the way don't shield the enemies behind them.
			LineOfSightIgnoresCharacters = true,
		})
	do
		if state.HitTargets[target] then
			continue
		end
		state.HitTargets[target] = true
		local amount = Damage.applyMelee(state.Character, target, attack.Damage * state.DamageScale)
		if amount > 0 then
			-- Ordinary lights damage a Nascent without stopping its committed
			-- pressure; finishers and heavies carry stronger reactions.
			Enemy.onHit(target, attack.Reaction or "Minor")
			local hit: Types.HitResult = { Target = target.Parent :: Model, Damage = amount, Health = target.Health }
			feedback:FireClient(player, {
				Kind = "Hit",
				Character = state.Character,
				Target = hit.Target,
				Damage = hit.Damage,
				Health = hit.Health,
				Heavy = state.Heavy,
			})
		end
	end
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="342">
          <Properties>
            <string name="Name">DamageService</string>
            <string name="Source"><![CDATA[--!strict

local applied = Instance.new("BindableEvent")
local Damage = { Applied = applied.Event }
local Status = require(script.Parent.MagicStatusEffectService)
local Defense = require(script.Parent.MeleeDefenseService)
local Players = game:GetService("Players")
local DamageRules = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicDamageRules)
local CombatPolicy = require(game:GetService("ReplicatedStorage").Shared.Modules.CombatPolicy)
local StatCaps = require(game:GetService("ReplicatedStorage").Shared.Modules.SpellStatCaps)
local CapProfiles = require(game:GetService("ReplicatedStorage").Shared.Configuration.SpellStatCaps)

local function apply(
	attacker: Model,
	target: Humanoid,
	amount: number,
	eventContext: any?,
	melee: boolean
): (number, number, boolean)
	local targetModel = target.Parent
	local attackerPlayer = Players:GetPlayerFromCharacter(attacker)
	local attackerOwnerId = attackerPlayer and attackerPlayer.UserId or attacker:GetAttribute("MagicSummonOwnerUserId")
	if targetModel and targetModel:GetAttribute("MissionGateway") == true then
		if attackerOwnerId ~= nil or attacker:GetAttribute("MissionId") ~= targetModel:GetAttribute("MissionId") then
			return 0, 0, false
		end
	end
	local targetOwnerId = targetModel and targetModel:GetAttribute("MagicSummonOwnerUserId")
	if
		target.Parent == attacker
		or target.Health <= 0
		or not target:IsDescendantOf(workspace)
		or (attackerOwnerId ~= nil and attackerOwnerId == targetOwnerId)
		or not CombatPolicy.canDamage(attacker, targetModel, Players)
	then
		return 0, 0, false
	end
	local incoming = math.max(0, amount)
	if targetModel and targetModel:GetAttribute("MissionGateway") == true then
		local scales =
			require(game:GetService("ReplicatedStorage").Shared.Configuration.DefendTheWalls).GatewayDamageScale
		incoming *= scales[attacker:GetAttribute("MissionRole") or "Basic"] or scales.Basic
	end
	incoming = DamageRules.applyOutgoingStrength(incoming, attacker:GetAttribute("MagicStrengthBonus"))
	if eventContext then
		local regionMultiplier = eventContext.RegionMultiplier
		if type(regionMultiplier) == "number" and regionMultiplier == regionMultiplier then
			incoming *= math.clamp(regionMultiplier, 0, 4)
		end
		incoming = DamageRules.applyChannel(incoming, targetModel, eventContext.DamageChannel, eventContext.Element)
	end
	if targetModel and targetModel:IsA("Model") then
		incoming = Defense.resolve(attacker, targetModel, incoming, melee)
		local armor = targetModel:GetAttribute("ArmorReduction")
		if type(armor) == "number" and armor == armor then
			incoming *= 1 - math.clamp(armor, 0, 0.9)
		end
	end
	-- PvP stat caps limit the final hit between players who may fight.
	local capProfile =
		StatCaps.profileName(CombatPolicy.owner(attacker, Players), CombatPolicy.owner(targetModel, Players))
	incoming = StatCaps.damage(incoming, CapProfiles[capProfile])
	local remaining, absorbed, brokenShields = Status.absorb(target, incoming)
	local dealt = 0
	local killed = false
	if remaining > 0 then
		local before = target.Health
		target:TakeDamage(remaining)
		dealt = math.max(0, before - target.Health)
		killed = before > 0 and target.Health <= 0
	end
	if dealt > 0 then
		applied:Fire(attacker, target, dealt, killed, eventContext)
	end
	for _, effect in brokenShields do
		if effect.OnBreak then
			effect.OnBreak(target)
		end
	end
	return dealt, absorbed, killed
end

function Damage.apply(attacker: Model, target: Humanoid, amount: number, eventContext: any?): (number, number, boolean)
	return apply(attacker, target, amount, eventContext, false)
end

-- Weapon and claw strikes. These are the only hits a guard's opening moment can parry.
function Damage.applyMelee(attacker: Model, target: Humanoid, amount: number): (number, number, boolean)
	return apply(attacker, target, amount, nil, true)
end

return Damage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="343">
          <Properties>
            <string name="Name">DefendTheWallsGuards</string>
            <string name="Source"><![CDATA[--!strict
-- NPC wall guards for Defend the Walls. Spearmen hold the ground in front of their
-- gate; crossbowmen shoot from the walkway. They never respawn during a round and
-- fall back to the next wall when theirs is breached. Movement is plain MoveTo
-- (no pathfinding) and one shared Heartbeat thinks for a slice of guards per
-- frame, so a full squad stays cheap next to a three-lane wave.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Configuration.DefendTheWalls)
local Damage = require(script.Parent.DamageService)

local Guards = {}

type Guard = {
	Model: Model,
	Root: BasePart,
	Humanoid: Humanoid,
	Kind: string,
	Level: number,
	Post: CFrame,
	NextThink: number,
	NextAttack: number,
	Retreat: { Rally: Vector3, Until: number }?,
}

export type Squad = {
	spawn: (roundId: string) -> (),
	retreat: (fromLevel: number, toLevel: number) -> (),
	clear: () -> (),
	alive: () -> number,
	total: () -> number,
}

local tones = {
	Spearman = { Body = Color3.fromRGB(74, 82, 96), Trim = Color3.fromRGB(150, 140, 110) },
	Crossbowman = { Body = Color3.fromRGB(70, 60, 52), Trim = Color3.fromRGB(120, 40, 36) },
}

local function weld(root: BasePart, part: BasePart)
	part.Anchored, part.CanCollide, part.Massless = false, false, true
	part.CanQuery = true
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = root, part
	w.Parent = part
end

local function body(
	model: Model,
	root: BasePart,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame, p.Color = name, size, root.CFrame * offset, color
	p.Material = material or Enum.Material.Fabric
	if shape then
		p.Shape = shape
	end
	p.Parent = model
	weld(root, p)
	return p
end

local function makeGuard(kind: string, post: CFrame, parent: Instance, roundId: string): (Model, BasePart, Humanoid)
	local tune = Config.Guards[kind]
	local tone = tones[kind]
	local model = Instance.new("Model")
	model.Name = "Guard_" .. kind
	local root = Instance.new("Part")
	root.Name, root.Size, root.CFrame = "HumanoidRootPart", Vector3.new(2, 2, 1), post
	root.Transparency, root.CanCollide = 1, true
	root.Parent = model
	body(model, root, "Torso", Vector3.new(2, 2, 1), CFrame.new(), tone.Body, Enum.Material.Metal)
	body(model, root, "Tabard", Vector3.new(1.4, 2.4, 1.1), CFrame.new(0, -0.3, 0), tone.Trim)
	body(model, root, "Legs", Vector3.new(1.8, 2, 0.9), CFrame.new(0, -2, 0), Color3.fromRGB(40, 36, 34))
	body(
		model,
		root,
		"Head",
		Vector3.new(1.2, 1.2, 1.2),
		CFrame.new(0, 1.6, 0),
		Color3.fromRGB(176, 150, 128),
		Enum.Material.SmoothPlastic
	)
	body(
		model,
		root,
		"Helm",
		Vector3.new(1.4, 0.8, 1.4),
		CFrame.new(0, 2.05, 0),
		Color3.fromRGB(90, 94, 100),
		Enum.Material.Metal
	)
	if kind == "Spearman" then
		body(
			model,
			root,
			"Spear",
			Vector3.new(0.25, 0.25, 9),
			CFrame.new(1.2, 0.2, -2.5),
			Color3.fromRGB(70, 52, 36),
			Enum.Material.Wood
		)
		body(
			model,
			root,
			"Shield",
			Vector3.new(0.3, 2.6, 2),
			CFrame.new(-1.2, 0, -0.3) * CFrame.Angles(0, math.pi / 2, 0),
			tone.Trim,
			Enum.Material.Wood
		)
	else
		body(
			model,
			root,
			"Crossbow",
			Vector3.new(2.4, 0.3, 2),
			CFrame.new(0, 0.3, -1.3),
			Color3.fromRGB(70, 52, 36),
			Enum.Material.Wood
		)
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 2
	humanoid.MaxHealth, humanoid.Health = tune.Health, tune.Health
	humanoid.WalkSpeed = tune.WalkSpeed
	humanoid.RequiresNeck, humanoid.BreakJointsOnDeath = false, false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model
	model.PrimaryPart = root
	-- Same tags/attributes as allied dummies and summons: spells treat them as
	-- allies, target bars colour them friendly, and enemies hunt them like defenders.
	model:SetAttribute("SandboxAlignment", "Human")
	model:SetAttribute("SandboxLabel", kind .. " Guard")
	model:SetAttribute("MissionGuard", true)
	model:SetAttribute("MissionId", roundId)
	model:SetAttribute("GuardKind", kind)
	CollectionService:AddTag(model, "MagicAllyTarget")
	CollectionService:AddTag(model, "CityHuman")
	model.Parent = parent
	root:SetNetworkOwner(nil)
	return model, root, humanoid
end

local function bolt(from: Vector3, to: Vector3)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material, p.Color = Enum.Material.Neon, Color3.fromRGB(255, 214, 150)
	p.Size = Vector3.new(0.15, 0.15, (to - from).Magnitude)
	p.CFrame = CFrame.lookAt((from + to) / 2, to)
	p.Parent = workspace
	task.delay(0.12, p.Destroy, p)
end

-- levels: map handles from DefendTheWallsMap; enemies(): live enemy models.
function Guards.new(folder: Instance, levels: { any }, enemies: () -> { Model }): Squad
	local list: { Guard } = {}
	local spawnedTotal = 0
	local heartbeat: RBXScriptConnection? = nil
	local container = Instance.new("Folder")
	container.Name, container.Parent = "MissionGuards", folder
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local function nearestEnemy(from: Vector3, radius: number): (Humanoid?, BasePart?)
		local best, bestHumanoid, bestRoot = radius, nil, nil
		for _, model in enemies() do
			local root = model:FindFirstChild("HumanoidRootPart")
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
				local d = (root.Position - from).Magnitude
				if d < best then
					best, bestHumanoid, bestRoot = d, humanoid, root
				end
			end
		end
		return bestHumanoid, bestRoot
	end

	local function think(guard: Guard, now: number)
		local tune = Config.Guards[guard.Kind]
		local here = guard.Root.Position
		local retreat = guard.Retreat
		if retreat then
			local flat = Vector3.new(retreat.Rally.X - here.X, 0, retreat.Rally.Z - here.Z)
			if flat.Magnitude < 6 or now > retreat.Until then
				guard.Retreat = nil
				guard.Model:PivotTo(guard.Post)
			else
				guard.Humanoid:MoveTo(retreat.Rally)
			end
			return
		end
		local post = guard.Post.Position
		local reach = if guard.Kind == "Spearman" then tune.Leash + tune.Range else tune.Range
		local target, targetRoot = nearestEnemy(if guard.Kind == "Spearman" then post else here, reach)
		if not target or not targetRoot then
			if guard.Kind == "Spearman" and (here - post).Magnitude > 3 then
				guard.Humanoid:MoveTo(post)
			end
			return
		end
		local distance = (targetRoot.Position - here).Magnitude
		if guard.Kind == "Spearman" and distance > tune.Range then
			guard.Humanoid:MoveTo(targetRoot.Position)
			return
		end
		if now < guard.NextAttack then
			return
		end
		if guard.Kind == "Crossbowman" then
			rayParams.FilterDescendantsInstances = { guard.Model, targetRoot.Parent :: Instance, container }
			local eye = here + Vector3.new(0, 1.5, 0)
			if workspace:Raycast(eye, targetRoot.Position - eye, rayParams) then
				return -- no line of sight
			end
			bolt(eye, targetRoot.Position)
		else
			guard.Humanoid:MoveTo(here) -- plant feet for the thrust
		end
		guard.NextAttack = now + tune.Cooldown
		if guard.Kind == "Crossbowman" then
			Damage.apply(guard.Model, target, tune.Damage)
		else
			Damage.applyMelee(guard.Model, target, tune.Damage)
		end
	end

	local cursor = 0
	local function step()
		local now = os.clock()
		-- Think for at most a quarter of the squad per frame.
		local budget = math.max(1, math.ceil(#list / 4))
		for _ = 1, math.min(budget, #list) do
			cursor = cursor % #list + 1
			local guard = list[cursor]
			if guard.Humanoid.Health > 0 and now >= guard.NextThink then
				guard.NextThink = now + Config.Guards.ThinkInterval
				think(guard, now)
			end
		end
	end

	local squad = {} :: Squad
	function squad.clear()
		if heartbeat then
			heartbeat:Disconnect()
			heartbeat = nil
		end
		for _, guard in list do
			guard.Model:Destroy()
		end
		table.clear(list)
		spawnedTotal = 0
	end
	function squad.spawn(roundId: string)
		squad.clear()
		for level, counts in Config.Guards.PerWall do
			local handles = levels[level]
			for _, kind in { "Spearman", "Crossbowman" } do
				local posts = if kind == "Spearman" then handles.SpearPosts else handles.BowPosts
				for i = 1, math.min(counts[kind] or 0, #posts) do
					if spawnedTotal >= Config.Guards.MaxTotal then
						break
					end
					local model, root, humanoid = makeGuard(kind, posts[i], container, roundId)
					local guard: Guard = {
						Model = model,
						Root = root,
						Humanoid = humanoid,
						Kind = kind,
						Level = level,
						Post = posts[i],
						NextThink = os.clock() + spawnedTotal * 0.05,
						NextAttack = 0,
						Retreat = nil,
					}
					humanoid.Died:Connect(function()
						task.delay(4, function()
							if model.Parent then
								model:Destroy()
							end
						end)
					end)
					table.insert(list, guard)
					spawnedTotal += 1
				end
			end
		end
		heartbeat = RunService.Heartbeat:Connect(step)
	end
	function squad.retreat(fromLevel: number, toLevel: number)
		local target = levels[toLevel]
		local used: { [string]: number } = { Spearman = 0, Crossbowman = 0 }
		for _, guard in list do
			if guard.Level == toLevel then
				used[guard.Kind] += 1
			end
		end
		for _, guard in list do
			if guard.Level == fromLevel and guard.Humanoid.Health > 0 then
				if not target then
					-- Doors are next: everyone falls back to the staging courtyard.
					guard.Level = toLevel
					local rally = levels[#levels].Fallback -- behind the breached bastion
					guard.Post = CFrame.new(rally + Vector3.new((#list % 7 - 3) * 4, 0, 6))
					guard.Retreat = { Rally = rally, Until = os.clock() + Config.Guards.RetreatTimeout }
				else
					local posts = if guard.Kind == "Spearman" then target.SpearPosts else target.BowPosts
					used[guard.Kind] += 1
					local slot = (used[guard.Kind] - 1) % #posts + 1
					guard.Level = toLevel
					-- Overflow guards double up behind the post rather than stacking on it.
					guard.Post = posts[slot] * CFrame.new(0, 0, if used[guard.Kind] > #posts then -3 else 0)
					if guard.Kind == "Crossbowman" then
						-- Drop down the front of the fallen wall first.
						guard.Model:PivotTo(CFrame.new(levels[fromLevel].Rally))
					end
					guard.Retreat = { Rally = target.Rally, Until = os.clock() + Config.Guards.RetreatTimeout }
				end
			end
		end
	end
	function squad.alive(): number
		local n = 0
		for _, guard in list do
			if guard.Humanoid.Health > 0 and guard.Model.Parent then
				n += 1
			end
		end
		return n
	end
	function squad.total(): number
		return spawnedTotal
	end
	return squad
end

return Guards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="344">
          <Properties>
            <string name="Name">DefendTheWallsMap</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the Defend the Walls siege map from the seeded layout: terrain, village,
-- corridors and crossroads, three wall levels with the baileys between them, the final gatehouse and city
-- backdrop, and the night lighting. Returns the gameplay handles the mode needs.
local Layout = require(game:GetService("ReplicatedStorage").Shared.Modules.DefendTheWallsLayout)
local Config = require(game:GetService("ReplicatedStorage").Shared.Configuration.DefendTheWalls)
local Kit = require(script.Kit)
local Scene = require(script.Lighting)
local Village = require(script.Village)
local Corridors = require(script.Corridors)
local Walls = require(script.Walls)
local Baileys = require(script.Baileys)
local Gate = require(script.Gate)

local Map = {}
Map.Walls = Walls

export type Built = {
	Folder: Folder,
	Layout: any,
	Levels: { Walls.Level },
	Doors: Model,
	DoorConsole: BasePart,
	Spawns: { Vector3 },
	Staging: Vector3,
}

local function terrain(layout: any, random: any)
	local t = workspace.Terrain
	local minZ, maxZ = layout.Spawns[2].Z - 50, layout.Doors.Z + 30
	local width = layout.HalfWidth * 2 + 60
	t:FillBlock(CFrame.new(0, -6, (minZ + maxZ) / 2), Vector3.new(width, 12, maxZ - minZ), Enum.Material.Mud)
	-- Rock fills the pockets between corridors so the roads read as cut trenches.
	for z = layout.Corridor.StartZ + 8, layout.Corridor.EndZ - 8, 12 do
		for x = -layout.HalfWidth + 6, layout.HalfWidth - 6, 12 do
			local p = { X = x, Z = z }
			local clear = (p.X - layout.Crossroads.X) ^ 2 + (p.Z - layout.Crossroads.Z) ^ 2
				> (layout.Crossroads.Radius + 10) ^ 2
			for _, lane in layout.Lanes do
				if Layout.distanceToPath(lane.Points, p) < lane.Width / 2 + 10 then
					clear = false
				end
			end
			if clear then
				t:FillBall(Vector3.new(x, random.range(2, 7), z), random.range(8, 11), Enum.Material.Rock)
			end
		end
	end
	-- Muddy verges and moss patches in the village, a stagnant pond off the right road.
	for _ = 1, 30 do
		local p = Vector3.new(
			random.range(-layout.HalfWidth, layout.HalfWidth),
			-1.5,
			random.range(layout.Village.MinZ, layout.Village.MaxZ)
		)
		t:FillBall(
			p,
			random.range(5, 10),
			if random.next() < 0.5 then Enum.Material.LeafyGrass else Enum.Material.Ground
		)
	end
	local pond = Vector3.new(layout.Village.Pond.X, -3, layout.Village.Pond.Z)
	t:FillBall(pond, 12, Enum.Material.Air)
	t:FillBlock(CFrame.new(pond + Vector3.new(0, -1.5, 0)), Vector3.new(18, 3, 18), Enum.Material.Water)
end

function Map.build(): Built
	local layout = Layout.generate(Config.Map.Seed)
	local random = Layout.rng(Config.Map.Seed + 1)
	local folder = Instance.new("Folder")
	folder.Name = "DefendTheWalls"
	folder:SetAttribute("Seed", Config.Map.Seed)
	Scene.apply()
	terrain(layout, random)
	Village.build(folder, layout, random)
	Corridors.build(folder, layout)
	local levels = Walls.build(folder, layout)
	Baileys.build(folder, layout)
	local doors, doorConsole = Gate.build(folder, layout, random)
	Gate.bounds(folder, layout)
	local spawnFolder = Kit.folder(folder, "EnemySpawns")
	local spawns = {}
	for _, spawn in layout.Spawns do
		local marker = Kit.part(
			spawnFolder,
			"Spawn_" .. spawn.Name,
			Vector3.new(4, 1, 4),
			CFrame.new(spawn.X, 0.5, spawn.Z),
			Enum.Material.Mud,
			Kit.Color.Mud,
			false
		)
		marker.Transparency = 1
		marker:SetAttribute("Lane", spawn.Lane)
		spawns[spawn.Lane] = Vector3.new(spawn.X, 4, spawn.Z)
	end
	folder.Parent = workspace
	return {
		Folder = folder,
		Layout = layout,
		Levels = levels,
		Doors = doors,
		DoorConsole = doorConsole,
		Spawns = spawns,
		Staging = Kit.v(layout.Staging, 5),
	}
end

return Map
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="345">
            <Properties>
              <string name="Name">Baileys</string>
              <string name="Source"><![CDATA[--!strict
-- The ground between walls, so losing a wall means fighting through somewhere,
-- not crossing an empty strip. Pieces come from the layout (DefendTheWallsLayout
-- baileys): barricade chicanes per lane, a building on each tower line, raised
-- firing terraces on the flanks, and burnt wagons. Everything here collides.
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Baileys = {}
local C, M = Kit.Color, Kit.Material

local function barricade(parent: Instance, piece: any)
	local model = Instance.new("Model")
	model.Name = "Barricade"
	local base = CFrame.new(piece.X, 0, piece.Z)
	Kit.part(model, "Beam", Vector3.new(piece.W, 1.2, 1.2), base * CFrame.new(0, piece.H * 0.55, 0), M.Timber, C.Oak)
	Kit.part(
		model,
		"Block",
		Vector3.new(piece.W, piece.H * 0.5, piece.D),
		base * CFrame.new(0, piece.H * 0.25, 0),
		M.Wood,
		C.OakPale
	)
	for x = -piece.W / 2 + 1, piece.W / 2 - 1, 2.5 do
		for _, tilt in { -0.6, 0.6 } do
			Kit.detail(
				model,
				"Stake",
				Vector3.new(0.5, 0.5, 5),
				base * CFrame.new(x, piece.H * 0.6, 0) * CFrame.Angles(tilt, 0, 0),
				M.Timber,
				C.Oak
			)
		end
	end
	model.Parent = parent
end

-- Roofless ruined building with a doorway on each lane-facing side and a lit interior.
local function building(parent: Instance, piece: any)
	local model = Instance.new("Model")
	model.Name = piece.Kind
	local base = CFrame.new(piece.X, 0, piece.Z)
	local w, d, h = piece.W, piece.D, piece.H
	local stone = piece.Kind ~= "Stables"
	local material, color = if stone then M.Wall else M.Wood, if stone then C.Slate else C.Oak
	Kit.part(model, "Floor", Vector3.new(w, 0.6, d), base * CFrame.new(0, 0.3, 0), M.Cobble, C.Cobble)
	for _, side in { -1, 1 } do
		Kit.part(model, "Wall", Vector3.new(w, h, 1.5), base * CFrame.new(0, h / 2, side * d / 2), material, color)
		-- Short walls split around a doorway.
		local doorway = 6
		local seg = (d - doorway) / 2
		for _, half in { -1, 1 } do
			Kit.part(
				model,
				"Wall",
				Vector3.new(1.5, h, seg),
				base * CFrame.new(side * w / 2, h / 2, half * (doorway + seg) / 2),
				material,
				color
			)
		end
		Kit.part(
			model,
			"Lintel",
			Vector3.new(1.5, h - 8, doorway),
			base * CFrame.new(side * w / 2, 8 + (h - 8) / 2, 0),
			material,
			color
		)
	end
	-- Collapsed roof beams and rubble inside.
	for x = -w / 2 + 3, w / 2 - 3, 5 do
		Kit.detail(
			model,
			"RoofBeam",
			Vector3.new(0.8, 0.8, d),
			base * CFrame.new(x, h - 0.5, 0) * CFrame.Angles(0, 0, (x % 3) * 0.05),
			M.Timber,
			C.Oak
		)
	end
	Kit.part(
		model,
		"Rubble",
		Vector3.new(6, 2, 4),
		base * CFrame.new(-w / 4, 1, -d / 4) * CFrame.Angles(0.15, 0.4, 0.1),
		M.Rock,
		C.SlateWet
	)
	if piece.Kind == "WardenChapel" then
		for i = -2, 2 do
			local candle = Kit.detail(
				model,
				"Candle",
				Vector3.new(0.3, 1, 0.3),
				base * CFrame.new(i * 1.5, 1.6, d / 2 - 2),
				Enum.Material.Neon,
				C.Flame
			)
			if i == 0 then
				Kit.light(candle, C.Flame, 18, 1.4)
			end
		end
	elseif piece.Kind == "Armoury" or piece.Kind == "Barracks" then
		Kit.brazier(model, (base * CFrame.new(w / 4, 0, 0)).Position)
		for i = -2, 2 do
			Kit.detail(
				model,
				"WeaponRack",
				Vector3.new(0.4, 5, 0.4),
				base * CFrame.new(i * 1.2 - w / 4, 2.5, d / 2 - 1.5) * CFrame.Angles(0.2, 0, 0),
				M.Timber,
				C.Oak
			)
		end
	else
		Kit.lantern(model, (base * CFrame.new(0, 8, 0)).Position)
	end
	Kit.banner(model, base * CFrame.new(0, h + 1, -d / 2 - 0.9), 6)
	model.Parent = parent
end

-- Raised timber firing terrace on a flank, ramp on the city side.
local function terrace(parent: Instance, piece: any)
	local model = Instance.new("Model")
	model.Name = "Terrace"
	local base = CFrame.new(piece.X, 0, piece.Z)
	Kit.part(model, "Deck", Vector3.new(piece.W, 1, piece.D), base * CFrame.new(0, piece.H, 0), M.Wood, C.OakPale)
	Kit.part(
		model,
		"Base",
		Vector3.new(piece.W, piece.H - 0.5, piece.D),
		base * CFrame.new(0, (piece.H - 0.5) / 2, 0),
		M.Rock,
		C.SlateWet
	)
	Kit.part(
		model,
		"Parapet",
		Vector3.new(piece.W, 3, 1),
		base * CFrame.new(0, piece.H + 2, -piece.D / 2 + 0.5),
		M.Timber,
		C.Oak
	)
	local inward = if piece.X > 0 then -1 else 1
	local rampLength = piece.H * 2.4
	-- A wedge's tall end is local +Z; turn it to face the deck from the inner side.
	Kit.wedge(
		model,
		"Ramp",
		Vector3.new(8, piece.H, rampLength),
		base
			* CFrame.new(inward * (piece.W / 2 + rampLength / 2), piece.H / 2, piece.D / 4)
			* CFrame.Angles(0, inward * -math.pi / 2, 0),
		M.Wood,
		C.OakPale
	)
	Kit.torch(model, (base * CFrame.new(inward * (piece.W / 2 - 2), piece.H, -piece.D / 2 + 2)).Position)
	model.Parent = parent
end

function Baileys.build(parent: Instance, layout: any)
	local root = Kit.folder(parent, "Baileys")
	for _, bailey in layout.Baileys do
		local folder = Kit.folder(root, "Bailey" .. bailey.Level)
		for _, piece in bailey.Pieces do
			if piece.Kind == "Barricade" then
				barricade(folder, piece)
			elseif piece.Kind == "Terrace" then
				terrace(folder, piece)
			elseif piece.Kind == "Wagon" then
				Props.cart(folder, Vector3.new(piece.X, 0, piece.Z), math.rad(piece.Yaw or 0))
				local fire = Instance.new("Fire")
				fire.Size, fire.Heat = 6, 8
				local anchor = Kit.detail(
					folder,
					"WagonFire",
					Vector3.new(1, 1, 1),
					CFrame.new(piece.X, 3, piece.Z),
					M.Rock,
					C.Iron
				)
				anchor.Transparency = 1
				fire.Parent = anchor
				Kit.light(anchor, C.Flame, 24, 1.8)
			else
				building(folder, piece)
			end
		end
		-- Torches down the middle of each bailey so the fight between walls stays lit.
		for _, x in { -84, -28, 28, 84 } do
			Kit.torch(folder, Vector3.new(x, 0, (bailey.MinZ + bailey.MaxZ) / 2 + 12))
		end
	end
	return root
end

return Baileys
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="346">
            <Properties>
              <string name="Name">Corridors</string>
              <string name="Source"><![CDATA[--!strict
-- Three walled sunken-road corridors that meet at one crossroads. Each lane has
-- its own light colour, edge glow and landmark; side walls are cut away wherever
-- they would cross another lane's road, which is what opens the crossings.
local Layout = require(game:GetService("ReplicatedStorage").Shared.Modules.DefendTheWallsLayout)
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Corridors = {}
local C, M = Kit.Color, Kit.Material
local CHUNK = 10

local function insideAnyRoad(layout: any, p: { X: number, Z: number }, margin: number): boolean
	local cross = layout.Crossroads
	if (p.X - cross.X) ^ 2 + (p.Z - cross.Z) ^ 2 < (cross.Radius + margin) ^ 2 then
		return true
	end
	for _, lane in layout.Lanes do
		if Layout.distanceToPath(lane.Points, p) < lane.Width / 2 + margin then
			return true
		end
	end
	return false
end

local function road(parent: Instance, lane: any, color: Color3, glowFromZ: number)
	local pts = lane.Points
	for i = 1, #pts - 1 do
		local a, b = Kit.v(pts[i], 0.15), Kit.v(pts[i + 1], 0.15)
		local length = (b - a).Magnitude
		local cf = CFrame.lookAt((a + b) / 2, b)
		Kit.part(
			parent,
			"Road",
			Vector3.new(lane.Width - 4, 0.3, length + lane.Width * 0.6),
			cf,
			M.Cobble,
			C.Cobble,
			true
		)
		if math.max(a.Z, b.Z) > glowFromZ then
			for _, side in { -1, 1 } do
				local offset = cf.RightVector * side * (lane.Width / 2 - 1.2)
				Kit.strip(parent, a + offset + Vector3.new(0, 0.2, 0), b + offset + Vector3.new(0, 0.2, 0), color)
			end
		end
	end
end

local function sideWalls(parent: Instance, layout: any, lane: any)
	local height, pts = layout.Corridor.WallHeight, lane.Points
	for i = 1, #pts - 1 do
		local a, b = Kit.v(pts[i]), Kit.v(pts[i + 1])
		local length = (b - a).Magnitude
		local dir = (b - a).Unit
		local right = dir:Cross(Vector3.yAxis)
		for d = CHUNK / 2, length, CHUNK do
			for _, side in { -1, 1 } do
				local mid = a + dir * d + right * side * (lane.Width / 2 + 1.5)
				local p = { X = mid.X, Z = mid.Z }
				if
					mid.Z > layout.Corridor.StartZ
					and mid.Z < layout.Corridor.EndZ
					and not insideAnyRoad(layout, p, 0.5)
				then
					local cf =
						CFrame.lookAt(mid + Vector3.new(0, height / 2, 0), mid + Vector3.new(0, height / 2, 0) + dir)
					Kit.part(parent, "CorridorWall", Vector3.new(3, height, CHUNK + 1), cf, M.Wall, C.SlateWet)
					Kit.detail(
						parent,
						"Coping",
						Vector3.new(4, 1, CHUNK + 1),
						cf * CFrame.new(0, height / 2 + 0.5, 0),
						M.Rock,
						C.Slate
					)
					if (d / CHUNK) % 3 < 1 then
						Kit.detail(
							parent,
							"Moss",
							Vector3.new(0.3, height * 0.6, CHUNK * 0.7),
							cf * CFrame.new(-side * 1.6, -height * 0.2, 0),
							M.Moss,
							C.Moss
						)
					end
				end
			end
		end
	end
end

-- A wall across the whole front with a gap for each road, so the only ways
-- between village, corridors and the wall field are the lanes.
local function crossBarrier(parent: Instance, layout: any, z: number)
	local height = layout.Corridor.WallHeight
	for x = -layout.HalfWidth + CHUNK / 2, layout.HalfWidth, CHUNK do
		if not insideAnyRoad(layout, { X = x, Z = z }, 1) then
			Kit.part(
				parent,
				"CorridorBarrier",
				Vector3.new(CHUNK + 0.5, height, 4),
				CFrame.new(x, height / 2, z),
				M.Wall,
				C.SlateWet
			)
		end
	end
end

local function landmark(parent: Instance, layout: any, lane: any, color: Color3)
	local pts = lane.Points
	local entry = Kit.v(pts[2]) + Vector3.new(0, 0, 18)
	local model = Instance.new("Model")
	model.Name = "Landmark_" .. lane.Landmark
	if lane.Landmark == "HangedOak" then
		local beside = entry + Vector3.new(-(lane.Width / 2 + 9), 0, 0)
		Props.deadTree(model, beside, 3)
		for i = 1, 2 do
			local cage = Kit.detail(
				model,
				"GibbetCage",
				Vector3.new(2.5, 4, 2.5),
				CFrame.new(beside + Vector3.new(i * 3, 10, 0)),
				Enum.Material.Metal,
				C.Iron
			)
			cage.Transparency = 0.3
			Props.chains(model, beside + Vector3.new(i * 3, 14.5, 0), 2.5)
		end
	elseif lane.Landmark == "BrokenSpire" then
		local beside = entry + Vector3.new(lane.Width / 2 + 8, 0, 0)
		Kit.part(model, "SpireBase", Vector3.new(7, 4, 7), CFrame.new(beside + Vector3.new(0, 2, 0)), M.Wall, C.Slate)
		Kit.part(
			model,
			"Spire",
			Vector3.new(4, 26, 4),
			CFrame.new(beside + Vector3.new(0, 16, 0)) * CFrame.Angles(0, 0.4, 0.12),
			M.Wall,
			C.SlateWet
		)
	else
		-- Aqueduct arcade spanning the right corridor's first straight.
		local a, b = Kit.v(pts[2]), Kit.v(pts[3])
		local dir, right = (b - a).Unit, (b - a).Unit:Cross(Vector3.yAxis)
		for d = 20, 80, 24 do
			local mid = a + dir * d
			for _, side in { -1, 1 } do
				Kit.part(
					model,
					"AqueductPier",
					Vector3.new(4, 22, 4),
					CFrame.new(mid + right * side * (lane.Width / 2 + 1.5) + Vector3.new(0, 11, 0)),
					M.Wall,
					C.Slate
				)
			end
			Kit.part(
				model,
				"AqueductSpan",
				Vector3.new(lane.Width + 7, 4, 5),
				CFrame.lookAt(mid + Vector3.new(0, 24, 0), mid + Vector3.new(0, 24, 0) + right),
				M.Wall,
				C.SlateWet
			)
		end
	end
	-- One coloured beacon per landmark so the lane reads from the walls.
	local beacon = Kit.detail(
		model,
		"LaneBeacon",
		Vector3.new(1.6, 1.6, 1.6),
		CFrame.new(entry + Vector3.new(0, 18, 0)),
		Enum.Material.Neon,
		color
	)
	Kit.light(beacon, color, 50, 2)
	model.Parent = parent
end

local function onLane(layout: any, p: { X: number, Z: number }, margin: number): boolean
	for _, lane in layout.Lanes do
		if Layout.distanceToPath(lane.Points, p) < lane.Width / 2 + margin then
			return true
		end
	end
	return false
end

-- The crossroads as a walled ruin rather than an open field: a ring wall with an
-- opening only where a road passes, a shrine plinth in the middle that splits the
-- flow into two channels, low cover walls in the wedges between roads to hold
-- from, and broken columns. Lane braziers on the plinth face their own exits.
local function junction(root: Instance, layout: any)
	local folder = Kit.folder(root, "Crossroads")
	local cross = layout.Crossroads
	local centre = Vector3.new(cross.X, 0, cross.Z)
	local plaza = Kit.part(
		folder,
		"CrossroadsFloor",
		Vector3.new(0.4, cross.Radius * 2, cross.Radius * 2),
		CFrame.new(cross.X, 0.2, cross.Z) * CFrame.Angles(0, 0, math.pi / 2),
		M.Cobble,
		C.Cobble
	)
	plaza.Shape = Enum.PartType.Cylinder
	plaza:SetAttribute("Lanes", "1,2,3")
	local height = layout.Corridor.WallHeight
	-- Ring wall, cut wherever a road crosses it.
	local ringRadius = cross.Radius + 1.5
	local steps = 40
	for i = 0, steps - 1 do
		local angle = (i + 0.5) / steps * math.pi * 2
		local p = centre + Vector3.new(math.cos(angle), 0, math.sin(angle)) * ringRadius
		if not onLane(layout, { X = p.X, Z = p.Z }, 1) then
			local length = 2 * math.pi * ringRadius / steps + 0.6
			local tall = if i % 7 == 3 then height * 0.55 else height -- a few collapsed bays
			local cf = CFrame.lookAt(p, centre) * CFrame.new(0, tall / 2, 0)
			Kit.part(folder, "RingWall", Vector3.new(length, tall, 3), cf, M.Wall, C.SlateWet)
			if i % 4 == 0 then
				Kit.part(folder, "RingPier", Vector3.new(4, tall + 3, 4), cf * CFrame.new(0, 1.5, -1), M.Wall, C.Slate)
			end
		end
	end
	-- Shrine plinth: solid, so the lanes have to choose a side of it.
	local plinthRadius = cross.Monument
	local plinth = Kit.part(
		folder,
		"ShrinePlinth",
		Vector3.new(3, plinthRadius * 2, plinthRadius * 2),
		CFrame.new(cross.X, 1.5, cross.Z) * CFrame.Angles(0, 0, math.pi / 2),
		M.Rock,
		C.SlateWet
	)
	plinth.Shape = Enum.PartType.Cylinder
	Kit.part(
		folder,
		"SaintStatue",
		Vector3.new(5, 15, 4),
		CFrame.new(cross.X, 10.5, cross.Z) * CFrame.Angles(0, 0.3, 0.05),
		M.Wall,
		C.Slate
	)
	Kit.detail(
		folder,
		"SaintHead",
		Vector3.new(2.4, 2.6, 2.4),
		CFrame.new(cross.X + 0.4, 19.2, cross.Z) * CFrame.Angles(0.4, 0.3, 0),
		M.Wall,
		C.Slate
	)
	for _, lane in layout.Lanes do
		-- Each lane's brazier sits on the plinth edge facing where that lane leaves.
		local exit = Kit.v(lane.Points[#lane.Points])
		local dir = Vector3.new(exit.X - cross.X, 0, exit.Z - cross.Z).Unit
		local spot = centre + dir * (plinthRadius - 2) + Vector3.new(0, 3, 0)
		local bowl = Kit.detail(
			folder,
			"LaneFire",
			Vector3.new(2.2, 1.6, 2.2),
			CFrame.new(spot + Vector3.new(0, 0.8, 0)),
			Enum.Material.Neon,
			Kit.rgb(lane.Color)
		)
		Kit.light(bowl, Kit.rgb(lane.Color), 34, 2.4, lane.Index == 2)
	end
	-- Low cover walls and broken columns in the wedges between roads.
	for i = 0, 23 do
		local angle = i / 24 * math.pi * 2
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local cover = centre + dir * (cross.Radius - 16)
		if not onLane(layout, { X = cover.X, Z = cover.Z }, 3) then
			Kit.part(
				folder,
				"CoverWall",
				Vector3.new(9, 3.6, 2),
				CFrame.lookAt(cover, centre) * CFrame.new(0, 1.8, 0),
				M.Rock,
				C.Slate
			)
		end
		local column = centre + dir * (cross.Radius - 5)
		if i % 2 == 0 and not onLane(layout, { X = column.X, Z = column.Z }, 2) then
			local tall = 6 + (i * 5) % 9
			Kit.part(
				folder,
				"BrokenColumn",
				Vector3.new(3, tall, 3),
				CFrame.new(column + Vector3.new(0, tall / 2, 0)) * CFrame.Angles(0, angle, 0.04),
				M.Wall,
				C.Slate
			)
		end
	end
	for i = 0, 1 do
		Kit.brazier(folder, centre + Vector3.new(if i == 0 then -1 else 1, 0, 0) * (cross.Radius - 9), i == 0)
	end
end

function Corridors.build(parent: Instance, layout: any)
	local root = Kit.folder(parent, "Corridors")
	for _, lane in layout.Lanes do
		local folder = Kit.folder(root, "Lane_" .. lane.Name)
		folder:SetAttribute("Lane", lane.Index)
		local color = Kit.rgb(lane.Color)
		road(folder, lane, color, layout.Corridor.StartZ - 40)
		sideWalls(folder, layout, lane)
		landmark(folder, layout, lane, color)
	end
	junction(root, layout)
	crossBarrier(root, layout, layout.Corridor.StartZ)
	crossBarrier(root, layout, layout.Corridor.EndZ)
	-- Lane lights: warm torches in the corridors, lane-tinted lanterns in the village.
	local lights = Kit.folder(root, "LaneLights")
	for _, spot in layout.CorridorLights do
		local lane = layout.Lanes[spot.Lane]
		local tint = Kit.rgb(lane.Color)
		if spot.Z >= layout.Corridor.StartZ then
			Kit.torch(lights, Vector3.new(spot.X, 0, spot.Z), tint:Lerp(C.Flame, 0.55))
		elseif spot.Z > layout.Spawns[1].Z + 20 then
			Kit.detail(
				lights,
				"LanternPost",
				Vector3.new(0.5, 9, 0.5),
				CFrame.new(spot.X, 4.5, spot.Z),
				M.Timber,
				C.Oak
			)
			Kit.lantern(lights, Vector3.new(spot.X + 1, 7, spot.Z), tint)
		end
	end
	for i, p in layout.DeadTrees do
		Props.deadTree(root, Kit.v(p), i)
	end
	return root
end

return Corridors
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="347">
            <Properties>
              <string name="Name">Gate</string>
              <string name="Source"><![CDATA[--!strict
-- The final doors in the inner gatehouse, the staging courtyard in front of them,
-- and the city backdrop behind (silhouettes only, sealed by invisible blockers).
local CollectionService = game:GetService("CollectionService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Configuration.DefendTheWalls)
local Kit = require(script.Parent.Kit)

local Gate = {}
local C, M = Kit.Color, Kit.Material

function Gate.build(parent: Instance, layout: any, random: any): (Model, BasePart)
	local root = Kit.folder(parent, "Gatehouse")
	local doors = layout.Doors
	local faceZ, height = doors.Z, 44
	-- Gatehouse face across the full width, with the door opening in the middle.
	local half = layout.HalfWidth
	for _, side in { -1, 1 } do
		local inner = doors.Width / 2
		local width = half - inner
		Kit.part(
			root,
			"GatehouseWall",
			Vector3.new(width, height, 12),
			CFrame.new(side * (inner + width / 2), height / 2, faceZ + 6),
			M.Wall,
			C.Slate
		)
		Kit.part(
			root,
			"GateTower",
			Vector3.new(18, height + 18, 18),
			CFrame.new(side * (inner + 9), (height + 18) / 2, faceZ + 4),
			M.Wall,
			C.SlateWet
		)
		Kit.brazier(root, Vector3.new(side * (inner + 6), 0, faceZ - 10), true)
		Kit.banner(root, CFrame.new(side * (inner + 9), height + 10, faceZ - 5.5), 18)
	end
	Kit.part(
		root,
		"DoorArch",
		Vector3.new(doors.Width, height - doors.Height, 12),
		CFrame.new(0, (height + doors.Height) / 2, faceZ + 6),
		M.Wall,
		C.SlateWet
	)
	local model = Instance.new("Model")
	model.Name = "FinalGate"
	local hit = Kit.part(
		model,
		"HumanoidRootPart",
		Vector3.new(doors.Width - 6, 12, 2),
		CFrame.new(0, 6, faceZ - 3),
		M.Wood,
		C.Oak,
		false
	)
	hit.Transparency, hit.CanQuery = 1, true
	for _, side in { -1, 1 } do
		local leaf = Kit.part(
			model,
			"DoorLeaf",
			Vector3.new(doors.Width / 2, doors.Height, 3),
			CFrame.new(side * doors.Width / 4, doors.Height / 2, faceZ),
			M.Wood,
			C.Oak
		)
		leaf:SetAttribute("Blocker", "City")
		for y = 4, doors.Height - 3, 6 do
			Kit.detail(
				model,
				"DoorBand",
				Vector3.new(doors.Width / 2 - 0.5, 1, 3.4),
				CFrame.new(side * doors.Width / 4, y, faceZ),
				M.Iron,
				C.Iron
			)
		end
		Kit.detail(model, "DoorRing", Vector3.new(2, 2, 0.6), CFrame.new(side * 2.5, 12, faceZ - 1.9), M.Iron, C.Iron)
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "Humanoid"
	humanoid.MaxHealth, humanoid.Health = Config.GatewayIntegrity, Config.GatewayIntegrity
	humanoid.RequiresNeck, humanoid.BreakJointsOnDeath = false, false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model
	model.PrimaryPart = hit
	model:SetAttribute("MissionGateway", true)
	model:SetAttribute("FinalGate", true)
	CollectionService:AddTag(model, "CityHuman")
	model.Parent = root
	local console =
		Kit.part(root, "DoorRepairConsole", Vector3.new(4, 5, 3), CFrame.new(18, 2.5, faceZ - 14), M.Iron, C.Iron)
	local rune = Kit.detail(
		root,
		"ConsoleRune",
		Vector3.new(2.5, 0.3, 2),
		CFrame.new(18, 5.2, faceZ - 14),
		Enum.Material.Neon,
		C.Bone
	)
	Kit.light(rune, C.Bone, 10, 1)
	-- Staging courtyard floor.
	Kit.part(
		root,
		"StagingFloor",
		Vector3.new(half * 2, 0.4, faceZ - layout.Walls[3].Z - 10),
		CFrame.new(0, 0.2, (faceZ + layout.Walls[3].Z) / 2 + 2),
		M.Cobble,
		C.Cobble
	)
	-- City backdrop: dark silhouettes with a few lit windows, never reachable.
	local city = Kit.folder(root, "CityBackdrop")
	for i = 1, 26 do
		local x = random.range(-half - 60, half + 60)
		local z = layout.City.MinZ + 20 + random.range(0, 220)
		local w, h = random.range(16, 34), random.range(30, 90)
		local block = Kit.part(
			city,
			"CityBlock",
			Vector3.new(w, h, w),
			CFrame.new(x, h / 2, z),
			M.Wall,
			Color3.fromRGB(22, 24, 30),
			false
		)
		block.CastShadow = false
		if random.next() < 0.45 then
			Kit.wedge(
				city,
				"CitySpire",
				Vector3.new(w * 0.4, h * 0.6, w * 0.4),
				CFrame.new(x, h + h * 0.3, z),
				M.Wall,
				Color3.fromRGB(22, 24, 30)
			).CanCollide =
				false
		end
		for _ = 1, 3 do
			local window = Kit.detail(
				city,
				"CityWindow",
				Vector3.new(1.4, 2.2, 0.2),
				CFrame.new(x + random.range(-w / 3, w / 3), random.range(8, h - 4), z - w / 2 - 0.2),
				Enum.Material.Neon,
				Color3.fromRGB(255, 190, 110)
			)
			window.Transparency = 0.15
		end
	end
	local cathedral = Kit.part(
		city,
		"Cathedral",
		Vector3.new(40, 120, 40),
		CFrame.new(0, 60, layout.City.MinZ + 160),
		M.Wall,
		Color3.fromRGB(18, 20, 26),
		false
	)
	cathedral.CastShadow = false
	local blocker = Kit.part(
		root,
		"CityBlocker",
		Vector3.new(half * 2 + 40, 200, 4),
		CFrame.new(0, 100, faceZ + 14),
		M.Wall,
		C.Slate
	)
	blocker.Transparency = 1
	return model, console
end

-- Side and rear blockers plus cliff faces so nothing leaves the playable strip.
function Gate.bounds(parent: Instance, layout: any)
	local root = Kit.folder(parent, "Bounds")
	local minZ, maxZ = layout.Spawns[2].Z - 40, layout.Doors.Z + 20
	local length = maxZ - minZ
	for _, side in { -1, 1 } do
		local x = side * (layout.HalfWidth + 4)
		Kit.part(
			root,
			"Cliff",
			Vector3.new(14, 34, length),
			CFrame.new(x + side * 4, 17, (minZ + maxZ) / 2) * CFrame.Angles(0, 0, side * -0.08),
			M.Rock,
			C.SlateWet
		)
		local wall = Kit.part(
			root,
			"Blocker",
			Vector3.new(4, 200, length),
			CFrame.new(x, 100, (minZ + maxZ) / 2),
			M.Wall,
			C.Slate
		)
		wall.Transparency = 1
	end
	local back = Kit.part(
		root,
		"Blocker",
		Vector3.new(layout.HalfWidth * 2 + 20, 200, 4),
		CFrame.new(0, 100, minZ),
		M.Wall,
		C.Slate
	)
	back.Transparency = 1
	for x = -layout.HalfWidth, layout.HalfWidth, 24 do
		Kit.part(
			root,
			"RearCliff",
			Vector3.new(26, 30, 14),
			CFrame.new(x, 15, minZ + 4) * CFrame.Angles(0.1, 0, 0),
			M.Rock,
			C.SlateWet
		)
	end
end

return Gate
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="348">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- Shared building blocks for the siege map: one palette, one part helper and a
-- few reusable pieces (torch, brazier, lantern, banner). Blockout stage: these
-- are well-materialled Parts; DefendTheWallsAssets lists the mesh kit that will
-- replace them piece by piece.
local Kit = {}

Kit.Color = {
	Slate = Color3.fromRGB(52, 56, 62),
	SlateWet = Color3.fromRGB(40, 44, 50),
	Cobble = Color3.fromRGB(70, 68, 64),
	Oak = Color3.fromRGB(52, 38, 28),
	OakPale = Color3.fromRGB(84, 64, 46),
	Iron = Color3.fromRGB(46, 46, 50),
	Moss = Color3.fromRGB(52, 64, 44),
	Mud = Color3.fromRGB(58, 48, 38),
	Plaster = Color3.fromRGB(122, 112, 96),
	Bone = Color3.fromRGB(176, 166, 140),
	Flame = Color3.fromRGB(255, 160, 80),
	Banner = Color3.fromRGB(96, 22, 26),
}

Kit.Material = {
	Wall = Enum.Material.Slate,
	Cobble = Enum.Material.Cobblestone,
	Wood = Enum.Material.WoodPlanks,
	Timber = Enum.Material.Wood,
	Iron = Enum.Material.DiamondPlate,
	Rock = Enum.Material.Rock,
	Plaster = Enum.Material.Plaster,
	Moss = Enum.Material.Grass,
}

function Kit.folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name, f.Parent = name, parent
	return f
end

function Kit.part(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	material: Enum.Material,
	color: Color3,
	collide: boolean?
): Part
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, size, cf
	p.Anchored = true
	p.Material, p.Color = material, color
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.CanCollide = collide ~= false
	if collide == false then
		p.CanQuery, p.CanTouch = false, false
	end
	p.Parent = parent
	return p
end

function Kit.wedge(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	material: Enum.Material,
	color: Color3
): WedgePart
	local w = Instance.new("WedgePart")
	w.Name, w.Size, w.CFrame = name, size, cf
	w.Anchored, w.Material, w.Color = true, material, color
	w.Parent = parent
	return w
end

-- Decorative only: no collision, query or touch, and no shadow for tiny bits.
function Kit.detail(
	parent: Instance,
	name: string,
	size: Vector3,
	cf: CFrame,
	material: Enum.Material,
	color: Color3
): Part
	local p = Kit.part(parent, name, size, cf, material, color, false)
	if size.Magnitude < 4 then
		p.CastShadow = false
	end
	return p
end

function Kit.light(parent: BasePart, color: Color3, range: number, brightness: number, shadows: boolean?): PointLight
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = color, range, brightness
	light.Shadows = shadows == true
	light.Parent = parent
	return light
end

local function flame(parent: Instance, cf: CFrame, size: number, color: Color3): Part
	local f = Kit.detail(parent, "Flame", Vector3.new(size, size * 1.4, size), cf, Enum.Material.Neon, color)
	f.Shape = Enum.PartType.Ball
	return f
end

-- Wall-mounted or free-standing torch. Warm light pool; shadows only when asked
-- (shadowed lights are expensive on console, so only hero lights cast them).
function Kit.torch(parent: Instance, base: Vector3, color: Color3?, shadows: boolean?): Model
	local model = Instance.new("Model")
	model.Name = "Torch"
	Kit.detail(
		model,
		"Post",
		Vector3.new(0.6, 7, 0.6),
		CFrame.new(base + Vector3.new(0, 3.5, 0)),
		Kit.Material.Timber,
		Kit.Color.Oak
	)
	Kit.detail(
		model,
		"Cup",
		Vector3.new(1.2, 0.8, 1.2),
		CFrame.new(base + Vector3.new(0, 7.2, 0)),
		Kit.Material.Iron,
		Kit.Color.Iron
	)
	local f = flame(model, CFrame.new(base + Vector3.new(0, 8.1, 0)), 1, color or Kit.Color.Flame)
	Kit.light(f, color or Kit.Color.Flame, 22, 1.6, shadows)
	model.Parent = parent
	return model
end

function Kit.brazier(parent: Instance, base: Vector3, shadows: boolean?): Model
	local model = Instance.new("Model")
	model.Name = "Brazier"
	Kit.detail(
		model,
		"Stand",
		Vector3.new(1, 3, 1),
		CFrame.new(base + Vector3.new(0, 1.5, 0)),
		Kit.Material.Iron,
		Kit.Color.Iron
	)
	local bowl = Kit.detail(
		model,
		"Bowl",
		Vector3.new(1.4, 3.6, 3.6),
		CFrame.new(base + Vector3.new(0, 3.4, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Kit.Material.Iron,
		Kit.Color.Iron
	)
	bowl.Shape = Enum.PartType.Cylinder
	local f = flame(model, CFrame.new(base + Vector3.new(0, 4.6, 0)), 2.4, Kit.Color.Flame)
	Kit.light(f, Kit.Color.Flame, 30, 2.2, shadows)
	local fire = Instance.new("Fire")
	fire.Size, fire.Heat, fire.Color, fire.SecondaryColor = 4, 6, Kit.Color.Flame, Color3.fromRGB(120, 30, 10)
	fire.Parent = f
	model.Parent = parent
	return model
end

function Kit.lantern(parent: Instance, at: Vector3, color: Color3?): Part
	local hook = Kit.detail(
		parent,
		"LanternChain",
		Vector3.new(0.2, 2, 0.2),
		CFrame.new(at + Vector3.new(0, 1.5, 0)),
		Kit.Material.Iron,
		Kit.Color.Iron
	)
	local glass = Kit.detail(
		parent,
		"Lantern",
		Vector3.new(0.9, 1.2, 0.9),
		CFrame.new(at),
		Enum.Material.Neon,
		color or Kit.Color.Flame
	)
	Kit.light(glass, color or Kit.Color.Flame, 14, 1.2)
	return hook
end

function Kit.banner(parent: Instance, top: CFrame, height: number)
	Kit.detail(parent, "BannerPole", Vector3.new(5, 0.4, 0.4), top, Kit.Material.Timber, Kit.Color.Oak)
	Kit.detail(
		parent,
		"Banner",
		Vector3.new(4, height, 0.15),
		top * CFrame.new(0, -height / 2 - 0.2, 0),
		Enum.Material.Fabric,
		Kit.Color.Banner
	)
end

-- Emissive lane edge strip: keeps lane borders readable in the dark.
function Kit.strip(parent: Instance, a: Vector3, b: Vector3, color: Color3)
	local length = (b - a).Magnitude
	if length < 0.5 then
		return
	end
	local strip = Kit.detail(
		parent,
		"LaneGlow",
		Vector3.new(0.5, 0.2, length),
		CFrame.lookAt((a + b) / 2, b),
		Enum.Material.Neon,
		color
	)
	strip.Transparency = 0.35
end

-- World label: near-only and never drawn through geometry, so labels can't stack.
function Kit.label(parent: BasePart, text: string, color: Color3, maxDistance: number)
	local sign = Instance.new("BillboardGui")
	sign.Size, sign.StudsOffset = UDim2.fromOffset(170, 30), Vector3.new(0, parent.Size.Y / 2 + 3, 0)
	sign.AlwaysOnTop, sign.MaxDistance, sign.LightInfluence = false, maxDistance, 0
	sign.Parent = parent
	local caption = Instance.new("TextLabel")
	caption.Size, caption.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	caption.Text, caption.TextColor3, caption.TextScaled, caption.Font = text, color, true, Enum.Font.GothamBold
	caption.TextStrokeTransparency = 0.4
	caption.Parent = sign
end

function Kit.v(p: { X: number, Z: number }, y: number?): Vector3
	return Vector3.new(p.X, y or 0, p.Z)
end

function Kit.rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="349">
            <Properties>
              <string name="Name">Lighting</string>
              <string name="Source"><![CDATA[--!strict
-- Night scene: cold moonlight, thick blue-grey fog and warm local light pools.
-- Technology = Future is set in default.project.json (not writable from scripts).
-- Values are tuned to stay readable on a Steam Deck panel; see Config.Map.Lighting.
local Lighting = game:GetService("Lighting")
local Config = require(game:GetService("ReplicatedStorage").Shared.Configuration.DefendTheWalls)

local Scene = {}

local function child(className: string, name: string): any
	local existing = Lighting:FindFirstChild(name)
	if existing then
		return existing
	end
	local object = Instance.new(className)
	object.Name, object.Parent = name, Lighting
	return object
end

function Scene.apply()
	local tune = Config.Map.Lighting
	Lighting:SetAttribute("SceneOwner", "DefendTheWalls")
	Lighting.ClockTime = tune.ClockTime
	Lighting.Brightness = tune.Brightness
	Lighting.Ambient = tune.Ambient
	Lighting.OutdoorAmbient = tune.OutdoorAmbient
	Lighting.ColorShift_Top = Color3.fromRGB(120, 140, 170)
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.ExposureCompensation = tune.Exposure
	Lighting.GlobalShadows = true
	local atmosphere = child("Atmosphere", "SiegeAtmosphere")
	atmosphere.Density, atmosphere.Offset = tune.FogDensity, 0.12
	atmosphere.Color, atmosphere.Decay = Color3.fromRGB(78, 88, 104), Color3.fromRGB(34, 38, 52)
	atmosphere.Glare, atmosphere.Haze = 0, 2.1
	local battle = Lighting:FindFirstChild("BattleMapAtmosphere")
	if battle then
		battle:Destroy()
	end
	local grade = child("ColorCorrectionEffect", "SiegeGrade")
	grade.Contrast, grade.Saturation, grade.TintColor = 0.12, -0.18, Color3.fromRGB(226, 232, 255)
	local bloom = child("BloomEffect", "SiegeBloom")
	bloom.Intensity, bloom.Size, bloom.Threshold = 0.55, 28, 1.6
	local sky = child("Sky", "SiegeSky")
	sky.StarCount, sky.MoonAngularSize, sky.CelestialBodiesShown = 1800, 14, true
end

return Scene
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="350">
            <Properties>
              <string name="Name">Props</string>
              <string name="Source"><![CDATA[--!strict
-- Reusable set dressing. Small props are decorative (no collision/query) so they
-- never snag enemy pathing; anything that blocks movement says so by name.
local Kit = require(script.Parent.Kit)

local Props = {}
local C, M = Kit.Color, Kit.Material

function Props.well(parent: Instance, at: Vector3)
	local model = Instance.new("Model")
	model.Name = "Well"
	local ring = Kit.part(
		model,
		"WellRing",
		Vector3.new(3, 7, 7),
		CFrame.new(at + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		M.Rock,
		C.SlateWet
	)
	ring.Shape = Enum.PartType.Cylinder
	for _, side in { -1, 1 } do
		Kit.detail(
			model,
			"WellPost",
			Vector3.new(0.6, 6, 0.6),
			CFrame.new(at + Vector3.new(side * 3, 5, 0)),
			M.Timber,
			C.Oak
		)
	end
	Kit.detail(model, "WellBeam", Vector3.new(7, 0.6, 0.6), CFrame.new(at + Vector3.new(0, 8, 0)), M.Timber, C.Oak)
	Kit.lantern(model, at + Vector3.new(0, 6.5, 0))
	model.Parent = parent
end

function Props.gallows(parent: Instance, at: Vector3)
	local model = Instance.new("Model")
	model.Name = "Gallows"
	Kit.part(model, "Platform", Vector3.new(12, 4, 8), CFrame.new(at + Vector3.new(0, 2, 0)), M.Wood, C.Oak)
	Kit.detail(model, "Upright", Vector3.new(0.9, 10, 0.9), CFrame.new(at + Vector3.new(-4, 9, 0)), M.Timber, C.Oak)
	Kit.detail(model, "Arm", Vector3.new(7, 0.8, 0.8), CFrame.new(at + Vector3.new(-1, 13.6, 0)), M.Timber, C.Oak)
	for _, x in { 0, 2 } do
		Kit.detail(
			model,
			"Noose",
			Vector3.new(0.15, 3, 0.15),
			CFrame.new(at + Vector3.new(x, 11.8, 0)),
			Enum.Material.Fabric,
			C.OakPale
		)
	end
	Props.crow(model, at + Vector3.new(1, 14.3, 0))
	model.Parent = parent
end

function Props.cart(parent: Instance, at: Vector3, yaw: number)
	local model = Instance.new("Model")
	model.Name = "BrokenCart"
	local base = CFrame.new(at) * CFrame.Angles(0, yaw, 0.18)
	Kit.part(model, "Bed", Vector3.new(5, 1, 8), base * CFrame.new(0, 2.2, 0), M.Wood, C.OakPale)
	for _, side in { -1, 1 } do
		Kit.detail(model, "Side", Vector3.new(0.3, 1.5, 8), base * CFrame.new(side * 2.4, 3.2, 0), M.Wood, C.Oak)
	end
	local wheel = Kit.detail(model, "Wheel", Vector3.new(0.5, 4, 4), base * CFrame.new(2.8, 2, -1.5), M.Timber, C.Oak)
	wheel.Shape = Enum.PartType.Cylinder
	Kit.detail(model, "LooseWheel", Vector3.new(4, 0.5, 4), CFrame.new(at + Vector3.new(-4, 0.3, 2)), M.Timber, C.Oak)
	model.Parent = parent
end

function Props.fenceLoop(parent: Instance, center: Vector3, width: number, depth: number)
	local corners = {
		center + Vector3.new(-width / 2, 0, -depth / 2),
		center + Vector3.new(width / 2, 0, -depth / 2),
		center + Vector3.new(width / 2, 0, depth / 2),
		center + Vector3.new(-width / 2, 0, depth / 2),
	}
	for i = 1, 4 do
		local a, b = corners[i], corners[i % 4 + 1]
		local length = (b - a).Magnitude
		for d = 0, length, 4 do
			-- Leave a gate gap in the middle of the front run, and gaps where posts rotted.
			if not (i == 1 and math.abs(d - length / 2) < 4) and (d * 7 + i) % 11 ~= 0 then
				local p = a + (b - a).Unit * d
				Kit.detail(
					parent,
					"FencePost",
					Vector3.new(0.4, 3.4, 0.4),
					CFrame.new(p + Vector3.new(0, 1.7, 0)),
					Enum.Material.Metal,
					C.Iron
				)
			end
		end
		Kit.detail(
			parent,
			"FenceRail",
			Vector3.new(0.25, 0.25, length),
			CFrame.lookAt((a + b) / 2 + Vector3.new(0, 2.8, 0), b + Vector3.new(0, 2.8, 0)),
			Enum.Material.Metal,
			C.Iron
		)
	end
end

function Props.deadTree(parent: Instance, at: Vector3, seed: number)
	local model = Instance.new("Model")
	model.Name = "DeadTree"
	local lean = ((seed * 37) % 10 - 5) * 0.02
	Kit.part(
		model,
		"Trunk",
		Vector3.new(2, 16, 2),
		CFrame.new(at + Vector3.new(0, 8, 0)) * CFrame.Angles(lean, 0, -lean),
		Enum.Material.Wood,
		Color3.fromRGB(38, 32, 28)
	)
	for i = 1, 3 do
		local angle = seed + i * 2.1
		Kit.detail(
			model,
			"Branch",
			Vector3.new(0.7, 0.7, 7),
			CFrame.new(at + Vector3.new(0, 9 + i * 2, 0)) * CFrame.Angles(0.5, angle, 0) * CFrame.new(0, 0, -3.5),
			Enum.Material.Wood,
			Color3.fromRGB(38, 32, 28)
		)
	end
	Props.crow(model, at + Vector3.new(0, 16.4, 0))
	model.Parent = parent
end

function Props.crow(parent: Instance, at: Vector3)
	Kit.detail(
		parent,
		"Crow",
		Vector3.new(0.6, 0.7, 1.1),
		CFrame.new(at),
		Enum.Material.SmoothPlastic,
		Color3.fromRGB(14, 14, 16)
	)
end

function Props.spikes(parent: Instance, from: Vector3, to: Vector3)
	local length = (to - from).Magnitude
	local dir = (to - from).Unit
	for d = 1, length, 3 do
		local p = from + dir * d
		Kit.detail(
			parent,
			"Stake",
			Vector3.new(0.6, 5, 0.6),
			CFrame.lookAt(p, p + dir) * CFrame.Angles(-0.7, 0, 0) * CFrame.new(0, 1.8, 0),
			M.Timber,
			C.Oak
		)
	end
end

function Props.chains(parent: Instance, top: Vector3, length: number)
	Kit.detail(
		parent,
		"Chain",
		Vector3.new(0.3, length, 0.3),
		CFrame.new(top - Vector3.new(0, length / 2, 0)),
		Enum.Material.Metal,
		C.Iron
	)
end

return Props
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="351">
            <Properties>
              <string name="Name">Village</string>
              <string name="Source"><![CDATA[--!strict
-- The ruined hamlet every wave walks through, and the three spawn grounds beyond it.
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Village = {}
local C, M = Kit.Color, Kit.Material

local function house(parent: Instance, spec: any)
	local model = Instance.new("Model")
	model.Name = "House"
	local base = CFrame.new(spec.X, 0, spec.Z) * CFrame.Angles(0, math.rad(spec.Yaw), 0)
	local w, d, storey = spec.Width, spec.Depth, 9
	local h = storey * spec.Stories
	-- Stone footing, plaster infill, dark oak frame.
	Kit.part(model, "Footing", Vector3.new(w + 1, 2, d + 1), base * CFrame.new(0, 1, 0), M.Rock, C.SlateWet)
	for _, side in { -1, 1 } do
		Kit.part(
			model,
			"WallLong",
			Vector3.new(w, h, 1),
			base * CFrame.new(0, 2 + h / 2, side * d / 2),
			M.Plaster,
			C.Plaster
		)
		Kit.part(
			model,
			"WallShort",
			Vector3.new(1, h, d),
			base * CFrame.new(side * w / 2, 2 + h / 2, 0),
			M.Plaster,
			C.Plaster
		)
	end
	-- Doorway gap on the front: carve by covering with a dark recess (blockout).
	Kit.detail(model, "Door", Vector3.new(4, 7, 0.4), base * CFrame.new(0, 5.5, -d / 2 - 0.6), M.Wood, C.Oak)
	for x = -w / 2, w / 2, w / 3 do
		for _, side in { -1, 1 } do
			Kit.detail(
				model,
				"Beam",
				Vector3.new(0.8, h, 0.4),
				base * CFrame.new(x, 2 + h / 2, side * (d / 2 + 0.6)),
				M.Timber,
				C.Oak
			)
		end
	end
	for level = 1, spec.Stories do
		for _, side in { -1, 1 } do
			Kit.detail(
				model,
				"Rail",
				Vector3.new(w, 0.8, 0.4),
				base * CFrame.new(0, 2 + level * storey - 0.4, side * (d / 2 + 0.6)),
				M.Timber,
				C.Oak
			)
		end
	end
	-- Pitched roof from two wedges; a broken roof loses one half and shows rafters.
	local rise = d * 0.45
	local roofY = 2 + h + rise / 2
	Kit.wedge(
		model,
		"Roof",
		Vector3.new(w + 2, rise, d / 2 + 1),
		base * CFrame.new(0, roofY, -d / 4 - 0.5),
		M.Wood,
		C.OakPale
	)
	if spec.RoofBroken then
		for x = -w / 2 + 1, w / 2 - 1, 3 do
			Kit.detail(
				model,
				"Rafter",
				Vector3.new(0.6, 0.6, d / 2 + 2),
				base * CFrame.new(x, roofY, d / 4) * CFrame.Angles(math.atan2(rise, d / 2), 0, 0),
				M.Timber,
				C.Oak
			)
		end
		Kit.detail(
			model,
			"Rubble",
			Vector3.new(w * 0.6, 1.5, 4),
			base * CFrame.new(1, 2.8, d / 2 + 3) * CFrame.Angles(0.2, 0.3, 0),
			M.Rock,
			C.Slate
		)
	else
		Kit.wedge(
			model,
			"Roof",
			Vector3.new(w + 2, rise, d / 2 + 1),
			base * CFrame.new(0, roofY, d / 4 + 0.5) * CFrame.Angles(0, math.pi, 0),
			M.Wood,
			C.OakPale
		)
	end
	Kit.lantern(model, (base * CFrame.new(w / 2 - 1.5, 7.5, -d / 2 - 1.6)).Position)
	model.Parent = parent
end

local function chapel(parent: Instance, at: any)
	local model = Instance.new("Model")
	model.Name = "Chapel"
	local base = CFrame.new(at.X, 0, at.Z)
	local w, d, h = 20, 36, 18
	Kit.part(model, "Floor", Vector3.new(w, 1, d), base * CFrame.new(0, 0.5, 0), M.Cobble, C.Cobble)
	for _, side in { -1, 1 } do
		Kit.part(model, "Nave", Vector3.new(2, h, d), base * CFrame.new(side * w / 2, h / 2, 0), M.Wall, C.Slate)
		for z = -d / 2 + 4, d / 2 - 4, 8 do
			Kit.part(
				model,
				"Buttress",
				Vector3.new(3, h * 0.7, 2.5),
				base * CFrame.new(side * (w / 2 + 2), h * 0.35, z),
				M.Wall,
				C.SlateWet
			)
		end
	end
	Kit.part(model, "Apse", Vector3.new(w, h, 2), base * CFrame.new(0, h / 2, d / 2), M.Wall, C.Slate)
	-- Façade with an arched doorway gap, then the collapsed spire: a broken stump plus fallen blocks.
	for _, side in { -1, 1 } do
		Kit.part(model, "Facade", Vector3.new(7, h, 2), base * CFrame.new(side * 6.5, h / 2, -d / 2), M.Wall, C.Slate)
	end
	Kit.part(model, "Lintel", Vector3.new(6, 6, 2), base * CFrame.new(0, h - 3, -d / 2), M.Wall, C.Slate)
	Kit.part(
		model,
		"SpireStump",
		Vector3.new(8, 12, 8),
		base * CFrame.new(0, h + 6, -d / 2 + 4) * CFrame.Angles(0, 0, 0.08),
		M.Wall,
		C.SlateWet
	)
	for i, offset in { Vector3.new(-14, 2, -8), Vector3.new(-18, 1.5, 2), Vector3.new(-11, 3, 10) } do
		Kit.part(
			model,
			"FallenSpire",
			Vector3.new(5, 5, 9 - i),
			base * CFrame.new(offset) * CFrame.Angles(0.3 * i, 0.9 * i, 0.2),
			M.Wall,
			C.Slate
		)
	end
	-- Candles in the nave: the one warm interior.
	for z = 6, d / 2 - 4, 4 do
		for _, x in { -4, 4 } do
			local candle = Kit.detail(
				model,
				"Candle",
				Vector3.new(0.3, 1, 0.3),
				base * CFrame.new(x, 1.5, z),
				Enum.Material.Neon,
				C.Flame
			)
			if z == 10 then
				Kit.light(candle, C.Flame, 16, 1.4)
			end
		end
	end
	model.Parent = parent
end

local function graveyard(parent: Instance, at: any, random: any)
	local model = Instance.new("Model")
	model.Name = "Graveyard"
	for row = -2, 2 do
		for col = -3, 3 do
			if random.next() < 0.75 then
				local p = Vector3.new(at.X + col * 5 + random.range(-1, 1), 0, at.Z + row * 6)
				Kit.part(
					model,
					"Headstone",
					Vector3.new(2.4, 3 + random.next() * 1.5, 0.6),
					CFrame.new(p + Vector3.new(0, 1.6, 0))
						* CFrame.Angles(random.range(-0.15, 0.15), 0, random.range(-0.12, 0.12)),
					M.Rock,
					C.Slate,
					false
				)
			end
		end
	end
	Props.fenceLoop(model, Vector3.new(at.X, 0, at.Z), 40, 34)
	model.Parent = parent
end

local function spawnGround(parent: Instance, spawn: any, lane: any)
	local color = Kit.rgb(lane.Color)
	local pad = Kit.part(
		parent,
		"EnemySpawn_" .. spawn.Name,
		Vector3.new(30, 0.4, 18),
		CFrame.new(spawn.X, 0.2, spawn.Z),
		Enum.Material.Mud,
		C.Mud,
		false
	)
	pad:SetAttribute("Lane", spawn.Lane)
	-- Broken arch on the spawn edge marks the lane entrance, lit in the lane colour.
	for _, side in { -1, 1 } do
		Kit.part(
			parent,
			"SpawnArchPier",
			Vector3.new(4, 16, 4),
			CFrame.new(spawn.X + side * 16, 8, spawn.Z + 12),
			M.Wall,
			C.SlateWet
		)
	end
	local lintel = Kit.part(
		parent,
		"SpawnArch",
		Vector3.new(36, 3, 4),
		CFrame.new(spawn.X, 17, spawn.Z + 12)
			* CFrame.Angles(0, 0, if spawn.Lane == 2 then 0 else 0.06 * (spawn.Lane - 2)),
		M.Wall,
		C.Slate
	)
	local glow = Kit.detail(
		parent,
		"SpawnGlow",
		Vector3.new(2, 2, 2),
		CFrame.new(spawn.X, 15, spawn.Z + 10),
		Enum.Material.Neon,
		color
	)
	Kit.light(glow, color, 40, 2.5)
	Kit.label(lintel, string.upper(lane.Name) .. " ROAD", color, 80)
end

function Village.build(parent: Instance, layout: any, random: any)
	local root = Kit.folder(parent, "Village")
	for _, spec in layout.Village.Houses do
		house(root, spec)
	end
	chapel(root, layout.Village.Chapel)
	graveyard(root, layout.Village.Graveyard, random)
	Props.well(root, Kit.v(layout.Village.Well))
	Props.gallows(root, Kit.v(layout.Village.Gallows))
	for _, p in layout.Village.Carts do
		Props.cart(root, Kit.v(p), random.range(0, math.pi * 2))
	end
	for _, spawn in layout.Spawns do
		spawnGround(root, spawn, layout.Lanes[spawn.Lane])
	end
	return root
end

return Village
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="352">
            <Properties>
              <string name="Name">Walls</string>
              <string name="Source"><![CDATA[--!strict
-- The three defensive lines. Each has a breachable gate per lane: a Humanoid
-- proxy the enemies attack (all gates of one level share that level's integrity,
-- see DefendTheWallsService) and a solid leaf that blocks everyone until the wall
-- is breached. Defenders reach the front by the walkway ramps and dropping over;
-- a "Climb back over" postern prompt on each wall's face brings players back.
-- Walkways, ramps, guard posts and the per-level repair console are created here too.
local Players = game:GetService("Players")
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local Walls = {}
local C, M = Kit.Color, Kit.Material

export type Level = {
	Level: number,
	Gates: { [number]: Model },
	Leaves: { BasePart },
	Console: BasePart,
	SpearPosts: { CFrame },
	BowPosts: { CFrame },
	Fallback: Vector3,
	Rally: Vector3,
}

-- Players-only way back over a closed wall (enemies never get prompts).
local function postern(parent: Instance, wall: any, x: number)
	local front = wall.Z - wall.Thickness / 2
	local ladder = Kit.part(
		parent,
		"PosternLadder",
		Vector3.new(3, wall.Height - 1, 0.6),
		CFrame.new(x, (wall.Height - 1) / 2, front - 0.4),
		M.Timber,
		C.OakPale,
		false
	)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText = "Climb back over", "Wall " .. wall.Level
	prompt.HoldDuration, prompt.MaxActivationDistance, prompt.RequiresLineOfSight = 0.6, 8, false
	prompt.Parent = ladder
	local landing = CFrame.new(x, 4, wall.Z + wall.Thickness / 2 + 10)
	prompt.Triggered:Connect(function(player)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if character and humanoid and humanoid.Health > 0 and Players:GetPlayerFromCharacter(character) == player then
			character:PivotTo(landing)
		end
	end)
end

local function gateModel(parent: Instance, wall: any, gate: any, laneName: string, height: number): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = string.format("Wall%dGate_%s", wall.Level, laneName)
	local front = wall.Z - wall.Thickness / 2
	local root = Kit.part(
		model,
		"HumanoidRootPart",
		Vector3.new(wall.GateWidth - 4, 10, 2),
		CFrame.new(gate.X, 5, front - 2.5),
		M.Wood,
		C.Oak,
		false
	)
	root.Transparency, root.CanQuery = 1, true
	local leaf = Kit.part(
		model,
		"GateLeaf",
		Vector3.new(wall.GateWidth, height, 2),
		CFrame.new(gate.X, height / 2, front + 0.5),
		if wall.Level == 1 then M.Timber else M.Wood,
		C.Oak
	)
	-- Iron banding on stone gates; sharpened tops on the palisade gate.
	if wall.Level == 1 then
		for x = -wall.GateWidth / 2 + 1, wall.GateWidth / 2 - 1, 2 do
			Kit.detail(
				model,
				"GateStake",
				Vector3.new(1.2, 2, 1.2),
				CFrame.new(gate.X + x, height + 0.6, front + 0.5) * CFrame.Angles(0, math.pi / 4, 0),
				M.Timber,
				C.Oak
			)
		end
	end
	for y = 3, height - 2, 5 do
		Kit.detail(
			model,
			"IronBand",
			Vector3.new(wall.GateWidth, 0.6, 2.3),
			CFrame.new(gate.X, y, front + 0.5),
			M.Iron,
			C.Iron
		)
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.RequiresNeck, humanoid.BreakJointsOnDeath = false, false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model
	model.PrimaryPart = root
	model:SetAttribute("MissionGateway", true)
	model:SetAttribute("WallLevel", wall.Level)
	model:SetAttribute("Lane", gate.Lane)
	model.Parent = parent
	return model, leaf
end

local function towers(parent: Instance, wall: any, xs: { number })
	for _, x in xs do
		local size = wall.Thickness + 6
		local height = wall.Height + 10
		Kit.part(parent, "Tower", Vector3.new(size, height, size), CFrame.new(x, height / 2, wall.Z), M.Wall, C.Slate)
		Kit.part(
			parent,
			"TowerTop",
			Vector3.new(size + 2, 1.5, size + 2),
			CFrame.new(x, height + 0.75, wall.Z),
			M.Rock,
			C.SlateWet
		)
		for i = 0, 3 do
			local angle = i * math.pi / 2
			Kit.detail(
				parent,
				"Merlon",
				Vector3.new(2.5, 3, 2.5),
				CFrame.new(x + math.cos(angle) * size / 2, height + 3, wall.Z + math.sin(angle) * size / 2),
				M.Wall,
				C.Slate
			)
		end
		local roof = Kit.wedge(
			parent,
			"TowerRoof",
			Vector3.new(size, 10, size / 2),
			CFrame.new(x, height + 6.5, wall.Z - size / 4),
			M.Wood,
			C.SlateWet
		)
		Kit.wedge(
			parent,
			"TowerRoof",
			Vector3.new(size, 10, size / 2),
			roof.CFrame * CFrame.new(0, 0, size / 2) * CFrame.Angles(0, math.pi, 0),
			M.Wood,
			C.SlateWet
		)
	end
end

function Walls.build(parent: Instance, layout: any): { Level }
	local root = Kit.folder(parent, "Walls")
	local levels: { Level } = {}
	for _, wall in layout.Walls do
		local folder = Kit.folder(root, string.format("Wall%d_%s", wall.Level, wall.Name))
		folder:SetAttribute("WallLevel", wall.Level)
		local gateHeight = math.min(wall.Height, 16)
		local walkwayY = wall.Height - 4
		local back = wall.Z + wall.Thickness / 2
		local front = wall.Z - wall.Thickness / 2
		-- Solid runs between gates.
		-- Runs overlap the side blockers so nothing squeezes past the wall ends.
		local edges = { -wall.HalfWidth - 6 }
		for _, gate in wall.Gates do
			table.insert(edges, gate.X - wall.GateWidth / 2)
			table.insert(edges, gate.X + wall.GateWidth / 2)
		end
		table.insert(edges, wall.HalfWidth + 6)
		local material = if wall.Level == 1 then M.Timber else M.Wall
		local color = if wall.Level == 1 then C.Oak else C.Slate
		for i = 1, #edges, 2 do
			local a, b = edges[i], edges[i + 1]
			local cx, width = (a + b) / 2, b - a
			Kit.part(
				folder,
				"WallRun",
				Vector3.new(width, wall.Height, wall.Thickness),
				CFrame.new(cx, wall.Height / 2, wall.Z),
				material,
				color
			)
			if wall.Level == 1 then
				-- Stone footing under the timber palisade, stakes along the top.
				Kit.part(
					folder,
					"Footing",
					Vector3.new(width, 4, wall.Thickness + 2),
					CFrame.new(cx, 2, wall.Z),
					M.Rock,
					C.SlateWet
				)
				for x = a + 1, b - 1, 2.2 do
					Kit.detail(
						folder,
						"PalisadeStake",
						Vector3.new(1.4, 3, 1.4),
						CFrame.new(x, wall.Height + 1.2, front + 1) * CFrame.Angles(0, math.pi / 4, 0),
						M.Timber,
						C.Oak
					)
				end
				Props.spikes(folder, Vector3.new(a + 2, 0, front - 6), Vector3.new(b - 2, 0, front - 6))
			else
				for x = a + 2, b - 2, 5 do
					Kit.detail(
						folder,
						"Merlon",
						Vector3.new(2.6, 3, 1.6),
						CFrame.new(x, wall.Height + 1.5, front + 0.8),
						M.Wall,
						C.Slate
					)
				end
			end
		end
		-- Lintels over the gates on taller walls keep the line continuous.
		for _, gate in wall.Gates do
			if wall.Height > gateHeight then
				Kit.part(
					folder,
					"GateArch",
					Vector3.new(wall.GateWidth, wall.Height - gateHeight, wall.Thickness),
					CFrame.new(gate.X, (wall.Height + gateHeight) / 2, wall.Z),
					M.Wall,
					C.SlateWet
				)
			end
		end
		-- Walkway behind the parapet, with ramps at both ends (along X so they never cut the field).
		local walkwayDepth = 6
		Kit.part(
			folder,
			"Walkway",
			Vector3.new(wall.HalfWidth * 2, 1, walkwayDepth),
			CFrame.new(0, walkwayY - 0.5, back + walkwayDepth / 2),
			M.Wood,
			C.OakPale
		)
		local rampLength = walkwayY * 2.2
		for _, side in { -1, 1 } do
			local x = side * (wall.HalfWidth - 6 - rampLength / 2)
			local ramp = Kit.wedge(
				folder,
				"Ramp",
				Vector3.new(walkwayDepth, walkwayY, rampLength),
				CFrame.new(x, walkwayY / 2, back + walkwayDepth * 1.5) * CFrame.Angles(0, side * math.pi / 2, 0),
				M.Wood,
				C.OakPale
			)
			ramp:SetAttribute("Access", "Walkway")
		end
		if wall.Level >= 2 then
			towers(folder, wall, { -wall.HalfWidth + 8, -56, 56, wall.HalfWidth - 8 })
		end
		if wall.Level == 3 then
			-- Buttresses, gargoyles and braziers on the bastion face.
			for x = -wall.HalfWidth + 20, wall.HalfWidth - 20, 26 do
				local clear = true
				for _, gate in wall.Gates do
					if math.abs(x - gate.X) < wall.GateWidth then
						clear = false
					end
				end
				if clear then
					Kit.wedge(
						folder,
						"Buttress",
						Vector3.new(4, wall.Height * 0.8, 8),
						CFrame.new(x, wall.Height * 0.4, front - 4) * CFrame.Angles(0, math.pi, 0),
						M.Wall,
						C.SlateWet
					)
					Kit.detail(
						folder,
						"Gargoyle",
						Vector3.new(2, 2.5, 4),
						CFrame.new(x, wall.Height - 2, front - 2) * CFrame.Angles(0.3, 0, 0),
						M.Rock,
						C.Slate
					)
				end
			end
		end
		-- Braziers on every walkway: the warm light pool that frames each line.
		for i, x in { -150, -70, 70, 150 } do
			Kit.brazier(folder, Vector3.new(x, walkwayY, back + 3), wall.Level == 3 and i == 2)
		end
		for _, x in { -170, -40, 40, 170 } do
			Kit.banner(folder, CFrame.new(x, wall.Height - 1, front - 0.6), 8 + wall.Level * 2)
		end
		local gates: { [number]: Model } = {}
		local leaves = {}
		local spear, bow = {}, {}
		for _, gate in wall.Gates do
			local lane = layout.Lanes[gate.Lane]
			local model, leaf = gateModel(folder, wall, gate, lane.Name, gateHeight)
			gates[gate.Lane] = model
			table.insert(leaves, leaf)
			-- Lane-coloured lamp over each gate ties the corridor to its gate.
			local lamp = Kit.detail(
				folder,
				"GateLamp",
				Vector3.new(1.2, 1.2, 1.2),
				CFrame.new(gate.X, gateHeight + 1.5, front - 1.5),
				Enum.Material.Neon,
				Kit.rgb(lane.Color)
			)
			Kit.light(lamp, Kit.rgb(lane.Color), 26, 1.8)
			for _, dx in { -5, 5 } do
				table.insert(spear, CFrame.new(gate.X + dx, 3, front - 9) * CFrame.Angles(0, math.pi, 0))
			end
			for _, dx in { -16, 16 } do
				table.insert(bow, CFrame.new(gate.X + dx, walkwayY + 3, back + 2) * CFrame.Angles(0, math.pi, 0))
			end
		end
		for _, x in { -84, 84 } do
			postern(folder, wall, x)
		end
		local console = Kit.part(
			folder,
			"RepairConsole",
			Vector3.new(4, 5, 3),
			CFrame.new(10, 2.5, back + walkwayDepth + 6),
			M.Iron,
			C.Iron
		)
		local rune = Kit.detail(
			folder,
			"ConsoleRune",
			Vector3.new(2.5, 0.3, 2),
			CFrame.new(10, 5.2, back + walkwayDepth + 6),
			Enum.Material.Neon,
			C.Bone
		)
		Kit.light(rune, C.Bone, 10, 1)
		levels[wall.Level] = {
			Level = wall.Level,
			Gates = gates,
			Leaves = leaves,
			Console = console,
			SpearPosts = spear,
			BowPosts = bow,
			Fallback = Kit.v(wall.Fallback, 5),
			Rally = Kit.v(wall.Rally, 3),
		}
	end
	return levels
end

-- Opens (true) or closes a level's gates: breached leaves drop and stop blocking.
function Walls.setBreached(level: Level, breached: boolean)
	for _, leaf in level.Leaves do
		leaf.CanCollide = not breached
		leaf.Transparency = if breached then 1 else 0
		for _, sibling in (leaf.Parent :: Instance):GetChildren() do
			if sibling:IsA("BasePart") and sibling.Name ~= "HumanoidRootPart" and sibling ~= leaf then
				sibling.Transparency = if breached then 1 else 0
			end
		end
	end
end

return Walls
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="353">
          <Properties>
            <string name="Name">DefendTheWallsService</string>
            <string name="Source"><![CDATA[--!strict
-- Defend the Walls: hold three walls and the final doors through a timed, phased
-- assault. Round flow, participants, rewards and analytics come from ModeRunner;
-- the map comes from DefendTheWallsMap and the NPC guards from DefendTheWallsGuards.
-- This file owns wall progression (each wall's shared integrity, breaches, fallback
-- spawn), the doors (the only loss condition) and repairs, the phase table and spawning.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Configuration.DefendTheWalls)
local Runtime = require(script.Parent.EnemyRuntime)
local Damage = require(script.Parent.DamageService)
local ModeRunner = require(script.Parent.ModeRunner)
local Map = require(script.Parent.DefendTheWallsMap)
local Guards = require(script.Parent.DefendTheWallsGuards)
local Mission = {}

local runner: ModeRunner.Runner
local entries: { any } = {}
local built: Map.Built
local gateway: Model -- the final doors
local gateHealth: Humanoid
local repairPrompts: { ProximityPrompt } = {} -- [1..3] walls, [4] doors
local folder: Folder
local enemies: Folder
local squad: Guards.Squad
local phase = 1
local nextSpawn = 0
local repairs = Config.RepairCharges
local spawned = 0
local budgetRemaining = 0
local defeated = 0
local stuckRemoved = 0
local eliteSpawned = false
-- Wall progression: 1-3 are the walls, Config.Walls.Count + 1 means only the doors remain.
local wallLevel = 1
local wallHP = 0
local gateOwner: { [Humanoid]: number } = {} -- gate proxy Humanoid -> wall level
local DOORS = Config.Walls.Count + 1

local function prompt(parent: BasePart, action: string, object: string): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText, p.ObjectText = action, object
	p.HoldDuration, p.MaxActivationDistance = 2, Config.RepairDistance
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

local function build(runner: ModeRunner.Runner): Folder
	built = Map.build()
	folder = built.Folder
	gateway = built.Doors
	gateHealth = gateway:FindFirstChildOfClass("Humanoid") :: Humanoid
	for level, handles in built.Levels do
		repairPrompts[level] = prompt(handles.Console, "Repair wall " .. level, "Defense console")
	end
	repairPrompts[DOORS] = prompt(built.DoorConsole, "Repair gateway", "Gate console")
	enemies = Instance.new("Folder")
	enemies.Name, enemies.Parent = "MissionEnemies", folder
	squad = Guards.new(folder, built.Levels, function()
		local models = {}
		for _, entry in entries do
			if entry.Handle.IsAlive() and entry.Handle.Model.Parent then
				table.insert(models, entry.Handle.Model)
			end
		end
		return models
	end)
	local hubSpawn = Instance.new("SpawnLocation")
	hubSpawn.Name, hubSpawn.Size, hubSpawn.Position =
		"MissionHubSpawn", Vector3.new(8, 1, 8), Config.Hub - Vector3.new(0, 5, 0)
	hubSpawn.Anchored, hubSpawn.Neutral, hubSpawn.Duration = true, true, 0
	hubSpawn.Parent = folder
	local sandboxGate = Instance.new("Part")
	sandboxGate.Name, sandboxGate.Size, sandboxGate.Anchored = "SandboxAccess", Vector3.new(5, 7, 3), true
	sandboxGate.Position = Config.Hub + Vector3.new(-24, -2.5, 4)
	sandboxGate.Material, sandboxGate.Color = Enum.Material.Slate, Color3.fromRGB(148, 115, 74)
	sandboxGate.Parent = folder
	local sandboxPrompt = Instance.new("ProximityPrompt")
	sandboxPrompt.ActionText, sandboxPrompt.ObjectText = "Enter combat sandbox", "Practice gate"
	sandboxPrompt.MaxActivationDistance, sandboxPrompt.HoldDuration = 10, 0.5
	sandboxPrompt.Parent = sandboxGate
	sandboxPrompt.Triggered:Connect(function(player)
		if runner.Participants[player] then
			return
		end
		player:SetAttribute("MissionSandbox", true)
		player:LoadCharacter()
	end)
	return folder
end

local function freshHumanoid(model: Model, maximum: number): Humanoid
	local old = model:FindFirstChildOfClass("Humanoid")
	if old then
		gateOwner[old] = nil
		old:Destroy()
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "Humanoid"
	humanoid.MaxHealth, humanoid.Health = maximum, maximum
	humanoid.RequiresNeck, humanoid.BreakJointsOnDeath = false, false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model
	return humanoid
end

-- Rebuilds every gate proxy and the doors at full integrity, gates closed.
local function resetDefenses()
	for level, handles in built.Levels do
		Map.Walls.setBreached(handles, false)
		for _, gate in handles.Gates do
			gateOwner[freshHumanoid(gate, Config.Walls.Integrity[level])] = level
			gate:SetAttribute("MissionId", nil)
			CollectionService:RemoveTag(gate, "CityHuman")
		end
	end
	gateHealth = freshHumanoid(gateway, Config.GatewayIntegrity)
end

local function syncWall()
	local handles = built.Levels[wallLevel]
	if not handles then
		return
	end
	for _, gate in handles.Gates do
		local humanoid = gate:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			humanoid.Health = math.max(0, wallHP)
		end
	end
end

-- Current objective for an enemy that chose `lane`: its gate on the active wall, else the doors.
local function objectiveFor(lane: number): Model
	local handles = built.Levels[wallLevel]
	return if handles then handles.Gates[lane] or gateway else gateway
end

local function setWall(level: number)
	wallLevel = level
	local handles = built.Levels[level]
	for index, p in repairPrompts do
		p.Enabled = index == level
	end
	if handles then
		wallHP = Config.Walls.Integrity[level]
		for _, gate in handles.Gates do
			gate:SetAttribute("MissionId", runner.RoundId)
			-- Enemy swings only land on players and CityHuman-tagged targets.
			CollectionService:AddTag(gate, "CityHuman")
		end
	else
		wallHP = 0
	end
	folder:SetAttribute("WallLevel", level)
	folder:SetAttribute("DefenderSpawn", if handles then handles.Fallback else Config.Hub)
	for _, entry in entries do
		entry.Order.Value = objectiveFor(entry.Lane)
	end
end

local function breachWall()
	local fallen = built.Levels[wallLevel]
	if not fallen then
		return
	end
	Map.Walls.setBreached(fallen, true)
	for _, gate in fallen.Gates do
		gate:SetAttribute("MissionId", nil)
		CollectionService:RemoveTag(gate, "CityHuman")
		local humanoid = gate:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Health = 0 -- enemies drop it as a target and take the new objective
		end
	end
	runner.metric("WallsBreached")
	local from = wallLevel
	setWall(wallLevel + 1)
	squad.retreat(from, wallLevel)
	runner.snapshot(nil)
end

local function activeCount(): number
	local n = 0
	for _, entry in entries do
		if entry.Handle.IsAlive() and entry.Handle.Model.Parent then
			n += 1
		end
	end
	return n
end

local function cleanupEnemies()
	for _, entry in entries do
		entry.Connection:Disconnect()
		entry.Handle.Destroy()
	end
	table.clear(entries)
end

local function spawnEnemy(kind: string)
	local definition = Config.Phases[phase]
	local lane = definition.Lanes[math.random(1, #definition.Lanes)]
	local position = built.Spawns[lane] + Vector3.new(math.random(-8, 8), 0, math.random(-4, 4))
	-- Some enemies branch at the crossroads and hit another lane's gate.
	local goal = lane
	if math.random() < Config.Map.BranchChance then
		goal = (lane + math.random(0, 1)) % Config.Walls.Count + 1
	end
	local handle = Runtime.create(position, enemies, kind)
	local model = handle.Model
	model:SetAttribute("MissionId", runner.RoundId)
	model:SetAttribute("MissionRole", kind)
	model:SetAttribute("SandboxLabel", kind .. " Enfleshed")
	local order = Instance.new("ObjectValue")
	order.Name, order.Value, order.Parent = "ObjectiveTarget", objectiveFor(goal), model
	model:SetAttribute("MissionLane", goal)
	local health = model:FindFirstChildOfClass("Humanoid")
	if health then
		local hp = if kind == "Swift" then 115 elseif kind == "Brute" then 260 elseif kind == "Elite" then 440 else 160
		health.MaxHealth, health.Health = hp, hp
		health.WalkSpeed = if kind == "Swift" then 22 elseif kind == "Brute" or kind == "Elite" then 13 else 18
	end
	if kind == "Brute" or kind == "Elite" then
		model:ScaleTo(if kind == "Elite" then 1.5 else 1.25)
		local highlight = Instance.new("Highlight")
		highlight.FillColor = if kind == "Elite" then Color3.fromRGB(212, 62, 57) else Color3.fromRGB(135, 100, 62)
		highlight.FillTransparency = 0.7
		highlight.Parent = model
	end
	local connection = (health :: Humanoid).Died:Connect(function()
		if runner.State == "ACTIVE" and model:GetAttribute("MissionId") == runner.RoundId then
			defeated += 1
			runner.metric("EnemiesDefeated")
		end
	end)
	table.insert(entries, {
		Handle = handle,
		Connection = connection,
		Order = order,
		Lane = goal,
		Last = position,
		ProgressAt = os.clock(),
		Born = os.clock(),
	})
	spawned += 1
	budgetRemaining -= 1
end

local function updateEnemies(now: number)
	local elapsed = (now - runner.StartAt) * Config.Duration / runner.Duration
	for index = #Config.Phases, 1, -1 do
		if elapsed >= Config.Phases[index].At then
			if index ~= phase then
				phase = index
				budgetRemaining = Config.Phases[index].Budget
				runner.snapshot(nil)
			end
			break
		end
	end
	for index = #entries, 1, -1 do
		local entry = entries[index]
		local model = entry.Handle.Model
		if not model.Parent or not entry.Handle.IsAlive() then
			entry.Connection:Disconnect()
			if model.Parent then
				entry.Handle.Destroy()
			end
			table.remove(entries, index)
		else
			local root = model:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				if (root.Position - entry.Last).Magnitude > 5 then
					entry.Last, entry.ProgressAt = root.Position, os.clock()
				end
				local objective = entry.Order.Value
				local goal = if objective and objective:IsA("Model")
					then objective:GetPivot().Position
					else Config.Gateway
				if os.clock() - entry.ProgressAt > Config.StuckTimeout and (root.Position - goal).Magnitude > 13 then
					entry.Connection:Disconnect()
					entry.Handle.Destroy()
					table.remove(entries, index)
					stuckRemoved += 1
				end
			end
		end
	end
	local party = math.max(1, runner.countParticipants())
	local definition = Config.Phases[phase]
	local cap = definition.Cap + (party - 1) * 4
	if phase >= 4 and not eliteSpawned and budgetRemaining > 0 and activeCount() < cap then
		eliteSpawned = true
		spawnEnemy("Elite")
	end
	if now >= nextSpawn and budgetRemaining > 0 and activeCount() < cap then
		local kind = "Basic"
		local roll = math.random()
		if phase >= 3 and roll < 0.15 then
			kind = "Brute"
		elseif phase >= 2 and roll < 0.4 then
			kind = "Swift"
		end
		spawnEnemy(kind)
		nextSpawn = now
			+ (
				if activeCount() < definition.Target + (party - 1) * 3
					then 2
					else definition.Interval / (1 + (party - 1) * 0.2)
			)
	end
end

local function rewardFor(_runner: ModeRunner.Runner, data: ModeRunner.Participant, victory: boolean): ModeRunner.Reward
	local participation =
		math.clamp((workspace:GetServerTimeNow() - data.Joined) / math.max(1, runner.Duration * 0.5), 0, 1)
	local bonus = math.clamp(math.floor(data.Damage / 500) + data.Repairs * 3 + data.Kills, 0, 10)
	local baseXP = if victory then Config.Rewards.VictoryXP else Config.Rewards.DefeatXP
	local baseMarks = if victory then Config.Rewards.VictoryMarks else Config.Rewards.DefeatMarks
	return {
		XP = math.floor((baseXP + bonus * 2) * participation),
		Marks = math.floor((baseMarks + bonus) * participation),
		Kills = data.Kills,
		Repairs = data.Repairs,
		Score = math.floor(data.Damage + data.Kills * 25 + data.Repairs * 100),
		Victory = victory,
		Deaths = data.Deaths,
	}
end

local function definition(remote: RemoteEvent): ModeRunner.ModeDefinition
	return {
		Id = "DefendTheWalls",
		Tier = 1,
		Remote = remote,
		Preparation = Config.Preparation,
		Results = Config.Results,
		MaxParticipants = Config.MaxParticipants,
		ParticipantAttribute = "MissionDefender",
		UnavailableText = "Defend the Walls is temporarily unavailable",
		build = build,
		duration = function()
			return if RunService:IsStudio() and Config.Studio.Accelerated
				then Config.Studio.Duration
				else Config.Duration
		end,
		timeoutOutcome = true, -- the gate held until the timer ran out
		prepare = function(current)
			resetDefenses()
			gateway:SetAttribute("MissionId", current.RoundId)
			setWall(1)
			squad.spawn(current.RoundId)
			phase, repairs, spawned, defeated, stuckRemoved = 1, Config.RepairCharges, 0, 0, 0
			budgetRemaining = Config.Phases[1].Budget
			eliteSpawned = false
		end,
		activate = function()
			nextSpawn = 0
		end,
		outcome = function()
			return if gateHealth.Health <= 0 then false else nil
		end,
		tick = function(_, now)
			updateEnemies(now)
		end,
		cleanup = function()
			cleanupEnemies()
			squad.clear()
			resetDefenses()
			setWall(1)
			repairs = Config.RepairCharges
		end,
		reward = rewardFor,
		newParticipant = function()
			return { Repairs = 0 }
		end,
		snapshot = function(_, message)
			message.Phase = phase
			message.PhaseName = Config.Phases[phase].Name
			message.Gateway = gateHealth.Health
			message.GatewayMax = gateHealth.MaxHealth
			message.WallLevel = wallLevel
			message.WallCount = Config.Walls.Count
			message.WallHP = math.max(0, wallHP)
			message.WallMax = if built.Levels[wallLevel] then Config.Walls.Integrity[wallLevel] else 0
			message.GuardsAlive = squad.alive()
			message.GuardsTotal = squad.total()
			message.Repairs = repairs
			message.Enemies = activeCount()
			message.Spawned = spawned
			message.Defeated = defeated
			message.StuckRemoved = stuckRemoved
			message.SpawnBudget = budgetRemaining
		end,
		progressLabel = function()
			return phase
		end,
	}
end

function Mission.start()
	local remotes = Shared:WaitForChild("SandboxRemotes")
	runner = ModeRunner.new(definition(remotes:WaitForChild("MissionRemote") :: RemoteEvent))
	runner.start()
	local function repair(player: Player, index: number)
		local data = runner.Participants[player]
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local health = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local console = repairPrompts[index].Parent :: BasePart
		if
			runner.State ~= "ACTIVE"
			or index ~= wallLevel -- only the active wall (or the doors) can be repaired
			or not data
			or repairs <= 0
			or not root
			or not root:IsA("BasePart")
			or not health
			or health.Health <= 0
			or (root.Position - console.Position).Magnitude > Config.RepairDistance + 2
		then
			return
		end
		if index == DOORS then
			if gateHealth.Health >= gateHealth.MaxHealth then
				return
			end
			gateHealth.Health = math.min(gateHealth.MaxHealth, gateHealth.Health + Config.RepairAmount)
		else
			local maximum = Config.Walls.Integrity[index]
			if wallHP >= maximum then
				return
			end
			wallHP = math.min(maximum, wallHP + Config.RepairAmount)
			syncWall()
		end
		repairs -= 1
		runner.metric("RepairsUsed")
		data.Repairs += 1
		runner.snapshot(nil)
	end
	for index, p in repairPrompts do
		p.Triggered:Connect(function(player)
			repair(player, index)
		end)
	end
	Damage.Applied:Connect(function(_attacker: Model, target: Humanoid, amount: number, killed: boolean)
		if runner.State ~= "ACTIVE" then
			return
		end
		if target == gateHealth then
			runner.snapshot(nil)
			if killed then
				runner.finish(false) -- only the final doors lose the mission
			end
		elseif gateOwner[target] == wallLevel then
			wallHP -= amount
			syncWall()
			if wallHP <= 0 then
				breachWall()
			else
				runner.snapshot(nil)
			end
		end
	end)
	-- The practice sandbox is reached from this mode's hub.
	local function resetSandbox(player: Player)
		player:SetAttribute("MissionSandbox", false)
	end
	Players.PlayerAdded:Connect(resetSandbox)
	for _, player in Players:GetPlayers() do
		resetSandbox(player)
	end
end

function Mission.debugFinish(victory: boolean)
	if not RunService:IsStudio() or not Config.Studio.Accelerated or not Config.Studio.MockProgression then
		return
	end
	runner.finish(victory)
end

function Mission.debugDamage(amount: number)
	if not RunService:IsStudio() or not Config.Studio.Accelerated or not Config.Studio.MockProgression then
		return
	end
	if runner.State == "ACTIVE" and type(amount) == "number" and amount == amount then
		gateHealth.Health = math.max(0, gateHealth.Health - math.clamp(amount, 0, Config.GatewayIntegrity))
		if gateHealth.Health <= 0 then
			runner.finish(false)
		else
			runner.snapshot(nil)
		end
	end
end

-- Studio-only load test: spawns `count` enemies across all three lanes right now,
-- ignoring phase caps, so the perf script can measure a full three-lane wave.
function Mission.debugWave(count: number)
	if not RunService:IsStudio() or runner.State ~= "ACTIVE" or type(count) ~= "number" then
		return
	end
	local saved = phase
	phase = #Config.Phases -- every lane open
	for i = 1, math.clamp(math.floor(count), 0, 60) do
		spawnEnemy(if i % 9 == 0 then "Brute" elseif i % 3 == 0 then "Swift" else "Basic")
	end
	phase = saved
	runner.snapshot(nil)
end

-- Breaks the active wall at once, to test fallbacks and guard retreats.
function Mission.debugBreach()
	if not RunService:IsStudio() or not Config.Studio.Accelerated or not Config.Studio.MockProgression then
		return
	end
	if runner.State == "ACTIVE" and built.Levels[wallLevel] then
		wallHP = 0
		breachWall()
	end
end

return Mission
]]></string>
