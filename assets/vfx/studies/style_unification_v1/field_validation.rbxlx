				RequireAsset = 1,
			},
			Drivers = { { "Stretch", "Speed", 0.9 }, { "Wobble", "Potency", 0.12 }, { "Spin", "Potency", 2 } },
			Forms = { Projectile = true },
		}),
		layer({
			Id = "Fire.Shell.Tongues",
			Roles = { Projectile = true, Aura = true, SelfEnhancement = true },
			Slot = "Shell",
			Kind = "Emitter",
			Priority = 1,
			Texture = "flame_tongue",
			Colors = { "Hot", "Body", "Deep" },
			Params = {
				Rate = 16,
				Lifetime = 0.34,
				Speed = 2.5,
				Spread = 22,
				Direction = "Back",
				Size = 1.25,
				SizeEnd = 0.35,
				Framerate = 30,
				Light = 0.65,
				RotSpeed = 40,
			},
			Drivers = {
