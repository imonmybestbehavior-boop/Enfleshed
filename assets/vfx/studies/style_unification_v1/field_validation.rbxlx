          <Item class="ModuleScript" referent="311">
            <Properties>
              <string name="Name">SpellVisualAssetLibrary</string>
              <string name="Source"><![CDATA[-- Data-only visual asset grammar. Small composable layers, never finished per-spell assets.
-- A layer: Kind (Nodes|Emitter|Trail|Fire|Light), Arrangement, Priority (1 boundary/silhouette,
-- 2 element body, 3 mechanic accent, 4 detail), Params defaults, Limits {min, max}, and
-- Drivers { Param, Feature, Weight, Shape? }: value = default + sum(weight * shape(feature)).
-- "Form" as an Arrangement means "follow the form's own volume arrangement".
local Library = {}

-- Count features (Pierces, Bounces, ...) are divided by this before driving a parameter.
Library.CountScale = 8

Library.Budget = {
	PerSpell = {
		MaxLayers = 12,
		MaxAccents = 4,
		MaxParts = 40,
		-- Parts held back from element bodies so mechanic accents (forks, satellites...) stay visible.
		AccentReserve = 12,
		MaxLinks = 28,
		MaxTrails = 3,
		MaxEmitters = 4,
		MaxEmitterRate = 24,
		MaxSpellRate = 48,
		MaxFire = 8,
		MaxLights = 1,
	},
	Global = {
		MaxSessions = 32,
		MaxEmitters = 32,
		MaxContinuousRate = 160,
		MaxFire = 96,
		MaxLights = 32,
	},
	-- Distance (studs) -> highest Priority still drawn. Priority 1 survives every visible tier.
	DistanceTiers = { { 70, 4 }, { 120, 3 }, { 180, 2 } },
	HiddenDistance = 180,
	Quality = {
		High = { Count = 1, Rate = 1, MaxPriority = 4, MaxEmitters = 4, MaxFire = 8 },
		Medium = { Count = 0.7, Rate = 0.6, MaxPriority = 4, MaxEmitters = 2, MaxFire = 4 },
		Low = { Count = 0.5, Rate = 0.35, MaxPriority = 3, MaxEmitters = 1, MaxFire = 2 },
	},
}

-- Volume arrangement used when an element/mechanic layer follows its form.
Library.FormArrangement = {
	Projectile = "Comet",
	Beam = "Helix",
	Wave = "Crest",
	Field = "Ground", -- fields are grounded: element bodies stand upright inside the footprint
	Aura = "Orbit",
	Construct = "Lattice",
	SelfEnhancement = "Mantle",
	Manipulation = "Lattice",
}

local function range(min, max)
	return { min, max }
end

-- 1. Form assets: how the spell exists in space. Boundaries stay authoritative.
Library.Forms = {
	Projectile = {
		{
			Id = "Projectile.Core",
			Kind = "Nodes",
			Arrangement = "Core",
			Motif = "Sphere",
			Priority = 1,
			Params = { Count = 1, Scale = 0.36, Stretch = 0, Brightness = 0.6, PulseAmplitude = 0.05 },
			Limits = { Scale = range(0.3, 0.6), Stretch = range(0, 0.9), Brightness = range(0.4, 1) },
			Drivers = {
				{ "Scale", "Direct", 0.18, "Soft" },
				{ "Scale", "Size", 0.06 },
				{ "Stretch", "Speed", 0.9, "Late" },
				{ "Brightness", "Direct", 0.4 },
			},
		},
		{
			Id = "Projectile.Shell",
			Kind = "Nodes",
			Arrangement = "Comet",
			Priority = 2,
			Params = { Count = 5, Scale = 0.55, Spread = 0.5, RotationSpeed = 1, Links = 1, LinkWidth = 0.5 },
			Limits = { Count = range(4, 10), Spread = range(0.4, 0.75), RotationSpeed = range(0.6, 5) },
			Drivers = {
				{ "Count", "Payloads", 4 },
				{ "Spread", "Size", 0.2 },
				{ "RotationSpeed", "Speed", 4 },
			},
		},
		{
			Id = "Projectile.Trail",
			Kind = "Trail",
			Priority = 2,
			Params = { Count = 2, Lifetime = 0.25, Width = 0.35, Opacity = 0.85 },
			Limits = { Count = range(1, 2), Lifetime = range(0.2, 1.6), Width = range(0.25, 1) },
			Drivers = {
				{ "Lifetime", "Speed", 0.55 },
				{ "Lifetime", "DotDuration", 0.45 },
				{ "Lifetime", "Linger", 0.3 },
				{ "Width", "Size", 0.6 },
			},
		},
	},
	Beam = {
		{
			Id = "Beam.Core",
			Kind = "Nodes",
			Arrangement = "BeamCore",
			Motif = "BeamCore",
			Priority = 1,
			Params = { Count = 1, Scale = 0.22, Brightness = 0.7, PulseAmplitude = 0.05 },
			Limits = { Scale = range(0.18, 0.6), Brightness = range(0.5, 1) },
			Drivers = { { "Scale", "Direct", 0.3, "Soft" }, { "Brightness", "Direct", 0.3 } },
		},
		{
			Id = "Beam.Aura",
			Kind = "Nodes",
			Arrangement = "BeamAura",
			Motif = "BeamAura",
			Priority = 1,
			Params = { Count = 1, Scale = 0.65, Opacity = 0.28 },
			Limits = { Scale = range(0.65, 0.65), Opacity = range(0.2, 0.45) },
			Drivers = { { "Opacity", "DotTotal", 0.17 } },
		},
		{
			Id = "Beam.Helix",
			Kind = "Nodes",
			Arrangement = "Helix",
			Priority = 2,
			Params = { Count = 10, Spread = 0.35, RotationSpeed = 1.5, Links = 1, LinkWidth = 0.65 },
			Limits = { Count = range(8, 20), Spread = range(0.3, 0.5), RotationSpeed = range(1, 6) },
			Drivers = { { "Count", "Range", 10 }, { "RotationSpeed", "Repeat", 4 }, { "Spread", "Width", 0.15 } },
		},
	},
	Wave = {
		{
			Id = "Wave.Front",
			Kind = "Nodes",
			Arrangement = "Crest",
			Priority = 1,
			Params = { Count = 12, Scale = 0.5, Links = 1, LinkWidth = 0.65 },
			Limits = { Count = range(12, 20), Scale = range(0.45, 1) },
			Drivers = { { "Count", "Radius", 8 }, { "Scale", "Direct", 0.5 } },
		},
	},
	Field = {
		{
			Id = "Field.Boundary",
			Kind = "Nodes",
			Arrangement = "Boundary",
			Priority = 1,
			Params = { Count = 8, Scale = 0.5, Links = 1, LinkWidth = 0.65 },
			Limits = { Count = range(8, 8) },
			Drivers = {},
		},
		{
			Id = "Field.Volume",
			Kind = "Nodes",
			Arrangement = "Carpet",
			Motif = "Disc",
			Priority = 2,
			Params = {
				Count = 4,
				Scale = 1,
				Height = 0.35,
				Opacity = 0.22,
				PulseAmplitude = 0.04,
				PulseFrequency = 0.4,
			},
			Limits = { Count = range(3, 5), Height = range(0.3, 0.95), Opacity = range(0.16, 0.36) },
			Drivers = {
				{ "Count", "DotTotal", 3 },
				{ "Count", "Heal", 2 },
				{ "Count", "Duration", 1 },
				{ "Height", "Lifetime", 0.5 },
				{ "Opacity", "DotTotal", 0.1 },
				{ "Opacity", "Duration", 0.04 },
			},
		},
	},
	Aura = {
		{
			Id = "Aura.Boundary",
			Kind = "Nodes",
			Arrangement = "Boundary",
			Priority = 1,
			Params = { Count = 8, Scale = 0.5, Links = 1, LinkWidth = 0.65 },
			Limits = { Count = range(8, 8) },
			Drivers = {},
		},
		{
			Id = "Aura.Orbit",
			Kind = "Nodes",
			Arrangement = "Orbit",
			Priority = 2,
			Params = { Count = 8, Scale = 0.55, RotationSpeed = 0.6, Height = 0.6 },
			Limits = { Count = range(8, 16), RotationSpeed = range(0.4, 2.5) },
			Drivers = { { "Count", "Duration", 6 }, { "RotationSpeed", "Repeat", 1.5 } },
		},
	},
	Construct = {
		{
			Id = "Construct.Lattice",
			Kind = "Nodes",
			Arrangement = "Lattice",
			Priority = 1,
			Params = { Count = 8, Scale = 0.6, Links = 1, LinkWidth = 0.6 },
			Limits = { Count = range(8, 16) },
			Drivers = { { "Count", "Construct", 8 } },
		},
	},
	SelfEnhancement = {
		{
			Id = "SelfEnhancement.Mantle",
			Kind = "Nodes",
			Arrangement = "Mantle",
			Priority = 1,
			Params = { Count = 8, Scale = 0.5, RotationSpeed = 0.8, Height = 0.7, Links = 1, LinkWidth = 0.5 },
			Limits = { Count = range(8, 14), Height = range(0.6, 1) },
			Drivers = { { "Count", "Duration", 6 }, { "Height", "Lifetime", 0.3 } },
		},
	},
	Manipulation = {
		{
			Id = "Manipulation.Lattice",
			Kind = "Nodes",
			Arrangement = "Lattice",
			Priority = 1,
			Params = { Count = 8, Scale = 0.6, Links = 1, LinkWidth = 0.6 },
			Limits = { Count = range(8, 8) },
			Drivers = {},
		},
	},
	-- Casting cue (gather / release around the caster): a contracting ring, no hit silhouette.
	Cue = {
		{
			Id = "Cue.Ring",
			Kind = "Nodes",
			Arrangement = "Comet",
			Priority = 1,
			Params = { Count = 8, Scale = 0.55, Spread = 0.6, RotationSpeed = 2, Brightness = 0.6, Links = 1 },
			Limits = { Count = range(8, 12), Brightness = range(0.5, 1) },
			Drivers = { { "Count", "Cast", 4 }, { "Brightness", "Cast", 0.4 } },
		},
	},
}

-- 2. Element assets: elemental visual language. Motif variants are chosen by the seed.
Library.Elements = {
	Fire = {
		Motifs = { "Flame", "Wedge" },
		Speed = 2.4,
		Texture = "Fire",
		Layers = {
			{
				Id = "Fire.Flames",
				Kind = "Nodes",
				Arrangement = "Form",
				Priority = 2,
				Params = {
					Count = 3,
					Scale = 0.6,
					PulseAmplitude = 0.06,
					PulseFrequency = 1.2,
					Turbulence = 0.2,
					Elongation = 2.2,
				},
				Limits = {
					Count = range(3, 14),
					Scale = range(0.6, 1.5),
					PulseAmplitude = range(0.05, 0.55),
					PulseFrequency = range(1, 10),
					Turbulence = range(0.15, 0.7),
				},
				Drivers = {
					{ "Count", "DotTotal", 6 },
					{ "Count", "Direct", 1 },
					{ "Count", "Radius", 8 },
					{ "Scale", "DotTotal", 0.9, "Ease" },
					{ "PulseAmplitude", "DotTick", 0.45 },
					{ "PulseFrequency", "DotRate", 8.5 },
					{ "Turbulence", "DotRate", 0.5 },
				},
			},
			{
				Id = "Fire.HotCore",
				Kind = "Nodes",
				Arrangement = "Core",
				Motif = "Sphere",
				Priority = 2,
				Forms = { Projectile = true },
				Params = { Count = 1, Scale = 0.18, Brightness = 0.7 },
				Limits = { Scale = range(0.15, 0.4), Brightness = range(0.6, 1) },
				Drivers = { { "Scale", "Direct", 0.22, "Soft" }, { "Brightness", "Direct", 0.3 } },
			},
			{
				Id = "Fire.Native",
				Kind = "Fire",
				Priority = 2,
				Params = { Count = 1, Size = 3, Heat = 8 },
				Limits = { Count = range(1, 6), Size = range(2, 12), Heat = range(6, 25) },
				Drivers = {
					{ "Count", "DotTotal", 5, "Soft" },
					{ "Size", "DotTotal", 8, "Soft" },
					{ "Size", "DotTick", 1.5 },
					{ "Count", "Radius", 4 },
					{ "Size", "Radius", 3 },
					{ "Heat", "DotRate", 14 },
				},
			},
			{
				Id = "Fire.Embers",
				Kind = "Emitter",
				Texture = "Fire",
				Priority = 4,
				Params = { Rate = 3, Lifetime = 0.5, Speed = 1.5, Size = 0.6, Rise = 3 },
				Limits = { Rate = range(2, 20), Lifetime = range(0.4, 2.2), Size = range(0.4, 1.6) },
				Drivers = {
					{ "Rate", "DotDuration", 12 },
					{ "Rate", "DotRate", 4 },
					{ "Rate", "Radius", 6 },
					{ "Lifetime", "DotDuration", 1.6 },
					{ "Size", "DotTotal", 0.8 },
				},
			},
			{
				Id = "Fire.Smoke",
				Kind = "Emitter",
				Texture = "Smoke",
				Priority = 4,
				Requires = { "DotDuration", 0.3 },
				Params = { Rate = 1, Lifetime = 1, Speed = 0.8, Size = 1.4, Rise = 2, Opacity = 0.55 },
				Limits = { Rate = range(1, 8), Lifetime = range(1, 3) },
				Drivers = { { "Rate", "DotDuration", 7 }, { "Lifetime", "DotDuration", 2 } },
			},
			{
				Id = "Fire.Sparks",
				Kind = "Emitter",
				Texture = "Sparkle",
				Priority = 4,
				Params = { Rate = 2, Lifetime = 0.35, Speed = 4, Size = 0.3 },
				Limits = { Rate = range(2, 18), Speed = range(3, 10) },
				Drivers = {
					{ "Rate", "DotRate", 10 },
					{ "Rate", "Direct", 6 },
					{ "Rate", "Radius", 5 },
					{ "Speed", "Direct", 6 },
				},
			},
		},
	},
	Ice = {
		Motifs = { "Crystal", "Shard" },
		Speed = 0.6,
		Texture = "Smoke",
		Layers = {
			{
				Id = "Ice.Crystals",
				Kind = "Nodes",
				Arrangement = "Form",
				Priority = 2,
				Params = { Count = 4, Scale = 0.7, RotationSpeed = 0.3, Elongation = 2.4 },
				Limits = { Count = range(4, 13), Scale = range(0.6, 1.3) },
				Drivers = {
