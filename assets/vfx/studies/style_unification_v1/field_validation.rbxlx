		VFX = "None",
		Construct = {
			Width = 14,
			Height = 14,
			Depth = 4,
			Distance = 8,
			Components = {},
		},
		Payloads = { { Kind = "Shield", Amount = 9, Duration = 3 }, { Kind = "Heal", Amount = 4 } },
		Casting = { Mode = "Instant", Cooldown = 4 },
		Lifetime = { Mode = "FixedDuration", Duration = 8 },
		TargetRules = { Relationship = "Ally", MaxTargets = 6 },
	},
	{
		Name = "Blue Hour",
		Description = "A water sphere slows enemies and grants allies a brief window to reposition.",
		Form = "Wave",
		Principle = "Energy",
		Element = "Water",
		Event = "OnCast",
		Targeting = "Self",
		Geometry = "Sphere",
		Shape = "Sphere",
		Material = "Glass",
		Particle = "Smoke",
		Trail = "None",
		Impact = "Ring",
		VFX = "None",
		Wave = {
			Range = 11,
			Dot = -1,
			DebugDuration = 0.16,
		},
		Payloads = { { Kind = "Slow", Multiplier = 0.7, Duration = 2 }, { Kind = "Reveal", Duration = 2 } },
		Casting = { Mode = "Instant", Cooldown = 2 },
	},
	{
		Name = "Cairnkeeper",
		Description = "A stone sentinel construct controls a narrow approach with repeated binding pulses.",
		Form = "Construct",
		Principle = "Energy",
		Element = "Earth",
		Event = "OnProximity",
		Targeting = "WorldPoint",
		Geometry = "Pillar",
		Shape = "Cylinder",
		Material = "Slate",
		Particle = "Smoke",
		Trail = "None",
		Impact = "Pulse",
		VFX = "None",
		Construct = {
			Width = 3,
			Height = 7,
			Depth = 3,
			Distance = 9,
			GrowthStartScale = 0.25,
			GrowthEndScale = 1,
			GrowthDuration = 0.45,
			Components = {},
		},
		Payloads = { { Kind = "Bind", Duration = 0.8 }, { Kind = "Damage", Amount = 5 } },
		Casting = { Mode = "Instant", Cooldown = 3 },
		Lifetime = { Mode = "FixedDuration", Duration = 8 },
	},
	{
		Name = "Celestial Pin",
		Description = "A precision space beam pulls an aimed opponent into a follow-up punish window.",
		Form = "Beam",
		Principle = "Space",
		Element = "Neutral",
		Event = "OnCast",
		Targeting = "EntityTarget",
		Shape = "Wedge",
		Material = "ForceField",
		Particle = "Sparks",
		Trail = "None",
		Impact = "Cross",
		VFX = "None",
		Beam = { Range = 48, Width = 1.3, DebugDuration = 0.16 },
		Payloads = {
			{ Kind = "Control", Mode = "Pull", Acceleration = 32, Duration = 0.45 },
			{ Kind = "Slow", Multiplier = 0.72, Duration = 1.2 },
		},
		Casting = { Mode = "Instant", Cooldown = 2 },
		TargetRules = { MaxTargets = 1 },
	},
	{
		Name = "Foxfire Carousel",
		Description = "A spiraling fire orb scatters bouncing sparks that pressure enemies around corners.",
		Form = "Projectile",
		Principle = "Energy",
		Element = "Fire",
		Event = "OnImpact",
		Targeting = "AimDirection",
		Shape = "Sphere",
		Material = "Neon",
		Particle = "Embers",
		Trail = "Particles",
		Impact = "Burst",
		VFX = "None",
		Projectile = {
			Speed = 60,
			Radius = 0.8,
			MaxDistance = 115,
			Behaviors = {
				{ Kind = "Bounce", MaxBounces = 3, Restitution = 0.68 },
				{ Kind = "Chain", Radius = 8, MaxJumps = 2, DamageFalloff = 0.62 },
			},
		},
		Payloads = {
			{ Kind = "Damage", Amount = 14 },
			{ Kind = "DamageOverTime", Amount = 2, Duration = 1.5, Interval = 0.5 },
		},
		Casting = { Mode = "Charged", MinimumCharge = 0.25, MaximumCharge = 1, Cooldown = 1.9 },
	},
	{
		Name = "Hearthline",
		Description = "A short cone of body magic heals allies and throws hostile attackers backward.",
		Form = "Wave",
		Principle = "Body",
		Element = "Neutral",
		Event = "OnCast",
		Targeting = "Self",
		Geometry = "Cone",
		Shape = "Wedge",
		Material = "ForceField",
		Particle = "Sparks",
		Trail = "None",
		Impact = "Pulse",
		VFX = "None",
		Wave = {
			Range = 13,
			Dot = 0,
			DebugDuration = 0.16,
		},
		Payloads = { { Kind = "Heal", Amount = 10 } },
		Casting = { Mode = "Instant", Cooldown = 2.1 },
		TargetRules = { Relationship = "Ally", MaxTargets = 5 },
	},
}

local function buildPayloads(form: string, principle: string, event: string, definitions: { any })
	local result = {}
	for _, sourcePayload in ipairs(definitions) do
		local schemaPayload = assert(Schema.Payloads[sourcePayload.Kind], "Unknown showcase payload")
		local payload = Spec.copy(schemaPayload.Defaults)
		overlay(payload, sourcePayload)
		payload.Kind = sourcePayload.Kind
		assert(
			Schema.supportsPayload(payload.Kind, form, event, principle),
			"Unsupported showcase effect: " .. form .. " / " .. event .. " / " .. payload.Kind
		)
		table.insert(result, payload)
	end
	return result
end

local function buildRecipeCollection(sourceRecipes: { any }, collectionLabel: string)
	local result = {}
	for _, recipe in ipairs(sourceRecipes) do
		local built, entry = pcall(function()
			local definition =
				assert(Spec.createDraft(recipe.Form, recipe.Principle), "Unsupported " .. collectionLabel .. " form")
			definition.SpellId = string.gsub(recipe.Name, "%W", "")
			definition.Name = recipe.Name
			definition.Element = recipe.Element
			definition.Tags = { "showcase", string.lower(recipe.Element), string.lower(recipe.Form) }
			if recipe.Targeting then
				definition.Targeting = recipe.Targeting
			end
			if recipe.Targeting == "EntityTarget" then
				definition.TargetPolicy = "Aim"
			end
			if recipe.Geometry then
				definition.Geometry = recipe.Geometry
			end
			if recipe.Casting then
				overlay(definition.Casting, recipe.Casting)
			end
			if recipe.Lifetime then
				overlay(definition.Lifetime, recipe.Lifetime)
			end
			for _, section in ipairs({ "Projectile", "Beam", "Wave", "Field", "Aura", "Construct", "MaterialConfig" }) do
				local key = if section == "MaterialConfig" then "Material" else section
				if recipe[section] then
					if section == "MaterialConfig" then
						definition.Material = Spec.copy(recipe.MaterialConfig)
					else
						overlay(definition[key], recipe[section])
					end
				end
			end
			if recipe.AreaConfig then
				definition[recipe.Form] = Spec.copy(recipe.AreaConfig)
			end
			-- Curated spells wear their element's own signature colours (the untouched Origin
			-- palette), matching the F8 preview; players pick a palette on their own copies.
			local visual = VisualSpec.PaletteDefinitions.Origin
			definition.Visual.Palette = "Origin"
			definition.Visual.Color = visual.Colors[1]
			definition.Visual.SecondaryColor = visual.Colors[2]
			definition.Visual.AccentColor = visual.Colors[3]
			definition.Visual.CoreShape = recipe.Shape
			definition.Visual.MaterialAppearance = recipe.Material
			definition.Visual.ParticleStyle = recipe.Particle
			definition.Visual.TrailStyle = recipe.Trail
			definition.Visual.ImpactStyle = recipe.Impact
			definition.Visual.VFXDefinition = recipe.VFX
			definition.Visual.CastingStyle = "GroundSigil"
			if recipe.TargetRules then
				overlay(definition.TargetRules, recipe.TargetRules)
			end
			definition.Triggers[recipe.Event] = {
				{ Payloads = buildPayloads(recipe.Form, recipe.Principle, recipe.Event, recipe.Payloads) },
			}
			for event, definitions in pairs(recipe.OtherTriggers or {}) do
				definition.Triggers[event] =
					{ { Payloads = buildPayloads(recipe.Form, recipe.Principle, event, definitions) } }
			end
			local valid, reason = Spec.validate(definition)
			assert(valid, "Invalid " .. collectionLabel .. " spell: " .. tostring(reason))
			return { Definition = definition, Description = recipe.Description }
		end)
		if built then
			table.insert(result, entry)
		else
			warn(
				string.format(
					"[MagicLab] Skipping invalid %s spell %s: %s",
					collectionLabel,
					recipe.Name,
					tostring(entry)
				)
			)
		end
	end
	return result
end

function Starters.buildShowcase()
	return buildRecipeCollection(showcases, "showcase")
end

function Starters.buildCombatStarters()
	return buildRecipeCollection(combatStarters, "combat starter")
end

function Starters.buildShowcaseExpansion()
	return buildRecipeCollection(showcaseExpansion, "showcase expansion")
end

return Starters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">GrimoireSummary</string>
            <string name="Source"><![CDATA[--!strict
-- Read-only summaries; all calculations come from the existing validator/estimator.
local Summary = {}
local function human(value)
	return tostring(value):gsub("(%l)(%u)", "%1 %2")
end
local function properties(value, depth)
	if type(value) ~= "table" then
		return human(value)
	end
	if depth > 4 then
		return "nested rules"
	end
	local items, keys = {}, {}
	for key in pairs(value) do
		table.insert(keys, key)
	end
	table.sort(keys, function(a, b)
		return tostring(a) < tostring(b)
	end)
	for _, key in ipairs(keys) do
		local v = value[key]
		if v ~= nil then
			table.insert(items, human(key) .. ": " .. properties(v, depth + 1))
		end
	end
	return table.concat(items, ", ")
end
local function creatorIssue(reason)
	local issue = tostring(reason)
	local lowered = string.lower(issue)
	if
		string.find(lowered, "principle", 1, true)
		or string.find(lowered, "expression", 1, true)
		or string.find(lowered, "source", 1, true)
	then
		return "One or more selected effects or settings conflict with this combination. Remove or adjust an effect, then review again."
	end
	return issue
end
function Summary.describe(d, schema, spec)
	local ok, reason = spec.validate(d)
	local estimated, cost = pcall(spec.estimate, d)
	if not estimated then
		cost = { ManaDemand = 0, Strain = 0, Complexity = 0 }
	end
	local lines = {
		d.Name .. " · " .. (schema.Forms[d.Form] and schema.Forms[d.Form].Label or d.Form),
		"Element: " .. d.Element,
		"Activation: " .. human(d.Casting.Mode) .. " · cooldown " .. d.Casting.Cooldown .. "s",
		"Preparation: " .. (d.Casting.CastTime or 0) .. "s · recovery " .. (d.Casting.RecoveryTime or 0) .. "s",
		"Aim: "
			.. (schema.TargetingModes[d.Targeting] and schema.TargetingModes[d.Targeting].Label or human(d.Targeting)),
		"Lifetime: "
			.. human(d.Lifetime.Mode)
			.. (d.Lifetime.Duration and (" · " .. d.Lifetime.Duration .. "s") or ""),
		"Targets: "
			.. (d.TargetRules.Relationship or "Any")
			.. " · reach "
			.. d.TargetRules.Range
			.. " studs · maximum "
			.. d.TargetRules.MaxTargets,
	}
	if d.Lifetime.Duration then
		table.insert(lines, "Active for " .. tostring(d.Lifetime.Duration) .. " seconds.")
	end
	if d.TargetRules.RequiresLineOfSight then
		table.insert(lines, "Walls can block targets (line of sight required).")
	end
	if d.TargetRules.RequiresConsent then
		table.insert(lines, "Players must allow consent-gated spells to affect them.")
	end
	if d.TargetRules.IncludeCaster then
		table.insert(lines, "Includes you: damage/control effects may also affect you.")
	end
	local effects = 0
	local events = {}
	for event in pairs(d.Triggers or {}) do
		table.insert(events, event)
	end
	table.sort(events)
	for _, event in ipairs(events) do
		for _, step in ipairs(d.Triggers[event]) do
			for _, payload in ipairs(step.Payloads or {}) do
				effects = effects + 1
				local definition = schema.Payloads[payload.Kind]
				local details = {}
				for _, field in ipairs(definition and definition.Fields or {}) do
					if payload[field.Key] ~= nil then
						table.insert(details, field.Label .. " " .. human(payload[field.Key]))
					end
				end
				table.insert(
					lines,
					(schema.EventLabels[event] or human(event))
						.. ": "
						.. (definition and definition.Label or payload.Kind)
						.. (step.Behavior and (" / " .. human(step.Behavior)) or "")
						.. (#details > 0 and (" — " .. table.concat(details, "; ")) or "")
				)
			end
		end
	end
	if effects == 0 then
		table.insert(lines, "No effects yet. Choose one or more effects to decide what the spell does.")
	end
	table.insert(
		lines,
		string.format(
			"Estimated demand %g mana · strain %g · complexity %g",
			cost.ManaDemand,
			cost.Strain,
			cost.Complexity
		)
	)
	table.insert(
		lines,
		string.format(
			"While active: %g mana/s · %g strain/s",
			cost.ManaUpkeepPerSecond or 0,
			cost.StrainPerSecond or 0
		)
	)
	table.insert(
		lines,
		"More effects, larger areas, more targets and added behaviors can increase estimates. Actual costs and damage also depend on the caster, charge and target defenses."
	)
	for _, pair in ipairs({
		{ "Special costs", d.Cost.SpecialResources },
		{ "Caster requirements", d.LocusRequirements },
		{ "Environment", d.EnvironmentRequirements },
		{ "Cast conditions", d.Conditions },
		{ "End conditions", d.Lifetime.EndWhen },
	}) do
		if type(pair[2]) == "table" and next(pair[2]) then
			table.insert(lines, pair[1] .. ": " .. properties(pair[2], 0))
		end
	end
	if not estimated then
		table.insert(
			lines,
			"Cost estimate unavailable until the invalid settings are corrected; zeros above are not a free cast."
		)
	end
	table.insert(lines, ok and "Ready to save and test." or "Needs attention: " .. creatorIssue(reason))
	return table.concat(lines, "\n"), ok, reason
end
return Summary
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">InventoryModel</string>
            <string name="Source"><![CDATA[--!strict

-- Pure inventory container rules. The server applies these to its authoritative
-- copy; the client uses the same functions only to predict what a drag will do.
-- Locations are strings: "Bag:<1..BagSize>", "Equip:<Slot>", "Quick:<1..QuickSize>".
local Rules = require(script.Parent.ItemRules)

local Model = {}

Model.BagSize = 24
Model.QuickSize = 2
Model.EquipSlots = table.freeze({ "MainHand", "MagicFocus", "Head", "Body", "Legs" })

local equipSlotSet: { [string]: boolean } = {}
for _, slot in Model.EquipSlots do
	equipSlotSet[slot] = true
end

export type Inventory = {
	Bag: { [number]: Rules.Instance },
	Equip: { [string]: Rules.Instance },
	Quick: { [number]: Rules.Instance },
}

export type Location = { Area: string, Key: any }

function Model.blank(): Inventory
	return { Bag = {}, Equip = {}, Quick = {} }
end

function Model.parse(value: any): Location?
	if type(value) ~= "string" or #value > 32 then
		return nil
	end
	local area, key = string.match(value, "^(%a+):(%w+)$")
	if area == "Bag" or area == "Quick" then
		local index = tonumber(key)
		local size = if area == "Bag" then Model.BagSize else Model.QuickSize
		if index and index % 1 == 0 and index >= 1 and index <= size then
			return { Area = area, Key = index }
		end
	elseif area == "Equip" and key and equipSlotSet[key] then
		return { Area = "Equip", Key = key }
	end
	return nil
end

function Model.format(location: Location): string
	return location.Area .. ":" .. tostring(location.Key)
end

local function container(inventory: Inventory, location: Location): { [any]: Rules.Instance }
	return (inventory :: any)[location.Area]
end

function Model.get(inventory: Inventory, location: Location): Rules.Instance?
	return container(inventory, location)[location.Key]
end

local function put(inventory: Inventory, location: Location, instance: Rules.Instance?)
	container(inventory, location)[location.Key] = instance :: any
end

-- Whether a location may hold this instance at all.
function Model.accepts(location: Location, instance: Rules.Instance?): boolean
	if not instance then
		return true
	end
	local definition = Rules.definition(instance.ItemId)
	if not definition then
		return false
	end
	if location.Area == "Bag" then
		return true
	elseif location.Area == "Quick" then
		return definition.Category == "Consumable"
	elseif location.Area == "Equip" then
		return definition.EquipSlot == location.Key
	end
	return false
end

function Model.firstEmptyBag(inventory: Inventory): number?
	for index = 1, Model.BagSize do
		if not inventory.Bag[index] then
			return index
		end
	end
	return nil
end

-- Moves, merges, or swaps. Returns success and a short reason on failure.
function Model.move(inventory: Inventory, fromValue: any, toValue: any): (boolean, string?)
	local from, to = Model.parse(fromValue), Model.parse(toValue)
	if not from or not to then
		return false, "BadLocation"
	end
	if Model.format(from) == Model.format(to) then
		return false, "Same"
	end
	local moving = Model.get(inventory, from)
	if not moving then
		return false, "Empty"
	end
	local target = Model.get(inventory, to)
	if not Model.accepts(to, moving) then
		return false, "Rejected"
	end
	if target and Rules.canStack(moving, target) then
		local room = Rules.maxStack(Rules.definition(target.ItemId)) - target.Count
		if room <= 0 then
			-- Full stacks simply trade places.
			put(inventory, from, target)
			put(inventory, to, moving)
			return true
		end
		local amount = math.min(room, moving.Count)
		target.Count += amount
		moving.Count -= amount
		if moving.Count <= 0 then
			put(inventory, from, nil)
		end
		return true
	end
	if target and not Model.accepts(from, target) then
		return false, "SwapRejected"
	end
	put(inventory, from, target)
	put(inventory, to, moving)
	return true
end

-- Splits `amount` off a stack into the first empty bag slot.
function Model.split(inventory: Inventory, fromValue: any, amount: any, newUid: string): (boolean, string?)
	local from = Model.parse(fromValue)
	local source = if from then Model.get(inventory, from) else nil
	if not source or type(amount) ~= "number" or amount ~= amount then
		return false, "BadSplit"
	end
	amount = math.floor(amount)
	if amount < 1 or amount >= source.Count then
		return false, "BadAmount"
	end
	local index = Model.firstEmptyBag(inventory)
	if not index then
		return false, "Full"
	end
	source.Count -= amount
	inventory.Bag[index] = Rules.new(source.ItemId, newUid, amount, source.Rarity, {})
	return true
end

-- Removes up to `count` (default: all) from a location and returns what was taken.
function Model.take(inventory: Inventory, location: Location, count: number?, newUid: string?): Rules.Instance?
	local source = Model.get(inventory, location)
	if not source then
		return nil
	end
	local amount = math.clamp(math.floor(count or source.Count), 1, source.Count)
	if amount >= source.Count then
		put(inventory, location, nil)
		return source
	end
	source.Count -= amount
	local taken = Rules.copy(source)
	taken.Uid = newUid or source.Uid
	taken.Count = amount
	return taken
end

-- Adds an instance, merging into compatible stacks (quick slots first) then
-- filling empty bag slots. Returns the count that did not fit.
function Model.add(inventory: Inventory, instance: Rules.Instance): number
	local definition = Rules.definition(instance.ItemId)
	if not definition then
		return instance.Count
	end
	local maxStack = Rules.maxStack(definition)
	if maxStack > 1 and #instance.Affixes == 0 then
		local stacks = {}
		for index = 1, Model.QuickSize do
			table.insert(stacks, inventory.Quick[index])
		end
		for index = 1, Model.BagSize do
			table.insert(stacks, inventory.Bag[index])
		end
		for _, stack in stacks do
			if instance.Count <= 0 then
				break
			end
			if stack and Rules.canStack(stack, instance) and stack.Count < maxStack then
				local amount = math.min(maxStack - stack.Count, instance.Count)
				stack.Count += amount
				instance.Count -= amount
			end
		end
	end
	if instance.Count <= 0 then
		return 0
	end
	local index = Model.firstEmptyBag(inventory)
	if not index then
		return instance.Count
	end
	inventory.Bag[index] = instance
	return 0
end

function Model.isEmpty(inventory: Inventory): boolean
	return next(inventory.Bag) == nil and next(inventory.Equip) == nil and next(inventory.Quick) == nil
end

-- Flat list form that survives DataStore and remote serialisation (no sparse arrays).
function Model.serialize(inventory: Inventory): { any }
	local list = {}
	for _, area in { "Bag", "Equip", "Quick" } do
		for key, instance in (inventory :: any)[area] do
			local entry = Rules.copy(instance) :: any
			entry.Location = area .. ":" .. tostring(key)
			table.insert(list, entry)
		end
	end
	return list
end

-- Rebuilds from untrusted serialised data, dropping invalid or duplicate entries.
function Model.deserialize(raw: any): Inventory
	local inventory = Model.blank()
	if type(raw) ~= "table" then
		return inventory
	end
	local seen: { [string]: boolean } = {}
	local overflow = {}
	for index, entry in raw do
		if type(index) ~= "number" or index > 200 then
			continue
		end
		local instance = Rules.clean(entry)
		if not instance or seen[instance.Uid] then
			continue
		end
		seen[instance.Uid] = true
		local location = Model.parse(if type(entry) == "table" then entry.Location else nil)
		if location and not Model.get(inventory, location) and Model.accepts(location, instance) then
			put(inventory, location, instance)
		else
			table.insert(overflow, instance)
		end
	end
	for _, instance in overflow do
		Model.add(inventory, instance)
	end
	return inventory
end

return Model
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">ItemRules</string>
            <string name="Source"><![CDATA[--!strict

-- Pure item-instance rules shared by server authority and client presentation:
-- loot rolling, stat aggregation, melee profile resolution and save cleaning.
-- An item instance is { Uid, ItemId, Count, Rarity, Affixes = { { Id, Value } } }.
local Configuration = script.Parent.Parent.Configuration
local Items = require(Configuration.Items).Items
local Loot = require(Configuration.Loot)
local Melee = require(Configuration.MeleeProfiles)

local Rules = {}

export type Affix = { Id: string, Value: number }
export type Instance = {
	Uid: string,
	ItemId: string,
	Count: number,
	Rarity: string,
	Affixes: { Affix },
}

local rarityIndex: { [string]: number } = {}
for index, rarity in Loot.Rarities do
	rarityIndex[rarity.Id] = index
end

function Rules.definition(itemId: any): any?
	return if type(itemId) == "string" then Items[itemId] else nil
end

function Rules.rarity(id: string): any
	return Loot.Rarities[rarityIndex[id] or 1]
end

function Rules.rollable(definition: any): boolean
	return definition ~= nil
		and ((definition.Category == "Weapon" and definition.WeaponType == "Melee") or definition.Category == "Armor")
end

function Rules.maxStack(definition: any): number
	return math.max(1, if definition and type(definition.MaxStack) == "number" then definition.MaxStack else 1)
end

function Rules.canStack(a: Instance?, b: Instance?): boolean
	if not a or not b or a.ItemId ~= b.ItemId or #a.Affixes > 0 or #b.Affixes > 0 then
		return false
	end
	return Rules.maxStack(Rules.definition(a.ItemId)) > 1
end

function Rules.new(itemId: string, uid: string, count: number?, rarity: string?, affixes: { Affix }?): Instance
	return {
		Uid = uid,
		ItemId = itemId,
		Count = count or 1,
		Rarity = rarity or "Common",
		Affixes = affixes or {},
	}
end

local function pickRarity(rng: Random, bonus: number): string
	local total = 0
	local weights = {}
	for index, rarity in Loot.Rarities do
		local weight = rarity.Weight * (1 + bonus * 0.5) ^ (index - 1)
		weights[index] = weight
		total += weight
	end
	local roll = rng:NextNumber() * total
	for index, weight in weights do
		roll -= weight
		if roll <= 0 then
			return Loot.Rarities[index].Id
		end
	end
	return Loot.Rarities[#Loot.Rarities].Id
end

local function round(value: number): number
	return math.floor(value * 1000 + 0.5) / 1000
end

-- Rolls one instance. Non-rollable items (consumables, materials, focus) are Common with no affixes.
function Rules.roll(itemId: string, rng: Random, uid: string, rarityBonus: number?, count: number?): Instance?
	local definition = Items[itemId]
	if not definition then
		return nil
	end
	if not Rules.rollable(definition) then
		return Rules.new(itemId, uid, math.clamp(count or 1, 1, Rules.maxStack(definition)))
	end
	local rarity = pickRarity(rng, rarityBonus or 0)
	local pool = {}
	for id, affix in Loot.Affixes do
		if affix.Categories[definition.Category] then
			table.insert(pool, id)
		end
	end
	table.sort(pool) -- Deterministic order so seeded rolls are reproducible.
	local affixes = {}
	local scale = Loot.RarityScale[rarity] or 1
	for _ = 1, math.min(Rules.rarity(rarity).Affixes, #pool) do
		local id = table.remove(pool, rng:NextInteger(1, #pool))
		local affix = Loot.Affixes[id]
		table.insert(
			affixes,
			{ Id = id, Value = round((affix.Min + (affix.Max - affix.Min) * rng:NextNumber()) * scale) }
		)
	end
	return Rules.new(itemId, uid, 1, rarity, affixes)
end

-- Picks loot from a role's table. Returns a list of { ItemId, Count, RarityBonus }.
function Rules.rollDrops(role: string, rng: Random): { { ItemId: string, Count: number, RarityBonus: number } }
	local tableDef = Loot.Tables[role] or Loot.Tables.Basic
	local drops = {}
	if rng:NextNumber() > tableDef.Chance then
		return drops
	end
	local total = 0
	for _, entry in tableDef.Entries do
		total += entry.Weight
	end
	for _ = 1, tableDef.Rolls do
		local roll = rng:NextNumber() * total
		for _, entry in tableDef.Entries do
			roll -= entry.Weight
			if roll <= 0 then
				local count = if entry.Count then rng:NextInteger(entry.Count[1], entry.Count[2]) else 1
				table.insert(drops, { ItemId = entry.ItemId, Count = count, RarityBonus = tableDef.RarityBonus })
				break
			end
		end
	end
	return drops
end

function Rules.stats(instance: Instance?): { [string]: number }
	local result: { [string]: number } = {}
	if not instance then
		return result
	end
	for _, affix in instance.Affixes do
		local definition = Loot.Affixes[affix.Id]
		if definition then
			result[definition.Stat] = (result[definition.Stat] or 0) + affix.Value
		end
	end
	return result
end

local function scaleAttack(attack: any, damage: number, speed: number, reach: number): any
	return {
		Startup = attack.Startup / speed,
		Active = attack.Active,
		Recovery = attack.Recovery / speed,
		Damage = math.floor(attack.Damage * damage + 0.5),
		Size = Vector3.new(attack.Size.X, attack.Size.Y, attack.Size.Z * reach),
		Offset = attack.Offset * (1 + (reach - 1) * 0.5),
		Reach = attack.Reach * reach,
		Reaction = attack.Reaction,
	}
end

-- Resolves an equipped melee instance into concrete attack timings and guard values.
function Rules.meleeLoadout(instance: Instance?): any?
	local definition = if instance then Items[instance.ItemId] else nil
	if not definition or definition.WeaponType ~= "Melee" then
		return nil
	end
	local profile = Melee.Profiles[definition.Archetype or "Sword"]
	if not profile then
		return nil
	end
	local stats = Rules.stats(instance)
	local damage = (definition.DamageScale or 1) * (1 + (stats.Damage or 0))
	local speed = (definition.SpeedScale or 1) * (1 + (stats.AttackSpeed or 0))
	local reach = 1 + (stats.Reach or 0)
	local lights = {}
	for index, attack in profile.Lights do
		lights[index] = scaleAttack(attack, damage, speed, reach)
	end
	return {
		Archetype = definition.Archetype,
		HandsOccupied = definition.HandsOccupied or 1,
		Lights = lights,
		Heavy = scaleAttack(profile.Heavy, damage * (1 + (stats.HeavyDamage or 0)), speed, reach),
		Block = {
			Reduction = math.clamp(profile.Block.Reduction + (stats.BlockReduction or 0), 0, 0.95),
			ParryWindow = profile.Block.ParryWindow + (stats.ParryWindow or 0),
			FacingDot = profile.Block.FacingDot,
		},
	}
end

function Rules.armor(instances: { Instance? }): number
	local total = 0
	for _, instance in instances do
		local definition = if instance then Items[instance.ItemId] else nil
		if definition and definition.Category == "Armor" then
			total += (definition.Armor or 0) + (Rules.stats(instance).Armor or 0)
		end
	end
	return math.clamp(total, 0, Loot.MaxArmor)
end

function Rules.displayName(instance: Instance): string
	local definition = Items[instance.ItemId]
	local name = if definition then definition.Name or instance.ItemId else instance.ItemId
	local first = instance.Affixes[1]
	local affix = if first then Loot.Affixes[first.Id] else nil
	return if affix then affix.Name .. " " .. name else name
end

local function formatAffix(affix: Affix): string?
	local definition = Loot.Affixes[affix.Id]
	if not definition then
		return nil
	end
	local labels = {
		Damage = "damage",
		AttackSpeed = "attack speed",
		Reach = "reach",
		HeavyDamage = "heavy damage",
		ParryWindow = "parry window",
		BlockReduction = "block reduction",
		Armor = "damage reduction",
	}
	local label = labels[definition.Stat] or definition.Stat
	if definition.Kind == "Seconds" then
		return string.format("+%.2fs %s", affix.Value, label)
	end
	return string.format("+%d%% %s", math.floor(affix.Value * 100 + 0.5), label)
end

-- Tooltip content: title, colour, and ordered text lines.
function Rules.describe(
	instance: Instance
): { Title: string, Color: Color3, Subtitle: string, Lines: { string }, Description: string }
	local definition = Items[instance.ItemId] or {}
	local rarity = Rules.rarity(instance.Rarity)
	local lines = {}
	local subtitle = definition.Category or "Item"
	if definition.WeaponType == "Melee" then
		local loadout = Rules.meleeLoadout(instance)
		subtitle = string.format(
			"%s %s · %s",
			rarity.Name,
			definition.Archetype or "Weapon",
			if definition.HandsOccupied == 2 then "Two-handed" else "One-handed"
		)
		if loadout then
			local lightTotal = 0
			for _, attack in loadout.Lights do
				lightTotal += attack.Damage
			end
			table.insert(lines, string.format("Light combo: %d hits, %d total", #loadout.Lights, lightTotal))
			table.insert(lines, string.format("Heavy: %d damage", loadout.Heavy.Damage))
			table.insert(lines, string.format("Reach: %.1f", loadout.Lights[1].Reach))
			table.insert(
				lines,
				string.format(
					"Block: %d%%  Parry: %.2fs",
					math.floor(loadout.Block.Reduction * 100 + 0.5),
					loadout.Block.ParryWindow
				)
			)
		end
	elseif definition.WeaponType == "MagicFocus" then
		subtitle = "Magic Focus"
		table.insert(lines, "Casts your awakened magic profile")
	elseif definition.Category == "Armor" then
		subtitle = string.format("%s %s armour", rarity.Name, definition.EquipSlot or "")
		table.insert(lines, string.format("Damage reduction: %d%%", math.floor((definition.Armor or 0) * 100 + 0.5)))
	elseif definition.Category == "Consumable" then
		subtitle = "Consumable"
		if definition.Heal then
			table.insert(lines, string.format("Restores %d health", definition.Heal))
		end
	elseif definition.Category == "Material" then
		subtitle = "Material"
	end
	for _, affix in instance.Affixes do
		local text = formatAffix(affix)
		if text then
			table.insert(lines, text)
		end
	end
	if instance.Count > 1 then
		table.insert(lines, string.format("Stack: %d / %d", instance.Count, Rules.maxStack(definition)))
	end
	return {
		Title = Rules.displayName(instance),
		Color = rarity.Color,
		Subtitle = subtitle,
		Lines = lines,
		Description = definition.Description or "",
	}
end

-- Validates untrusted (saved) data back into an instance, or nil when unusable.
function Rules.clean(raw: any): Instance?
	if type(raw) ~= "table" or type(raw.Uid) ~= "string" or #raw.Uid == 0 or #raw.Uid > 64 then
		return nil
	end
	local definition = Rules.definition(raw.ItemId)
	if not definition then
		return nil
	end
	local count = if type(raw.Count) == "number" and raw.Count == raw.Count then math.floor(raw.Count) else 1
	count = math.clamp(count, 1, Rules.maxStack(definition))
	local rarity = if type(raw.Rarity) == "string" and rarityIndex[raw.Rarity] then raw.Rarity else "Common"
	local affixes = {}
	if Rules.rollable(definition) and type(raw.Affixes) == "table" then
		local seen = {}
		local maxScale = 1
		for _, scale in Loot.RarityScale do
			maxScale = math.max(maxScale, scale)
		end
		for _, affix in raw.Affixes do
			local affixDef = if type(affix) == "table" and type(affix.Id) == "string"
				then Loot.Affixes[affix.Id]
				else nil
			if
				affixDef
				and not seen[affix.Id]
				and affixDef.Categories[definition.Category]
				and type(affix.Value) == "number"
				and affix.Value == affix.Value
				and #affixes < 4
			then
				seen[affix.Id] = true
				table.insert(affixes, { Id = affix.Id, Value = math.clamp(affix.Value, 0, affixDef.Max * maxScale) })
			end
		end
	end
	if not Rules.rollable(definition) then
		rarity = "Common"
	end
	return Rules.new(raw.ItemId, raw.Uid, count, rarity, affixes)
end

function Rules.copy(instance: Instance): Instance
	local affixes = {}
	for index, affix in instance.Affixes do
		affixes[index] = { Id = affix.Id, Value = affix.Value }
	end
	return Rules.new(instance.ItemId, instance.Uid, instance.Count, instance.Rarity, affixes)
end

return Rules
]]></string>
