        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">MagicActionFlow</string>
            <string name="Source"><![CDATA[--!strict
-- Pure presentation adapter for turning a SpellSpec trigger table into player-facing
-- action blocks. It never mutates or simplifies the saved spell definition.
local Flow = {}

local RELATION_LABELS = {
	First = "WHEN",
	Parallel = "ALSO",
}

local function copy(value)
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[key] = copy(child)
	end
	return result
end

local OPERATOR_TEXT = {
	["=="] = "is",
	["!="] = "is not",
	Is = "is",
	IsNot = "is not",
	[">"] = ">",
	[">="] = "≥",
	["<"] = "<",
	["<="] = "≤",
	Within = "within",
	Outside = "beyond",
	Has = "has",
	DoesNotHave = "lacks",
	MultipleOf = "is a multiple of",
}

-- Readable one-line form of a condition tree for the action map, e.g.
-- "Target HealthPercent < 0.5 and SpellState AreaOccupants ≥ 3".
function Flow.conditionSummary(node): string
	if type(node) ~= "table" then
		return "?"
	end
	if node.Operator == "ALL" or node.Operator == "ANY" then
		local parts = {}
		for _, child in ipairs(node.Conditions or {}) do
			local text = Flow.conditionSummary(child)
			if child.Operator == "ALL" or child.Operator == "ANY" then
				text = "(" .. text .. ")"
			end
			table.insert(parts, text)
		end
		return table.concat(parts, if node.Operator == "ALL" then " and " else " or ")
	elseif node.Operator == "NOT" then
		return "not (" .. Flow.conditionSummary((node.Conditions or {})[1]) .. ")"
	end
	return string.format(
		"%s %s %s %s",
		tostring(node.Family),
		tostring(node.Property),
		OPERATOR_TEXT[node.Operator] or tostring(node.Operator),
		tostring(node.Value)
	)
end

-- Starter condition for a new IF branch; the player edits it afterwards.
function Flow.branchCondition()
	return {
		Operator = "ALL",
		Conditions = { { Family = "Target", Property = "HealthPercent", Operator = "<", Value = 0.5 } },
	}
end

local function depth(node): number
	if type(node) ~= "table" or not (node.Operator == "ALL" or node.Operator == "ANY" or node.Operator == "NOT") then
		return 1
	end
	local deepest = 0
	for _, child in ipairs(node.Conditions or {}) do
		deepest = math.max(deepest, depth(child))
	end
	return 1 + deepest
end

-- The condition for an OTHERWISE branch: the exact negation of `condition`.
-- Unwraps an existing NOT instead of stacking another one.
function Flow.otherwise(condition, maxDepth: number): (any?, string?)
	if type(condition) ~= "table" then
		return nil, "Only a conditional step can have an otherwise branch."
	end
	if condition.Operator == "NOT" then
		local inner = copy((condition.Conditions or {})[1])
		local isGroup = type(inner) == "table"
			and (inner.Operator == "ALL" or inner.Operator == "ANY" or inner.Operator == "NOT")
		if type(inner) == "table" and not isGroup then
			-- A bare rule must sit inside a group to be a step condition.
			inner = { Operator = "ALL", Conditions = { inner } }
		end
		return inner, nil
	end
	if depth(condition) + 1 > maxDepth then
		return nil, "This condition is too deeply nested to invert."
	end
	return { Operator = "NOT", Conditions = { copy(condition) } }, nil
end

local function payloadLabels(step, schema): { string }
	local labels = {}
	for _, payload in ipairs(step.Payloads or {}) do
		local definition = schema.Payloads[payload.Kind]
		table.insert(labels, if definition then definition.Label else payload.Kind or "Unknown effect")
	end
	if step.Behavior then
		local definition = schema.Behaviors[step.Behavior]
		table.insert(labels, if definition then definition.Label else step.Behavior)
	end
	if #labels == 0 then
		table.insert(labels, "Empty step")
	end
	return labels
end

function Flow.describeStep(eventName: string, stepIndex: number, step, schema)
	local eventLabel = schema.EventLabels[eventName] or eventName
	local labels = payloadLabels(step, schema)
	return {
		Event = eventName,
		EventLabel = eventLabel,
		StepIndex = stepIndex,
		Relation = if stepIndex == 1 then RELATION_LABELS.First else RELATION_LABELS.Parallel,
		Title = table.concat(labels, " + "),
		HasCondition = step.Condition ~= nil,
		ConditionLabel = if step.Condition then "IF " .. Flow.conditionSummary(step.Condition) else "Always",
		IsEmpty = #(step.Payloads or {}) == 0 and step.Behavior == nil,
	}
end

function Flow.build(definition, schema, eventOrder: { string }?)
	local result = {}
	local ordered = eventOrder or schema.EventOrder
	for _, eventName in ipairs(ordered) do
		for stepIndex, step in ipairs((definition.Triggers or {})[eventName] or {}) do
			table.insert(result, Flow.describeStep(eventName, stepIndex, step, schema))
		end
	end
	return result
end

function Flow.canAddStep(definition, eventName: string, maxSteps: number): (boolean, string?)
	local steps = (definition.Triggers or {})[eventName] or {}
	if #steps >= maxSteps then
		return false, string.format("This timing already has the limit of %d steps.", maxSteps)
	end
	return true, nil
end

return Flow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">MagicAerialMovementSpec</string>
            <string name="Source"><![CDATA[-- Pure bounds for aerial movement authoring and client-input validation.
local Spec = {}

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function Spec.clampSpeed(value, maximum)
	if not finite(value) or not finite(maximum) or maximum <= 0 then
		return nil
	end
	return math.max(0, math.min(value, maximum))
end

function Spec.normalizeInput(x, y, z, maximumMagnitude)
	if not finite(x) or not finite(y) or not finite(z) or not finite(maximumMagnitude) or maximumMagnitude <= 0 then
		return nil
	end
	local magnitude = math.sqrt(x * x + y * y + z * z)
	if not finite(magnitude) or magnitude > maximumMagnitude then
		return nil
	end
	if magnitude > 1 then
		return x / magnitude, y / magnitude, z / magnitude
	end
	return x, y, z
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">MagicAreaGrowth</string>
            <string name="Source"><![CDATA[--!strict

-- Shared scale math keeps server hit geometry and presentation dimensions in sync.
local Growth = {}

local function clamp(value, minimum, maximum)
	return math.max(minimum, math.min(maximum, value))
end

function Growth.scale(area, age)
	if area.GrowthDuration == nil or area.GrowthDuration <= 0 then
		return 1
	end
	local alpha = clamp(math.max(age, 0) / area.GrowthDuration, 0, 1)
	return area.GrowthStartScale + (area.GrowthEndScale - area.GrowthStartScale) * alpha
end

function Growth.area(area, scale)
	if scale == 1 then
		return area
	end
	local result = {}
	for key, value in pairs(area) do
		result[key] = value
	end
	for _, key in ipairs({
		"Radius",
		"Range",
		"Height",
		"Width",
		"Depth",
		"Thickness",
		"InnerRadius",
		"OuterRadius",
	}) do
		if type(result[key]) == "number" then
			result[key] = result[key] * scale
		end
	end
	return result
end

return Growth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">MagicAreaMembership</string>
            <string name="Source"><![CDATA[--!strict

-- Pure set difference for sampled Field/Aura occupancy transitions.
local Membership = {}

function Membership.diff(previous, targets)
	local current = {}
	local entered = {}
	for _, target in ipairs(targets) do
		if not current[target] then
			current[target] = true
			if not previous[target] then
				table.insert(entered, target)
			end
		end
	end

	local exited = {}
	for target in pairs(previous) do
		if not current[target] then
			table.insert(exited, target)
		end
	end

	return current, entered, exited
end

function Membership.clear(previous)
	local exited = {}
	for target in pairs(previous) do
		table.insert(exited, target)
	end
	return exited
end

return Membership
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">MagicAreaSpec</string>
            <string name="Source"><![CDATA[-- Shared pure-data validation for Field and Aura hit-volume geometry.
local Spec = {}

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function bounded(value, minimum, maximum)
	return finite(value) and value >= minimum and value <= maximum
end

local function hasOnlyKeys(value, allowed)
	if type(value) ~= "table" then
		return false
	end
	for key in pairs(value) do
		if not allowed[key] then
			return false
		end
	end
	return true
end

function Spec.validate(form, shape, area, maxRadius, minInterval)
	if form ~= "Field" and form ~= "Aura" then
		return false, "Area geometry requires a Field or Aura"
	end
	local allowed = {
		Interval = true,
		Yaw = true,
		GrowthStartScale = true,
		GrowthEndScale = true,
		GrowthDuration = true,
	}
	if form == "Field" then
		allowed.DebugHeight, allowed.FollowTarget = true, true
	end
	if shape == "Sphere" then
		allowed.Radius = true
	elseif shape == "Capsule" then
		allowed.Radius, allowed.Height = true, true
	elseif shape == "Cylinder" then
		allowed.Radius, allowed.Height = true, true
	elseif shape == "Cone" then
		allowed.Range, allowed.Angle, allowed.Height = true, true, true
	elseif shape == "Ring" then
		allowed.InnerRadius, allowed.OuterRadius, allowed.Height = true, true, true
	elseif shape == "Box" then
		allowed.Width, allowed.Height, allowed.Depth = true, true, true
	elseif shape == "Plane" then
		allowed.Width, allowed.Height, allowed.Thickness = true, true, true
	elseif shape == "Line" then
		allowed.Width, allowed.Height, allowed.Range = true, true, true
	else
		return false, "Unsupported area geometry"
	end
	if not hasOnlyKeys(area, allowed) then
		return false, "Area contains settings unrelated to its selected geometry"
	end

	local dimensionsValid
	if shape == "Sphere" then
		dimensionsValid = bounded(area.Radius, 0.1, maxRadius)
	elseif shape == "Capsule" then
		dimensionsValid = bounded(area.Radius, 0.1, maxRadius) and bounded(area.Height, area.Radius * 2, maxRadius)
	elseif shape == "Cylinder" then
		dimensionsValid = bounded(area.Radius, 0.1, maxRadius) and bounded(area.Height, 0.1, maxRadius)
	elseif shape == "Cone" then
		dimensionsValid = bounded(area.Range, 0.1, maxRadius)
			and bounded(area.Height, 0.1, maxRadius)
			and bounded(area.Angle, 5, 120)
	elseif shape == "Ring" then
		dimensionsValid = bounded(area.InnerRadius, 0.1, maxRadius)
			and bounded(area.OuterRadius, 0.2, maxRadius)
			and area.InnerRadius < area.OuterRadius
			and bounded(area.Height, 0.1, maxRadius)
	elseif shape == "Plane" then
		dimensionsValid = bounded(area.Width, 0.1, maxRadius)
			and bounded(area.Height, 0.1, maxRadius)
			and bounded(area.Thickness, 0.1, math.min(maxRadius, 4))
	elseif shape == "Line" then
		dimensionsValid = bounded(area.Width, 0.1, maxRadius)
			and bounded(area.Height, 0.1, maxRadius)
			and bounded(area.Range, 0.1, maxRadius)
	else
		dimensionsValid = bounded(area.Width, 0.1, maxRadius)
			and bounded(area.Height, 0.1, maxRadius)
			and bounded(area.Depth, 0.1, maxRadius)
	end
	if not dimensionsValid then
		return false, "Area dimensions are invalid or outside the configured limit"
	end
	if not bounded(area.Interval, minInterval, 5) or not bounded(area.Yaw, -180, 180) then
		return false, "Area interval or yaw is outside the configured limit"
	end
	if area.FollowTarget ~= nil and type(area.FollowTarget) ~= "boolean" then
		return false, "Area follow-target setting must be true or false"
	end
	local hasGrowth = (area.GrowthStartScale ~= nil and area.GrowthStartScale ~= 0)
		or (area.GrowthEndScale ~= nil and area.GrowthEndScale ~= 0)
		or (area.GrowthDuration ~= nil and area.GrowthDuration ~= 0)
	if
		hasGrowth
		and (
			not bounded(area.GrowthStartScale, 0.1, 2)
			or not bounded(area.GrowthEndScale, 0.1, 2)
			or not bounded(area.GrowthDuration, 0.1, 30)
		)
	then
		return false, "Area expansion needs start/end scales from 0.1–2 and duration from 0.1–30 seconds"
	end
	if hasGrowth then
		local maximumScale = math.max(area.GrowthStartScale, area.GrowthEndScale)
		local maximumDimension
		if shape == "Sphere" then
			maximumDimension = area.Radius
		elseif shape == "Capsule" or shape == "Cylinder" then
			maximumDimension = math.max(area.Radius, area.Height)
		elseif shape == "Ring" then
			maximumDimension = area.OuterRadius
		elseif shape == "Cone" then
			maximumDimension = math.max(area.Range, area.Height, 2 * area.Range * math.tan(math.rad(area.Angle / 2)))
		elseif shape == "Line" then
			maximumDimension = math.max(area.Range, area.Height, area.Width)
		elseif shape == "Plane" then
			maximumDimension = math.max(area.Width, area.Height, area.Thickness)
		else
			maximumDimension = math.max(area.Width, area.Height, area.Depth)
		end
		if maximumDimension * maximumScale > maxRadius then
			return false, "Expanded area would exceed the configured maximum radius"
		end
	end
	if form == "Field" and not bounded(area.DebugHeight, 0.1, 1) then
		return false, "Field debug marker height is outside the configured limit"
	end
	return true, nil
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">MagicAttributeSpec</string>
            <string name="Source"><![CDATA[-- Explicit allowlist for temporary spell-driven numeric attributes.
local Limits = require(script.Parent.Parent.Configuration.MagicLab)
local Spec = {}

Spec.Definitions = {
	MagicArmor = {
		Label = "Magic armor",
		Minimum = -Limits.MaxArmorModifier,
		Maximum = Limits.MaxArmorModifier,
	},
	MagicStrength = {
		Label = "Strength",
		Minimum = Limits.MinMagicStrengthModifier,
		Maximum = Limits.MaxMagicStrengthModifier,
	},
}

function Spec.supports(attribute)
	return Spec.Definitions[attribute] ~= nil
end

function Spec.clamp(attribute, amount)
	local definition = Spec.Definitions[attribute]
	if
		not definition
		or type(amount) ~= "number"
		or amount ~= amount
		or amount == math.huge
		or amount == -math.huge
	then
		return nil
	end
	return math.max(definition.Minimum, math.min(definition.Maximum, amount))
end

function Spec.aggregate(effects, attribute, now)
	local total = 0
	for _, effect in ipairs(effects) do
		if
			effect.Kind == "ModifyAttribute"
			and effect.Attribute == attribute
			and (now == nil or effect.ExpiresAt == nil or effect.ExpiresAt > now)
		then
			total = total + (effect.Amount or 0)
		end
	end
	local definition = Spec.Definitions[attribute]
	if not definition then
		return 0
	end
	return math.max(definition.Minimum, math.min(definition.Maximum, total))
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">MagicAudioSpec</string>
            <string name="Source"><![CDATA[-- Optional Roblox audio asset IDs used by the reusable magic presentation runtime.
local Spec = {}

Spec.Cues = {
	{ Key = "CastSoundId", Label = "Cast sound", Mode = "OneShot" },
	{ Key = "ChargeSoundId", Label = "Charge sound", Mode = "OneShot" },
	{ Key = "TravelSoundId", Label = "Travel loop", Mode = "Loop" },
	{ Key = "ImpactSoundId", Label = "Impact sound", Mode = "OneShot" },
	{ Key = "AmbientLoopSoundId", Label = "Active effect loop", Mode = "Loop" },
	{ Key = "EndSoundId", Label = "End sound", Mode = "OneShot" },
	{ Key = "BreakSoundId", Label = "Break sound", Mode = "OneShot" },
}

Spec.Defaults = {
	CastSoundId = "",
	ChargeSoundId = "",
	TravelSoundId = "",
	ImpactSoundId = "",
	AmbientLoopSoundId = "",
	EndSoundId = "",
	BreakSoundId = "",
	Volume = 0.6,
	RollOffMaxDistance = 80,
}

local allowed = { Volume = true, RollOffMaxDistance = true }
for _, cue in ipairs(Spec.Cues) do
	allowed[cue.Key] = true
end

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Spec.validate(audio)
	if type(audio) ~= "table" then
		return false, "Audio settings must be a table"
	end
	for key, value in pairs(audio) do
		if not allowed[key] then
			return false, "Unsupported audio setting"
		end
		if key == "Volume" then
			if not finite(value) or value < 0 or value > 1 then
				return false, "Audio volume must be between 0 and 1"
			end
		elseif key == "RollOffMaxDistance" then
			if not finite(value) or value < 10 or value > 250 then
				return false, "Audio distance must be between 10 and 250 studs"
			end
		elseif type(value) ~= "string" or #value > 20 or (value ~= "" and not string.match(value, "^%d+$")) then
			return false, "Sound IDs must be blank or numeric Roblox asset IDs"
		end
	end
	return true, nil
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">MagicAuthoringGuide</string>
            <string name="Source"><![CDATA[--!strict
-- Intent hints use existing Form/effect capabilities. Required runtime defaults stay internal.
local Guide = {}

Guide.Intents = {
	{
		Id = "Attack",
		Label = "Attack",
		Description = "Hurt a target or pressure an area with damaging effects.",
		Payloads = { "Damage", "DamageOverTime", "Force" },
		RecommendedForms = { "Projectile", "Beam", "Wave", "Field" },
	},
	{
		Id = "Defense",
		Label = "Defense",
		Description = "Protect yourself or an ally with shields or defensive enhancements.",
		Payloads = { "Shield", "ModifyAttribute", "Enhancement" },
		RecommendedForms = { "Aura", "Field", "SelfEnhancement", "Construct" },
	},
	{
		Id = "Healing",
		Label = "Healing & support",
		Description = "Restore health or help an ally survive and recover.",
		Payloads = { "Heal", "Restoration", "Shield", "ModifyAttribute" },
		RecommendedForms = { "Aura", "Field", "Beam", "Projectile" },
	},
	{
		Id = "Movement",
		Label = "Movement",
		Description = "Fly yourself, improve movement, or move a target through space.",
		Payloads = { "Enhancement", "AerialMovement", "Displacement", "Control" },
		RecommendedForms = { "SelfEnhancement", "Wave", "Aura", "Projectile" },
	},
	{
		Id = "Control",
		Label = "Control",
		Description = "Slow, bind, pull, push, or otherwise limit a target.",
		Payloads = { "Slow", "Bind", "Control", "TimeDilation", "Displacement" },
		RecommendedForms = { "Field", "Wave", "Projectile", "Beam", "Aura" },
	},
	{
		Id = "Summoning",
		Label = "Summoning",
		Description = "Create a companion that can follow, protect, or use an assigned spell.",
		Payloads = { "Summon" },
		RecommendedForms = { "Aura", "Field", "Projectile", "Beam" },
	},
	{
		Id = "Utility",
		Label = "Utility",
		Description = "Reveal, alter, or interact with a target or the surrounding world.",
		Payloads = { "Reveal", "Manipulation", "Transformation" },
		RecommendedForms = { "Manipulation", "Construct", "Field", "Projectile" },
	},
	{
		Id = "Area",
		Label = "Area effects",
		Description = "Affect a zone, pulse, or nearby group instead of one direct target.",
		Payloads = {
			"Damage",
			"DamageOverTime",
			"Heal",
			"Restoration",
			"Shield",
			"Slow",
			"Bind",
			"Control",
			"Reveal",
			"Summon",
		},
		RecommendedForms = { "Field", "Aura", "Wave" },
	},
}

local function included(values, value)
	return table.find(values, value) ~= nil
end

local function intentDefinition(intentId)
	for _, intent in ipairs(Guide.Intents) do
		if intent.Id == intentId then
			return intent
		end
	end
	return nil
end

local function internalDefault(kind, formName, schema)
	local definition = schema.Payloads[kind]
	if definition and definition.Principle then
		return definition.Principle
	end
	-- Matches the Lab's creation step (MagicLabController): material
	-- Manipulation always uses the Matter Principle.
	if kind == "Manipulation" then
		return "Matter"
	end
	-- The runtime still requires a valid Source contract. Pick its default privately;
	-- this value never becomes a creation choice or a description of the spell.
	if schema.supportsPrincipleForm("Energy", formName) then
		return "Energy"
	end
	for _, principle in ipairs(schema.Principles) do
		if schema.supportsPrincipleForm(principle, formName) then
			return principle
		end
	end
	return nil
end

local function candidate(intent, formName, kind, event, schema, spec)
	local definition = schema.Payloads[kind]
	local principle = internalDefault(kind, formName, schema)
	if not definition or not principle or not schema.supportsPrincipleForm(principle, formName) then
		return nil
	end
	if not schema.supportsPayloadCapability(kind, formName, event) then
		return nil
	end
	local draft = spec.createDraft(formName, principle)
	if not draft then
		return nil
	end
	local payload = spec.copy(definition.Defaults or {})
	payload.Kind = kind
	draft.Triggers[event] = { { Payloads = { payload } } }
	-- Only offer starters the server will accept as created (for example,
	-- Manipulation on a Beam needs ObjectTarget and a material the guided
	-- path does not configure).
	if not spec.validate(draft) then
		return nil
	end
	return {
		Form = formName,
		-- Internal compatibility default required by the current spell contract.
		Payload = kind,
		Event = event,
		PayloadLabel = definition.Label or kind,
		Description = definition.Description or "",
		Category = definition.Category or "Utility",
		Intent = intent.Id,
	}
end

function Guide.forShape(intentId, formName, schema, spec)
	local intent = intentDefinition(intentId)
	local form = schema.Forms[formName]
	if not intent or not form then
		return {}
	end
	local results = {}
	for _, kind in ipairs(intent.Payloads) do
		local definition = schema.Payloads[kind]
		if definition then
			for _, event in ipairs(schema.eventsForEffects(formName, "Instant", form.Draft.Targeting)) do
				local result = candidate(intent, formName, kind, event, schema, spec)
				if result then
					table.insert(results, result)
					break
				end
			end
		end
	end
	return results
end

function Guide.shapes(intentId, schema, spec)
	local intent = intentDefinition(intentId)
	if not intent then
		return {}
	end
	local results = {}
	for _, formName in ipairs(schema.FormOrder) do
		if #Guide.forShape(intentId, formName, schema, spec) > 0 then
			table.insert(results, formName)
		end
	end
	local order = {}
	for index, formName in ipairs(intent.RecommendedForms or {}) do
		order[formName] = index
	end
	table.sort(results, function(left, right)
		local leftRank, rightRank = order[left], order[right]
		if leftRank and rightRank then
			return leftRank < rightRank
		elseif leftRank then
			return true
		elseif rightRank then
			return false
		end
		return table.find(schema.FormOrder, left) < table.find(schema.FormOrder, right)
	end)
	return results
end

function Guide.isRecommended(intentId, formName)
	local intent = intentDefinition(intentId)
	return intent ~= nil and included(intent.RecommendedForms or {}, formName)
end

function Guide.intents()
	return Guide.Intents
end

function Guide.definition(intentId)
	return intentDefinition(intentId)
end

return Guide
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">MagicBeamAim</string>
            <string name="Source"><![CDATA[-- Convert a camera aim point into a ray from the actual casting origin.
-- Caller validates the point and direction; collision/range checks stay server-owned.
local Aim = {}
function Aim.direction(origin, fallback, point, minimumDot)
	if point then
		local delta = point - origin
		if delta.Magnitude > 0.001 and fallback:Dot(delta.Unit) >= (minimumDot or -1) then
			return delta.Unit
		end
	end
	return fallback
end
return Aim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">MagicBodyRegionSpec</string>
            <string name="Source"><![CDATA[-- Classifies Roblox character body-part names for optional payload damage scaling.
-- Unknown/custom rig parts deliberately fall back to Other.
local Spec = {}

local function normalized(name)
	local result = string.lower(name):gsub("[^%a]", "")
	return result
end

function Spec.classify(partName)
	if type(partName) ~= "string" then
		return "Other"
	end

	local name = normalized(partName)
	if name == "head" then
		return "Head"
	elseif name == "torso" or name == "uppertorso" or name == "lowertorso" or name == "humanoidrootpart" then
		return "Torso"
	elseif string.find(name, "arm", 1, true) or string.find(name, "hand", 1, true) then
		return "Arm"
	elseif string.find(name, "leg", 1, true) or string.find(name, "foot", 1, true) then
		return "Leg"
	end
	return "Other"
end

function Spec.multiplier(payload, partName)
	local region = Spec.classify(partName)
	local value = payload[region .. "Multiplier"]
	if type(value) ~= "number" or value ~= value or value < 0 or value > 4 then
		value = 1
	end
	return region, value
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">MagicCastInterruption</string>
            <string name="Source"><![CDATA[--!strict

-- Small pure rules for interrupting a cast before its server-timed release.
local Interruption = {}

function Interruption.damage(casting, amount)
	return casting.InterruptOnDamage == true and amount > 0 and amount == amount and amount < math.huge
end

function Interruption.movement(casting, distance)
	local threshold = casting.InterruptMoveDistance or 0
	return threshold > 0 and distance > threshold
end

return Interruption
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">MagicCastingSpec</string>
            <string name="Source"><![CDATA[-- Casting modes that currently have meaningful server runtime implementations.
local Spec = {}
Spec.ToggleForms = {
	Field = true,
	Aura = true,
	SelfEnhancement = true,
	Construct = true,
}
Spec.ChargeModes = { Charged = true, HoldAndRelease = true }
Spec.CommandForms = { Projectile = true, Beam = true, Wave = true, Field = true, Aura = true }
Spec.SustainedForms = { Construct = true }
Spec.ChanneledForms = {
	Projectile = true,
	Beam = true,
	Wave = true,
	Field = true,
	Aura = true,
	SelfEnhancement = true,
}

function Spec.supportsChannel(form)
	return Spec.ChanneledForms[form] == true
end

function Spec.supportsToggle(form)
	return Spec.ToggleForms[form] == true
end

function Spec.isChargeMode(mode)
	return Spec.ChargeModes[mode] == true
end

function Spec.supportsCommandCast(form)
	return Spec.CommandForms[form] == true
end

function Spec.supportsSustained(form)
	return Spec.SustainedForms[form] == true
end

function Spec.isHeldMode(mode)
	return mode == "Channeled" or mode == "Sustained"
end

function Spec.supportsAimUpdate(form, mode)
	return (form == "Beam" or form == "Projectile") and mode == "Channeled"
end

function Spec.movementMultiplier(casting)
	if casting.CanMoveWhileCasting == false then
		return 0
	end
	return 1 - (casting.MovementPenalty or 0)
end

function Spec.rotationLocked(casting)
	return casting.CanRotateWhileCasting == false
end

function Spec.hasFreeHand(casting, freeHandCount)
	return casting.RequiresFreeHand ~= true or (type(freeHandCount) == "number" and freeHandCount >= 1)
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">MagicCompanionSpellPolicy</string>
            <string name="Source"><![CDATA[--!strict

-- Companion casting accepts bounded target spells whose payloads imply one
-- unambiguous target relationship. Charged spells auto-release at full charge.
local Policy = {}
local forms = { Projectile = true, Beam = true, Wave = true, Field = true, Aura = true, Construct = true }
local offensive = {
	Damage = true,
	DamageOverTime = true,
	ElementalMark = true,
	Slow = true,
	Bind = true,
	Reveal = true,
	Control = true,
	Force = true,
	Displacement = true,
}
local supportive = { Heal = true, Restoration = true, Shield = true }
local auxiliary = { ElementalMark = true, ConsumeElementalMark = true }
local control = { Slow = true, Bind = true, Control = true, Displacement = true, ElementalMark = true }

function Policy.executionDefinition(definition, spellId)
	local execution = {}
	for key, value in pairs(definition) do
		execution[key] = value
	end
	execution.SpellId = spellId
	-- Magic Lab drafts may bypass sandbox costs for direct tests, but a companion
	-- cast is an owner-authorized cast and must use the ordinary Locus resource path.
	execution.Development = nil
	return execution
end

function Policy.castLockDuration(definition, gather, release)
	local charge = 0
	if definition.Casting.Mode == "Charged" or definition.Casting.Mode == "HoldAndRelease" then
		charge = definition.Casting.MaximumCharge or 0
	end
	local activeDuration = 0
	if definition.Casting.Mode == "Channeled" and definition.Lifetime then
		activeDuration = definition.Lifetime.Duration or 0
	end
	return charge + (definition.Casting.CastTime or 0) + gather + release + activeDuration
end

function Policy.autoReleasesAtFullCharge(definition, companionCast)
	return definition.Casting.Mode == "Charged"
		or (companionCast == true and definition.Casting.Mode == "HoldAndRelease")
end

function Policy.requiresCommandSlot(definition)
	return definition.Casting.Mode == "CommandCast" or definition.Casting.Mode == "Channeled"
end

function Policy.classify(definition)
	if
		not definition
		or (
			definition.Casting.Mode ~= "Instant"
			and definition.Casting.Mode ~= "Charged"
			and definition.Casting.Mode ~= "HoldAndRelease"
			and definition.Casting.Mode ~= "CommandCast"
			and definition.Casting.Mode ~= "Channeled"
		)
	then
		return nil, "Companions support Instant, charged, bounded Channeled, or CommandCast spells"
	end
	if not forms[definition.Form] then
		return nil, "This Form is not supported by companion casting"
	end
	if definition.Targeting == "MaterialTarget" or definition.Targeting == "ObjectTarget" then
		return nil, "Companions cannot select material or object targets yet"
	end
	local hasOffense, hasSupport, hasDamage, hasHeal, hasShield, hasArmorModifier, hasTimeDilation, hasControl, shieldAmount, armorAmount, timeRate =
		false, false, false, false, false, false, false, false, 0, 0, nil
	for _, steps in pairs(definition.Triggers or {}) do
		for _, step in ipairs(steps) do
			for _, payload in ipairs(step.Payloads or {}) do
				if payload.Kind == "ElementalMark" and definition.Element == "Neutral" then
					return nil, "Elemental marks require a non-neutral selected Element"
				elseif payload.Kind == "ModifyAttribute" then
					if
						(payload.Attribute == "MagicArmor" or payload.Attribute == "MagicStrength")
						and payload.Amount < 0
					then
						hasOffense = true
					else
						hasSupport = true
						hasArmorModifier = payload.Attribute == "MagicArmor"
						armorAmount = math.max(armorAmount, payload.Amount or 0)
					end
				elseif payload.Kind == "TimeDilation" then
					if type(payload.Rate) ~= "number" or payload.Rate ~= payload.Rate then
						return nil, "Time dilation needs a finite rate"
					end
					hasTimeDilation = true
					timeRate = payload.Rate
					if payload.Rate < 1 then
						hasOffense = true
					else
						hasSupport = true
					end
				elseif offensive[payload.Kind] then
					hasOffense = true
					hasDamage = hasDamage or payload.Kind == "Damage" or payload.Kind == "DamageOverTime"
					hasControl = hasControl or control[payload.Kind] == true
				elseif supportive[payload.Kind] then
					hasSupport = true
					hasHeal = hasHeal or payload.Kind == "Heal" or payload.Kind == "Restoration"
					hasShield = hasShield or payload.Kind == "Shield"
					if payload.Kind == "Shield" then
						shieldAmount = math.max(shieldAmount, payload.Amount or 0)
					end
				elseif not auxiliary[payload.Kind] then
					return nil, "This payload is not supported by companion casting"
				end
			end
		end
	end
	if not hasOffense and not hasSupport then
		return nil, "Companion spell needs a combat or support payload"
	end
	local relationship = definition.TargetRules.Relationship
	local mode
	if hasOffense and hasSupport then
		if relationship == "Hostile" then
			mode = "Hostile"
		elseif relationship == "Ally" then
			mode = "Ally"
		else
			return nil, "Mixed attack and support spells need an explicit Hostile or Ally target rule"
		end
	elseif hasOffense then
		if relationship ~= "Any" and relationship ~= "Hostile" then
			return nil, "Attack spells need an Any or Hostile target rule"
		end
		mode = "Hostile"
	else
		if relationship ~= "Ally" then
			return nil, "Support spells need an Ally target rule to prevent healing hostiles"
		end
		mode = "Ally"
	end
	return {
		Mode = mode,
		RequiresCommand = definition.Casting.Mode == "CommandCast",
		AutoReleasesAtFullCharge = Policy.autoReleasesAtFullCharge(definition, true),
		AutoChannelsToLifetime = definition.Casting.Mode == "Channeled",
		CanDamage = hasDamage,
		CanControl = hasControl,
		CanHeal = hasHeal,
		CanShield = hasShield,
		ShieldAmount = shieldAmount,
		CanModifyAttribute = hasArmorModifier,
		CanTimeDilation = hasTimeDilation,
		TimeRate = timeRate,
		ArmorAmount = armorAmount,
		Range = definition.TargetRules.Range,
	},
		nil
end

return Policy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">MagicConditionEvaluator</string>
            <string name="Source"><![CDATA[-- Pure condition-tree evaluator. Runtime adapters provide values through the
-- resolver; this module can be tested without Roblox services.
local Evaluator = {}

local function hasDelimitedTag(encoded, expected)
	if type(encoded) ~= "string" or type(expected) ~= "string" then
		return false
	end
	local tag = string.lower(expected)
	if #tag == 0 or #tag > 48 or string.find(tag, "[^%w_%-]") then
		return false
	end
	return string.find(encoded, "|" .. tag .. "|", 1, true) ~= nil
end

local function compare(actual, operator, expected)
	if actual == nil then
		return false
	end
	if operator == "==" or operator == "Is" then
		return actual == expected
	elseif operator == "!=" or operator == "IsNot" then
		return actual ~= expected
	elseif operator == ">" then
		return type(actual) == "number" and actual > expected
	elseif operator == ">=" then
		return type(actual) == "number" and actual >= expected
	elseif operator == "<" then
		return type(actual) == "number" and actual < expected
	elseif operator == "<=" then
		return type(actual) == "number" and actual <= expected
	elseif operator == "MultipleOf" then
		return type(actual) == "number" and type(expected) == "number" and expected >= 1 and actual % expected == 0
	elseif operator == "Within" then
		return type(actual) == "number" and actual <= expected
	elseif operator == "Outside" then
		return type(actual) == "number" and actual > expected
	elseif operator == "Has" then
		if type(actual) == "string" and string.sub(actual, 1, 1) == "|" then
			return hasDelimitedTag(actual, expected)
		end
		return type(actual) == "string" and string.find(string.lower(actual), string.lower(expected), 1, true) ~= nil
	elseif operator == "DoesNotHave" then
		if type(actual) == "string" and string.sub(actual, 1, 1) == "|" then
			return not hasDelimitedTag(actual, expected)
		end
		return type(actual) == "string" and string.find(string.lower(actual), string.lower(expected), 1, true) == nil
	end
	return false
end

local function evaluateNode(node, resolver, applicableFamilies)
	if node.Operator == "ALL" or node.Operator == "ANY" or node.Operator == "NOT" then
		if node.Operator == "NOT" then
			local child = evaluateNode(node.Conditions[1], resolver, applicableFamilies)
			if child == nil then
				return nil
			end
			return not child
		end
		local applicable, omitted, passed = 0, 0, 0
		for _, childNode in ipairs(node.Conditions) do
			local result = evaluateNode(childNode, resolver, applicableFamilies)
			if result == nil then
				omitted = omitted + 1
			else
				applicable = applicable + 1
				if result then
					passed = passed + 1
				end
			end
		end
		if applicable == 0 then
			return nil
		end
		if node.Operator == "ALL" then
			if passed ~= applicable then
				return false
			end
			if omitted == 0 then
				return true
			end
			return nil
		end
		if passed > 0 then
			return true
		end
		if omitted == 0 then
			return false
		end
		return nil
	end
	if applicableFamilies and not applicableFamilies[node.Family] then
		return nil
	end
	return compare(resolver(node.Family, node.Property), node.Operator, node.Value)
end

function Evaluator.evaluate(tree, resolver, applicableFamilies)
	return evaluateNode(tree, resolver, applicableFamilies)
end

return Evaluator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">MagicConditionSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Whitelisted condition language shared by server validation and the editor.
-- Values are resolved by explicit runtime adapters; spell data never supplies
-- property paths or executable code.
local ConditionSpec = {}
local registeredSpecialResourceProperties = {}

ConditionSpec.MaxDepth = 4
ConditionSpec.MaxNodes = 32
ConditionSpec.MaxChildren = 8
-- Families a trigger step may branch on. Environment and Material need world
-- queries the event context does not perform, so they are not offered.
ConditionSpec.StepConditionFamilies = {
	Caster = true,
	Target = true,
	Relationship = true,
	Status = true,
	Resource = true,
	SpellState = true,
	Time = true,
}
-- Properties inside allowed families that event contexts cannot resolve.
ConditionSpec.StepUnavailableProperties = {
	Target = { HasLineOfSight = true },
}
ConditionSpec.EndConditionFamilies = {
	Caster = true,
	Resource = true,
	Status = true,
	SpellState = true,
	Environment = true,
	Time = true,
}

local numeric = { "==", "!=", ">", ">=", "<", "<=", "Within", "Outside" }
local boolean = { "==", "!=", "Is", "IsNot" }
local stringComparison = { "==", "!=", "Is", "IsNot", "Has", "DoesNotHave" }
-- Counters also support cadence: "MultipleOf 3" passes on every third trigger.
local counter = { "==", "!=", ">", ">=", "<", "<=", "MultipleOf" }

ConditionSpec.Properties = {
	Caster = {
		HealthPercent = { Kind = "Number", Min = 0, Max = 1, Operators = numeric },
		IsAlive = { Kind = "Boolean", Operators = boolean },
		OnGround = { Kind = "Boolean", Operators = boolean },
		Team = { Kind = "String", MaxLength = 32, Operators = stringComparison },
	},
	Target = {
		HealthPercent = { Kind = "Number", Min = 0, Max = 1, Operators = numeric },
		IsAlive = { Kind = "Boolean", Operators = boolean },
		IsPlayer = { Kind = "Boolean", Operators = boolean },
		HasLineOfSight = { Kind = "Boolean", Operators = boolean },
		Name = { Kind = "String", MaxLength = 32, Operators = stringComparison },
		Tags = { Kind = "String", MaxLength = 24, Operators = { "Has", "DoesNotHave" } },
	},
	Relationship = {
		IsSelf = { Kind = "Boolean", Operators = boolean },
		IsAlly = { Kind = "Boolean", Operators = boolean },
		IsHostile = { Kind = "Boolean", Operators = boolean },
		IsNeutral = { Kind = "Boolean", Operators = boolean },
	},
	SpellState = {
		Age = { Kind = "Number", Min = 0, Max = 60, Operators = numeric },
		TargetsHit = { Kind = "Number", Min = 0, Max = 64, Integer = true, Operators = numeric },
		DistanceFromCaster = { Kind = "Number", Min = 0, Max = 100000, Operators = numeric },
		RemainingDuration = { Kind = "Number", Min = 0, Max = 100000, Operators = numeric },
		PierceCount = { Kind = "Number", Min = 0, Max = 64, Integer = true, Operators = numeric },
		BounceCount = { Kind = "Number", Min = 0, Max = 64, Integer = true, Operators = numeric },
		AbsorbedEnergy = { Kind = "Number", Min = 0, Max = 100000, Operators = numeric },
		ControlledMass = { Kind = "Number", Min = 0, Max = 3000000, Operators = numeric },
		HasCurrentTarget = { Kind = "Boolean", Operators = boolean },
		Tags = { Kind = "String", MaxLength = 48, Operators = { "Has", "DoesNotHave" } },
		Phase = { Kind = "String", MaxLength = 32, Operators = stringComparison },
		IsMaintained = { Kind = "Boolean", Operators = boolean },
		-- Runtime counters, kept per active effect by MagicService.emit.
		TriggerCount = { Kind = "Number", Min = 0, Max = 10000, Integer = true, Operators = counter },
		AreaOccupants = { Kind = "Number", Min = 0, Max = 64, Integer = true, Operators = numeric },
		EventTargets = { Kind = "Number", Min = 0, Max = 64, Integer = true, Operators = numeric },
	},
	Resource = {
		Mana = { Kind = "Number", Min = 0, Max = 100000, Operators = numeric },
		ManaPercent = { Kind = "Number", Min = 0, Max = 1, Operators = numeric },
		Capacity = { Kind = "Number", Min = 0, Max = 100000, Operators = numeric },
		Efficiency = { Kind = "Number", Min = 0.01, Max = 100, Operators = numeric },
		Potency = { Kind = "Number", Min = 0.01, Max = 100, Operators = numeric },
		Strain = { Kind = "Number", Min = 0, Max = 100000, Operators = numeric },
		StrainTolerance = { Kind = "Number", Min = 0, Max = 100000, Operators = numeric },
		ComplexityCapacity = { Kind = "Number", Min = 0, Max = 100000, Operators = numeric },
	},
	Environment = {
		ClockTime = { Kind = "Number", Min = 0, Max = 24, Operators = numeric },
		OnGround = { Kind = "Boolean", Operators = boolean },
		Zone = { Kind = "String", MaxLength = 32, Operators = stringComparison },
		ZoneTags = { Kind = "String", MaxLength = 24, Operators = { "Has", "DoesNotHave" } },
	},
	Material = {
		Type = { Kind = "String", MaxLength = 32, Operators = stringComparison },
		AvailableAmount = { Kind = "Number", Min = 0, Max = 100000, Operators = numeric },
	},
	Status = {
		Shield = { Kind = "Number", Min = 0, Max = 100000, Operators = numeric },
		SlowMultiplier = { Kind = "Number", Min = 0, Max = 1, Operators = numeric },
		TimeRate = { Kind = "Number", Min = 0.25, Max = 2, Operators = numeric },
		HasShield = { Kind = "Boolean", Operators = boolean },
		IsSlowed = { Kind = "Boolean", Operators = boolean },
		IsBound = { Kind = "Boolean", Operators = boolean },
		IsRevealed = { Kind = "Boolean", Operators = boolean },
		IsBurning = { Kind = "Boolean", Operators = boolean, Help = "True while a Fire mark is active." },
		IsWet = { Kind = "Boolean", Operators = boolean, Help = "True while a Water mark is active." },
		ElementalMarks = {
			Kind = "String",
			MaxLength = 48,
			Operators = { "Has", "DoesNotHave" },
			Help = "Checks whether the target has an active mark for an element, such as Fire or Ice.",
		},
		MagicArmorBonus = { Kind = "Number", Min = -100, Max = 100, Operators = numeric },
		MagicStrengthBonus = { Kind = "Number", Min = -75, Max = 100, Operators = numeric },
	},
	DistancePosition = {
		Distance = { Kind = "Number", Min = 0, Max = 10000, Operators = numeric },
		VerticalDistance = { Kind = "Number", Min = 0, Max = 10000, Operators = numeric },
	},
	Time = {
		ClockTime = { Kind = "Number", Min = 0, Max = 24, Operators = numeric },
		SinceCast = { Kind = "Number", Min = 0, Max = 60, Operators = numeric },
	},
}

function ConditionSpec.configureSpecialResources(definitions)
	local resourceProperties = ConditionSpec.Properties.Resource
	for property in pairs(registeredSpecialResourceProperties) do
		resourceProperties[property] = nil
	end
	registeredSpecialResourceProperties = {}
	for id, definition in pairs(definitions or {}) do
		local descriptor = { Kind = "Number", Min = 0, Max = definition.Capacity, Operators = numeric }
		if resourceProperties[id] == nil then
			resourceProperties[id] = descriptor
			registeredSpecialResourceProperties[id] = true
		end
		local percentId = id .. "Percent"
		if resourceProperties[percentId] == nil then
			resourceProperties[percentId] = { Kind = "Number", Min = 0, Max = 1, Operators = numeric }
			registeredSpecialResourceProperties[percentId] = true
		end
	end
end

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function denseArrayLength(value, maximum)
	if type(value) ~= "table" then
		return nil
	end
	local count = 0
	for key in pairs(value) do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > maximum then
			return nil
		end
		count = count + 1
	end
	if count ~= #value then
		return nil
	end
	return count
end

local function validateNode(node, depth, budget)
	budget[1] = budget[1] + 1
	if budget[1] > ConditionSpec.MaxNodes or depth > ConditionSpec.MaxDepth then
		return false, "Condition tree exceeds its depth or size limit"
	end
	if type(node) ~= "table" then
		return false, "Condition entry must be a table"
	end
	if node.Operator == "ALL" or node.Operator == "ANY" or node.Operator == "NOT" then
		for key in pairs(node) do
			if key ~= "Operator" and key ~= "Conditions" then
				return false, "Unsupported condition group field"
			end
		end
		local children = node.Conditions
		local childCount = denseArrayLength(children, ConditionSpec.MaxChildren)
		if not childCount or childCount == 0 then
			return false, "Condition groups need 1–8 rules"
		end
		if node.Operator == "NOT" and childCount ~= 1 then
			return false, "NOT groups need exactly one rule"
		end
		for index, child in ipairs(children) do
			if index > ConditionSpec.MaxChildren then
				return false, "Condition group is too large"
			end
			local ok, reason = validateNode(child, depth + 1, budget)
			if not ok then
				return false, reason
			end
		end
		return true
	end

	local descriptor = ConditionSpec.Properties[node.Family] and ConditionSpec.Properties[node.Family][node.Property]
	if not descriptor then
		return false, "Condition property is not exposed by the runtime"
	end
	for key in pairs(node) do
		if key ~= "Family" and key ~= "Property" and key ~= "Operator" and key ~= "Value" then
			return false, "Unsupported condition rule field"
		end
	end
	local operatorFound = false
	for _, operator in ipairs(descriptor.Operators) do
		if operator == node.Operator then
			operatorFound = true
			break
		end
	end
	if type(node.Operator) ~= "string" or not operatorFound then
		return false, "Unsupported comparison for condition property"
	end
	local value = node.Value
	if descriptor.Kind == "Number" then
		if not finite(value) or value < descriptor.Min or value > descriptor.Max then
			return false, "Condition number is outside its supported range"
		end
		if descriptor.Integer and value % 1 ~= 0 then
			return false, "Condition value must be a whole number"
		end
		if node.Operator == "MultipleOf" and value < 1 then
			return false, "MultipleOf needs a whole number of at least 1"
		end
	elseif descriptor.Kind == "Boolean" then
		if type(value) ~= "boolean" then
			return false, "Condition value must be true or false"
		end
	elseif type(value) ~= "string" or #value > descriptor.MaxLength then
		return false, "Condition text value is invalid"
	end
	return true
end

function ConditionSpec.validate(conditions)
	if type(conditions) ~= "table" then
		return false, "Conditions must be a list or a rule group"
	end
	-- Preserve the original V1 checkbox identifiers without changing their meaning.
	if conditions.Operator == nil then
		if #conditions > 5 then
			return false, "Too many legacy conditions"
		end
		return true
	end
	return validateNode(conditions, 1, { 0 })
end

local function usesOnlyFamilies(node, families)
	if node.Operator == "ALL" or node.Operator == "ANY" or node.Operator == "NOT" then
		for _, child in ipairs(node.Conditions) do
			if not usesOnlyFamilies(child, families) then
				return false
			end
		end
		return true
	end
	return families[node.Family] == true
end

function ConditionSpec.validateForFamilies(conditions, families)
	local valid, reason = ConditionSpec.validate(conditions)
	if not valid then
		return false, reason
	end
	if not usesOnlyFamilies(conditions, families) then
		return false, "Condition uses a target-only family in a caster lifetime rule"
	end
	return true
end

local function usesUnavailableStepProperty(node)
	if node.Operator == "ALL" or node.Operator == "ANY" or node.Operator == "NOT" then
		for _, child in ipairs(node.Conditions) do
			if usesUnavailableStepProperty(child) then
				return true
			end
		end
		return false
	end
	local unavailable = ConditionSpec.StepUnavailableProperties[node.Family]
	return unavailable ~= nil and unavailable[node.Property] == true
end

-- A trigger-step condition must be a rule tree (not the legacy list form)
-- built only from values an event context can resolve.
function ConditionSpec.validateStep(conditions)
	if type(conditions) ~= "table" or conditions.Operator == nil then
		return false, "Step conditions must be an ALL, ANY, or NOT rule group"
	end
	local ok, reason = ConditionSpec.validateForFamilies(conditions, ConditionSpec.StepConditionFamilies)
	if not ok then
		return false,
			if reason == "Condition uses a target-only family in a caster lifetime rule"
				then "Step condition uses a value that trigger events cannot check"
				else reason
	end
	if usesUnavailableStepProperty(conditions) then
		return false, "Step condition uses a value that trigger events cannot check"
	end
	return true
end

return ConditionSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">MagicConditionTree</string>
            <string name="Source"><![CDATA[-- Pure helpers for creating and editing the bounded condition tree.
local Tree = {}

local function isGroup(node)
	return type(node) == "table" and (node.Operator == "ALL" or node.Operator == "ANY" or node.Operator == "NOT")
end

Tree.isGroup = isGroup

function Tree.countNodes(node)
	if type(node) ~= "table" then
		return 0
	end
	local count = 1
	if isGroup(node) then
		for _, child in ipairs(node.Conditions or {}) do
			count = count + Tree.countNodes(child)
		end
	end
	return count
end

function Tree.maxDepth(node)
	if not isGroup(node) then
		return 1
	end
	local deepest = 0
	for _, child in ipairs(node.Conditions or {}) do
		deepest = math.max(deepest, Tree.maxDepth(child))
	end
	return 1 + deepest
end

function Tree.newRule()
	return { Family = "Caster", Property = "IsAlive", Operator = "Is", Value = true }
end

function Tree.newGroup(operator)
	if operator ~= "ALL" and operator ~= "ANY" then
		return nil, "Condition groups must use ALL or ANY"
	end
	return { Operator = operator, Conditions = { Tree.newRule() } }
end

function Tree.addRule(group, maxChildren, maxNodes, treeRoot)
	if not isGroup(group) or group.Operator == "NOT" then
		return false, "Rules can only be added to an ALL or ANY group"
	end
	if #(group.Conditions or {}) >= maxChildren then
		return false, "Condition group has reached its child limit"
	end
	if Tree.countNodes(treeRoot or group) + 1 > maxNodes then
		return false, "Condition tree has reached its node limit"
	end
	table.insert(group.Conditions, Tree.newRule())
	return true
end

function Tree.addGroup(group, operator, maxChildren, maxNodes, treeRoot)
	if not isGroup(group) or group.Operator == "NOT" then
		return false, "Groups can only be added to an ALL or ANY group"
	end
	if #(group.Conditions or {}) >= maxChildren then
		return false, "Condition group has reached its child limit"
	end
	local nested = Tree.newGroup(operator)
	if not nested then
		return false, "Condition groups must use ALL or ANY"
	end
	if Tree.countNodes(treeRoot or group) + Tree.countNodes(nested) > maxNodes then
		return false, "Condition tree has reached its node limit"
	end
	table.insert(group.Conditions, nested)
	return true
end

function Tree.wrapNot(node)
	if type(node) ~= "table" or isGroup(node) and node.Operator == "NOT" then
		return nil, "Only a non-negated condition can be wrapped in NOT"
	end
	return { Operator = "NOT", Conditions = { node } }
end

function Tree.unwrapNot(node)
	if not isGroup(node) or node.Operator ~= "NOT" or type(node.Conditions) ~= "table" then
		return nil, "Condition is not a NOT group"
	end
	return node.Conditions[1]
end

function Tree.replace(root, parent, index, replacement)
	if parent then
		if not isGroup(parent) or type(index) ~= "number" then
			return false
		end
		if parent.Operator == "NOT" and index ~= 1 then
			return false
		end
		parent.Conditions[index] = replacement
	else
		root = replacement
	end
	return true, root
end

function Tree.remove(parent, index)
	if not isGroup(parent) or parent.Operator == "NOT" or type(index) ~= "number" then
		return false
	end
	if #(parent.Conditions or {}) <= 1 then
		return false, "Condition groups must keep at least one child"
	end
	table.remove(parent.Conditions, index)
	return true
end

return Tree
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">MagicConstructGeometrySpec</string>
            <string name="Source"><![CDATA[-- Shared Construct primitive and bounded composition registry. Geometry is
-- server-authored from these descriptors; clients can choose only a registry key.
local Spec = {}

Spec.Order = { "Box", "Sphere", "Cylinder", "Wedge", "Arch", "Pillar", "Stairs", "Bridge", "Custom" }
Spec.PrimitiveOrder = { "Block", "Ball", "Cylinder", "Wedge" }
Spec.MaxCustomComponents = 5
Spec.MaxComponentLifetime = 15
Spec.DefaultCustomComponent = {
	Shape = "Block",
	SizeX = 0.7,
	SizeY = 0.7,
	SizeZ = 0.7,
	OffsetX = 0,
	OffsetY = 0,
	OffsetZ = 0,
	RotationX = 0,
	RotationY = 0,
	RotationZ = 0,
	Duration = nil,
}

local function piece(shape, sizeScale, offsetScale, rotationDegrees)
	return {
		Shape = shape,
		SizeScale = sizeScale,
		OffsetScale = offsetScale,
		RotationDegrees = rotationDegrees or { 0, 0, 0 },
	}
end

Spec.Definitions = {
	Box = {
		Parts = { piece("Block", { 1, 1, 1 }, { 0, 0, 0 }) },
	},
	Sphere = {
		Parts = { piece("Ball", { 1, 1, 1 }, { 0, 0, 0 }) },
	},
	Cylinder = {
		Parts = { piece("Cylinder", { 1, 1, 1 }, { 0, 0, 0 }, { 0, 0, 90 }) },
	},
	Wedge = {
		Parts = { piece("Wedge", { 1, 1, 1 }, { 0, 0, 0 }) },
	},
	Arch = {
		Parts = {
			piece("Block", { 0.18, 0.82, 1 }, { -0.41, -0.09, 0 }),
			piece("Block", { 0.18, 0.82, 1 }, { 0.41, -0.09, 0 }),
			piece("Block", { 0.82, 0.18, 1 }, { 0, 0.41, 0 }),
		},
	},
	Pillar = {
		Parts = {
			piece("Block", { 0.82, 0.14, 0.82 }, { 0, -0.43, 0 }),
			piece("Block", { 0.62, 0.72, 0.62 }, { 0, 0, 0 }),
			piece("Block", { 0.92, 0.14, 0.92 }, { 0, 0.43, 0 }),
		},
	},
	Stairs = {
		Parts = {},
	},
	Bridge = {
		Parts = {
			piece("Block", { 1, 0.16, 1 }, { 0, -0.34, 0 }),
			piece("Block", { 0.12, 0.18, 1 }, { -0.44, -0.17, 0 }),
			piece("Block", { 0.12, 0.18, 1 }, { 0.44, -0.17, 0 }),
			piece("Block", { 1, 0.14, 0.1 }, { 0, 0.14, -0.45 }),
			piece("Block", { 1, 0.14, 0.1 }, { 0, 0.14, 0.45 }),
		},
	},
	Custom = { Parts = {}, IsCustom = true },
}

for index = 1, 5 do
	local stepCount = 5
	local height = index / stepCount
	table.insert(
		Spec.Definitions.Stairs.Parts,
		piece("Block", { 1, height, 1 / stepCount }, { 0, -0.5 + height / 2, -0.5 + (index - 0.5) / stepCount })
	)
end

function Spec.get(name)
	return Spec.Definitions[name]
end

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function denseCustomArray(components)
	if type(components) ~= "table" or #components < 1 or #components > Spec.MaxCustomComponents then
		return false
	end
	local count = 0
	for key in pairs(components) do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > Spec.MaxCustomComponents then
			return false
		end
		count = count + 1
	end
	return count == #components
end

local function rotatedExtents(size, rotationDegrees)
	local x, y, z = math.rad(rotationDegrees[1]), math.rad(rotationDegrees[2]), math.rad(rotationDegrees[3])
	local sx, cx, sy, cy, sz, cz = math.sin(x), math.cos(x), math.sin(y), math.cos(y), math.sin(z), math.cos(z)
	local matrix = {
		{ cy * cz, -cy * sz, sy },
		{ cx * sz + sx * sy * cz, cx * cz - sx * sy * sz, -sx * cy },
		{ sx * sz - cx * sy * cz, sx * cz + cx * sy * sz, cx * cy },
	}
	return {
		math.abs(matrix[1][1]) * size[1] / 2
			+ math.abs(matrix[1][2]) * size[2] / 2
			+ math.abs(matrix[1][3]) * size[3] / 2,
		math.abs(matrix[2][1]) * size[1] / 2
			+ math.abs(matrix[2][2]) * size[2] / 2
			+ math.abs(matrix[2][3]) * size[3] / 2,
		math.abs(matrix[3][1]) * size[1] / 2
			+ math.abs(matrix[3][2]) * size[2] / 2
			+ math.abs(matrix[3][3]) * size[3] / 2,
	}
end

local function customComponents(components, width, height, depth)
	if not denseCustomArray(components) then
		return nil
	end
	local envelope = { width, height, depth }
	local result = {}
	local allowed = {
		Shape = true,
		SizeX = true,
		SizeY = true,
		SizeZ = true,
		OffsetX = true,
		OffsetY = true,
		OffsetZ = true,
		RotationX = true,
		RotationY = true,
		RotationZ = true,
		Duration = true,
	}
	for _, component in ipairs(components) do
		if type(component) ~= "table" then
			return nil
		end
		for key in pairs(component) do
			if not allowed[key] then
				return nil
			end
		end
		local validShape = false
		for _, shape in ipairs(Spec.PrimitiveOrder) do
			if shape == component.Shape then
				validShape = true
				break
			end
		end
		if not validShape then
			return nil
		end
		local normalizedSize = { component.SizeX, component.SizeY, component.SizeZ }
		local normalizedOffset = { component.OffsetX, component.OffsetY, component.OffsetZ }
		local rotation = { component.RotationX, component.RotationY, component.RotationZ }
		for axis = 1, 3 do
			if not finite(normalizedSize[axis]) or normalizedSize[axis] < 0.05 or normalizedSize[axis] > 1 then
				return nil
			end
			if not finite(normalizedOffset[axis]) or math.abs(normalizedOffset[axis]) > 0.5 then
				return nil
			end
			if not finite(rotation[axis]) or math.abs(rotation[axis]) > 180 then
				return nil
			end
		end
		if
			component.Duration ~= nil
			and (
				not finite(component.Duration)
				or component.Duration < 0.1
				or component.Duration > Spec.MaxComponentLifetime
			)
		then
			return nil
		end
		local size = {
			envelope[1] * normalizedSize[1],
			envelope[2] * normalizedSize[2],
			envelope[3] * normalizedSize[3],
		}
		local offset = {
			envelope[1] * normalizedOffset[1],
			envelope[2] * normalizedOffset[2],
			envelope[3] * normalizedOffset[3],
		}
		local extents = rotatedExtents(size, rotation)
		for axis = 1, 3 do
			if math.abs(offset[axis]) + extents[axis] > envelope[axis] / 2 + 0.001 then
				return nil
			end
		end
		table.insert(result, {
			Shape = component.Shape,
			Size = size,
			Offset = offset,
			RotationDegrees = rotation,
			Duration = component.Duration,
		})
	end
	return result
end

function Spec.components(name, width, height, depth, customParts)
	if name == "Custom" then
		return customComponents(customParts, width, height, depth)
	end
	local definition = Spec.Definitions[name]
	if not definition then
		return nil
	end
	local result = {}
	for _, descriptor in ipairs(definition.Parts) do
		local sizeX = width * descriptor.SizeScale[1]
		local sizeY = height * descriptor.SizeScale[2]
		if descriptor.Shape == "Cylinder" then
			sizeX, sizeY = sizeY, sizeX
		end
		table.insert(result, {
			Shape = descriptor.Shape,
			Size = {
				sizeX,
				sizeY,
				depth * descriptor.SizeScale[3],
			},
			Offset = {
				width * descriptor.OffsetScale[1],
				height * descriptor.OffsetScale[2],
				depth * descriptor.OffsetScale[3],
			},
			RotationDegrees = descriptor.RotationDegrees,
		})
	end
	return result
end

function Spec.dimensions(name, width, height, depth)
	local components = Spec.components(name, width, height, depth)
	local first = components and components[1]
	if not first then
		return width, height, depth
	end
	return first.Size[1], first.Size[2], first.Size[3]
end

function Spec.rotationDegrees(name)
	local definition = Spec.Definitions[name]
	local first = definition and definition.Parts[1]
	local rotation = first and first.RotationDegrees or { 0, 0, 0 }
	return rotation[1], rotation[2], rotation[3]
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">MagicConstructGrowthSpec</string>
            <string name="Source"><![CDATA[-- Shared pure-data bounds for time-scaled Construct geometry.
local Spec = {}

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function bounded(value, minimum, maximum)
	return finite(value) and value >= minimum and value <= maximum
end

function Spec.validate(construct)
	if type(construct) ~= "table" then
		return false, "Invalid Construct"
	end
	local hasGrowth = (construct.GrowthStartScale ~= nil and construct.GrowthStartScale ~= 0)
		or (construct.GrowthEndScale ~= nil and construct.GrowthEndScale ~= 0)
		or (construct.GrowthDuration ~= nil and construct.GrowthDuration ~= 0)
	if not hasGrowth then
		return true
	end
	if
		not bounded(construct.GrowthStartScale, 0.1, 2)
		or not bounded(construct.GrowthEndScale, 0.1, 2)
		or not bounded(construct.GrowthDuration, 0.1, 30)
	then
		return false, "Construct expansion requires bounded start/end/time values"
	end
	local maximumScale = math.max(construct.GrowthStartScale, construct.GrowthEndScale)
	if
		construct.Width * maximumScale > 20
		or construct.Height * maximumScale > 20
		or construct.Depth * maximumScale > 20
		or construct.Width * construct.Height * construct.Depth * maximumScale ^ 3 > 2000
	then
		return false, "Expanded Construct dimensions exceed the configured size or volume"
	end
	return true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">MagicControlMassSpec</string>
            <string name="Source"><![CDATA[-- Pure mass gate shared by the server executor and validation tests.
local Spec = {}

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Spec.allows(controlledMass, authoredMaximum)
	return finite(controlledMass)
		and controlledMass > 0
		and finite(authoredMaximum)
		and authoredMaximum > 0
		and controlledMass <= authoredMaximum
end

function Spec.adjust(totals, caster, spellId, delta)
	if type(totals) ~= "table" or caster == nil or type(spellId) ~= "string" or not finite(delta) then
		return 0
	end
	local bySpell = totals[caster]
	if not bySpell then
		bySpell = {}
		totals[caster] = bySpell
	end
	local total = math.max(0, (bySpell[spellId] or 0) + delta)
	if total <= 1e-6 then
		bySpell[spellId] = nil
		if next(bySpell) == nil then
			totals[caster] = nil
		end
		return 0
	end
	bySpell[spellId] = total
	return total
end

function Spec.total(totals, caster, spellId)
	local total = totals[caster] and totals[caster][spellId]
	if finite(total) and total > 0 then
		return total
	end
	return 0
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">MagicDamageRules</string>
            <string name="Source"><![CDATA[-- Shared outgoing strength and incoming Elemental, Physical, and Soul damage
-- math. Combat attributes remain server-owned.
local Rules = {}

Rules.Elements = { "Neutral", "Fire", "Ice", "Lightning", "Earth", "Water", "Wind", "Poison" }
Rules.KnownElements = {}
for _, element in ipairs(Rules.Elements) do
	Rules.KnownElements[element] = true
end
Rules.ExpressionElements = { Fire = "Fire", Earth = "Earth", Water = "Water", Lightning = "Lightning" }

function Rules.defaultElementForExpression(expression)
	return Rules.ExpressionElements[expression] or "Neutral"
end

function Rules.mitigate(amount, resistance, armor)
	local safeAmount = 0
	if type(amount) == "number" and amount == amount then
		safeAmount = math.max(0, amount)
	end
	local safeResistance = 0
	if type(resistance) == "number" and resistance == resistance then
		safeResistance = math.max(0, math.min(1, resistance))
	end
	local afterResistance = safeAmount * (1 - safeResistance)
	local safeArmor = 0
	if type(armor) == "number" and armor == armor then
		safeArmor = math.max(0, math.min(100, armor))
	end
	return math.max(0, afterResistance - safeArmor)
end

function Rules.resistance(target, element)
	if not target or not Rules.KnownElements[element] or element == "Neutral" then
		return 0
	end
	local value = target:GetAttribute("MagicResistance" .. element)
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.max(0, math.min(1, value))
end

function Rules.armor(target)
	if not target then
		return 0
	end
	local base = target:GetAttribute("MagicArmor")
	local modifier = target:GetAttribute("MagicArmorBonus")
	if type(base) ~= "number" or base ~= base then
		base = 0
	end
	if type(modifier) ~= "number" or modifier ~= modifier then
		modifier = 0
	end
	return math.max(0, math.min(100, base + modifier))
end

function Rules.soulResistance(target)
	if not target then
		return 0
	end
	local value = target:GetAttribute("SoulResistance")
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.max(0, math.min(1, value))
end

function Rules.soulArmor(target)
	if not target then
		return 0
	end
	local value = target:GetAttribute("SoulArmor")
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.max(0, math.min(100, value))
end

function Rules.physicalResistance(target)
	if not target then
		return 0
	end
	local value = target:GetAttribute("PhysicalResistance")
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.max(0, math.min(1, value))
end

function Rules.physicalArmor(target)
	if not target then
		return 0
	end
	local value = target:GetAttribute("PhysicalArmor")
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.max(0, math.min(100, value))
end

function Rules.applyChannel(amount, target, channel, element)
	if channel == "Soul" then
		return Rules.mitigate(amount, Rules.soulResistance(target), Rules.soulArmor(target))
	elseif channel == "Physical" then
		return Rules.mitigate(amount, Rules.physicalResistance(target), Rules.physicalArmor(target))
	end
	return Rules.mitigate(amount, Rules.resistance(target, element), Rules.armor(target))
end

function Rules.applyOutgoingStrength(amount, strengthBonus)
	local safeAmount = 0
	if type(amount) == "number" and amount == amount then
		safeAmount = math.max(0, amount)
	end
	local safeBonus = 0
	if type(strengthBonus) == "number" and strengthBonus == strengthBonus then
		safeBonus = math.max(-75, math.min(100, strengthBonus))
	end
	local multiplier = 1 + safeBonus / 100
	return safeAmount * math.max(0.25, math.min(2, multiplier))
end

return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">MagicElementalInteractionSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Data-driven effects that are applied when an elemental mark is added.
local MagicLab = require(script.Parent.Parent.Configuration.MagicLab)
local Spec = {}

function Spec.effectsFor(element, markDuration)
	local configured = MagicLab.ElementalInteractions[element]
	if not configured then
		return {}
	end
	local effects = {}
	for _, configuredEffect in ipairs(configured) do
		local effect = {}
		for key, value in pairs(configuredEffect) do
			effect[key] = value
		end
		if effect.Duration == "Mark" then
			effect.Duration = markDuration
		end
		table.insert(effects, effect)
	end
	return effects
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">MagicElementalMarkSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Pure helpers for bounded, timed elemental marks stored by the server status service.
local Spec = {}

local function isActive(mark, element, now)
	return mark.Kind == "ElementalMark"
		and mark.Element == element
		and type(mark.Stacks) == "number"
		and mark.Stacks > 0
		and type(mark.Remaining) == "number"
		and mark.Remaining > 0
		and type(mark.ExpiresAt) == "number"
		and mark.ExpiresAt > now
end

function Spec.stackCount(effects, element, now)
	local total = 0
	for _, effect in ipairs(effects) do
		if isActive(effect, element, now) then
			total = total + effect.Stacks
		end
	end
	return total
end

function Spec.apply(effects, candidate, maximumStacks, now, maximumEffects)
	local currentStacks = Spec.stackCount(effects, candidate.Element, now)
	local existing
	for _, effect in ipairs(effects) do
		if
			isActive(effect, candidate.Element, now)
			and effect.Caster == candidate.Caster
			and effect.SpellId == candidate.SpellId
		then
			existing = effect
			break
		end
	end
	if existing then
		existing.Stacks = existing.Stacks + math.min(candidate.Stacks, math.max(0, maximumStacks - currentStacks))
		existing.ExpiresAt = candidate.ExpiresAt
		existing.Remaining = candidate.Remaining
		existing.LastUpdateAt = candidate.LastUpdateAt
		return true
	end
	if currentStacks >= maximumStacks or #effects >= maximumEffects then
		return false
	end
	candidate.Stacks = math.min(candidate.Stacks, maximumStacks - currentStacks)
	table.insert(effects, candidate)
	return true
end

function Spec.encode(effects, now)
	local elements = {}
	for _, effect in ipairs(effects) do
		if isActive(effect, effect.Element, now) then
			elements[string.lower(effect.Element)] = true
		end
	end
	local sorted = {}
	for element in pairs(elements) do
		table.insert(sorted, element)
	end
	table.sort(sorted)
	if #sorted > 0 then
		return "|" .. table.concat(sorted, "|") .. "|"
	end
	return "||"
end

function Spec.hasEncoded(encoded, element)
	if type(encoded) ~= "string" or type(element) ~= "string" then
		return false
	end
	return string.find(encoded, "|" .. string.lower(element) .. "|", 1, true) ~= nil
end

function Spec.consume(effects, element, amount, now)
	local matching = {}
	for index, effect in ipairs(effects) do
		if isActive(effect, element, now) then
			table.insert(matching, { Index = index, Effect = effect })
		end
	end
	table.sort(matching, function(a, b)
		if a.Effect.ExpiresAt == b.Effect.ExpiresAt then
			return a.Index > b.Index
		end
		return a.Effect.ExpiresAt < b.Effect.ExpiresAt
	end)
	local remaining = amount
	for _, entry in ipairs(matching) do
		if remaining <= 0 then
			break
		end
		local take = math.min(entry.Effect.Stacks, remaining)
		entry.Effect.Stacks = entry.Effect.Stacks - take
		remaining = remaining - take
	end
	for index = #effects, 1, -1 do
		local effect = effects[index]
		if effect.Kind == "ElementalMark" and (effect.Stacks or 0) <= 0 then
			table.remove(effects, index)
		end
	end
	return amount - remaining
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">MagicEnvironmentRequirementSpec</string>
            <string name="Source"><![CDATA[-- Optional cast-time requirements based on server-resolved environment state.
local ZoneSpec = require(script.Parent.MagicEnvironmentZoneSpec)

local Spec = {}
local MAX_TAGS = ZoneSpec.MaxTags
Spec.MaxTags = MAX_TAGS
Spec.MaxTagLength = ZoneSpec.MaxTagLength

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function validTagList(tags)
	if tags == nil then
		return true
	end
	if type(tags) ~= "table" then
		return false
	end
	local count = 0
	local seen = {}
	for key, tag in pairs(tags) do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or type(tag) ~= "string" then
			return false
		end
		local canonical = string.lower(tag)
		if
			#canonical == 0
			or #canonical > ZoneSpec.MaxTagLength
			or string.find(canonical, "[^%w_%-]")
			or seen[canonical]
		then
			return false
		end
		seen[canonical] = true
		count = count + 1
		if count > MAX_TAGS then
			return false
		end
	end
	return count == #tags
end

function Spec.validate(requirements)
	if requirements == nil then
		return true
	end
	if type(requirements) ~= "table" then
		return false, "Environment requirements must be a table"
	end
	for key in pairs(requirements) do
		if key ~= "RequireGrounded" and key ~= "ClockTime" and key ~= "ZoneTags" then
			return false, "Unsupported environment requirement: " .. tostring(key)
		end
	end
	if requirements.RequireGrounded ~= nil and type(requirements.RequireGrounded) ~= "boolean" then
		return false, "Grounded requirement must be a boolean"
	end
	if requirements.ClockTime ~= nil then
		local window = requirements.ClockTime
		if type(window) ~= "table" then
			return false, "Clock-time requirement must be a window"
		end
		for key in pairs(window) do
			if key ~= "Start" and key ~= "End" then
				return false, "Unsupported clock-time window field"
			end
		end
		if
			not finite(window.Start)
			or not finite(window.End)
			or window.Start < 0
			or window.Start > 24
			or window.End < 0
			or window.End > 24
		then
			return false, "Clock-time window must be between 0 and 24"
		end
	end
	if requirements.ZoneTags ~= nil then
		local zoneTags = requirements.ZoneTags
		if type(zoneTags) ~= "table" then
			return false, "Zone-tag requirement must be a table"
		end
		for key in pairs(zoneTags) do
			if key ~= "Required" and key ~= "Forbidden" then
				return false, "Unsupported zone-tag requirement field"
			end
		end
		if not validTagList(zoneTags.Required) or not validTagList(zoneTags.Forbidden) then
			return false, "Zone tags must be unique canonical tags"
		end
		local required = {}
		for _, tag in ipairs(zoneTags.Required or {}) do
			required[string.lower(tag)] = true
		end
		for _, tag in ipairs(zoneTags.Forbidden or {}) do
			if required[string.lower(tag)] then
				return false, "A zone tag cannot be both required and forbidden"
			end
		end
	end
	return true
end

local function inWindow(time, window)
	local startTime = window.Start
	local endTime = window.End
	if startTime == endTime then
		return time == startTime
	elseif startTime < endTime then
		return time >= startTime and time <= endTime
	end
	return time >= startTime or time <= endTime
end

function Spec.check(requirements, environment)
	local valid, reason = Spec.validate(requirements)
	if not valid then
		return false, reason
	end
	if not requirements then
		return true
	end
	if type(environment) ~= "table" then
		return false, "Environment state unavailable"
	end
	if requirements.RequireGrounded and environment.OnGround ~= true then
		return false, "This spell requires solid ground beneath the caster"
	end
	if requirements.ClockTime then
		if not finite(environment.ClockTime) or not inWindow(environment.ClockTime, requirements.ClockTime) then
			return false,
				string.format(
					"This spell can only be cast between %g:00 and %g:00",
					requirements.ClockTime.Start,
					requirements.ClockTime.End
				)
		end
	end
	local zoneTags = requirements.ZoneTags
	if zoneTags then
		local encoded = environment.ZoneTags or "||"
		for _, tag in ipairs(zoneTags.Required or {}) do
			if not ZoneSpec.hasTag(encoded, tag) then
				return false, "This spell requires the " .. tag .. " environment"
			end
		end
		for _, tag in ipairs(zoneTags.Forbidden or {}) do
			if ZoneSpec.hasTag(encoded, tag) then
				return false, "This spell cannot be cast in the " .. tag .. " environment"
			end
		end
	end
	return true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">MagicEnvironmentZoneSpec</string>
            <string name="Source"><![CDATA[-- Whitelisted metadata helpers for author-authored magic environment volumes.
local Spec = {}

Spec.MaxTags = 8
Spec.MaxTagLength = 24

function Spec.encodeTags(value)
	if type(value) ~= "string" then
		return "||"
	end
	local tags = {}
	local seen = {}
	for token in string.gmatch(value, "[^,;|%s]+") do
		local tag = string.lower(token)
		if #tag <= Spec.MaxTagLength and not seen[tag] and not string.find(tag, "[^%w_%-]") then
			seen[tag] = true
			table.insert(tags, tag)
			if #tags >= Spec.MaxTags then
				break
			end
		end
	end
	if #tags == 0 then
		return "||"
	end
	return "|" .. table.concat(tags, "|") .. "|"
end

function Spec.hasTag(encoded, expected)
	if type(encoded) ~= "string" or type(expected) ~= "string" then
		return false
	end
	local tag = string.lower(expected)
	if #tag == 0 or #tag > Spec.MaxTagLength or string.find(tag, "[^%w_%-]") then
		return false
	end
	return string.find(encoded, "|" .. tag .. "|", 1, true) ~= nil
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">MagicGeometry</string>
            <string name="Source"><![CDATA[--!strict
-- Support distance of an oriented box along a surface normal.
local Geometry = {}
function Geometry.surfaceOffset(normal, right, up, forward, size)
	return math.abs(normal:Dot(right)) * size.X / 2
		+ math.abs(normal:Dot(up)) * size.Y / 2
		+ math.abs(normal:Dot(forward)) * size.Z / 2
end

function Geometry.withinCone(direction, offset, minimumDot)
	if offset.Magnitude < 0.0001 then
		return true
	end
	return direction:Dot(offset.Unit) >= minimumDot
end

function Geometry.areaSize(shape, area)
	if shape == "Sphere" then
		return Vector3.new(area.Radius * 2, area.Radius * 2, area.Radius * 2)
	elseif shape == "Capsule" then
		return Vector3.new(area.Radius * 2, area.Height, area.Radius * 2)
	elseif shape == "Cylinder" then
		return Vector3.new(area.Radius * 2, area.Height, area.Radius * 2)
	elseif shape == "Ring" then
		return Vector3.new(area.OuterRadius * 2, area.Height, area.OuterRadius * 2)
	elseif shape == "Cone" then
		local width = 2 * area.Range * math.tan(math.rad(area.Angle / 2))
		return Vector3.new(width, area.Height, area.Range)
	elseif shape == "Plane" then
		return Vector3.new(area.Width, area.Height, area.Thickness)
	elseif shape == "Line" then
		return Vector3.new(area.Width, area.Height, area.Range)
	end
	return Vector3.new(area.Width, area.Height, area.Depth)
end

function Geometry.areaQueryFrame(shape, frame, area)
	if shape == "Cone" or shape == "Line" then
		return frame * CFrame.new(0, 0, -area.Range / 2)
	end
	return frame
end

function Geometry.containsArea(shape, frame, worldPoint, area)
	local point = frame:PointToObjectSpace(worldPoint)
	if shape == "Sphere" then
		return point.X * point.X + point.Y * point.Y + point.Z * point.Z <= area.Radius * area.Radius
	elseif shape == "Capsule" then
		local halfSegment = math.max(area.Height / 2 - area.Radius, 0)
		local nearestY = math.max(-halfSegment, math.min(halfSegment, point.Y))
		local offsetY = point.Y - nearestY
		return point.X * point.X + offsetY * offsetY + point.Z * point.Z <= area.Radius * area.Radius
	elseif shape == "Cylinder" then
		return point.X * point.X + point.Z * point.Z <= area.Radius * area.Radius
			and math.abs(point.Y) <= area.Height / 2
	elseif shape == "Ring" then
		local radiusSquared = point.X * point.X + point.Z * point.Z
		return radiusSquared >= area.InnerRadius * area.InnerRadius
			and radiusSquared <= area.OuterRadius * area.OuterRadius
			and math.abs(point.Y) <= area.Height / 2
	elseif shape == "Cone" then
		local depth = -point.Z
		return depth >= 0
			and depth <= area.Range
			and math.abs(point.Y) <= area.Height / 2
			and math.abs(point.X) <= depth * math.tan(math.rad(area.Angle / 2))
	elseif shape == "Plane" then
		return math.abs(point.X) <= area.Width / 2
			and math.abs(point.Y) <= area.Height / 2
			and math.abs(point.Z) <= area.Thickness / 2
	elseif shape == "Line" then
		return math.abs(point.X) <= area.Width / 2
			and math.abs(point.Y) <= area.Height / 2
			and point.Z <= 0
			and point.Z >= -area.Range
	end
	return math.abs(point.X) <= area.Width / 2
		and math.abs(point.Y) <= area.Height / 2
		and math.abs(point.Z) <= area.Depth / 2
end

return Geometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">MagicLabCost</string>
            <string name="Source"><![CDATA[--!strict
-- Estimates include display-only upkeep, which belongs to Casting, not saved Cost.
-- Keep the established Cost schema and any authored special-resource costs.
local Cost = {}
function Cost.normalize(definition)
	if type(definition.Cost) == "table" then
		definition.Cost.ManaUpkeepPerSecond = nil
		definition.Cost.StrainPerSecond = nil
	end
end
function Cost.refresh(definition, estimate, clone)
	local special = definition.Cost and definition.Cost.SpecialResources
	local values = estimate(definition)
	definition.Cost = {
		ManaDemand = values.ManaDemand,
		Strain = values.Strain,
		Complexity = values.Complexity,
		SpecialResources = clone(special or {}),
	}
end
return Cost
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">MagicLibraryProfile</string>
            <string name="Source"><![CDATA[--!strict
-- Small versioned codec for the development Magic Lab slot library.
local Profile = { Version = 1 }

local function copy(value, clone)
	return clone(value)
end

function Profile.decode(raw, slotCount, slotId, validate, clone, hydrate)
	local definitions = {}
	if raw == nil then
		return definitions, true, nil
	end
	if type(raw) ~= "table" or raw.Version ~= Profile.Version or type(raw.Slots) ~= "table" then
		return definitions, false, "Saved spell library has an unsupported or invalid format"
	end
	for key in pairs(raw) do
		if key ~= "Version" and key ~= "Slots" then
			return definitions, false, "Saved spell library contains unknown data; it was left untouched"
		end
	end
	for key, value in pairs(raw.Slots) do
		local slot = tonumber(key)
		if not slot or slot % 1 ~= 0 or slot < 1 or slot > slotCount or tostring(slot) ~= tostring(key) then
			return definitions, false, "Saved spell library contains an invalid slot; it was left untouched"
		end
		if type(value) ~= "table" then
			return definitions, false, "Saved spell library contains an invalid spell; it was left untouched"
		end
		local definition = copy(value, clone)
		if hydrate then
			definition = hydrate(definition, slot, slotId(slot))
		end
		local ok = validate(definition)
		if not ok then
			return {}, false, "A saved spell no longer passes validation; the profile was left untouched"
		end
		definitions[slot] = definition
	end
	return definitions, true, nil
end

function Profile.encode(definitions, slotCount, slotId, validate, clone, dehydrate)
	local slots = {}
	for slot = 1, slotCount do
		local value = definitions[slot]
		if value ~= nil then
			if type(value) ~= "table" then
				return nil, "Cannot save an invalid spell slot"
			end
			local definition = copy(value, clone)
			if dehydrate then
				definition = dehydrate(definition, slot, slotId(slot))
			end
			local ok = validate(definition)
			if not ok then
				return nil, "Cannot save a spell that no longer passes validation"
			end
			slots[tostring(slot)] = definition
		end
	end
	return { Version = Profile.Version, Slots = slots }, nil
end

return Profile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">MagicLifetimeConditionSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Defines the keep-alive meaning of condition-driven effect lifetimes.
local Spec = {}

function Spec.allowsStart(mode, conditionResult)
	return mode ~= "UntilConditionFails" or conditionResult == true
end

function Spec.shouldEnd(mode, conditionResult)
	if mode == "UntilConditionFails" then
		return conditionResult ~= true
	end
	return conditionResult == true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">MagicLifetimeSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Data-only lifetime compatibility shared by SpellSpec and the Magic Lab UI.
local Spec = {}

Spec.ModesByForm = {
	Projectile = { FixedDuration = true, UntilTargetLost = true, UntilConditionFails = true },
	Beam = { Instantaneous = true, FixedDuration = true, UntilConditionFails = true },
	Wave = { Instantaneous = true, FixedDuration = true, UntilConditionFails = true },
	Field = {
		FixedDuration = true,
		UntilDestroyed = true,
		UntilTargetLost = true,
		UntilToggledOff = true,
		UntilResourceDepleted = true,
		UntilConditionFails = true,
	},
	Aura = {
		FixedDuration = true,
		UntilDestroyed = true,
		UntilToggledOff = true,
		UntilTargetLost = true,
		UntilResourceDepleted = true,
		UntilConditionFails = true,
	},
	SelfEnhancement = {
		FixedDuration = true,
		UntilToggledOff = true,
		UntilResourceDepleted = true,
		UntilConditionFails = true,
	},
	Construct = {
		FixedDuration = true,
		Persistent = true,
		UntilDestroyed = true,
		UntilToggledOff = true,
		UntilTargetLost = true,
		UntilResourceDepleted = true,
		UntilConditionFails = true,
	},
	Manipulation = { Instantaneous = true },
}

function Spec.supports(form, mode)
	local modes = Spec.ModesByForm[form]
	return modes ~= nil and modes[mode] == true
end

function Spec.supportsTargeting(form, mode, targeting, followsTarget, maintainsTarget)
	if not Spec.supports(form, mode) then
		return false
	end
	if mode ~= "UntilTargetLost" then
		return true
	end
	if form == "Field" then
		return (targeting == "EntityTarget" or targeting == "ObjectTarget") and followsTarget == true
	elseif form == "Projectile" then
		return targeting == "EntityTarget" and maintainsTarget == true
	end
	return targeting == "EntityTarget" or targeting == "ObjectTarget"
end

function Spec.targetLost(mode, targetIsAlive)
	return mode == "UntilTargetLost" and targetIsAlive ~= true
end

function Spec.claimExpiry(state)
	if type(state) ~= "table" or state.ExpireEventFired == true then
		return false
	end
	state.ExpireEventFired = true
	return true
end

function Spec.effectiveDuration(mode, duration)
	if mode == "UntilConditionFails" then
		return duration or math.huge
	end
	if
		mode == "UntilToggledOff"
		or mode == "Persistent"
		or mode == "UntilDestroyed"
		or mode == "UntilTargetLost"
		or mode == "UntilResourceDepleted"
	then
		return math.huge
	end
	return duration
end

function Spec.validConditionDuration(form, duration, maximum)
	if form == "Projectile" and duration == nil then
		return false
	end
	return duration == nil
		or (type(duration) == "number" and duration == duration and duration >= 0.1 and duration <= maximum)
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">MagicLoadBudget</string>
            <string name="Source"><![CDATA[--!strict
-- Cost-weighted server budget for active magic, layered on the per-player and
-- global count caps. A complex spell costs more of the shared budget than a
-- simple one, and the budget shrinks when the server frame time is slow, so a
-- crowded server degrades by refusing *new* casts instead of dropping frames.
local Budget = {}

Budget.MaxLoad = 120 -- ≈ 64 active spells of average complexity
Budget.ComplexityScale = 10 -- weight = 1 + complexity / scale
Budget.MaxComplexity = 40
Budget.HealthyFrameMs = 25 -- below this, the full budget is available
Budget.CriticalFrameMs = 50 -- at or above this, only MinShare of the budget is available
Budget.MinShare = 0.5
Budget.FrameSmoothing = 0.1 -- EMA factor per heartbeat

function Budget.weight(definition: any): number
	local cost = type(definition) == "table" and type(definition.Cost) == "table" and definition.Cost.Complexity
	local complexity = if type(cost) == "number" and cost == cost then math.clamp(cost, 0, Budget.MaxComplexity) else 0
	return 1 + complexity / Budget.ComplexityScale
end

-- Budget available at the given smoothed server frame time.
function Budget.allowed(frameMs: number): number
	if frameMs ~= frameMs or frameMs <= Budget.HealthyFrameMs then
		return Budget.MaxLoad
	end
	local t = math.clamp((frameMs - Budget.HealthyFrameMs) / (Budget.CriticalFrameMs - Budget.HealthyFrameMs), 0, 1)
	return Budget.MaxLoad * (1 - (1 - Budget.MinShare) * t)
end

function Budget.canAdd(currentLoad: number, weight: number, frameMs: number): boolean
	return currentLoad + weight <= Budget.allowed(frameMs)
end

function Budget.smooth(previousMs: number, deltaSeconds: number): number
	local sample = math.clamp(deltaSeconds * 1000, 0, 1000)
	return previousMs + (sample - previousMs) * Budget.FrameSmoothing
end

return Budget
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">MagicLocusModel</string>
            <string name="Source"><![CDATA[--!strict

-- Pure resource math shared by the server runtime and validation tests.
local Model = {}

local function clamp(value, low, high)
	return math.max(low, math.min(high, value))
end

function Model.newState(profile, startingMana)
	return {
		Capacity = profile.Capacity,
		Efficiency = profile.Efficiency,
		Potency = profile.Potency,
		StrainTolerance = profile.StrainTolerance,
		ComplexityCapacity = profile.ComplexityCapacity,
		Mana = clamp(startingMana, 0, profile.Capacity),
		Strain = 0,
	}
end

function Model.cost(authored, charge, chargeScale, state)
	local chargeMultiplier = 1 + charge * chargeScale
	return authored.ManaDemand * chargeMultiplier / state.Efficiency,
		authored.Strain * chargeMultiplier * 30 / state.StrainTolerance,
		authored.Complexity
end

function Model.evaluate(state, manaDemand, strain, complexity, safety)
	if manaDemand > state.Mana then
		return "IMPOSSIBLE", "Insufficient mana", false
	end
	if complexity > state.ComplexityCapacity then
		return "IMPOSSIBLE", "Complexity exceeds capacity", false
	end
	local projectedStrain = state.Strain + strain
	local overextended = projectedStrain > state.StrainTolerance
	if manaDemand > safety.SafeManaDemand or strain > safety.SafeStrain or overextended then
		local reason = "Above safe Locus threshold"
		if overextended then
			reason = "Strain exceeds Locus tolerance; overextension risk"
		end
		return "UNSAFE", reason, overextended
	end
	return "VALID", nil, false
end

function Model.advance(state, delta, manaRecovery, strainRecovery)
	if delta <= 0 then
		return
	end
	state.Mana = math.min(state.Capacity, state.Mana + manaRecovery * delta)
	state.Strain = math.max(0, state.Strain - strainRecovery * delta)
end

function Model.spend(state, manaDemand, strain)
	state.Mana = math.max(0, state.Mana - manaDemand)
	state.Strain = state.Strain + strain
end

function Model.upkeep(state, manaPerSecond, strainPerSecond, delta)
	if delta <= 0 then
		return true
	end
	local manaDemand = manaPerSecond * delta / state.Efficiency
	local strain = strainPerSecond * delta * 30 / state.StrainTolerance
	if manaDemand > state.Mana then
		local fraction = 1
		if manaDemand > 0 then
			fraction = state.Mana / manaDemand
		end
		state.Mana = 0
		state.Strain = state.Strain + strain * fraction
		return false
	end
	Model.spend(state, manaDemand, strain)
	return true
end

return Model
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">MagicLocusRequirementSpec</string>
            <string name="Source"><![CDATA[-- Optional minimum Locus metrics required to execute an authored spell.
local Spec = {}

Spec.Order = { "Capacity", "Efficiency", "Potency", "StrainTolerance", "ComplexityCapacity" }
Spec.Metrics = {
	Capacity = { Label = "Capacity", Maximum = 100000 },
	Efficiency = { Label = "Efficiency", Maximum = 100 },
	Potency = { Label = "Potency", Maximum = 100 },
	StrainTolerance = { Label = "Strain tolerance", Maximum = 100000 },
	ComplexityCapacity = { Label = "Complexity capacity", Maximum = 100000 },
}

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Spec.validate(requirements)
	if requirements == nil then
		return true
	end
	if type(requirements) ~= "table" then
		return false, "Locus requirements must be a table"
	end
	for key, value in pairs(requirements) do
		local metric = Spec.Metrics[key]
		if not metric then
			return false, "Unsupported Locus requirement: " .. tostring(key)
		end
		if not finite(value) or value < 0 or value > metric.Maximum then
			return false, "Minimum " .. metric.Label .. " is outside its supported range"
		end
	end
	return true
end

function Spec.check(requirements, resources)
	local valid, reason = Spec.validate(requirements)
	if not valid then
		return false, reason
	end
	if type(resources) ~= "table" then
		return false, "Locus state unavailable"
	end
	for _, key in ipairs(Spec.Order) do
		local minimum = requirements and requirements[key] or 0
		if minimum > 0 and (not finite(resources[key]) or resources[key] < minimum) then
			return false, string.format("Requires Locus %s ≥ %g", Spec.Metrics[key].Label, minimum)
		end
	end
	return true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">MagicMaterialSpec</string>
            <string name="Source"><![CDATA[-- Material-source compatibility for Matter Forms. This describes an explicit
-- source requirement and consumption, not material physics or terrain editing.
local Spec = {}

Spec.Profiles = {
	Earth = {
		Label = "Earth",
		Expression = "Earth",
		MaterialTargetForms = {
			Projectile = true,
			Beam = true,
			Wave = true,
			Field = true,
			Aura = true,
		},
		ManipulationForms = { Manipulation = true },
		ManipulationObjectTargetForms = { Manipulation = true, Projectile = true, Beam = true, Wave = true },
	},
	Metal = {
		Label = "Metal",
		Expression = "Earth",
		MaterialTargetForms = {
			Projectile = true,
			Beam = true,
			Wave = true,
			Field = true,
			Aura = true,
		},
		ManipulationForms = { Manipulation = true },
		ManipulationObjectTargetForms = { Manipulation = true, Projectile = true, Beam = true, Wave = true },
	},
	Wood = {
		Label = "Wood",
		Expression = "Earth",
		MaterialTargetForms = {
			Projectile = true,
			Beam = true,
			Wave = true,
			Field = true,
			Aura = true,
		},
		ManipulationForms = { Manipulation = true },
		ManipulationObjectTargetForms = { Manipulation = true, Projectile = true, Beam = true, Wave = true },
	},
	Water = {
		Label = "Water",
		Expression = "Water",
		MaterialTargetForms = {
			Projectile = true,
			Beam = true,
			Wave = true,
			Field = true,
			Aura = true,
		},
		ManipulationForms = {},
		ManipulationObjectTargetForms = {},
	},
}

Spec.MaterialOrder = { "Earth", "Metal", "Water", "Wood" }

function Spec.supports(principle, expression, form, targeting, material)
	local profile = Spec.Profiles[material]
	if principle ~= "Matter" or not profile or expression ~= profile.Expression then
		return false
	end

	if targeting == "MaterialTarget" then
		return profile.MaterialTargetForms[form] == true or profile.ManipulationForms[form] == true
	elseif targeting == "ObjectTarget" then
		return profile.ManipulationObjectTargetForms[form] == true
	end

	return false
end

function Spec.options(principle, expression, form, targeting)
	local options = {}
	for _, material in ipairs(Spec.MaterialOrder) do
		if Spec.supports(principle, expression, form, targeting, material) then
			table.insert(options, material)
		end
	end
	return options
end

function Spec.label(material)
	local profile = Spec.Profiles[material]
	return profile and profile.Label or material
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">MagicMovementEffects</string>
            <string name="Source"><![CDATA[-- Aggregates explicit movement statuses without owning Humanoid properties.
local Effects = {}

function Effects.multiplier(active, now)
	local multiplier = 1
	for _, effect in ipairs(active) do
		if effect.ExpiresAt > now then
			if effect.Kind == "Bind" then
				return 0
			elseif effect.Kind == "Slow" then
				multiplier = math.min(multiplier, effect.Multiplier or 1)
			end
		end
	end
	return multiplier
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">MagicObjectTargetSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Pure allowlist checks shared by server ObjectTarget acquisition and revalidation.
local Spec = {}

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Spec.isValidInteractionTarget(target, hasPhysics, hasManipulation)
	if
		type(target) ~= "table"
		or target.InWorkspace ~= true
		or target.CanCollide ~= true
		or target.HasHumanoidAncestor == true
		or target.Tagged ~= true
		or (hasPhysics ~= true and hasManipulation ~= true)
	then
		return false
	end
	if hasPhysics then
		if target.Anchored == true or not finite(target.AssemblyMass) or target.AssemblyMass <= 0 then
			return false
		end
	end
	if hasManipulation then
		return target.MaterialMatches == true and target.RaiseAuthorized == true
	end
	return true
end

function Spec.isSolidWorldSurfaceTarget(target)
	return type(target) == "table"
		and target.InWorkspace == true
		and target.CanCollide == true
		and target.HasHumanoidAncestor ~= true
end

function Spec.isValidManipulationTarget(target, hasOperation, hasPhysics)
	if
		type(target) ~= "table"
		or target.InWorkspace ~= true
		or target.HasHumanoidAncestor == true
		or target.Tagged ~= true
		or (hasOperation ~= true and hasPhysics ~= true)
	then
		return false
	end
	if hasOperation and (target.MaterialMatches ~= true or target.RaiseAuthorized ~= true) then
		return false
	end
	if hasPhysics then
		return target.CanCollide == true
			and target.Anchored ~= true
			and finite(target.AssemblyMass)
			and target.AssemblyMass > 0
	end
	return true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">MagicOperationBudget</string>
            <string name="Source"><![CDATA[--!strict
-- Bounds the work a single triggering event can cascade into. MaxMagicEventDepth
-- limits how long a reaction chain gets; this limits how wide it gets, since
-- every damaged target can re-emit a reaction that hits every target again.
-- A fresh budget starts at each root event (depth 0); nested reactions share it.
local OperationBudget = {}

export type Budget = { Remaining: number, Exhausted: boolean, Reported: boolean }

function OperationBudget.new(limit: number): Budget
	return { Remaining = limit, Exhausted = false, Reported = false }
end

-- Nested events (EventDepth > 0) inherit their parent's budget. Root events get
-- a new one, so long-lived effects that tick repeatedly never drain it.
function OperationBudget.resolve(runtimeState: any, limit: number): Budget
	local inherited = runtimeState and runtimeState.OperationBudget
	if type(inherited) == "table" and (runtimeState.EventDepth or 0) > 0 then
		return inherited
	end
	return OperationBudget.new(limit)
end

function OperationBudget.spend(budget: Budget, cost: number): boolean
	if budget.Exhausted then
		return false
	end
	if budget.Remaining < cost then
		budget.Exhausted = true
		return false
	end
	budget.Remaining -= cost
	return true
end

-- True exactly once after the budget runs out, so callers report it once.
function OperationBudget.takeReport(budget: Budget): boolean
	if budget.Exhausted and not budget.Reported then
		budget.Reported = true
		return true
	end
	return false
end

return OperationBudget
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">MagicPersistentConstructSpec</string>
            <string name="Source"><![CDATA[-- Versioned, DataStore-safe records for static world-persistent Constructs.
local Spec = { Version = 1, MaxRecords = 128, MaxPerOwner = 8, MaxComponents = 5 }

local shapes = { Block = true, Ball = true, Cylinder = true, Wedge = true }
local materials = { Auto = true, Neon = true, ForceField = true, Glass = true, SmoothPlastic = true, Slate = true }
local particles = { Sparks = true, Smoke = true, Embers = true, None = true }

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function vector(values, minimum, maximum)
	if type(values) ~= "table" or #values ~= 3 then
		return false
	end
	for index = 1, 3 do
		if not finite(values[index]) or values[index] < minimum or values[index] > maximum then
			return false
		end
	end
	for key in pairs(values) do
		if type(key) ~= "number" or key < 1 or key > 3 or key % 1 ~= 0 then
			return false
		end
	end
	return true
end

local function onlyKeys(value, allowed)
	if type(value) ~= "table" then
		return false
	end
	for key in pairs(value) do
		if not allowed[key] then
			return false
		end
	end
	return true
end

function Spec.validateRecord(record)
	if
		not onlyKeys(record, {
			Id = true,
			OwnerUserId = true,
			CreatedAt = true,
			Position = true,
			RotationDegrees = true,
			Components = true,
			Visual = true,
		})
		or type(record.Id) ~= "string"
		or #record.Id < 8
		or #record.Id > 64
		or not finite(record.OwnerUserId)
		or record.OwnerUserId < 0
		or record.OwnerUserId % 1 ~= 0
		or not finite(record.CreatedAt)
		or record.CreatedAt < 0
		or record.CreatedAt % 1 ~= 0
		or not vector(record.Position, -1000000, 1000000)
		or not vector(record.RotationDegrees, -180, 180)
	then
		return false, "Persistent Construct identity or transform is invalid"
	end
	local components = record.Components
	if type(components) ~= "table" or #components < 1 or #components > Spec.MaxComponents then
		return false, "Persistent Construct component count is invalid"
	end
	local componentKeys = 0
	for key in pairs(components) do
		if type(key) ~= "number" or key < 1 or key > Spec.MaxComponents or key % 1 ~= 0 then
			return false, "Persistent Construct component list is malformed"
		end
		componentKeys = componentKeys + 1
	end
	if componentKeys ~= #components then
		return false, "Persistent Construct component list is sparse"
	end
	for _, component in ipairs(components) do
		if
			not onlyKeys(component, { Shape = true, Size = true, Offset = true, RotationDegrees = true })
			or not shapes[component.Shape]
			or not vector(component.Size, 0.05, 20)
			or not vector(component.Offset, -10, 10)
			or not vector(component.RotationDegrees, -180, 180)
		then
			return false, "Persistent Construct component is invalid"
		end
	end
	local visual = record.Visual
	if
		not onlyKeys(visual, {
			Color = true,
			SecondaryColor = true,
			AccentColor = true,
			MaterialAppearance = true,
			Opacity = true,
			Emission = true,
			ParticleStyle = true,
		})
		or not vector(visual.Color, 0, 1)
		or (visual.SecondaryColor ~= nil and not vector(visual.SecondaryColor, 0, 1))
		or (visual.AccentColor ~= nil and not vector(visual.AccentColor, 0, 1))
		or not materials[visual.MaterialAppearance]
		or not finite(visual.Opacity)
		or visual.Opacity < 0.2
		or visual.Opacity > 1
		or not finite(visual.Emission)
		or visual.Emission < 0
		or visual.Emission > 1
		or not particles[visual.ParticleStyle]
	then
		return false, "Persistent Construct presentation is invalid"
	end
	return true
end

function Spec.emptyProfile()
	return { Version = Spec.Version, Records = {} }
end

function Spec.decode(raw)
	if raw == nil then
		return Spec.emptyProfile(), true
	end
	if not onlyKeys(raw, { Version = true, Records = true }) or raw.Version ~= Spec.Version then
		return Spec.emptyProfile(), false, "Persistent Construct profile version is invalid"
	end
	local records = raw.Records
	if type(records) ~= "table" or #records > Spec.MaxRecords then
		return Spec.emptyProfile(), false, "Persistent Construct profile exceeds its record limit"
	end
	local owners, ids = {}, {}
	local recordKeys = 0
	for key in pairs(records) do
		if type(key) ~= "number" or key < 1 or key > Spec.MaxRecords or key % 1 ~= 0 then
			return Spec.emptyProfile(), false, "Persistent Construct profile list is malformed"
		end
		recordKeys = recordKeys + 1
	end
	if recordKeys ~= #records then
		return Spec.emptyProfile(), false, "Persistent Construct profile list is sparse"
	end
	local copy = {}
	for index, record in ipairs(records) do
		local valid, reason = Spec.validateRecord(record)
		if not valid or ids[record.Id] then
			return Spec.emptyProfile(), false, reason or "Persistent Construct IDs must be unique"
		end
		ids[record.Id] = true
		owners[record.OwnerUserId] = (owners[record.OwnerUserId] or 0) + 1
		if owners[record.OwnerUserId] > Spec.MaxPerOwner then
			return Spec.emptyProfile(), false, "Persistent Construct owner limit is invalid"
		end
		local cloned = {}
		for key, value in pairs(record) do
			if type(value) == "table" then
				local sub = {}
				for subKey, subValue in pairs(value) do
					if type(subValue) == "table" then
						local nested = {}
						for nestedKey, nestedValue in pairs(subValue) do
							nested[nestedKey] = nestedValue
						end
						sub[subKey] = nested
					else
						sub[subKey] = subValue
					end
				end
				cloned[key] = sub
			else
				cloned[key] = value
			end
		end
		copy[index] = cloned
	end
	return { Version = Spec.Version, Records = copy }, true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
