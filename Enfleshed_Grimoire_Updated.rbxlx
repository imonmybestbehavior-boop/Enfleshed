        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">MagicLocus</string>
            <string name="Source"><![CDATA[--!strict

-- Canonical base Locus profile and centralized prototype practice curve.
return {
	Persistence = {
		Enabled = true,
		DataStoreName = "EnfleshedLocusProfileV1",
		SaveInterval = 60,
		MaxPersistedStrain = 1000000,
	},
	Default = {
		Capacity = 300,
		Efficiency = 1,
		Potency = 1,
		StrainTolerance = 30,
		ComplexityCapacity = 8,
	},
	-- Named special pools are distinct from Mana and Strain. This development
	-- registry entry demonstrates authoring and can be extended by server config.
	SpecialResources = {
		Focus = {
			Label = "Focus",
			Capacity = 100,
			Starting = 100,
			RecoveryPerSecond = 4,
			Attribute = "MagicFocus",
		},
	},
	-- Retained as a separately testable curve, but disabled in this unrestricted
	-- mechanics sandbox so casting never raises player stats.
	Progression = {
		Enabled = false,
		PracticeCastsPerRank = 25,
		MaximumRank = 12,
		PerRank = {
			Capacity = 15,
			Efficiency = 0.015,
			Potency = 0.015,
			StrainTolerance = 1.5,
			ComplexityCapacity = 0.25,
		},
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">MagicPresentation</string>
            <string name="Source"><![CDATA[--!strict
-- Server timing for reusable procedural casting gestures. Timings are seconds.
local PoseSpec = require(script.Parent.Parent.Modules.MagicPoseSpec)
return {
	Profiles = PoseSpec.Profiles,
	Forms = {
		Projectile = "ProjectileCast",
		Beam = "BeamCast",
		Wave = "SelfCast",
		Field = "GroundCast",
		Aura = "SelfCast",
		Construct = "GroundCast",
		SelfEnhancement = "SelfCast",
		Manipulation = "GroundCast",
	},
	Timing = {
		ProjectileCast = { Gather = 0.16, Release = 0.12, Recovery = 0.20 },
		BeamCast = { Gather = 0.28, Release = 0.18, Recovery = 0.24 },
		GroundCast = { Gather = 0.20, Release = 0.12, Recovery = 0.22 },
		SelfCast = { Gather = 0.14, Release = 0.10, Recovery = 0.20 },
		OverheadCast = { Gather = 0.22, Release = 0.18, Recovery = 0.3 },
		WardCast = { Gather = 0.18, Release = 0.14, Recovery = 0.22 },
		SweepCast = { Gather = 0.20, Release = 0.17, Recovery = 0.25 },
	},
	ChargePoseDuration = 3,
	MaxPoseDuration = 3.5,
	ObserverDistance = 180,
	MaxObservedCasts = 32,
	LocalDistortion = {
		UpdateInterval = 0.1,
		FalloffDistance = 24,
		MaxBlur = 2.5,
		MaxContrast = 0.08,
		MaxDesaturation = 0.06,
	},
	ParticleTexture = "rbxasset://textures/particles/sparkles_main.dds",
	ParticleRate = 12,
	AreaNodes = 8,
	ParticleBudget = {
		MaxEmitters = 64,
		MaxContinuousRate = 360,
		MaxBurstPerSecond = 240,
		BurstCapacity = 300,
	},
}
]]></string>
          </Properties>
