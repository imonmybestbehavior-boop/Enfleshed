  <Item class="StarterPlayer" referent="1371">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="1372">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="1373">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Protocol = require(Shared:WaitForChild("Networking"):WaitForChild("Protocol"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local remotes = Shared:WaitForChild(Protocol.Folder)
local request = remotes:WaitForChild(Protocol.Request) :: RemoteEvent
local feedback = remotes:WaitForChild(Protocol.Feedback) :: RemoteEvent
local aerialControl = remotes:WaitForChild(Protocol.AerialControl) :: RemoteEvent
local player = Players.LocalPlayer
local sequence = 0

local function send(action: string, extra: Types.ActionOptions?): number
	sequence += 1
	local character = player.Character
	if not character or not player:GetAttribute("OpeningComplete") then
		return sequence
	end
	local payload: Types.ActionRequest = {
		Action = action,
		Sequence = sequence,
		Character = character,
		Sprinting = if extra then extra.Sprinting else nil,
		Direction = if extra then extra.Direction else nil,
		SpellId = if extra then extra.SpellId else nil,
		AimDirection = if extra then extra.AimDirection else nil,
		WorldPoint = if extra then extra.WorldPoint else nil,
		TargetModel = if extra then extra.TargetModel else nil,
		TargetInstance = if extra then extra.TargetInstance else nil,
		CastOrigin = if extra then extra.CastOrigin else nil,
		EquipmentSlot = if extra then extra.EquipmentSlot else nil,
		EquipmentAction = if extra then extra.EquipmentAction else nil,
		AwakeningProfileId = if extra then extra.AwakeningProfileId else nil,
		SummonMode = if extra then extra.SummonMode else nil,
		SummonId = if extra then extra.SummonId else nil,
	}
	request:FireServer(payload)
	return sequence
end

require(script.Controllers.OpeningController).start(remotes)
local practice = game:GetService("RunService"):IsStudio() and require(Shared.Configuration.DevelopmentSandbox).Enabled
if not practice then
	require(script.Controllers.WorldEventController).start()
end

local debug = require(script.Controllers.DebugController).start()
require(script.Controllers.MagicRevealController).start()
if not practice then
	require(script.Controllers.AssignmentController).start()
	require(script.Controllers.NavigationController).start()
end
require(script.Controllers.LanternController).start()
local aerial = require(script.Controllers.MagicAerialController).start(aerialControl)
local movement = require(script.Controllers.MovementController).start(send)
local combat = require(script.Controllers.CombatController).start(send, movement, debug)
local camera = require(script.Controllers.CameraController).start()
local magic = require(script.Controllers.MagicController).start(send, camera.GetAim)
local equipment = require(script.Controllers.EquipmentController).start(send, combat.Attack, magic.WeaponAction)
local awakening = require(script.Controllers.AwakeningController).start(send)
local generated = require(script.Controllers.GeneratedSpellController).start(magic, debug)
local selectedSummonId: number? = nil
local function cycleSummonSelection()
	local summons = workspace:FindFirstChild("MagicSummons")
	local owned = {}
	if summons then
		for _, model in summons:GetChildren() do
			local summonId = model:GetAttribute("MagicSummonId")
			if
				model:IsA("Model")
				and model:GetAttribute("MagicSummonOwnerUserId") == player.UserId
				and type(summonId) == "number"
			then
				table.insert(owned, { Model = model, Id = summonId })
			end
		end
	end
	table.sort(owned, function(first, second)
		return first.Id < second.Id
	end)
	if #owned == 0 then
		selectedSummonId = nil
	else
		local nextIndex = 1
		for index, summon in owned do
			if summon.Id == selectedSummonId then
				nextIndex = index % #owned + 1
				break
			end
		end
		selectedSummonId = owned[nextIndex].Id
	end
	player:SetAttribute("MagicSelectedSummonId", selectedSummonId)
end

local function summonCommand(mode: string)
	local _, point, target = camera.GetAim()
	send(Protocol.SummonCommand, {
		SummonMode = mode,
		TargetModel = if mode == "Attack" then target else nil,
		WorldPoint = if mode == "Move" or mode == "Patrol" then point else nil,
		SummonId = if mode == "Dismiss" then nil else selectedSummonId,
	})
end

local summonCommands = require(script.Controllers.SummonCommandController).start(summonCommand, cycleSummonSelection)
require(script.Controllers.InputController).start(
	movement.Sprint,
	function()
		if combat.CanDash() then
			movement.Dash()
		end
	end,
	magic.Cast,
	magic.Release,
	equipment.Use,
	equipment.Switch,
	generated.Cycle,
	generated.Begin,
	generated.Release,
	cycleSummonSelection,
	summonCommand
)

local function reset()
	selectedSummonId = nil
	player:SetAttribute("MagicSelectedSummonId", nil)
	movement.Reset()
	aerial.Reset()
	combat.Reset()
	magic.Reset()
	equipment.Reset()
	awakening.Reset()
end
player.CharacterRemoving:Connect(reset)
local deathConnection: RBXScriptConnection? = nil
local function characterAdded(character: Model)
	reset()
	if deathConnection then
		deathConnection:Disconnect()
		deathConnection = nil
	end
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") and player.Character == character then
		deathConnection = humanoid.Died:Connect(reset)
	end
end
player.CharacterAdded:Connect(characterAdded)
if player.Character then
	task.spawn(characterAdded, player.Character)
end
feedback.OnClientEvent:Connect(function(message)
	if message.Kind == "Equipment" then
		equipment.Feedback(message)
	elseif message.Kind == "MagicAwakening" then
		awakening.Feedback(message)
	elseif message.Kind == "ImpactNumber" then
		local target = if typeof(message.Target) == "Instance" and message.Target:IsA("Model")
			then message.Target
			else nil
		if typeof(message.Amount) == "number" and typeof(message.Effect) == "string" then
			debug.Number(message.Effect, message.Amount, target)
		end
	elseif message.Kind == "Magic" then
		debug.Magic(message)
	elseif message.Kind == "SummonCommand" then
		debug.SummonCommand(message)
		summonCommands.Feedback(message)
	elseif message.Kind == "Swing" or (player.Character ~= nil and message.Character == player.Character) then
		movement.Feedback(message)
		combat.Feedback(message)
	end
end)
]]></string>
        </Properties>
        <Item class="Folder" referent="1374">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="1375">
            <Properties>
              <string name="Name">AssignmentController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Definitions = require(Shared.Configuration.Assignments)

local Assignment = {}

function Assignment.start()
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn = "AssignmentHUD", false
	gui.Parent = player:WaitForChild("PlayerGui")
	local label = Instance.new("TextLabel")
	label.Size, label.Position = UDim2.fromOffset(420, 74), UDim2.new(0.5, -210, 0, 12)
	label.BackgroundTransparency, label.TextColor3, label.TextStrokeTransparency = 0.28, Color3.new(1, 1, 1), 0
	label.BackgroundColor3, label.Font, label.TextSize = Color3.fromRGB(18, 18, 18), Enum.Font.Gotham, 16
	label.Parent = gui
	game:GetService("RunService").RenderStepped:Connect(function()
		local id, status = player:GetAttribute("AssignmentId"), player:GetAttribute("AssignmentState")
		gui.Enabled = id ~= nil and id ~= "" and player:GetAttribute("OpeningComplete") == true
		if not gui.Enabled then
			return
		end
		local definition = Definitions[id]
		label.Text = string.format(
			"%s  |  %s\n%s  |  Scrip: %d",
			definition and definition.Name or id,
			status or "",
			player:GetAttribute("AssignmentLocation") or "",
			player:GetAttribute("MilitaryScrip") or 0
		)
	end)
end

return Assignment
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1376">
            <Properties>
              <string name="Name">AwakeningController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Protocol = require(Shared.Networking.Protocol)
local Profiles = require(Shared.Configuration.MagicProfiles)
local Controller = {}

function Controller.start(send: (string, any?) -> number)
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	local rebuild: () -> ()
	gui.Name = "MagicFocusProfileGui"
	gui.ResetOnSpawn = false
	gui.Enabled = true
	gui.Parent = player:WaitForChild("PlayerGui")
	local openButton = Instance.new("TextButton")
	openButton.Name = "OpenFocusProfiles"
	openButton.AnchorPoint = Vector2.new(1, 1)
	openButton.Position = UDim2.new(1, -18, 1, -88)
	openButton.Size = UDim2.fromOffset(156, 34)
	openButton.BackgroundColor3 = Color3.fromRGB(34, 40, 43)
	openButton.TextColor3 = Color3.fromRGB(236, 230, 215)
	openButton.Font = Enum.Font.GothamMedium
	openButton.TextSize = 13
	openButton.Text = "FOCUS PROFILE · K"
	openButton.Visible = true
	openButton.Parent = gui

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Visible = false
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(420, 390)
	panel.BackgroundColor3 = Color3.fromRGB(18, 20, 23)
	panel.BackgroundTransparency = 0.08
	panel.BorderSizePixel = 0
	panel.Parent = gui

	local header = Instance.new("TextLabel")
	header.Size = UDim2.new(1, -24, 0, 34)
	header.Position = UDim2.fromOffset(12, 10)
	header.BackgroundTransparency = 1
	header.Font = Enum.Font.GothamBold
	header.TextSize = 18
	header.TextColor3 = Color3.fromRGB(232, 225, 210)
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.Text = "MAGIC FOCUS PROFILES"
	header.Parent = panel

	local close = Instance.new("TextButton")
	close.Size = UDim2.fromOffset(32, 30)
	close.Position = UDim2.new(1, -42, 0, 8)
	close.BackgroundColor3 = Color3.fromRGB(48, 48, 48)
	close.TextColor3 = Color3.new(1, 1, 1)
	close.Font = Enum.Font.GothamBold
	close.TextSize = 16
	close.Text = "×"
	close.Parent = panel
	close.Activated:Connect(function()
		panel.Visible = false
	end)
	openButton.Activated:Connect(function()
		if player:GetAttribute("MagicLabOpen") then
			return
		end
		panel.Visible = not panel.Visible
		if panel.Visible then
			rebuild()
		end
	end)

	local current = Instance.new("TextLabel")
	current.Size = UDim2.new(1, -24, 0, 25)
	current.Position = UDim2.fromOffset(12, 48)
	current.BackgroundTransparency = 1
	current.Font = Enum.Font.Gotham
	current.TextSize = 13
	current.TextColor3 = Color3.fromRGB(202, 206, 210)
	current.TextXAlignment = Enum.TextXAlignment.Left
	current.Parent = panel

	local list = Instance.new("ScrollingFrame")
	list.Name = "Profiles"
	list.Position = UDim2.fromOffset(12, 78)
	list.Size = UDim2.new(1, -24, 1, -122)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 5
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 7)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local status = Instance.new("TextLabel")
	status.Size = UDim2.new(1, -24, 0, 30)
	status.Position = UDim2.new(0, 12, 1, -36)
	status.BackgroundTransparency = 1
	status.Font = Enum.Font.Gotham
	status.TextSize = 12
	status.TextColor3 = Color3.fromRGB(190, 196, 202)
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.Text = "K · every test profile is available. The Magic Focus uses the selected profile for its casts."
	status.Parent = panel

	local buttons: { [string]: TextButton } = {}
	rebuild = function()
		for _, child in list:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		buttons = {}
		local ids = {}
		for id in Profiles do
			table.insert(ids, id)
		end
		table.sort(ids)
		for order, id in ipairs(ids) do
			local definition = Profiles[id]
			local selected = player:GetAttribute("MagicAwakeningProfileId") == id
			local button = Instance.new("TextButton")
			button.Name = id
			button.LayoutOrder = order
			button.Size = UDim2.new(1, -4, 0, 66)
			button.BackgroundColor3 = if selected then Color3.fromRGB(62, 83, 83) else Color3.fromRGB(42, 46, 49)
			button.TextColor3 = Color3.fromRGB(239, 235, 225)
			button.Font = Enum.Font.Gotham
			button.TextSize = 13
			button.TextWrapped = true
			button.TextXAlignment = Enum.TextXAlignment.Left
			button.Text = string.format(
				"  %s%s\n  %s",
				definition.Label,
				if selected then "  ·  EQUIPPED" else "",
				definition.Description
			)
			button.AutoButtonColor = true
			button.Parent = list
			buttons[id] = button
			button.Activated:Connect(function()
				status.Text = "Applying " .. definition.Label .. "…"
				send(Protocol.MagicAwakeningSelect, { AwakeningProfileId = id })
			end)
		end
		local selectedId = player:GetAttribute("MagicAwakeningProfileId") or "RecruitGeneric"
		local selectedDefinition = Profiles[selectedId]
		current.Text = "Current focus profile: " .. (selectedDefinition and selectedDefinition.Label or "Recruit Focus")
	end

	player:GetAttributeChangedSignal("MagicAwakeningProfileId"):Connect(rebuild)
	player:GetAttributeChangedSignal("MagicLabOpen"):Connect(function()
		if player:GetAttribute("MagicLabOpen") then
			panel.Visible = false
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Enum.KeyCode.K and not player:GetAttribute("MagicLabOpen") then
			panel.Visible = not panel.Visible
			if panel.Visible then
				rebuild()
			end
		end
	end)
	rebuild()

	return {
		Feedback = function(message: any)
			if message.Kind ~= "MagicAwakening" then
				return
			end
			status.Text = if message.Accepted
				then "Test profile selected. The focus now uses this profile."
				else tostring(message.Reason or "Profile selection rejected")
			rebuild()
		end,
		Reset = function()
			panel.Visible = false
		end,
	}
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1377">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict

-- A compact Scriptable third-person camera. It owns gameplay mouse look but can
-- release the cursor for a future UI without that UI depending on camera internals.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Configuration.Sandbox).Camera
local Camera = {}

function Camera.start()
	local player = Players.LocalPlayer
	local enabled = true
	local yaw = 0
	local pitch = math.rad(-12)
	local gui = Instance.new("ScreenGui")
	gui.Name = "SandboxCrosshair"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = player:WaitForChild("PlayerGui")
	local crosshair = Instance.new("Frame")
	crosshair.Name = "Center"
	crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
	crosshair.Position = UDim2.fromScale(0.5, 0.5)
	crosshair.Size = UDim2.fromOffset(0, 0)
	crosshair.BackgroundTransparency = 1
	crosshair.Parent = gui
	for _, line in
		{
			{
				UDim2.fromOffset(Config.Crosshair.Thickness, Config.Crosshair.Size),
				UDim2.fromOffset(0, -Config.Crosshair.Gap),
			},
			{
				UDim2.fromOffset(Config.Crosshair.Thickness, Config.Crosshair.Size),
				UDim2.fromOffset(0, Config.Crosshair.Gap),
			},
			{
				UDim2.fromOffset(Config.Crosshair.Size, Config.Crosshair.Thickness),
				UDim2.fromOffset(-Config.Crosshair.Gap, 0),
			},
			{
				UDim2.fromOffset(Config.Crosshair.Size, Config.Crosshair.Thickness),
				UDim2.fromOffset(Config.Crosshair.Gap, 0),
			},
		}
	do
		local part = Instance.new("Frame")
		part.AnchorPoint = Vector2.new(0.5, 0.5)
		part.Size = line[1]
		part.Position = UDim2.fromScale(0.5, 0.5) + line[2]
		part.BackgroundColor3 = Color3.new(1, 1, 1)
		part.BackgroundTransparency = Config.Crosshair.Transparency
		part.BorderSizePixel = 0
		part.Parent = crosshair
	end

	local function setMouseLocked(value: boolean)
		UserInputService.MouseBehavior = if value then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = not value
		gui.Enabled = value
	end

	local function getRoot(): BasePart?
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		return if root and root:IsA("BasePart") then root else nil
	end

	local function getAim(): (Vector3, Vector3, Model?, Instance?)
		local camera = Workspace.CurrentCamera
		if not camera then
			return Vector3.zAxis, Vector3.zero, nil, nil
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character or Workspace }
		params.RespectCanCollide = true
		local direction = camera.CFrame.LookVector
		local hit = Workspace:Raycast(camera.CFrame.Position, direction * Config.AimDistance, params)
		local target: Model? = nil
		local targetParams = RaycastParams.new()
		targetParams.FilterType = Enum.RaycastFilterType.Exclude
		targetParams.FilterDescendantsInstances = { player.Character or Workspace }
		targetParams.RespectCanCollide = false
		local targetHit = Workspace:Raycast(camera.CFrame.Position, direction * Config.AimDistance, targetParams)
		if targetHit then
			local model = targetHit.Instance:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then
				target = model
			end
		end
		return direction,
			if hit then hit.Position else camera.CFrame.Position + direction * Config.AimDistance,
			target,
			if targetHit then targetHit.Instance else nil
	end

	function Camera:SetGameplayMouseLookEnabled(value: boolean)
		enabled = value
		setMouseLocked(value and player:GetAttribute("OpeningComplete") == true)
	end

	RunService:BindToRenderStep("SandboxThirdPersonCamera", Enum.RenderPriority.Camera.Value, function()
		local camera = Workspace.CurrentCamera
		local root = getRoot()
		if not camera or not root then
			return
		end
		camera.CameraType = Enum.CameraType.Scriptable
		local playing = enabled
			and player:GetAttribute("OpeningComplete") == true
			and not player:GetAttribute("MagicLabOpen")
		setMouseLocked(playing)
		local character = player.Character
		local rotationLocked = character and character:GetAttribute("MagicRotationLocked") == true
		local delta = if playing and not rotationLocked then UserInputService:GetMouseDelta() else Vector2.zero
		yaw -= delta.X * Config.MouseSensitivity
		pitch = math.clamp(pitch - delta.Y * Config.MouseSensitivity, Config.MinimumPitch, Config.MaximumPitch)
		local target = root.Position + Vector3.new(0, Config.Height, 0)
		local rotation = CFrame.fromOrientation(pitch, yaw, 0)
		local desired = target - rotation.LookVector * Config.Distance + rotation.RightVector * Config.ShoulderOffset
		local offset = desired - target
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character }
		params.RespectCanCollide = true
		local obstruction = Workspace:Raycast(target, offset, params)
		local position = desired
		if obstruction then
			position = target + offset.Unit * math.max(0, obstruction.Distance - Config.ObstructionPadding)
		end
		camera.CFrame = CFrame.lookAt(position, target)
		camera.Focus = CFrame.new(target)
	end)

	UserInputService.TextBoxFocused:Connect(function()
		Camera:SetGameplayMouseLookEnabled(false)
	end)
	UserInputService.TextBoxFocusReleased:Connect(function()
		Camera:SetGameplayMouseLookEnabled(true)
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		Camera:SetGameplayMouseLookEnabled(false)
	end)
	UserInputService.WindowFocused:Connect(function()
		Camera:SetGameplayMouseLookEnabled(true)
	end)
	GuiService.MenuOpened:Connect(function()
		Camera:SetGameplayMouseLookEnabled(false)
	end)
	GuiService.MenuClosed:Connect(function()
		Camera:SetGameplayMouseLookEnabled(true)
	end)

	setMouseLocked(player:GetAttribute("OpeningComplete") == true)
	return {
		GetAim = getAim,
		SetGameplayMouseLookEnabled = function(value: boolean)
			Camera:SetGameplayMouseLookEnabled(value)
		end,
	}
end

return Camera
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1378">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local Protocol = require(Shared:WaitForChild("Networking"):WaitForChild("Protocol"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local Movement = require(script.Parent.MovementController)
local Debug = require(script.Parent.DebugController)
local Combat = {}

local function swing(character: Model, step: number)
	local root = character:FindFirstChild("HumanoidRootPart")
	local attack = Config.Combat.Attacks[step]
	if not root or not root:IsA("BasePart") or not attack then
		return
	end
	local part = Instance.new("Part")
	part.Name = "SwingPreview"
	part.Size = attack.Size
	part.CFrame = root.CFrame * CFrame.new(0, 0, -attack.Offset)
	part.Anchored = false
	part.Massless = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(240, 195, 135)
	part.Transparency = Config.Debug.SwingTransparency
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
	part.Parent = workspace
	Debris:AddItem(part, attack.Startup + attack.Active)
end

function Combat.start(
	send: (string, Types.ActionOptions?) -> number,
	movement: Movement.Controller,
	debug: Debug.Controller
)
	local player = Players.LocalPlayer
	local combo = 0
	local readyAt = 0
	local expires = 0
	local pending = 0
	local bufferedUntil = 0

	local function attack()
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		if not character or not humanoid or humanoid.Health <= 0 or movement.IsDashing() then
			return
		end
		local now = workspace:GetServerTimeNow()
		if now < readyAt or pending ~= 0 then
			if readyAt - now <= Config.Combat.InputBuffer then
				bufferedUntil = now + Config.Combat.InputBuffer
			end
			return
		end
		combo = if now > expires then 1 else combo % #Config.Combat.Attacks + 1
		local definition = Config.Combat.Attacks[combo]
		readyAt = now + definition.Startup + definition.Active + definition.Recovery
		expires = readyAt + Config.Combat.ComboReset
		bufferedUntil = 0
		swing(character, combo)
		pending = send(Protocol.Light, nil)
	end

	RunService.RenderStepped:Connect(function()
		local now = workspace:GetServerTimeNow()
		if bufferedUntil >= now and pending == 0 and now >= readyAt then
			attack()
		end
		debug.Update(if now > expires then 0 else combo, movement.GetCooldown())
	end)

	return {
		Attack = attack,
		CanDash = function(): boolean
			return pending == 0 and workspace:GetServerTimeNow() >= readyAt
		end,
		Reset = function()
			combo = 0
			readyAt = 0
			expires = 0
			pending = 0
			bufferedUntil = 0
			debug.Reset()
		end,
		Feedback = function(message: any)
			if message.Kind == "Swing" then
				if
					typeof(message.Character) == "Instance"
					and message.Character:IsA("Model")
					and message.Character ~= player.Character
				then
					swing(message.Character, message.Combo)
				end
			elseif message.Kind == "Hit" then
				local target = message.Target
				debug.Hit(message.Damage, if typeof(target) == "Instance" and target:IsA("Model") then target else nil)
			elseif message.Kind == "Correction" then
				bufferedUntil = 0
			elseif message.Kind == "Action" and message.Action == Protocol.Light and message.Sequence == pending then
				pending = 0
				combo = message.Combo
				readyAt = message.ReadyAt
				expires = readyAt + Config.Combat.ComboReset
				if not message.Accepted then
					bufferedUntil = 0
				end
			end
		end,
	}
end

return Combat
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1379">
            <Properties>
              <string name="Name">DebugController</string>
              <string name="Source"><![CDATA[--!strict

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Configuration.Sandbox)
local Debug = {}

function Debug.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "SandboxDebug"
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local cityConfig = require(game:GetService("ReplicatedStorage").Shared.Configuration.CityLife)
	gui.Enabled = game:GetService("RunService"):IsStudio()
		and (cityConfig.DevelopmentSpells or Config.StressTest.Enabled)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromOffset(760, 216)
	label.Position = UDim2.fromOffset(12, 12)
	label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	label.BackgroundTransparency = 0.25
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextSize = 17
	label.Font = Enum.Font.Code
	label.Parent = gui
	local hitUntil = 0
	local hitText = ""
	local stress: Instance? = nil
	local magicText = ""
	local magicUntil = 0
	local summonText = ""
	local summonUntil = 0
	local generatedText = ""
	local function waveText(): string
		if not Config.StressTest.Enabled then
			return ""
		end
		if not stress or not stress.Parent then
			stress = workspace:FindFirstChild("SandboxStressTest")
		end
		if not stress then
			return "Stress test starting..."
		end
		local phase = stress:GetAttribute("Status")
		if phase == "Complete" then
			return "Stress test complete | Living 0"
		end
		if phase == "Blocked" then
			return "Waiting for a clear enemy spawn area"
		end
		local wave = stress:GetAttribute("Wave") or 0
		local total = stress:GetAttribute("TotalWaves") or 0
		local living = stress:GetAttribute("LivingEnemies") or 0
		if phase == "Waiting" then
			local seconds =
				math.max(0, math.ceil((stress:GetAttribute("NextWaveAt") or 0) - workspace:GetServerTimeNow()))
			return string.format("Wave %d/%d | Living %d | Next in %ds", wave, total, living, seconds)
		end
		return string.format("Wave %d/%d | Living %d", wave, total, living)
	end
	local function locusTestText(): string
		return "Locus stats fixed for unrestricted testing"
	end
	local function companionSpellText(): string
		local summons = workspace:FindFirstChild("MagicSummons")
		if not summons then
			return ""
		end
		local owned = {}
		for _, model in summons:GetChildren() do
			if model:IsA("Model") and model:GetAttribute("MagicSummonOwnerUserId") == Players.LocalPlayer.UserId then
				table.insert(owned, {
					Id = model:GetAttribute("MagicSummonId") or 0,
					Slot = model:GetAttribute("MagicSummonSpellSlot") or 0,
					Status = model:GetAttribute("MagicSummonSpellStatus") or "SEARCHING",
					Reason = model:GetAttribute("MagicSummonSpellReason") or "",
					Target = model:GetAttribute("MagicSummonSpellTarget") or "",
				})
			end
		end
		if #owned == 0 then
			return ""
		end
		local selectedId = Players.LocalPlayer:GetAttribute("MagicSelectedSummonId")
		table.sort(owned, function(first, second)
			if (first.Id == selectedId) ~= (second.Id == selectedId) then
				return first.Id == selectedId
			end
			return first.Id < second.Id
		end)
		local rows = {}
		for index = 1, math.min(#owned, 3) do
			local companion = owned[index]
			local detail = if companion.Target ~= "" then " → " .. companion.Target else ""
			if companion.Reason ~= "" then
				detail ..= " · " .. companion.Reason
			end
			table.insert(
				rows,
				string.format(
					"%s#%s slot %s: %s%s",
					if companion.Id == selectedId then "▶ " else "",
					companion.Id,
					companion.Slot,
					companion.Status,
					detail
				)
			)
		end
		return "Companion spells | " .. table.concat(rows, "   |   ")
	end
	local numberSequence = 0
	local function showNumber(kind: string, amount: number, target: Model?)
		if not target or not target:IsDescendantOf(workspace) or amount <= 0 then
			return
		end
		local anchor = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
		if not anchor or not anchor:IsA("BasePart") then
			return
		end
		numberSequence += 1
		local number = Instance.new("BillboardGui")
		number.Name = "SandboxCombatNumber" .. numberSequence
		number.Adornee = anchor
		number.Size = UDim2.fromOffset(150, 36)
		number.StudsOffset = Vector3.new((numberSequence % 3 - 1) * 0.4, 3.5, 0)
		number.AlwaysOnTop = true
		number.MaxDistance = 140
		number.Parent = target
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.GothamBold
		text.TextSize = 25
		text.TextStrokeTransparency = 0.15
		text.TextTransparency = 0
		text.Text = if kind == "Damage"
			then string.format("-%g", amount)
			elseif kind == "Transformation" then string.format("×%.2f SIZE", amount)
			elseif kind == "TimeDilation" then string.format("×%.2f TIME", amount)
			elseif kind == "Displacement" then string.format("%g STUDS", amount)
			elseif kind == "Shield" then string.format("+%g SHIELD", amount)
			elseif kind == "Control" then string.format("%g CONTROL", amount)
			else string.format("+%g", amount)
		text.TextColor3 = if kind == "Heal"
			then Color3.fromRGB(111, 255, 153)
			elseif kind == "Transformation" then Color3.fromRGB(232, 174, 255)
			elseif kind == "TimeDilation" then Color3.fromRGB(176, 155, 255)
			elseif kind == "Displacement" then Color3.fromRGB(212, 180, 255)
			elseif kind == "Shield" then Color3.fromRGB(112, 222, 255)
			elseif kind == "Control" then Color3.fromRGB(206, 146, 255)
			elseif kind == "Damage" then Color3.fromRGB(255, 119, 96)
			else Color3.fromRGB(255, 240, 140)
		text.Parent = number
		TweenService:Create(number, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			StudsOffset = number.StudsOffset + Vector3.new(0, 1.15, 0),
		}):Play()
		TweenService
			:Create(text, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0.15), {
				TextTransparency = 1,
				TextStrokeTransparency = 1,
			})
			:Play()
		Debris:AddItem(number, 1.1)
	end
	return {
		Hit = function(damage: number, target: Model?)
			local name = if target then (target:GetAttribute("SandboxLabel") or target.Name) else "Target"
			hitText = string.format("HIT %s  -%g HP", name, damage)
			hitUntil = os.clock() + Config.Debug.HitDuration
			if not target or not target:IsDescendantOf(workspace) then
				return
			end
			-- The highlight is local; floating numbers arrive through replicated server feedback.
			for _, effectName in { "SandboxConfirmedHit" } do
				local previous = target:FindFirstChild(effectName)
				if previous then
					previous:Destroy()
				end
			end
			local flash = Instance.new("Highlight")
			flash.Name = "SandboxConfirmedHit"
			flash.Adornee = target
			flash.FillTransparency = 0.6
			flash.FillColor = Color3.fromRGB(255, 255, 255)
			flash.OutlineColor = Color3.fromRGB(255, 255, 255)
			flash.OutlineTransparency = 0
			flash.DepthMode = Enum.HighlightDepthMode.Occluded
			flash.Parent = target
			Debris:AddItem(flash, Config.Debug.TargetFlashDuration)
		end,
		Reset = function()
			hitUntil = 0
		end,
		Magic = function(message: any)
			magicText = string.format(
				"Magic %s %s | mana %s/%s (cost %s) | strain %s/%s | complexity %s/%s%s%s%s",
				tostring(message.Name or ""),
				tostring(message.Result or ""),
				tostring(message.Mana or "-"),
				tostring(message.Capacity or "-"),
				tostring(message.ManaDemand or "-"),
				tostring(message.Strain or "-"),
				tostring(message.StrainTolerance or "-"),
				tostring(message.Complexity or "-"),
				tostring(message.ComplexityCapacity or "-"),
				if message.Damage then " | damage " .. tostring(message.Damage) else "",
				if message.Reason then " | " .. tostring(message.Reason) else "",
				if message.Effect
					then " | " .. tostring(message.Effect) .. " " .. tostring(message.Amount or "")
					else ""
			)
			magicUntil = os.clock() + 2.5
		end,
		SummonCommand = function(message: any)
			summonText = if message.Accepted
				then "Summons: " .. tostring(message.Reason or message.Mode or "Order set")
				else "Summons: " .. tostring(message.Reason or "Command rejected")
			summonUntil = os.clock() + 3
		end,
		Number = showNumber,
		Generated = function(text: string)
			generatedText = text
		end,
		Update = function(combo: number, cooldown: number)
			label.Text = string.format(
				"Combo %d/3  |  Dash %.1fs\n%s\n%s\n%s\n%s\n%s\n%s\n%s\nV2: 4 Lance | 5 Ground | 6 Reinforcement | 7 Raise\nSummons: N Select | Z Follow | X Protect | C Attack | B Move | J Patrol | H Hold | G Support | V Dismiss",
				combo,
				cooldown,
				if os.clock() < hitUntil then hitText else "",
				if os.clock() < magicUntil then magicText else "",
				if os.clock() < summonUntil then summonText else "",
				companionSpellText(),
				generatedText,
				waveText(),
				locusTestText()
			)
		end,
	}
end

export type Controller = typeof(Debug.start())
return Debug
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1380">
            <Properties>
              <string name="Name">EquipmentController</string>
              <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Protocol = require(Shared.Networking.Protocol)
local Types = require(Shared.Types.CombatTypes)
local Equipment = {}

function Equipment.start(
	send: (string, Types.ActionOptions?) -> number,
	meleeAttack: () -> (),
	magicAction: (string) -> ()
)
	local player = game:GetService("Players").LocalPlayer
	local activeSlot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
	player:GetAttributeChangedSignal("ActiveEquipmentSlot"):Connect(function()
		activeSlot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
	end)
	return {
		Use = function(action: string)
			if activeSlot == "SecondaryWeapon" and action == "Primary" then
				meleeAttack()
			elseif activeSlot == "PrimaryWeapon" then
				magicAction(action)
			end
		end,
		Switch = function()
			local slot = if activeSlot == "PrimaryWeapon" then "SecondaryWeapon" else "PrimaryWeapon"
			send(Protocol.EquipmentSwitch, { EquipmentSlot = slot })
		end,
		Feedback = function(message: any)
			if
				message.Kind == "Equipment"
				and (message.ActiveSlot == "PrimaryWeapon" or message.ActiveSlot == "SecondaryWeapon")
			then
				activeSlot = message.ActiveSlot
			end
		end,
		Reset = function()
			activeSlot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
		end,
	}
end

return Equipment
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1381">
            <Properties>
              <string name="Name">GeneratedSpellController</string>
              <string name="Source"><![CDATA[--!strict

-- Development-only keyboard harness for the controlled generated registry.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.Sandbox).DevelopmentSpellStress
local Generated = require(Shared.Configuration.GeneratedSpellStress)
local GeneratedController = {}

function GeneratedController.start(magic: any, debug: any)
	local selected = 1
	local function announce()
		if not Config.Enabled or #Generated.Order == 0 then
			return
		end
		local id = Generated.Order[selected]
		debug.Generated(string.format("Generated %d/%d | %s", selected, #Generated.Order, Generated.Descriptions[id]))
	end
	announce()
	return {
		Cycle = function()
			if not Config.Enabled or #Generated.Order == 0 then
				return
			end
			selected = selected % #Generated.Order + 1
			announce()
		end,
		Begin = function()
			if not Config.Enabled or #Generated.Order == 0 then
				return
			end
			local id = Generated.Order[selected]
			local mode = Generated.Definitions[id].Casting.Mode
			magic.Cast(id, mode == "Charged" or mode == "HoldAndRelease")
		end,
		Release = function()
			magic.Release()
		end,
	}
end

return GeneratedController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1382">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local player = game:GetService("Players").LocalPlayer
local SummonConfig = require(game:GetService("ReplicatedStorage").Shared.Configuration.MagicSummons)
local development = game:GetService("RunService"):IsStudio()
	and require(game:GetService("ReplicatedStorage").Shared.Configuration.CityLife).DevelopmentSpells
local Input = {}

function Input.start(
	sprint: (boolean) -> (),
	dash: () -> (),
	magicStart: (string, boolean?) -> (),
	magicRelease: () -> (),
	useEquipment: (string) -> (),
	switchEquipment: () -> (),
	cycleGenerated: () -> (),
	startGenerated: () -> (),
	releaseGenerated: () -> (),
	cycleSummonSelection: () -> (),
	summonCommand: (string) -> ()
)
	ContextActionService:BindAction("SandboxSprint", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprint(false)
		elseif state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			sprint(true)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.LeftShift)
	ContextActionService:BindAction("SandboxDash", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			dash()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Q)
	ContextActionService:BindAction("SandboxLight", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			useEquipment("Primary")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.UserInputType.MouseButton1)
	for mode, keyName in pairs(SummonConfig.CommandKeys) do
		local key = Enum.KeyCode[keyName]
		ContextActionService:BindAction("SandboxSummon" .. mode, function(_, state)
			if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
				return Enum.ContextActionResult.Pass
			end
			if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
				summonCommand(mode)
			end
			return Enum.ContextActionResult.Sink
		end, false, key)
	end
	ContextActionService:BindAction("SandboxEquipmentArea", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			useEquipment("Area")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.UserInputType.MouseButton2)
	ContextActionService:BindAction("SandboxSummonSelect", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			cycleSummonSelection()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode[SummonConfig.SelectionKey])
	ContextActionService:BindAction("SandboxEquipmentSwitch", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			switchEquipment()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.E)
	for spellId, key in
		{
			Fireball = Enum.KeyCode.One,
			BodyBurst = Enum.KeyCode.Two,
			StoneShot = Enum.KeyCode.Three,
			LightningLance = Enum.KeyCode.Four,
			BurningGround = Enum.KeyCode.Five,
			BodyReinforcement = Enum.KeyCode.Six,
			StoneRaise = Enum.KeyCode.Seven,
		}
	do
		ContextActionService:BindAction("Sandbox" .. spellId, function(_, state)
			if not development then
				return Enum.ContextActionResult.Pass
			end
			if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
				return Enum.ContextActionResult.Pass
			end
			if UserInputService:GetFocusedTextBox() then
				return Enum.ContextActionResult.Sink
			end
			if state == Enum.UserInputState.Begin then
				magicStart(spellId, spellId == "StoneShot")
			elseif
				spellId == "StoneShot" and (state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel)
			then
				magicRelease()
			end
			return Enum.ContextActionResult.Sink
		end, false, key)
	end
	ContextActionService:BindAction("SandboxGeneratedCycle", function(_, state)
		if not development then
			return Enum.ContextActionResult.Pass
		end
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			cycleGenerated()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.F)
	ContextActionService:BindAction("SandboxGeneratedCast", function(_, state)
		if not development then
			return Enum.ContextActionResult.Pass
		end
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if UserInputService:GetFocusedTextBox() then
			return Enum.ContextActionResult.Sink
		end
		if state == Enum.UserInputState.Begin then
			startGenerated()
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			releaseGenerated()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.R)
	UserInputService.WindowFocusReleased:Connect(function()
		sprint(false)
	end)
	UserInputService.TextBoxFocused:Connect(function()
		sprint(false)
	end)
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1383">
            <Properties>
              <string name="Name">LanternController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Lantern = {}

function Lantern.start()
	local player = Players.LocalPlayer
	local attachment: Attachment? = nil
	local function clear()
		if attachment then
			attachment:Destroy()
			attachment = nil
		end
	end
	local function bind(character: Model)
		clear()
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if player.Character ~= character or not root or not root:IsA("BasePart") then
			return
		end
		local anchor = Instance.new("Attachment")
		anchor.Name = "LocalFieldLantern"
		anchor.Position = Vector3.new(0, 2.2, -1.4)
		anchor.Parent = root
		attachment = anchor
		local light = Instance.new("PointLight")
		light.Name = "FieldLantern"
		light.Color = Color3.fromRGB(255, 203, 146)
		light.Range, light.Brightness, light.Shadows = 36, 3.25, true
		light.Parent = anchor
	end
	player.CharacterRemoving:Connect(clear)
	player.CharacterAdded:Connect(bind)
	if player.Character then
		task.spawn(bind, player.Character)
	end
end

return Lantern
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1384">
            <Properties>
              <string name="Name">MagicAerialController</string>
              <string name="Source"><![CDATA[--!strict

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Controller = {}

function Controller.start(remote: RemoteEvent)
	local player = Players.LocalPlayer
	local character: Model? = nil
	local active = false
	local ascending = false
	local descending = false
	local lastSent = 0
	local attributeConnection: RBXScriptConnection? = nil
	local sendInterval = 0.1

	local function showTouchControls(value: boolean)
		for _, actionName in { "MagicAerialAscend", "MagicAerialDescend" } do
			local button = ContextActionService:GetButton(actionName)
			if button then
				button.Visible = value
			end
		end
	end

	local function setActive(value: boolean)
		active = value
		showTouchControls(value)
		if not active then
			ascending = false
			descending = false
		end
	end

	local function bindCharacter(nextCharacter: Model)
		if attributeConnection then
			attributeConnection:Disconnect()
			attributeConnection = nil
		end
		character = nextCharacter
		setActive((nextCharacter:GetAttribute("MagicAerialSpeed") or 0) > 0)
		attributeConnection = nextCharacter:GetAttributeChangedSignal("MagicAerialSpeed"):Connect(function()
			setActive((nextCharacter:GetAttribute("MagicAerialSpeed") or 0) > 0)
		end)
	end

	local function verticalAction(direction: number, inputState: Enum.UserInputState)
		if not active then
			return Enum.ContextActionResult.Pass
		end
		local pressed = inputState == Enum.UserInputState.Begin
		if direction > 0 then
			ascending = pressed
		else
			descending = pressed
		end
		if inputState == Enum.UserInputState.Cancel then
			ascending = false
			descending = false
		end
		return Enum.ContextActionResult.Sink
	end

	ContextActionService:BindActionAtPriority("MagicAerialAscend", function(_, state)
		return verticalAction(1, state)
	end, true, 3000, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	ContextActionService:SetTitle("MagicAerialAscend", "Rise")
	ContextActionService:BindActionAtPriority("MagicAerialDescend", function(_, state)
		return verticalAction(-1, state)
	end, true, 3000, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("MagicAerialDescend", "Descend")

	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		bindCharacter(player.Character)
	end

	RunService.Heartbeat:Connect(function()
		if not active or not character or player.Character ~= character or UserInputService:GetFocusedTextBox() then
			return
		end
		local now = os.clock()
		if now - lastSent < sendInterval then
			return
		end
		lastSent = now
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		local move = humanoid.MoveDirection
		local interfaceOpen = player:GetAttribute("MagicLabOpen") == true
		local direction = if interfaceOpen
			then Vector3.zero
			else Vector3.new(move.X, (if ascending then 1 else 0) - (if descending then 1 else 0), move.Z)
		if direction.Magnitude > 1 then
			direction = direction.Unit
		end
		remote:FireServer(character, direction)
	end)

	return {
		Reset = function()
			setActive(false)
		end,
	}
end

return Controller
]]></string>
            </Properties>
