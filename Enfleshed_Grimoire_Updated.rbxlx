      <Item class="Folder" referent="93">
        <Properties>
          <string name="Name">Types</string>
        </Properties>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">CombatTypes</string>
            <string name="Source"><![CDATA[--!strict

export type Attack = {
	Startup: number,
	Active: number,
	Recovery: number,
	Damage: number,
	Size: Vector3,
	Offset: number,
	Reach: number,
}

export type ActionOptions = {
	Sprinting: boolean?,
	Direction: Vector3?,
	SpellId: string?,
	AimDirection: Vector3?,
	WorldPoint: Vector3?,
	TargetModel: Model?,
	TargetInstance: Instance?,
	CastOrigin: Vector3?,
	EquipmentSlot: string?,
	EquipmentAction: string?,
	AwakeningProfileId: string?,
	SummonMode: string?,
	SummonId: number?,
	AllowsTargetedSpells: boolean?,
}

export type ActionRequest = {
	Action: string,
	Sequence: number,
	Character: Model,
	Sprinting: boolean?,
	Direction: Vector3?,
	SpellId: string?,
	AimDirection: Vector3?,
	WorldPoint: Vector3?,
	TargetModel: Model?,
	TargetInstance: Instance?,
	CastOrigin: Vector3?,
	EquipmentSlot: string?,
	EquipmentAction: string?,
	AwakeningProfileId: string?,
	SummonMode: string?,
	SummonId: number?,
	AllowsTargetedSpells: boolean?,
}

export type HitResult = { Target: Model, Damage: number, Health: number }

-- Type information only: the actual state is created and retained exclusively on the server.
export type PlayerState = {
	Character: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Sprinting: boolean,
	MagicWalkSpeedBonus: number,
	MagicSpeedMultiplier: number,
	MagicSlowMultiplier: number,
	MagicCastingMultiplier: number,
	MagicRotationLocked: boolean,
	MagicCastingDirection: Vector3?,
	MagicBaseJumpHeight: number,
	MagicPreviousMultiplier: number?,
	MagicSpeedGraceUntil: number?,
	MagicJumpPowerBonus: number,
	MagicAerialSpeed: number,
	MagicAerialInput: Vector3,
	MagicAerialInputExpiresAt: number,
	MagicAerialAttachment: Attachment?,
	MagicAerialVelocity: LinearVelocity?,
	DashUntil: number,
	DashReadyAt: number,
	DashOrigin: Vector3?,
	DashCheckUntil: number,
	LastPosition: Vector3,
	LastFramePosition: Vector3,
	LastCheck: number,
	DashAllowance: number,
	CorrectionUntil: number,
	SpawnGraceUntil: number,
	Combo: number,
	ReadyAt: number,
	ComboExpires: number,
	Attack: Attack?,
	ActiveAt: number,
	ActiveUntil: number,
	HitTargets: { [Humanoid]: boolean },
}

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">EquipmentTypes</string>
            <string name="Source"><![CDATA[--!strict

export type Slot = "PrimaryWeapon" | "SecondaryWeapon" | "Utility"

export type State = {
	PrimaryWeapon: string?,
	SecondaryWeapon: string?,
	Utility: string?,
	ActiveSlot: Slot,
}

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">MagicTypes</string>
            <string name="Source"><![CDATA[--!strict

export type ValidationResult = "VALID" | "UNSAFE" | "IMPOSSIBLE"

export type CastIntent = {
	SpellId: string,
	AimDirection: Vector3,
	WorldPoint: Vector3?,
	TargetModel: Model?,
	TargetInstance: Instance?,
}

export type ActiveSpell = {
	SpellId: string,
	Caster: Model,
	Age: number,
	CurrentPhase: string,
	TargetsHit: { [Humanoid]: boolean },
	RemainingLifetime: number,
}

export type Payload = {
	Kind: string,
	Duration: number?,
	Interval: number?,
	Amount: number?,
	Magnitude: number?,
	Upward: number?,
	SpeedMultiplier: number?,
	WalkSpeedBonus: number?,
	JumpPowerBonus: number?,
	Operation: string?,
	Distance: number?,
	Mode: string?,
	DamageChannel: string?,
	Rate: number?,
	Attribute: string?,
	Multiplier: number?,
	Acceleration: number?,
	MaxSpeed: number?,
	Archetype: string?,
	Count: number?,
	SpellSlot: string?,
}
export type TriggerStep = { Behavior: string?, Radius: number?, Payloads: { Payload } }
export type SpellSpec = {
	SpellId: string,
	Name: string,
	Version: number,
	Tags: { string },
	Element: string,
	Source: { Principle: string, Expression: string },
	Form: string,
	Targeting: string,
	TargetPolicy: string?,
	Geometry: string,
	Motion: string,
	TargetRules: {
		Range: number,
		MaxTargets: number,
		RequiresLineOfSight: boolean,
		IncludeCaster: boolean,
		Relationship: string,
		RequiresConsent: boolean,
	},
	Conditions: any,
	Casting: {
		Mode: string,
		Cooldown: number,
		CastTime: number,
		RecoveryTime: number,
		MinimumCharge: number?,
		MaximumCharge: number?,
		InterruptOnDamage: boolean?,
		InterruptMoveDistance: number?,
		CanMoveWhileCasting: boolean?,
		MovementPenalty: number?,
		CanRotateWhileCasting: boolean?,
	},
	Lifetime: { Mode: string, Duration: number? },
	Cost: {
		ManaDemand: number,
		Strain: number,
		Complexity: number,
		SpecialResources: { [string]: number }?,
	},
	LocusRequirements: {
		Capacity: number?,
		Efficiency: number?,
		Potency: number?,
		StrainTolerance: number?,
		ComplexityCapacity: number?,
	}?,
	Triggers: { [string]: { TriggerStep } },
	Visual: { Color: Color3, Profile: string?, ProjectileScale: number? },
	Projectile: {
		Speed: number,
		Radius: number,
		MaxDistance: number,
		Gravity: number,
		Acceleration: number,
		MotionPhases: {
			{
				Mode: string?,
				Duration: number,
				SpeedMultiplier: number?,
				Acceleration: number?,
				Gravity: number?,
				ArcHeight: number?,
				BezierSide: number?,
				BezierHeight: number?,
				OrbitRadius: number?,
				OrbitAngularSpeed: number?,
				ExpandMultiplier: number?,
			}
		}?,
	}?,
	Beam: {
		Range: number,
		Width: number,
		DebugDuration: number,
		Pattern: ("Single" | "Cascade")?,
		StrikeCount: number?,
		SpreadRadius: number?,
		DropHeight: number?,
		StrikeInterval: number?,
		Interval: number?,
		GrowthStartScale: number?,
		GrowthEndScale: number?,
		GrowthDuration: number?,
	}?,
	Field: {
		Radius: number?,
		InnerRadius: number?,
		OuterRadius: number?,
		Width: number?,
		Height: number?,
		Depth: number?,
		Range: number?,
		Angle: number?,
		Interval: number,
		DebugHeight: number?,
		Yaw: number?,
		GrowthStartScale: number?,
		GrowthEndScale: number?,
		GrowthDuration: number?,
	}?,
	Wave: {
		Range: number,
		Dot: number,
		DebugDuration: number,
		GrowthStartScale: number?,
		GrowthEndScale: number?,
		GrowthDuration: number?,
	}?,
	Aura: {
		Radius: number?,
		InnerRadius: number?,
		OuterRadius: number?,
		Width: number?,
		Height: number?,
		Depth: number?,
		Range: number?,
		Angle: number?,
		Interval: number,
		Yaw: number?,
		GrowthStartScale: number?,
		GrowthEndScale: number?,
		GrowthDuration: number?,
	}?,
	Construct: {
		Width: number,
		Height: number,
		Depth: number,
		Distance: number,
		GrowthStartScale: number?,
		GrowthEndScale: number?,
		GrowthDuration: number?,
		Components: {
			{
				Shape: string,
				SizeX: number,
				SizeY: number,
				SizeZ: number,
				OffsetX: number,
				OffsetY: number,
				OffsetZ: number,
				RotationX: number,
				RotationY: number,
				RotationZ: number,
			}
		}?,
	}?,
	Material: { Material: string, Amount: number?, SearchRadius: number }?,
}
return {}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="97">
        <Properties>
          <string name="Name">Utilities</string>
        </Properties>
      </Item>
