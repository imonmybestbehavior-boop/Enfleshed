            <string name="Name">MagicPoseSpec</string>
            <string name="Source"><![CDATA[-- Shared procedural cast poses. Angles use the body-space convention from MagicRig.
local Spec = {}

Spec.Profiles = {
	"Auto",
	"ProjectileCast",
	"BeamCast",
