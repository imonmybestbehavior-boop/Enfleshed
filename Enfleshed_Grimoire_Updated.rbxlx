        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local HitDetection = require(script.Parent.HitDetectionService)
local Damage = require(script.Parent.DamageService)
local Enemy = require(script.Parent.EnemyService)
local Combat = {}

function Combat.request(state: Types.PlayerState, now: number): boolean
	if now < state.ReadyAt or now < state.DashUntil or now < state.CorrectionUntil then
		return false
	end
	state.Combo = if now > state.ComboExpires then 1 else state.Combo % #Config.Combat.Attacks + 1
	local attack = Config.Combat.Attacks[state.Combo]
	state.Attack = attack
	state.ActiveAt = now + attack.Startup
	state.ActiveUntil = state.ActiveAt + attack.Active
	state.ReadyAt = state.ActiveUntil + attack.Recovery
	state.ComboExpires = state.ReadyAt + Config.Combat.ComboReset
	state.HitTargets = {}
	return true
end

function Combat.update(player: Player, state: Types.PlayerState, now: number, feedback: RemoteEvent)
	local attack = state.Attack
	if not attack then
		return
	end
	if now > state.ActiveUntil then
		state.Attack = nil
		return
	end
	if now < state.ActiveAt then
		return
	end
	local origin = state.Root.CFrame
	for _, target in
		HitDetection.find(state.Character, origin, origin * CFrame.new(0, 0, -attack.Offset), attack.Size, {
			OverlapCollisionGroup = Config.Combat.OverlapCollisionGroup,
			MaxDistance = attack.Reach,
			MinimumFacingDot = Config.Combat.MinimumFacingDot,
			RequireLineOfSight = true,
		})
	do
		if state.HitTargets[target] then
			continue
		end
		state.HitTargets[target] = true
		local amount = Damage.apply(state.Character, target, attack.Damage)
		if amount > 0 then
			-- Only the recruit finisher is significant. Ordinary lights damage a
			-- Nascent without stopping its committed pressure.
			Enemy.onHit(target, if state.Combo == #Config.Combat.Attacks then "Significant" else "Minor")
			local hit: Types.HitResult = { Target = target.Parent :: Model, Damage = amount, Health = target.Health }
			feedback:FireClient(player, {
				Kind = "Hit",
				Character = state.Character,
				Target = hit.Target,
				Damage = hit.Damage,
				Health = hit.Health,
			})
		end
	end
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="127">
          <Properties>
            <string name="Name">DamageService</string>
            <string name="Source"><![CDATA[--!strict

local applied = Instance.new("BindableEvent")
local Damage = { Applied = applied.Event }
local Status = require(script.Parent.MagicStatusEffectService)
local Players = game:GetService("Players")
local DamageRules = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicDamageRules)

function Damage.apply(attacker: Model, target: Humanoid, amount: number, eventContext: any?): (number, number, boolean)
	local targetModel = target.Parent
	local attackerPlayer = Players:GetPlayerFromCharacter(attacker)
	local attackerOwnerId = attackerPlayer and attackerPlayer.UserId or attacker:GetAttribute("MagicSummonOwnerUserId")
	local targetOwnerId = targetModel and targetModel:GetAttribute("MagicSummonOwnerUserId")
	if
		target.Parent == attacker
		or target.Health <= 0
		or not target:IsDescendantOf(workspace)
		or (attackerOwnerId ~= nil and attackerOwnerId == targetOwnerId)
	then
		return 0, 0, false
	end
	local incoming = math.max(0, amount)
	incoming = DamageRules.applyOutgoingStrength(incoming, attacker:GetAttribute("MagicStrengthBonus"))
	if eventContext then
		local regionMultiplier = eventContext.RegionMultiplier
		if type(regionMultiplier) == "number" and regionMultiplier == regionMultiplier then
			incoming *= math.clamp(regionMultiplier, 0, 4)
		end
		incoming = DamageRules.applyChannel(incoming, targetModel, eventContext.DamageChannel, eventContext.Element)
	end
	local remaining, absorbed, brokenShields = Status.absorb(target, incoming)
	local dealt = 0
	local killed = false
	if remaining > 0 then
		local before = target.Health
		target:TakeDamage(remaining)
		dealt = math.max(0, before - target.Health)
		killed = before > 0 and target.Health <= 0
	end
	if dealt > 0 then
		applied:Fire(attacker, target, dealt, killed, eventContext)
	end
	for _, effect in brokenShields do
		if effect.OnBreak then
			effect.OnBreak(target)
		end
	end
	return dealt, absorbed, killed
end

return Damage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">EnemyRuntime</string>
            <string name="Source"><![CDATA[--!strict
-- Shared admission/scheduling, independent from population ownership.
local Physics = game:GetService("PhysicsService")
local Run = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Configuration.Sandbox)
local Enemy = require(script.Parent.EnemyService)
local Runtime = { Group = "SandboxStressEnemies" }
local handles: { Enemy.Handle } = {}
local started, inFlight, cursor, nextPath = false, 0, 0, 0

function Runtime.start()
	if started then
		return
	end
	started = true
	local visual, query = Config.Enemy.VisualCollisionGroup, Config.Combat.OverlapCollisionGroup
	for _, group in { Runtime.Group, visual, query } do
		if not Physics:IsCollisionGroupRegistered(group) then
			Physics:RegisterCollisionGroup(group)
		end
	end
	Physics:CollisionGroupSetCollidable(Runtime.Group, Runtime.Group, Config.StressTest.EnemyCollisions)
	Physics:CollisionGroupSetCollidable(Runtime.Group, "Default", true)
	Physics:CollisionGroupSetCollidable(visual, "Default", false)
	Physics:CollisionGroupSetCollidable(visual, Runtime.Group, false)
	Physics:CollisionGroupSetCollidable(visual, visual, false)
	Physics:CollisionGroupSetCollidable(query, visual, true)
	Physics:CollisionGroupSetCollidable(query, "Default", true)
	Physics:CollisionGroupSetCollidable(query, Runtime.Group, false)
	Run.Heartbeat:Connect(function()
		local now = os.clock()
		for i = #handles, 1, -1 do
			local handle = handles[i]
			if not handle.Model.Parent or not handle.IsAlive() then
				table.remove(handles, i)
			else
				handle.Update(now)
			end
		end
		if #handles == 0 or now < nextPath or inFlight >= Config.StressTest.MaxPathsInFlight then
			return
		end
		for _ = 1, #handles do
			cursor = cursor % #handles + 1
			local job = handles[cursor].TakePathJob()
			if job then
				inFlight += 1
				nextPath = now + 1 / Config.StressTest.PathStartsPerSecond
				task.spawn(function()
					local ok, err = pcall(job)
					inFlight -= 1
					if not ok then
						warn(err)
					end
				end)
				break
			end
		end
	end)
end

function Runtime.create(position: Vector3, folder: Folder): Enemy.Handle
	Runtime.start()
	local handle =
		Enemy.create(position, folder, Runtime.Group, (#handles % 10) * 0.01, 1 / Config.StressTest.HitQueryRate)
	table.insert(handles, handle)
	return handle
end

return Runtime
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">EnemyService</string>
            <string name="Source"><![CDATA[--!strict

local Collection = game:GetService("CollectionService")
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sandbox = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local Config = Sandbox.Enemy
local Damage = require(script.Parent.DamageService)
local HitDetection = require(script.Parent.HitDetectionService)
local AttackSelector = require(script.Parent.NascentAttackSelector)
local Enemy = {}
local hitReactions: { [Humanoid]: (string) -> () } = {}

-- One synchronous reaction for this basic enemy; no status-effect bus or registry of effects.
function Enemy.onLightHit(humanoid: Humanoid)
	local react = hitReactions[humanoid]
	if react then
		react("Minor")
	end
end

function Enemy.onHit(humanoid: Humanoid, strength: string)
	local react = hitReactions[humanoid]
	if react then
		react(strength)
	end
end

type State = "Idle" | "Chase" | "Telegraph" | "Attack" | "Recover" | "Vulnerable" | "Flinch" | "Dead"

-- One local placeholder rig, with no asset request, animation package, or spawn manager.
local function createRig(
	position: Vector3,
	container: Folder,
	collisionGroup: string
): (Model, Humanoid, BasePart, TextLabel, (string, number) -> ())
	local model = Instance.new("Model")
	model.Name = "Stage1Enfleshed"
	Collection:AddTag(model, "Enfleshed")
	local function part(name: string, size: Vector3, offset: Vector3, color: Color3?): Part
		local result = Instance.new("Part")
		result.Name = name
		result.Size = size
		result.Position = position + offset
		result.Color = color or Color3.fromRGB(130, 65, 70)
		result.Material = Enum.Material.SmoothPlastic
		result.CanCollide = false
		result.CanTouch = false
		result.Massless = name ~= "HumanoidRootPart"
		result.CollisionGroup = Config.VisualCollisionGroup
		result.Parent = model
		return result
	end
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.zero)
	root.Transparency = 1
	local torso = part("Torso", Vector3.new(3.2, 3.7, 1.75), Vector3.new(0, 0.3, 0), Color3.fromRGB(94, 42, 52))
	local head = part("Head", Vector3.new(1.9, 2.15, 1.8), Vector3.new(-0.18, 2.75, -0.35), Color3.fromRGB(145, 72, 76))
	head.Shape = Enum.PartType.Ball
	local function joint(name: string, parent: BasePart, limb: BasePart): Motor6D
		local motor = Instance.new("Motor6D")
		motor.Name = name
		motor.Part0 = parent
		motor.Part1 = limb
		motor.C0 = parent.CFrame:ToObjectSpace(limb.CFrame)
		motor.Parent = parent
		return motor
	end
	local rootJoint = joint("RootJoint", root, torso)
	local neck = joint("Neck", torso, head)
	local leftShoulder = joint(
		"Left Shoulder",
		torso,
		part("Left Arm", Vector3.new(1.45, 3.7, 1.3), Vector3.new(-2.25, 0.05, -0.15), Color3.fromRGB(121, 55, 71))
	)
	local rightShoulder = joint(
		"Right Shoulder",
		torso,
		part("Right Arm", Vector3.new(1.8, 4.5, 1.55), Vector3.new(2.4, -0.25, -0.5), Color3.fromRGB(151, 61, 67))
	)
	local leftHip = joint(
		"Left Hip",
		torso,
		part("Left Leg", Vector3.new(1.2, 3, 1.2), Vector3.new(-0.65, -2.9, 0), Color3.fromRGB(90, 42, 55))
	)
	local rightHip = joint(
		"Right Hip",
		torso,
		part("Right Leg", Vector3.new(1.2, 3, 1.2), Vector3.new(0.65, -2.9, 0), Color3.fromRGB(90, 42, 55))
	)
	-- The humanoid joints remain the animatable foundation. These welded growths
	-- only distort the silhouette into an asymmetrical, once-human Nascent.
	local function growth(name: string, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?)
		local piece = part(name, size, Vector3.zero, color)
		piece.Shape = shape or Enum.PartType.Block
		piece.CFrame = torso.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = torso
		weld.Part1 = piece
		weld.Parent = piece
	end
	growth(
		"ShoulderGrowth",
		Vector3.new(2.25, 1.45, 2.1),
		CFrame.new(-1.35, 1.05, 0.15),
		Color3.fromRGB(112, 49, 62),
		Enum.PartType.Ball
	)
	growth(
		"RibGrowth",
		Vector3.new(1.15, 2.4, 0.75),
		CFrame.new(1.5, -0.2, -0.6) * CFrame.Angles(0, 0, -0.35),
		Color3.fromRGB(128, 57, 62)
	)
	growth(
		"BackMass",
		Vector3.new(2.4, 2.7, 1.25),
		CFrame.new(0.5, 0.1, 1.1) * CFrame.Angles(0.2, 0.25, 0),
		Color3.fromRGB(69, 31, 42),
		Enum.PartType.Ball
	)
	growth(
		"JawGrowth",
		Vector3.new(1.4, 0.65, 1.1),
		CFrame.new(-0.1, 1.45, -0.85),
		Color3.fromRGB(173, 83, 83),
		Enum.PartType.Ball
	)
	local hull = Instance.new("Part")
	hull.Name = "CollisionHull"
	hull.Shape = Enum.PartType.Cylinder
	-- Cylinders run along local X; rotate upright. The flat cap is above normal jump height.
	hull.Size = Vector3.new(Config.CollisionHull.Height, Config.CollisionHull.Diameter, Config.CollisionHull.Diameter)
	hull.CFrame = root.CFrame * CFrame.new(0, Config.CollisionHull.CenterOffsetY, 0) * CFrame.Angles(0, 0, math.pi / 2)
	hull.Transparency = 1
	hull.Massless = true
	hull.CanCollide = true
	hull.CanTouch = false
	hull.CollisionGroup = collisionGroup
	hull.CustomPhysicalProperties = PhysicalProperties.new(0.7, Config.CollisionHull.Friction, 0, 100, 100)
	hull.Parent = model
	local hullWeld = Instance.new("WeldConstraint")
	hullWeld.Part0 = root
	hullWeld.Part1 = hull
	hullWeld.Parent = hull
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R6
	humanoid.HipHeight = 0
	humanoid.MaxHealth = Config.Health
	humanoid.Health = Config.Health
	humanoid.WalkSpeed = Config.WalkSpeed
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model
	model.PrimaryPart = root
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(240, 48)
	gui.StudsOffset = Vector3.new(0, 2, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 55
	gui.Parent = head
	local label = Instance.new("TextLabel")
	label.Name = "NameLabel"
	label.Size = UDim2.fromScale(1, 0.5)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.TextSize = 16
	label.Parent = gui
	local bar = Instance.new("Frame")
	bar.Name = "HealthBack"
	bar.Size = UDim2.fromScale(0.7, 0.14)
	bar.Position = UDim2.fromScale(0.15, 0.62)
	bar.BorderSizePixel, bar.BackgroundColor3 = 0, Color3.fromRGB(20, 20, 20)
	bar.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "HealthFill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BorderSizePixel, fill.BackgroundColor3 = 0, Color3.fromRGB(155, 58, 68)
	fill.Parent = bar
	model.Parent = container
	root:SetNetworkOwner(nil)
	local function pose(
		state: string,
		now: number,
		attack: string,
		step: number,
		desperate: boolean,
		majorFlinch: boolean
	)
		local breath = math.sin(now * (if desperate then 6 else 3))
		rootJoint.Transform = CFrame.new(0, breath * 0.055, 0.12) * CFrame.Angles(-0.16, 0, 0)
		neck.Transform = CFrame.Angles(0.18, breath * 0.1, -0.08)
		leftShoulder.Transform = CFrame.Angles(0.15, 0, 0.28)
		rightShoulder.Transform = CFrame.Angles(0.32, 0, -0.34)
		leftHip.Transform = CFrame.new()
		rightHip.Transform = CFrame.new()
		if state == "Chase" then
			local stride = math.sin(now * (if desperate then 13 else 10)) * 0.72
			rootJoint.Transform *= CFrame.Angles(-0.22, 0, 0)
			leftShoulder.Transform = CFrame.Angles(stride + 0.35, 0, 0.35)
			rightShoulder.Transform = CFrame.Angles(-stride - 0.6, 0, -0.52)
			leftHip.Transform = CFrame.Angles(-stride, 0, 0)
			rightHip.Transform = CFrame.Angles(stride, 0, 0)
		elseif state == "Telegraph" then
			if attack == "PredatoryLunge" then
				rootJoint.Transform = CFrame.new(0, -0.25, 0.45) * CFrame.Angles(0.52, 0, 0)
				leftShoulder.Transform = CFrame.Angles(-1.4, 0, 0.6)
				rightShoulder.Transform = CFrame.Angles(-1.6, 0, -0.7)
			elseif attack == "FrenziedChain" then
				rootJoint.Transform = CFrame.Angles(-0.38, 0, if step % 2 == 0 then -0.2 else 0.2)
				leftShoulder.Transform = CFrame.Angles(-1.05, 0, 0.7)
				rightShoulder.Transform = CFrame.Angles(-0.55, 0, -0.75)
			elseif attack == "MaulingCombination" then
				rootJoint.Transform = CFrame.Angles(-0.34, 0, if step == 3 then 0.25 else -0.16)
				leftShoulder.Transform = CFrame.Angles(-0.75, 0, 0.55)
				rightShoulder.Transform = CFrame.Angles(-1.1, 0, -0.55)
			else
				rootJoint.Transform = CFrame.Angles(-0.28, 0, 0)
				leftShoulder.Transform = CFrame.Angles(-0.65, 0, 0.45)
				rightShoulder.Transform = CFrame.Angles(-1.3, 0, -0.5)
			end
		elseif state == "Attack" then
			rootJoint.Transform = CFrame.new(0, 0, -0.25) * CFrame.Angles(-0.28, 0, 0)
			if attack == "FrenziedChain" then
				if step == 1 then
					rightShoulder.Transform = CFrame.Angles(1.5, 0, -0.6)
				elseif step == 2 then
					leftShoulder.Transform = CFrame.Angles(1.35, 0, 0.75)
				elseif step == 3 then
					rightShoulder.Transform = CFrame.Angles(1.1, 0, 0.8)
				else
					rootJoint.Transform *= CFrame.Angles(-0.28, 0, 0.35)
					leftShoulder.Transform = CFrame.Angles(1.5, 0, 1)
					rightShoulder.Transform = CFrame.Angles(1.55, 0, -0.8)
				end
			elseif attack == "PredatoryLunge" then
				rootJoint.Transform = CFrame.new(0, 0.15, -0.5) * CFrame.Angles(-0.55, 0, 0)
				leftShoulder.Transform = CFrame.Angles(1.2, 0, 0.6)
				rightShoulder.Transform = CFrame.Angles(1.35, 0, -0.7)
			elseif attack == "MaulingCombination" then
				leftShoulder.Transform = CFrame.Angles(if step == 2 then 0.55 else 1.15, 0, 0.8)
				rightShoulder.Transform = CFrame.Angles(if step == 3 then 1.65 else 0.85, 0, -0.8)
			else
				rightShoulder.Transform = CFrame.Angles(1.35, 0, -0.35)
				leftShoulder.Transform = CFrame.Angles(0.75, 0, 0.42)
			end
		elseif state == "Vulnerable" then
			rootJoint.Transform = CFrame.new(0, -0.3, 0.38) * CFrame.Angles(0.48, 0, 0.35)
			leftShoulder.Transform = CFrame.Angles(0.9, 0, 1.1)
			rightShoulder.Transform = CFrame.Angles(0.75, 0, -1.15)
		elseif state == "Flinch" then
			rootJoint.Transform =
				CFrame.Angles(if majorFlinch then 0.45 else 0.16, 0, if majorFlinch then -0.45 else -0.16)
			leftShoulder.Transform = CFrame.Angles(0.65, 0, 0.8)
			rightShoulder.Transform = CFrame.Angles(0.65, 0, -0.8)
		elseif state == "Dead" then
			rootJoint.Transform = CFrame.new(0, -1.1, 0.55) * CFrame.Angles(1.25, 0, -0.5)
		end
	end
	return model, humanoid, root, label, pose
end

export type Handle = {
	Model: Model,
	Update: (number) -> (),
	IsAlive: () -> boolean,
	Destroy: () -> (),
	TakePathJob: () -> (() -> ())?,
	HasPendingPath: () -> boolean,
}

function Enemy.create(
	position: Vector3,
	container: Folder,
	collisionGroup: string,
	thinkOffset: number,
	hitInterval: number
): Handle
	local model, humanoid, root, label, pose = createRig(position, container, collisionGroup)
	local state: State = "Idle"
	local target: Instance? = nil
	local nextThink = os.clock() + thinkOffset
	local nextHit = 0
	local activeAt, activeUntil, recoverUntil = 0, 0, 0
	local activeAttack: any? = nil
	local attackName = ""
	local attackStep, attackCount = 0, 0
	local attackHit = false
	local attackSerial = 0
	local lastAttack = ""
	local flinchUntil = 0
	local flinchMajor = false
	local flinchAfterAttack = false
	local resumeRecovery = false
	local committedOrigin = root.CFrame
	local committedBox = root.CFrame
	local hitTargets: { [Humanoid]: boolean } = {}
	local debugBox: Part? = nil
	local debugHighlight: Highlight? = nil
	local connections: { RBXScriptConnection } = {}
	local nav = Config.Navigation
	local path: Path? = nil
	local blockedConnection: RBXScriptConnection? = nil
	local waypoints: { PathWaypoint } = {}
	local waypointIndex = 1
	local pathGoal: Vector3? = nil
	local generation = 0
	local computing = false
	local pendingPath: (() -> ())? = nil
	local nextPath = 0
	local progressPosition = root.Position
	local progressAt = 0
	local stuck = false
	local lastUpdateAt = os.clock()

	local function turnToward(other: BasePart, maxRadians: number, pivotRadians: number?): boolean
		local flatTarget = Vector3.new(other.Position.X, root.Position.Y, other.Position.Z) - root.Position
		if flatTarget.Magnitude < 0.01 then
			return false
		end
		local current = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		if current.Magnitude < 0.01 then
			return false
		end
		current = current.Unit
		local desired = flatTarget.Unit
		local signed = math.atan2(current:Cross(desired).Y, math.clamp(current:Dot(desired), -1, 1))
		if pivotRadians and math.abs(signed) >= Config.Turning.PivotAngle then
			maxRadians = math.max(maxRadians, pivotRadians)
		end
		local turn = math.clamp(signed, -maxRadians, maxRadians)
		root.CFrame = CFrame.lookAt(root.Position, root.Position + current) * CFrame.Angles(0, turn, 0)
		return true
	end

	local function combatTurnRate(other: BasePart): number
		local distance = (other.Position - root.Position).Magnitude
		local turning = Config.Turning
		if distance <= turning.VeryCloseDistance then
			return turning.VeryCloseTurnRate
		elseif distance <= turning.CloseCombatDistance then
			return turning.CloseCombatTurnRate
		elseif distance <= turning.MidRangeDistance then
			return turning.MidRangeTurnRate
		end
		return turning.ChaseTurnRate
	end

	local function clearPath()
		pendingPath = nil
		model:SetAttribute("PathQueued", false)
		generation += 1 -- Any yielding ComputeAsync result from an earlier state is obsolete.
		if blockedConnection then
			blockedConnection:Disconnect()
			blockedConnection = nil
		end
		if path then
			path:Destroy()
			path = nil
		end
		waypoints = {}
		pathGoal = nil
		waypointIndex = 1
	end

	local function clearDebug()
		if debugBox then
			debugBox:Destroy()
			debugBox = nil
		end
		if debugHighlight then
			debugHighlight:Destroy()
			debugHighlight = nil
		end
	end

	local function display()
		label.Text = if Config.DebugLabels
			then string.format(
				"%s  %d/%d\n%s",
				model:GetAttribute("SandboxLabel") or "Nascent",
				humanoid.Health,
				humanoid.MaxHealth,
				state
			)
			else "Nascent"
		local fill = label.Parent
			and label.Parent:FindFirstChild("HealthBack")
			and label.Parent.HealthBack:FindFirstChild("HealthFill")
		if fill and fill:IsA("Frame") then
			fill.Size = UDim2.fromScale(math.max(0, humanoid.Health / humanoid.MaxHealth), 1)
		end
		model:SetAttribute("SandboxState", state)
		model:SetAttribute("NascentAttack", attackName)
		model:SetAttribute("NascentVulnerable", state == "Vulnerable")
		model:SetAttribute("NascentDesperate", humanoid.Health / humanoid.MaxHealth <= Config.DesperateHealthFraction)
	end

	local function setState(value: State)
		if state ~= value then
			state = value
			display()
		end
	end

	local function stopMoving()
		humanoid:MoveTo(root.Position)
		humanoid:Move(Vector3.zero)
	end

	local function targetRoot(subject: Instance?): BasePart?
		local character = if subject and subject:IsA("Player")
			then subject.Character
			elseif subject and subject:IsA("Model") then subject
			else nil
		if subject and subject:IsA("Player") and not subject:GetAttribute("OpeningComplete") then
			return nil
		end
		local health = if character then character:FindFirstChildOfClass("Humanoid") else nil
		local result = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if health and health.Health > 0 and result and result:IsA("BasePart") and result:IsDescendantOf(workspace) then
			return result
		end
		return nil
	end

	local function rayParams(character: Instance): RaycastParams
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { container, character }
		params.RespectCanCollide = true
		return params
	end

	local function visible(other: BasePart): boolean
		return workspace:Raycast(root.Position, other.Position - root.Position, rayParams(other.Parent :: Instance))
			== nil
	end

	local function die()
		if state == "Dead" then
			return
		end
		setState("Dead")
		pose("Dead", os.clock(), attackName, attackStep, false, false)
		hitReactions[humanoid] = nil
		clearPath()
		clearDebug()
		target = nil
		hitTargets = {}
		stopMoving()
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = true
		for _, connection in connections do
			connection:Disconnect()
		end
		-- The temporary coordinator retires this handle and removes the corpse.
		for _, item in model:GetDescendants() do
			if item:IsA("BasePart") then
				item.CanCollide = false
				item.CanQuery = false
			end
		end
	end

	local function beginFlinch(now: number, keepRecovery: boolean, duration: number?, major: boolean?)
		clearPath()
		clearDebug()
		stopMoving()
		humanoid.AutoRotate = false
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = true
		activeAt, activeUntil = 0, 0
		activeAttack = nil
		hitTargets = {}
		flinchAfterAttack = false
		flinchMajor = major == true
		resumeRecovery = keepRecovery
		if not keepRecovery then
			recoverUntil = 0
		end
		flinchUntil = now + (duration or Config.Reactions.Significant.Flinch)
		setState("Flinch")
	end

	hitReactions[humanoid] = function(strength: string)
		if state == "Dead" or humanoid.Health <= 0 then
			return
		end
		local reaction = Config.Reactions[strength] or Config.Reactions.Minor
		local now = os.clock()
		if state == "Vulnerable" then
			reaction = Config.Reactions.Major
		end
		if reaction.Flinch <= 0 then
			return
		end
		local committed = (state == "Telegraph" or state == "Attack") and now >= activeAt
		if committed and now < activeUntil and strength ~= "Major" then
			-- An already active strike finishes; it cannot be retroactively dodged by hitting.
			flinchAfterAttack = true
			return
		end
		beginFlinch(
			now,
			state == "Recover" or committed or (state == "Flinch" and resumeRecovery),
			reaction.Flinch,
			strength == "Major" or state == "Vulnerable"
		)
	end

	local function beginAttack(other: BasePart, name: string, now: number)
		local attacks = Config.Nascent
		activeAttack = attacks[name]
		if not activeAttack then
			return
		end
		clearPath()
		stopMoving()
		humanoid.AutoRotate = false
		local facing = Vector3.new(other.Position.X, root.Position.Y, other.Position.Z)
		if (facing - root.Position).Magnitude > 0 then
			root.CFrame = CFrame.lookAt(root.Position, facing)
		end
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = true -- Prevent contact physics from moving the committed strike.
		attackName = name
		attackStep = 1
		attackCount = activeAttack.Count or 1
		attackHit = false
		attackSerial += 1
		committedOrigin = root.CFrame
		committedBox = committedOrigin * CFrame.new(0, 0, -activeAttack.Offset)
		activeAt = now + activeAttack.Telegraph
		activeUntil = activeAt + activeAttack.Active
		local desperate = humanoid.Health / humanoid.MaxHealth <= Config.DesperateHealthFraction
		recoverUntil = activeUntil
			+ activeAttack.Recovery * (if desperate then Config.Nascent.DesperateRecoveryMultiplier else 1)
		hitTargets = {}
		nextHit = activeAt
		setState("Telegraph")
		if Config.DebugTelegraph and Config.DebugNascent then
			local box = Instance.new("Part")
			box.Name = "TemporaryEnemyAttackDebug"
			box.Size = activeAttack.Size
			box.CFrame = committedBox
			box.Anchored = true
			box.CanCollide = false
			box.CanTouch = false
			box.CanQuery = false
			box.Material = Enum.Material.Neon
			box.Color = Color3.fromRGB(255, 170, 40)
			box.Transparency = 0.7
			box.Parent = workspace
			debugBox = box
			local highlight = Instance.new("Highlight")
			highlight.Name = "TemporaryTelegraphDebug"
			highlight.Adornee = model
			highlight.FillColor = box.Color
			highlight.FillTransparency = 0.5
			highlight.Parent = model
			debugHighlight = highlight
		end
	end

	local function chooseAttack(distance: number): string?
		local desperate = humanoid.Health / humanoid.MaxHealth <= Config.DesperateHealthFraction
		return AttackSelector.choose(Config.Nascent, distance, lastAttack, attackSerial, desperate)
	end

	local function requestPath(_other: BasePart, now: number)
		if computing or pendingPath or now < nextPath then
			return
		end
		-- Keep a usable old route while waiting for the shared round-robin budget.
		pendingPath = function()
			local other = targetRoot(target)
			if state ~= "Chase" or not other then
				computing = false
				return
			end
			local token = generation
			local destination = other.Position
			local requestedTarget = target
			nextPath = os.clock() + nav.RepathInterval
			local candidate = PathfindingService:CreatePath({
				AgentRadius = nav.AgentRadius,
				AgentHeight = nav.AgentHeight,
				AgentCanJump = nav.AgentCanJump,
				WaypointSpacing = nav.WaypointSpacing,
			})
			local ok = pcall(function()
				candidate:ComputeAsync(root.Position, destination)
			end)
			computing = false
			local currentRoot = targetRoot(target)
			if
				not ok
				or candidate.Status ~= Enum.PathStatus.Success
				or state ~= "Chase"
				or token ~= generation
				or target ~= requestedTarget
				or not currentRoot
				or (currentRoot.Position - destination).Magnitude > nav.TargetMoveThreshold
			then
				candidate:Destroy()
				return
			end
			clearPath()
			path = candidate
			pathGoal = destination
			waypoints = candidate:GetWaypoints()
			waypointIndex = 2
			blockedConnection = candidate.Blocked:Connect(function(index)
				if index >= waypointIndex then
					clearPath()
					stopMoving()
				end
			end)
		end
		model:SetAttribute("PathQueued", true)
	end

	local function chase(other: BasePart, now: number, frameDelta: number)
		local targetDistance = (other.Position - root.Position).Magnitude
		local closeCombat = targetDistance <= Config.Turning.CloseCombatDistance
		humanoid.AutoRotate = not closeCombat
		if closeCombat then
			turnToward(other, combatTurnRate(other) * frameDelta, Config.Turning.PivotTurnRate * frameDelta)
		end
		if targetDistance <= Config.Turning.CloseStandoffDistance + nav.WaypointTolerance then
			-- Holding the intended melee standoff is progress, not a navigation stall.
			progressPosition = root.Position
			progressAt = now
			stuck = false
		elseif (root.Position - progressPosition).Magnitude >= nav.ProgressDistance then
			progressPosition = root.Position
			progressAt = now
			stuck = false
		elseif now - progressAt >= nav.StuckTime then
			stuck = true
			clearPath()
			progressAt = now
		end
		local travel = other.Position - root.Position
		local direct = workspace:Blockcast(
			root.CFrame * CFrame.new(0, Config.CollisionHull.CenterOffsetY, 0),
			nav.SweepSize,
			travel,
			rayParams(other.Parent :: Instance)
		) == nil
		if direct and not stuck then
			if path or computing or pendingPath then
				clearPath()
			end
			local horizontal = Vector3.new(other.Position.X - root.Position.X, 0, other.Position.Z - root.Position.Z)
			if horizontal.Magnitude <= Config.Turning.CloseStandoffDistance then
				-- At melee range, face and pressure instead of running through prey.
				stopMoving()
			else
				local destination = other.Position - horizontal.Unit * Config.Turning.CloseStandoffDistance
				humanoid:MoveTo(destination)
			end
			return
		end
		if not pathGoal or (other.Position - pathGoal).Magnitude >= nav.TargetMoveThreshold then
			requestPath(other, now)
		end
		local waypoint = waypoints[waypointIndex]
		while waypoint do
			local delta = waypoint.Position - root.Position
			if Vector3.new(delta.X, 0, delta.Z).Magnitude > nav.WaypointTolerance then
				break
			end
			waypointIndex += 1
			waypoint = waypoints[waypointIndex]
		end
		if waypoint then
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
			humanoid:MoveTo(waypoint.Position)
		else
			stopMoving()
			if path then
				clearPath()
			end
			requestPath(other, now)
		end
	end

	table.insert(connections, model:GetAttributeChangedSignal("SandboxLabel"):Connect(display))
	table.insert(connections, humanoid.HealthChanged:Connect(display))
	table.insert(connections, humanoid.Died:Connect(die))
	table.insert(connections, model.Destroying:Connect(die))
	local function update(now: number)
		if humanoid.Health <= 0 or not model:IsDescendantOf(workspace) then
			die()
			return
		end
		local frameDelta = math.min(0.1, math.max(0, now - lastUpdateAt))
		lastUpdateAt = now
		pose(
			state,
			now,
			attackName,
			attackStep,
			humanoid.Health / humanoid.MaxHealth <= Config.DesperateHealthFraction,
			flinchMajor
		)
		-- Timers are cheap; hit queries are capped separately from staggered navigation.
		if state == "Telegraph" or state == "Attack" then
			local other = targetRoot(target)
			if state == "Telegraph" and other and activeAttack then
				if activeAttack.TrackingByStrike then
					local tracking = activeAttack.TrackingByStrike[attackStep] or 0
					if
						(other.Position - root.Position).Magnitude <= activeAttack.TrackingEscapeRange
						and tracking > 0
					then
						turnToward(other, activeAttack.TrackingTurnRate * tracking * frameDelta)
					end
				elseif activeAttack.TelegraphTurnRate then
					local windupProgress =
						math.clamp((now - (activeAt - activeAttack.Telegraph)) / activeAttack.Telegraph, 0, 1)
					local rate = if windupProgress < (activeAttack.CommitFraction or 1)
						then activeAttack.TelegraphTurnRate
						else activeAttack.CommitTurnRate or 0
					turnToward(other, rate * frameDelta)
				end
			end
			if now >= activeUntil then
				if flinchAfterAttack then
					clearDebug()
					beginFlinch(now, true)
				elseif attackStep < attackCount then
					attackStep += 1
					hitTargets = {}
					activeAt = now + (activeAttack.StepGap or 0)
					activeUntil = activeAt + activeAttack.Active
					setState("Telegraph")
				elseif attackName == "FrenziedChain" then
					clearDebug()
					recoverUntil = now + activeAttack.Recovery
					setState("Vulnerable")
				elseif attackName == "PredatoryLunge" and not attackHit then
					clearDebug()
					recoverUntil = now + activeAttack.MissRecovery
					setState("Vulnerable")
				elseif attackName == "RushingStrike" and not attackHit and attackSerial % 2 == 0 then
					clearDebug()
					beginAttack(other or root, "ReversalSwipe", now)
				else
					clearDebug()
					lastAttack = attackName
					activeAttack = nil
					setState("Recover")
				end
			elseif now >= activeAt then
				if state ~= "Attack" then
					setState("Attack")
					-- Contact begins with the visible strike pose, before the first
					-- server hit query runs on this active window.
					pose(
						"Attack",
						now,
						attackName,
						attackStep,
						humanoid.Health / humanoid.MaxHealth <= Config.DesperateHealthFraction,
						flinchMajor
					)
					committedOrigin = root.CFrame
					committedBox = committedOrigin * CFrame.new(0, 0, -(activeAttack and activeAttack.Offset or 0))
					if debugBox then
						debugBox.Color = Color3.fromRGB(255, 55, 55)
					end
					if debugHighlight then
						debugHighlight.FillColor = Color3.fromRGB(255, 55, 55)
					end
				end
				if other and activeAttack then
					if activeAttack.TrackingByStrike then
						local tracking = activeAttack.TrackingByStrike[attackStep] or 0
						if
							(other.Position - root.Position).Magnitude <= activeAttack.TrackingEscapeRange
							and tracking > 0
						then
							turnToward(other, activeAttack.TrackingTurnRate * tracking * frameDelta)
						end
					elseif activeAttack.CommitTurnRate then
						turnToward(other, activeAttack.CommitTurnRate * frameDelta)
					end
				end
				if activeAttack and activeAttack.Travel > 0 then
					local travel = root.CFrame.LookVector
						* (activeAttack.Travel * math.min(1, hitInterval / activeAttack.Active))
					local obstacle = workspace:Blockcast(
						root.CFrame,
						Config.CollisionHull.Diameter * Vector3.new(1, 1, 1),
						travel,
						rayParams(model)
					)
					if obstacle then
						travel = travel.Unit * math.max(0, obstacle.Distance - 0.2)
					end
					root.CFrame += travel
					committedOrigin = root.CFrame
					committedBox = committedOrigin * CFrame.new(0, 0, -activeAttack.Offset)
					if debugBox then
						debugBox.CFrame = committedBox
					end
				end
				if now < nextHit or not activeAttack then
					return
				end
				nextHit = now + hitInterval
				for _, victim in
					HitDetection.find(model, committedOrigin, committedBox, activeAttack.Size, {
						OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
						RequireLineOfSight = true,
						CanTarget = function(character)
							return Players:GetPlayerFromCharacter(character) ~= nil
								or Collection:HasTag(character, "CityHuman")
						end,
					})
				do
					if not hitTargets[victim] then
						hitTargets[victim] = true
						local damage = activeAttack.Damage
						Damage.apply(model, victim, if typeof(damage) == "table" then damage[attackStep] else damage)
						attackHit = true
					end
				end
			end
			return
		end
		if state == "Flinch" then
			if now < flinchUntil then
				return
			end
			-- Reuse release logic below; preserve an existing recovery instead of shortening it.
			if not resumeRecovery then
				recoverUntil = 0
			end
			setState("Recover")
		end
		if state == "Vulnerable" then
			if now < recoverUntil then
				return
			end
			activeAttack = nil
			lastAttack = attackName
			root.Anchored = false
			root:SetNetworkOwner(nil)
			humanoid.AutoRotate = true
			setState("Chase")
		end
		if state == "Recover" then
			if now < recoverUntil then
				return
			end
			root.Anchored = false
			root:SetNetworkOwner(nil)
			humanoid.AutoRotate = true
			progressPosition = root.Position
			progressAt = now
			setState("Chase")
		end
		if state == "Chase" then
			local chaseTarget = targetRoot(target)
			if
				chaseTarget
				and (chaseTarget.Position - root.Position).Magnitude <= Config.Turning.CloseCombatDistance
			then
				humanoid.AutoRotate = false
				turnToward(
					chaseTarget,
					combatTurnRate(chaseTarget) * frameDelta,
					Config.Turning.PivotTurnRate * frameDelta
				)
			elseif chaseTarget then
				humanoid.AutoRotate = true
			end
		end
		if now < nextThink then
			return
		end
		nextThink = now + Config.ThinkInterval
		local other = targetRoot(target)
		local order = model:FindFirstChild("ObjectiveTarget")
		local objective = if order and order:IsA("ObjectValue") then order.Value else nil
		if
			not other or (target ~= objective and (other.Position - root.Position).Magnitude > Config.DisengageRange)
		then
			target = nil
			other = nil
			clearPath()
			stopMoving()
			setState("Idle")
			local nearest = Config.DetectionRange
			local candidates: { Instance } = {}
			for _, player in Players:GetPlayers() do
				table.insert(candidates, player)
			end
			for _, human in Collection:GetTagged("CityHuman") do
				table.insert(candidates, human)
			end
			for _, player in candidates do
				local candidate = targetRoot(player)
				if candidate then
					local distance = (candidate.Position - root.Position).Magnitude
					if distance <= nearest and visible(candidate) then
						nearest = distance
						target = player
						other = candidate
					end
				end
			end
			if not other and objective then
				target, other = objective, targetRoot(objective)
			end
			if other then
				progressAt = now
				progressPosition = root.Position
				stuck = false
				setState("Chase")
			end
		end
		if other then
			local choice = if visible(other) then chooseAttack((other.Position - root.Position).Magnitude) else nil
			if choice then
				beginAttack(other, choice, now)
			else
				chase(other, now, frameDelta)
			end
		end
	end
	display()
	return {
		Model = model,
		Update = update,
		IsAlive = function(): boolean
			return state ~= "Dead"
		end,
		HasPendingPath = function(): boolean
			return pendingPath ~= nil
		end,
		TakePathJob = function(): (() -> ())?
			local job = pendingPath
			if not job or state == "Dead" then
				return nil
			end
			pendingPath = nil
			model:SetAttribute("PathQueued", false)
			computing = true
			return function()
				local ok, err = pcall(job)
				computing = false -- Release even if creating or processing a path raises an error.
				if not ok then
					error(tostring(err))
				end
			end
		end,
		Destroy = function()
			die()
			model:Destroy()
		end,
	}
end

return Enemy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="130">
          <Properties>
            <string name="Name">EquipmentService</string>
            <string name="Source"><![CDATA[--!strict

-- Server-owned prototype equipment state. It selects items/profiles but never
-- executes weapon combat; magic remains in MagicService and melee in CombatService.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Definitions = require(Shared.Configuration.Items)
local Equipment = {}

type Slot = "PrimaryWeapon" | "SecondaryWeapon" | "Utility"
type State = {
	Owned: { [string]: boolean },
	PrimaryWeapon: string?,
	SecondaryWeapon: string?,
	Utility: string?,
	ActiveSlot: Slot,
}

local states: { [Player]: State } = {}

local function itemInSlot(state: State, slot: Slot): string?
	return state[slot]
end

local function publish(player: Player, state: State, remote: RemoteEvent)
	player:SetAttribute("PrimaryWeapon", state.PrimaryWeapon)
	player:SetAttribute("SecondaryWeapon", state.SecondaryWeapon)
	player:SetAttribute("Utility", state.Utility)
	player:SetAttribute("ActiveEquipmentSlot", state.ActiveSlot)
	remote:FireClient(player, {
		Kind = "Equipment",
		PrimaryWeapon = state.PrimaryWeapon,
		SecondaryWeapon = state.SecondaryWeapon,
		Utility = state.Utility,
		ActiveSlot = state.ActiveSlot,
	})
end

local function attachVisual(player: Player, state: State)
	local character = player.Character
	if not character then
		return
	end
	local previous = character:FindFirstChild("SandboxEquippedWeapon")
	if previous then
		previous:Destroy()
	end
	local itemId = itemInSlot(state, state.ActiveSlot)
	local item = if itemId then Definitions.Items[itemId] else nil
	if not item or not item.Visual then
		return
	end
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return
	end
	local visual = item.Visual
	local part = Instance.new("Part")
	part.Name = "SandboxEquippedWeapon"
	part.Size = visual.Size
	part.Color = visual.Color
	part.Material = visual.Material
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CFrame = hand.CFrame * visual.Offset
	part.Parent = character
	if visual.MuzzleOffset then
		local muzzle = Instance.new("Attachment")
		muzzle.Name = "Muzzle"
		muzzle.CFrame = visual.MuzzleOffset
		muzzle.Parent = part
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = part
	weld.Parent = part
end

function Equipment.bind(player: Player)
	states[player] = {
		Owned = {},
		PrimaryWeapon = nil,
		SecondaryWeapon = nil,
		Utility = nil,
		ActiveSlot = "SecondaryWeapon", -- Preserve existing melee controls on spawn.
	}
end

function Equipment.chooseStarter(player: Player, path: string, remote: RemoteEvent): boolean
	local state = states[player]
	if not state or next(state.Owned) ~= nil or (path ~= "Melee" and path ~= "Magic") then
		return false
	end
	local id = if path == "Melee" then "RecruitMeleeWeapon" else "RecruitMagicWeapon"
	local slot: Slot = if path == "Melee" then "SecondaryWeapon" else "PrimaryWeapon"
	state.Owned[id] = true
	state[slot] = id
	state.ActiveSlot = slot
	attachVisual(player, state)
	publish(player, state, remote)
	return true
end

function Equipment.characterAdded(player: Player, remote: RemoteEvent)
	local state = states[player]
	if state then
		attachVisual(player, state)
		publish(player, state, remote)
	end
end

function Equipment.switch(player: Player, slot: any, remote: RemoteEvent): boolean
	local state = states[player]
	if slot ~= "PrimaryWeapon" and slot ~= "SecondaryWeapon" and slot ~= "Utility" then
		return false
	end
	if not state then
		return false
	end
	local itemId = itemInSlot(state, slot :: Slot)
	if not itemId or not state.Owned[itemId] or not Definitions.Items[itemId] then
		return false
	end
	state.ActiveSlot = slot
	attachVisual(player, state)
	publish(player, state, remote)
	return true
end

function Equipment.magicCast(player: Player, action: any): (string?, { Origin: Vector3 }?)
	local state = states[player]
	if not state or state.ActiveSlot ~= "PrimaryWeapon" or (action ~= "Primary" and action ~= "Area") then
		return nil, nil
	end
	local itemId = state.PrimaryWeapon
	local item = if itemId and state.Owned[itemId] then Definitions.Items[itemId] else nil
	if not item or item.ItemType ~= "Weapon" or item.WeaponType ~= "MagicFocus" then
		return nil, nil
	end
	local selectedProfileId = require(script.Parent.MagicDiscoveryService).awakeningProfileId(player)
	local profileId = selectedProfileId or item.MagicProfile
	local profile = Definitions.MagicProfiles[profileId]
	if not profile then
		return nil, nil
	end
	local weapon = player.Character and player.Character:FindFirstChild("SandboxEquippedWeapon")
	local muzzle = if weapon then weapon:FindFirstChild("Muzzle") else nil
	local context = if muzzle and muzzle:IsA("Attachment") then { Origin = muzzle.WorldPosition } else nil
	return if action == "Primary" then profile.PrimarySpellId else profile.AreaSpellId, context
end

function Equipment.freeHandCount(player: Player): number
	local state = states[player]
	if not state then
		return 0
	end
	local character = player.Character
	local handCount = 2
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rigHandCount = humanoid and humanoid:GetAttribute("MagicHandCount")
	if type(rigHandCount) == "number" and rigHandCount == rigHandCount then
		handCount = math.clamp(math.floor(rigHandCount), 0, 8)
	end
	local itemId = itemInSlot(state, state.ActiveSlot)
	local item = if itemId and state.Owned[itemId] then Definitions.Items[itemId] else nil
	local occupied = if item then item.HandsOccupied else 0
	if type(occupied) ~= "number" or occupied ~= occupied then
		occupied = if item and item.ItemType == "Weapon" then 1 else 0
	end
	return math.max(0, handCount - math.clamp(math.floor(occupied), 0, handCount))
end

function Equipment.meleeActive(player: Player): boolean
	local state = states[player]
	if not state or state.ActiveSlot ~= "SecondaryWeapon" then
		return false
	end
	local itemId = state.SecondaryWeapon
	local item = if itemId and state.Owned[itemId] then Definitions.Items[itemId] else nil
	return item ~= nil and item.ItemType == "Weapon" and item.WeaponType == "Melee"
end

function Equipment.remove(player: Player)
	states[player] = nil
end

return Equipment
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">HitDetectionService</string>
            <string name="Source"><![CDATA[--!strict

local HitDetection = {}
local Geometry = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicGeometry)

export type Rules = {
	OverlapCollisionGroup: string?,
	MaxDistance: number?,
	MinimumFacingDot: number?,
	RequireLineOfSight: boolean?,
	IncludeAttacker: boolean?,
	CanTarget: ((Model, Humanoid) -> boolean)?,
}

-- Geometry and target policy come from the caller, never from attacker identity.
function HitDetection.find(attacker: Model, origin: CFrame, hitbox: CFrame, size: Vector3, rules: Rules): { Humanoid }
	local overlap = OverlapParams.new()
	overlap.CollisionGroup = rules.OverlapCollisionGroup or "Default"
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = if rules.IncludeAttacker then {} else { attacker }
	local found: { [Humanoid]: boolean } = {}
	local targets: { Humanoid } = {}
	for _, part in workspace:GetPartBoundsInBox(hitbox, size, overlap) do
		local model = part:FindFirstAncestorOfClass("Model")
		while model and not model:FindFirstChildOfClass("Humanoid") do
			model = model:FindFirstAncestorOfClass("Model")
		end
		local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
		local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
		if
			not model
			or (model == attacker and not rules.IncludeAttacker)
			or not humanoid
			or humanoid.Health <= 0
			or not root
			or not root:IsA("BasePart")
			or found[humanoid]
		then
			continue
		end
		found[humanoid] = true
		if rules.CanTarget and not rules.CanTarget(model, humanoid) then
			continue
		end
		local delta = root.Position - origin.Position
		if rules.MaxDistance and delta.Magnitude > rules.MaxDistance then
			continue
		end
		local horizontal = Vector3.new(delta.X, 0, delta.Z)
		if
			rules.MinimumFacingDot
			and horizontal.Magnitude > 0
			and origin.LookVector:Dot(horizontal.Unit) < rules.MinimumFacingDot
		then
			continue
		end
		if rules.RequireLineOfSight and delta.Magnitude > 0.001 then
			local ray = RaycastParams.new()
			ray.FilterType = Enum.RaycastFilterType.Exclude
			ray.FilterDescendantsInstances = { attacker, model }
			ray.RespectCanCollide = true
			if workspace:Raycast(origin.Position, delta, ray) then
				continue
			end
		end
		table.insert(targets, humanoid)
	end
	return targets
end

function HitDetection.findArea(attacker: Model, origin: CFrame, shape: string, area: any, rules: Rules): { Humanoid }
	local size = Geometry.areaSize(shape, area)
	local queryFrame = Geometry.areaQueryFrame(shape, origin, area)
	local queryRules = table.clone(rules)
	local previousCanTarget = rules.CanTarget
	queryRules.CanTarget = function(model, humanoid)
		local root = model:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") or not Geometry.containsArea(shape, origin, root.Position, area) then
			return false
		end
		return not previousCanTarget or previousCanTarget(model, humanoid)
	end
	return HitDetection.find(attacker, origin, queryFrame, size, queryRules)
end

-- Sphere and cone use the same target/LOS policy as melee. They remain neutral
-- queries: callers provide geometry and target policy rather than attacker roles.
function HitDetection.findSphere(attacker: Model, origin: CFrame, radius: number, rules: Rules): { Humanoid }
	local overlap = OverlapParams.new()
	overlap.CollisionGroup = rules.OverlapCollisionGroup or "Default"
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = if rules.IncludeAttacker then {} else { attacker }
	local found: { [Humanoid]: boolean } = {}
	local targets: { Humanoid } = {}
	for _, part in workspace:GetPartBoundsInRadius(origin.Position, radius, overlap) do
		local model = part:FindFirstAncestorOfClass("Model")
		local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
		local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
		if
			not model
			or not humanoid
			or not root
			or not root:IsA("BasePart")
			or (model == attacker and not rules.IncludeAttacker)
			or humanoid.Health <= 0
			or found[humanoid]
		then
			continue
		end
		found[humanoid] = true
		local delta = root.Position - origin.Position
		if
			(rules.MaxDistance and delta.Magnitude > rules.MaxDistance)
			or (rules.CanTarget and not rules.CanTarget(model, humanoid))
		then
			continue
		end
		if rules.RequireLineOfSight and delta.Magnitude > 0.001 then
			local ray = RaycastParams.new()
			ray.FilterType = Enum.RaycastFilterType.Exclude
			ray.FilterDescendantsInstances = { attacker, model }
			ray.RespectCanCollide = true
			if workspace:Raycast(origin.Position, delta, ray) then
				continue
			end
		end
		table.insert(targets, humanoid)
	end
	return targets
end

function HitDetection.findCone(
	attacker: Model,
	origin: CFrame,
	range: number,
	minimumDot: number,
	rules: Rules
): { Humanoid }
	local result: { Humanoid } = {}
	for _, humanoid in HitDetection.findSphere(attacker, origin, range, rules) do
		local root = humanoid.Parent and humanoid.Parent:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local delta = root.Position - origin.Position
			if Geometry.withinCone(origin.LookVector, delta, minimumDot) then
				table.insert(result, humanoid)
			end
		end
	end
	return result
end

return HitDetection
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="132">
          <Properties>
            <string name="Name">LivingCityService</string>
            <string name="Source"><![CDATA[--!strict
-- A bounded population, one update loop and one shared navigation computation.
local Collection = game:GetService("CollectionService")
local Pathfinding = game:GetService("PathfindingService")
local Run = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Configuration.CityLife).NPCs
local Plan = require(Shared.Configuration.PhaseATopology)
local Spawn = require(script.Parent.WorldSpawnService)
local Damage = require(script.Parent.DamageService)
local PopulationLayout = require(script.Parent.CityPopulationLayout)
local City = {}
local entries, mobilizations = {}, {}
local folder, computing, cursor, nextPathStart = nil, false, 0, 0

local function groundedAround(point)
	for _, offset in
		{ Vector3.zero, Vector3.new(5, 0, 0), Vector3.new(-5, 0, 0), Vector3.new(0, 0, 5), Vector3.new(0, 0, -5) }
	do
		local result = Spawn.ground(point + offset, 5, 2.5)
		if result then
			return result
		end
	end
	return nil
end
local function rig(name, role, position)
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("Role", role)
	local function part(name, size, offset, color)
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame = name, size, CFrame.new(position + offset)
		p.Color, p.Material = color, Enum.Material.Fabric
		p.CanCollide, p.CanTouch = false, false
		p.Parent = model
		return p
	end
	local skin, cloth = Color3.fromRGB(157, 120, 91), Color3.fromRGB(92, 83, 67)
	if role == "Guard" or role == "Patrol" then
		cloth = Color3.fromRGB(64, 74, 71)
	end
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.zero, cloth)
	root.Transparency, root.CanCollide = 1, true
	local torso = part("Torso", Vector3.new(2, 2, 1), Vector3.zero, cloth)
	local head = part("Head", Vector3.new(2, 1, 1), Vector3.new(0, 1.5, 0), skin)
	local function joint(a, b, name)
		local motor = Instance.new("Motor6D")
		motor.Name, motor.Part0, motor.Part1 = name, a, b
		motor.C0, motor.Parent = a.CFrame:ToObjectSpace(b.CFrame), a
	end
	joint(root, torso, "RootJoint")
	joint(torso, head, "Neck")
	for _, side in { -1, 1 } do
		local prefix = if side < 0 then "Left" else "Right"
		joint(
			torso,
			part(prefix .. " Arm", Vector3.new(1, 2, 1), Vector3.new(side * 1.5, 0, 0), cloth),
			prefix .. " Shoulder"
		)
		joint(
			torso,
			part(prefix .. " Leg", Vector3.new(1, 2, 1), Vector3.new(side * 0.5, -2, 0), cloth),
			prefix .. " Hip"
		)
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.MaxHealth, humanoid.Health, humanoid.WalkSpeed = Config.Health, Config.Health, Config.Speed
	humanoid.Parent = model
	model.PrimaryPart, model.Parent = root, folder
	root:SetNetworkOwner(nil)
	Collection:AddTag(model, "CityHuman")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ObjectText, prompt.ActionText = name .. " · " .. role, "Listen"
	prompt.KeyboardKeyCode, prompt.MaxActivationDistance, prompt.RequiresLineOfSight = Enum.KeyCode.K, 8, true
	prompt.Parent = head
	prompt.Triggered:Connect(function(player)
		if humanoid.Health <= 0 or not player:GetAttribute("OpeningComplete") then
			return
		end
		local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if r and (r.Position - root.Position).Magnitude <= 10 then
			player:SetAttribute(
				"CityRemark",
				if role == "Guard" or role == "Patrol"
					then "Stay alert. We hold these streets together."
					else "Work goes on. Keep clear of the lower passages."
			)
		end
	end)
	return model, humanoid, root
end
function City.create(name, role, nodes, temporary, home)
	if not folder or #entries >= Config.MaxPopulation then
		return nil
	end
	local position = groundedAround(home or Plan.Nodes[nodes[1]])
	if not position then
		return nil
	end
	local model, humanoid, root = rig(name, role, position)
	local entry = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Role = role,
		Nodes = nodes,
		Index = 2,
		Home = position,
		NextPath = 0,
		NextHit = 0,
		NextIdle = 0,
		Temporary = temporary,
		Finished = false,
		Path = nil,
		Waypoint = 1,
	}
	table.insert(entries, entry)
	return entry
end
function City.remove(entry)
	if not entry then
		return
	end
	entry.Removed = true
	entry.Model:Destroy()
end
function City.near(point, guardsOnly)
	local nearest, distance = nil, math.huge
	for _, entry in entries do
		if
			not entry.Removed
			and entry.Humanoid.Health > 0
			and (not guardsOnly or entry.Role == "Guard" or entry.Role == "Patrol")
		then
			local d = (entry.Root.Position - point).Magnitude
			if d < distance then
				nearest, distance = entry, d
			end
		end
	end
	return nearest, distance
end
function City.mobilize(id, defense, retreat)
	mobilizations[id] = { Defense = defense, Retreat = retreat }
end
function City.release(id)
	mobilizations[id] = nil
end
local function visible(a, b, exclude)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances, params.RespectCanCollide = exclude, true
	return workspace:Raycast(a, b - a, params) == nil
end
function City.start()
	if folder or not Config.Enabled then
		return
	end
	folder = Instance.new("Folder")
	folder.Name, folder.Parent = "LivingCity", workspace
	local roster = {}
	local fronts = {}
	local geometry = workspace:FindFirstChild("LowerLayerGraybox")
	local markers = geometry and geometry:FindFirstChild("StreetFronts")
	if markers then
		local ordered = markers:GetChildren()
		table.sort(ordered, function(a, b)
			return a.Name < b.Name
		end)
		for _, marker in ordered do
			table.insert(fronts, {
				Kind = marker:GetAttribute("Archetype"),
				Enterable = marker:GetAttribute("Enterable"),
				Home = marker.Value,
			})
		end
	end
	local target = math.min(
		Config.MaxPopulation - Config.EventReserve,
		math.floor(Config.AmbientTarget * math.max(0, Config.Scale))
	)
	local definitions = PopulationLayout.build(Plan, Config.Roster, fronts, target)
	for i = 1, math.min(target, #definitions) do
		table.insert(roster, { Definition = definitions[i], Retry = 0 })
	end
	folder:SetAttribute("AmbientTarget", #roster)
	local updateCursor = 0
	local nextTick = 0
	Run.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextTick then
			return
		end
		nextTick = now + Config.Tick
		local spawnAttempts = 0
		for _, slot in roster do
			if slot.Entry and (slot.Entry.Removed or slot.Entry.Humanoid.Health <= 0) then
				slot.Entry = nil
				slot.Retry = now + Config.RespawnSeconds
			end
			if not slot.Entry and now >= slot.Retry and spawnAttempts < Config.SpawnAttemptsPerTick then
				spawnAttempts += 1
				local d = slot.Definition
				local home = if d.Position then Vector3.new(d.Position.X, d.Position.Y, d.Position.Z) else nil
				slot.Entry = City.create(d.Name, d.Role, d.Nodes, false, home)
				if slot.Entry then
					slot.Entry.Model:SetAttribute("District", d.District or "Authored")
				end
				slot.Retry = now + Config.RespawnSeconds
			end
		end
		local threats = Collection:GetTagged("Enfleshed")
		for i = #entries, 1, -1 do
			if entries[i].Removed or not entries[i].Model.Parent then
				table.remove(entries, i)
			end
		end
		local living = 0
		for _, entry in entries do
			if entry.Humanoid.Health > 0 then
				living += 1
			end
		end
		folder:SetAttribute("LivingCount", living)
		for _ = 1, math.min(Config.UpdatesPerTick, #entries) do
			updateCursor = updateCursor % #entries + 1
			local e = entries[updateCursor]
			if e.Removed or not e.Model.Parent then
				continue
			end
			if e.Humanoid.Health <= 0 then
				e.DeadAt = e.DeadAt or now
				if now - e.DeadAt > 4 then
					City.remove(e)
				end
				continue
			end
			local threat, distance = nil, Config.DangerRadius
			for _, model in threats do
				local h = model:FindFirstChildOfClass("Humanoid")
				local r = model:FindFirstChild("HumanoidRootPart")
				if h and h.Health > 0 and r then
					local d = (r.Position - e.Root.Position).Magnitude
					if d < distance and visible(e.Root.Position, r.Position, { e.Model, model }) then
						threat, distance = model, d
					end
				end
			end
			local guard = e.Role == "Guard" or e.Role == "Patrol"
			local goal = nil
			e.Humanoid.WalkSpeed = Config.Speed
			if threat then
				local r = threat.HumanoidRootPart
				if guard then
					goal = if distance <= Config.GuardRange then e.Root.Position else r.Position
					if distance <= Config.GuardRange and now >= e.NextHit then
						e.NextHit = now + Config.GuardCooldown
						Damage.apply(e.Model, threat:FindFirstChildOfClass("Humanoid"), Config.GuardDamage)
					end
				else
					e.Humanoid.WalkSpeed = Config.FleeSpeed
					local away = e.Root.Position - r.Position
					if away.Magnitude > 0 then
						goal = groundedAround(e.Root.Position + away.Unit * 16)
					end
					goal = goal or e.Home
				end
			else
				for _, orders in mobilizations do
					if (e.Home - orders.Defense).Magnitude < 350 then
						goal = (if guard then orders.Defense else orders.Retreat) + Vector3.new(0, 3, 0)
						break
					end
				end
				if not goal then
					if e.Nodes[1] == e.Nodes[2] then
						if e.Role == "Shopkeeper" or e.Role == "Guard" then
							goal = e.Home
						else
							if now >= e.NextIdle then
								e.NextIdle = now + 8
								e.IdleGoal = groundedAround(
									e.Home + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))
								) or e.Home
							end
							goal = e.IdleGoal
						end
					elseif not e.Finished then
						goal = Plan.Nodes[e.Nodes[e.Index]] + Vector3.new(0, 3, 0)
						if (goal - e.Root.Position).Magnitude < 7 then
							e.Index += 1
							e.Path = nil
							if e.Index > #e.Nodes then
								if e.Temporary then
									e.Finished = true
								else
									e.Index = 1
								end
							end
						end
					end
				end
			end
			if e.Goal and goal and (e.Goal - goal).Magnitude > 12 then
				e.Path = nil
			end
			e.Goal = goal
			if not goal or (goal - e.Root.Position).Magnitude < 3 then
				e.NeedPath = false
				e.Humanoid:MoveTo(e.Root.Position)
				continue
			end
			local params = RaycastParams.new()
			params.FilterDescendantsInstances = { folder }
			params.RespectCanCollide = true
			-- A broad sweep prevents repeated straight-line commands into door frames.
			local direction = goal - e.Root.Position
			local blocked = workspace:Blockcast(CFrame.new(e.Root.Position), Vector3.new(2, 3, 2), direction, params)
			if not blocked and math.abs(direction.Y) < 4 then
				e.Path = nil
				e.NeedPath = false
				e.Humanoid:MoveTo(goal)
			else
				e.NeedPath = true
				if e.Path then
					local waypoint = e.Path[e.Waypoint]
					if waypoint and (waypoint.Position - e.Root.Position).Magnitude < 5 then
						e.Waypoint += 1
						waypoint = e.Path[e.Waypoint]
					end
					if waypoint then
						e.Humanoid.Jump = waypoint.Action == Enum.PathWaypointAction.Jump
						e.Humanoid:MoveTo(waypoint.Position)
					end
				end
			end
		end
		if not computing and now >= nextPathStart and #entries > 0 then
			for _ = 1, #entries do
				cursor = cursor % #entries + 1
				local e = entries[cursor]
				if e.NeedPath and e.Goal and now >= e.NextPath and e.Humanoid.Health > 0 and not e.Removed then
					computing = true
					nextPathStart = now + 1 / Config.PathStartsPerSecond
					e.NextPath = now + Config.RepathSeconds
					local goal = e.Goal
					task.spawn(function()
						local path = Pathfinding:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
						local ok = pcall(function()
							path:ComputeAsync(e.Root.Position, goal)
						end)
						if
							ok
							and not e.Removed
							and e.Humanoid.Health > 0
							and e.Goal
							and (e.Goal - goal).Magnitude < 10
							and path.Status == Enum.PathStatus.Success
						then
							e.Path = path:GetWaypoints()
							e.Waypoint = 2
						end
						path:Destroy()
						computing = false
					end)
					break
				end
			end
		end
	end)
end
return City
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">MagicBehaviorExecutors</string>
            <string name="Source"><![CDATA[--!strict

-- V1 behavior registry. Each handler receives runtime context supplied by
-- MagicService, keeping behaviors independent from spell identities.
local Behaviors = {}

type Context = {
	ApplySpherePayloads: (radius: number, payloads: { any }) -> (),
}

local executors: { [string]: (Context, any) -> () } = {
	Explode = function(context, behavior)
		context.ApplySpherePayloads(behavior.Radius, behavior.Payloads)
	end,
}

function Behaviors.execute(name: string, context: Context, behavior: any): boolean
	local executor = executors[name]
	if not executor then
		return false
	end
	executor(context, behavior)
	return true
end

return Behaviors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">MagicCommandSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Shared matching semantics for optional named-command trigger filters.
local Spec = {}

function Spec.matches(filter, command)
	return filter == nil or filter == command
end

function Spec.canExecuteCompanionSpell(requiresCommand, commandIssued, command)
	if requiresCommand ~= true then
		return true
	end
	return commandIssued == true and (command == "Attack" or command == "Support")
end

function Spec.validSelectionId(id)
	return type(id) == "number" and id == id and id % 1 == 0 and id > 0
end

function Spec.validPointCoordinates(x, y, z)
	local function finiteBounded(value)
		return type(value) == "number" and value == value and math.abs(value) <= 1000000
	end
	return finiteBounded(x) and finiteBounded(y) and finiteBounded(z)
end

function Spec.matchesSelection(recordId, selectedId)
	return selectedId == nil or recordId == selectedId
end

function Spec.activeCommandCount(active, owner)
	local commandIds = {}
	for _, effect in ipairs(active) do
		if effect.Player == owner and effect.CommandCastId ~= nil then
			commandIds[effect.CommandCastId] = true
		end
	end
	local count = 0
	for _ in pairs(commandIds) do
		count = count + 1
	end
	return count
end

function Spec.canStartActiveCommand(active, owner, maximum)
	return type(maximum) == "number" and maximum >= 0 and Spec.activeCommandCount(active, owner) < maximum
end

function Spec.nextPatrolRoute(existing, waypoint)
	if type(existing) == "table" and #existing == 1 then
		return { existing[1], waypoint }, true
	end
	return { waypoint }, false
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">MagicConditions</string>
            <string name="Source"><![CDATA[--!strict

-- Evaluates only properties explicitly exposed by MagicConditionSpec. There is
-- no arbitrary Instance/property lookup in spell-authored condition data.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local Spec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicConditionSpec)
local Evaluator = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicConditionEvaluator)
local LifetimeCondition = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicLifetimeConditionSpec)
local Relationships = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicRelationship)
local TargetConsent = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicTargetConsentSpec)
local EnvironmentZoneSpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicEnvironmentZoneSpec)
local EnvironmentRequirementSpec =
	require(game:GetService("ReplicatedStorage").Shared.Modules.MagicEnvironmentRequirementSpec)
local SpellIdentitySpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicSpellIdentitySpec)
local ElementalMarkSpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicElementalMarkSpec)
local SpecialResourceDefinitions =
	require(game:GetService("ReplicatedStorage").Shared.Configuration.MagicLocus).SpecialResources
local Control = require(script.Parent.MagicControlService)

local MAX_ENVIRONMENT_ZONE_ID_LENGTH = 32

local Conditions = {}
Spec.configureSpecialResources(SpecialResourceDefinitions)

local function humanoidOf(model: Model?): Humanoid?
	return if model then model:FindFirstChildOfClass("Humanoid") else nil
end

local function rootOf(model: Model?): BasePart?
	local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
	return if root and root:IsA("BasePart") then root else nil
end

local function environmentZoneAt(position: Vector3): (string?, string?)
	local selectedId: string? = nil
	local selectedTags: string? = nil
	local selectedPriority = -math.huge
	for _, instance in CollectionService:GetTagged("MagicEnvironmentZone") do
		if not instance:IsA("BasePart") or not instance:IsDescendantOf(workspace) then
			continue
		end
		local zoneId = instance:GetAttribute("MagicZoneId")
		if type(zoneId) ~= "string" or #zoneId == 0 or #zoneId > MAX_ENVIRONMENT_ZONE_ID_LENGTH then
			continue
		end
		local localPosition = instance.CFrame:PointToObjectSpace(position)
		local halfSize = instance.Size * 0.5
		if
			math.abs(localPosition.X) > halfSize.X
			or math.abs(localPosition.Y) > halfSize.Y
			or math.abs(localPosition.Z) > halfSize.Z
		then
			continue
		end
		local priority = instance:GetAttribute("MagicZonePriority")
		if type(priority) ~= "number" or priority ~= priority or math.abs(priority) == math.huge then
			priority = 0
		end
		if
			priority > selectedPriority or (priority == selectedPriority and (selectedId == nil or zoneId < selectedId))
		then
			selectedId = zoneId
			selectedTags = EnvironmentZoneSpec.encodeTags(instance:GetAttribute("MagicZoneTags"))
			selectedPriority = priority
		end
	end
	return selectedId, selectedTags
end

local function alignment(model: Model?): string?
	if not model then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(model)
	local ownerUserId = model:GetAttribute("MagicSummonOwnerUserId") or model:GetAttribute("SandboxOwnerUserId")
	local owner = if type(ownerUserId) == "number" then Players:GetPlayerByUserId(ownerUserId) else nil
	local alignedPlayer = player or owner
	local ownerAlignment = if alignedPlayer
		then if alignedPlayer.Team then alignedPlayer.Team.Name else "Human"
		else nil
	local value = model:GetAttribute("SandboxAlignment") or model:GetAttribute("MagicAlignment")
	return Relationships.resolveAlignment(value, ownerAlignment)
end

local function relationship(caster: Model?, target: Model?)
	local isSelf = caster ~= nil and target == caster
	local isHostile = target ~= nil
		and (CollectionService:HasTag(target, "Enfleshed") or CollectionService:HasTag(target, "MagicHostileTarget"))
	local casterAlignment = alignment(caster)
	local targetAlignment = alignment(target)
	return Relationships.classify(
		isSelf,
		isHostile,
		casterAlignment ~= nil and casterAlignment == targetAlignment,
		caster ~= nil
			and target ~= nil
			and CollectionService:HasTag(target, "SandboxAlly")
			and CollectionService:HasTag(caster, "SandboxAlly")
	)
end

local function values(context: any): { [string]: any }
	local caster: Model? = context.Caster
	local target: Model? = context.Target
	local casterHumanoid = humanoidOf(caster)
	local targetHumanoid = humanoidOf(target)
	local statusHumanoid = targetHumanoid or casterHumanoid
	local statusModel = if targetHumanoid then target else caster
	local casterRoot = rootOf(caster)
	local targetRoot = rootOf(target)
	local delta = if casterRoot and targetRoot then targetRoot.Position - casterRoot.Position else nil
	local resource = context.Resources or {}
	local material: Instance? = context.Material
	local materialName: string? = nil
	local available: number? = nil
	if material then
		local name = material:GetAttribute("MagicMaterial")
		materialName = if type(name) == "string" then name else nil
		local amount = material:GetAttribute("AvailableAmount")
		available = if type(amount) == "number" then amount else nil
	end
	local targetShield = if statusHumanoid then statusHumanoid:GetAttribute("MagicShield") else nil
	local targetSlow = if statusHumanoid then statusHumanoid:GetAttribute("MagicSlowMultiplier") else nil
	local targetTimeRate = if statusHumanoid then statusHumanoid:GetAttribute("MagicTimeRate") else nil
	local targetArmorBonus = if statusHumanoid then statusHumanoid:GetAttribute("MagicArmorBonus") else nil
	local targetStrengthBonus = if statusHumanoid then statusHumanoid:GetAttribute("MagicStrengthBonus") else nil
	local targetBound = if statusHumanoid then statusHumanoid:GetAttribute("MagicMovementBound") else nil
	local targetElementalMarks = if statusHumanoid then statusHumanoid:GetAttribute("MagicElementalMarks") else nil
	local encodedElementalMarks = if type(targetElementalMarks) == "string" then targetElementalMarks else "||"
	local relation = relationship(caster, target)
	local casterAlignment = alignment(caster)
	local materialTarget = context.MaterialTarget
	local castState = context.SpellState or {}
	local spellId = castState.SpellId or context.SpellId
	local controlledMass = if caster and type(spellId) == "string" then Control.controlledMass(caster, spellId) else nil
	local environmentZone = context.EnvironmentZone
	local environmentZoneTags = context.EnvironmentZoneTags
	if environmentZone == nil then
		if casterRoot then
			environmentZone, environmentZoneTags = environmentZoneAt(casterRoot.Position)
		end
		context.EnvironmentZone = environmentZone or false
		context.EnvironmentZoneTags = environmentZoneTags or "||"
	elseif environmentZone == false then
		environmentZone = nil
	end
	local hitCount = castState.TargetsHit or 0
	if type(hitCount) == "table" then
		local count = 0
		for _, hit in pairs(hitCount) do
			if hit then
				count += 1
			end
		end
		hitCount = count
	end
	local activePosition = castState.Position
	local activeDistance = if casterRoot and typeof(activePosition) == "Vector3"
		then (activePosition - casterRoot.Position).Magnitude
		else nil
	local remainingDuration = castState.RemainingLifetime
	if
		type(remainingDuration) ~= "number"
		or remainingDuration ~= remainingDuration
		or remainingDuration <= -math.huge
		or remainingDuration >= math.huge
	then
		remainingDuration = nil
	elseif remainingDuration < 0 then
		remainingDuration = 0
	end
	local currentTarget = castState.CurrentTarget
	local hasCurrentTarget = typeof(context.Target) == "Instance" and context.Target:IsDescendantOf(workspace)
		or (
			typeof(currentTarget) == "Instance"
			and currentTarget.Parent ~= nil
			and currentTarget:IsDescendantOf(workspace)
		)
	local now = os.clock()
	local valuesByFamily = {
		Caster = {
			HealthPercent = if casterHumanoid and casterHumanoid.MaxHealth > 0
				then casterHumanoid.Health / casterHumanoid.MaxHealth
				else nil,
			IsAlive = casterHumanoid ~= nil and casterHumanoid.Health > 0,
			OnGround = casterHumanoid ~= nil and casterHumanoid.FloorMaterial ~= Enum.Material.Air,
			Team = casterAlignment,
		},
		Target = {
			HealthPercent = if targetHumanoid and targetHumanoid.MaxHealth > 0
				then targetHumanoid.Health / targetHumanoid.MaxHealth
				else nil,
			IsAlive = targetHumanoid ~= nil and targetHumanoid.Health > 0,
			IsPlayer = target ~= nil and Players:GetPlayerFromCharacter(target) ~= nil,
			HasLineOfSight = context.HasLineOfSight,
			Name = if target then target.Name else nil,
			Tags = EnvironmentZoneSpec.encodeTags(target and target:GetAttribute("MagicConditionTags") or ""),
		},
		Relationship = {
			IsSelf = relation == "Self",
			IsAlly = relation == "Ally",
			IsHostile = relation == "Hostile",
			IsNeutral = relation == "Neutral",
		},
		SpellState = {
			Age = castState.Age or 0,
			TargetsHit = hitCount,
			DistanceFromCaster = activeDistance,
			RemainingDuration = remainingDuration,
			PierceCount = castState.PierceCount or 0,
			BounceCount = castState.BounceCount or 0,
			AbsorbedEnergy = castState.AbsorbedEnergy or 0,
			ControlledMass = controlledMass,
			HasCurrentTarget = hasCurrentTarget,
			Tags = SpellIdentitySpec.encode(castState.SpellTags or {}),
			Phase = castState.CurrentPhase or "Casting",
			IsMaintained = castState.IsChannel == true,
		},
		Resource = {
			Mana = resource.Mana,
			ManaPercent = if resource.Capacity and resource.Capacity > 0
				then resource.Mana / resource.Capacity
				else nil,
			Capacity = resource.Capacity,
			Efficiency = resource.Efficiency,
			Potency = resource.Potency,
			Strain = resource.Strain,
			StrainTolerance = resource.StrainTolerance,
			ComplexityCapacity = resource.ComplexityCapacity,
		},
		Environment = {
			ClockTime = Lighting.ClockTime,
			OnGround = casterHumanoid ~= nil and casterHumanoid.FloorMaterial ~= Enum.Material.Air,
			Zone = environmentZone or "",
			ZoneTags = environmentZoneTags or "||",
		},
		Material = {
			Type = materialName or (if materialTarget then materialTarget.Material else nil),
			AvailableAmount = available,
		},
		Status = {
			Shield = if type(targetShield) == "number" then targetShield else 0,
			SlowMultiplier = if type(targetSlow) == "number" then targetSlow else 1,
			TimeRate = if type(targetTimeRate) == "number" then targetTimeRate else 1,
			HasShield = type(targetShield) == "number" and targetShield > 0,
			IsSlowed = type(targetSlow) == "number" and targetSlow < 1,
			IsBound = targetBound == true,
			IsRevealed = statusModel ~= nil and CollectionService:HasTag(statusModel, "MagicRevealedTarget"),
			ElementalMarks = if type(targetElementalMarks) == "string" then targetElementalMarks else "||",
			IsBurning = ElementalMarkSpec.hasEncoded(encodedElementalMarks, "Fire"),
			IsWet = ElementalMarkSpec.hasEncoded(encodedElementalMarks, "Water"),
			MagicArmorBonus = if type(targetArmorBonus) == "number" then targetArmorBonus else 0,
			MagicStrengthBonus = if type(targetStrengthBonus) == "number" then targetStrengthBonus else 0,
		},
		DistancePosition = {
			Distance = if delta then delta.Magnitude else nil,
			VerticalDistance = if delta then math.abs(delta.Y) else nil,
		},
		Time = {
			ClockTime = Lighting.ClockTime,
			SinceCast = castState.Age or math.max(0, now - (castState.StartedAt or now)),
		},
	}
	for id, definition in pairs(SpecialResourceDefinitions) do
		local amount = resource.SpecialResources and resource.SpecialResources[id]
		valuesByFamily.Resource[id] = amount
		valuesByFamily.Resource[id .. "Percent"] = if amount ~= nil and definition.Capacity > 0
			then amount / definition.Capacity
			else nil
	end
	return valuesByFamily
end

local legacyCast = {
	OnGround = function(context)
		local humanoid = humanoidOf(context.Caster)
		return humanoid ~= nil and humanoid.FloorMaterial ~= Enum.Material.Air
	end,
}
local legacyTarget = {
	TargetIsSelf = function(context)
		return context.Target == context.Caster
	end,
	TargetWithinRange = function(context)
		return (context.Position - context.TargetRoot.Position).Magnitude <= context.Range
	end,
}

local function conditionUsesLineOfSight(node: any): boolean
	if node.Operator == "ALL" or node.Operator == "ANY" or node.Operator == "NOT" then
		for _, child in ipairs(node.Conditions) do
			if conditionUsesLineOfSight(child) then
				return true
			end
		end
		return false
	end
	return node.Family == "Target" and node.Property == "HasLineOfSight"
end

local function conditionUsesEnvironmentZone(node: any): boolean
	if type(node) ~= "table" then
		return false
	end
	if node.Operator == "ALL" or node.Operator == "ANY" or node.Operator == "NOT" then
		for _, child in ipairs(node.Conditions) do
			if conditionUsesEnvironmentZone(child) then
				return true
			end
		end
		return false
	end
	return node.Family == "Environment" and (node.Property == "Zone" or node.Property == "ZoneTags")
end

function Conditions.relationshipMatches(caster: Model?, target: Model?, rule: string?): boolean
	return Relationships.matches(relationship(caster, target), rule)
end

function Conditions.hasConsent(definition: any, target: Model?): boolean
	return TargetConsent.allows(definition.TargetRules.RequiresConsent, target, Players)
end

function Conditions.cast(definition: any, state: any, extras: any?): (boolean, string?)
	local conditionList = definition.Conditions
	local context = {
		Caster = state.Character,
		Player = extras and extras.Player,
		SpellId = definition.SpellId,
		Resources = extras and extras.Resources,
		Material = extras and extras.Material,
		MaterialTarget = extras and extras.MaterialTarget,
		SpellState = table.clone(extras and extras.SpellState or {}),
	}
	context.SpellState.SpellTags = definition.Tags or {}
	local zoneTags = "||"
	context.EnvironmentZone = false
	local requirements = definition.EnvironmentRequirements
	local zoneTagRequirements = requirements and requirements.ZoneTags
	local needsZone = conditionUsesEnvironmentZone(conditionList)
		or (
			zoneTagRequirements
			and (#(zoneTagRequirements.Required or {}) > 0 or #(zoneTagRequirements.Forbidden or {}) > 0)
		)
	if needsZone then
		local casterRoot = rootOf(state.Character)
		if casterRoot then
			local zoneId, tags = environmentZoneAt(casterRoot.Position)
			context.EnvironmentZone = zoneId or false
			zoneTags = tags or "||"
		end
	end
	context.EnvironmentZoneTags = zoneTags
	if conditionList.Operator then
		local result = Evaluator.evaluate(conditionList, function(familyName, propertyName)
			local family = values(context)[familyName]
			return family and family[propertyName]
		end, {
			Caster = true,
			Resource = true,
			Status = true,
			Environment = true,
			Material = true,
			SpellState = true,
			Time = true,
		})
		if result == false then
			return false, "Cast conditions were not met"
		end
	else
		for _, condition in ipairs(conditionList) do
			local check = legacyCast[condition]
			if check and not check(context) then
				return false, "OnGround condition requires standing on a surface"
			end
		end
	end
	local caster = state.Character
	local casterHumanoid = humanoidOf(caster)
	local requirementsMet, requirementReason = EnvironmentRequirementSpec.check(definition.EnvironmentRequirements, {
		OnGround = casterHumanoid ~= nil and casterHumanoid.FloorMaterial ~= Enum.Material.Air,
		ClockTime = Lighting.ClockTime,
		ZoneTags = zoneTags or "||",
	})
	if not requirementsMet then
		return false, requirementReason
	end
	return true
end

function Conditions.endWhen(definition: any, effect: any, resources: any?): boolean
	local rule = definition.Lifetime and definition.Lifetime.EndWhen
	if not rule then
		return false
	end
	local caster = effect.Caster or (effect.State and effect.State.Character)
	local context = {
		Caster = caster,
		Resources = resources,
		SpellId = definition.SpellId,
		SpellState = table.clone(effect),
	}
	context.SpellState.SpellTags = definition.Tags or {}
	local resolvedValues = values(context)
	local result = Evaluator.evaluate(rule, function(familyName, propertyName)
		local family = resolvedValues[familyName]
		return family and family[propertyName]
	end, Spec.EndConditionFamilies)
	return LifetimeCondition.shouldEnd(definition.Lifetime.Mode, result)
end

function Conditions.lifetimeAllowsStart(definition: any, state: any, resources: any?): boolean
	if definition.Lifetime.Mode ~= "UntilConditionFails" then
		return true
	end
	local effectState = {
		Caster = state.Character,
		State = state,
		Age = 0,
		SpellId = definition.SpellId,
		StartedAt = os.clock(),
		CurrentPhase = "Active",
		TargetsHit = 0,
		Position = state.Root.Position,
		RemainingLifetime = definition.Lifetime.Duration,
	}
	local rule = definition.Lifetime.EndWhen
	if not rule then
		return false
	end
	local resolvedValues = values({
		Caster = effectState.Caster,
		Resources = resources,
		SpellId = definition.SpellId,
		SpellState = table.clone(effectState),
	})
	resolvedValues.SpellState.Tags = SpellIdentitySpec.encode(definition.Tags or {})
	local result = Evaluator.evaluate(rule, function(familyName, propertyName)
		local family = resolvedValues[familyName]
		return family and family[propertyName]
	end, Spec.EndConditionFamilies)
	return LifetimeCondition.allowsStart(definition.Lifetime.Mode, result)
end

function Conditions.targets(
	definition: any,
	caster: Model,
	position: Vector3,
	targets: { Humanoid },
	extras: any?
): { Humanoid }
	local result = {}
	local rules = definition.TargetRules
	local legacyLineOfSight = not definition.Conditions.Operator
		and table.find(definition.Conditions, "HasLineOfSight") ~= nil
	local conditionLineOfSight = definition.Conditions.Operator and conditionUsesLineOfSight(definition.Conditions)
	local evaluateLineOfSight = rules.RequiresLineOfSight or legacyLineOfSight or conditionLineOfSight
	table.sort(targets, function(a, b)
		local rootA = a.Parent and rootOf(a.Parent)
		local rootB = b.Parent and rootOf(b.Parent)
		return rootA ~= nil
			and rootB ~= nil
			and (rootA.Position - position).Magnitude < (rootB.Position - position).Magnitude
	end)
	for _, humanoid in ipairs(targets) do
		local model = humanoid.Parent
		local target = if model and model:IsA("Model") then model else nil
		local root = rootOf(target)
		if not target or not root or (humanoid.Health <= 0 and not (extras and extras.AllowDeadTargets)) then
			continue
		end
		local hasLineOfSight = true
		if evaluateLineOfSight then
			local delta = root.Position - position
			if delta.Magnitude > 0.001 then
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { caster, target }
				params.RespectCanCollide = true
				hasLineOfSight = workspace:Raycast(position, delta, params) == nil
			end
		end
		local context = {
			Caster = caster,
			Target = target,
			Player = extras and extras.Player,
			SpellId = definition.SpellId,
			Resources = extras and extras.Resources,
			Material = extras and extras.Material,
			MaterialTarget = extras and extras.MaterialTarget,
			Position = position,
			TargetRoot = root,
			Range = rules.Range,
			HasLineOfSight = hasLineOfSight,
			SpellState = table.clone(extras and extras.SpellState or {}),
		}
		context.SpellState.SpellTags = definition.Tags or {}
		local allowed = Conditions.relationshipMatches(caster, target, rules.Relationship)
			and Conditions.hasConsent(definition, target)
			and (
				target ~= caster
				or definition.Form == "SelfEnhancement"
				or (extras and extras.AllowCasterTarget == true)
				or rules.IncludeCaster == true
			)
		if definition.Conditions.Operator then
			allowed = allowed
				and Evaluator.evaluate(definition.Conditions, function(familyName, propertyName)
						local family = values(context)[familyName]
						return family and family[propertyName]
					end, nil)
					~= false
		else
			for _, condition in ipairs(definition.Conditions) do
				local check = legacyTarget[condition]
				if check and not check(context) then
					allowed = false
					break
				end
			end
		end
		if (rules.RequiresLineOfSight or legacyLineOfSight) and not hasLineOfSight then
			allowed = false
		end
		if allowed then
			table.insert(result, humanoid)
		end
		if #result >= rules.MaxTargets then
			break
		end
	end
	return result
end

return Conditions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">MagicControlService</string>
            <string name="Source"><![CDATA[--!strict

-- A bounded maintained horizontal influence. This is intentionally physical
-- control, not a stun, movement lock, or one-shot Force impulse.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Limits = require(ReplicatedStorage.Shared.Configuration.MagicLab)
local Ownership = require(script.Parent.MagicPhysicsOwnership)
local MassSpec = require(ReplicatedStorage.Shared.Modules.MagicControlMassSpec)

local Control = {}
local states: { [BasePart]: any } = setmetatable({}, { __mode = "k" }) :: any
local controlledMassByCaster: any = setmetatable({}, { __mode = "k" })
local activeTargets = 0

local function setControlledMass(effect: any, mass: number)
	local previous = effect.ControlledMass or 0
	if previous ~= mass then
		MassSpec.adjust(controlledMassByCaster, effect.Caster, effect.SpellId, mass - previous)
		effect.ControlledMass = mass
	end
end

local function release(root: BasePart, state: any)
	for _, effect in state.Effects do
		setControlledMass(effect, 0)
	end
	if state.Force then
		state.Force:Destroy()
	end
	if state.Attachment then
		state.Attachment:Destroy()
	end
	Ownership.release(root, state.Token)
	states[root] = nil
	activeTargets = math.max(0, activeTargets - 1)
end

local function dispatchTargetDeath(state: any)
	local humanoid = state.Humanoid
	if not humanoid or humanoid.Health > 0 then
		return
	end
	local callbacks = {}
	local seen = {}
	local now = os.clock()
	for _, effect in state.Effects do
		local casterHumanoid = effect.Caster:FindFirstChildOfClass("Humanoid")
		if
			effect.OnTargetDeath
			and effect.Expires > now
			and effect.Caster:IsDescendantOf(workspace)
			and casterHumanoid
			and casterHumanoid.Health > 0
		then
			local spells = seen[effect.Caster]
			if not spells then
				spells = {}
				seen[effect.Caster] = spells
			end
			if not spells[effect.SpellId] then
				spells[effect.SpellId] = true
				table.insert(callbacks, effect.OnTargetDeath)
			end
		end
	end
	for _, callback in callbacks do
		task.defer(callback, humanoid)
	end
end

local function rootOf(model: Instance?): BasePart?
	local root = model and model:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

RunService.Heartbeat:Connect(function()
	local now = os.clock()
	for targetRoot, state in states do
		local target = state.Humanoid
		if
			not targetRoot:IsDescendantOf(workspace)
			or (target and (target.Health <= 0 or not target:IsDescendantOf(workspace)))
			or (
				state.ObjectTarget and (state.ObjectTarget.Anchored or not state.ObjectTarget:IsDescendantOf(workspace))
			)
		then
			dispatchTargetDeath(state)
			release(targetRoot, state)
			continue
		end

		local acceleration = Vector3.zero
		state.ControlledMass = targetRoot.AssemblyMass
		local speedCap = Limits.MaxSpeed
		for index = #state.Effects, 1, -1 do
			local effect = state.Effects[index]
			local casterRoot = rootOf(effect.Caster)
			if
				effect.Expires <= now
				or not effect.CasterHumanoid
				or effect.CasterHumanoid.Health <= 0
				or not casterRoot
				or not casterRoot:IsDescendantOf(workspace)
				or not MassSpec.allows(targetRoot.AssemblyMass, effect.MaxMass)
			then
				setControlledMass(effect, 0)
				table.remove(state.Effects, index)
			else
				setControlledMass(effect, targetRoot.AssemblyMass)
				speedCap = math.min(speedCap, effect.MaxSpeed)
				local offset = Vector3.new(
					targetRoot.Position.X - casterRoot.Position.X,
					0,
					targetRoot.Position.Z - casterRoot.Position.Z
				)
				if offset.Magnitude > 0.1 then
					local direction = offset.Unit * (if effect.Mode == "Pull" then -1 else 1)
					acceleration += direction * effect.Acceleration
				end
			end
		end

		if #state.Effects == 0 then
			release(targetRoot, state)
			continue
		end

		local horizontalVelocity =
			Vector3.new(targetRoot.AssemblyLinearVelocity.X, 0, targetRoot.AssemblyLinearVelocity.Z)
		if horizontalVelocity.Magnitude >= speedCap or targetRoot.AssemblyMass <= 0 then
			state.Force.Force = Vector3.zero
		else
			local maxAcceleration = Limits.MaxAcceleration
			if acceleration.Magnitude > maxAcceleration then
				acceleration = acceleration.Unit * maxAcceleration
			end
			state.Force.Force = acceleration * targetRoot.AssemblyMass
		end
	end
end)

local function applyToRoot(
	caster: Model,
	targetRoot: BasePart,
	humanoid: Humanoid?,
	objectTarget: BasePart?,
	spellId: string,
	payload: any,
	potency: number,
	onTargetDeath: ((Humanoid) -> ())?
): (boolean, boolean)
	local casterRoot = rootOf(caster)
	local casterHumanoid = caster:FindFirstChildOfClass("Humanoid")
	if
		not casterRoot
		or not casterHumanoid
		or casterHumanoid.Health <= 0
		or (humanoid and humanoid.Health <= 0)
		or targetRoot == casterRoot
		or targetRoot.Anchored
		or targetRoot.AssemblyMass <= 0
		or not MassSpec.allows(targetRoot.AssemblyMass, payload.MaxMass)
		or (payload.Mode ~= "Pull" and payload.Mode ~= "Push")
	then
		return false
	end

	local state = states[targetRoot]
	if not state then
		if activeTargets >= Limits.MaxEffectTargets then
			return false
		end
		local token = {}
		if not Ownership.claim(targetRoot, token) then
			return false
		end
		local attachment = Instance.new("Attachment")
		attachment.Name = "MagicControlAttachment"
		attachment.Parent = targetRoot
		local force = Instance.new("VectorForce")
		force.Name = "MagicControlForce"
		force.ApplyAtCenterOfMass = true
		force.RelativeTo = Enum.ActuatorRelativeTo.World
		force.Attachment0 = attachment
		force.Force = Vector3.zero
		force.Parent = targetRoot
		state = {
			Humanoid = humanoid,
			ObjectTarget = objectTarget,
			Effects = {},
			Token = token,
			Attachment = attachment,
			Force = force,
		}
		states[targetRoot] = state
		activeTargets += 1
	elseif objectTarget and state.Humanoid then
		return false
	elseif humanoid and state.ObjectTarget then
		return false
	end

	local now = os.clock()
	local existing
	for _, effect in state.Effects do
		if effect.Caster == caster and effect.SpellId == spellId then
			existing = effect
			break
		end
	end
	if not existing and #state.Effects >= Limits.MaxEffectsPerTarget then
		return false
	end
	local effect = existing or { Caster = caster, CasterHumanoid = casterHumanoid, SpellId = spellId }
	effect.Mode = payload.Mode
	effect.Acceleration = math.clamp(payload.Acceleration * potency, 0, Limits.MaxAcceleration)
	effect.MaxSpeed = payload.MaxSpeed
	effect.MaxMass = payload.MaxMass
	effect.Expires = now + payload.Duration
	effect.OnTargetDeath = onTargetDeath
	if not existing then
		table.insert(state.Effects, effect)
	end
	setControlledMass(effect, targetRoot.AssemblyMass)
	return true, existing == nil
end

function Control.apply(
	caster: Model,
	humanoid: Humanoid,
	spellId: string,
	payload: any,
	potency: number,
	onTargetDeath: ((Humanoid) -> ())?
): (boolean, boolean)
	local targetModel = humanoid.Parent
	local targetRoot = rootOf(targetModel)
	if not targetRoot or humanoid.Health <= 0 then
		return false
	end
	return applyToRoot(caster, targetRoot, humanoid, nil, spellId, payload, potency, onTargetDeath)
end

function Control.applyObject(
	caster: Model,
	target: BasePart,
	spellId: string,
	payload: any,
	potency: number
): (boolean, boolean)
	if
		not target:IsDescendantOf(workspace)
		or target.Anchored
		or target.AssemblyMass <= 0
		or target:FindFirstAncestorOfClass("Model")
			and target:FindFirstAncestorOfClass("Model"):FindFirstChildOfClass("Humanoid")
	then
		return false
	end
	local targetRoot = target.AssemblyRootPart or target
	return applyToRoot(caster, targetRoot, nil, target, spellId, payload, potency, nil)
end

function Control.controlledMass(caster: Model, spellId: string): number
	return MassSpec.total(controlledMassByCaster, caster, spellId)
end

return Control
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">MagicDiscoveryService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-owned test preference storage with dormant discovery compatibility.
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.MagicLab)
local Spec = require(Shared.Modules.MagicDiscoverySpec)
local LocusConfig = require(Shared.Configuration.MagicLocus)
local LocusProgression = require(Shared.Modules.MagicLocusProgressionSpec)
local MagicProfiles = require(Shared.Configuration.MagicProfiles)
local Service = {}

local profiles: { [Player]: any } = {}
local sessionProgress: { [Player]: any } = {}
local loaded: { [Player]: boolean } = {}
local writable: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}
local revisions: { [Player]: number } = {}
local pendingProfileSelections: { [Player]: string } = {}
local store
local storeReady, storeResult = pcall(function()
	return DataStoreService:GetDataStore(Config.DiscoveryDataStoreName)
end)
if storeReady then
	store = storeResult
end

local function empty()
	return Spec.decode(nil)
end

local function key(player: Player): string
	return "u:" .. tostring(player.UserId)
end

local function refreshAttributes(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local progressionEnabled = Config.ProgressionEnabled == true
	local progress = Spec.progress(profile, progressionEnabled)
	local locus = LocusProgression.profile(LocusConfig.Default, LocusConfig.Progression, progress.TotalCasts)
	player:SetAttribute("MagicDiscoveryLoaded", loaded[player] == true)
	player:SetAttribute("MagicDiscoveryTotalCasts", progress.TotalCasts)
	player:SetAttribute("MagicLocusRank", locus.Rank)
	player:SetAttribute("MagicLocusRankProgress", locus.Progress)
	player:SetAttribute("MagicLocusCastsToNextRank", locus.CastsToNextRank)
	for name, value in locus.Metrics do
		player:SetAttribute("MagicLocus" .. name, value)
	end
	for name, count in progress.Principles do
		player:SetAttribute("MagicDiscoveryPrinciple_" .. name, count)
	end
	for name, count in progress.Forms do
		player:SetAttribute("MagicDiscoveryForm_" .. name, count)
	end
	for name, unlocked in progress.Palettes do
		player:SetAttribute("MagicUnlockPalette_" .. name, unlocked)
	end
	for name, unlocked in progress.Shapes do
		player:SetAttribute("MagicUnlockShape_" .. name, unlocked)
	end
	for _, name in Spec.ExpressionOrder do
		player:SetAttribute("MagicDiscoveryExpression_" .. name, profiles[player].Expressions[name] or 0)
		player:SetAttribute("MagicUnlockExpression_" .. name, progress.Expressions[name] == true)
	end
	local selectedProfileId = profiles[player].AwakeningProfileId
	if not Spec.awakeningProfileUnlocked(profiles[player], selectedProfileId, MagicProfiles, progressionEnabled) then
		selectedProfileId = "RecruitGeneric"
		profiles[player].AwakeningProfileId = selectedProfileId
	end
	player:SetAttribute("MagicAwakeningProfileId", selectedProfileId)
	for profileId, definition in MagicProfiles do
		player:SetAttribute(
			"MagicUnlockAwakening_" .. profileId,
			Spec.awakeningProfileUnlocked(profiles[player], profileId, MagicProfiles, progressionEnabled)
		)
	end
end

local function markDirty(player: Player)
	if not loaded[player] or not writable[player] or not store then
		return
	end
	dirty[player] = true
	revisions[player] = (revisions[player] or 0) + 1
	local revision = revisions[player]
	task.delay(Config.DiscoverySaveDebounce, function()
		if player.Parent ~= Players or revisions[player] ~= revision or not dirty[player] then
			return
		end
		local snapshot = Spec.encode(profiles[player])
		if not snapshot then
			writable[player] = false
			return
		end
		local rejected = false
		local ok, result = pcall(function()
			return store:UpdateAsync(key(player), function(existing)
				rejected = false
				if existing ~= nil then
					local _, safe = Spec.decode(existing)
					if not safe then
						rejected = true
						return nil
					end
				end
				return snapshot
			end)
		end)
		if not ok then
			return
		end
		if rejected or result == nil then
			writable[player] = false
			return
		end
		if revisions[player] == revision then
			dirty[player] = nil
		end
	end)
end

local function bind(player: Player)
	if profiles[player] then
		return
	end
	profiles[player] = empty()
	sessionProgress[player] = empty()
	loaded[player] = false
	writable[player] = false
	refreshAttributes(player)
	task.spawn(function()
		if not store then
			loaded[player], writable[player] = true, false
			local pendingProfileId = pendingProfileSelections[player]
			pendingProfileSelections[player] = nil
			if pendingProfileId then
				local selected = Spec.selectAwakeningProfile(
					profiles[player],
					pendingProfileId,
					MagicProfiles,
					Config.ProgressionEnabled == true
				)
				if selected then
					profiles[player] = selected
				end
			end
			refreshAttributes(player)
			return
		end
		local ok, raw = pcall(function()
			return store:GetAsync(key(player))
		end)
		if player.Parent ~= Players then
			return
		end
		if ok then
			local saved, safe = Spec.decode(raw)
			if safe then
				local delta = sessionProgress[player]
				saved.TotalCasts += delta.TotalCasts
				for principle, count in delta.Principles do
					saved.Principles[principle] += count
				end
				for form, count in delta.Forms do
					saved.Forms[form] += count
				end
				for expression, count in delta.Expressions do
					saved.Expressions[expression] += count
				end
				profiles[player] = saved
				loaded[player], writable[player] = true, true
			else
				loaded[player], writable[player] = true, false
			end
		else
			loaded[player], writable[player] = true, false
		end
		local pendingProfileId = pendingProfileSelections[player]
		pendingProfileSelections[player] = nil
		if pendingProfileId then
			local selected, accepted = Spec.selectAwakeningProfile(
				profiles[player],
				pendingProfileId,
				MagicProfiles,
				Config.ProgressionEnabled == true
			)
			if accepted and selected then
				profiles[player] = selected
			end
		end
		refreshAttributes(player)
		if sessionProgress[player].TotalCasts > 0 or pendingProfileId ~= nil then
			markDirty(player)
		end
	end)
end

local function remove(player: Player)
	-- Debounced saves are best-effort. A final snapshot avoids losing a quick Studio session.
	if dirty[player] and writable[player] and store and loaded[player] then
		local snapshot = Spec.encode(profiles[player])
		if snapshot then
			pcall(function()
				store:UpdateAsync(key(player), function(existing)
					if existing ~= nil then
						local _, safe = Spec.decode(existing)
						if not safe then
							return nil
						end
					end
					return snapshot
				end)
			end)
		end
	end
	profiles[player], sessionProgress[player], loaded[player], writable[player], dirty[player], revisions[player], pendingProfileSelections[player] =
		nil, nil, nil, nil, nil, nil, nil
end

function Service.start()
	Players.PlayerAdded:Connect(bind)
	Players.PlayerRemoving:Connect(remove)
	game:BindToClose(function()
		for player in profiles do
			remove(player)
		end
	end)
	for _, player in Players:GetPlayers() do
		bind(player)
	end
end

function Service.recordCast(player: Player, definition)
	if Config.ProgressionEnabled ~= true then
		return
	end
	if not profiles[player] then
		bind(player)
	end
	local principle = definition and definition.Source and definition.Source.Principle
	local form = definition and definition.Form
	local expression = definition and definition.Source and definition.Source.Expression
	if type(principle) ~= "string" or type(form) ~= "string" or type(expression) ~= "string" then
		return
	end
	profiles[player] = Spec.recordCast(profiles[player], principle, form, expression)
	sessionProgress[player] = Spec.recordCast(sessionProgress[player], principle, form, expression)
	refreshAttributes(player)
	markDirty(player)
end

function Service.isUnlocked(player: Player, kind: string, id: string): boolean
	return Config.ProgressionEnabled ~= true or player:GetAttribute("MagicUnlock" .. kind .. "_" .. id) == true
end

function Service.selectAwakeningProfile(player: Player, profileId: any): (boolean, string?)
	if type(profileId) ~= "string" or not MagicProfiles[profileId] then
		return false, "Choose a valid Magic Focus profile"
	end
	if not profiles[player] then
		bind(player)
	end
	local selected, accepted, reason =
		Spec.selectAwakeningProfile(profiles[player], profileId, MagicProfiles, Config.ProgressionEnabled == true)
	if not accepted or not selected then
		return false, reason
	end
	profiles[player] = selected
	if not loaded[player] then
		pendingProfileSelections[player] = profileId
		refreshAttributes(player)
		return true, nil
	end
	refreshAttributes(player)
	markDirty(player)
	return true, nil
end

function Service.awakeningProfileId(player: Player): string?
	local profileId = profiles[player] and profiles[player].AwakeningProfileId
	return if type(profileId) == "string" and MagicProfiles[profileId] then profileId else "RecruitGeneric"
end

function Service.validateVisual(player: Player, visual, previous): (boolean, string?)
	if type(visual) ~= "table" then
		return false, "Visual settings must be a table"
	end
	if Config.ProgressionEnabled ~= true then
		return true, nil
	end
	local palette = visual.Palette
	if palette and palette ~= "LegacyCustom" and not Service.isUnlocked(player, "Palette", palette) then
		local priorPalette = previous and previous.Visual and previous.Visual.Palette
		if priorPalette ~= palette then
			local data = Spec.Palettes[palette]
			return false, data and ("Palette locked · " .. data.Requirement) or "Unknown palette"
		end
	end
	local shape = visual.CoreShape
	if shape and not Service.isUnlocked(player, "Shape", shape) then
		local priorShape = previous and previous.Visual and previous.Visual.CoreShape
		if priorShape ~= shape then
			local data = Spec.Shapes[shape]
			return false, data and ("Shape undiscovered · " .. data.Requirement) or "Unknown shape"
		end
	end
	return true, nil
end

function Service.validateExpression(player: Player, principle: string, expression: string, previous): (boolean, string?)
	local requirement = Spec.Expressions[expression]
	if not requirement or requirement.Principle ~= principle then
		return false, "Expression does not belong to the selected Principle"
	end
	if Config.ProgressionEnabled ~= true then
		return true, nil
	end
	if Service.isUnlocked(player, "Expression", expression) then
		return true, nil
	end
	local previousSource = previous and previous.Source
	if previousSource and previousSource.Principle == principle and previousSource.Expression == expression then
		return true, nil
	end
	return false, "Expression locked · " .. requirement.Requirement
end

function Service.progress(player: Player)
	local progress = Spec.progress(profiles[player] or empty(), Config.ProgressionEnabled == true)
	progress.AwakeningProfileId = Service.awakeningProfileId(player) or "RecruitGeneric"
	return progress
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">MagicFormExecutors</string>
            <string name="Source"><![CDATA[--!strict

-- V2 form dispatch. Each executor operates entirely through its supplied
-- context, which keeps this registry independent of individual spell IDs.
local Forms = {}

Forms.Executors = {
	Aura = function(d, context)
		context.CreateAura(d)
	end,
	Construct = function(d, context)
		context.CreateConstruct(d)
	end,
	Projectile = function(definition, context)
		context.CreateProjectile(definition)
	end,
	Wave = function(definition, context)
		context.ExecuteWave(definition)
	end,
	Beam = function(definition: any, context: any)
		context.ExecuteBeam(definition)
	end,
	Field = function(definition: any, context: any)
		context.CreateField(definition)
	end,
	SelfEnhancement = function(definition: any, context: any)
		context.ApplySelf(definition)
	end,
	Manipulation = function(definition: any, context: any)
		context.ApplyManipulation(definition)
	end,
}

function Forms.execute(form: string, definition: any, context: any): boolean
	local executor = Forms.Executors[form]
	if not executor then
		return false
	end
	executor(definition, context)
	return true
end

return Forms
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">MagicLabService</string>
            <string name="Source"><![CDATA[--!strict
-- A separate development transport; never accepts a live-player spell registry edit.
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.MagicLab)
local Slots = require(Shared.Modules.MagicSlots)
local Spec = require(Shared.Modules.SpellSpec)
local Profile = require(Shared.Modules.MagicLibraryProfile)
local Library = require(Shared.Modules.GrimoireLibrary)
local Starters = require(Shared.Modules.GrimoireStarters)
local LabCost = require(Shared.Modules.MagicLabCost)
local Magic = require(script.Parent.MagicService)
local Lab = {}

function Lab.start(folder: Folder, getState: (Player) -> any, feedback: RemoteEvent)
	local request = Instance.new("RemoteEvent")
	request.Name = "MagicLabRequest"
	request.Parent = folder
	local response = Instance.new("RemoteEvent")
	response.Name = "MagicLabResponse"
	response.Parent = folder
	local catalogResponse = Instance.new("RemoteEvent")
	catalogResponse.Name, catalogResponse.Parent = "GrimoireResponse", folder
	local catalogs = {}
	local saving = {}
	local loading = {}
	local last: { [Player]: number } = {}
	local definitions: { [Player]: any } = {}
	local loaded: { [Player]: boolean } = {}
	local writable: { [Player]: boolean } = {}
	local dirty: { [Player]: boolean } = {}
	local saveRevision: { [Player]: number } = {}
	local store
	local storeReady = pcall(function()
		store = DataStoreService:GetDataStore(Config.LibraryDataStoreName)
	end)
	if not storeReady then
		store = nil
	end

	local function allowed(): boolean
		return Config.Enabled and (RunService:IsStudio() or (not Config.StudioOnly and Config.AllowLive))
	end
	local function ready(player: Player): boolean
		local state = getState(player)
		return state ~= nil
			and state.Character == player.Character
			and state.Humanoid.Health > 0
			and state.Root:IsDescendantOf(workspace)
			and player:GetAttribute("OpeningComplete") == true
	end
	local function slotId(slot: number): string?
		return Slots.id(slot)
	end
	local function validateStored(definition): boolean
		if type(definition) ~= "table" then
			return false
		end
		local clean = Spec.copy(definition)
		clean.Development = nil
		LabCost.normalize(clean)
		for _, colorKey in { "Color", "SecondaryColor", "AccentColor" } do
			local color = if type(clean.Visual) == "table" then clean.Visual[colorKey] else nil
			if type(color) == "table" then
				if
					type(color[1]) ~= "number"
					or type(color[2]) ~= "number"
					or type(color[3]) ~= "number"
					or color[1] < 0
					or color[1] > 1
					or color[2] < 0
					or color[2] > 1
					or color[3] < 0
					or color[3] > 1
				then
					return false
				end
				clean.Visual[colorKey] = Color3.new(color[1], color[2], color[3])
			end
		end
		local ok = Spec.validate(clean)
		return ok == true
	end
	local function hydrate(definition, slot: number, id: string)
		LabCost.normalize(definition)
		for _, colorKey in { "Color", "SecondaryColor", "AccentColor" } do
			local color = if type(definition.Visual) == "table" then definition.Visual[colorKey] else nil
			if
				type(color) == "table"
				and type(color[1]) == "number"
				and type(color[2]) == "number"
				and type(color[3]) == "number"
				and color[1] >= 0
				and color[1] <= 1
				and color[2] >= 0
				and color[2] <= 1
				and color[3] >= 0
				and color[3] <= 1
			then
				definition.Visual[colorKey] = Color3.new(color[1], color[2], color[3])
			end
		end
		if validateStored(definition) then
			if type(definition.Visual) == "table" and definition.Visual.Palette == nil then
				-- Preserve pre-discovery RGB authoring without changing its appearance.
				definition.Visual.Palette = "LegacyCustom"
			end
			definition.SpellId = id
			LabCost.refresh(definition, Spec.estimate, Spec.copy)
			definition.Development = true
		end
		return definition
	end
	local function dehydrate(definition, slot: number, id: string)
		definition.SpellId = id
		LabCost.refresh(definition, Spec.estimate, Spec.copy)
		definition.Development = nil
		for _, colorKey in { "Color", "SecondaryColor", "AccentColor" } do
			local color = if type(definition.Visual) == "table" then definition.Visual[colorKey] else nil
			if typeof(color) == "Color3" then
				definition.Visual[colorKey] = { color.R, color.G, color.B }
			end
		end
		return definition
	end
	local function makePublic(defs)
		local public = {}
		for slot, value in pairs(defs) do
			local definition = Spec.copy(value)
			definition.Development = nil
			public[tostring(slot)] = definition
		end
		return public
	end
	local function reply(player: Player, action, ok: boolean, text: string, data, slot)
		response:FireClient(player, ok, text, data, action, slot)
	end
	local function profileKey(player: Player): string
		return "u:" .. tostring(player.UserId)
	end
	local function decode(raw)
		local slotData = raw
		if type(raw) == "table" and raw.Version == Library.Version then
			slotData = { Version = Profile.Version, Slots = raw.Slots }
		end
		local defs, safe, reason = Profile.decode(slotData, Slots.Count, slotId, validateStored, Spec.copy, hydrate)
		if not safe then
			return defs, false, reason
		end
		local catalog, catalogReason = Library.decode(raw, defs, Spec.copy, validateStored, hydrate)
		return defs, catalog ~= nil, catalogReason, catalog
	end
	local function publish(player, ok, text, slot, saveState)
		if loaded[player] and not writable[player] then
			text ..= " · session only; persistent storage is unavailable or protected"
		end
		local catalog = Spec.copy(catalogs[player] or Library.empty())
		catalog.SaveState = saveState
			or (if not writable[player] then "SESSION ONLY" elseif dirty[player] then "SAVING" else "SAVED")
		for _, record in pairs(catalog.Records) do
			record.Definition.Development = nil
		end
		catalogResponse:FireClient(player, ok, text, catalog, makePublic(definitions[player] or {}), slot)
	end
	local function save(player: Player): (boolean, string)
		-- Serialize writes so a slower older save cannot overwrite a newer snapshot.
		while saving[player] do
			task.wait(0.1)
		end
		if not dirty[player] then
			return true, "Spell library is unchanged"
		end
		if not loaded[player] then
			return false, "Spell library has not loaded"
		end
		if not writable[player] or not store then
			return false, "Persistent storage is unavailable; this session remains usable"
		end
		local snapshot, encodeFailure =
			Profile.encode(definitions[player] or {}, Slots.Count, slotId, validateStored, Spec.copy, dehydrate)
		if not snapshot then
			return false, encodeFailure or "Spell library could not be saved"
		end
		snapshot.Version = Library.Version
		snapshot.Catalog = Spec.copy(catalogs[player] or Library.empty())
		for _, record in pairs(snapshot.Catalog.Records) do
			record.Definition = dehydrate(record.Definition, 1, record.Definition.SpellId)
		end
		local _, validSnapshot, invalidReason = decode(snapshot)
		if not validSnapshot then
			return false, invalidReason or "Library validation failed"
		end
		local rejectedExistingProfile = false
		local savedRevision = saveRevision[player]
		saving[player] = true
		local ok, result = pcall(function()
			return store:UpdateAsync(profileKey(player), function(existing)
				rejectedExistingProfile = false
				if existing ~= nil then
					local _, safe = decode(existing)
					if not safe then
						rejectedExistingProfile = true
						return nil
					end
				end
				return snapshot
			end)
		end)
		saving[player] = nil
		if not ok then
			return false, "Spell library save failed; session copy is still equipped"
		end
		if rejectedExistingProfile or result == nil then
			writable[player] = false
			return false, "Existing spell data was not overwritten because it could not be validated"
		end
		if saveRevision[player] == savedRevision then
			dirty[player] = nil
		end
		return true, "Spell library saved"
	end
	local function scheduleSave(player: Player)
		if not writable[player] then
			return
		end
		saveRevision[player] = (saveRevision[player] or 0) + 1
		dirty[player] = true
		local revision = saveRevision[player]
		task.delay(Config.LibrarySaveDebounce, function()
			if player.Parent ~= Players or saveRevision[player] ~= revision then
				return
			end
			local ok, text = save(player)
			reply(player, "Save", ok, text, nil, nil)
		end)
	end
	local function seedStarters(player: Player)
		local catalog = catalogs[player]
		for _, collection in ipairs(catalog.Collections) do
			if collection == Starters.Collection then
				return
			end
		end
		local templates = Starters.build()
		local recordCount = 0
		for _ in pairs(catalog.Records) do
			recordCount += 1
		end
		if recordCount + #templates > Library.MaxRecords or #catalog.Collections >= Library.MaxCollections then
			return
		end
		table.insert(catalog.Collections, Starters.Collection)
		for _, template in ipairs(templates) do
			local definition = Spec.copy(template.Definition)
			LabCost.refresh(definition, Spec.estimate, Spec.copy)
			local valid, reason = Spec.validate(definition)
			assert(valid, "Starter failed server validation: " .. tostring(reason))
			local id = assert(Library.add(catalog, definition, Spec.copy, os.time()))
			catalog.Records[id].Collection = Starters.Collection
			catalog.Records[id].Tags = Starters.Tag
		end
		if writable[player] then
			scheduleSave(player)
		end
	end
	local function load(player: Player)
		if loading[player] then
			reply(player, "Load", false, "The library is still loading; try again shortly", nil, nil)
			return
		end
		if loaded[player] then
			publish(player, true, "Library ready")
			reply(player, "Load", true, "Spell library ready", makePublic(definitions[player] or {}), nil)
			return
		end
		if not store then
			catalogs[player] = Library.empty()
			definitions[player] = {}
			loaded[player], writable[player] = true, false
			seedStarters(player)
			reply(player, "Load", true, "Session library ready · persistent storage unavailable", {}, nil)
			return
		end
		loading[player] = true
		local ok, raw = pcall(function()
			return store:GetAsync(profileKey(player))
		end)
		loading[player] = nil
		if player.Parent ~= Players then
			return
		end
		if not ok then
			catalogs[player] = Library.empty()
			definitions[player] = {}
			loaded[player], writable[player] = true, false
			seedStarters(player)
			reply(
				player,
				"Load",
				true,
				"Session library ready · DataStore unavailable; saved data was not changed",
				{},
				nil
			)
			return
		end
		local result, safe, reason, catalog = decode(raw)
		if not safe then
			catalogs[player] = Library.empty()
			definitions[player] = {}
			loaded[player], writable[player] = true, false
			seedStarters(player)
			reply(player, "Load", true, reason or "Saved library was left untouched; session library ready", {}, nil)
			return
		end
		catalogs[player] = catalog
		definitions[player] = result
		loaded[player], writable[player] = true, true
		seedStarters(player)
		for slot, definition in pairs(result) do
			Magic.setCompanionSpell(player, slot, definition)
		end
		reply(player, "Load", true, "Spell library loaded", makePublic(result), nil)
	end

	request.OnServerEvent:Connect(function(player, action, data, slot)
		if not allowed() then
			return
		end
		local now = os.clock()
		if now - (last[player] or -math.huge) < 0.1 then
			response:FireClient(player, false, "Please wait briefly between Lab requests", nil, action, slot)
			return
		end
		last[player] = now
		if not ready(player) then
			response:FireClient(player, false, "Character is not ready", nil, action, slot)
			return
		end
		if action == "Load" then
			load(player)
			publish(player, true, "Library ready")
			return
		end
		if action == "Library" then
			if not loaded[player] or type(data) ~= "table" or type(data.Action) ~= "string" then
				publish(player, false, "Load the library first")
				return
			end
			if data.Action == "RetrySave" then
				local ok, text = save(player)
				publish(player, ok, text, nil, (not ok and writable[player]) and "SAVE FAILED · SESSION COPY" or nil)
				return
			end
			local catalog = catalogs[player]
			local ok, text = false, "Unknown library action"
			local changedSlot
			if data.Action == "Equip" or data.Action == "Unequip" then
				local id = Slots.id(data.Slot)
				local record = type(data.Id) == "string" and catalog.Records[data.Id]
				if not id or (data.Action == "Equip" and (not record or record.Archived)) then
					publish(player, false, "Choose an active spell and a valid slot")
					return
				end
				local definition = record and Spec.copy(record.Definition)
				if definition then
					definition.SpellId, definition.Development = id, nil
					local valid, reason = Spec.validate(definition)
					if not valid then
						publish(player, false, reason)
						return
					end
					LabCost.refresh(definition, Spec.estimate, Spec.copy)
					definition.Development = true
				end
				Magic.clearTemporary(player, getState(player), id)
				definitions[player][data.Slot] = if data.Action == "Equip" then definition else nil
				catalog.Assignments[tostring(data.Slot)] = if data.Action == "Equip" then data.Id else nil
				Magic.setCompanionSpell(player, data.Slot, definitions[player][data.Slot])
				changedSlot = data.Slot
				ok, text =
					true,
					if data.Action == "Equip" then "Spell equipped" else "Slot cleared; spell remains in the library"
			elseif data.Action == "SaveNew" then
				if type(data.Definition) ~= "table" then
					publish(player, false, "Spell definition is required")
					return
				end
				local valid, reason = Spec.validate(data.Definition)
				if not valid then
					publish(player, false, reason)
					return
				end
				local definition = Spec.copy(data.Definition)
				LabCost.refresh(definition, Spec.estimate, Spec.copy)
				local recordId, addReason = Library.add(catalog, definition, Spec.copy, os.time())
				if recordId then
					catalog.Records[recordId].Definition = Spec.copy(definition)
					ok, text = true, "Saved as a separate library spell; no loadout slot changed"
				else
					text = addReason or "Spell could not be saved to the library"
				end
			elseif data.Action == "Update" then
				local record = type(data.Id) == "string" and catalog.Records[data.Id]
				if not record or record.Archived or type(data.Definition) ~= "table" then
					publish(player, false, "Choose an active saved spell and provide its revised definition")
					return
				end
				local valid, reason = Spec.validate(data.Definition)
				if not valid then
					publish(player, false, reason)
					return
				end
				local definition = Spec.copy(data.Definition)
				definition.SpellId = record.Definition.SpellId or Slots.id(1)
				definition.Development = true
				LabCost.refresh(definition, Spec.estimate, Spec.copy)
				ok, text = Library.update(catalog, data.Id, definition, Spec.copy, os.time())
				if ok then
					for key, assignedId in pairs(catalog.Assignments) do
						if assignedId == data.Id then
							local assignedSlot = tonumber(key)
							local assigned = Spec.copy(definition)
							assigned.SpellId = Slots.id(assignedSlot)
							Magic.clearTemporary(player, getState(player), assigned.SpellId)
							definitions[player][assignedSlot] = assigned
							Magic.setCompanionSpell(player, assignedSlot, assigned)
						end
					end
				end
			else
				ok, text = Library.mutate(catalog, data.Action, data, Spec.copy, os.time())
				if ok and data.Action == "Rename" then
					for key, id in pairs(catalog.Assignments) do
						if id == data.Id then
							definitions[player][tonumber(key)].Name = catalog.Records[id].Definition.Name
							Magic.setCompanionSpell(player, tonumber(key), definitions[player][tonumber(key)])
						end
					end
				end
			end
			if ok then
				dirty[player] = true
				scheduleSave(player)
			end
			publish(
				player,
				ok,
				text
					.. (
						if ok
							then " · " .. (if writable[player] then "saving" else "session only; storage unavailable")
							else ""
					),
				changedSlot
			)
			return
		end
		local slotIdValue = slotId(slot)
		if not slotIdValue then
			return
		end
		local state = getState(player)
		if action == "Apply" then
			if not loaded[player] then
				reply(player, action, false, "Load the spell library before editing slots", nil, slot)
				return
			end
			local ok, reason = Spec.validate(data)
			if not ok then
				reply(player, action, false, reason, nil, slot)
				return
			end
			-- The Lab is a development editor: progression never gates valid test spells.
			-- Spec.validate above still enforces expressions, visual enums, and compatibility.
			local catalog = catalogs[player] or Library.empty()
			catalogs[player] = catalog
			local recordId, recordReason = Library.capture(catalog, slot, data, Spec.copy, os.time())
			if not recordId then
				reply(player, action, false, recordReason, nil, slot)
				return
			end
			local definition = Spec.copy(data)
			definition.SpellId = slotIdValue
			LabCost.refresh(definition, Spec.estimate, Spec.copy)
			definition.Development = true -- server-only capability, rejected if supplied in client schema
			catalog.Records[recordId].Definition = Spec.copy(definition)
			-- Keep references to the same library spell consistent across equipped slots.
			for key, id in pairs(catalog.Assignments) do
				local otherSlot = tonumber(key)
				if id == recordId and otherSlot ~= slot then
					local other = Spec.copy(definition)
					other.SpellId = Slots.id(otherSlot)
					Magic.clearTemporary(player, getState(player), other.SpellId)
					definitions[player][otherSlot] = other
					Magic.setCompanionSpell(player, otherSlot, other)
				end
			end
			Magic.clearTemporary(player, state, slotIdValue)
			definitions[player] = definitions[player] or {}
			definitions[player][slot] = definition
			dirty[player] = true
			Magic.setCompanionSpell(player, slot, definition)
			scheduleSave(player)
			publish(player, true, "Library updated")
			reply(
				player,
				action,
				true,
				"Equipped slot "
					.. slot
					.. (writable[player] and " · saving library" or " · session only; storage unavailable"),
				definition.Cost,
				slot
			)
		elseif action == "Cast" then
			if
				typeof(data) ~= "table"
				or data.Character ~= player.Character
				or typeof(data.AimDirection) ~= "Vector3"
				or typeof(data.WorldPoint) ~= "Vector3"
				or (data.CastOrigin ~= nil and typeof(data.CastOrigin) ~= "Vector3")
				or (data.TargetModel ~= nil and typeof(data.TargetModel) ~= "Instance")
				or (data.TargetInstance ~= nil and typeof(data.TargetInstance) ~= "Instance")
			then
				return
			end
			local definition = definitions[player] and definitions[player][slot]
			if not definition then
				reply(player, action, false, "Apply a valid spell first", nil, slot)
				return
			end
			Magic.start(player, state, data, feedback, nil, definition)
		else
			reply(player, action, false, "Unknown Lab action", nil, slot)
		end
	end)

	local function releasePlayer(player: Player)
		if definitions[player] and writable[player] then
			local _, text = save(player)
			if text then
				-- Saving on leave is best-effort; the server shutdown path cannot rely on client feedback.
			end
		end
		catalogs[player], loading[player] = nil, nil
		last[player], definitions[player], loaded[player], writable[player], dirty[player], saveRevision[player] =
			nil, nil, nil, nil, nil, nil
	end
	Players.PlayerRemoving:Connect(releasePlayer)
	game:BindToClose(function()
		for player in pairs(definitions) do
			if writable[player] then
				save(player)
			end
		end
	end)
end

return Lab
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">MagicManipulationExecutors</string>
            <string name="Source"><![CDATA[--!strict

-- Discrete world-manipulation operations. Authorization and target selection
-- remain in MagicService; this registry only applies the authored operation.
local Manipulation = {}

local directionByOperation = {
	Raise = 1,
	Lower = -1,
}

function Manipulation.offset(operation, distance)
	local direction = directionByOperation[operation]
	if not direction then
		return nil
	end
	return direction * distance
end

function Manipulation.execute(operation, target, distance)
	local verticalOffset = Manipulation.offset(operation, distance)
	if verticalOffset == nil then
		return false
	end
	target.Position = target.Position + Vector3.yAxis * verticalOffset
	return true
end

return Manipulation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">MagicPayloadExecutors</string>
            <string name="Source"><![CDATA[--!strict

-- Small registry for payload kinds the runtime currently supports. Context is
-- supplied by MagicService so executors remain neutral about spell identities.
local Damage = require(script.Parent.DamageService)
local Movement = require(script.Parent.MovementService)
local Status = require(script.Parent.MagicStatusEffectService)
local Control = require(script.Parent.MagicControlService)
local Ownership = require(script.Parent.MagicPhysicsOwnership)

local AttributeSpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicAttributeSpec)
local MagicLab = require(game:GetService("ReplicatedStorage").Shared.Configuration.MagicLab)
local TemporalRate = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicTemporalRate)
local BodyRegion = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicBodyRegionSpec)
local ElementalInteractions = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicElementalInteractionSpec)
local Payloads = {}
local periodicEffects = {}
local RunService = game:GetService("RunService")

local function setPeriodicDeathCallback(effect, callback)
	if effect.DeathConnection then
		effect.DeathConnection:Disconnect()
		effect.DeathConnection = nil
	end
	effect.TargetDeathCallback = callback
	if callback then
		effect.DeathConnection = effect.Target.Died:Connect(function()
			local casterHumanoid = effect.Caster:FindFirstChildOfClass("Humanoid")
			local elapsed = math.max(0, os.clock() - (effect.LastUpdateAt or os.clock()))
			local remaining = TemporalRate.advance(effect.Remaining or 0, elapsed, Status.timeRate(effect.Target))
			if
				remaining <= 0
				or not casterHumanoid
				or casterHumanoid.Health <= 0
				or not effect.Caster:IsDescendantOf(workspace)
			then
				return
			end
			-- Let DamageService's synchronous KilledByThisSpell event claim this
			-- same death before the deferred DiedWhileAffected event is considered.
			task.defer(callback)
		end)
	end
end

local function removePeriodicEffect(index)
	local effect = periodicEffects[index]
	if effect and effect.DeathConnection then
		effect.DeathConnection:Disconnect()
		effect.DeathConnection = nil
	end
	table.remove(periodicEffects, index)
end

-- Brief server simulation for player-owned impulse targets; no control lock or stun.
RunService.Heartbeat:Connect(function()
	local now = os.clock()
	for i = #periodicEffects, 1, -1 do
		local effect = periodicEffects[i]
		local casterHumanoid = effect.Caster:FindFirstChildOfClass("Humanoid")
		if
			not effect.Caster:IsDescendantOf(workspace)
			or not casterHumanoid
			or casterHumanoid.Health <= 0
			or not effect.Target:IsDescendantOf(workspace)
			or effect.Target.Health <= 0
			or (
				effect.RequiredElementalMark
				and not Status.hasElementalMark(effect.Target, effect.RequiredElementalMark)
			)
		then
			removePeriodicEffect(i)
		else
			local elapsed = math.max(0, now - (effect.LastUpdateAt or now))
			local rate = Status.timeRate(effect.Target)
			effect.Remaining = TemporalRate.advance(effect.Remaining or 0, elapsed, rate)
			effect.UntilNext = TemporalRate.advance(effect.UntilNext or effect.Interval, elapsed, rate)
			effect.LastUpdateAt = now
			local due = effect.UntilNext <= 0
			if due and (effect.Remaining > 0 or -effect.Remaining <= effect.Interval * rate) then
				if effect.Kind == "DamageOverTime" then
					local dealt, absorbed =
						Damage.apply(effect.Caster, effect.Target, effect.Amount, effect.DamageContext)
					if dealt > 0 then
						effect.Feedback(effect.Target, dealt)
					end
					if absorbed > 0 then
						effect.EffectFeedback("Shield", effect.Target, absorbed)
					end
				else
					local restored = Status.heal(effect.Caster, effect.Target, effect.Amount)
					if restored > 0 then
						effect.EffectFeedback("Heal", effect.Target, restored)
					end
				end
			end
			if due then
				local overdue = math.max(0, -effect.UntilNext)
				effect.UntilNext += effect.Interval * (math.floor(overdue / effect.Interval) + 1)
			end
			if effect.Remaining <= 0 then
				removePeriodicEffect(i)
			end
		end
	end
end)
local function applyForce(root, velocity)
	if root.Anchored or root.AssemblyMass == math.huge then
		return
	end
	local token = {}
	Ownership.claim(root, token)
	task.delay(0.2, function()
		Ownership.release(root, token)
	end)
	Movement.allowMagicImpulse(root, velocity)
	root:ApplyImpulse(velocity * root.AssemblyMass)
end

local function payloadDamageContext(payload, context, target)
	if not context.DamageContext then
		return nil
	end
	local damageContext = table.clone(context.DamageContext)
	damageContext.DamageChannel = payload.DamageChannel or "Elemental"
	local targetModel = target and target.Parent
	local hitPart = damageContext.HitPart
	if
		typeof(hitPart) ~= "Instance"
		or not hitPart:IsA("BasePart")
		or not targetModel
		or not hitPart:IsDescendantOf(targetModel)
	then
		hitPart = targetModel and targetModel:FindFirstChild("HumanoidRootPart") or nil
	end
	local region, multiplier = BodyRegion.multiplier(payload, hitPart and hitPart.Name)
	damageContext.HitPart = hitPart
	damageContext.DamageRegion = region
	damageContext.RegionMultiplier = multiplier
	return damageContext
end

local function displacementDirection(payload, context, targetRoot)
	local casterRoot = context.Caster:FindFirstChild("HumanoidRootPart")
	local direction
	if payload.Mode == "TowardCaster" or payload.Mode == "AwayFromCaster" then
		if not casterRoot or not casterRoot:IsA("BasePart") then
			return nil
		end
		direction = casterRoot.Position - targetRoot.Position
		if payload.Mode == "AwayFromCaster" then
			direction = -direction
		end
	else
		direction = context.Direction
		if payload.Mode == "AgainstAim" then
			direction = -direction
		end
	end
	if typeof(direction) ~= "Vector3" then
		return nil
	end
	direction = Vector3.new(direction.X, 0, direction.Z)
	return if direction.Magnitude > 0.001 then direction.Unit else nil
end

local function displaceTarget(payload, context, humanoid)
	local model = humanoid.Parent
	local root = model and model:FindFirstChild("HumanoidRootPart")
	if
		not model
		or not model:IsA("Model")
		or not root
		or not root:IsA("BasePart")
		or humanoid.Health <= 0
		or root.Anchored
		or not model:IsDescendantOf(workspace)
	then
		return false
	end
	local direction = displacementDirection(payload, context, root)
	if not direction then
		return false
	end
	local distance = math.clamp(payload.Distance * context.Potency, 1, MagicLab.MaxDisplacementDistance)
	local displacement = direction * distance
	local destinationXZ = root.Position + displacement
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { context.Caster, model }
	rayParams.RespectCanCollide = true
	if workspace:Raycast(root.Position, displacement, rayParams) then
		return false
	end
	local groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Exclude
	groundParams.FilterDescendantsInstances = { context.Caster, model }
	groundParams.RespectCanCollide = true
	local ground = workspace:Raycast(destinationXZ + Vector3.new(0, 8, 0), Vector3.new(0, -24, 0), groundParams)
	if not ground or ground.Normal.Y < 0.55 then
		return false
	end
	local currentFloorY = root.Position.Y - humanoid.HipHeight - root.Size.Y * 0.5
	local verticalChange = ground.Position.Y - currentFloorY
	if math.abs(verticalChange) > 4 then
		return false
	end
	local destination =
		Vector3.new(destinationXZ.X, ground.Position.Y + humanoid.HipHeight + root.Size.Y * 0.5, destinationXZ.Z)
	local _, extents = model:GetBoundingBox()
	local clearanceSize =
		Vector3.new(math.clamp(extents.X, 2, 8), math.clamp(extents.Y, 4, 12), math.clamp(extents.Z, 2, 8))
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { context.Caster, model }
	overlap.RespectCanCollide = true
	if #workspace:GetPartBoundsInBox(CFrame.new(destination), clearanceSize, overlap) > 0 then
		return false
	end
	local ownershipToken = {}
	if not Ownership.claim(root, ownershipToken) then
		return false
	end
	local ok = pcall(function()
		model:PivotTo(model:GetPivot() + (destination - root.Position))
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
	end)
	task.delay(0.2, function()
		Ownership.release(root, ownershipToken)
	end)
	if ok then
		context.EffectFeedback("Displacement", humanoid, distance)
	end
	return ok
end

-- Payload metadata stays beside the executor registry so cross-cutting runtime
-- behavior does not need to grow a payload-kind conditional list.
Payloads.Metadata = {
	Damage = { TracksHumanoidTargets = true },
	DamageOverTime = { TracksHumanoidTargets = true },
	Heal = { TracksHumanoidTargets = true },
	Restoration = { TracksHumanoidTargets = true },
	Shield = { TracksHumanoidTargets = true },
	ModifyAttribute = { TracksHumanoidTargets = true },
	Transformation = { TracksHumanoidTargets = true },
	Slow = { TracksHumanoidTargets = true },
	Bind = { TracksHumanoidTargets = true },
	Reveal = { TracksHumanoidTargets = true },
	Control = { TracksHumanoidTargets = true },
	Force = { TracksHumanoidTargets = true },
	Displacement = { TracksHumanoidTargets = true },
	TimeDilation = { TracksHumanoidTargets = true },
	Enhancement = { TracksHumanoidTargets = true },
	ElementalMark = { TracksHumanoidTargets = true },
	ConsumeElementalMark = { TracksHumanoidTargets = true },
}

Payloads.Executors = {
	ElementalMark = function(payload: any, context: any)
		local element = context.DamageContext and context.DamageContext.Element
		if type(element) ~= "string" or element == "Neutral" then
			return
		end
		for _, target in context.Targets or {} do
			if
				Status.elementalMark(context.Caster, target, context.SpellId, element, payload.Stacks, payload.Duration)
			then
				for _, effect in ElementalInteractions.effectsFor(element, payload.Duration) do
					local executor = Payloads.Executors[effect.Kind]
					if executor then
						local effectContext = table.clone(context)
						effectContext.Targets = { target }
						effectContext.RequiredElementalMark = effect.RequiresElementalMark
						effect.Element = effect.Element or element
						executor(effect, effectContext)
					end
				end
			end
		end
	end,
	ConsumeElementalMark = function(payload: any, context: any)
		local element = payload.Element or (context.DamageContext and context.DamageContext.Element)
		if type(element) ~= "string" or element == "Neutral" then
			return
		end
		for _, target in context.Targets or {} do
			Status.consumeElementalMark(target, element, payload.Stacks)
		end
	end,
	DamageOverTime = function(payload, context)
		local now = os.clock()
		for _, target in context.Targets or {} do
			local damageContext = payloadDamageContext(payload, context, target)
			local existing
			local casterCount = 0
			for _, effect in periodicEffects do
				if effect.Caster == context.Caster then
					casterCount += 1
					if
						effect.Target == target
						and effect.SpellId == context.SpellId
						and effect.Kind == "DamageOverTime"
						and effect.RequiredElementalMark == context.RequiredElementalMark
					then
						existing = effect
					end
				end
			end
			if existing then
				-- Refresh duration/strength, never postpone the already scheduled next tick.
				existing.Remaining = payload.Duration
				existing.LastUpdateAt = now
				existing.Amount = payload.Amount * context.Potency
				existing.Interval = payload.Interval
				existing.Feedback = context.HitFeedback
				existing.EffectFeedback = context.EffectFeedback
				existing.DamageContext = damageContext
				existing.RequiredElementalMark = context.RequiredElementalMark
				setPeriodicDeathCallback(existing, context.TargetDeathCallback and context.TargetDeathCallback(target))
			elseif
				#periodicEffects < MagicLab.MaxPeriodicEffectsGlobal
				and casterCount < MagicLab.MaxPeriodicEffectsPerCaster
			then
				local effect = {
					Kind = "DamageOverTime",
					Caster = context.Caster,
					Target = target,
					SpellId = context.SpellId,
					Amount = payload.Amount * context.Potency,
					Interval = payload.Interval,
					UntilNext = payload.Interval,
					Remaining = payload.Duration,
					LastUpdateAt = now,
					Feedback = context.HitFeedback,
					EffectFeedback = context.EffectFeedback,
					DamageContext = damageContext,
					RequiredElementalMark = context.RequiredElementalMark,
				}
				setPeriodicDeathCallback(effect, context.TargetDeathCallback and context.TargetDeathCallback(target))
				table.insert(periodicEffects, effect)
			end
		end
	end,
	Restoration = function(payload: any, context: any)
		local now = os.clock()
		for _, target in context.Targets or {} do
			local existing
			local casterCount = 0
			for _, effect in periodicEffects do
				if effect.Caster == context.Caster then
					casterCount += 1
					if
						effect.Target == target
						and effect.SpellId == context.SpellId
						and effect.Kind == "Restoration"
					then
						existing = effect
					end
				end
			end
			if existing then
				existing.Remaining = payload.Duration
				existing.LastUpdateAt = now
				existing.Amount = payload.Amount * context.Potency
				existing.Interval = payload.Interval
				existing.EffectFeedback = context.EffectFeedback
				setPeriodicDeathCallback(existing, context.TargetDeathCallback and context.TargetDeathCallback(target))
			elseif
				#periodicEffects < MagicLab.MaxPeriodicEffectsGlobal
				and casterCount < MagicLab.MaxPeriodicEffectsPerCaster
			then
				local effect = {
					Kind = "Restoration",
					Caster = context.Caster,
					Target = target,
					SpellId = context.SpellId,
					Amount = payload.Amount * context.Potency,
					Interval = payload.Interval,
					UntilNext = payload.Interval,
					Remaining = payload.Duration,
					LastUpdateAt = now,
					EffectFeedback = context.EffectFeedback,
				}
				setPeriodicDeathCallback(effect, context.TargetDeathCallback and context.TargetDeathCallback(target))
				table.insert(periodicEffects, effect)
			end
		end
	end,
	Damage = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			local damageContext = payloadDamageContext(payload, context, humanoid)
			local dealt, absorbed =
				Damage.apply(context.Caster, humanoid, payload.Amount * context.Potency, damageContext)
			if dealt > 0 then
				context.HitFeedback(humanoid, dealt)
			end
			if absorbed > 0 then
				context.EffectFeedback("Shield", humanoid, absorbed)
			end
		end
	end,
	Heal = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			local restored = Status.heal(context.Caster, humanoid, payload.Amount * context.Potency)
			if restored > 0 then
				context.EffectFeedback("Heal", humanoid, restored)
			end
		end
	end,
	Shield = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			local onBreak = if context.DamageContext
				then function(target)
					context.DamageContext.EmitEvent("OnBreak", target)
				end
				else nil
			local added = Status.shield(
				context.Caster,
				humanoid,
				context.SpellId,
				payload.Amount * context.Potency,
				payload.Duration,
				onBreak,
				context.TargetDeathCallback and context.TargetDeathCallback(humanoid)
			)
			if added then
				context.EffectFeedback("Shield", humanoid, payload.Amount * context.Potency)
			end
		end
	end,
	ModifyAttribute = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			local amount = AttributeSpec.clamp(payload.Attribute, payload.Amount * context.Potency)
			if
				amount ~= nil
				and Status.modifyAttribute(
					context.Caster,
					humanoid,
					context.SpellId,
					payload.Attribute,
					amount,
					payload.Duration,
					context.TargetDeathCallback and context.TargetDeathCallback(humanoid),
					context.RequiredElementalMark
				)
			then
				context.EffectFeedback(payload.Attribute, humanoid, amount)
			end
		end
	end,
	Transformation = function(payload: any, context: any)
		if payload.Mode ~= "Scale" then
			return
		end
		for _, humanoid in context.Targets or {} do
			local multiplier = 1 + (payload.Multiplier - 1) * context.Potency
			if
				Status.transform(
					context.Caster,
					humanoid,
					context.SpellId,
					multiplier,
					payload.Duration,
					context.TargetDeathCallback and context.TargetDeathCallback(humanoid)
				)
			then
				context.EffectFeedback("Transformation", humanoid, multiplier)
			end
		end
	end,
	Slow = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			local multiplier = 1 - (1 - payload.Multiplier) * context.Potency
			if
				Status.slow(
					context.Caster,
					humanoid,
					context.SpellId,
					multiplier,
					payload.Duration,
					context.TargetDeathCallback and context.TargetDeathCallback(humanoid),
					context.RequiredElementalMark
				)
			then
				context.EffectFeedback("Slow", humanoid, multiplier)
			end
		end
	end,
	Bind = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			if
				Status.bind(
					context.Caster,
					humanoid,
					context.SpellId,
					payload.Duration,
					context.TargetDeathCallback and context.TargetDeathCallback(humanoid)
				)
			then
				context.EffectFeedback("Bind", humanoid, payload.Duration)
			end
		end
	end,
	Reveal = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			if
				context.Player
				and Status.reveal(
					context.Player,
					context.Caster,
					humanoid,
					context.SpellId,
					payload.Duration,
					context.Color,
					context.TargetDeathCallback and context.TargetDeathCallback(humanoid)
				)
			then
				context.EffectFeedback("Reveal", humanoid, payload.Duration)
			end
		end
	end,
	Control = function(payload: any, context: any)
		for _, target in context.Targets or {} do
			local applied, started
			if target:IsA("Humanoid") then
				applied, started = Control.apply(
					context.Caster,
					target,
					context.SpellId,
					payload,
					context.Potency,
					context.TargetDeathCallback and context.TargetDeathCallback(target)
				)
			elseif target:IsA("BasePart") then
				applied, started =
					Control.applyObject(context.Caster, target, context.SpellId, payload, context.Potency)
			end
			if applied and started then
				context.EffectFeedback("Control", target, payload.Acceleration * context.Potency)
			end
		end
	end,
	Force = function(payload: any, context: any)
		for _, target in context.Targets or {} do
			local root = if target:IsA("Humanoid")
				then target.Parent and target.Parent:FindFirstChild("HumanoidRootPart")
				else target
			if root and root:IsA("BasePart") and not root.Anchored then
				local direction = context.Direction
				if direction.Magnitude < 0.001 then
					local delta = root.Position - context.Origin
					direction = if delta.Magnitude > 0.001 then delta.Unit else Vector3.yAxis
				end
				applyForce(root, direction * payload.Magnitude + Vector3.new(0, payload.Upward or 0, 0))
			end
		end
	end,
	Displacement = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			displaceTarget(payload, context, humanoid)
		end
	end,
	TimeDilation = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			local rate = TemporalRate.clamp(payload.Rate)
			if
				Status.temporalRate(
					context.Caster,
					humanoid,
					context.SpellId,
					rate,
					payload.Duration,
					context.TargetDeathCallback and context.TargetDeathCallback(humanoid)
				)
			then
				context.EffectFeedback("TimeDilation", humanoid, rate)
			end
		end
	end,
	Enhancement = function(payload: any, context: any)
		context.ApplyEnhancement(payload)
	end,
	AerialMovement = function(payload: any, context: any)
		context.ApplyAerialMovement(payload)
	end,
	Manipulation = function(payload: any, context: any)
		context.ApplyManipulation(payload)
	end,
	Summon = function(payload: any, context: any)
		context.Summon(payload)
	end,
}

function Payloads.execute(payloads: { any }, context: any)
	for _, payload in payloads do
		local executor = Payloads.Executors[payload.Kind]
		if executor then
			local metadata = Payloads.Metadata[payload.Kind]
			if metadata and metadata.TracksHumanoidTargets then
				for _, target in context.Targets or {} do
					if context.TrackAffected then
						context.TrackAffected(target)
					end
				end
			end
			executor(payload, context)
		end
	end
end

return Payloads
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="142">
          <Properties>
            <string name="Name">MagicPersistentConstructStore</string>
            <string name="Source"><![CDATA[-- Server-owned versioned persistence for static world Constructs.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.MagicLab)
local Spec = require(Shared.Modules.MagicPersistentConstructSpec)

local Store = {}
local dataStore
local loaded = false
local writable = false
local profile = Spec.emptyProfile()
local key = string.format("place:%s:%s", tostring(game.GameId), tostring(game.PlaceId))

local function decode(raw)
	return Spec.decode(raw)
end

function Store.start(restore)
	if loaded then
		if writable then
			return true
		end
		return false, "Persistent Construct storage is unavailable"
	end
	local storeOk, store = pcall(function()
		return DataStoreService:GetDataStore(Config.PersistentConstructDataStoreName)
	end)
	if not storeOk then
		loaded = true
		return false, "Persistent Construct DataStore could not be opened"
	end
	dataStore = store
	local readOk, raw = pcall(function()
		return dataStore:GetAsync(key)
	end)
	if not readOk then
		loaded = true
		return false, "Persistent Construct world data could not be loaded; no saved data was changed"
	end
	local clean, valid, reason = decode(raw)
	if not valid then
		loaded = true
		return false, reason or "Persistent Construct world data failed validation"
	end
	profile, loaded, writable = clean, true, true
	for _, record in ipairs(profile.Records) do
		local ok, err = pcall(restore, record)
		if not ok then
			warn("Persistent Construct restore failed: " .. tostring(err))
		end
	end
	return true
end

function Store.add(record)
	if not loaded or not writable or not dataStore then
		return nil, "Persistent Construct storage is unavailable"
	end
	local candidate = {}
	for field, value in pairs(record) do
		candidate[field] = value
	end
	candidate.Id = HttpService:GenerateGUID(false)
	candidate.CreatedAt = os.time()
	local valid, validationReason = Spec.validateRecord(candidate)
	if not valid then
		return nil, validationReason
	end
	local rejected
	local ok, result = pcall(function()
		return dataStore:UpdateAsync(key, function(raw)
			rejected = nil
			local current, safe, reason = decode(raw)
			if not safe then
				rejected = reason or "Existing persistent world data failed validation"
				return nil
			end
			if #current.Records >= Spec.MaxRecords then
				rejected = "Persistent Construct world is at its configured record limit"
				return nil
			end
			local owned = 0
			for _, existing in ipairs(current.Records) do
				if existing.OwnerUserId == candidate.OwnerUserId then
					owned = owned + 1
				end
			end
			if owned >= Spec.MaxPerOwner then
				rejected = "You reached the persistent Construct limit for this place"
				return nil
			end
			table.insert(current.Records, candidate)
			return current
		end)
	end)
	if not ok then
		return nil, "Persistent Construct save failed; the cast was not created"
	end
	if rejected or result == nil then
		return nil, rejected or "Persistent Construct save was not committed"
	end
	local updated, safe, reason = decode(result)
	if not safe then
		writable = false
		return nil, reason or "Saved Persistent Construct world data failed validation"
	end
	profile = updated
	return candidate.Id
end

function Store.remove(id)
	if not loaded or not writable or not dataStore then
		return false, "Persistent Construct storage is unavailable"
	end
	local rejected
	local ok, result = pcall(function()
		return dataStore:UpdateAsync(key, function(raw)
			rejected = nil
			local current, safe, reason = decode(raw)
			if not safe then
				rejected = reason or "Existing persistent world data failed validation"
				return nil
			end
			for index = #current.Records, 1, -1 do
				if current.Records[index].Id == id then
					table.remove(current.Records, index)
				end
			end
			return current
		end)
	end)
	if not ok or rejected or result == nil then
		return false, rejected or "Persistent Construct removal could not be saved"
	end
	local updated, safe, reason = decode(result)
	if not safe then
		writable = false
		return false, reason or "Saved Persistent Construct world data failed validation"
	end
	profile = updated
	return true
end

function Store.status()
	return loaded, writable, #profile.Records
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="143">
          <Properties>
            <string name="Name">MagicPhysicsOwnership</string>
            <string name="Source"><![CDATA[--!strict

-- Keep server simulation active while one or more magic physics effects own a
-- root. Tokens let short impulses and maintained controls coexist safely.
local Players = game:GetService("Players")
local Ownership = {}
local states = setmetatable({}, { __mode = "k" })

function Ownership.claim(root: BasePart, token: any): boolean
	if root.Anchored or not root:IsDescendantOf(workspace) then
		return false
	end
	local state = states[root]
	if not state then
		if not root:CanSetNetworkOwnership() then
			return false
		end
		state = {
			Owner = root:GetNetworkOwner(),
			Automatic = root:GetNetworkOwnershipAuto(),
			Tokens = {},
		}
		states[root] = state
		local ok = pcall(function()
			root:SetNetworkOwner(nil)
		end)
		if not ok then
			states[root] = nil
			return false
		end
	end
	state.Tokens[token] = true
	return true
end

function Ownership.release(root: BasePart, token: any)
	local state = states[root]
	if not state then
		return
	end
	state.Tokens[token] = nil
	if next(state.Tokens) ~= nil then
		return
	end
	states[root] = nil
	if not root:IsDescendantOf(workspace) or not root:CanSetNetworkOwnership() then
		return
	end
	pcall(function()
		if state.Automatic or not state.Owner or state.Owner.Parent ~= Players then
			root:SetNetworkOwnershipAuto()
		else
			root:SetNetworkOwner(state.Owner)
		end
	end)
end

return Ownership
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="144">
          <Properties>
            <string name="Name">MagicPresentation</string>
            <string name="Source"><![CDATA[--!strict
-- Reusable replicated presentation only; no hit tests or gameplay effects.
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Configuration.MagicPresentation)
local BudgetSpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicPresentationBudget)
local VisualSpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicVisualSpec)
local TweenService = game:GetService("TweenService")
local Presentation = {}
local castRemote
local particleBudget = BudgetSpec.new(Config.ParticleBudget, os.clock())
function Presentation.start(folder)
	castRemote = Instance.new("RemoteEvent")
	castRemote.Name = "MagicPresentation"
	castRemote.Parent = folder
end
local function visualSettings(definition)
	return (definition and definition.Visual) or {}
end
function Presentation.material(definition)
	local name = visualSettings(definition).MaterialAppearance
	if name == nil or name == "Auto" then
		name = VisualSpec.autoMaterial(
			definition and definition.Source and definition.Source.Principle,
			definition and definition.Source and definition.Source.Expression,
			definition and definition.Form
		)
	end
	local material = if type(name) == "string" then Enum.Material[name] else nil
	return material or Enum.Material.Neon
end
local function particles(parent, color, rate, style, emission)
	if not BudgetSpec.acquireEmitter(particleBudget, rate) then
		return nil
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = Config.ParticleTexture
	if style == "Smoke" then
		emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	elseif style == "Embers" then
		emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
		emitter.Lifetime = NumberRange.new(0.35, 0.8)
		emitter.Speed = NumberRange.new(1, 4)
	else
		emitter.Lifetime = NumberRange.new(0.2, 0.55)
		emitter.Speed = NumberRange.new(0.5, 2)
	end
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = emission or 0.8
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	emitter.Rate = rate
	emitter.Parent = parent
	local released = false
	emitter.Destroying:Connect(function()
		if not released then
			released = true
			BudgetSpec.releaseEmitter(particleBudget, rate)
		end
	end)
	return emitter
end
local function emitParticles(emitter: ParticleEmitter?, count: number)
	if not emitter or not emitter.Parent then
		return
	end
	local allowed = BudgetSpec.takeBurst(particleBudget, count, os.clock())
	if allowed > 0 then
		emitter:Emit(allowed)
	end
end
local function environmentalLayer(parent: BasePart, definition: any?)
	local settings = visualSettings(definition)
	local style = settings.EnvironmentalVisual or "None"
	if style == "None" then
		return
	end
	local color = settings.SecondaryColor or settings.Color or Color3.new(1, 1, 1)
	local particleStyle = if style == "GroundMist" then "Smoke" else "Sparks"
	local emitter = particles(parent, color, 2, particleStyle, settings.Emission)
	if not emitter then
		return
	end
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.SpreadAngle = Vector2.new(35, 35)
	if style == "GroundMist" then
		emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
		emitter.Lifetime = NumberRange.new(1.2, 2.2)
		emitter.Speed = NumberRange.new(0.1, 0.7)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 2.2) })
		emitter.Transparency =
			NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.75), NumberSequenceKeypoint.new(1, 1) })
	else
		emitter.Lifetime = NumberRange.new(0.8, 1.6)
		emitter.Speed = NumberRange.new(0.3, 1.2)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0.35) })
	end
end
function Presentation.profile(definition)
	local profile = definition.Visual.Profile
	if not profile or profile == "Auto" then
		profile = Config.Forms[definition.Form]
	end
	return profile
end
function Presentation.timing(definition)
	local profile = Presentation.profile(definition)
	return Config.Timing[profile] or Config.Timing.ProjectileCast
end
local function cue(character, profile, phase, duration, gather)
	if castRemote then
		castRemote:FireAllClients(character, profile, phase, duration, gather)
	end
end
local function audioId(definition, key)
	local audio = definition and definition.Audio
	local id = audio and audio[key]
	return if type(id) == "string" and id ~= "" and string.match(id, "^%d+$") then id else nil
end
local function makeSound(definition, key, parent, looped)
	local id = audioId(definition, key)
	if not id or not parent or (definition.Audio.Volume or 0) <= 0 then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = "MagicAudio_" .. key
	sound.SoundId = "rbxassetid://" .. id
	sound.Volume = math.clamp(definition.Audio.Volume or 0.6, 0, 1)
	sound.RollOffMaxDistance = math.clamp(definition.Audio.RollOffMaxDistance or 80, 10, 250)
	sound.EmitterSize = 5
	sound.Looped = looped
	sound.Parent = parent
	sound:Play()
	if not looped then
		Debris:AddItem(sound, 20)
	end
	return sound
end
function Presentation.playSound(definition, key, position: Vector3, parent: Instance?)
	local emitter = parent
	if not emitter then
		local anchor = Instance.new("Part")
		anchor.Name = "MagicAudioEmitter"
		anchor.Size = Vector3.one * 0.1
		anchor.Position = position
		anchor.Anchored = true
		anchor.Transparency = 1
		anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = false, false, false
		anchor.Parent = workspace
		emitter = anchor
		local sound = makeSound(definition, key, emitter, false)
		if sound then
			Debris:AddItem(anchor, 20)
		else
			anchor:Destroy()
		end
		return sound
	end
	return makeSound(definition, key, emitter, false)
end
function Presentation.attachLoop(definition, key, parent: Instance)
	return makeSound(definition, key, parent, true)
end
function Presentation.stopLoop(parent: Instance, key: string)
	local sound = parent:FindFirstChild("MagicAudio_" .. key)
	if sound and sound:IsA("Sound") then
		Presentation.stopSound(sound)
	end
end
function Presentation.stopSound(sound: Sound?)
	if sound and sound.Parent then
		sound:Stop()
		sound:Destroy()
	end
end
local function stopAttachedAudio(parent: Instance)
	for _, child in parent:GetDescendants() do
		if child:IsA("Sound") and string.sub(child.Name, 1, 11) == "MagicAudio_" then
			Presentation.stopSound(child)
		end
	end
end
function Presentation.gather(character, definition, duration, gather, phase)
	local profile = Presentation.profile(definition)
	cue(character, profile, phase or "Gather", math.clamp(duration, 0.1, Config.MaxPoseDuration), gather)
	local settings = visualSettings(definition)
	local root = character:FindFirstChild("HumanoidRootPart")
	Presentation.playSound(
		definition,
		"ChargeSoundId",
		if root and root:IsA("BasePart") then root.Position else character:GetPivot().Position,
		root
	)
	if settings.CastingStyle == "GroundSigil" and root and root:IsA("BasePart") then
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.FilterDescendantsInstances = { character }
		rayParams.RespectCanCollide = true
		local floor = workspace:Raycast(root.Position, Vector3.new(0, -8, 0), rayParams)
		if floor then
			Presentation.marker(
				"MagicCastSigil",
				floor.Position + Vector3.new(0, 0.05, 0),
				Vector3.new(0.12, 5, 5),
				settings.AccentColor or definition.Visual.Color,
				duration
			)
		end
	end
	if settings.CastingStyle ~= "None" and settings.ParticleStyle ~= "None" then
		for _, name in { "RightHand", "LeftHand", "Right Arm", "Left Arm" } do
			local hand = character:FindFirstChild(name)
			if hand and hand:IsA("BasePart") then
				local attachment = Instance.new("Attachment")
				attachment.Name = "MagicCastGlow"
				attachment.Position = Vector3.new(0, -hand.Size.Y * 0.4, 0)
				attachment.Parent = hand
				emitParticles(
					particles(attachment, definition.Visual.Color, 0, settings.ParticleStyle, settings.Emission),
					10
				)
				Debris:AddItem(attachment, duration + 0.2)
			end
		end
	end
end
function Presentation.release(character, definition)
	local timing = Presentation.timing(definition)
	cue(character, Presentation.profile(definition), "Release", timing.Release + timing.Recovery, timing.Release)
	local settings = visualSettings(definition)
	local root = character:FindFirstChild("HumanoidRootPart")
	Presentation.playSound(
		definition,
		"CastSoundId",
		if root and root:IsA("BasePart") then root.Position else character:GetPivot().Position,
		root
	)
	for _, name in { "RightHand", "Right Arm" } do
		local hand = character:FindFirstChild(name)
		if hand and hand:IsA("BasePart") and settings.ParticleStyle ~= "None" then
			emitParticles(
				particles(
					hand,
					settings.AccentColor or definition.Visual.Color,
					0,
					settings.ParticleStyle,
					settings.Emission
				),
				12
			)
			break
		end
	end
end
function Presentation.cancel(character, definition)
	cue(character, Presentation.profile(definition), "Cancel", 0, 0)
end
function Presentation.sustain(character, definition)
	cue(character, Presentation.profile(definition), "Sustain", 0, 0)
end
function Presentation.handOrigin(character, fallback)
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if hand and hand:IsA("BasePart") and (hand.Position - fallback).Magnitude < 6 then
		return hand.Position - hand.CFrame.UpVector * hand.Size.Y * 0.35 + Vector3.yAxis * 0.9
	end
	return fallback
end

local function surfacePulse(hit, definition)
	local settings = visualSettings(definition)
	if settings.SurfaceBehavior ~= "Pulse" or not hit or not hit.Instance then
		return
	end
	local surface = hit.Instance
	if surface:IsA("BasePart") then
		if not surface.Anchored then
			return
		end
		local model = surface:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then
			return
		end
	elseif not surface:IsA("Terrain") then
		return
	end
	-- Spend from the existing shared cosmetic burst budget; this effect never
	-- creates a gameplay part or participates in hit detection.
	if BudgetSpec.takeBurst(particleBudget, 1, os.clock()) == 0 then
		return
	end
	local normal = if typeof(hit.Normal) == "Vector3" and hit.Normal.Magnitude > 0.001
		then hit.Normal.Unit
		else Vector3.yAxis
	local seed = if math.abs(normal:Dot(Vector3.yAxis)) < 0.95 then Vector3.yAxis else Vector3.zAxis
	local yAxis = (seed - normal * seed:Dot(normal)).Unit
	local zAxis = normal:Cross(yAxis).Unit
	local pulse = Instance.new("Part")
	pulse.Name = "MagicSurfacePulse"
	pulse.Shape = Enum.PartType.Cylinder
	pulse.Size = Vector3.new(0.06, 0.35, 0.35)
	pulse.CFrame = CFrame.fromMatrix(hit.Position + normal * 0.04, normal, yAxis, zAxis)
	pulse.Anchored = true
	pulse.CanCollide, pulse.CanTouch, pulse.CanQuery = false, false, false
	pulse.Material = Presentation.material(definition)
	pulse.Color = settings.AccentColor or settings.SecondaryColor or settings.Color
	pulse.Transparency = 1 - (settings.Opacity or 0.85)
	pulse.Parent = workspace
	TweenService:Create(pulse, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.06, 3.5, 3.5),
		Transparency = 1,
	}):Play()
	Debris:AddItem(pulse, 0.65)
end

function Presentation.impact(position, color, definition, hit)
	local settings = visualSettings(definition)
	surfacePulse(hit, definition)
	local style = settings.ImpactStyle or "Burst"
	if style == "None" then
		return
	end
	if style == "Ring" or style == "Pulse" then
		local part = Instance.new("Part")
		part.Name = if style == "Ring" then "MagicImpactRing" else "MagicImpactPulse"
		part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
		part.Material = Presentation.material(definition)
		part.Color = settings.AccentColor or settings.SecondaryColor or color
		part.Transparency = 1 - (settings.Opacity or 0.85)
		part.Position = position
		if style == "Ring" then
			part.Shape = Enum.PartType.Cylinder
			part.Size = Vector3.new(0.08, 0.7, 0.7)
			part.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
			TweenService:Create(part, TweenInfo.new(0.35), { Size = Vector3.new(0.08, 5, 5), Transparency = 1 }):Play()
		else
			part.Shape = Enum.PartType.Ball
			part.Size = Vector3.one * 0.2
			TweenService:Create(part, TweenInfo.new(0.3), { Size = Vector3.one * 4, Transparency = 1 }):Play()
		end
		part.Parent = workspace
		Debris:AddItem(part, 0.45)
		return
	end
	if style == "Cross" then
		for index, angle in { -45, 45 } do
			local bar = Instance.new("Part")
			bar.Name = "MagicImpactCross"
			bar.Anchored, bar.CanCollide, bar.CanTouch, bar.CanQuery = true, false, false, false
			bar.Material = Presentation.material(definition)
			bar.Color = settings.AccentColor or color
			bar.Transparency = 1 - (settings.Opacity or 0.85)
			bar.Size = Vector3.new(0.18, 0.18, 0.4)
			bar.CFrame = CFrame.new(position + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, math.rad(angle), 0)
			bar.Parent = workspace
			TweenService:Create(bar, TweenInfo.new(0.28), {
				Size = Vector3.new(0.18, 0.18, 3.5),
				Transparency = 1,
			}):Play()
			Debris:AddItem(bar, 0.35)
		end
		return
	end
	if settings.ParticleStyle == "None" then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Name = "MagicImpact"
	anchor.Anchored, anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = true, false, false, false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.1
	anchor.Position = position
	anchor.Parent = workspace
	local emitterColor = settings.AccentColor or settings.SecondaryColor or color
	local emitter = particles(anchor, emitterColor, 0, settings.ParticleStyle, settings.Emission)
	if emitter then
		emitter.Speed = NumberRange.new(3, 8)
	end
	emitParticles(emitter, 18)
	Debris:AddItem(anchor, 0.7)
end
function Presentation.construct(part: BasePart, particleCount: number?, definition: any?)
	local settings = visualSettings(definition)
	local finalTransparency = 1 - (settings.Opacity or 0.85)
	part.Transparency = 0.85
	TweenService:Create(part, TweenInfo.new(0.25), { Transparency = finalTransparency }):Play()
	if settings.ParticleStyle ~= "None" then
		emitParticles(
			particles(part, settings.SecondaryColor or part.Color, 0, settings.ParticleStyle, settings.Emission),
			particleCount or 20
		)
	end
end
function Presentation.finish(part: Instance)
	stopAttachedAudio(part)
	if part:IsA("Model") then
		for _, object in part:GetDescendants() do
			if object:IsA("BasePart") then
				object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
				TweenService:Create(object, TweenInfo.new(0.35), { Transparency = 1 }):Play()
			elseif object:IsA("ParticleEmitter") then
				object.Enabled = false
			end
		end
		Debris:AddItem(part, 0.6)
		return
	end
	if not part:IsA("BasePart") then
		part:Destroy()
		return
	end
	if part.Name == "MagicTemporaryConstruct" then
		local ghost = Instance.new("Part")
		ghost.Name = "MagicConstructDissolve"
		ghost.Size, ghost.CFrame, ghost.Color, ghost.Material = part.Size, part.CFrame, part.Color, part.Material
		ghost.Anchored, ghost.CanCollide, ghost.CanTouch, ghost.CanQuery = true, false, false, false
		ghost.Transparency = 0.4
		ghost.Parent = workspace
		TweenService:Create(ghost, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		emitParticles(particles(ghost, ghost.Color, 0), 12)
		Debris:AddItem(ghost, 0.6)
	end
	if part.Name ~= "MagicTemporaryConstruct" then
		for _, object in part:GetDescendants() do
			if object:IsA("ParticleEmitter") then
				object.Enabled = false
			end
		end
		part.Transparency = 1
		Debris:AddItem(part, 0.6)
	else
		part:Destroy()
	end
end
function Presentation.projectile(definition: any, position: Vector3): BasePart
	local settings = visualSettings(definition)
	local shape = settings.CoreShape or "Sphere"
	local part: BasePart = Instance.new(if shape == "Wedge" then "WedgePart" else "Part")
	part.Name = "MagicProjectile"
	if part:IsA("Part") then
		part.Shape = Enum.PartType[if shape == "Sphere" then "Ball" elseif shape == "Crystal" then "Block" else shape]
	end
	local appearanceScale = math.clamp(definition.Visual.ProjectileScale or 1, 1, 4)
	local visualRadius = definition.Projectile.Radius * appearanceScale
	part.Size = Vector3.new(visualRadius * 2, visualRadius * 2, visualRadius * 2)
	part.CFrame = CFrame.new(position)
		* (if shape == "Crystal" then CFrame.Angles(math.rad(45), math.rad(45), math.rad(45)) else CFrame.identity)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = Presentation.material(definition)
	part.Color = definition.Visual.Color
	part.Parent = workspace
	part.Transparency = 1 - (settings.Opacity or 0.85)
	local emitter = if settings.ParticleStyle == "None"
		then nil
		else particles(
			part,
			settings.SecondaryColor or part.Color,
			Config.ParticleRate,
			settings.ParticleStyle,
			settings.Emission
		)
	if emitter then
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35 * appearanceScale),
			NumberSequenceKeypoint.new(1, 0),
		})
	end
	local a, b = Instance.new("Attachment"), Instance.new("Attachment")
	a.Position, b.Position = Vector3.new(0, 0.25 * appearanceScale, 0), Vector3.new(0, -0.25 * appearanceScale, 0)
	a.Parent, b.Parent = part, part
	if (settings.TrailStyle or "Ribbon") == "Ribbon" then
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1 = a, b
		trail.Color = ColorSequence.new(part.Color, settings.AccentColor or settings.SecondaryColor or part.Color)
		trail.LightEmission = settings.Emission or 1
		trail.Lifetime = 0.25
		trail.FaceCamera = true
		trail.WidthScale = NumberSequence.new(appearanceScale, 0)
		trail.Transparency = NumberSequence.new(0, 1)
		trail.Parent = part
	elseif settings.TrailStyle == "Particles" and settings.ParticleStyle ~= "None" then
		local trailParticles = particles(
			a,
			settings.SecondaryColor or part.Color,
			Config.ParticleRate,
			settings.ParticleStyle,
			settings.Emission
		)
		if trailParticles then
			trailParticles.Lifetime = NumberRange.new(0.18, 0.32)
			trailParticles.Speed = NumberRange.new(0.1, 0.8)
		end
	end
	Presentation.attachLoop(definition, "TravelSoundId", part)
	return part
end

function Presentation.marker(
	name: string,
	position: Vector3,
	size: Vector3,
	color: Color3,
	duration: number?,
	shape: Enum.PartType?
): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape or Enum.PartType.Cylinder
	part.Size = size
	part.CFrame = CFrame.new(position)
		* if part.Shape == Enum.PartType.Cylinder then CFrame.Angles(0, 0, math.rad(90)) else CFrame.identity
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
	part.Transparency, part.Material, part.Color = 0.55, Enum.Material.Neon, color
	part.Parent = workspace
	part.Transparency = 0.85
	for i = 1, Config.AreaNodes do
		local angle = i / Config.AreaNodes * math.pi * 2
		local attachment = Instance.new("Attachment")
		attachment.Position = Vector3.new(0, math.cos(angle) * size.Y * 0.5, math.sin(angle) * size.Z * 0.5)
		attachment.Parent = part
		local emitter = particles(attachment, color, if duration then 0 else 2)
		emitParticles(emitter, 2)
	end
	if duration then
		TweenService:Create(part, TweenInfo.new(duration), { Transparency = 1 }):Play()
		Debris:AddItem(part, math.max(duration, 0.6))
	end
	return part
end

local function finishAreaMarker(marker: BasePart, definition: any?, size: Vector3)
	environmentalLayer(marker, definition)
	local distortion = visualSettings(definition).Distortion or 0
	if distortion > 0 then
		marker:SetAttribute("MagicVisualDistortion", distortion)
		marker:SetAttribute("MagicDistortionRadius", math.max(size.X, size.Y, size.Z) / 2)
		CollectionService:AddTag(marker, "MagicDistortionArea")
	end
	return marker
end

function Presentation.areaMarker(
	name: string,
	frame: CFrame,
	shape: string,
	size: Vector3,
	color: Color3,
	flatHeight: number?,
	definition: any?
): BasePart
	if shape == "Sphere" then
		return finishAreaMarker(
			Presentation.marker(name, frame.Position, Vector3.new(flatHeight or 0.15, size.X, size.Z), color),
			definition,
			size
		)
	end
	if shape == "Capsule" then
		local radius = size.X / 2
		local stemHeight = math.max(size.Y - radius * 2, 0.05)
		local marker = Instance.new("Part")
		marker.Name = name
		marker.Shape = Enum.PartType.Cylinder
		marker.Size = Vector3.new(stemHeight, size.X, size.Z)
		marker.CFrame = frame * CFrame.Angles(0, 0, math.rad(90))
		marker.Anchored = true
		marker.CanCollide, marker.CanTouch, marker.CanQuery = false, false, false
		marker.Transparency, marker.Material, marker.Color = 0.9, Enum.Material.Neon, color
		marker.Parent = workspace
		for _, sign in { -1, 1 } do
			local cap = Instance.new("Part")
			cap.Name = if sign < 0 then "CapsuleLowerCap" else "CapsuleUpperCap"
			cap.Shape = Enum.PartType.Ball
			cap.Size = Vector3.one * radius * 2
			cap.CFrame = frame * CFrame.new(0, sign * stemHeight / 2, 0)
			cap.Anchored = false
			cap.Massless = true
			cap.CanCollide, cap.CanTouch, cap.CanQuery = false, false, false
			cap.Transparency, cap.Material, cap.Color = 0.88, Enum.Material.Neon, color
			cap.Parent = marker
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = marker, cap
			weld.Parent = marker
		end
		return finishAreaMarker(marker, definition, size)
	end
	if shape == "Cone" then
		local anchor = Instance.new("Part")
		anchor.Name = name
		anchor.Size = Vector3.one * 0.1
		anchor.CFrame = frame
		anchor.Anchored, anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = true, false, false, false
		anchor.Transparency = 1
		anchor.Parent = workspace
		anchor:SetAttribute("MagicAreaWidth", size.X)
		anchor:SetAttribute("MagicAreaHeight", size.Y)
		anchor:SetAttribute("MagicAreaDepth", size.Z)
		local range = size.Z
		local angle = 2 * math.deg(math.atan(size.X / (2 * range)))
		local halfWidth = range * math.tan(math.rad(angle / 2))
		local halfHeight = size.Y / 2
		local function edge(first: Vector3, second: Vector3)
			local a, b = Instance.new("Attachment"), Instance.new("Attachment")
			a.Position, b.Position = first, second
			a.Parent, b.Parent = anchor, anchor
			local beam = Instance.new("Beam")
			beam.Name = "MagicConeEdge"
			beam.Attachment0, beam.Attachment1 = a, b
			beam.Color = ColorSequence.new(color)
			beam.Transparency = NumberSequence.new(0.35)
			beam.Width0, beam.Width1 = 0.08, 0.08
			beam.FaceCamera = false
			beam.Parent = anchor
		end
		for _, y in { -halfHeight, halfHeight } do
			local apex = Vector3.new(0, y, 0)
			local left = Vector3.new(-halfWidth, y, -range)
			local right = Vector3.new(halfWidth, y, -range)
			edge(apex, left)
			edge(apex, right)
			edge(left, right)
		end
		edge(Vector3.new(0, -halfHeight, 0), Vector3.new(0, halfHeight, 0))
		edge(Vector3.new(-halfWidth, -halfHeight, -range), Vector3.new(-halfWidth, halfHeight, -range))
		edge(Vector3.new(halfWidth, -halfHeight, -range), Vector3.new(halfWidth, halfHeight, -range))
		return finishAreaMarker(anchor, definition, size)
	end
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = if shape == "Cylinder" then Enum.PartType.Cylinder else Enum.PartType.Block
	part.Size = if shape == "Cylinder" then Vector3.new(size.Y, size.X, size.Z) else size
	local lineOffset = if shape == "Line" then CFrame.new(0, 0, -size.Z / 2) else CFrame.identity
	part.CFrame = frame
		* lineOffset
		* (if shape == "Cylinder" then CFrame.Angles(0, 0, math.rad(90)) else CFrame.identity)
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
	part.Transparency, part.Material, part.Color = 0.88, Enum.Material.Neon, color
	part.Parent = workspace
	particles(part, color, 2)
	return finishAreaMarker(part, definition, size)
end

function Presentation.resizeAreaMarker(
	marker: BasePart,
	shape: string,
	frame: CFrame,
	size: Vector3,
	flatHeight: number?
)
	if shape == "Capsule" then
		local radius = size.X / 2
		local stemHeight = math.max(size.Y - radius * 2, 0.05)
		marker.Size = Vector3.new(stemHeight, size.X, size.Z)
		marker.CFrame = frame * CFrame.Angles(0, 0, math.rad(90))
		for _, child in marker:GetChildren() do
			if child:IsA("BasePart") and string.find(child.Name, "Capsule", 1, true) == 1 then
				local sign = if child.Name == "CapsuleLowerCap" then -1 else 1
				child.Size = Vector3.one * radius * 2
				child.CFrame = frame * CFrame.new(0, sign * stemHeight / 2, 0)
			end
		end
		return
	end
	local lineOffset = if shape == "Line" then CFrame.new(0, 0, -size.Z / 2) else CFrame.identity
	marker.CFrame = frame
		* lineOffset
		* (if shape == "Cylinder" then CFrame.Angles(0, 0, math.rad(90)) else CFrame.identity)
	if shape == "Sphere" then
		marker.Size = Vector3.new(flatHeight or 0.15, size.X, size.Z)
	elseif shape == "Cone" then
		local previous = Vector3.new(
			marker:GetAttribute("MagicAreaWidth") or size.X,
			marker:GetAttribute("MagicAreaHeight") or size.Y,
			marker:GetAttribute("MagicAreaDepth") or size.Z
		)
		local ratios = Vector3.new(
			if previous.X > 0 then size.X / previous.X else 1,
			if previous.Y > 0 then size.Y / previous.Y else 1,
			if previous.Z > 0 then size.Z / previous.Z else 1
		)
		for _, child in marker:GetChildren() do
			if child:IsA("Attachment") then
				child.Position =
					Vector3.new(child.Position.X * ratios.X, child.Position.Y * ratios.Y, child.Position.Z * ratios.Z)
			end
		end
		marker:SetAttribute("MagicAreaWidth", size.X)
		marker:SetAttribute("MagicAreaHeight", size.Y)
		marker:SetAttribute("MagicAreaDepth", size.Z)
	else
		marker.Size = if shape == "Cylinder" then Vector3.new(size.Y, size.X, size.Z) else size
	end
end

function Presentation.beam(
	origin: Vector3,
	endpoint: Vector3,
	width: number,
	color: Color3,
	duration: number,
	definition: any?
)
	if (endpoint - origin).Magnitude < 0.01 then
		return
	end
	local settings = visualSettings(definition)
	local secondary = settings.SecondaryColor or color
	local lifetime = math.max(0.45, duration)
	local model = Instance.new("Model")
	model.Name = "MagicBeamFlash"
	model.Parent = workspace
	local function endpointPart(position)
		local p = Instance.new("Part")
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
		p.Shape, p.Material, p.Color = Enum.PartType.Ball, Presentation.material(definition), color
		p.Size = Vector3.one * math.max(1.8, width)
		p.Position = position
		p.Parent = model
		local attachment = Instance.new("Attachment")
		attachment.Parent = p
		game:GetService("TweenService")
			:Create(p, TweenInfo.new(lifetime), { Transparency = 1, Size = p.Size * 1.7 })
			:Play()
		return attachment
	end
	local beam = Instance.new("Beam")
	beam.Attachment0, beam.Attachment1 = endpointPart(origin), endpointPart(endpoint)
	beam.FaceCamera = true
	beam.Width0, beam.Width1 = math.max(1.4, width), math.max(1.4, width)
	beam.Color = ColorSequence.new(color, secondary)
	beam.LightEmission = settings.Emission or 1
	beam.Texture = Config.ParticleTexture
	beam.TextureSpeed = 3
	beam.TextureLength = 2
	beam.Parent = model
	local core = beam:Clone()
	core.Name = "BeamCore"
	core.Texture = ""
	core.Width0, core.Width1 = math.max(0.3, width * 0.3), math.max(0.3, width * 0.3)
	core.Color = ColorSequence.new(settings.AccentColor or Color3.new(1, 1, 1))
	core.Parent = model
	TweenService:Create(core, TweenInfo.new(lifetime), { Width0 = 0, Width1 = 0 }):Play()
	game:GetService("TweenService"):Create(beam, TweenInfo.new(lifetime), { Width0 = 0, Width1 = 0 }):Play()
	Debris:AddItem(model, lifetime)
end
return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="145">
          <Properties>
            <string name="Name">MagicProjectileBehaviorExecutors</string>
            <string name="Source"><![CDATA[--!strict

-- Composable, spell-neutral behaviors for the Projectile Form. Definitions are
-- validated data; this registry owns steering and impact continuation rules.
local Behaviors = {}

local executors: { [string]: any } = {}

executors.Proximity = {
	Spawn = function(projectile, behavior, context)
		projectile.NextProximityCheckAt = context.Now + behavior.Interval
		projectile.ProximityTargets = {}
		projectile.ProximityTargetCount = 0
	end,
	Update = function(projectile, behavior, _delta, context)
		if
			context.Now < (projectile.NextProximityCheckAt or math.huge)
			or (projectile.ProximityTargetCount or 0) >= behavior.MaxTargets
		then
			return
		end
		projectile.NextProximityCheckAt = context.Now + behavior.Interval
		local remaining = behavior.MaxTargets - (projectile.ProximityTargetCount or 0)
		local targets = context.FindProximityTargets(projectile, behavior.Radius, remaining)
		for _, humanoid in ipairs(targets) do
			if not projectile.ProximityTargets[humanoid] then
				projectile.ProximityTargets[humanoid] = true
				projectile.ProximityTargetCount += 1
				projectile.CurrentPhase = "Proximity"
				context.OnProximity(projectile, humanoid)
				projectile.CurrentPhase = "Traveling"
			end
		end
	end,
}

executors.Absorb = {
	Update = function(projectile, behavior, _delta, context)
		local now = context.Now
		if now < (projectile.NextAbsorbCheckAt or 0) or (projectile.AbsorbCount or 0) >= behavior.MaxAbsorbed then
			return
		end
		projectile.NextAbsorbCheckAt = now + behavior.CheckInterval
		local incoming = context.FindIncomingProjectile(projectile, behavior.Radius)
		if not incoming then
			return
		end
		incoming.AbsorbedBy = projectile
		projectile.AbsorbCount = (projectile.AbsorbCount or 0) + 1
		projectile.AbsorbedEnergy = (projectile.AbsorbedEnergy or 0) + 1
		projectile.PotencyMultiplier =
			math.min(behavior.MaxPotencyMultiplier, (projectile.PotencyMultiplier or 1) + behavior.PowerPerAbsorption)
		context.ShowAbsorption(projectile, incoming)
	end,
}

executors.Reflect = {
	Update = function(projectile, behavior, _delta, context)
		local now = context.Now
		if now < (projectile.NextReflectCheckAt or 0) or (projectile.ReflectCount or 0) >= behavior.MaxReflections then
			return
		end
		projectile.NextReflectCheckAt = now + behavior.CheckInterval
		local incoming = context.FindIncomingProjectile(projectile, behavior.Radius, behavior.MaxHopsPerProjectile)
		if not incoming or not context.ReflectProjectile(projectile, incoming) then
			return
		end
		projectile.ReflectCount = (projectile.ReflectCount or 0) + 1
		context.ShowReflection(projectile, incoming)
	end,
}

executors.Pulse = {
	Spawn = function(projectile, behavior, context)
		projectile.NextPulseAt = context.Now + behavior.Interval
	end,
	Update = function(projectile, behavior, _delta, context)
		if context.Now < (projectile.NextPulseAt or math.huge) then
			return
		end
		projectile.NextPulseAt = context.Now + behavior.Interval
		context.Pulse(projectile, behavior)
	end,
}

executors.Homing = {
	Update = function(projectile, behavior, delta, context)
		local target = projectile.HomingTarget
		local humanoid = target and target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
		local hitTargets = projectile.HitHumanoids or {}
		if not humanoid or humanoid.Health <= 0 or hitTargets[humanoid] then
			target = nil
			projectile.HomingTarget = nil
		end
		local now = os.clock()
		if not target and not projectile.FixedTarget and now >= (projectile.NextHomingScan or 0) then
			projectile.NextHomingScan = now + 0.15
			projectile.HomingTarget = context.FindTarget(projectile, behavior.SearchRadius)
			target = projectile.HomingTarget
		end
		local root = target and target.Parent and target.Parent:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			return
		end
		local offset = root.Position - projectile.Position
		if offset.Magnitude < 0.001 then
			return
		end
		local current = projectile.Velocity.Unit
		local desired = offset.Unit
		local dot = math.clamp(current:Dot(desired), -1, 1)
		local angle = math.acos(dot)
		if angle < 0.001 then
			projectile.Direction = desired
			return
		end
		local axis = current:Cross(desired)
		if axis.Magnitude < 0.001 then
			axis = current:Cross(Vector3.yAxis)
			if axis.Magnitude < 0.001 then
				axis = current:Cross(Vector3.xAxis)
			end
		end
		local turn = math.min(angle, math.rad(behavior.TurnRate) * math.min(delta, 0.1))
		local direction = CFrame.fromAxisAngle(axis.Unit, turn):VectorToWorldSpace(current).Unit
		local speed = projectile.Velocity.Magnitude
		projectile.Direction = direction
		projectile.Velocity = direction * speed
	end,
}

executors.Pierce = {
	Impact = function(projectile, behavior, hit, context)
		local humanoid, model = context.TargetFromHit(hit)
		if not humanoid or not model then
			return false
		end
		local pierced = projectile.PierceCount or 0
		if pierced >= behavior.MaxPierces then
			return false
		end
		projectile.PierceCount = pierced + 1
		projectile.IgnoredTargetModels = projectile.IgnoredTargetModels or {}
		table.insert(projectile.IgnoredTargetModels, model)
		return true
	end,
}

executors.Chain = {
	Impact = function(projectile, behavior, hit, context)
		local humanoid = context.TargetFromHit(hit)
		if not humanoid then
			return false
		end
		projectile.HitHumanoids = projectile.HitHumanoids or {}
		projectile.HitHumanoids[humanoid] = true
		local from = hit.Position
		for jump = 1, behavior.MaxJumps do
			local nextTarget = context.FindTargetAt(projectile, from, behavior.Radius)
			if not nextTarget then
				break
			end
			local model = nextTarget.Parent
			local root = model and model:FindFirstChild("HumanoidRootPart")
			if not model or not root or not root:IsA("BasePart") then
				break
			end
			projectile.HitHumanoids[nextTarget] = true
			projectile.IgnoredTargetModels = projectile.IgnoredTargetModels or {}
			table.insert(projectile.IgnoredTargetModels, model)
			local endpoint = root.Position + Vector3.new(0, 1, 0)
			context.Link(from, endpoint)
			context.ApplyImpact(projectile, nextTarget, endpoint, behavior.DamageFalloff ^ jump)
			from = endpoint
		end
		return false
	end,
}

executors.Propagate = {
	Impact = function(projectile, behavior, hit, context)
		local primaryTarget = context.TargetFromHit(hit)
		projectile.HitHumanoids = projectile.HitHumanoids or {}
		if primaryTarget then
			projectile.HitHumanoids[primaryTarget] = true
		end
		local targets = context.FindTargetsAt(projectile, hit.Position, behavior.Radius, behavior.MaxTargets)
		for index, humanoid in ipairs(targets) do
			projectile.HitHumanoids[humanoid] = true
			local model = humanoid.Parent
			if model then
				projectile.IgnoredTargetModels = projectile.IgnoredTargetModels or {}
				table.insert(projectile.IgnoredTargetModels, model)
			end
			local root = model and model:FindFirstChild("HumanoidRootPart")
			local position = if root and root:IsA("BasePart") then root.Position else hit.Position
			context.ApplyImpact(projectile, humanoid, position, behavior.PayloadFalloff ^ index)
		end
		return false
	end,
}

executors.Bounce = {
	Impact = function(projectile, behavior, hit, context)
		local humanoid = context.TargetFromHit(hit)
		local normal = hit.Normal
		if humanoid or typeof(normal) ~= "Vector3" or normal.Magnitude < 0.001 then
			return false
		end

		local bounceCount = projectile.BounceCount or 0
		if bounceCount >= behavior.MaxBounces then
			return false
		end
		local velocity = projectile.Velocity
		if velocity.Magnitude < 0.001 then
			return false
		end

		local normalUnit = normal.Unit
		local reflected = velocity - 2 * velocity:Dot(normalUnit) * normalUnit
		if reflected.Magnitude < 0.001 then
			return false
		end
		projectile.BounceCount = bounceCount + 1
		projectile.Velocity = reflected.Unit * velocity.Magnitude * behavior.Restitution
		projectile.Direction = projectile.Velocity.Unit
		return true
	end,
}

executors.Split = {
	Impact = function(projectile, behavior, hit, context)
		if (projectile.SplitDepth or 0) > 0 then
			return false
		end
		local normal = hit.Normal
		if typeof(normal) ~= "Vector3" or normal.Magnitude < 0.001 then
			return false
		end

		local forward = projectile.Direction.Unit
		local rotationAxis = Vector3.yAxis
		if math.abs(forward:Dot(rotationAxis)) > 0.95 then
			rotationAxis = Vector3.xAxis
		end
		local _, hitModel = context.TargetFromHit(hit)
		local ignoredTargets = table.clone(projectile.IgnoredTargetModels or {})
		if hitModel and not table.find(ignoredTargets, hitModel) then
			table.insert(ignoredTargets, hitModel)
		end
		local directions = {}
		local halfAngle = math.rad(behavior.SpreadAngle) / 2
		for index = 1, behavior.ChildCount do
			local alpha = (index - 1) / (behavior.ChildCount - 1) * 2 - 1
			local angle = alpha * halfAngle
			local direction = CFrame.fromAxisAngle(rotationAxis, angle):VectorToWorldSpace(forward).Unit
			table.insert(directions, direction)
		end

		if context.SpawnSplit(projectile, hit, behavior, directions, ignoredTargets) then
			projectile.TerminateAfterImpact = true
		end
		return false
	end,
}

executors.Spread = {
	Spawn = function(projectile, behavior, context)
		for pair = 1, behavior.SidePairs do
			local angle = behavior.SpreadAngle * pair
			if not context.SpawnSpread(projectile, behavior, pair, -angle) then
				return
			end
			if not context.SpawnSpread(projectile, behavior, pair, angle) then
				return
			end
		end
	end,
}

executors.Linger = {
	Impact = function(projectile, behavior, hit, context)
		if projectile.Kind ~= "Projectile" then
			return false
		end
		projectile.Kind = "ProjectileLinger"
		projectile.CurrentPhase = "Lingering"
		projectile.Position = projectile.Position
		projectile.Velocity = Vector3.zero
		projectile.LingerRadius = behavior.Radius
		projectile.LingerInterval = behavior.Interval
		projectile.RemainingLifetime = behavior.Duration
		projectile.NextInterval = context.Now + behavior.Interval
		if projectile.MotionPhaseMode == "Attached" and hit.Instance:IsA("BasePart") then
			projectile.AttachedPart = hit.Instance
			projectile.AttachedOffset = hit.Instance.CFrame:PointToObjectSpace(projectile.Position)
		end
		return false
	end,
}

executors.Return = {
	Update = function(projectile, behavior, delta, context)
		if not projectile.Returning and projectile.Distance >= behavior.ReturnAtDistance then
			projectile.Returning = true
			projectile.CurrentPhase = "Returning"
		end
		if not projectile.Returning then
			return
		end

		local target = context.ReturnTargetPosition(projectile)
		if not target then
			projectile.ReturnEnded = true
			return
		end
		local offset = target - projectile.Position
		if offset.Magnitude <= behavior.CatchRadius then
			projectile.ReturnEnded = true
			return
		end
		if projectile.Velocity.Magnitude < 0.001 then
			projectile.Velocity = offset.Unit * projectile.BaseSpeed
			projectile.Direction = offset.Unit
			return
		end

		local current = projectile.Velocity.Unit
		local desired = offset.Unit
		local dot = math.clamp(current:Dot(desired), -1, 1)
		local angle = math.acos(dot)
		if angle < 0.001 then
			projectile.Direction = desired
			return
		end
		local axis = current:Cross(desired)
		if axis.Magnitude < 0.001 then
			axis = current:Cross(Vector3.yAxis)
			if axis.Magnitude < 0.001 then
				axis = current:Cross(Vector3.xAxis)
			end
		end
		local turn = math.min(angle, math.rad(behavior.TurnRate) * math.min(delta, 0.1))
		local direction = CFrame.fromAxisAngle(axis.Unit, turn):VectorToWorldSpace(current).Unit
		projectile.Direction = direction
		projectile.Velocity = direction * math.max(projectile.Velocity.Magnitude, projectile.BaseSpeed)
	end,
}

function Behaviors.update(projectile, delta, context)
	for _, behavior in ipairs(projectile.Definition.Projectile.Behaviors or {}) do
		local executor = executors[behavior.Kind]
		if executor and executor.Update then
			executor.Update(projectile, behavior, delta, context)
		end
	end
end

function Behaviors.spawn(projectile, context)
	for _, behavior in ipairs(projectile.Definition.Projectile.Behaviors or {}) do
		local executor = executors[behavior.Kind]
		if executor and executor.Spawn then
			executor.Spawn(projectile, behavior, context)
		end
	end
end

function Behaviors.impact(projectile, hit, context): boolean
	local continue = false
	for _, behavior in ipairs(projectile.Definition.Projectile.Behaviors or {}) do
		if behavior.Kind == "Linger" then
			continue
		end
		local executor = executors[behavior.Kind]
		if executor and executor.Impact and executor.Impact(projectile, behavior, hit, context) then
			continue = true
		end
	end
	if projectile.TerminateAfterImpact then
		return false
	end
	for _, behavior in ipairs(projectile.Definition.Projectile.Behaviors or {}) do
		if behavior.Kind == "Linger" then
			executors.Linger.Impact(projectile, behavior, hit, context)
			return false
		end
	end
	return continue and not projectile.TerminateAfterImpact
end

return Behaviors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="146">
          <Properties>
            <string name="Name">MagicService</string>
            <string name="Source"><![CDATA[--!strict

-- Server-owned interpreter for normalized registered and development spell data.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sandbox = require(Shared.Configuration.Sandbox)
local LocusConfiguration = require(Shared.Configuration.MagicLocus)
local LocusProfile = LocusConfiguration.Default
local LocusPersistence = LocusConfiguration.Persistence
local LocusModel = require(Shared.Modules.MagicLocusModel)
local LocusProfileCodec = require(Shared.Modules.MagicLocusProfile)
local SpecialResourceSpec = require(Shared.Modules.MagicSpecialResourceSpec)
local SpecialResourceDefinitions = LocusConfiguration.SpecialResources
local specialResourcesValid, specialResourcesReason =
	SpecialResourceSpec.validateDefinitions(SpecialResourceDefinitions)
assert(specialResourcesValid, specialResourcesReason)
local LocusProgression = require(Shared.Modules.MagicLocusProgressionSpec)
local Definitions = require(Shared.Configuration.Spells)
local Generated = require(Shared.Configuration.GeneratedSpellStress)
local Validator = require(Shared.Modules.SpellDefinitionValidator)
local HitDetection = require(script.Parent.HitDetectionService)
local Forms = require(script.Parent.MagicFormExecutors)
local Payloads = require(script.Parent.MagicPayloadExecutors)
local Movement = require(script.Parent.MovementService)
local Spec = require(Shared.Modules.SpellSpec)
local Geometry = require(Shared.Modules.MagicGeometry)
local AreaGrowth = require(Shared.Modules.MagicAreaGrowth)
local Limits = require(Shared.Configuration.MagicLab)
local Triggers = require(script.Parent.MagicTriggerExecutors)
local ProjectileBehaviors = require(script.Parent.MagicProjectileBehaviorExecutors)
local Conditions = require(script.Parent.MagicConditions)
local ConstructGeometry = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicConstructGeometrySpec)
local AreaMembership = require(Shared.Modules.MagicAreaMembership)
local ProximitySpec = require(Shared.Modules.MagicProximitySpec)
local Presentation = require(script.Parent.MagicPresentation)
local PersistentConstructStore = require(script.Parent.MagicPersistentConstructStore)
local Summons = require(script.Parent.SummonService)
local Damage = require(script.Parent.DamageService)
local CompanionSpellPolicy = require(Shared.Modules.MagicCompanionSpellPolicy)
local CastingSpec = require(Shared.Modules.MagicCastingSpec)
local CommandSpec = require(script.Parent.MagicCommandSpec)
local Manipulation = require(script.Parent.MagicManipulationExecutors)
local SummonConfiguration = require(Shared.Configuration.MagicSummons)
local LifetimeSpec = require(Shared.Modules.MagicLifetimeSpec)
local CastInterruption = require(Shared.Modules.MagicCastInterruption)
local TargetingSpec = require(Shared.Modules.MagicTargetingSpec)
local ObjectTargetSpec = require(Shared.Modules.MagicObjectTargetSpec)
local TargetDeathSpec = require(Shared.Modules.MagicTargetDeathSpec)
local ProjectileMotion = require(Shared.Modules.MagicProjectileMotion)
local TemporalRate = require(Shared.Modules.MagicTemporalRate)
local LocusRequirementSpec = require(Shared.Modules.MagicLocusRequirementSpec)
local StatusEffects = require(script.Parent.MagicStatusEffectService)
local Discovery = require(script.Parent.MagicDiscoveryService)
local Equipment = require(script.Parent.EquipmentService)
local Magic = {}

type State = { Character: Model, Humanoid: Humanoid, Root: BasePart }
type CastContext = { Origin: Vector3, CommandCast: boolean?, CommandId: number? }?
type Charge = {
	SpellId: string,
	BeganAt: number,
	Definition: any,
	Character: Model,
	StartPosition: Vector3,
	State: State,
	Intent: any,
	AimDirection: Vector3,
	Remote: RemoteEvent,
	Context: CastContext,
}
type Active = {
	SpellId: string,
	Caster: Model,
	Age: number,
	CurrentPhase: string,
	TargetsHit: { [Humanoid]: boolean },
	RemainingLifetime: number,
	Definition: any,
	Position: Vector3,
	Direction: Vector3,
	Visual: BasePart,
	Player: Player,
	Remote: RemoteEvent,
}

local playerData: { [Player]: any } = {}
local resourceWritable: { [Player]: boolean } = {}
local resourceDirty: { [Player]: boolean } = {}
local resourceSaveScheduled: { [Player]: boolean } = {}
local resourceProfileLoaded: { [Player]: boolean } = {}
local progressionConnections: { [Player]: RBXScriptConnection } = {}
local queueResourceSave: (Player) -> ()
local companionSpells: { [Player]: { [number]: any } } = {}
local active: { any } = {}
local nextCommandCastId = 0

local function isSpellCooling(stats, spellId: string, now: number): boolean
	local cooldown = stats.Ready[spellId]
	if type(cooldown) == "table" then
		return cooldown.Remaining > 0
	end
	-- Accept old in-memory timestamp entries while the service is hot-reloaded.
	return type(cooldown) == "number" and now < cooldown
end
local enhancements: {
	[Player]: {
		[string]: {
			State: State,
			ExpiresAt: number,
			WalkSpeedBonus: number,
			JumpPowerBonus: number,
			SpeedMultiplier: number,
		},
	},
} =
	{}

local locusStore
local locusStoreAvailable = false
if LocusPersistence.Enabled then
	locusStoreAvailable, locusStore = pcall(function()
		return DataStoreService:GetDataStore(LocusPersistence.DataStoreName)
	end)
	if not locusStoreAvailable then
		locusStore = nil
	end
end

local function feedback(remote: RemoteEvent, player: Player, result: string, spell: any?, data: { [string]: any }?)
	remote:FireClient(player, {
		Kind = "Magic",
		Result = result,
		SpellId = if spell then spell.SpellId else nil,
		Name = if spell then spell.Name else nil,
		Mana = data and data.Mana or nil,
		Capacity = data and data.Capacity or nil,
		Strain = data and data.Strain or nil,
		StrainTolerance = data and data.StrainTolerance or nil,
		Efficiency = data and data.Efficiency or nil,
		Potency = data and data.Potency or nil,
		Complexity = data and data.Complexity or nil,
		ComplexityCapacity = data and data.ComplexityCapacity or nil,
		ManaDemand = data and data.ManaDemand or nil,
		Reason = data and data.Reason or nil,
		Damage = data and data.Damage or nil,
		Effect = data and data.Effect or nil,
		Amount = data and data.Amount or nil,
		Target = data and data.Target or nil,
		SpecialResources = data and data.SpecialResources or nil,
	})
end

local function validVector(value: any): boolean
	return typeof(value) == "Vector3"
		and value.X == value.X
		and value.Y == value.Y
		and value.Z == value.Z
		and math.abs(value.X) < 1e7
		and math.abs(value.Y) < 1e7
		and math.abs(value.Z) < 1e7
end

local function hasHumanoidAncestor(instance: Instance): boolean
	local ancestor = instance.Parent
	while ancestor and ancestor ~= workspace do
		if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
			return true
		end
		ancestor = ancestor.Parent
	end
	return false
end

local function isSolidWorldSurfaceTarget(target: BasePart): boolean
	return ObjectTargetSpec.isSolidWorldSurfaceTarget({
		InWorkspace = target:IsDescendantOf(workspace),
		CanCollide = target.CanCollide,
		HasHumanoidAncestor = hasHumanoidAncestor(target),
	})
end

local function isValidObjectInteractionTarget(definition, target: BasePart): boolean
	local hasPhysics = false
	local hasManipulation = false
	for _, steps in definition.Triggers or {} do
		for _, step in steps do
			for _, payload in step.Payloads or {} do
				hasPhysics = hasPhysics or payload.Kind == "Force" or payload.Kind == "Control"
				hasManipulation = hasManipulation or payload.Kind == "Manipulation"
			end
		end
	end
	if
		not ObjectTargetSpec.isValidInteractionTarget({
			InWorkspace = target:IsDescendantOf(workspace),
			CanCollide = target.CanCollide,
			HasHumanoidAncestor = hasHumanoidAncestor(target),
			Tagged = CollectionService:HasTag(target, "MagicManipulable"),
			Anchored = target.Anchored,
			AssemblyMass = target.AssemblyMass,
			MaterialMatches = definition.Material ~= nil
				and target:GetAttribute("MagicMaterial") == definition.Material.Material,
			RaiseAuthorized = target:GetAttribute("MagicRaise") == true,
		}, hasPhysics, hasManipulation)
	then
		return false
	end
	return true
end

local function isLiveHomingTarget(root: BasePart?): boolean
	if not root or not root:IsDescendantOf(workspace) then
		return false
	end
	local model = root:FindFirstAncestorOfClass("Model")
	local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
	return model ~= nil and humanoid ~= nil and humanoid.Health > 0
end

local function getDefinition(id: any): any?
	if typeof(id) ~= "string" then
		return nil
	end
	local definition = Definitions[id] or Generated.Definitions[id]
	if
		not definition
		or not (if definition.Version == 3 then Spec.validate(definition) else Validator.validate(definition))
	then
		return nil
	end
	return Spec.normalize(definition)
end

local function findMaterial(definition: any, point: Vector3): Instance?
	local requirement = definition.Material
	if not requirement then
		return nil
	end
	local closest: Instance? = nil
	local closestDistance = math.huge
	for _, source in CollectionService:GetTagged("MagicMaterialSource") do
		local position = if source:IsA("BasePart")
			then source.Position
			elseif source:IsA("Model") then source:GetPivot().Position
			else nil
		local available = source:GetAttribute("AvailableAmount")
		if
			position
			and source:IsDescendantOf(workspace)
			and source:GetAttribute("MagicMaterial") == requirement.Material
			and type(available) == "number"
			and available == available
			and available > -math.huge
			and available < math.huge
			and available >= requirement.Amount
			and (position - point).Magnitude <= requirement.SearchRadius
			and (position - point).Magnitude < closestDistance
		then
			closest, closestDistance = source, (position - point).Magnitude
		end
	end
	return closest
end

local function findManipulable(definition: any, point: Vector3): BasePart?
	local closest: BasePart? = nil
	local closestDistance = math.huge
	for _, source in CollectionService:GetTagged("MagicManipulable") do
		if
			source:IsA("BasePart")
			and source:GetAttribute("MagicMaterial") == definition.Material.Material
			and source:GetAttribute("MagicRaise") == true
			and (source.Position - point).Magnitude <= definition.Material.SearchRadius
			and (source.Position - point).Magnitude < closestDistance
		then
			closest, closestDistance = source, (source.Position - point).Magnitude
		end
	end
	return closest
end

local function acquireEntityTarget(state: State, direction: Vector3, definition: any): Model?
	local origin = state.Root.Position + Vector3.new(0, 1.5, 0)
	local range = math.min(TargetingSpec.entityRange(definition), Sandbox.Magic.LockOnAcquireRange)
	local candidates = HitDetection.findSphere(state.Character, CFrame.new(origin), range, {
		OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
		MaxDistance = range,
		RequireLineOfSight = definition.TargetRules.RequiresLineOfSight,
	})
	local selected: Model? = nil
	local bestDot = Sandbox.Magic.MinimumEntityAimDot
	local bestDistance = math.huge
	for _, humanoid in ipairs(candidates) do
		local model = humanoid.Parent
		local root = model and model:FindFirstChild("HumanoidRootPart")
		if
			model
			and model:IsA("Model")
			and root
			and root:IsA("BasePart")
			and Conditions.relationshipMatches(state.Character, model, definition.TargetRules.Relationship)
			and Conditions.hasConsent(definition, model)
		then
			local delta = root.Position - origin
			if delta.Magnitude > 0.001 then
				local dot = direction:Dot(delta.Unit)
				if dot > bestDot or (dot == bestDot and delta.Magnitude < bestDistance) then
					selected = model
					bestDot = dot
					bestDistance = delta.Magnitude
				end
			end
		end
	end
	return selected
end

local function costs(definition: any, charge: number, resources: any): (number, number, number)
	return LocusModel.cost(definition.Cost, charge, Sandbox.Magic.ChargeCostScale, resources)
end

local function setCastingMovement(player: Player, state: State?, definition: any?, direction: Vector3?)
	if not state or state.Character ~= player.Character then
		return
	end
	local multiplier = if definition then CastingSpec.movementMultiplier(definition.Casting) else 1
	Movement.setMagicCasting(state, multiplier)
	Movement.setMagicRotation(state, definition ~= nil and CastingSpec.rotationLocked(definition.Casting), direction)
end

local function resourceSnapshot(stats: any?): any
	if not stats then
		return nil
	end
	return {
		Mana = stats.Mana,
		Capacity = stats.Capacity,
		Strain = stats.Strain,
		StrainTolerance = stats.StrainTolerance,
		Efficiency = stats.Efficiency,
		Potency = stats.Potency,
		ComplexityCapacity = stats.ComplexityCapacity,
		SpecialResources = stats.SpecialResources,
	}
end

local function syncSpecialResourceAttributes(player: Player)
	local stats = playerData[player]
	if not stats or not player.Parent then
		return
	end
	for id, definition in pairs(SpecialResourceDefinitions) do
		player:SetAttribute(definition.Attribute, stats.SpecialResources[id])
		player:SetAttribute(definition.Attribute .. "Capacity", definition.Capacity)
	end
end

local function locusProfileFor(player: Player)
	local progress = Discovery.progress(player)
	return LocusProgression.profile(LocusProfile, LocusConfiguration.Progression, progress.TotalCasts)
end

local function syncLocusProgression(player: Player)
	local stats = playerData[player]
	if not stats or player:GetAttribute("MagicDiscoveryLoaded") ~= true then
		return
	end
	local progression = locusProfileFor(player)
	local metrics = progression.Metrics
	stats.Capacity = metrics.Capacity
	stats.Efficiency = metrics.Efficiency
	stats.Potency = metrics.Potency
	stats.StrainTolerance = metrics.StrainTolerance
	stats.ComplexityCapacity = metrics.ComplexityCapacity
	stats.Mana = math.min(stats.Mana, stats.Capacity)
	stats.ProgressionRank = progression.Rank
end

local function locusPotency(player: Player): number
	local stats = playerData[player]
	return if stats then stats.Potency else LocusProfile.Potency
end

local function hasPayload(definition, event: string, kind: string): boolean
	for _, step in definition.Triggers[event] or {} do
		for _, payload in step.Payloads or {} do
			if payload.Kind == kind then
				return true
			end
		end
	end
	return false
end

local function hasPayloadAnywhere(definition, kind: string): boolean
	for _, steps in definition.Triggers or {} do
		for _, step in steps do
			for _, payload in step.Payloads or {} do
				if payload.Kind == kind then
					return true
				end
			end
		end
	end
	return false
end

local function validate(
	player: Player,
	state: State,
	intent: any,
	definition: any,
	charge: number
): (string, string?, Instance?, Vector3?, Model?, Vector3?)
	if not definition or not validVector(intent.AimDirection) then
		return "IMPOSSIBLE", "Invalid spell or aim"
	end
	if not CastingSpec.hasFreeHand(definition.Casting, Equipment.freeHandCount(player)) then
		return "IMPOSSIBLE", "This spell requires at least one free hand"
	end
	local direction = intent.AimDirection
	if direction.Magnitude < 0.9 or direction.Magnitude > 1.1 then
		return "IMPOSSIBLE", "Invalid aim direction"
	end
	direction = direction.Unit
	-- Constructs are aim-placed primitives. Their ray may attach them to a surface
	-- or character, but the cast itself must never depend on having a target.
	local targeting = if definition.Form == "Construct" then "AimDirection" else definition.Targeting
	local worldPoint = intent.WorldPoint
	local material: Instance? = nil
	local selectedTarget: Model? = nil
	local objectPosition: Vector3? = nil
	if targeting == "EntityTarget" then
		local policy = definition.TargetPolicy or "Aim"
		local target = if policy == "LockOn" then nil else intent.TargetModel
		local function validTarget(candidate: any): (Model?, Vector3?, string?)
			if
				typeof(candidate) ~= "Instance"
				or not candidate:IsA("Model")
				or not candidate:IsDescendantOf(workspace)
			then
				return nil, nil, "Aim at a living target"
			end
			local humanoid = candidate:FindFirstChildOfClass("Humanoid")
			local root = candidate:FindFirstChild("HumanoidRootPart")
			if
				candidate == state.Character
				or not humanoid
				or humanoid.Health <= 0
				or not root
				or not root:IsA("BasePart")
			then
				return nil, nil, "Target is not a living character"
			end
			if not Conditions.relationshipMatches(state.Character, candidate, definition.TargetRules.Relationship) then
				return nil, nil, "Target does not match the spell relationship rule"
			end
			if not Conditions.hasConsent(definition, candidate) then
				return nil, nil, "Target has not opted in to consent-gated spells"
			end
			local origin = state.Root.Position + Vector3.new(0, 1.5, 0)
			local delta = root.Position - origin
			if delta.Magnitude < 0.001 or delta.Magnitude > TargetingSpec.entityRange(definition) then
				return nil, nil, "Target is outside spell range"
			end
			if direction:Dot(delta.Unit) < Sandbox.Magic.MinimumEntityAimDot then
				return nil, nil, "Target is outside aim direction"
			end
			if definition.TargetRules.RequiresLineOfSight then
				local ray = RaycastParams.new()
				ray.FilterType = Enum.RaycastFilterType.Exclude
				ray.FilterDescendantsInstances = { state.Character, candidate }
				ray.RespectCanCollide = true
				if workspace:Raycast(origin, delta, ray) then
					return nil, nil, "Target is obstructed"
				end
			end
			return candidate, delta.Unit, nil
		end
		local targetDirection: Vector3? = nil
		local targetReason: string? = nil
		if target then
			selectedTarget, targetDirection, targetReason = validTarget(target)
		end
		if not selectedTarget and (policy == "LockOn" or policy == "AimOrLockOn") then
			local acquired = acquireEntityTarget(state, direction, definition)
			if acquired then
				selectedTarget, targetDirection, targetReason = validTarget(acquired)
			end
		end
		if not selectedTarget then
			return "IMPOSSIBLE", targetReason or "No valid target in the aim cone"
		end
		direction = targetDirection or direction
	elseif targeting == "WorldPoint" or targeting == "Area" then
		if
			not validVector(worldPoint)
			or (worldPoint - state.Root.Position).Magnitude > definition.TargetRules.Range
		then
			return "IMPOSSIBLE", "Invalid world target"
		end
		if
			definition.Form == "Construct"
			and (
				(worldPoint - (state.Root.Position + Vector3.new(0, 1.5, 0))).Magnitude < 0.001
				or (worldPoint - (state.Root.Position + Vector3.new(0, 1.5, 0))).Magnitude
					> definition.Construct.Distance
			)
		then
			return "IMPOSSIBLE", "World point is outside Construct placement range"
		end
		local aimedDelta = worldPoint - (state.Root.Position + Vector3.new(0, 1.5, 0))
		if aimedDelta.Magnitude > 0 and direction:Dot(aimedDelta.Unit) < Sandbox.Magic.MinimumWorldAimDot then
			return "IMPOSSIBLE", "World target is outside aim direction"
		end
	elseif targeting == "MaterialTarget" then
		if
			not validVector(worldPoint)
			or (worldPoint - state.Root.Position).Magnitude > definition.TargetRules.Range
		then
			return "IMPOSSIBLE", "Invalid material target"
		end
		-- Use a server-known spell origin for the anti-spoof comparison rather than
		-- trusting a client-provided camera position. This preserves camera pitch.
		local aimedDelta = worldPoint - (state.Root.Position + Vector3.new(0, 1.5, 0))
		if aimedDelta.Magnitude > 0 and direction:Dot(aimedDelta.Unit) < Sandbox.Magic.MinimumWorldAimDot then
			return "IMPOSSIBLE", "Material target is outside aim direction"
		end
		material = if definition.Form == "Manipulation"
			then findManipulable(definition, worldPoint)
			else findMaterial(definition, worldPoint)
		if not material then
			return "IMPOSSIBLE", "No eligible material source with enough available amount is in range"
		end
	elseif targeting == "ObjectTarget" then
		local targetInstance = intent.TargetInstance
		if
			typeof(targetInstance) ~= "Instance"
			or not targetInstance:IsA("BasePart")
			or not targetInstance:IsDescendantOf(workspace)
		then
			return "IMPOSSIBLE", "Aim at a valid world object"
		end
		local origin = state.Root.Position + Vector3.new(0, 1.5, 0)
		if definition.Form == "Construct" then
			if not isSolidWorldSurfaceTarget(targetInstance) then
				return "IMPOSSIBLE", "Constructs can attach only to solid world geometry"
			end
			local reach = math.min(definition.TargetRules.Range, definition.Construct.Distance)
			local obstructionRay = RaycastParams.new()
			obstructionRay.FilterType = Enum.RaycastFilterType.Exclude
			obstructionRay.FilterDescendantsInstances = { state.Character }
			obstructionRay.RespectCanCollide = true
			local hit = workspace:Raycast(origin, direction * reach, obstructionRay)
			if not hit or hit.Instance ~= targetInstance then
				return "IMPOSSIBLE", "Selected surface is out of reach or obstructed"
			end
			material = targetInstance
			objectPosition = hit.Position
		elseif definition.Form == "Field" or definition.Form == "Aura" then
			if not isSolidWorldSurfaceTarget(targetInstance) then
				return "IMPOSSIBLE", "Area spells can target only solid world surfaces"
			end
			local reach = definition.TargetRules.Range
			local obstructionRay = RaycastParams.new()
			obstructionRay.FilterType = Enum.RaycastFilterType.Exclude
			obstructionRay.FilterDescendantsInstances = { state.Character }
			obstructionRay.RespectCanCollide = true
			local hit = workspace:Raycast(origin, direction * reach, obstructionRay)
			if not hit or hit.Instance ~= targetInstance then
				return "IMPOSSIBLE", "Selected surface is out of reach or obstructed"
			end
			material = targetInstance
			objectPosition = hit.Position
		elseif definition.Form == "Projectile" or definition.Form == "Beam" or definition.Form == "Wave" then
			local hasObjectForce = hasPayloadAnywhere(definition, "Force")
			local hasObjectControl = hasPayloadAnywhere(definition, "Control")
			local hasObjectManipulation = hasPayloadAnywhere(definition, "Manipulation")
			if
				not (hasObjectForce or hasObjectControl or hasObjectManipulation)
				or not isValidObjectInteractionTarget(definition, targetInstance)
			then
				return "IMPOSSIBLE",
					"Selected object is not authorized for this spell's Force, Control, or material Manipulation effects"
			end
			local formReach = if definition.Form == "Projectile"
				then definition.Projectile.MaxDistance
				elseif definition.Form == "Beam" then definition.Beam.Range * math.max(
					definition.Beam.GrowthStartScale or 1,
					definition.Beam.GrowthEndScale or 1
				)
				else definition.Wave.Range * math.max(
					definition.Wave.GrowthStartScale or 1,
					definition.Wave.GrowthEndScale or 1
				)
			local reach = math.min(
				definition.TargetRules.Range,
				formReach,
				if definition.Material then definition.Material.SearchRadius else definition.TargetRules.Range
			)
			local obstructionRay = RaycastParams.new()
			obstructionRay.FilterType = Enum.RaycastFilterType.Exclude
			obstructionRay.FilterDescendantsInstances = { state.Character }
			obstructionRay.RespectCanCollide = true
			local hit = workspace:Raycast(origin, direction * reach, obstructionRay)
			if not hit or hit.Instance ~= targetInstance then
				return "IMPOSSIBLE", "Selected movable object is out of reach or obstructed"
			end
			material = targetInstance
			objectPosition = hit.Position
		else
			local hasOperation = hasPayload(definition, "OnCast", "Manipulation")
			local hasObjectForce = hasPayload(definition, "OnCast", "Force")
			local hasObjectControl = hasPayload(definition, "OnCast", "Control")
			local hasObjectPhysics = hasObjectForce or hasObjectControl
			local manipulationTargetValid = ObjectTargetSpec.isValidManipulationTarget({
				InWorkspace = targetInstance:IsDescendantOf(workspace),
				CanCollide = targetInstance.CanCollide,
				HasHumanoidAncestor = hasHumanoidAncestor(targetInstance),
				Tagged = CollectionService:HasTag(targetInstance, "MagicManipulable"),
				Anchored = targetInstance.Anchored,
				AssemblyMass = targetInstance.AssemblyMass,
				MaterialMatches = definition.Material ~= nil
					and targetInstance:GetAttribute("MagicMaterial") == definition.Material.Material,
				RaiseAuthorized = targetInstance:GetAttribute("MagicRaise") == true,
			}, hasOperation, hasObjectPhysics)
			if not manipulationTargetValid then
				return "IMPOSSIBLE", "Aim at a tagged material or movable object supported by this spell"
			end
			local reach = math.min(
				definition.TargetRules.Range,
				if definition.Material then definition.Material.SearchRadius else definition.TargetRules.Range
			)
			local obstructionRay = RaycastParams.new()
			obstructionRay.FilterType = Enum.RaycastFilterType.Exclude
			obstructionRay.FilterDescendantsInstances = { state.Character }
			obstructionRay.RespectCanCollide = true
			local hit = workspace:Raycast(origin, direction * reach, obstructionRay)
			if not hit or hit.Instance ~= targetInstance then
				return "IMPOSSIBLE", "Selected object is out of reach or obstructed"
			end
			material = targetInstance
			objectPosition = hit.Position
		end
	end
	if
		definition.Form == "Manipulation"
		and (hasPayload(definition, "OnCast", "Force") or hasPayload(definition, "OnCast", "Control"))
		and (not material or material.Anchored or material.AssemblyMass == math.huge)
	then
		return "IMPOSSIBLE", "Physical force requires a movable object"
	end
	local stats = playerData[player]
	local groundOK, groundReason = Conditions.cast(definition, state, {
		Player = player,
		Resources = resourceSnapshot(stats),
		Material = material,
		MaterialTarget = worldPoint and (material and material:GetAttribute("MagicMaterial") or nil),
	})
	if not groundOK then
		return "IMPOSSIBLE", groundReason
	end
	if not Conditions.lifetimeAllowsStart(definition, state, resourceSnapshot(stats)) then
		return "IMPOSSIBLE", "The effect's keep-alive condition is not currently satisfied"
	end
	if
		definition.TargetRules.RequiresLineOfSight
		and (targeting == "WorldPoint" or targeting == "Area" or targeting == "MaterialTarget")
	then
		local ray = RaycastParams.new()
		ray.FilterType = Enum.RaycastFilterType.Exclude
		ray.FilterDescendantsInstances = { state.Character }
		ray.RespectCanCollide = true
		local origin = state.Root.Position + Vector3.new(0, 1.5, 0)
		local delta = worldPoint - origin
		local hit = workspace:Raycast(origin, delta, ray)
		if hit and (hit.Position - worldPoint).Magnitude > 2 then
			return "IMPOSSIBLE", "Target is obstructed"
		end
	end
	local stats = playerData[player]
	if not stats then
		return "IMPOSSIBLE", "Locus state unavailable"
	end
	local meetsLocusRequirements, locusRequirementReason = true, nil
	if Limits.ProgressionEnabled then
		meetsLocusRequirements, locusRequirementReason =
			LocusRequirementSpec.check(definition.LocusRequirements, resourceSnapshot(stats))
	end
	if not meetsLocusRequirements then
		return "IMPOSSIBLE", locusRequirementReason
	end
	local specialAffordable, missingSpecial = SpecialResourceSpec.canAfford(
		stats.SpecialResources,
		definition.Cost.SpecialResources,
		SpecialResourceDefinitions
	)
	if not specialAffordable then
		local label = SpecialResourceDefinitions[missingSpecial] and SpecialResourceDefinitions[missingSpecial].Label
		return "IMPOSSIBLE", "Insufficient " .. tostring(label or "special resource")
	end
	if definition.Development then
		return "VALID", nil, material, direction, selectedTarget, objectPosition
	end
	local mana, strain, complexity = costs(definition, charge, stats)
	local result, reason = LocusModel.evaluate(stats, mana, strain, complexity, Sandbox.Magic.SandboxResources)
	return result, reason, material, direction, selectedTarget, objectPosition
end

local function updateEnhancement(player: Player, fallbackState: any?)
	local walkSpeedBonus, jumpPowerBonus = 0, 0
	local multiplier = 1
	local aerialSpeed = 0
	for _, effect in enhancements[player] or {} do
		walkSpeedBonus += effect.WalkSpeedBonus
		jumpPowerBonus += effect.JumpPowerBonus
		multiplier = math.max(multiplier, effect.SpeedMultiplier)
		aerialSpeed = math.max(aerialSpeed, effect.AerialSpeed or 0)
	end
	walkSpeedBonus = math.min(walkSpeedBonus, 30)
	jumpPowerBonus = math.min(jumpPowerBonus, Limits.MaxJumpBonus)
	multiplier = math.min(multiplier, Limits.MaxMultiplier)
	local _, effect = next(enhancements[player] or {})
	if effect then
		Movement.setMagicEnhancement(effect.State, walkSpeedBonus, jumpPowerBonus, multiplier)
		Movement.setMagicAerial(effect.State, aerialSpeed)
	elseif fallbackState then
		Movement.setMagicEnhancement(fallbackState, 0, 0, 1)
		Movement.setMagicAerial(fallbackState, 0)
	end
end

local emit: any
local finishBeamChannel: any
local function context(definition, caster, position, targets, direction, remote, player, potency, runtimeState)
	local stats = playerData[player]
	local eventDepth = runtimeState and runtimeState.EventDepth or 0
	local resolvedPotency = potency or (if stats then stats.Potency else LocusProfile.Potency)
	local ctx = {
		Caster = caster,
		Player = player,
		SpellId = definition.SpellId,
		Color = definition.Visual.Color,
		Targets = if runtimeState and (runtimeState.UsePreviousTargetSet or runtimeState.AllowObjectTarget)
			then targets
			else Conditions.targets(definition, caster, position, targets, {
				Player = player,
				Resources = resourceSnapshot(stats),
				SpellState = runtimeState,
				AllowDeadTargets = runtimeState
					and (
						runtimeState.EventName == "OnTargetDeath"
						or runtimeState.EventName == "OnDamageTaken"
						or runtimeState.EventName == "OnBreak"
						or runtimeState.EventName == "OnCasterDeath"
						or runtimeState.EventName == "OnExit"
					),
				AllowCasterTarget = runtimeState
					and (
						runtimeState.EventName == "OnDamageTaken"
						or runtimeState.EventName == "OnBreak"
						or runtimeState.EventName == "OnThreshold"
						or runtimeState.EventName == "OnCasterDeath"
					),
			}),
		Direction = direction,
		Potency = resolvedPotency,
		Origin = position,
		EventDepth = eventDepth,
		HealthThreshold = runtimeState and runtimeState.HealthThreshold or nil,
		Command = runtimeState and runtimeState.Command or nil,
		DeathCause = runtimeState and runtimeState.DeathCause or nil,
		TrackAffected = function(humanoid)
			if
				runtimeState
				and type(runtimeState.TargetsHit) == "table"
				and typeof(humanoid) == "Instance"
				and humanoid:IsA("Humanoid")
			then
				runtimeState.TargetsHit[humanoid] = true
			end
		end,
		HitFeedback = function(humanoid, dealt)
			feedback(
				remote,
				player,
				"HIT",
				definition,
				{ Reason = humanoid.Parent and humanoid.Parent.Name, Damage = dealt, Target = humanoid.Parent }
			)
		end,
		EffectFeedback = function(effect, humanoid, amount)
			local target = humanoid.Parent
			feedback(remote, player, "EFFECT", definition, {
				Effect = effect,
				Amount = amount,
				Reason = target and target.Name,
				Target = target,
			})
			if
				(
					effect == "Heal"
					or effect == "Shield"
					or effect == "Control"
					or effect == "Displacement"
					or effect == "TimeDilation"
					or effect == "Transformation"
					or effect == "MagicArmor"
					or effect == "Bind"
				)
				and target
				and target:IsA("Model")
			then
				remote:FireAllClients({ Kind = "ImpactNumber", Effect = effect, Amount = amount, Target = target })
			end
		end,
		Summon = function(payload)
			local created, count, message = Summons.apply(
				player,
				caster,
				definition.SpellId,
				payload,
				definition.Visual.Color,
				Spec.copy(definition),
				remote,
				direction,
				resolvedPotency,
				position
			)
			if message or not created then
				feedback(remote, player, if created then "SUMMONED" else "IMPOSSIBLE", definition, {
					Reason = message
						or "No new summon was created; check whether this spell already has its configured summon count",
					Count = count,
				})
			end
		end,
	}
	ctx.ApplyManipulation = function(operation)
		local target = runtimeState and runtimeState.ObjectTarget
		if
			runtimeState
			and runtimeState.AllowObjectTarget == true
			and typeof(target) == "Instance"
			and target:IsA("BasePart")
			and table.find(ctx.Targets, target)
			and isValidObjectInteractionTarget(definition, target)
		then
			Manipulation.execute(operation.Operation, target, operation.Distance)
		end
	end
	ctx.DamageContext = {
		Depth = eventDepth,
		SourceRuntimeState = runtimeState and runtimeState.RuntimeOrigin or nil,
		HitPart = runtimeState and runtimeState.HitPart or nil,
		Element = definition.Element or "Neutral",
		ThresholdSteps = definition.Triggers.OnThreshold,
		EmitEvent = function(eventName, targetHumanoid, eventData)
			if eventDepth >= Limits.MaxMagicEventDepth or not emit then
				return
			end
			local runtime = runtimeState and (runtimeState.RuntimeOrigin or runtimeState)
			if eventName == "OnTargetDeath" and not TargetDeathSpec.claim(runtime, targetHumanoid) then
				return
			end
			local eventState = {
				RuntimeOrigin = runtimeState and (runtimeState.RuntimeOrigin or runtimeState) or nil,
				Age = runtimeState and runtimeState.Age or 0,
				CurrentPhase = eventName,
				TargetsHit = runtimeState and runtimeState.TargetsHit or {},
				Position = runtimeState and runtimeState.Position or position,
				RemainingLifetime = runtimeState and runtimeState.RemainingLifetime or nil,
				PierceCount = runtimeState and runtimeState.PierceCount or 0,
				BounceCount = runtimeState and runtimeState.BounceCount or 0,
				AbsorbedEnergy = runtimeState and runtimeState.AbsorbedEnergy or 0,
				CurrentTarget = runtimeState and runtimeState.CurrentTarget or targetHumanoid,
				StartedAt = runtimeState and runtimeState.StartedAt or os.clock(),
				EventDepth = eventDepth + 1,
				EventName = eventName,
				DeathCause = if eventName == "OnTargetDeath"
					then (eventData and eventData.DeathCause or "KilledByThisSpell")
					else nil,
				HealthThreshold = eventData and eventData.HealthThreshold or nil,
				UsePreviousTargetSet = eventName == "OnBreak",
			}
			local eventPosition = position
			if
				(eventName == "OnBreak" or eventName == "OnThreshold" or eventName == "OnTargetDeath")
				and targetHumanoid
			then
				local targetModel = targetHumanoid.Parent
				local targetRoot = targetModel and targetModel:FindFirstChild("HumanoidRootPart")
				if targetRoot and targetRoot:IsA("BasePart") then
					eventPosition = targetRoot.Position
				end
			end
			emit(
				definition,
				eventName,
				caster,
				eventPosition,
				if targetHumanoid then { targetHumanoid } else {},
				direction,
				remote,
				player,
				potency,
				eventState
			)
		end,
	}
	ctx.TargetDeathCallback = function(targetHumanoid)
		if not definition.Triggers or not definition.Triggers.OnTargetDeath then
			return nil
		end
		return function()
			ctx.DamageContext.EmitEvent("OnTargetDeath", targetHumanoid, { DeathCause = "DiedWhileAffected" })
		end
	end
	ctx.ApplySpherePayloads = function(radius, payloads)
		Presentation.marker(
			"MagicExplosionDebug",
			position,
			Vector3.new(0.2, radius * 2, radius * 2),
			definition.Visual.Color,
			0.2
		)
		local candidates = HitDetection.findSphere(caster, CFrame.new(position), radius, {
			OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
			RequireLineOfSight = definition.TargetRules.RequiresLineOfSight,
			IncludeAttacker = definition.TargetRules.IncludeCaster,
		})
		local targets = Conditions.targets(definition, caster, position, candidates, {
			Player = player,
			Resources = resourceSnapshot(stats),
			SpellState = runtimeState,
		})
		local validatedState = table.clone(runtimeState or {})
		validatedState.UsePreviousTargetSet = true
		Payloads.execute(
			payloads,
			context(definition, caster, position, targets, direction, remote, player, potency, validatedState)
		)
	end
	return ctx
end
emit = function(definition, event, caster, position, targets, direction, remote, player, potency, runtimeState)
	local eventState = table.clone(runtimeState or {})
	eventState.EventName = event
	eventState.RuntimeOrigin = if runtimeState then runtimeState.RuntimeOrigin or runtimeState else nil
	local audioCue = if event == "OnImpact"
		then "ImpactSoundId"
		elseif event == "OnExpire" then "EndSoundId"
		elseif event == "OnBreak" then "BreakSoundId"
		else nil
	if audioCue then
		Presentation.playSound(definition, audioCue, position)
	end
	Triggers.execute(
		definition,
		event,
		context(definition, caster, position, targets, direction, remote, player, potency, eventState)
	)
end

local function hasEvent(definition: any, event: string): boolean
	local steps = definition.Triggers[event]
	return type(steps) == "table" and #steps > 0
end

local lifecycleState

local function dispatchClaimedExpiry(
	effect: any,
	position: Vector3,
	targets: { any },
	potency: number?,
	casterOverride: Model?,
	playerOverride: Player?
)
	if not hasEvent(effect.Definition, "OnExpire") then
		return
	end
	effect.CurrentPhase = "Expired"
	local eventState = lifecycleState(effect, "OnExpire", effect.EventDepth or 0)
	eventState.Position = position
	emit(
		effect.Definition,
		"OnExpire",
		effect.Caster or casterOverride,
		position,
		targets,
		effect.Direction or Vector3.zero,
		effect.Remote,
		effect.Player or playerOverride,
		potency,
		eventState
	)
end

local function emitExpiry(
	effect: any,
	position: Vector3,
	targets: { any },
	potency: number?,
	casterOverride: Model?,
	playerOverride: Player?
): boolean
	if not LifetimeSpec.claimExpiry(effect) then
		return false
	end
	dispatchClaimedExpiry(effect, position, targets, potency, casterOverride, playerOverride)
	return true
end

lifecycleState = function(source: any, event: string, depth: number)
	local runtime = source.RuntimeOrigin or source
	return {
		RuntimeOrigin = runtime,
		Age = source.Age or runtime.Age or 0,
		CurrentPhase = event,
		TargetsHit = runtime.TargetsHit or source.TargetsHit or {},
		Position = runtime.Position or source.Position,
		RemainingLifetime = runtime.RemainingLifetime or source.RemainingLifetime,
		PierceCount = runtime.PierceCount or source.PierceCount or 0,
		BounceCount = runtime.BounceCount or source.BounceCount or 0,
		AbsorbedEnergy = runtime.AbsorbedEnergy or source.AbsorbedEnergy or 0,
		CurrentTarget = runtime.CurrentTarget or source.CurrentTarget,
		ObjectTarget = runtime.ObjectTarget or source.ObjectTarget,
		AllowObjectTarget = runtime.AllowObjectTarget == true or source.AllowObjectTarget == true,
		StartedAt = source.StartedAt or runtime.StartedAt or os.clock(),
		EventDepth = depth,
		EventName = event,
	}
end

local function interruptWindupForDamage(target: Humanoid, amount: number)
	if amount <= 0 then
		return
	end
	for player, stats in playerData do
		for _, key in { "Charge", "Pending" } do
			local windup = stats[key]
			if
				windup
				and windup.State.Humanoid == target
				and CastInterruption.damage(windup.Definition.Casting, amount)
			then
				stats[key] = nil
				setCastingMovement(player, windup.State, nil)
				Presentation.cancel(windup.State.Character, windup.Definition)
				feedback(windup.Remote, player, "IMPOSSIBLE", windup.Definition, {
					Reason = "Cast interrupted by health damage",
				})
			end
		end
	end
end

Damage.Applied:Connect(function(attacker: Model, target: Humanoid, amount: number, killed: boolean, damageContext: any?)
	interruptWindupForDamage(target, amount)
	if damageContext and type(damageContext.EmitEvent) == "function" then
		local maxHealth = target.MaxHealth
		local healthBefore = 0
		local healthAfter = 0
		if maxHealth > 0 then
			healthBefore = math.min(maxHealth, target.Health + amount) / maxHealth * 100
			healthAfter = target.Health / maxHealth * 100
		end
		damageContext.EmitEvent("OnDamageDealt", target)
		if maxHealth > 0 then
			for _, step in ipairs(damageContext.ThresholdSteps or {}) do
				local threshold = step.HealthPercent
				if threshold and healthBefore > threshold and healthAfter <= threshold then
					damageContext.EmitEvent("OnThreshold", target, { HealthThreshold = threshold })
				end
			end
		end
		if killed then
			damageContext.EmitEvent("OnTargetDeath", target)
		end
	end
	local targetModel = target.Parent
	if not targetModel or not targetModel:IsA("Model") then
		return
	end
	local depth = if damageContext and type(damageContext.Depth) == "number" then damageContext.Depth else 0
	if depth >= Limits.MaxMagicEventDepth then
		return
	end
	for _, spell in active do
		if spell.Caster == targetModel and hasEvent(spell.Definition, "OnDamageTaken") then
			emit(
				spell.Definition,
				"OnDamageTaken",
				spell.Caster,
				spell.Position,
				{ target },
				spell.Direction,
				spell.Remote,
				spell.Player,
				nil,
				lifecycleState(spell, "OnDamageTaken", depth + 1)
			)
		end
	end
	for player, effects in enhancements do
		for _, effect in effects do
			if
				effect.State.Character == targetModel
				and effect.State.Humanoid.Health > 0
				and effect.Definition
				and hasEvent(effect.Definition, "OnDamageTaken")
			then
				emit(
					effect.Definition,
					"OnDamageTaken",
					targetModel,
					effect.State.Root.Position,
					{ target },
					effect.Direction,
					effect.Remote,
					player,
					nil,
					lifecycleState(effect, "OnDamageTaken", depth + 1)
				)
			end
		end
	end
	if killed then
		local seen = table.clone(active)
		for _, spell in seen do
			local sameSource = damageContext and damageContext.SourceRuntimeState == spell
			if
				not sameSource
				and spell.TargetsHit
				and spell.TargetsHit[target]
				and hasEvent(spell.Definition, "OnTargetDeath")
				and TargetDeathSpec.claim(spell.RuntimeOrigin or spell, target)
			then
				local root = targetModel:FindFirstChild("HumanoidRootPart")
				local position = if root and root:IsA("BasePart")
					then root.Position
					else targetModel:GetPivot().Position
				local eventState = lifecycleState(spell, "OnTargetDeath", depth + 1)
				eventState.DeathCause = "DiedWhileAffected"
				emit(
					spell.Definition,
					"OnTargetDeath",
					spell.Caster,
					position,
					{ target },
					spell.Direction or Vector3.zero,
					spell.Remote,
					spell.Player,
					nil,
					eventState
				)
			end
		end
		for player, effects in enhancements do
			for _, effect in effects do
				local sameSource = damageContext and damageContext.SourceRuntimeState == effect
				if
					not sameSource
					and effect.TargetsHit
					and effect.TargetsHit[target]
					and effect.Definition
					and hasEvent(effect.Definition, "OnTargetDeath")
					and TargetDeathSpec.claim(effect.RuntimeOrigin or effect, target)
				then
					local root = targetModel:FindFirstChild("HumanoidRootPart")
					local position = if root and root:IsA("BasePart")
						then root.Position
						else targetModel:GetPivot().Position
					local eventState = lifecycleState(effect, "OnTargetDeath", depth + 1)
					eventState.DeathCause = "DiedWhileAffected"
					emit(
						effect.Definition,
						"OnTargetDeath",
						effect.State.Character,
						position,
						{ target },
						effect.Direction or Vector3.zero,
						effect.Remote,
						player,
						nil,
						eventState
					)
				end
			end
		end
	end
end)

local function sphereTargets(definition, caster, position, radius)
	return HitDetection.findSphere(caster, CFrame.new(position), radius, {
		MaxDistance = if definition.Form == "Aura" then radius else nil,
		OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
		RequireLineOfSight = definition.TargetRules.RequiresLineOfSight,
		IncludeAttacker = definition.TargetRules.IncludeCaster,
	})
end

local function areaTargets(spell, position, radius)
	local stats = playerData[spell.Player]
	return Conditions.targets(
		spell.Definition,
		spell.Caster,
		position,
		sphereTargets(spell.Definition, spell.Caster, position, radius),
		{
			Player = spell.Player,
			Resources = resourceSnapshot(stats),
			SpellState = spell,
		}
	)
end

local function expireProjectile(spell)
	local targets = if spell.Kind == "ProjectileLinger"
		then areaTargets(spell, spell.Position, spell.LingerRadius)
		else {}
	emitExpiry(spell, spell.Position, targets, locusPotency(spell.Player) * (spell.PotencyMultiplier or 1))
end

local function formAreaCandidates(definition, caster, position, age)
	local area = if definition.Form == "Field" then definition.Field else definition.Aura
	area = AreaGrowth.area(area, AreaGrowth.scale(area, age or 0))
	if definition.Geometry == "Sphere" then
		return sphereTargets(definition, caster, position, area.Radius)
	end
	local frame = CFrame.new(position) * CFrame.Angles(0, math.rad(area.Yaw or 0), 0)
	return HitDetection.findArea(caster, frame, definition.Geometry, area, {
		OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
		RequireLineOfSight = definition.TargetRules.RequiresLineOfSight,
		IncludeAttacker = definition.TargetRules.IncludeCaster,
	})
end

local function formAreaTargets(spell, position)
	local stats = playerData[spell.Player]
	return Conditions.targets(
		spell.Definition,
		spell.Caster,
		position,
		formAreaCandidates(spell.Definition, spell.Caster, position, spell.Age),
		{
			Player = spell.Player,
			Resources = resourceSnapshot(stats),
			SpellState = spell,
		}
	)
end

local function updateActiveProximity(effect, position: Vector3, now: number)
	local definition = effect.Definition
	local proximity = definition.Proximity
	if not proximity or not hasEvent(definition, "OnProximity") then
		return
	end
	local state = effect.ProximityState
	if not state then
		state = ProximitySpec.newState(now)
		effect.ProximityState = state
	end
	if not ProximitySpec.isDue(state, now, proximity.MaxTargets) then
		return
	end
	ProximitySpec.beginSample(state, now, proximity.Interval)
	local candidates = HitDetection.findSphere(effect.Caster, CFrame.new(position), proximity.Radius, {
		OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
		RequireLineOfSight = definition.TargetRules.RequiresLineOfSight,
		IncludeAttacker = definition.TargetRules.IncludeCaster,
	})
	local targets = Conditions.targets(definition, effect.Caster, position, candidates, {
		Player = effect.Player,
		Resources = resourceSnapshot(playerData[effect.Player]),
		SpellState = effect,
	})
	for _, humanoid in ipairs(targets) do
		if ProximitySpec.claim(state, humanoid, proximity.MaxTargets) then
			effect.CurrentPhase = "Proximity"
			effect.CurrentTarget = humanoid
			emit(
				definition,
				"OnProximity",
				effect.Caster,
				position,
				{ humanoid },
				effect.Direction,
				effect.Remote,
				effect.Player,
				locusPotency(effect.Player) * (effect.PotencyMultiplier or 1),
				lifecycleState(effect, "OnProximity", effect.EventDepth or 0)
			)
			effect.CurrentTarget = nil
			effect.CurrentPhase = "Active"
		end
	end
end

local emitAreaTransition
local function updateAreaMembership(spell, targets)
	local previous = spell.PresentTargets or {}
	local validTargets = {}
	for _, humanoid in targets do
		if humanoid.Health > 0 and humanoid:IsDescendantOf(workspace) then
			table.insert(validTargets, humanoid)
		end
	end
	local current, entered, exited = AreaMembership.diff(previous, validTargets)
	for _, humanoid in ipairs(entered) do
		emitAreaTransition(spell, "OnEnter", humanoid)
	end
	for _, humanoid in ipairs(exited) do
		emitAreaTransition(spell, "OnExit", humanoid)
	end
	spell.PresentTargets = current
end

emitAreaTransition = function(spell, event, humanoid)
	if not humanoid:IsDescendantOf(workspace) then
		return
	end
	local eventState = table.clone(spell)
	eventState.UsePreviousTargetSet = event == "OnExit"
	emit(
		spell.Definition,
		event,
		spell.Caster,
		spell.Position,
		{ humanoid },
		spell.Direction,
		spell.Remote,
		spell.Player,
		nil,
		eventState
	)
end

local function closeAreaMembership(spell)
	local exited = AreaMembership.clear(spell.PresentTargets or {})
	for _, humanoid in ipairs(exited) do
		emitAreaTransition(spell, "OnExit", humanoid)
	end
	spell.PresentTargets = {}
end

local function finishInterruptedArea(spell)
	local wasChannel = spell.IsChannel == true
	spell.IsChannel = false
	local targets = {}
	for humanoid in pairs(spell.PresentTargets or {}) do
		if humanoid:IsDescendantOf(workspace) then
			table.insert(targets, humanoid)
		end
	end
	emitExpiry(spell, spell.Position, targets)
	closeAreaMembership(spell)
	local stats = playerData[spell.Player]
	if stats and stats.Channel == spell then
		stats.Channel = nil
	end
	if spell.Visual then
		Presentation.finish(spell.Visual)
	end
	if wasChannel then
		Presentation.cancel(spell.Caster, spell.Definition)
	end
end

local function expireSelfEnhancement(player: Player, effect: any)
	if not LifetimeSpec.claimExpiry(effect) then
		return
	end
	local state = effect.State
	local humanoid = state.Humanoid
	local character = state.Character
	local position = state.Root.Position
	if humanoid.Health <= 0 and not effect.CasterDeathEventFired and hasEvent(effect.Definition, "OnCasterDeath") then
		effect.CurrentPhase = "CasterDeath"
		emit(
			effect.Definition,
			"OnCasterDeath",
			character,
			position,
			{ humanoid },
			effect.Direction,
			effect.Remote,
			player,
			nil,
			lifecycleState(effect, "OnCasterDeath", 0)
		)
	end
	dispatchClaimedExpiry(effect, position, { humanoid }, nil, character, player)
end

local function stopToggledEffect(player: Player, caster: Model, definition: any): boolean
	local stopped = false
	for index = #active, 1, -1 do
		local spell = active[index]
		if
			spell.Player == player
			and spell.Caster == caster
			and spell.Definition.SpellId == definition.SpellId
			and (
				spell.Kind == "Field"
				or spell.Kind == "Aura"
				or (spell.Kind == "Construct" and definition.Form == "Construct")
			)
		then
			if spell.Kind == "Field" or spell.Kind == "Aura" then
				local wasChannel = spell.IsChannel == true
				local area = spell.Definition.Field or spell.Definition.Aura
				local targets = formAreaTargets(spell, spell.Position)
				updateAreaMembership(spell, targets)
				spell.IsChannel = false
				emitExpiry(spell, spell.Position, targets)
				closeAreaMembership(spell)
				if wasChannel then
					Presentation.cancel(spell.Caster, spell.Definition)
				end
			elseif spell.Kind == "Construct" then
				local target = spell.AttachedHumanoid
				emitExpiry(spell, spell.Position, if target then { target } else {}, nil)
			end
			Presentation.finish(spell.Visual)
			table.remove(active, index)
			stopped = true
		end
	end
	return stopped
end

local function configuredLifetime(definition: any): number
	return LifetimeSpec.effectiveDuration(definition.Lifetime.Mode, definition.Lifetime.Duration)
end

local function watchPersistentConstruct(model: Model, id: string)
	local removed = false
	local function removeRecord()
		if removed then
			return
		end
		removed = true
		task.spawn(function()
			local reason
			for attempt = 1, 3 do
				local ok
				ok, reason = PersistentConstructStore.remove(id)
				if ok then
					return
				end
				task.wait(attempt)
			end
			warn("Persistent Construct removal was not saved: " .. tostring(reason))
		end)
	end
	model.Destroying:Connect(removeRecord)
	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			removeRecord()
		end
	end)
end

local function persistentConstructRecord(player: Player, frame: CFrame, components: { any }, definition: any)
	local rx, ry, rz = frame:ToOrientation()
	local serializedComponents = {}
	for index, component in ipairs(components) do
		local rotation = component.RotationDegrees
		serializedComponents[index] = {
			Shape = component.Shape,
			Size = { component.Size[1], component.Size[2], component.Size[3] },
			Offset = { component.Offset[1], component.Offset[2], component.Offset[3] },
			RotationDegrees = { rotation[1], rotation[2], rotation[3] },
		}
	end
	local function colorArray(color)
		return { color.R, color.G, color.B }
	end
	local visual = definition.Visual
	return {
		OwnerUserId = player.UserId,
		Position = { frame.Position.X, frame.Position.Y, frame.Position.Z },
		RotationDegrees = { math.deg(rx), math.deg(ry), math.deg(rz) },
		Components = serializedComponents,
		Visual = {
			Color = colorArray(visual.Color),
			SecondaryColor = visual.SecondaryColor and colorArray(visual.SecondaryColor) or nil,
			AccentColor = visual.AccentColor and colorArray(visual.AccentColor) or nil,
			MaterialAppearance = visual.MaterialAppearance or "Auto",
			Opacity = visual.Opacity or 0.85,
			Emission = visual.Emission or 0,
			ParticleStyle = visual.ParticleStyle or "None",
		},
	}
end

-- A single bounded sweep includes world solids and character limbs. Query-only
-- cosmetic parts are excluded through reassignment (FilterDescendantsInstances is a copy).
local function sweep(start, delta, caster, visualPart, radius, additionalIgnored)
	if delta.Magnitude < 0.0001 then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignored = { caster }
	if visualPart then
		table.insert(ignored, visualPart)
	end
	for _, instance in ipairs(additionalIgnored or {}) do
		table.insert(ignored, instance)
	end
	params.RespectCanCollide = false
	for _ = 1, 16 do
		params.FilterDescendantsInstances = ignored
		local hit = if radius > 0
			then workspace:Spherecast(start, radius, delta, params)
			else workspace:Raycast(start, delta, params)
		if not hit then
			return nil
		end
		local model = hit.Instance:FindFirstAncestorOfClass("Model")
		if
			(model and model:FindFirstChildOfClass("Humanoid"))
			or hit.Instance:IsA("Terrain")
			or (hit.Instance:IsA("BasePart") and hit.Instance.CanCollide)
		then
			return hit
		end
		table.insert(ignored, hit.Instance)
	end
	-- Fail closed at the final obstruction, never tunnel through excessive decorations.
	params.RespectCanCollide = true
	return if radius > 0
		then workspace:Spherecast(start, radius, delta, params)
		else workspace:Raycast(start, delta, params)
end
local function isSpawnFloorClip(part, start, direction, caster, visualPart, radius)
	-- Large visuals may begin with their lower surface slightly inside the floor.
	-- Treat only the supporting surface directly beneath a mostly level/upward cast
	-- as launch clearance; walls, characters, and downward casts still impact.
	if radius <= 0 or direction.Y < -0.35 then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = if visualPart then { caster, visualPart } else { caster }
	params.RespectCanCollide = true
	local support = workspace:Raycast(start + Vector3.yAxis * 0.05, -Vector3.yAxis * (radius + 0.1), params)
	return support ~= nil and support.Instance == part and support.Position.Y <= start.Y
end
local function targetFrom(hit)
	local model = hit and hit.Instance:FindFirstAncestorOfClass("Model")
	while model and not model:FindFirstChildOfClass("Humanoid") do
		model = model:FindFirstAncestorOfClass("Model")
	end
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	return if humanoid then { humanoid } else {}
end

local function resolveBeamCascadeStrike(spell, strikeIndex: number)
	local definition = spell.Definition
	local beam = definition.Beam
	local count = beam.StrikeCount
	local angle = (strikeIndex - 1) * 2.399963229728653
	local radial = if count > 1 then beam.SpreadRadius * math.sqrt((strikeIndex - 1) / (count - 1)) else 0
	local center = spell.Center + Vector3.new(math.cos(angle) * radial, 0, math.sin(angle) * radial)
	if (center - spell.Caster:GetPivot().Position).Magnitude > definition.TargetRules.Range + beam.SpreadRadius then
		return
	end
	local start = center + Vector3.yAxis * beam.DropHeight
	local delta = -Vector3.yAxis * (beam.DropHeight + 8)
	local hit = sweep(start, delta, spell.Caster, nil, beam.Width / 2)
	local endpoint = if hit then start + delta.Unit * hit.Distance else start + delta
	Presentation.beam(start, endpoint, beam.Width, definition.Visual.Color, definition.Beam.DebugDuration, definition)
	if hit then
		local runtimeState = { HitPart = hit.Instance }
		emit(
			definition,
			"OnImpact",
			spell.Caster,
			endpoint,
			targetFrom(hit),
			-Vector3.yAxis,
			spell.Remote,
			spell.Player,
			nil,
			runtimeState
		)
	end
end

local function objectTargetHit(
	caster: Model,
	origin: Vector3,
	direction: Vector3,
	range: number,
	target: BasePart?,
	definition
)
	if not target or not isValidObjectInteractionTarget(definition, target) then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { caster }
	params.RespectCanCollide = true
	local hit = workspace:Raycast(origin, direction * range, params)
	return if hit and hit.Instance == target then hit else nil
end

local function objectTargetRange(definition): number
	local formRange = if definition.Form == "Projectile"
		then definition.Projectile.MaxDistance
		elseif definition.Form == "Beam" then definition.Beam.Range * math.max(
			definition.Beam.GrowthStartScale or 1,
			definition.Beam.GrowthEndScale or 1
		)
		else definition.Wave.Range * math.max(
			definition.Wave.GrowthStartScale or 1,
			definition.Wave.GrowthEndScale or 1
		)
	return math.min(
		definition.TargetRules.Range,
		formRange,
		if definition.Material then definition.Material.SearchRadius else definition.TargetRules.Range
	)
end
local hasCapacity: (Player) -> boolean

local function initializeProjectileMotion(projectile, definition)
	local phases = definition.Projectile.MotionPhases or {}
	projectile.BaseSpeed = definition.Projectile.Speed
	projectile.MotionPhaseIndex = 1
	projectile.MotionPhaseElapsed = 0
	projectile.InitialVisualSize = projectile.Visual.Size
	projectile.Velocity = projectile.Direction * ProjectileMotion.initialSpeed(definition.Projectile.Speed, phases)
end

local function projectileHasBehavior(projectile, kind: string): boolean
	for _, behavior in ipairs(projectile.Definition.Projectile.Behaviors or {}) do
		if behavior.Kind == kind then
			return true
		end
	end
	return false
end

local function projectileBehaviorContext(spell)
	local definition = spell.Definition
	local function findTargetsAt(projectile, position, radius, maxTargets)
		local nearby = HitDetection.findSphere(spell.Caster, CFrame.new(position), radius, {
			OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
			RequireLineOfSight = false,
		})
		local candidates = {}
		for _, humanoid in ipairs(nearby) do
			if not (projectile.HitHumanoids and projectile.HitHumanoids[humanoid]) then
				table.insert(candidates, humanoid)
			end
		end
		local valid = Conditions.targets(definition, spell.Caster, position, candidates)
		local configuredLos = definition.TargetRules.RequiresLineOfSight
			or (not definition.Conditions.Operator and table.find(definition.Conditions, "HasLineOfSight") ~= nil)
		local visible = {}
		for _, humanoid in ipairs(valid) do
			local model = humanoid.Parent
			local root = model and model:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				local unobstructed = configuredLos
				if not configuredLos then
					local ray = RaycastParams.new()
					ray.FilterType = Enum.RaycastFilterType.Exclude
					ray.FilterDescendantsInstances = { spell.Caster, model }
					ray.RespectCanCollide = true
					unobstructed = workspace:Raycast(position, root.Position - position, ray) == nil
				end
				if unobstructed then
					table.insert(visible, { Humanoid = humanoid, Distance = (root.Position - position).Magnitude })
				end
			end
		end
		table.sort(visible, function(a, b)
			return a.Distance < b.Distance
		end)
		local results = {}
		for index = 1, math.min(maxTargets or #visible, #visible) do
			table.insert(results, visible[index].Humanoid)
		end
		return results
	end
	local function findTargetAt(projectile, position, radius)
		return findTargetsAt(projectile, position, radius, 1)[1]
	end
	return {
		Now = workspace:GetServerTimeNow(),
		ReturnTargetPosition = function(projectile)
			local humanoid = projectile.Caster:FindFirstChildOfClass("Humanoid")
			local root = projectile.Caster:FindFirstChild("HumanoidRootPart")
			if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
				return nil
			end
			return root.Position + Vector3.new(0, 1.5, 0)
		end,
		FindProximityTargets = function(projectile, radius, maxTargets)
			local candidates = areaTargets(spell, projectile.Position, radius)
			local targets = {}
			for _, humanoid in ipairs(candidates) do
				if
					not (projectile.ProximityTargets and projectile.ProximityTargets[humanoid])
					and not (projectile.HitHumanoids and projectile.HitHumanoids[humanoid])
				then
					table.insert(targets, humanoid)
					if #targets >= maxTargets then
						break
					end
				end
			end
			return targets
		end,
		OnProximity = function(projectile, humanoid)
			emit(
				definition,
				"OnProximity",
				spell.Caster,
				projectile.Position,
				{ humanoid },
				projectile.Direction,
				spell.Remote,
				spell.Player,
				locusPotency(spell.Player) * (projectile.PotencyMultiplier or 1),
				projectile
			)
		end,
		FindIncomingProjectile = function(projectile, radius, maxReflections)
			local closest = nil
			local closestDistance = math.huge
			for _, candidate in ipairs(active) do
				if
					candidate ~= projectile
					and candidate.Kind == "Projectile"
					and not candidate.AbsorbedBy
					and candidate.Caster ~= projectile.Caster
					and (maxReflections == nil or (candidate.ReflectionCount or 0) < maxReflections)
					and candidate.Caster:IsDescendantOf(workspace)
					and Conditions.relationshipMatches(projectile.Caster, candidate.Caster, "Hostile")
				then
					local separation = (candidate.Position - projectile.Position).Magnitude
					local contactRange = radius + definition.Projectile.Radius + candidate.Definition.Projectile.Radius
					if separation <= contactRange and separation < closestDistance then
						closest = candidate
						closestDistance = separation
					end
				end
			end
			return closest
		end,
		ShowAbsorption = function(projectile)
			Presentation.marker(
				"MagicProjectileAbsorb",
				projectile.Position,
				Vector3.new(0.16, definition.Projectile.Radius * 2.6, definition.Projectile.Radius * 2.6),
				definition.Visual.Color,
				0.22
			)
		end,
		ReflectProjectile = function(projectile, incoming)
			local originalCaster = incoming.Caster
			local originalHumanoid = originalCaster:FindFirstChildOfClass("Humanoid")
			local originalRoot = originalCaster:FindFirstChild("HumanoidRootPart")
			local reflectorHumanoid = projectile.Caster:FindFirstChildOfClass("Humanoid")
			local reflectorRoot = projectile.Caster:FindFirstChild("HumanoidRootPart")
			if
				not originalHumanoid
				or originalHumanoid.Health <= 0
				or not originalRoot
				or not originalRoot:IsA("BasePart")
				or not reflectorHumanoid
				or reflectorHumanoid.Health <= 0
				or not reflectorRoot
				or not reflectorRoot:IsA("BasePart")
			then
				return false
			end
			local towardSource = originalRoot.Position - incoming.Position
			if towardSource.Magnitude < 0.001 or incoming.Velocity.Magnitude < 0.001 then
				return false
			end
			incoming.Caster = projectile.Caster
			incoming.Player = projectile.Player
			incoming.Remote = projectile.Remote
			incoming.Direction = towardSource.Unit
			incoming.Velocity = incoming.Direction * incoming.Velocity.Magnitude
			incoming.HomingTarget = originalRoot
			incoming.FixedTarget = true
			incoming.ReflectionCount = (incoming.ReflectionCount or 0) + 1
			incoming.TargetsHit = {}
			incoming.CurrentPhase = "Reflected"
			return true
		end,
		ShowReflection = function(projectile)
			Presentation.marker(
				"MagicProjectileReflect",
				projectile.Position,
				Vector3.new(0.16, definition.Projectile.Radius * 2.6, definition.Projectile.Radius * 2.6),
				definition.Visual.Color,
				0.22
			)
		end,
		Pulse = function(projectile, behavior)
			local targets = areaTargets(spell, projectile.Position, behavior.Radius)
			Presentation.marker(
				"MagicProjectilePulse",
				projectile.Position,
				Vector3.new(0.12, behavior.Radius * 2, behavior.Radius * 2),
				definition.Visual.Color,
				0.18
			)
			emit(
				definition,
				"OnTick",
				spell.Caster,
				projectile.Position,
				targets,
				projectile.Direction,
				spell.Remote,
				spell.Player,
				locusPotency(spell.Player) * (projectile.PotencyMultiplier or 1),
				projectile
			)
		end,
		FindTarget = function(projectile, radius)
			return findTargetAt(projectile, projectile.Position, radius)
		end,
		FindTargetAt = findTargetAt,
		FindTargetsAt = findTargetsAt,
		TargetFromHit = function(hit)
			local humanoid = targetFrom(hit)[1]
			return humanoid, humanoid and humanoid.Parent or nil
		end,
		Link = function(from, to)
			Presentation.beam(
				from,
				to,
				math.max(1.4, definition.Projectile.Radius * 2),
				definition.Visual.Color,
				0.12,
				definition
			)
		end,
		ApplyImpact = function(projectile, humanoid, position, falloff)
			emit(
				definition,
				"OnImpact",
				spell.Caster,
				position,
				{ humanoid },
				projectile.Direction,
				spell.Remote,
				spell.Player,
				locusPotency(spell.Player) * (projectile.PotencyMultiplier or 1) * falloff
			)
		end,
		SpawnSplit = function(projectile, hit, behavior, directions, ignoredTargets)
			local normal = hit.Normal
			if typeof(normal) ~= "Vector3" or normal.Magnitude < 0.001 then
				return false
			end
			local start = hit.Position + normal.Unit * (definition.Projectile.Radius + 0.05)
			local spawned = 0
			local ignoredHumanoids = {}
			for _, model in ipairs(ignoredTargets) do
				local humanoid = model:FindFirstChildOfClass("Humanoid")
				if humanoid then
					ignoredHumanoids[humanoid] = true
				end
			end
			local childHitHumanoids = table.clone(projectile.HitHumanoids or {})
			for humanoid in ignoredHumanoids do
				childHitHumanoids[humanoid] = true
			end
			for _, childDirection in ipairs(directions) do
				if not hasCapacity(spell.Player) then
					break
				end
				local child = {
					Kind = "Projectile",
					SpellId = definition.SpellId,
					Caster = spell.Caster,
					Age = 0,
					CurrentPhase = "Traveling",
					TargetsHit = {},
					HitHumanoids = table.clone(childHitHumanoids),
					StartedAt = os.clock(),
					RemainingLifetime = configuredLifetime(definition),
					Definition = definition,
					Position = start,
					Direction = childDirection,
					Velocity = childDirection * definition.Projectile.Speed,
					Distance = 0,
					IgnoredTargetModels = table.clone(ignoredTargets),
					SplitDepth = (projectile.SplitDepth or 0) + 1,
					PotencyMultiplier = (projectile.PotencyMultiplier or 1) * behavior.DamageFalloff,
					HomingTarget = projectile.HomingTarget,
					FixedTarget = projectile.FixedTarget,
					CommandCastId = projectile.CommandCastId,
					Visual = Presentation.projectile(definition, start),
					Player = spell.Player,
					Remote = spell.Remote,
				}
				initializeProjectileMotion(child, definition)
				emit(definition, "OnSpawn", spell.Caster, start, {}, childDirection, spell.Remote, spell.Player)
				table.insert(active, child)
				spawned += 1
			end
			return spawned > 0
		end,
		SpawnSpread = function(projectile, behavior, pair, angleDegrees)
			if not hasCapacity(spell.Player) then
				return false
			end
			local forward = projectile.Direction.Unit
			local rotationAxis = Vector3.yAxis
			if math.abs(forward:Dot(rotationAxis)) > 0.95 then
				rotationAxis = Vector3.xAxis
			end
			local direction = CFrame.fromAxisAngle(rotationAxis, math.rad(angleDegrees))
				:VectorToWorldSpace(forward).Unit
			local child = table.clone(projectile)
			child.Age = 0
			child.CurrentPhase = "Traveling"
			child.TargetsHit = {}
			child.HitHumanoids = {}
			child.IgnoredTargetModels = {}
			child.StartedAt = os.clock()
			child.RemainingLifetime = configuredLifetime(definition)
			child.Position = projectile.Position
			child.Direction = direction
			child.Velocity = direction * definition.Projectile.Speed
			child.Distance = 0
			child.SplitDepth = projectile.SplitDepth or 0
			child.BounceCount = 0
			child.PotencyMultiplier = (projectile.PotencyMultiplier or 1) * behavior.DamageFalloff ^ pair
			child.Visual = Presentation.projectile(definition, child.Position)
			initializeProjectileMotion(child, definition)
			emit(definition, "OnSpawn", spell.Caster, child.Position, {}, direction, spell.Remote, spell.Player)
			table.insert(active, child)
			return true
		end,
	}
end
hasCapacity = function(player, additional: number?)
	local required = additional or 1
	if #active + required > Limits.MaxActiveGlobal then
		return false
	end
	local count = 0
	for _, effect in active do
		if effect.Player == player then
			count += 1
		end
	end
	return count + required <= Limits.MaxActivePerPlayer
end

local function spawnChannelProjectile(channel): boolean
	if not hasCapacity(channel.Player) then
		return false
	end
	local definition = channel.Definition
	local root = channel.Caster:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end
	local fallback = root.Position + Vector3.new(0, 1.5, 0)
	local start = Presentation.handOrigin(channel.Caster, fallback)
	if start ~= fallback and sweep(fallback, start - fallback, channel.Caster, nil, 0) then
		start = fallback
	end
	local targetRoot = nil
	local targetModel = channel.TargetModel
	if targetModel and targetModel:IsDescendantOf(workspace) then
		local humanoid = targetModel:FindFirstChildOfClass("Humanoid")
		local candidateRoot = targetModel:FindFirstChild("HumanoidRootPart")
		if humanoid and humanoid.Health > 0 and candidateRoot and candidateRoot:IsA("BasePart") then
			targetRoot = candidateRoot
		end
	end
	local projectile = {
		Kind = "Projectile",
		SpellId = definition.SpellId,
		Caster = channel.Caster,
		Age = 0,
		CurrentPhase = "Traveling",
		TargetsHit = {},
		StartedAt = os.clock(),
		RemainingLifetime = definition.Lifetime.Duration,
		Definition = definition,
		Position = start,
		Direction = channel.Direction,
		Velocity = channel.Direction * definition.Projectile.Speed,
		Distance = 0,
		HomingTarget = if definition.TargetPolicy == "MaintainTarget" then targetRoot else nil,
		ObjectTarget = if definition.Targeting == "ObjectTarget" then channel.ObjectTarget else nil,
		FixedTarget = definition.TargetPolicy == "MaintainTarget",
		Visual = Presentation.projectile(definition, start),
		Player = channel.Player,
		Remote = channel.Remote,
	}
	initializeProjectileMotion(projectile, definition)
	emit(definition, "OnSpawn", channel.Caster, start, {}, projectile.Direction, channel.Remote, channel.Player)
	table.insert(active, projectile)
	ProjectileBehaviors.spawn(projectile, projectileBehaviorContext(projectile))
	return true
end

local function constructPlacement(state, d, direction, intent)
	local origin = state.Root.Position + Vector3.new(0, 1.5, 0)
	local placementDistance = d.Construct.Distance
	-- Use a nearby camera aim point when available, but always preserve a valid
	-- direction-based free-air placement when the ray has no target.
	if validVector(intent.WorldPoint) then
		local delta = intent.WorldPoint - origin
		if
			delta.Magnitude > 0.001
			and delta.Magnitude <= placementDistance
			and direction:Dot(delta.Unit) >= Sandbox.Magic.MinimumWorldAimDot
		then
			direction = delta.Unit
			placementDistance = math.min(delta.Magnitude, placementDistance)
		end
	end
	local center = origin + direction * placementDistance
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.001 then
		flat = Vector3.new(0, 0, -1)
	end
	local frame = CFrame.lookAt(center, center + flat.Unit)
	local startScale = AreaGrowth.scale(d.Construct, 0)
	local size = Vector3.new(d.Construct.Width, d.Construct.Height, d.Construct.Depth) * startScale
	local hit = sweep(origin, direction * placementDistance, state.Character, nil, 0)
	local attachment, attachedHumanoid
	if hit then
		-- Project this upright box onto the surface normal, keeping its nearest face flush.
		local normal = hit.Normal
		local offset = Geometry.surfaceOffset(normal, frame.RightVector, frame.UpVector, frame.LookVector, size)
		frame = frame.Rotation + hit.Position + normal * (offset + 0.03)
		if hit.Instance:IsA("BasePart") then
			attachment = hit.Instance
			attachedHumanoid = targetFrom(hit)[1]
		end
	end
	-- Placement is intentionally not gated on free volume. A Construct can be
	-- formed in open air or intersect existing world geometry; a ray hit only
	-- improves placement by attaching it to the nearby surface/character.
	return frame, size, attachment, attachedHumanoid, if hit then hit.Position else nil, if hit then hit.Normal else nil
end
local function execute(
	player,
	state,
	remote,
	definition,
	intent,
	charge,
	material,
	direction,
	result,
	reason,
	castContext,
	selectedTarget,
	objectPosition
)
	local stats = playerData[player]
	local channelProjectile = definition.Form == "Projectile" and definition.Casting.Mode == "Channeled"
	local persistentConstruct = definition.Form == "Construct" and definition.Lifetime.Mode == "Persistent"
	if not stats or (not persistentConstruct and not hasCapacity(player, if channelProjectile then 2 else 1)) then
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = "Active spell safety limit" })
		return
	end
	local constructFrame, constructSize, constructAttachment, constructHumanoid, constructAnchorPoint, constructAnchorNormal
	local constructComponents
	local persistentRecordId
	if definition.Form == "Construct" then
		constructFrame, constructSize, constructAttachment, constructHumanoid, constructAnchorPoint, constructAnchorNormal =
			constructPlacement(state, definition, direction, intent)
		if not constructFrame then
			feedback(remote, player, "IMPOSSIBLE", definition, {
				Reason = "The Construct placement could not be created",
			})
			return
		end
		constructComponents = ConstructGeometry.components(
			definition.Geometry,
			definition.Construct.Width,
			definition.Construct.Height,
			definition.Construct.Depth,
			definition.Construct.Components
		)
		if not constructComponents then
			feedback(remote, player, "IMPOSSIBLE", definition, { Reason = "Construct geometry is invalid" })
			return
		end
		if definition.Targeting == "EntityTarget" and selectedTarget then
			local targetHumanoid = selectedTarget:FindFirstChildOfClass("Humanoid")
			if not targetHumanoid or constructHumanoid ~= targetHumanoid then
				feedback(remote, player, "IMPOSSIBLE", definition, {
					Reason = "Construct could not reach the selected character without obstruction",
				})
				return
			end
		end
		if definition.Lifetime.Mode == "Persistent" then
			if constructHumanoid or (constructAttachment and not constructAttachment.Anchored) then
				feedback(remote, player, "IMPOSSIBLE", definition, {
					Reason = "Persistent Constructs can only be placed on static world geometry or in open air",
				})
				return
			end
		end
	end
	local mana, strain, complexity = costs(definition, charge, stats)
	if CastingSpec.isHeldMode(definition.Casting.Mode) and stats.Mana < mana then
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = "Not enough mana to begin the held spell" })
		return
	end
	local specialCosts = definition.Cost.SpecialResources or {}
	local specialAffordable, missingSpecial =
		SpecialResourceSpec.canAfford(stats.SpecialResources, specialCosts, SpecialResourceDefinitions)
	if not specialAffordable then
		local label = SpecialResourceDefinitions[missingSpecial] and SpecialResourceDefinitions[missingSpecial].Label
		feedback(remote, player, "IMPOSSIBLE", definition, {
			Reason = "Insufficient " .. tostring(label or "special resource"),
			SpecialResources = stats.SpecialResources,
		})
		return
	end
	local materialAmount = if material
			and definition.Material
			and definition.Form ~= "Manipulation"
		then definition.Material.Amount
		else nil
	local materialAvailable = if material then material:GetAttribute("AvailableAmount") else nil
	if
		materialAmount
		and (
			not material
			or not material:IsDescendantOf(workspace)
			or not CollectionService:HasTag(material, "MagicMaterialSource")
			or material:GetAttribute("MagicMaterial") ~= definition.Material.Material
			or type(materialAvailable) ~= "number"
			or materialAvailable ~= materialAvailable
			or materialAvailable <= -math.huge
			or materialAvailable >= math.huge
			or materialAvailable < materialAmount
		)
	then
		feedback(
			remote,
			player,
			"IMPOSSIBLE",
			definition,
			{ Reason = "Material source no longer has enough available amount" }
		)
		return
	end
	if definition.Lifetime.Mode == "Persistent" then
		stats.PersistentConstructCastInProgress = true
		local saved, id, saveReason = pcall(
			PersistentConstructStore.add,
			persistentConstructRecord(player, constructFrame, constructComponents, definition)
		)
		stats.PersistentConstructCastInProgress = nil
		if not saved or not id then
			feedback(remote, player, "IMPOSSIBLE", definition, {
				Reason = tostring(saveReason or id or "Persistent Construct storage is unavailable"),
			})
			return
		end
		persistentRecordId = id
	end
	if not definition.Development or CastingSpec.isHeldMode(definition.Casting.Mode) then
		LocusModel.spend(stats, mana, strain)
	end
	local paidSpecialResources = false
	if next(specialCosts) then
		local spent = SpecialResourceSpec.spend(stats.SpecialResources, specialCosts, SpecialResourceDefinitions)
		if not spent then
			if persistentRecordId then
				task.spawn(function()
					PersistentConstructStore.remove(persistentRecordId)
				end)
			end
			feedback(
				remote,
				player,
				"IMPOSSIBLE",
				definition,
				{ Reason = "Special resource state changed before release" }
			)
			return
		end
		paidSpecialResources = true
		syncSpecialResourceAttributes(player)
	end
	if not definition.Development or CastingSpec.isHeldMode(definition.Casting.Mode) or paidSpecialResources then
		queueResourceSave(player)
	end
	Summons.clearDismissal(player, definition.SpellId)
	stats.Ready[definition.SpellId] = {
		Remaining = math.max(definition.Casting.Cooldown, definition.Casting.RecoveryTime),
		Caster = state.Humanoid,
	}
	if materialAmount and material then
		material:SetAttribute("AvailableAmount", materialAvailable - materialAmount)
	end
	feedback(remote, player, result, definition, {
		Reason = reason,
		Mana = stats.Mana,
		Capacity = stats.Capacity,
		Strain = stats.Strain,
		StrainTolerance = stats.StrainTolerance,
		Efficiency = stats.Efficiency,
		Potency = stats.Potency,
		Complexity = complexity,
		ComplexityCapacity = stats.ComplexityCapacity,
		ManaDemand = mana,
		SpecialResources = stats.SpecialResources,
	})
	local origin = castContext and castContext.Origin or state.Root.Position + Vector3.new(0, 1.5, 0)
	local commandCastId = if castContext
			and castContext.CommandCast == true
			and CompanionSpellPolicy.requiresCommandSlot(d)
		then castContext.CommandId
		else nil
	local function registerActiveEffect(effect)
		if commandCastId ~= nil then
			effect.CommandCastId = commandCastId
		end
		table.insert(active, effect)
	end
	if not castContext and (definition.Form == "Projectile" or definition.Form == "Beam") then
		local hand = intent.CastOrigin
		if not validVector(hand) or (hand - state.Root.Position).Magnitude > 3.5 then
			hand = Presentation.handOrigin(state.Character, origin)
		end
		if not sweep(origin, hand - origin, state.Character, nil, 0) then
			origin = hand
		end
		if validVector(intent.WorldPoint) then
			local delta = intent.WorldPoint - origin
			if delta.Magnitude > 0.001 and direction:Dot(delta.Unit) >= Sandbox.Magic.MinimumWorldAimDot then
				direction = delta.Unit
			end
		end
	end
	local formContext = {}
	formContext.CreateConstruct = function(d)
		local components = constructComponents
			or ConstructGeometry.components(
				d.Geometry,
				d.Construct.Width,
				d.Construct.Height,
				d.Construct.Depth,
				d.Construct.Components
			)
		if not components then
			return
		end
		local componentLifetimes = {}
		local model = Instance.new("Model")
		model.Name = "MagicTemporaryConstruct"
		local pivot = Instance.new("Part")
		pivot.Name = "ConstructPivot"
		pivot.Size = Vector3.one * 0.1
		pivot.Transparency = 1
		pivot.Anchored = true
		pivot.CanCollide, pivot.CanTouch, pivot.CanQuery = false, false, false
		pivot.CFrame = constructFrame
		pivot.Parent = model
		model.PrimaryPart = pivot
		-- The bounded registry is shared with the preview; only server-authored
		-- components become collidable, and character attachments remain harmless.
		for index, component in ipairs(components) do
			local part: BasePart = Instance.new(if component.Shape == "Wedge" then "WedgePart" else "Part")
			part.Name = string.format("ConstructPart%02d", index)
			part.Size = Vector3.new(component.Size[1], component.Size[2], component.Size[3])
			if part:IsA("Part") then
				part.Shape = Enum.PartType[component.Shape]
			end
			local rotation = component.RotationDegrees
			part.CFrame = constructFrame
				* CFrame.new(component.Offset[1], component.Offset[2], component.Offset[3])
				* CFrame.Angles(math.rad(rotation[1]), math.rad(rotation[2]), math.rad(rotation[3]))
			-- Anchored pieces are moved together with the Model and cannot tunnel.
			part.Anchored = true
			part.CanCollide, part.CanTouch, part.CanQuery = constructHumanoid == nil, false, true
			part.Material, part.Color, part.Transparency =
				Presentation.material(d), d.Visual.Color, 1 - (d.Visual.Opacity or 0.85)
			part.Parent = model
			if component.Duration then
				componentLifetimes[part] = component.Duration
			end
			Presentation.construct(part, if index == 1 then 20 else 4, d)
		end
		local constructStartScale = AreaGrowth.scale(d.Construct, 0)
		if constructStartScale ~= 1 then
			model:ScaleTo(constructStartScale)
		end
		model.Parent = workspace
		if d.Lifetime.Mode == "Persistent" and persistentRecordId then
			model.Name = "MagicPersistentConstruct"
			model:SetAttribute("MagicPersistentConstruct", true)
			model:SetAttribute("MagicPersistentConstructId", persistentRecordId)
			model:SetAttribute("MagicPersistentConstructOwner", player.UserId)
			watchPersistentConstruct(model, persistentRecordId)
			return
		end
		Presentation.attachLoop(d, "AmbientLoopSoundId", pivot)
		emit(d, "OnCast", state.Character, constructFrame.Position, {}, direction, remote, player)
		local attachmentPoint = if constructAnchorPoint and constructAttachment
			then constructAttachment.CFrame:PointToObjectSpace(constructAnchorPoint)
			else constructAnchorPoint
		local attachmentNormal = if constructAnchorNormal and constructAttachment
			then constructAttachment.CFrame:VectorToObjectSpace(constructAnchorNormal)
			else constructAnchorNormal
		local attachmentRotation = if constructAttachment
			then constructAttachment.CFrame.Rotation:ToObjectSpace(constructFrame.Rotation)
			else constructFrame.Rotation
		local construct = {
			Kind = "Construct",
			Attachment = constructAttachment,
			AttachedHumanoid = constructHumanoid,
			AttachmentOffset = constructAttachment and constructAttachment.CFrame:ToObjectSpace(constructFrame),
			AttachmentPoint = attachmentPoint,
			AttachmentNormal = attachmentNormal,
			AttachmentRotation = attachmentRotation,
			AnchorPoint = if constructAttachment then nil else constructAnchorPoint,
			AnchorNormal = if constructAttachment then nil else constructAnchorNormal,
			BaseSize = Vector3.new(d.Construct.Width, d.Construct.Height, d.Construct.Depth),
			CurrentScale = constructStartScale,
			GrowthEnabled = d.Construct.GrowthDuration ~= nil and d.Construct.GrowthDuration > 0,
			GrowthCheckAccumulator = 0.1,
			Caster = state.Character,
			Position = constructFrame.Position,
			Direction = direction,
			Player = player,
			Remote = remote,
			Definition = d,
			Age = 0,
			CurrentPhase = "Active",
			TargetsHit = {},
			ProximityState = if d.Proximity then ProximitySpec.newState(workspace:GetServerTimeNow()) else nil,
			StartedAt = os.clock(),
			RemainingLifetime = configuredLifetime(d),
			State = state,
			Visual = model,
			ComponentLifetimes = componentLifetimes,
		}
		registerActiveEffect(construct)
		formContext.RegisterChannel(construct)
	end
	formContext.CreateAura = function(d)
		local followPart = if d.Targeting == "ObjectTarget"
				and material
				and material:IsA("BasePart")
			then material
			else nil
		local followTarget = if d.Targeting == "EntityTarget" then selectedTarget else state.Character
		local followRoot = if followPart then nil else followTarget:FindFirstChild("HumanoidRootPart")
		if
			(not followPart and (not followRoot or not followRoot:IsA("BasePart")))
			or (followPart and not objectPosition)
		then
			feedback(remote, player, "IMPOSSIBLE", d, { Reason = "Aura follow target is no longer available" })
			return
		end
		local point: Vector3
		if followPart then
			point = objectPosition :: Vector3
		else
			point = (followRoot :: BasePart).Position
		end
		local initialAura = AreaGrowth.area(d.Aura, AreaGrowth.scale(d.Aura, 0))
		local marker = Presentation.areaMarker(
			"MagicAuraDebug",
			CFrame.new(point) * CFrame.Angles(0, math.rad(d.Aura.Yaw or 0), 0),
			d.Geometry,
			Geometry.areaSize(d.Geometry, initialAura),
			d.Visual.Color,
			nil,
			d
		)
		Presentation.attachLoop(d, "AmbientLoopSoundId", marker)
		local targets = formAreaCandidates(d, state.Character, point, 0)
		local aura = {
			Kind = "Aura",
			Caster = state.Character,
			Player = player,
			Remote = remote,
			Definition = d,
			FollowTarget = followTarget,
			FollowPart = followPart,
			FollowPartOffset = if followPart then followPart.CFrame:PointToObjectSpace(point) else nil,
			Age = 0,
			CurrentPhase = "Active",
			TargetsHit = {},
			PresentTargets = {},
			StartedAt = os.clock(),
			Position = point,
			Direction = Vector3.zero,
			RemainingLifetime = configuredLifetime(d),
			NextInterval = 0,
			Visual = marker,
		}
		registerActiveEffect(aura)
		formContext.RegisterChannel(aura)
		emit(d, "OnCast", state.Character, point, targets, Vector3.zero, remote, player, nil, aura)
		emit(d, "OnSpawn", state.Character, point, targets, Vector3.zero, remote, player, nil, aura)
	end
	formContext.ExecuteBeam = function(d)
		local objectTarget = if d.Targeting == "ObjectTarget"
				and material
				and material:IsA("BasePart")
			then material
			else nil
		if d.Casting.Mode == "Channeled" then
			local beam = AreaGrowth.area(d.Beam, AreaGrowth.scale(d.Beam, 0))
			local beamRange = math.min(beam.Range, d.TargetRules.Range)
			local channel = {
				Kind = "BeamChannel",
				SpellId = d.SpellId,
				Caster = state.Character,
				Age = 0,
				CurrentPhase = "Channeling",
				TargetsHit = {},
				StartedAt = workspace:GetServerTimeNow(),
				RemainingLifetime = d.Lifetime.Duration,
				NextInterval = 0,
				Definition = d,
				ObjectTarget = objectTarget,
				Position = origin,
				Direction = direction,
				Player = player,
				Remote = remote,
				Visual = nil,
				IsChannel = true,
			}
			channel.AmbientSound = Presentation.attachLoop(d, "AmbientLoopSoundId", state.Root)
			local hit = sweep(origin, direction * beamRange, state.Character, nil, beam.Width / 2)
			local endpoint = hit and (origin + direction * hit.Distance) or origin + direction * beamRange
			Presentation.beam(origin, endpoint, beam.Width, d.Visual.Color, d.Beam.DebugDuration, d)
			local targetHit = if hit and hit.Instance == objectTarget
				then objectTargetHit(
					state.Character,
					origin,
					direction,
					math.min(objectTargetRange(d), beamRange),
					objectTarget,
					d
				)
				else nil
			channel.AllowObjectTarget = targetHit ~= nil
			channel.HitPart = if not objectTarget and hit then hit.Instance else nil
			emit(
				d,
				"OnCast",
				state.Character,
				origin,
				if objectTarget then if targetHit then { objectTarget } else {} else targetFrom(hit),
				direction,
				remote,
				player,
				nil,
				channel
			)
			if hit then
				emit(
					d,
					"OnImpact",
					state.Character,
					endpoint,
					if objectTarget then if targetHit then { objectTarget } else {} else targetFrom(hit),
					direction,
					remote,
					player,
					nil,
					channel
				)
			end
			channel.HitPart = nil
			channel.AllowObjectTarget = nil
			stats.Channel = channel
			registerActiveEffect(channel)
			return
		end
		local beam = AreaGrowth.area(d.Beam, AreaGrowth.scale(d.Beam, 0))
		local beamRange = math.min(beam.Range, d.TargetRules.Range)
		local hit = sweep(origin, direction * beamRange, state.Character, nil, beam.Width / 2)
		local endpoint = hit and (origin + direction * hit.Distance) or origin + direction * beamRange
		if d.Beam.Pattern == "Cascade" then
			if not hasCapacity(player) then
				feedback(remote, player, "IMPOSSIBLE", d, { Reason = "Too many active spells" })
				return
			end
			local eventState = { HitPart = if hit then hit.Instance else nil }
			emit(d, "OnCast", state.Character, origin, targetFrom(hit), direction, remote, player, nil, eventState)
			local cascade = {
				Kind = "BeamCascade",
				SpellId = d.SpellId,
				Caster = state.Character,
				Definition = d,
				Player = player,
				Remote = remote,
				Center = endpoint,
				Position = endpoint,
				Direction = direction,
				Age = 0,
				StrikeIndex = 1,
				NextInterval = workspace:GetServerTimeNow() + d.Beam.StrikeInterval,
				RemainingLifetime = d.Beam.StrikeInterval * (d.Beam.StrikeCount - 1) + 0.25,
				StartedAt = workspace:GetServerTimeNow(),
				TargetsHit = {},
			}
			resolveBeamCascadeStrike(cascade, 1)
			registerActiveEffect(cascade)
			return
		end
		Presentation.beam(origin, endpoint, beam.Width, d.Visual.Color, d.Beam.DebugDuration, d)
		local targetHit = if hit and hit.Instance == objectTarget
			then objectTargetHit(
				state.Character,
				origin,
				direction,
				math.min(objectTargetRange(d), beamRange),
				objectTarget,
				d
			)
			else nil
		local eventState = {
			HitPart = if not objectTarget and hit then hit.Instance else nil,
			AllowObjectTarget = objectTarget ~= nil and targetHit ~= nil,
			ObjectTarget = objectTarget,
		}
		emit(
			d,
			"OnCast",
			state.Character,
			origin,
			if targetHit then { objectTarget } elseif objectTarget then {} else targetFrom(hit),
			direction,
			remote,
			player,
			nil,
			eventState
		)
		-- An instant Beam always resolves at a server-known endpoint. If nothing
		-- obstructs it, that endpoint is the maximum-range end of the visible Beam;
		-- target-dependent payloads still receive an empty target list there.
		emit(
			d,
			"OnImpact",
			state.Character,
			endpoint,
			if targetHit then { objectTarget } elseif objectTarget then {} else targetFrom(hit),
			direction,
			remote,
			player,
			nil,
			eventState
		)
	end
	formContext.ExecuteWave = function(d)
		local waveDirection = if direction.Magnitude > 0.001 then direction.Unit else state.Root.CFrame.LookVector
		local objectTarget = if d.Targeting == "ObjectTarget"
				and material
				and material:IsA("BasePart")
			then material
			else nil
		local function pulse(eventName: string, age: number)
			local wave = AreaGrowth.area(d.Wave, AreaGrowth.scale(d.Wave, age))
			local waveRange = math.min(wave.Range, d.TargetRules.Range)
			local point = state.Root.Position
			local frame = CFrame.lookAt(point, point + waveDirection)
			local objectHit = objectTargetHit(
				state.Character,
				point + Vector3.new(0, 1.5, 0),
				waveDirection,
				math.min(objectTargetRange(d), waveRange),
				objectTarget,
				d
			)
			local targetRules = {
				OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
				RequireLineOfSight = d.TargetRules.RequiresLineOfSight,
				IncludeAttacker = d.TargetRules.IncludeCaster,
			}
			local targets = if objectTarget
				then if objectHit then { objectTarget } else {}
				elseif d.Geometry == "Sphere" then HitDetection.findSphere(
					state.Character,
					frame,
					waveRange,
					targetRules
				)
				else HitDetection.findCone(state.Character, frame, waveRange, d.Wave.Dot, targetRules)
			local eventState = if objectTarget
				then { AllowObjectTarget = objectHit ~= nil, ObjectTarget = objectTarget }
				else nil
			emit(d, eventName, state.Character, point, targets, waveDirection, remote, player, nil, eventState)
			Presentation.marker(
				"MagicWaveDebug",
				if d.Geometry == "Sphere" then point else point - Vector3.new(0, 2.7, 0),
				if d.Geometry == "Sphere"
					then Vector3.one * waveRange * 2
					else Vector3.new(0.15, waveRange * 2, waveRange * 2),
				d.Visual.Color,
				d.Wave.DebugDuration,
				if d.Geometry == "Sphere" then Enum.PartType.Ball else Enum.PartType.Cylinder
			)
			return targets, point
		end
		local _, point = pulse("OnCast", 0)
		if d.Casting.Mode == "Channeled" then
			local channel = {
				Kind = "WaveChannel",
				SpellId = d.SpellId,
				Caster = state.Character,
				Age = 0,
				CurrentPhase = "Channeling",
				TargetsHit = {},
				StartedAt = workspace:GetServerTimeNow(),
				RemainingLifetime = d.Lifetime.Duration,
				NextInterval = d.Wave.Interval or 0.4,
				Definition = d,
				ObjectTarget = objectTarget,
				Position = point,
				Direction = waveDirection,
				Player = player,
				Remote = remote,
				Visual = nil,
				IsChannel = true,
			}
			channel.AmbientSound = Presentation.attachLoop(d, "AmbientLoopSoundId", state.Root)
			stats.Channel = channel
			registerActiveEffect(channel)
		end
	end
	formContext.CreateField = function(d)
		local point = intent.WorldPoint
		local followPart: BasePart? = nil
		local followTargetModel: Model? = nil
		if d.Targeting == "ObjectTarget" then
			if not objectPosition then
				feedback(remote, player, "IMPOSSIBLE", d, { Reason = "Selected surface is no longer available" })
				return
			end
			point = objectPosition
			if d.Field.FollowTarget and material and material:IsA("BasePart") then
				followPart = material
			end
		end
		if d.Targeting == "EntityTarget" and selectedTarget then
			local targetRoot = selectedTarget:FindFirstChild("HumanoidRootPart")
			if not targetRoot or not targetRoot:IsA("BasePart") then
				feedback(remote, player, "IMPOSSIBLE", d, { Reason = "Field target is no longer available" })
				return
			end
			point = targetRoot.Position
			if d.Field.FollowTarget then
				followTargetModel = selectedTarget
			end
		end
		if d.Field.FollowTarget and not followPart and not followTargetModel then
			feedback(remote, player, "IMPOSSIBLE", d, { Reason = "Field follow target is no longer available" })
			return
		end
		local initialField = AreaGrowth.area(d.Field, AreaGrowth.scale(d.Field, 0))
		local marker = Presentation.areaMarker(
			"MagicFieldDebug",
			CFrame.new(point) * CFrame.Angles(0, math.rad(d.Field.Yaw or 0), 0),
			d.Geometry,
			Geometry.areaSize(d.Geometry, initialField),
			d.Visual.Color,
			d.Field.DebugHeight,
			d
		)
		Presentation.attachLoop(d, "AmbientLoopSoundId", marker)
		local targets = formAreaCandidates(d, state.Character, point, 0)
		local field = {
			Kind = "Field",
			Caster = state.Character,
			Player = player,
			Remote = remote,
			Definition = d,
			FollowTarget = d.Field.FollowTarget == true,
			FollowTargetModel = followTargetModel,
			FollowPart = followPart,
			FollowPartOffset = if followPart then followPart.CFrame:PointToObjectSpace(point) else nil,
			Age = 0,
			CurrentPhase = "Active",
			TargetsHit = {},
			PresentTargets = {},
			StartedAt = os.clock(),
			Position = point,
			Direction = direction,
			RemainingLifetime = configuredLifetime(d),
			NextInterval = 0,
			Visual = marker,
		}
		registerActiveEffect(field)
		formContext.RegisterChannel(field)
		emit(d, "OnCast", state.Character, point, targets, direction, remote, player, nil, field)
		emit(d, "OnSpawn", state.Character, point, targets, direction, remote, player, nil, field)
	end
	formContext.RegisterChannel = function(spell)
		if CastingSpec.isHeldMode(d.Casting.Mode) then
			spell.SpellId = d.SpellId
			spell.IsChannel = true
			stats.Channel = spell
		end
	end
	formContext.ApplySelf = function(d)
		local ctx = context(d, state.Character, state.Root.Position, { state.Humanoid }, direction, remote, player)
		local combined = { WalkSpeedBonus = 0, JumpPowerBonus = 0, SpeedMultiplier = 1, AerialSpeed = 0 }
		ctx.ApplyEnhancement = function(payload)
			combined.WalkSpeedBonus += payload.WalkSpeedBonus or 0
			combined.JumpPowerBonus += payload.JumpPowerBonus or 0
			combined.SpeedMultiplier = math.max(combined.SpeedMultiplier, payload.SpeedMultiplier or 1)
		end
		ctx.ApplyAerialMovement = function(payload)
			combined.AerialSpeed = math.max(combined.AerialSpeed, payload.Speed or 0)
		end
		Triggers.execute(d, "OnCast", ctx)
		enhancements[player] = enhancements[player] or {}
		enhancements[player][d.SpellId] = {
			State = state,
			Definition = d,
			Remote = remote,
			Direction = direction,
			Age = 0,
			CurrentPhase = "Active",
			TargetsHit = {},
			StartedAt = os.clock(),
			ExpiresAt = if d.Lifetime.Mode == "UntilToggledOff"
					or d.Lifetime.Mode == "UntilResourceDepleted"
					or d.Lifetime.Mode == "UntilConditionFails"
				then math.huge
				else workspace:GetServerTimeNow() + d.Lifetime.Duration,
			WalkSpeedBonus = combined.WalkSpeedBonus,
			JumpPowerBonus = combined.JumpPowerBonus,
			SpeedMultiplier = combined.SpeedMultiplier,
			AerialSpeed = combined.AerialSpeed,
			ProximityState = if d.Proximity then ProximitySpec.newState(workspace:GetServerTimeNow()) else nil,
			IsChannel = d.Casting.Mode == "Channeled",
			AmbientSound = Presentation.attachLoop(d, "AmbientLoopSoundId", state.Root),
		}
		updateEnhancement(player)
		if d.Casting.Mode == "Channeled" then
			local channel = {
				Kind = "SelfEnhancementChannel",
				SpellId = d.SpellId,
				Caster = state.Character,
				State = state,
				Player = player,
				Remote = remote,
				Definition = d,
				Age = 0,
				CurrentPhase = "Channeling",
				TargetsHit = {},
				StartedAt = workspace:GetServerTimeNow(),
				RemainingLifetime = d.Lifetime.Duration,
				Position = state.Root.Position,
				Direction = direction,
				Visual = nil,
				IsChannel = true,
			}
			channel.AmbientSound = enhancements[player][d.SpellId].AmbientSound
			stats.Channel = channel
			registerActiveEffect(channel)
		end
	end
	formContext.ApplyManipulation = function(d)
		local target = if material and material:IsA("BasePart") then material else nil
		local ctx = context(
			d,
			state.Character,
			origin,
			if target then { target } else {},
			direction,
			remote,
			player,
			nil,
			{ AllowObjectTarget = target ~= nil, ObjectTarget = target }
		)
		Triggers.execute(d, "OnCast", ctx)
	end
	formContext.CreateProjectile = function(d)
		-- Begin at the server-known origin so a large projectile cannot skip a nearby wall.
		local start = origin
		if castContext and validVector(intent.WorldPoint) then
			local delta = intent.WorldPoint - start
			if delta.Magnitude > 0.001 then
				direction = delta.Unit
			end
		end
		local targetRoot = selectedTarget and selectedTarget:FindFirstChild("HumanoidRootPart")
		emit(d, "OnCast", state.Character, start, {}, direction, remote, player)
		emit(d, "OnSpawn", state.Character, start, {}, direction, remote, player)
		local projectile = {
			Kind = "Projectile",
			SpellId = d.SpellId,
			Caster = state.Character,
			Age = 0,
			CurrentPhase = "Traveling",
			TargetsHit = {},
			StartedAt = os.clock(),
			RemainingLifetime = configuredLifetime(d),
			Definition = d,
			Position = start,
			Direction = direction,
			Velocity = direction * d.Projectile.Speed,
			Distance = 0,
			HomingTarget = if d.TargetPolicy == "MaintainTarget"
					and targetRoot
					and targetRoot:IsA("BasePart")
				then targetRoot
				else nil,
			FixedTarget = d.TargetPolicy == "MaintainTarget",
			Visual = Presentation.projectile(d, start),
			Player = player,
			Remote = remote,
			ObjectTarget = if d.Targeting == "ObjectTarget"
					and material
					and material:IsA("BasePart")
				then material
				else nil,
			CommandCastId = commandCastId,
		}
		initializeProjectileMotion(projectile, d)
		registerActiveEffect(projectile)
		if d.Casting.Mode == "Channeled" then
			local channel = {
				Kind = "ProjectileChannel",
				SpellId = d.SpellId,
				Caster = state.Character,
				Age = 0,
				CurrentPhase = "Channeling",
				TargetsHit = {},
				StartedAt = workspace:GetServerTimeNow(),
				RemainingLifetime = d.Lifetime.Duration,
				NextInterval = d.Projectile.ChannelInterval or 0.4,
				Definition = d,
				Position = start,
				Direction = direction,
				TargetModel = selectedTarget,
				ObjectTarget = if d.Targeting == "ObjectTarget"
						and material
						and material:IsA("BasePart")
					then material
					else nil,
				Player = player,
				Remote = remote,
				Visual = nil,
				IsChannel = true,
			}
			channel.AmbientSound = Presentation.attachLoop(d, "AmbientLoopSoundId", state.Root)
			stats.Channel = channel
			registerActiveEffect(channel)
		end
		ProjectileBehaviors.spawn(projectile, projectileBehaviorContext(projectile))
	end
	Forms.execute(definition.Form, definition, formContext)
	if CastingSpec.isHeldMode(definition.Casting.Mode) then
		local channel = stats.Channel
		if channel and channel.Caster == state.Character and channel.SpellId == definition.SpellId then
			Presentation.sustain(state.Character, definition)
		end
	end
	Discovery.recordCast(player, definition)
	syncLocusProgression(player)
end
local function castNow(player, state, intent, remote, definition, charge, castContext)
	local result, reason, material, direction, selectedTarget, objectPosition =
		validate(player, state, intent, definition, charge)
	if result == "IMPOSSIBLE" or not direction then
		setCastingMovement(player, state, nil)
		local stats = playerData[player]
		feedback(remote, player, "IMPOSSIBLE", definition, {
			Reason = reason,
			Mana = stats and stats.Mana,
			Capacity = stats and stats.Capacity,
			Strain = stats and stats.Strain,
			StrainTolerance = stats and stats.StrainTolerance,
			ComplexityCapacity = stats and stats.ComplexityCapacity,
		})
		return
	end
	execute(
		player,
		state,
		remote,
		definition,
		intent,
		charge,
		material,
		direction,
		result,
		reason,
		castContext,
		selectedTarget,
		objectPosition
	)
	local stats = playerData[player]
	if not stats or not stats.Channel then
		setCastingMovement(player, state, nil)
	end
end
local function queueCast(player, state, intent, remote, definition, charge, castContext, startPosition: Vector3?)
	local result, reason, _, validatedDirection = validate(player, state, intent, definition, charge)
	if result == "IMPOSSIBLE" then
		setCastingMovement(player, state, nil)
		local stats = playerData[player]
		feedback(remote, player, result, definition, {
			Reason = reason,
			Mana = stats and stats.Mana,
			Capacity = stats and stats.Capacity,
			Strain = stats and stats.Strain,
			StrainTolerance = stats and stats.StrainTolerance,
			ComplexityCapacity = stats and stats.ComplexityCapacity,
		})
		return false, reason
	end
	local timing = Presentation.timing(definition)
	local now = workspace:GetServerTimeNow()
	local windup = definition.Casting.CastTime + timing.Gather
	local releaseAt = now + windup
	local impactAt = releaseAt + timing.Release
	local pendingIntent = Spec.copy(intent)
	if CastingSpec.rotationLocked(definition.Casting) and validatedDirection then
		pendingIntent.AimDirection = validatedDirection
	end
	Presentation.gather(state.Character, definition, windup + timing.Release + timing.Recovery, windup)
	playerData[player].Pending = {
		At = impactAt,
		ReleaseAt = releaseAt,
		Released = false,
		State = state,
		Intent = pendingIntent,
		Remote = remote,
		Definition = definition,
		Charge = charge,
		Context = castContext,
		StartPosition = startPosition or state.Root.Position,
	}
	setCastingMovement(player, state, definition, validatedDirection)
	feedback(remote, player, "CHARGING", definition, { Reason = "Gathering · server-timed release" })
	return true, nil
end

local function movementInterrupted(windup): boolean
	local root = windup.State.Root
	return root.Parent ~= nil
		and CastInterruption.movement(windup.Definition.Casting, (root.Position - windup.StartPosition).Magnitude)
end

function Magic.start(player, state, intent, remote, castContext, temporaryDefinition): (boolean, string?)
	local definition = temporaryDefinition or getDefinition(intent.SpellId)
	local stats = playerData[player]
	if not definition or not stats then
		feedback(remote, player, "IMPOSSIBLE", nil, { Reason = "Unknown spell" })
		return false, "Unknown spell or unavailable Locus resources"
	end
	if stats.PersistentConstructCastInProgress then
		local reason = "A Persistent Construct save is already in progress"
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = reason })
		return false, reason
	end
	if definition.Casting.Mode == "CommandCast" and (not castContext or castContext.CommandCast ~= true) then
		feedback(remote, player, "IMPOSSIBLE", definition, {
			Reason = "CommandCast spells must be assigned to a summon and activated with Attack or Support",
		})
		return false, "CommandCast requires an owner-issued summon order"
	end
	if stats.ResourceProfileReady == false then
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = "Locus resources are still loading" })
		return false, "Locus resources are still loading"
	end
	local effects = enhancements[player]
	if definition.Lifetime.Mode == "UntilToggledOff" then
		if definition.Form == "SelfEnhancement" and effects and effects[definition.SpellId] then
			local effect = effects[definition.SpellId]
			expireSelfEnhancement(player, effect)
			Presentation.stopSound(effect.AmbientSound)
			effects[definition.SpellId] = nil
			updateEnhancement(player, state)
			feedback(remote, player, "OFF", definition, nil)
			return true
		elseif stopToggledEffect(player, state.Character, definition) then
			feedback(remote, player, "OFF", definition, nil)
			return true
		end
	end
	local now = workspace:GetServerTimeNow()
	if stats.Pending or stats.Channel or isSpellCooling(stats, definition.SpellId, now) then
		local reason = if stats.Pending
			then "Owner is already completing another cast"
			elseif stats.Channel then "Owner has another active channel"
			else "Spell is cooling down"
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = reason })
		return false, reason
	end
	if CastingSpec.isChargeMode(definition.Casting.Mode) then
		if stats.Charge then
			return false, "Owner is already charging another spell"
		end
		local chargeResult, chargeReason, _, chargeDirection = validate(player, state, intent, definition, 0)
		if chargeResult == "IMPOSSIBLE" or not chargeDirection then
			feedback(remote, player, "IMPOSSIBLE", definition, { Reason = chargeReason })
			return false, chargeReason
		end
		local chargeIntent = Spec.copy(intent)
		chargeIntent.AimDirection = chargeDirection
		stats.Charge = {
			SpellId = definition.SpellId,
			Definition = definition,
			Character = state.Character,
			BeganAt = now,
			State = state,
			Intent = chargeIntent,
			AimDirection = chargeDirection,
			Remote = remote,
			Context = castContext,
			StartPosition = state.Root.Position,
		}
		Presentation.gather(
			state.Character,
			definition,
			definition.Casting.MaximumCharge,
			definition.Casting.MaximumCharge,
			"Charge"
		)
		feedback(remote, player, "CHARGING", definition, nil)
		setCastingMovement(player, state, definition, chargeDirection)
		return true
	end
	return queueCast(player, state, intent, remote, definition, 0, castContext)
end

local function expireConstruct(spell)
	local target = spell.AttachedHumanoid
	local targets = if target and target.Health > 0 and target.Parent then { target } else {}
	emitExpiry(spell, spell.Position or spell.Caster:GetPivot().Position, targets, nil)
end

local function finalChannelTargets(channel)
	local definition = channel.Definition
	channel.HitPart = nil
	local humanoid = channel.Caster:FindFirstChildOfClass("Humanoid")
	local root = channel.Caster:FindFirstChild("HumanoidRootPart")
	if
		not humanoid
		or humanoid.Health <= 0
		or not root
		or not root:IsA("BasePart")
		or not root:IsDescendantOf(workspace)
	then
		return channel.Position, {}
	end
	channel.AllowObjectTarget = false
	if channel.Kind == "BeamChannel" then
		local beam = AreaGrowth.area(definition.Beam, AreaGrowth.scale(definition.Beam, channel.Age))
		local range = math.min(beam.Range, definition.TargetRules.Range)
		local origin = Presentation.handOrigin(channel.Caster, root.Position + Vector3.new(0, 1.5, 0))
		local hit = sweep(origin, channel.Direction * range, channel.Caster, nil, beam.Width / 2)
		local objectHit = if hit and hit.Instance == channel.ObjectTarget
			then objectTargetHit(
				channel.Caster,
				origin,
				channel.Direction,
				math.min(objectTargetRange(definition), range),
				channel.ObjectTarget,
				definition
			)
			else nil
		channel.AllowObjectTarget = objectHit ~= nil
		channel.HitPart = if not channel.ObjectTarget and hit then hit.Instance else nil
		channel.Position = origin
		return origin,
			if channel.ObjectTarget then if objectHit then { channel.ObjectTarget } else {} else targetFrom(hit)
	elseif channel.Kind == "WaveChannel" then
		local wave = AreaGrowth.area(definition.Wave, AreaGrowth.scale(definition.Wave, channel.Age))
		local range = math.min(wave.Range, definition.TargetRules.Range)
		local position = root.Position
		local objectHit = objectTargetHit(
			channel.Caster,
			position + Vector3.new(0, 1.5, 0),
			channel.Direction,
			math.min(objectTargetRange(definition), range),
			channel.ObjectTarget,
			definition
		)
		if channel.ObjectTarget then
			channel.AllowObjectTarget = objectHit ~= nil
			channel.Position = position
			return position, if objectHit then { channel.ObjectTarget } else {}
		end
		local frame = CFrame.lookAt(position, position + channel.Direction)
		local targetRules = {
			OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
			RequireLineOfSight = definition.TargetRules.RequiresLineOfSight,
			IncludeAttacker = definition.TargetRules.IncludeCaster,
		}
		local targets = if definition.Geometry == "Sphere"
			then HitDetection.findSphere(channel.Caster, frame, range, targetRules)
			else HitDetection.findCone(channel.Caster, frame, range, wave.Dot, targetRules)
		channel.Position = position
		return position, targets
	end
	return channel.Position, {}
end

finishBeamChannel = function(channel)
	-- Expiration triggers run after maintenance has ended.
	channel.IsChannel = false
	local definition = channel.Definition
	if channel.Kind == "Field" or channel.Kind == "Aura" then
		local targets = formAreaTargets(channel, channel.Position)
		updateAreaMembership(channel, targets)
		emitExpiry(channel, channel.Position, targets)
		closeAreaMembership(channel)
	elseif channel.Kind == "SelfEnhancementChannel" then
		local effects = enhancements[channel.Player]
		local effect = effects and effects[channel.SpellId]
		if effect then
			expireSelfEnhancement(channel.Player, effect)
		elseif definition then
			emitExpiry(channel, channel.Position, { channel.State.Humanoid })
		end
	elseif channel.Kind == "Construct" then
		expireConstruct(channel)
	elseif definition then
		local position, targets = finalChannelTargets(channel)
		emitExpiry(channel, position, targets)
		channel.AllowObjectTarget = nil
	end
	local stats = playerData[channel.Player]
	if stats and stats.Channel == channel then
		stats.Channel = nil
	end
	if channel.Kind == "SelfEnhancementChannel" then
		local effects = enhancements[channel.Player]
		if effects and effects[channel.SpellId] then
			effects[channel.SpellId] = nil
			updateEnhancement(channel.Player, channel.State)
		end
	end
	if channel.Visual then
		Presentation.finish(channel.Visual)
	end
	Presentation.cancel(channel.Caster, definition)
	Presentation.stopSound(channel.AmbientSound)
	setCastingMovement(channel.Player, channel.State, nil)
end

function Magic.release(player, state, intent, remote)
	local stats = playerData[player]
	local spellId = intent and intent.SpellId
	local pending = stats and stats.Pending
	if
		pending
		and CastingSpec.isHeldMode(pending.Definition.Casting.Mode)
		and spellId == pending.Definition.SpellId
	then
		setCastingMovement(player, pending.State, nil)
		Presentation.cancel(pending.State.Character, pending.Definition)
		stats.Pending = nil
		return
	end
	local channel = stats and stats.Channel
	if channel and spellId == channel.SpellId then
		for index = #active, 1, -1 do
			if active[index] == channel then
				finishBeamChannel(channel)
				table.remove(active, index)
				break
			end
		end
		feedback(remote, player, "OFF", channel.Definition, nil)
		return
	end
	local charge = stats and stats.Charge
	if not charge or not intent or intent.SpellId ~= charge.SpellId or state.Character ~= charge.Character then
		return
	end
	stats.Charge = nil
	local definition = charge.Definition
	if not definition then
		setCastingMovement(player, charge.State, nil)
		return
	end
	local elapsed = math.clamp(workspace:GetServerTimeNow() - charge.BeganAt, 0, definition.Casting.MaximumCharge)
	if elapsed < definition.Casting.MinimumCharge then
		setCastingMovement(player, state, nil)
		Presentation.cancel(state.Character, definition)
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = "Charge was released too early" })
		return
	end
	local releaseIntent = if CastingSpec.rotationLocked(definition.Casting) then charge.Intent else intent
	queueCast(player, state, releaseIntent, remote, definition, elapsed, nil, charge.StartPosition)
end

function Magic.updateAim(player, state, intent): boolean
	local stats = playerData[player]
	local channel = stats and stats.Channel
	local direction = intent and intent.AimDirection
	local expectedKind = if channel
			and channel.Definition
			and channel.Definition.Form == "Projectile"
		then "ProjectileChannel"
		else "BeamChannel"
	if
		not intent
		or not state
		or state.MagicRotationLocked == true
		or not channel
		or not channel.IsChannel
		or channel.Kind ~= expectedKind
		or channel.Player ~= player
		or channel.Caster ~= state.Character
		or channel.SpellId ~= intent.SpellId
		or not channel.Definition
		or CastingSpec.rotationLocked(channel.Definition.Casting)
		or not CastingSpec.supportsAimUpdate(channel.Definition.Form, channel.Definition.Casting.Mode)
		or not validVector(direction)
	then
		return false
	end
	local magnitude = direction.Magnitude
	if magnitude < 0.9 or magnitude > 1.1 then
		return false
	end
	channel.Direction = direction.Unit
	return true
end

function Magic.clearTemporary(player, state, spellId)
	local stats = playerData[player]
	if stats and stats.Pending and stats.Pending.Definition.SpellId == spellId then
		local pending = stats.Pending
		stats.Pending = nil
		setCastingMovement(player, pending.State, nil)
		Presentation.cancel(pending.State.Character, pending.Definition)
	end
	if stats and stats.Charge and stats.Charge.Definition.SpellId == spellId then
		local charge = stats.Charge
		stats.Charge = nil
		setCastingMovement(player, charge.State, nil)
		Presentation.cancel(charge.State.Character, charge.Definition)
	end
	for index = #active, 1, -1 do
		local spell = active[index]
		if spell.Player ~= player or spell.SpellId ~= spellId then
			continue
		end
		local lifetimeMode = spell.Definition.Lifetime.Mode
		if spell.IsChannel then
			finishBeamChannel(spell)
		elseif
			(spell.Kind == "Field" or spell.Kind == "Aura" or spell.Kind == "Construct")
			and lifetimeMode ~= "FixedDuration"
		then
			if spell.Kind == "Field" or spell.Kind == "Aura" then
				finishInterruptedArea(spell)
			else
				expireConstruct(spell)
				Presentation.finish(spell.Visual)
			end
		else
			continue
		end
		if spell.LingerVisual then
			Presentation.finish(spell.LingerVisual)
		end
		table.remove(active, index)
	end
	local playerEnhancements = enhancements[player]
	local effect = playerEnhancements and playerEnhancements[spellId]
	if effect then
		expireSelfEnhancement(player, effect)
		Presentation.stopSound(effect.AmbientSound)
		playerEnhancements[spellId] = nil
		updateEnhancement(player, state or effect.State)
	end
	-- Expiry triggers can create summons, so dismiss after all old-definition
	-- callbacks have run.
	Summons.clearSpell(player, spellId)
end

local function summonSpellProfile(definition): (any?, string?)
	if not definition then
		return nil, "No spell assigned"
	end
	local profile, reason = CompanionSpellPolicy.classify(definition)
	if not profile then
		return nil, reason
	end
	if definition.Conditions.Operator then
		local function containsForbidden(node)
			if node.Operator == "ALL" or node.Operator == "ANY" or node.Operator == "NOT" then
				for _, child in ipairs(node.Conditions) do
					if containsForbidden(child) then
						return true
					end
				end
				return false
			end
			return (node.Family == "Caster" or node.Family == "Environment") and node.Property == "OnGround"
				or node.Family == "Relationship" and node.Property == "IsSelf"
		end
		if containsForbidden(definition.Conditions) then
			return nil, "Companion spells cannot depend on caster-grounded or self-target conditions"
		end
	else
		for _, condition in ipairs(definition.Conditions) do
			if condition == "OnGround" or condition == "TargetIsSelf" then
				return nil, "Companion spells cannot depend on caster-grounded or self-target conditions"
			end
		end
	end
	return profile, nil
end

local function isHostileSummonTarget(target: Model): boolean
	return CollectionService:HasTag(target, "Enfleshed") or CollectionService:HasTag(target, "MagicHostileTarget")
end

function Magic.setCompanionSpell(player: Player, slot: number, definition: any)
	companionSpells[player] = companionSpells[player] or {}
	companionSpells[player][slot] = Spec.copy(definition)
end

function Magic.getCompanionSpellProfile(player: Player, slot: number): (any?, string?)
	return summonSpellProfile(companionSpells[player] and companionSpells[player][slot])
end

function Magic.executeSummonCommand(
	player: Player,
	caster: Model,
	definition: any,
	remote: RemoteEvent,
	direction: Vector3,
	potency: number,
	command: string,
	targets: { Humanoid }
)
	if
		player.Character ~= caster
		or not hasEvent(definition, "OnCommand")
		or not table.find(Spec.Schema.CommandOrder, command)
	then
		return
	end
	local root = caster:FindFirstChild("HumanoidRootPart")
	local humanoid = caster:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return
	end
	emit(definition, "OnCommand", caster, root.Position, targets, direction, remote, player, potency, {
		Age = 0,
		CurrentPhase = "Command",
		TargetsHit = {},
		StartedAt = workspace:GetServerTimeNow(),
		EventDepth = 0,
		EventName = "OnCommand",
		Command = command,
	})
end

function Magic.castSummonSpell(
	player: Player,
	caster: Model,
	slot: number,
	summonId: number,
	target: Model,
	remote: RemoteEvent
): (boolean, number, boolean, string?, number?)
	local definition = companionSpells[player] and companionSpells[player][slot]
	local profile, profileReason
	if definition then
		profile, profileReason = summonSpellProfile(definition)
	else
		profileReason = "No spell assigned"
	end
	if not definition or not profile then
		return false, 0, false, profileReason or "Assigned spell is not valid for companions"
	end
	if caster:GetAttribute("MagicSummonOwnerUserId") ~= player.UserId then
		return false, 0, false, "Summon belongs to another player"
	end
	if profile.Mode == "Hostile" and not isHostileSummonTarget(target) then
		return false, 0, false, "Target is not hostile"
	end
	if profile.Mode == "Ally" and not Conditions.relationshipMatches(caster, target, "Ally") then
		return false, 0, false, "Target is not an ally"
	end
	local humanoid = caster:FindFirstChildOfClass("Humanoid")
	local root = caster:FindFirstChild("HumanoidRootPart")
	local targetHumanoid = target:FindFirstChildOfClass("Humanoid")
	local targetRoot = target:FindFirstChild("HumanoidRootPart")
	if
		not humanoid
		or humanoid.Health <= 0
		or not root
		or not root:IsA("BasePart")
		or not targetHumanoid
		or targetHumanoid.Health <= 0
		or not targetRoot
		or not targetRoot:IsA("BasePart")
	then
		return false, 0, false, "Summon or target is no longer alive"
	end
	local stats = playerData[player]
	local spellId = string.format("Summon_%d_Slot_%d", summonId, slot)
	local cooldown = math.max(definition.Casting.Cooldown, definition.Casting.RecoveryTime, 0.2)
	if not stats then
		return false, cooldown, true, "Owner Locus resources are unavailable"
	end
	if stats.Pending then
		return false, cooldown, true, "Owner is already completing another cast"
	end
	if stats.Channel then
		return false, cooldown, true, "Owner has another active channel"
	end
	if
		CompanionSpellPolicy.requiresCommandSlot(definition)
		and not CommandSpec.canStartActiveCommand(active, player, SummonConfiguration.MaxActiveCommands)
	then
		return false, cooldown, true, "Owner already has an active CommandCast spell"
	end
	local now = workspace:GetServerTimeNow()
	if isSpellCooling(stats, spellId, now) then
		return false, cooldown, true, "Companion spell is cooling down"
	end
	local point = targetRoot.Position
	local core = caster:FindFirstChild("WispCore")
	local origin = if core and core:IsA("BasePart") then core.Position else root.Position
	local delta = point - origin
	if delta.Magnitude < 0.001 or delta.Magnitude > definition.TargetRules.Range then
		return false, cooldown, true, "Target is outside assigned spell range"
	end
	local summonDefinition = CompanionSpellPolicy.executionDefinition(Spec.copy(definition), spellId)
	local state: State = { Character = caster, Humanoid = humanoid, Root = root }
	local commandId: number? = nil
	if CompanionSpellPolicy.requiresCommandSlot(definition) then
		nextCommandCastId += 1
		commandId = nextCommandCastId
	end
	local intent = {
		SpellId = spellId,
		-- Companions have no camera input. Their server-selected target supplies both
		-- the aim vector and world point used by the ordinary Form executor.
		AimDirection = delta.Unit,
		WorldPoint = point,
		TargetModel = target,
		CastOrigin = origin,
	}
	local started, reason = Magic.start(player, state, intent, remote, {
		Origin = origin,
		CommandCast = definition.Casting.Mode == "CommandCast",
		CommandId = commandId,
	}, summonDefinition)
	local timing = Presentation.timing(definition)
	local castDuration = CompanionSpellPolicy.castLockDuration(definition, timing.Gather, timing.Release)
	return started == true, cooldown, true, reason, if started then castDuration else nil
end

local function clearActive(player)
	for i = #active, 1, -1 do
		if active[i].Player == player then
			if active[i].IsChannel then
				finishBeamChannel(active[i])
			elseif active[i].Kind == "Field" or active[i].Kind == "Aura" then
				finishInterruptedArea(active[i])
			elseif active[i].Kind == "ProjectileLinger" then
				local spell = active[i]
				expireProjectile(spell)
				Presentation.finish(spell.Visual)
			elseif active[i].Kind == "Projectile" then
				local spell = active[i]
				expireProjectile(spell)
				Presentation.finish(spell.Visual)
			elseif active[i].Kind == "Construct" then
				local spell = active[i]
				expireConstruct(spell)
				Presentation.finish(spell.Visual)
			elseif active[i].Visual then
				Presentation.finish(active[i].Visual)
			end
			if active[i].LingerVisual then
				Presentation.finish(active[i].LingerVisual)
			end
			table.remove(active, i)
		end
	end
end

local function locusProfileKey(player: Player): string
	return "u:" .. tostring(player.UserId)
end

local function saveLocusProfile(player: Player): boolean
	local state = playerData[player]
	if not state or not resourceDirty[player] then
		return true
	end
	if not LocusPersistence.Enabled or not locusStoreAvailable or not locusStore or not resourceWritable[player] then
		return false
	end
	local snapshot = LocusProfileCodec.encode(state, LocusPersistence.MaxPersistedStrain, SpecialResourceDefinitions)
	if not snapshot then
		resourceWritable[player] = false
		warn("Magic: invalid Locus state was not persisted")
		return false
	end
	local manaSnapshot, strainSnapshot = snapshot.Mana, snapshot.Strain
	local rejectedExistingProfile = false
	local ok, result = pcall(function()
		return locusStore:UpdateAsync(locusProfileKey(player), function(existing)
			rejectedExistingProfile = false
			if existing ~= nil then
				local _, safe = LocusProfileCodec.decode(
					existing,
					Sandbox.Magic.SandboxResources.StartingMana,
					LocusProfile.Capacity,
					LocusPersistence.MaxPersistedStrain,
					SpecialResourceDefinitions
				)
				if not safe then
					rejectedExistingProfile = true
					return nil
				end
			end
			return snapshot
		end)
	end)
	if not ok then
		warn("Magic: Locus profile save failed; server session remains active")
		return false
	end
	if rejectedExistingProfile or result == nil then
		resourceWritable[player] = false
		warn("Magic: unsafe existing Locus profile was left untouched")
		return false
	end
	local specialValuesMatch = true
	for id, value in pairs(snapshot.SpecialResources) do
		if state.SpecialResources[id] ~= value then
			specialValuesMatch = false
			break
		end
	end
	if state.Mana == manaSnapshot and state.Strain == strainSnapshot and specialValuesMatch then
		resourceDirty[player] = nil
	end
	return true
end

queueResourceSave = function(player: Player)
	if not LocusPersistence.Enabled or not locusStoreAvailable or not locusStore or not resourceWritable[player] then
		return
	end
	resourceDirty[player] = true
	if resourceSaveScheduled[player] then
		return
	end
	resourceSaveScheduled[player] = true
	task.delay(LocusPersistence.SaveInterval, function()
		resourceSaveScheduled[player] = nil
		if player.Parent ~= Players or not resourceDirty[player] then
			return
		end
		saveLocusProfile(player)
		if resourceDirty[player] and resourceWritable[player] then
			queueResourceSave(player)
		end
	end)
end

local function loadLocusProfile(player: Player)
	local startingMana = Sandbox.Magic.SandboxResources.StartingMana
	if not LocusPersistence.Enabled or not locusStoreAvailable or not locusStore then
		resourceWritable[player] = false
		return {
			Mana = startingMana,
			Strain = 0,
			SpecialResources = SpecialResourceSpec.defaults(SpecialResourceDefinitions),
		}
	end
	local ok, raw = pcall(function()
		return locusStore:GetAsync(locusProfileKey(player))
	end)
	if not ok then
		resourceWritable[player] = false
		warn("Magic: Locus profile could not load; using canonical starting resources for this session")
		return {
			Mana = startingMana,
			Strain = 0,
			SpecialResources = SpecialResourceSpec.defaults(SpecialResourceDefinitions),
		}
	end
	local maximumProfile = LocusProgression.maximumProfile(LocusProfile, LocusConfiguration.Progression)
	local resources, safe = LocusProfileCodec.decode(
		raw,
		startingMana,
		maximumProfile.Capacity,
		LocusPersistence.MaxPersistedStrain,
		SpecialResourceDefinitions
	)
	resourceWritable[player] = safe
	if not safe then
		warn("Magic: unsafe Locus profile was left untouched; using canonical starting resources for this session")
	end
	return resources
end

function Magic.bind(player)
	if playerData[player] then
		return
	end
	local canLoad = LocusPersistence.Enabled and locusStoreAvailable and locusStore ~= nil
	resourceWritable[player] = false
	resourceProfileLoaded[player] = not canLoad
	local startingMana = Sandbox.Magic.SandboxResources.StartingMana
	local state = LocusModel.newState(LocusProfile, startingMana)
	state.SpecialResources = SpecialResourceSpec.defaults(SpecialResourceDefinitions)
	state.Strain = 0
	state.ResourceProfileReady = not canLoad
	state.Ready = {}
	playerData[player] = state
	syncSpecialResourceAttributes(player)
	progressionConnections[player] = player:GetAttributeChangedSignal("MagicDiscoveryLoaded"):Connect(function()
		syncLocusProgression(player)
	end)
	syncLocusProgression(player)
	if canLoad then
		task.spawn(function()
			local resources = loadLocusProfile(player)
			local current = playerData[player]
			if not current or player.Parent ~= Players or resourceProfileLoaded[player] then
				resourceWritable[player] = nil
				resourceProfileLoaded[player] = nil
				return
			end
			current.Mana = resources.Mana
			current.Strain = resources.Strain
			current.SpecialResources =
				SpecialResourceSpec.mergeCurrent(resources.SpecialResources, SpecialResourceDefinitions)
			current.ResourceProfileReady = true
			syncSpecialResourceAttributes(player)
			syncLocusProgression(player)
			resourceProfileLoaded[player] = true
		end)
	end
end
function Magic.reset(player)
	clearActive(player)
	for _, effect in enhancements[player] or {} do
		expireSelfEnhancement(player, effect)
		Presentation.stopSound(effect.AmbientSound)
		Movement.setMagicEnhancement(effect.State, 0, 0, 1)
		Movement.setMagicAerial(effect.State, 0)
	end
	enhancements[player] = nil
	-- Active spell and Self Enhancement expiry triggers can contain Summon
	-- payloads, so dismiss groups after every final event has run.
	Summons.clearOwner(player)
	local old = playerData[player]
	if old then
		if old.Charge then
			setCastingMovement(player, old.Charge.State, nil)
			Presentation.cancel(old.Charge.Character, old.Charge.Definition)
		end
		if old.Pending then
			setCastingMovement(player, old.Pending.State, nil)
			Presentation.cancel(old.Pending.State.Character, old.Pending.Definition)
		end
	end
	if old then
		local profile = {
			Capacity = old.Capacity,
			Efficiency = old.Efficiency,
			Potency = old.Potency,
			StrainTolerance = old.StrainTolerance,
			ComplexityCapacity = old.ComplexityCapacity,
		}
		local state = LocusModel.newState(profile, old.Mana)
		state.Strain = old.Strain
		state.SpecialResources = SpecialResourceSpec.mergeCurrent(old.SpecialResources, SpecialResourceDefinitions)
		state.ResourceProfileReady = old.ResourceProfileReady
		state.Ready = {}
		state.ProgressionRank = old.ProgressionRank or 0
		playerData[player] = state
		syncSpecialResourceAttributes(player)
	end
end
-- Explicit development command; does not change normal cast resource rules.
function Magic.restoreTestingResources(player)
	if not game:GetService("RunService"):IsStudio() then
		return false
	end
	local stats = playerData[player]
	if not stats or not stats.ResourceProfileReady then
		return false
	end
	stats.Mana, stats.Strain = stats.Capacity, 0
	for id, definition in pairs(SpecialResourceDefinitions) do
		if type(definition) == "table" and definition.Capacity then
			stats.SpecialResources[id] = definition.Capacity
		end
	end
	syncSpecialResourceAttributes(player)
	return true
end
function Magic.remove(player)
	Magic.reset(player)
	if resourceDirty[player] then
		saveLocusProfile(player)
	end
	playerData[player] = nil
	if progressionConnections[player] then
		progressionConnections[player]:Disconnect()
		progressionConnections[player] = nil
	end
	resourceWritable[player] = nil
	resourceDirty[player] = nil
	resourceSaveScheduled[player] = nil
	resourceProfileLoaded[player] = nil
	companionSpells[player] = nil
end

game:BindToClose(function()
	for player in pairs(playerData) do
		if resourceDirty[player] then
			saveLocusProfile(player)
		end
	end
end)
RunService.Heartbeat:Connect(function(delta)
	local now = workspace:GetServerTimeNow()
	for player, stats in playerData do
		for spellId, cooldown in stats.Ready do
			if type(cooldown) == "number" then
				stats.Ready[spellId] = { Remaining = math.max(0, cooldown - now), Caster = nil }
				cooldown = stats.Ready[spellId]
			end
			if type(cooldown) == "table" then
				local casterHumanoid = cooldown.Caster
				local timeRate = if casterHumanoid and casterHumanoid.Parent
					then StatusEffects.timeRate(casterHumanoid)
					else 1
				cooldown.Remaining = TemporalRate.advance(cooldown.Remaining, delta, timeRate)
				if cooldown.Remaining <= 0 then
					stats.Ready[spellId] = nil
				end
			end
		end
		local manaBefore, strainBefore = stats.Mana, stats.Strain
		LocusModel.advance(
			stats,
			delta,
			Sandbox.Magic.SandboxResources.ManaRegenerationPerSecond,
			Sandbox.Magic.SandboxResources.StrainRecoveryPerSecond
		)
		local specialResourcesChanged =
			SpecialResourceSpec.advance(stats.SpecialResources, SpecialResourceDefinitions, delta)
		if specialResourcesChanged then
			syncSpecialResourceAttributes(player)
		end
		if stats.Mana ~= manaBefore or stats.Strain ~= strainBefore or specialResourcesChanged then
			queueResourceSave(player)
		end
		local charge = stats.Charge
		if charge and movementInterrupted(charge) then
			stats.Charge = nil
			setCastingMovement(player, charge.State, nil)
			Presentation.cancel(charge.State.Character, charge.Definition)
			feedback(charge.Remote, player, "IMPOSSIBLE", charge.Definition, {
				Reason = "Cast interrupted by movement",
			})
			charge = nil
		end
		if
			charge
			and CompanionSpellPolicy.autoReleasesAtFullCharge(
				charge.Definition,
				charge.Context and charge.Context.CommandCast == true
			)
			and now - charge.BeganAt >= charge.Definition.Casting.MaximumCharge
		then
			stats.Charge = nil
			queueCast(
				player,
				charge.State,
				charge.Intent,
				charge.Remote,
				charge.Definition,
				charge.Definition.Casting.MaximumCharge,
				charge.Context,
				charge.StartPosition
			)
		elseif
			charge
			and charge.Definition.Casting.Mode == "HoldAndRelease"
			and now - charge.BeganAt >= charge.Definition.Casting.MaximumCharge + Limits.MaxChargeReadyHoldSeconds
		then
			stats.Charge = nil
			setCastingMovement(player, charge.State, nil)
			Presentation.cancel(charge.State.Character, charge.Definition)
			feedback(charge.Remote, player, "IMPOSSIBLE", charge.Definition, {
				Reason = "Prepared cast expired before release",
			})
		end
		local pending = stats.Pending
		if pending then
			local pendingCaster = pending.State.Character
			local isPlayerCharacter = pendingCaster == player.Character
			local isOwnedSummon = pendingCaster:GetAttribute("MagicSummonOwnerUserId") == player.UserId
				and pendingCaster:IsDescendantOf(workspace)
			if (not isPlayerCharacter and not isOwnedSummon) or pending.State.Humanoid.Health <= 0 then
				stats.Pending = nil
				setCastingMovement(player, pending.State, nil)
				Presentation.cancel(pending.State.Character, pending.Definition)
			elseif movementInterrupted(pending) then
				stats.Pending = nil
				setCastingMovement(player, pending.State, nil)
				Presentation.cancel(pending.State.Character, pending.Definition)
				feedback(pending.Remote, player, "IMPOSSIBLE", pending.Definition, {
					Reason = "Cast interrupted by movement",
				})
			else
				if not pending.Released and now >= pending.ReleaseAt then
					pending.Released = true
					Presentation.release(pending.State.Character, pending.Definition)
				end
				if now >= pending.At then
					stats.Pending = nil
					castNow(
						player,
						pending.State,
						pending.Intent,
						pending.Remote,
						pending.Definition,
						pending.Charge or 0,
						pending.Context
					)
				end
			end
		end
	end
	for i = #active, 1, -1 do
		local spell = active[i]
		local d = spell.Definition
		if spell.AbsorbedBy then
			emitExpiry(spell, spell.Position, {})
			Presentation.finish(spell.Visual)
			if spell.LingerVisual then
				Presentation.finish(spell.LingerVisual)
			end
			table.remove(active, i)
			continue
		end
		local humanoid = spell.Caster:FindFirstChildOfClass("Humanoid")
		local playerCaster = spell.Player.Character == spell.Caster
		local ownedSummon = spell.Caster:GetAttribute("MagicSummonOwnerUserId") == spell.Player.UserId
		if
			(not playerCaster and not ownedSummon)
			or not spell.Caster:IsDescendantOf(workspace)
			or not humanoid
			or humanoid.Health <= 0
		then
			if humanoid and humanoid.Health <= 0 and hasEvent(d, "OnCasterDeath") then
				spell.CurrentPhase = "CasterDeath"
				if spell.Kind == "SelfEnhancementChannel" then
					local effects = enhancements[spell.Player]
					local effect = effects and effects[spell.SpellId]
					if effect then
						effect.CasterDeathEventFired = true
					end
				end
				emit(
					d,
					"OnCasterDeath",
					spell.Caster,
					spell.Position or spell.Caster:GetPivot().Position,
					{ humanoid },
					spell.Direction or Vector3.zero,
					spell.Remote,
					spell.Player,
					nil,
					lifecycleState(spell, "OnCasterDeath", spell.EventDepth or 0)
				)
			end
			if spell.IsChannel then
				finishBeamChannel(spell)
			elseif spell.Kind == "Field" or spell.Kind == "Aura" then
				finishInterruptedArea(spell)
			elseif spell.Kind == "Construct" then
				expireConstruct(spell)
				if spell.Visual then
					Presentation.finish(spell.Visual)
				end
			elseif spell.Kind == "Projectile" or spell.Kind == "ProjectileLinger" then
				expireProjectile(spell)
				if spell.Visual then
					Presentation.finish(spell.Visual)
				end
			elseif spell.Visual then
				Presentation.finish(spell.Visual)
			end
			if spell.LingerVisual then
				Presentation.finish(spell.LingerVisual)
			end
			table.remove(active, i)
			continue
		end
		local step = if spell.Kind == "BeamCascade" then delta else math.min(delta, spell.RemainingLifetime)
		spell.Age += step
		local stats = playerData[spell.Player]
		if d.Casting.RequiresFreeHand and spell.IsChannel and Equipment.freeHandCount(spell.Player) < 1 then
			spell.ResourceEnded = true
			spell.RemainingLifetime = 0
			feedback(spell.Remote, spell.Player, "EXPIRED", d, {
				Reason = "Channel ended · no free hand available",
			})
		end
		local manaRate = d.Casting.ManaUpkeepPerSecond or 0
		local strainRate = d.Casting.StrainPerSecond or 0
		local paid = true
		if manaRate > 0 or strainRate > 0 then
			paid = stats ~= nil and LocusModel.upkeep(stats, manaRate, strainRate, step)
			if stats then
				queueResourceSave(spell.Player)
			end
		end
		-- Exact depletion is also exhaustion even when the final payment was fully covered.
		if not paid or (stats and manaRate > 0 and stats.Mana <= 0) then
			spell.ResourceEnded = true
			spell.RemainingLifetime = 0
			feedback(spell.Remote, spell.Player, "EXPIRED", d, {
				Reason = if stats and stats.Mana <= 0
					then "Active spell ended · mana depleted"
					else "Active spell ended · ongoing Locus resources depleted",
				Mana = stats and stats.Mana,
				Capacity = stats and stats.Capacity,
				Strain = stats and stats.Strain,
				StrainTolerance = stats and stats.StrainTolerance,
			})
		end
		if not spell.ResourceEnded and spell.Kind ~= "BeamCascade" then
			spell.RemainingLifetime -= delta
		end
		if not spell.EndConditionEnded and Conditions.endWhen(d, spell, stats) then
			spell.EndConditionEnded = true
			spell.RemainingLifetime = 0
		end
		if spell.Kind == "SelfEnhancementChannel" then
			if spell.RemainingLifetime <= 0 then
				finishBeamChannel(spell)
				if not spell.ResourceEnded then
					feedback(spell.Remote, spell.Player, "EXPIRED", d, {
						Reason = if not stats or stats.Mana <= 0
							then "Self Enhancement ended · mana depleted"
							else "Self Enhancement channel limit reached",
					})
				end
				table.remove(active, i)
			end
		elseif spell.Kind == "BeamCascade" then
			if not stats or spell.StrikeIndex >= d.Beam.StrikeCount then
				table.remove(active, i)
			elseif now >= spell.NextInterval then
				spell.StrikeIndex += 1
				spell.NextInterval = now + d.Beam.StrikeInterval
				resolveBeamCascadeStrike(spell, spell.StrikeIndex)
				if spell.StrikeIndex >= d.Beam.StrikeCount then
					table.remove(active, i)
				end
			end
		elseif spell.Kind == "BeamChannel" then
			local ended = not stats or stats.Mana <= 0 or spell.RemainingLifetime <= 0
			if not ended and now >= spell.NextInterval then
				spell.NextInterval = now + (d.Beam.Interval or 0.15)
				local root = spell.Caster:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					local beam = AreaGrowth.area(d.Beam, AreaGrowth.scale(d.Beam, spell.Age))
					local beamRange = math.min(beam.Range, d.TargetRules.Range)
					spell.Position = Presentation.handOrigin(spell.Caster, root.Position + Vector3.new(0, 1.5, 0))
					local hit = sweep(spell.Position, spell.Direction * beamRange, spell.Caster, nil, beam.Width / 2)
					local endpoint = hit and (spell.Position + spell.Direction * hit.Distance)
						or spell.Position + spell.Direction * beamRange
					Presentation.beam(
						spell.Position,
						endpoint,
						beam.Width,
						d.Visual.Color,
						math.max(d.Beam.DebugDuration, d.Beam.Interval * 1.5),
						d
					)
					local targetHit = if hit and hit.Instance == spell.ObjectTarget
						then objectTargetHit(
							spell.Caster,
							spell.Position,
							spell.Direction,
							math.min(objectTargetRange(d), beamRange),
							spell.ObjectTarget,
							d
						)
						else nil
					spell.AllowObjectTarget = targetHit ~= nil
					spell.HitPart = if not spell.ObjectTarget and hit then hit.Instance else nil
					emit(
						d,
						"OnTick",
						spell.Caster,
						spell.Position,
						if spell.ObjectTarget then if targetHit then { spell.ObjectTarget } else {} else targetFrom(hit),
						spell.Direction,
						spell.Remote,
						spell.Player,
						nil,
						spell
					)
					if hit then
						emit(
							d,
							"OnImpact",
							spell.Caster,
							endpoint,
							if spell.ObjectTarget
								then if targetHit then { spell.ObjectTarget } else {}
								else targetFrom(hit),
							spell.Direction,
							spell.Remote,
							spell.Player,
							nil,
							spell
						)
					end
					spell.HitPart = nil
					spell.AllowObjectTarget = nil
				else
					ended = true
				end
			end
			if ended then
				finishBeamChannel(spell)
				if not spell.ResourceEnded then
					feedback(spell.Remote, spell.Player, "EXPIRED", d, {
						Reason = if not stats or stats.Mana <= 0
							then "Channel ended · mana depleted"
							else "Channel limit reached",
					})
				end
				table.remove(active, i)
			end
		elseif spell.Kind == "ProjectileChannel" then
			local ended = not stats or stats.Mana <= 0 or spell.RemainingLifetime <= 0
			if not ended and now >= spell.NextInterval then
				spell.NextInterval = now + (d.Projectile.ChannelInterval or 0.4)
				spawnChannelProjectile(spell)
			end
			if ended then
				finishBeamChannel(spell)
				if not spell.ResourceEnded then
					feedback(spell.Remote, spell.Player, "EXPIRED", d, {
						Reason = if not stats or stats.Mana <= 0
							then "Projectile channel ended · mana depleted"
							else "Projectile channel limit reached",
					})
				end
				table.remove(active, i)
			end
		elseif spell.Kind == "WaveChannel" then
			local ended = not stats or stats.Mana <= 0 or spell.RemainingLifetime <= 0
			if not ended and now >= spell.NextInterval then
				spell.NextInterval = now + (d.Wave.Interval or 0.4)
				local root = spell.Caster:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					local wave = AreaGrowth.area(d.Wave, AreaGrowth.scale(d.Wave, spell.Age))
					local waveRange = math.min(wave.Range, d.TargetRules.Range)
					spell.Position = root.Position
					local frame = CFrame.lookAt(spell.Position, spell.Position + spell.Direction)
					local objectHit = objectTargetHit(
						spell.Caster,
						spell.Position + Vector3.new(0, 1.5, 0),
						spell.Direction,
						math.min(objectTargetRange(d), waveRange),
						spell.ObjectTarget,
						d
					)
					local targetRules = {
						OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
						RequireLineOfSight = d.TargetRules.RequiresLineOfSight,
						IncludeAttacker = d.TargetRules.IncludeCaster,
					}
					local targets = if spell.ObjectTarget
						then if objectHit then { spell.ObjectTarget } else {}
						elseif d.Geometry == "Sphere" then HitDetection.findSphere(
							spell.Caster,
							frame,
							waveRange,
							targetRules
						)
						else HitDetection.findCone(spell.Caster, frame, waveRange, d.Wave.Dot, targetRules)
					Presentation.marker(
						"MagicWaveDebug",
						if d.Geometry == "Sphere" then spell.Position else spell.Position - Vector3.new(0, 2.7, 0),
						if d.Geometry == "Sphere"
							then Vector3.one * waveRange * 2
							else Vector3.new(0.15, waveRange * 2, waveRange * 2),
						d.Visual.Color,
						d.Wave.DebugDuration,
						if d.Geometry == "Sphere" then Enum.PartType.Ball else Enum.PartType.Cylinder
					)
					spell.AllowObjectTarget = objectHit ~= nil
					emit(
						d,
						"OnTick",
						spell.Caster,
						spell.Position,
						targets,
						spell.Direction,
						spell.Remote,
						spell.Player,
						nil,
						spell
					)
					spell.AllowObjectTarget = nil
				else
					ended = true
				end
			end
			if ended then
				finishBeamChannel(spell)
				if not spell.ResourceEnded then
					feedback(spell.Remote, spell.Player, "EXPIRED", d, {
						Reason = if not stats or stats.Mana <= 0
							then "Wave channel ended · mana depleted"
							else "Wave channel limit reached",
					})
				end
				table.remove(active, i)
			end
		elseif spell.Kind == "Construct" then
			local attachment = spell.Attachment
			local gone = not spell.Visual:IsDescendantOf(workspace)
				or (attachment ~= nil and not attachment:IsDescendantOf(workspace))
			local dead = spell.AttachedHumanoid and spell.AttachedHumanoid.Health <= 0
			local hasConstructPart = false
			for part in spell.ComponentLifetimes or {} do
				if part.Parent == nil or not part:IsDescendantOf(spell.Visual) then
					spell.ComponentLifetimes[part] = nil
				end
			end
			for _, part in spell.Visual:GetChildren() do
				if part:IsA("BasePart") and string.sub(part.Name, 1, 13) == "ConstructPart" then
					local componentDuration = spell.ComponentLifetimes and spell.ComponentLifetimes[part]
					if componentDuration and spell.Age >= componentDuration then
						if spell.ComponentLifetimes then
							spell.ComponentLifetimes[part] = nil
						end
						part:Destroy()
					else
						hasConstructPart = true
					end
				end
			end
			if not hasConstructPart then
				spell.RemainingLifetime = 0
			end
			if spell.GrowthEnabled and not gone and not dead then
				spell.GrowthCheckAccumulator += step
				if attachment and spell.AttachmentPoint and spell.AttachmentNormal and spell.AttachmentRotation then
					local contactPoint = attachment.CFrame:PointToWorldSpace(spell.AttachmentPoint)
					local normal = attachment.CFrame:VectorToWorldSpace(spell.AttachmentNormal).Unit
					local rotation = attachment.CFrame.Rotation * spell.AttachmentRotation
					spell.GrowthAnchorPoint, spell.GrowthAnchorNormal, spell.GrowthAnchorRotation =
						contactPoint, normal, rotation
				end
				local anchorPoint = spell.GrowthAnchorPoint or spell.AnchorPoint
				local anchorNormal = spell.GrowthAnchorNormal or spell.AnchorNormal
				local anchorRotation = spell.GrowthAnchorRotation or spell.Visual:GetPivot().Rotation
				local function frameForScale(scale)
					local size = spell.BaseSize * scale
					if not anchorPoint or not anchorNormal then
						return CFrame.new(spell.Visual:GetPivot().Position) * anchorRotation, size
					end
					local orientation = CFrame.new(anchorPoint) * anchorRotation
					local offset = Geometry.surfaceOffset(
						anchorNormal,
						orientation.RightVector,
						orientation.UpVector,
						orientation.LookVector,
						size
					)
					local center = anchorPoint + anchorNormal * (offset + 0.03)
					return CFrame.new(center) * anchorRotation, size
				end
				if spell.GrowthCheckAccumulator >= 0.1 then
					spell.GrowthCheckAccumulator %= 0.1
					local growthScale = AreaGrowth.scale(d.Construct, spell.Age)
					local targetFrame, targetSize = frameForScale(growthScale)
					local overlap = OverlapParams.new()
					overlap.FilterType = Enum.RaycastFilterType.Exclude
					overlap.FilterDescendantsInstances = if spell.AttachedHumanoid
						then { spell.Visual, spell.AttachedHumanoid.Parent }
						elseif attachment then { spell.Visual, attachment }
						else { spell.Visual }
					local blocked = false
					for _, part in
						workspace:GetPartBoundsInBox(targetFrame, targetSize - Vector3.new(0.02, 0.02, 0.02), overlap)
					do
						local model = part:FindFirstAncestorOfClass("Model")
						if part.CanCollide or (model and model:FindFirstChildOfClass("Humanoid")) then
							blocked = true
							break
						end
					end
					if not blocked then
						local raycast = RaycastParams.new()
						raycast.FilterType = Enum.RaycastFilterType.Exclude
						raycast.FilterDescendantsInstances = overlap.FilterDescendantsInstances
						raycast.RespectCanCollide = true
						for _, axis in ipairs({
							{ targetFrame.RightVector, targetSize.X / 2 },
							{ targetFrame.UpVector, targetSize.Y / 2 },
							{ targetFrame.LookVector, targetSize.Z / 2 },
						}) do
							local distance = math.max(0, axis[2] - 0.05)
							for _, sign in ipairs({ -1, 1 }) do
								if
									distance > 0
									and workspace:Raycast(targetFrame.Position, axis[1] * distance * sign, raycast)
								then
									blocked = true
									break
								end
							end
							if blocked then
								break
							end
						end
					end
					if not blocked then
						if math.abs(growthScale - spell.CurrentScale) >= 0.001 then
							spell.Visual:ScaleTo(growthScale)
							spell.CurrentScale = growthScale
						end
					end
				end
				local followFrame = frameForScale(spell.CurrentScale)
				spell.Visual:PivotTo(followFrame)
			elseif attachment and not gone and not dead then
				spell.Visual:PivotTo(attachment.CFrame * spell.AttachmentOffset)
			end
			if not gone and not dead then
				spell.Position = spell.Visual:GetPivot().Position
				updateActiveProximity(spell, spell.Position, now)
			end
			if spell.RemainingLifetime <= 0 or gone or dead then
				expireConstruct(spell)
				if spell.IsChannel then
					spell.IsChannel = false
					if stats and stats.Channel == spell then
						stats.Channel = nil
					end
					setCastingMovement(spell.Player, spell.State, nil)
					Presentation.cancel(spell.Caster, d)
					if not spell.ResourceEnded then
						feedback(spell.Remote, spell.Player, "EXPIRED", d, {
							Reason = if gone or dead
								then "Sustained Construct ended · attachment or construct was removed"
								else "Sustained Construct reached its maximum duration",
						})
					end
				end
				Presentation.finish(spell.Visual)
				table.remove(active, i)
			end
			continue
		end
		if
			spell.Kind == "BeamChannel"
			or spell.Kind == "ProjectileChannel"
			or spell.Kind == "WaveChannel"
			or spell.Kind == "SelfEnhancementChannel"
		then
			continue
		end
		if spell.ReturnEnded then
			emitExpiry(spell, spell.Position, {})
			Presentation.finish(spell.Visual)
			table.remove(active, i)
			continue
		end
		if spell.Kind == "Field" or spell.Kind == "Aura" then
			if spell.Definition.Lifetime.Mode == "UntilDestroyed" and not spell.Visual:IsDescendantOf(workspace) then
				finishInterruptedArea(spell)
				table.remove(active, i)
				continue
			end
			local area = d.Field or d.Aura
			local areaScale = AreaGrowth.scale(area, spell.Age)
			local scaledArea = AreaGrowth.area(area, areaScale)
			local followsAnchor = spell.Kind == "Aura" or spell.FollowTarget == true
			if followsAnchor then
				if spell.FollowPart then
					local followPart = spell.FollowPart
					if
						not followPart:IsDescendantOf(workspace)
						or not followPart.CanCollide
						or hasHumanoidAncestor(followPart)
					then
						finishInterruptedArea(spell)
						table.remove(active, i)
						continue
					end
					spell.Position = followPart.CFrame:PointToWorldSpace(spell.FollowPartOffset)
				else
					local followTarget = spell.FollowTargetModel or spell.FollowTarget or spell.Caster
					local root = followTarget:FindFirstChild("HumanoidRootPart")
					local followHumanoid = followTarget:FindFirstChildOfClass("Humanoid")
					if
						not followTarget:IsDescendantOf(workspace)
						or not root
						or not root:IsA("BasePart")
						or not followHumanoid
						or followHumanoid.Health <= 0
					then
						finishInterruptedArea(spell)
						table.remove(active, i)
						continue
					end
					spell.Position = root.Position
				end
			end
			local visualPosition = spell.Position
			if spell.Kind == "Aura" and d.Geometry ~= "Cone" and d.Geometry ~= "Plane" and d.Geometry ~= "Line" then
				visualPosition -= Vector3.new(0, 2.7, 0)
			end
			local areaFrame = CFrame.new(visualPosition) * CFrame.Angles(0, math.rad(area.Yaw or 0), 0)
			Presentation.resizeAreaMarker(
				spell.Visual,
				d.Geometry,
				areaFrame,
				Geometry.areaSize(d.Geometry, scaledArea),
				if spell.Kind == "Field" then d.Field.DebugHeight else nil
			)
			local targets = nil
			if spell.RemainingLifetime > 0 and now >= spell.NextInterval then
				spell.NextInterval = now + area.Interval
				targets = formAreaTargets(spell, spell.Position)
				updateAreaMembership(spell, targets)
				emit(
					d,
					"OnTick",
					spell.Caster,
					spell.Position,
					targets,
					spell.Direction,
					spell.Remote,
					spell.Player,
					nil,
					spell
				)
			end
			if spell.RemainingLifetime <= 0 then
				if not targets then
					targets = formAreaTargets(spell, spell.Position)
					updateAreaMembership(spell, targets)
				end
				local wasChannel = spell.IsChannel == true
				spell.IsChannel = false
				emitExpiry(spell, spell.Position, targets or formAreaCandidates(d, spell.Caster, spell.Position))
				closeAreaMembership(spell)
				if stats and stats.Channel == spell then
					stats.Channel = nil
				end
				if wasChannel then
					Presentation.cancel(spell.Caster, d)
				end
				Presentation.finish(spell.Visual)
				table.remove(active, i)
			end
		elseif spell.Kind == "ProjectileLinger" then
			if spell.AttachedPart then
				local attachedPart = spell.AttachedPart
				if attachedPart.Parent == nil or not attachedPart:IsDescendantOf(workspace) then
					spell.RemainingLifetime = 0
				else
					spell.Position = attachedPart.CFrame:PointToWorldSpace(spell.AttachedOffset)
					spell.Visual.Position = spell.Position
					if spell.LingerVisual then
						spell.LingerVisual.CFrame = attachedPart.CFrame * spell.AttachedVisualOffset
					end
				end
			end
			local targets = nil
			if spell.RemainingLifetime > 0 and now >= spell.NextInterval then
				spell.NextInterval = now + spell.LingerInterval
				targets = areaTargets(spell, spell.Position, spell.LingerRadius)
				emit(
					d,
					"OnTick",
					spell.Caster,
					spell.Position,
					targets,
					spell.Direction,
					spell.Remote,
					spell.Player,
					locusPotency(spell.Player) * (spell.PotencyMultiplier or 1),
					spell
				)
			end
			if spell.RemainingLifetime <= 0 then
				targets = targets or areaTargets(spell, spell.Position, spell.LingerRadius)
				emitExpiry(spell, spell.Position, targets, locusPotency(spell.Player) * (spell.PotencyMultiplier or 1))
				Presentation.finish(spell.Visual)
				if spell.LingerVisual then
					Presentation.finish(spell.LingerVisual)
				end
				table.remove(active, i)
			end
		else
			local maintainedTargetLost = spell.Kind == "Projectile"
				and LifetimeSpec.targetLost(d.Lifetime.Mode, isLiveHomingTarget(spell.HomingTarget))
			if spell.EndConditionEnded or maintainedTargetLost then
				emitExpiry(spell, spell.Position, {})
				Presentation.finish(spell.Visual)
				if spell.LingerVisual then
					Presentation.finish(spell.LingerVisual)
				end
				table.remove(active, i)
				continue
			end
			ProjectileBehaviors.update(spell, step, projectileBehaviorContext(spell))
			if spell.ReturnEnded then
				emitExpiry(spell, spell.Position, {})
				Presentation.finish(spell.Visual)
				table.remove(active, i)
				continue
			end
			local motionPhases = d.Projectile.MotionPhases or {}
			local previousPhase = spell.MotionPhaseIndex or 1
			local previousElapsed = spell.MotionPhaseElapsed or 0
			local phaseIndex, phaseElapsed, motionPhase =
				ProjectileMotion.advance(motionPhases, previousPhase, previousElapsed, step)
			local enteredPhase = phaseIndex ~= nil and phaseIndex ~= previousPhase
			local initializePhase = phaseIndex ~= nil
				and (enteredPhase or spell.MotionPhaseInitializedIndex ~= phaseIndex)
			if phaseIndex then
				spell.MotionPhaseIndex = phaseIndex
				spell.MotionPhaseElapsed = phaseElapsed
				if initializePhase then
					spell.MotionPhaseInitializedIndex = phaseIndex
					local velocityDirection = if spell.Velocity.Magnitude > 0.001
						then spell.Velocity.Unit
						else spell.Direction
					spell.Velocity = velocityDirection * spell.BaseSpeed * (motionPhase.SpeedMultiplier or 1)
					spell.Direction = velocityDirection
					spell.OrbitOrigin = nil
					spell.BezierOrigin = nil
					if motionPhase.Mode == "Orbiting" then
						local radial = spell.Direction:Cross(Vector3.yAxis)
						if radial.Magnitude < 0.05 then
							radial = spell.Direction:Cross(Vector3.xAxis)
						end
						spell.OrbitOrigin = spell.Position
						spell.OrbitRadial = radial.Unit
						spell.OrbitTangent = Vector3.yAxis:Cross(radial.Unit).Unit
					elseif motionPhase.Mode == "Bezier" then
						local sideAxis = spell.Direction:Cross(Vector3.yAxis)
						if sideAxis.Magnitude < 0.05 then
							sideAxis = spell.Direction:Cross(Vector3.xAxis)
						end
						spell.BezierOrigin = spell.Position
						spell.BezierDirection = spell.Direction
						spell.BezierSideAxis = sideAxis.Unit
						spell.BezierDistance = spell.Velocity.Magnitude * motionPhase.Duration
					end
				end
			end
			local mode = motionPhase and motionPhase.Mode or "Linear"
			spell.MotionPhaseMode = mode
			local phaseDuration = motionPhase and motionPhase.Duration or 1
			local phaseTimeBefore = if initializePhase then 0 else previousElapsed
			local previous = spell.Position
			local usesAcceleration = mode == "Linear" or mode == "Arcing" or mode == "Attached"
			local usesGravity = mode == "Linear" or mode == "Arcing" or mode == "Falling" or mode == "Attached"
			local acceleration = if mode == "Stationary"
				then Vector3.zero
				else spell.Direction * (if usesAcceleration and motionPhase
					then motionPhase.Acceleration or d.Projectile.Acceleration
					elseif usesAcceleration then d.Projectile.Acceleration
					else 0) - Vector3.new(
					0,
					if mode == "Falling"
						then motionPhase.Gravity
						elseif usesGravity and motionPhase then motionPhase.Gravity or d.Projectile.Gravity
						elseif usesGravity then d.Projectile.Gravity
						else 0,
					0
				)
			local movement = if mode == "Stationary"
				then Vector3.zero
				else spell.Velocity * step + acceleration * (step * step / 2)
			if mode == "Arcing" and motionPhase then
				local beforeArc = ProjectileMotion.arcOffset(motionPhase.ArcHeight, phaseDuration, phaseTimeBefore)
				local afterArc = ProjectileMotion.arcOffset(motionPhase.ArcHeight, phaseDuration, phaseElapsed)
				movement += Vector3.yAxis * (afterArc - beforeArc)
			elseif mode == "Orbiting" and motionPhase and spell.OrbitOrigin then
				local angularSpeed = motionPhase.OrbitAngularSpeed
				local radius = motionPhase.OrbitRadius
				local function orbitOffset(time)
					local angle = time * angularSpeed
					return spell.OrbitRadial * (radius * (math.cos(angle) - 1))
						+ spell.OrbitTangent * (radius * math.sin(angle))
				end
				movement += orbitOffset(phaseElapsed) - orbitOffset(phaseTimeBefore)
			elseif mode == "Bezier" and motionPhase and spell.BezierOrigin then
				local before = ProjectileMotion.bezierPosition(
					spell.BezierOrigin,
					spell.BezierDirection,
					spell.BezierSideAxis,
					spell.BezierDistance,
					motionPhase.BezierSide or 0,
					motionPhase.BezierHeight or 0,
					phaseTimeBefore / phaseDuration
				)
				local after = ProjectileMotion.bezierPosition(
					spell.BezierOrigin,
					spell.BezierDirection,
					spell.BezierSideAxis,
					spell.BezierDistance,
					motionPhase.BezierSide or 0,
					motionPhase.BezierHeight or 0,
					phaseElapsed / phaseDuration
				)
				movement = after - before
			end
			local collisionRadius = d.Projectile.Radius
			if mode == "Expanding" and motionPhase then
				collisionRadius *= ProjectileMotion.expansion(motionPhase.ExpandMultiplier, phaseDuration, phaseElapsed)
				if spell.InitialVisualSize then
					spell.Visual.Size = spell.InitialVisualSize * (collisionRadius / d.Projectile.Radius)
				end
			end
			if not spell.Returning then
				local remaining = d.Projectile.MaxDistance - spell.Distance
				if movement.Magnitude > remaining then
					movement = movement.Unit * math.max(0, remaining)
				end
			end
			if mode == "Bezier" and motionPhase then
				local tangent = ProjectileMotion.bezierTangent(
					spell.BezierDirection,
					spell.BezierSideAxis,
					spell.BezierDistance,
					motionPhase.BezierSide or 0,
					motionPhase.BezierHeight or 0,
					phaseElapsed / phaseDuration
				)
				if tangent.Magnitude > 0.001 then
					spell.Velocity = tangent.Unit * (tangent.Magnitude / phaseDuration)
					spell.Direction = tangent.Unit
				end
			else
				spell.Velocity += acceleration * step
			end
			if mode == "Stationary" then
				spell.Velocity = Vector3.zero
			end
			local hit = nil
			if not spell.CheckedSpawn then
				spell.CheckedSpawn = true
				local overlap = OverlapParams.new()
				overlap.FilterType = Enum.RaycastFilterType.Exclude
				local ignored = { spell.Caster, spell.Visual }
				for _, model in ipairs(spell.IgnoredTargetModels or {}) do
					table.insert(ignored, model)
				end
				overlap.FilterDescendantsInstances = ignored
				-- Query with the authored collision radius, never the independently scaled visual.
				for _, part in workspace:GetPartBoundsInRadius(previous, collisionRadius, overlap) do
					local model = part:FindFirstAncestorOfClass("Model")
					local isHumanoid = model and model:FindFirstChildOfClass("Humanoid")
					if
						(part.CanCollide or isHumanoid)
						and not isSpawnFloorClip(
							part,
							previous,
							spell.Direction,
							spell.Caster,
							spell.Visual,
							collisionRadius
						)
					then
						hit = { Instance = part, Position = previous, Distance = 0 }
						break
					end
				end
			end
			if mode == "Stationary" and now >= (spell.NextStationaryQuery or 0) then
				spell.NextStationaryQuery = now + Limits.ProjectileStationarySampleInterval
				local overlap = OverlapParams.new()
				overlap.FilterType = Enum.RaycastFilterType.Exclude
				local ignored = { spell.Caster, spell.Visual }
				for _, model in ipairs(spell.IgnoredTargetModels or {}) do
					table.insert(ignored, model)
				end
				overlap.FilterDescendantsInstances = ignored
				overlap.RespectCanCollide = false
				for _, part in workspace:GetPartBoundsInRadius(previous, collisionRadius, overlap) do
					local model = part:FindFirstAncestorOfClass("Model")
					local isHumanoid = model and model:FindFirstChildOfClass("Humanoid")
					if
						(part.CanCollide or isHumanoid)
						and not isSpawnFloorClip(
							part,
							previous,
							spell.Direction,
							spell.Caster,
							spell.Visual,
							collisionRadius
						)
					then
						hit = { Instance = part, Position = previous, Distance = 0 }
						break
					end
				end
			end
			hit = hit
				or sweep(previous, movement, spell.Caster, spell.Visual, collisionRadius, spell.IgnoredTargetModels)
			spell.Position = if hit
				then previous + (if movement.Magnitude > 0 then movement.Unit else Vector3.zero) * hit.Distance
				else previous + movement
			spell.Distance += if hit then hit.Distance else movement.Magnitude
			spell.Visual.Position = spell.Position
			if hit then
				Presentation.impact(hit.Position, d.Visual.Color, d, hit)
				local hitObjectTarget = spell.ObjectTarget
					and hit.Instance == spell.ObjectTarget
					and spell.Distance <= objectTargetRange(d)
					and isValidObjectInteractionTarget(d, hit.Instance)
				local hitTargets = if spell.ObjectTarget
					then if hitObjectTarget then { spell.ObjectTarget } else {}
					else targetFrom(hit)
				local hitHumanoid = hitTargets[1]
				if hitHumanoid then
					spell.HitHumanoids = spell.HitHumanoids or {}
					spell.HitHumanoids[hitHumanoid] = true
					spell.TargetsHit[hitHumanoid] = true
					if projectileHasBehavior(spell, "Return") then
						local hitModel = hitHumanoid.Parent
						if hitModel then
							spell.IgnoredTargetModels = spell.IgnoredTargetModels or {}
							if not table.find(spell.IgnoredTargetModels, hitModel) then
								table.insert(spell.IgnoredTargetModels, hitModel)
							end
						end
					end
				end
				spell.CurrentPhase = "Impact"
				spell.AllowObjectTarget = hitObjectTarget == true
				spell.HitPart = hit.Instance
				emit(
					d,
					"OnImpact",
					spell.Caster,
					hit.Position,
					hitTargets,
					spell.Direction,
					spell.Remote,
					spell.Player,
					locusPotency(spell.Player) * (spell.PotencyMultiplier or 1),
					spell
				)
				spell.HitPart = nil
				spell.AllowObjectTarget = nil
				local continue = ProjectileBehaviors.impact(spell, hit, projectileBehaviorContext(spell))
				if projectileHasBehavior(spell, "Return") and hitHumanoid then
					continue = true
				end
				if continue then
					spell.Position = hit.Position + spell.Direction * (d.Projectile.Radius + 0.05)
					spell.Visual.Position = spell.Position
				elseif spell.Kind == "ProjectileLinger" then
					Presentation.stopLoop(spell.Visual, "TravelSoundId")
					Presentation.attachLoop(d, "AmbientLoopSoundId", spell.Visual)
					for _, behavior in ipairs(d.Projectile.Behaviors) do
						if behavior.Kind == "Linger" then
							spell.LingerVisual = Presentation.marker(
								"MagicLingerHazard",
								hit.Position,
								Vector3.new(0.15, behavior.Radius * 2, behavior.Radius * 2),
								d.Visual.Color
							)
							if spell.AttachedPart then
								spell.AttachedVisualOffset =
									spell.AttachedPart.CFrame:ToObjectSpace(spell.LingerVisual.CFrame)
							end
							break
						end
					end
				elseif spell.Kind ~= "ProjectileLinger" then
					Presentation.finish(spell.Visual)
					table.remove(active, i)
				end
			elseif spell.RemainingLifetime <= 0 or spell.Distance >= d.Projectile.MaxDistance - 0.001 then
				if
					spell.RemainingLifetime > 0
					and spell.Distance >= d.Projectile.MaxDistance - 0.001
					and not spell.Returning
				then
					spell.Returning = projectileHasBehavior(spell, "Return")
					if spell.Returning then
						spell.CurrentPhase = "Returning"
					end
				end
				if not spell.Returning or spell.RemainingLifetime <= 0 then
					emitExpiry(spell, spell.Position, {})
					Presentation.finish(spell.Visual)
					table.remove(active, i)
				end
			end
		end
	end
	for player, effects in enhancements do
		local fallback = nil
		for id, effect in effects do
			effect.Age += delta
			local manaRate = effect.Definition.Casting.ManaUpkeepPerSecond or 0
			local strainRate = effect.Definition.Casting.StrainPerSecond or 0
			if
				not effect.IsChannel
				and not effect.ResourceEnded
				and now < effect.ExpiresAt
				and (manaRate > 0 or strainRate > 0)
			then
				local stats = playerData[player]
				local paid = stats ~= nil and LocusModel.upkeep(stats, manaRate, strainRate, delta)
				if stats then
					queueResourceSave(player)
				end
				if not paid or (stats and manaRate > 0 and stats.Mana <= 0) then
					effect.ResourceEnded = true
					effect.ExpiresAt = now
					feedback(effect.Remote, player, "EXPIRED", effect.Definition, {
						Reason = if stats and stats.Mana <= 0
							then "Enhancement ended · mana depleted"
							else "Enhancement ended · ongoing Locus resources depleted",
						Mana = stats and stats.Mana,
						Capacity = stats and stats.Capacity,
						Strain = stats and stats.Strain,
						StrainTolerance = stats and stats.StrainTolerance,
					})
				end
			end
			if not effect.EndConditionEnded and Conditions.endWhen(effect.Definition, effect, playerData[player]) then
				effect.EndConditionEnded = true
				effect.ExpiresAt = now
			end
			if
				now < effect.ExpiresAt
				and effect.State.Character == player.Character
				and effect.State.Humanoid.Health > 0
			then
				updateActiveProximity(effect, effect.State.Root.Position, now)
			end
			if
				now >= effect.ExpiresAt
				or effect.State.Character ~= player.Character
				or effect.State.Humanoid.Health <= 0
			then
				expireSelfEnhancement(player, effect)
				Presentation.stopSound(effect.AmbientSound)
				fallback = effect.State
				effects[id] = nil
			end
		end
		if fallback then
			updateEnhancement(player, fallback)
		end
	end
end)

local function restorePersistentConstruct(record)
	local savedVisual = record.Visual
	local visual = {
		Color = Color3.new(savedVisual.Color[1], savedVisual.Color[2], savedVisual.Color[3]),
		MaterialAppearance = savedVisual.MaterialAppearance,
		Opacity = savedVisual.Opacity,
		Emission = savedVisual.Emission,
		ParticleStyle = savedVisual.ParticleStyle,
	}
	if savedVisual.SecondaryColor then
		visual.SecondaryColor =
			Color3.new(savedVisual.SecondaryColor[1], savedVisual.SecondaryColor[2], savedVisual.SecondaryColor[3])
	end
	local frame = CFrame.new(record.Position[1], record.Position[2], record.Position[3])
		* CFrame.Angles(
			math.rad(record.RotationDegrees[1]),
			math.rad(record.RotationDegrees[2]),
			math.rad(record.RotationDegrees[3])
		)
	local definition = { Form = "Construct", Visual = visual }
	local model = Instance.new("Model")
	model.Name = "MagicPersistentConstruct"
	local pivot = Instance.new("Part")
	pivot.Name = "ConstructPivot"
	pivot.Size = Vector3.one * 0.1
	pivot.Transparency = 1
	pivot.Anchored = true
	pivot.CanCollide, pivot.CanTouch, pivot.CanQuery = false, false, false
	pivot.CFrame = frame
	pivot.Parent = model
	model.PrimaryPart = pivot
	for index, component in ipairs(record.Components) do
		local part: BasePart = Instance.new(if component.Shape == "Wedge" then "WedgePart" else "Part")
		part.Name = string.format("ConstructPart%02d", index)
		part.Size = Vector3.new(component.Size[1], component.Size[2], component.Size[3])
		if part:IsA("Part") then
			part.Shape = Enum.PartType[component.Shape]
		end
		local rotation = component.RotationDegrees
		part.CFrame = frame
			* CFrame.new(component.Offset[1], component.Offset[2], component.Offset[3])
			* CFrame.Angles(math.rad(rotation[1]), math.rad(rotation[2]), math.rad(rotation[3]))
		part.Anchored = true
		part.CanCollide, part.CanTouch, part.CanQuery = true, false, true
		part.Material = Presentation.material(definition)
		part.Color = definition.Visual.Color
		part.Transparency = 1 - (definition.Visual.Opacity or 0.85)
		part.Parent = model
	end
	model:SetAttribute("MagicPersistentConstruct", true)
	model:SetAttribute("MagicPersistentConstructId", record.Id)
	model:SetAttribute("MagicPersistentConstructOwner", record.OwnerUserId)
	model.Parent = workspace
	watchPersistentConstruct(model, record.Id)
end

task.spawn(function()
	local ready, reason = PersistentConstructStore.start(restorePersistentConstruct)
	if not ready then
		warn("Persistent Construct storage unavailable: " .. tostring(reason))
	end
end)

return Magic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="147">
          <Properties>
            <string name="Name">MagicStatusEffectService</string>
            <string name="Source"><![CDATA[--!strict

-- Bounded V1 status effects shared by player and NPC Humanoids.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Limits = require(game:GetService("ReplicatedStorage").Shared.Configuration.MagicLab)
local ShieldPool = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicShieldPool)
local AttributeSpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicAttributeSpec)
local MovementEffects = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicMovementEffects)
local RevealSpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicRevealSpec)
local TemporalRate = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicTemporalRate)
local TransformationSpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicTransformationSpec)
local EffectSpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicStatusEffectSpec)
local ElementalMarkSpec = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicElementalMarkSpec)
local DamageRules = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicDamageRules)
local Movement = require(script.Parent.MovementService)
TemporalRate.configure(Limits.MinTimeRate, Limits.MaxTimeRate)

type Effect = {
	Kind: string,
	Attribute: string?,
	Caster: Model,
	SpellId: string,
	ExpiresAt: number,
	Remaining: number?,
	LastUpdateAt: number?,
	Amount: number?,
	Multiplier: number?,
	OnBreak: ((Humanoid) -> ())?,
	ViewerUserId: number?,
	Color: Color3?,
	OnTargetDeath: ((Humanoid) -> ())?,
	Element: string?,
	Stacks: number?,
	RequiredElementalMark: string?,
}
type TargetState = {
	Humanoid: Humanoid,
	Effects: { Effect },
	Connections: { RBXScriptConnection },
	RevealAttributes: { [string]: boolean },
	TransformModel: Model?,
	OriginalScale: number?,
	AppliedScale: number?,
}

local Status = {}
local targets: { [Humanoid]: TargetState } = setmetatable({}, { __mode = "k" }) :: any
local active: { TargetState } = {}
local lastSweep = 0

local function setAttribute(humanoid: Humanoid, model: Model?, name: string, value: any)
	humanoid:SetAttribute(name, value)
	if model then
		model:SetAttribute(name, value)
	end
end

local function captureTransformBaseline(state: TargetState, model: Model): boolean
	if state.TransformModel == model and state.OriginalScale then
		return true
	end
	local ok, scale = pcall(function()
		return model:GetScale()
	end)
	if not ok or type(scale) ~= "number" then
		return false
	end
	state.TransformModel = model
	state.OriginalScale = scale
	state.AppliedScale = scale
	return true
end

local function restoreTransform(state: TargetState)
	local model = state.TransformModel
	local scale = state.OriginalScale
	-- A live model may be moved out of Workspace before cleanup runs. Restore
	-- its authored size while it still exists so reparenting it later cannot
	-- preserve an expired transformation.
	if model and scale and model.Parent ~= nil then
		pcall(function()
			model:ScaleTo(scale)
		end)
	end
	state.TransformModel = nil
	state.OriginalScale = nil
	state.AppliedScale = nil
end

local function getState(humanoid: Humanoid, create: boolean): TargetState?
	local state = targets[humanoid]
	if state or not create or #active >= Limits.MaxEffectTargets then
		return state
	end
	local model = humanoid.Parent
	if not model or not model:IsA("Model") or not humanoid:IsDescendantOf(workspace) then
		return nil
	end
	state = { Humanoid = humanoid, Effects = {}, Connections = {}, RevealAttributes = {} }
	targets[humanoid] = state
	table.insert(active, state)
	state.Connections = {
		humanoid.Died:Connect(function()
			local callbacks = {}
			local seen = {}
			local now = os.clock()
			for _, effect in state.Effects do
				local casterHumanoid = effect.Caster:FindFirstChildOfClass("Humanoid")
				local casterAlive = effect.Caster:IsDescendantOf(workspace)
					and (not casterHumanoid or casterHumanoid.Health > 0)
				local viewerPresent = not effect.ViewerUserId or Players:GetPlayerByUserId(effect.ViewerUserId) ~= nil
				if
					effect.OnTargetDeath
					and not EffectSpec.isExpired(
						effect.Kind,
						effect.ExpiresAt,
						effect.Remaining,
						now,
						casterAlive,
						viewerPresent
					)
				then
					local sourceSpells = seen[effect.Caster]
					if not sourceSpells then
						sourceSpells = {}
						seen[effect.Caster] = sourceSpells
					end
					if not sourceSpells[effect.SpellId] then
						sourceSpells[effect.SpellId] = true
						table.insert(callbacks, effect.OnTargetDeath)
					end
				end
			end
			for _, callback in callbacks do
				task.defer(callback, humanoid)
			end
			Status.clear(humanoid)
		end),
		humanoid.AncestryChanged:Connect(function(_, parent)
			if parent == nil then
				Status.clear(humanoid)
			end
		end),
	}
	return state
end

local function removeState(state: TargetState)
	if targets[state.Humanoid] ~= state then
		return
	end
	targets[state.Humanoid] = nil
	for i = #active, 1, -1 do
		if active[i] == state then
			table.remove(active, i)
			break
		end
	end
	for _, connection in state.Connections do
		connection:Disconnect()
	end
	restoreTransform(state)
	local model = state.Humanoid.Parent
	if model and model:IsA("Model") then
		for attribute in state.RevealAttributes do
			model:SetAttribute(attribute, nil)
			model:SetAttribute(string.gsub(attribute, "Until", "Color"), nil)
		end
		if next(state.RevealAttributes) then
			CollectionService:RemoveTag(model, "MagicRevealedTarget")
		end
	end
	Movement.setMagicSlow(state.Humanoid, 1)
	setAttribute(state.Humanoid, if model and model:IsA("Model") then model else nil, "MagicShield", 0)
	setAttribute(state.Humanoid, if model and model:IsA("Model") then model else nil, "MagicArmorBonus", 0)
	setAttribute(state.Humanoid, if model and model:IsA("Model") then model else nil, "MagicStrengthBonus", 0)
	setAttribute(state.Humanoid, if model and model:IsA("Model") then model else nil, "MagicMovementBound", false)
	setAttribute(state.Humanoid, if model and model:IsA("Model") then model else nil, "MagicShieldExpiresAt", nil)
	setAttribute(state.Humanoid, if model and model:IsA("Model") then model else nil, "MagicSlowMultiplier", 1)
	setAttribute(state.Humanoid, if model and model:IsA("Model") then model else nil, "MagicTimeRate", 1)
	setAttribute(state.Humanoid, if model and model:IsA("Model") then model else nil, "MagicElementalMarks", nil)
end

local function refreshAttributes(state: TargetState)
	local now = os.clock()
	for index = #state.Effects, 1, -1 do
		local effect = state.Effects[index]
		if
			effect.RequiredElementalMark
			and ElementalMarkSpec.stackCount(state.Effects, effect.RequiredElementalMark, now) <= 0
		then
			table.remove(state.Effects, index)
		end
	end
	local shield = 0
	local timeRate = TemporalRate.combine(state.Effects, now)
	local slow = MovementEffects.multiplier(state.Effects, now)
	local movementMultiplier = math.clamp(slow * timeRate, 0, TemporalRate.Maximum)
	local bound = movementMultiplier <= 0
	local armorBonus = AttributeSpec.aggregate(state.Effects, "MagicArmor", now)
	local strengthBonus = AttributeSpec.aggregate(state.Effects, "MagicStrength", now)
	local earliestShield: number? = nil
	local reveals = RevealSpec.aggregate(state.Effects, now)
	local elementalMarks = ElementalMarkSpec.encode(state.Effects, now)
	local transformScale = TransformationSpec.aggregate(state.Effects, now)
	for _, effect in state.Effects do
		if effect.Kind == "Shield" then
			shield += effect.Amount or 0
			earliestShield = if earliestShield then math.min(earliestShield, effect.ExpiresAt) else effect.ExpiresAt
		end
	end
	local model = state.Humanoid.Parent
	local parentModel = if model and model:IsA("Model") then model else nil
	if state.TransformModel and state.OriginalScale and state.TransformModel:IsDescendantOf(workspace) then
		local targetScale = state.OriginalScale * transformScale
		if math.abs(targetScale - (state.AppliedScale or state.OriginalScale)) > 0.001 then
			local ok = pcall(function()
				state.TransformModel:ScaleTo(targetScale)
			end)
			if ok then
				state.AppliedScale = targetScale
			end
		end
	end
	local currentRevealAttributes: { [string]: boolean } = {}
	if parentModel then
		for userId, reveal in reveals do
			local untilAttribute, colorAttribute = RevealSpec.attributeNames(userId)
			local serverExpiry = workspace:GetServerTimeNow() + reveal.ExpiresAt - now
			local currentExpiry = parentModel:GetAttribute(untilAttribute)
			if type(currentExpiry) ~= "number" or math.abs(currentExpiry - serverExpiry) > 0.05 then
				parentModel:SetAttribute(untilAttribute, serverExpiry)
			end
			if parentModel:GetAttribute(colorAttribute) ~= reveal.Color then
				parentModel:SetAttribute(colorAttribute, reveal.Color)
			end
			currentRevealAttributes[untilAttribute] = true
		end
		for attribute in state.RevealAttributes do
			if not currentRevealAttributes[attribute] then
				parentModel:SetAttribute(attribute, nil)
				parentModel:SetAttribute(string.gsub(attribute, "Until", "Color"), nil)
			end
		end
		if next(currentRevealAttributes) then
			CollectionService:AddTag(parentModel, "MagicRevealedTarget")
		else
			CollectionService:RemoveTag(parentModel, "MagicRevealedTarget")
		end
		state.RevealAttributes = currentRevealAttributes
	end
	setAttribute(state.Humanoid, parentModel, "MagicShield", shield)
	setAttribute(state.Humanoid, parentModel, "MagicArmorBonus", armorBonus)
	setAttribute(state.Humanoid, parentModel, "MagicStrengthBonus", strengthBonus)
	setAttribute(state.Humanoid, parentModel, "MagicMovementBound", bound)
	local expiresAt = if earliestShield then workspace:GetServerTimeNow() + earliestShield - os.clock() else nil
	setAttribute(state.Humanoid, parentModel, "MagicShieldExpiresAt", expiresAt)
	setAttribute(state.Humanoid, parentModel, "MagicSlowMultiplier", slow)
	setAttribute(state.Humanoid, parentModel, "MagicTimeRate", timeRate)
	setAttribute(state.Humanoid, parentModel, "MagicElementalMarks", elementalMarks)
	Movement.setMagicSlow(state.Humanoid, movementMultiplier)
end

function Status.elementalMark(
	caster: Model,
	humanoid: Humanoid,
	spellId: string,
	element: string,
	stacks: number,
	duration: number
): boolean
	if
		not DamageRules.KnownElements[element]
		or element == "Neutral"
		or type(stacks) ~= "number"
		or stacks ~= stacks
		or stacks % 1 ~= 0
		or stacks < 1
		or type(duration) ~= "number"
		or duration ~= duration
		or humanoid.Health <= 0
		or not humanoid:IsDescendantOf(workspace)
		or not caster:IsDescendantOf(workspace)
	then
		return false
	end
	local state = getState(humanoid, true)
	if not state then
		return false
	end
	local now = os.clock()
	for index = #state.Effects, 1, -1 do
		local effect = state.Effects[index]
		if
			effect.Kind == "ElementalMark"
			and ElementalMarkSpec.stackCount({ effect }, effect.Element or "", now) == 0
		then
			table.remove(state.Effects, index)
		end
	end
	local safeDuration = math.clamp(duration, 0.1, Limits.MaxDuration)
	local timeRate = TemporalRate.combine(state.Effects, now)
	local expiresAt = now + TemporalRate.worldDuration(safeDuration, timeRate)
	local candidate: Effect = {
		Kind = "ElementalMark",
		Element = element,
		Stacks = stacks,
		Caster = caster,
		SpellId = spellId,
		ExpiresAt = expiresAt,
		Remaining = safeDuration,
		LastUpdateAt = now,
	}
	if
		not ElementalMarkSpec.apply(
			state.Effects,
			candidate,
			Limits.MaxElementalMarkStacks,
			now,
			Limits.MaxEffectsPerTarget
		)
	then
		if #state.Effects == 0 then
			removeState(state)
		end
		return false
	end
	refreshAttributes(state)
	return true
end

function Status.consumeElementalMark(humanoid: Humanoid, element: string, stacks: number): number
	local state = targets[humanoid]
	if not state or not DamageRules.KnownElements[element] or element == "Neutral" then
		return 0
	end
	local consumed = ElementalMarkSpec.consume(state.Effects, element, math.max(0, math.floor(stacks)), os.clock())
	if consumed > 0 then
		refreshAttributes(state)
		if #state.Effects == 0 then
			removeState(state)
		end
	end
	return consumed
end

function Status.hasElementalMark(humanoid: Humanoid, element: string): boolean
	local state = targets[humanoid]
	return state ~= nil and ElementalMarkSpec.stackCount(state.Effects, element, os.clock()) > 0
end

local function sameSource(effect: Effect, caster: Model, spellId: string, kind: string, attribute: string?): boolean
	return effect.Caster == caster
		and effect.SpellId == spellId
		and effect.Kind == kind
		and effect.Attribute == attribute
end

local function putEffect(
	humanoid: Humanoid,
	caster: Model,
	spellId: string,
	kind: string,
	duration: number,
	amount: number?,
	multiplier: number?,
	onBreak: ((Humanoid) -> ())?,
	attribute: string?,
	viewerUserId: number?,
	color: Color3?,
	onTargetDeath: ((Humanoid) -> ())?,
	requiredElementalMark: string?
): boolean
	if humanoid.Health <= 0 or not humanoid:IsDescendantOf(workspace) or not caster:IsDescendantOf(workspace) then
		return false
	end
	local state = getState(humanoid, true)
	if not state then
		return false
	end
	local now = os.clock()
	local safeDuration = math.clamp(duration, 0.1, Limits.MaxDuration)
	local timeRate = TemporalRate.combine(state.Effects, now)
	local expiresAt = now
		+ if kind == "TimeDilation" then safeDuration else TemporalRate.worldDuration(safeDuration, timeRate)
	for index, effect in state.Effects do
		if
			sameSource(effect, caster, spellId, kind, attribute)
			and effect.RequiredElementalMark == requiredElementalMark
		then
			effect.ExpiresAt = expiresAt
			effect.Remaining = if kind == "TimeDilation" then nil else safeDuration
			effect.LastUpdateAt = if kind == "TimeDilation" then nil else now
			if kind == "Shield" then
				effect.OnBreak = onBreak
				local otherShield = 0
				for _, other in state.Effects do
					if other ~= effect and other.Kind == "Shield" then
						otherShield += other.Amount or 0
					end
				end
				effect.Amount = math.min(
					math.max(effect.Amount or 0, amount or 0),
					math.max(0, Limits.MaxShieldPerTarget - otherShield)
				)
				if (effect.Amount or 0) <= 0 then
					table.remove(state.Effects, index)
					if #state.Effects == 0 then
						removeState(state)
					else
						refreshAttributes(state)
					end
					return false
				end
			elseif kind == "ModifyAttribute" then
				effect.Amount = amount
				effect.Attribute = attribute
			elseif kind == "Transformation" then
				effect.Multiplier = multiplier
			elseif kind == "Reveal" then
				effect.ViewerUserId = viewerUserId
				effect.Color = color
			else
				effect.Multiplier = multiplier
			end
			effect.OnTargetDeath = onTargetDeath
			refreshAttributes(state)
			return true
		end
	end
	if #state.Effects >= Limits.MaxEffectsPerTarget then
		return false
	end
	if kind == "Transformation" then
		local model = humanoid.Parent
		if not model or not model:IsA("Model") or not captureTransformBaseline(state, model) then
			return false
		end
	end
	local totalShield = 0
	for _, effect in state.Effects do
		if effect.Kind == "Shield" then
			totalShield += effect.Amount or 0
		end
	end
	if kind == "Shield" then
		amount = math.min(amount or 0, math.max(0, Limits.MaxShieldPerTarget - totalShield))
		if amount <= 0 then
			return false
		end
	end
	table.insert(state.Effects, {
		Kind = kind,
		Attribute = attribute,
		Caster = caster,
		SpellId = spellId,
		ExpiresAt = expiresAt,
		Remaining = if kind == "TimeDilation" then nil else safeDuration,
		LastUpdateAt = if kind == "TimeDilation" then nil else now,
		Amount = amount,
		Multiplier = multiplier,
		OnBreak = onBreak,
		ViewerUserId = viewerUserId,
		Color = color,
		OnTargetDeath = onTargetDeath,
		RequiredElementalMark = requiredElementalMark,
		Multiplier = multiplier,
	})
	refreshAttributes(state)
	return true
end

function Status.heal(caster: Model, humanoid: Humanoid, amount: number): number
	if humanoid.Health <= 0 or not humanoid:IsDescendantOf(workspace) or not caster:IsDescendantOf(workspace) then
		return 0
	end
	local before = humanoid.Health
	humanoid.Health = math.min(humanoid.MaxHealth, before + math.clamp(amount, 0, Limits.MaxHeal))
	return math.max(0, humanoid.Health - before)
end

function Status.shield(
	caster: Model,
	humanoid: Humanoid,
	spellId: string,
	amount: number,
	duration: number,
	onBreak: ((Humanoid) -> ())?,
	onTargetDeath: ((Humanoid) -> ())?
): boolean
	return putEffect(
		humanoid,
		caster,
		spellId,
		"Shield",
		duration,
		math.clamp(amount, 0, Limits.MaxShield),
		nil,
		onBreak,
		nil,
		nil,
		nil,
		onTargetDeath
	)
end

function Status.slow(
	caster: Model,
	humanoid: Humanoid,
	spellId: string,
	multiplier: number,
	duration: number,
	onTargetDeath: ((Humanoid) -> ())?,
	requiredElementalMark: string?
): boolean
	return putEffect(
		humanoid,
		caster,
		spellId,
		"Slow",
		duration,
		nil,
		math.clamp(multiplier, Limits.MinSlowMultiplier, 1),
		nil,
		nil,
		nil,
		nil,
		onTargetDeath,
		requiredElementalMark
	)
end

function Status.temporalRate(
	caster: Model,
	humanoid: Humanoid,
	spellId: string,
	multiplier: number,
	duration: number,
	onTargetDeath: ((Humanoid) -> ())?
): boolean
	return putEffect(
		humanoid,
		caster,
		spellId,
		"TimeDilation",
		duration,
		nil,
		TemporalRate.clamp(multiplier),
		nil,
		nil,
		nil,
		nil,
		onTargetDeath
	)
end

function Status.timeRate(humanoid: Humanoid): number
	local state = targets[humanoid]
	return if state then TemporalRate.combine(state.Effects, os.clock()) else 1
end

function Status.bind(
	caster: Model,
	humanoid: Humanoid,
	spellId: string,
	duration: number,
	onTargetDeath: ((Humanoid) -> ())?
): boolean
	return putEffect(
		humanoid,
		caster,
		spellId,
		"Bind",
		math.min(duration, Limits.MaxBindDuration),
		nil,
		nil,
		nil,
		nil,
		nil,
		nil,
		onTargetDeath
	)
end

function Status.reveal(
	viewer: Player,
	caster: Model,
	humanoid: Humanoid,
	spellId: string,
	duration: number,
	color: Color3,
	onTargetDeath: ((Humanoid) -> ())?
): boolean
	return putEffect(
		humanoid,
		caster,
		spellId,
		"Reveal",
		math.min(duration, Limits.MaxRevealDuration, Limits.MaxDuration),
		nil,
		nil,
		nil,
		nil,
		viewer.UserId,
		color,
		onTargetDeath
	)
end

function Status.modifyAttribute(
	caster: Model,
	humanoid: Humanoid,
	spellId: string,
	attribute: string,
	amount: number,
	duration: number,
	onTargetDeath: ((Humanoid) -> ())?,
	requiredElementalMark: string?
): boolean
	local safeAmount = AttributeSpec.clamp(attribute, amount)
	if safeAmount == nil then
		return false
	end
	return putEffect(
		humanoid,
		caster,
		spellId,
		"ModifyAttribute",
		duration,
		safeAmount,
		nil,
		nil,
		attribute,
		nil,
		nil,
		onTargetDeath,
		requiredElementalMark
	)
end

function Status.transform(
	caster: Model,
	humanoid: Humanoid,
	spellId: string,
	multiplier: number,
	duration: number,
	onTargetDeath: ((Humanoid) -> ())?
): boolean
	local scale = TransformationSpec.clampScale(multiplier)
	if scale == nil then
		return false
	end
	local model = humanoid.Parent
	if not model or not model:IsA("Model") then
		return false
	end
	local state = getState(humanoid, true)
	if not state or not captureTransformBaseline(state, model) then
		return false
	end
	return putEffect(
		humanoid,
		caster,
		spellId,
		"Transformation",
		duration,
		nil,
		scale,
		nil,
		nil,
		nil,
		nil,
		nil,
		onTargetDeath
	)
end

function Status.absorb(humanoid: Humanoid, amount: number): (number, number, { Effect })
	local state = targets[humanoid]
	if not state or amount <= 0 then
		return amount, 0, {}
	end
	local now = os.clock()
	for i = #state.Effects, 1, -1 do
		if state.Effects[i].ExpiresAt <= now then
			table.remove(state.Effects, i)
		end
	end
	-- Spend the soonest-expiring shield first so refreshes remain intuitive.
	table.sort(state.Effects, function(a, b)
		if a.Kind ~= "Shield" then
			return false
		elseif b.Kind ~= "Shield" then
			return true
		end
		return a.ExpiresAt < b.ExpiresAt
	end)
	local remaining, absorbed, broken = ShieldPool.consume(state.Effects, amount)
	for i = #state.Effects, 1, -1 do
		local effect = state.Effects[i]
		if effect.Kind == "Shield" and (effect.Amount or 0) <= 0 then
			table.remove(state.Effects, i)
		end
	end
	refreshAttributes(state)
	if #state.Effects == 0 then
		removeState(state)
	end
	return remaining, absorbed, broken
end

function Status.clear(humanoid: Humanoid)
	local state = targets[humanoid]
	if state then
		removeState(state)
	end
end

RunService.Heartbeat:Connect(function()
	local now = os.clock()
	if now - lastSweep < 0.2 then
		return
	end
	lastSweep = now
	for i = #active, 1, -1 do
		local state = active[i]
		local humanoid = state.Humanoid
		if not humanoid:IsDescendantOf(workspace) or humanoid.Health <= 0 then
			removeState(state)
		else
			for j = #state.Effects, 1, -1 do
				local effect = state.Effects[j]
				if effect.Kind == "TimeDilation" then
					local casterHumanoid = effect.Caster:FindFirstChildOfClass("Humanoid")
					local casterAlive = effect.Caster:IsDescendantOf(workspace)
						and (not casterHumanoid or casterHumanoid.Health > 0)
					local viewerPresent = not effect.ViewerUserId
						or Players:GetPlayerByUserId(effect.ViewerUserId) ~= nil
					if
						EffectSpec.isExpired(
							effect.Kind,
							effect.ExpiresAt,
							effect.Remaining,
							now,
							casterAlive,
							viewerPresent
						)
					then
						table.remove(state.Effects, j)
					end
				end
			end
			local timeRate = TemporalRate.combine(state.Effects, now)
			for j = #state.Effects, 1, -1 do
				local effect = state.Effects[j]
				local casterAlive = effect.Caster:IsDescendantOf(workspace)
				local casterHumanoid = effect.Caster:FindFirstChildOfClass("Humanoid")
				if casterHumanoid and casterHumanoid.Health <= 0 then
					casterAlive = false
				end
				local viewerPresent = not effect.ViewerUserId or Players:GetPlayerByUserId(effect.ViewerUserId) ~= nil
				if effect.Kind ~= "TimeDilation" then
					local elapsed = math.max(0, now - (effect.LastUpdateAt or now))
					effect.Remaining = TemporalRate.advance(effect.Remaining or 0, elapsed, timeRate)
					effect.LastUpdateAt = now
					effect.ExpiresAt = now + TemporalRate.worldDuration(effect.Remaining, timeRate)
				end
				if
					EffectSpec.isExpired(
						effect.Kind,
						effect.ExpiresAt,
						effect.Remaining,
						now,
						casterAlive,
						viewerPresent
					)
				then
					table.remove(state.Effects, j)
				end
			end
			if #state.Effects == 0 then
				removeState(state)
			else
				refreshAttributes(state)
			end
		end
	end
end)

return Status
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="148">
          <Properties>
            <string name="Name">MagicSummonPlacement</string>
            <string name="Source"><![CDATA[-- Placement math shared by Event-triggered summons. Keep the summon behind
-- the impact surface relative to the incoming cast direction.
local Placement = {}

function Placement.behindImpact(eventPosition, sourceDirection, clearance)
	local awayFromImpact = Vector3.xAxis
	if sourceDirection.Magnitude > 0.001 then
		awayFromImpact = -sourceDirection.Unit
	end
	return eventPosition + awayFromImpact * clearance
end

return Placement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="149">
          <Properties>
            <string name="Name">MagicTriggerDispatch</string>
            <string name="Source"><![CDATA[-- Roblox-independent trigger-step interpreter used by the server runtime.
-- Keeping the injected executors explicit makes event routing testable without
-- duplicating the production dispatch rules in a test harness.
local Dispatch = {}

function Dispatch.execute(definition, event, context, payloads, behaviors, commands, targetDeath)
	for _, step in ipairs((definition.Triggers and definition.Triggers[event]) or {}) do
		local matches = true
		if event == "OnThreshold" and step.HealthPercent ~= context.HealthThreshold then
			matches = false
		elseif event == "OnCommand" and not commands.matches(step.Command, context.Command) then
			matches = false
		elseif event == "OnTargetDeath" and not targetDeath.matches(step.DeathMode, context.DeathCause) then
			matches = false
		end

		if matches then
			if step.Behavior then
				behaviors.execute(step.Behavior, context, step)
			else
				payloads.execute(step.Payloads or {}, context)
			end
		end
	end
end

return Dispatch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="150">
          <Properties>
            <string name="Name">MagicTriggerExecutors</string>
            <string name="Source"><![CDATA[--!strict
local Payloads = require(script.Parent.MagicPayloadExecutors)
local Behaviors = require(script.Parent.MagicBehaviorExecutors)
local Commands = require(script.Parent.MagicCommandSpec)
local TargetDeath = require(game:GetService("ReplicatedStorage").Shared.Modules.MagicTargetDeathSpec)
local Dispatch = require(script.Parent.MagicTriggerDispatch)
local Triggers = {}
function Triggers.execute(definition: any, event: string, context: any)
	Dispatch.execute(definition, event, context, Payloads, Behaviors, Commands, TargetDeath)
end
return Triggers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="151">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox")).Movement
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local Speed = require(Shared.Modules.MovementSpeed)
local MagicLab = require(Shared.Configuration.MagicLab)
local AerialSpec = require(Shared.Modules.MagicAerialMovementSpec)
local Movement = {}
type NpcSlowRecord = {
	BaseSpeed: number,
	BaseJumpPower: number,
	BaseJumpHeight: number,
	Multiplier: number,
	AppliedSpeed: number,
	Writing: boolean,
	Connection: RBXScriptConnection?,
}
local impulses = setmetatable({}, { __mode = "k" })
local playerStates = setmetatable({}, { __mode = "k" })
local npcSlowRecords: { [Humanoid]: NpcSlowRecord } = setmetatable({}, { __mode = "k" }) :: any

local function clearAerial(state: Types.PlayerState)
	if state.MagicAerialVelocity then
		if state.Root:IsDescendantOf(workspace) then
			state.Root.AssemblyLinearVelocity = Vector3.zero
		end
		state.MagicAerialVelocity:Destroy()
		state.MagicAerialVelocity = nil
	end
	if state.MagicAerialAttachment then
		state.MagicAerialAttachment:Destroy()
		state.MagicAerialAttachment = nil
	end
	state.MagicAerialSpeed = 0
	state.MagicAerialInput = Vector3.zero
	state.MagicAerialInputExpiresAt = 0
	state.Character:SetAttribute("MagicAerialSpeed", 0)
end

local function applyAerialInput(state: Types.PlayerState, now: number)
	local velocity = state.MagicAerialVelocity
	if not velocity then
		return
	end
	if now < state.DashUntil then
		if velocity.Enabled then
			velocity.Enabled = false
		end
		return
	end
	if not velocity.Enabled then
		velocity.Enabled = true
	end
	local input = if now <= state.MagicAerialInputExpiresAt then state.MagicAerialInput else Vector3.zero
	local speedScale = if Config.WalkSpeed > 0
		then Speed.calculate(
			Config.WalkSpeed,
			Config.SprintSpeed,
			state.Sprinting,
			state.MagicWalkSpeedBonus,
			state.MagicSpeedMultiplier
		) / Config.WalkSpeed
		else 1
	local speed = math.clamp(
		state.MagicAerialSpeed * speedScale * (state.MagicSlowMultiplier or 1) * (state.MagicCastingMultiplier or 1),
		0,
		MagicLab.MaxAerialSpeed
	)
	local targetVelocity = input * speed
	if velocity.VectorVelocity ~= targetVelocity then
		velocity.VectorVelocity = targetVelocity
	end
end

local function aerialMaximumSpeed(state: Types.PlayerState): number
	if state.MagicAerialSpeed <= 0 then
		return 0
	end
	local speedScale = if Config.WalkSpeed > 0
		then Speed.calculate(
			Config.WalkSpeed,
			Config.SprintSpeed,
			state.Sprinting,
			state.MagicWalkSpeedBonus,
			state.MagicSpeedMultiplier
		) / Config.WalkSpeed
		else 1
	return math.clamp(
		state.MagicAerialSpeed * speedScale * (state.MagicSlowMultiplier or 1) * (state.MagicCastingMultiplier or 1),
		0,
		MagicLab.MaxAerialSpeed
	)
end

function Movement.bind(state: Types.PlayerState)
	playerStates[state.Humanoid] = state
	state.Character:SetAttribute("MagicAerialSpeed", state.MagicAerialSpeed)
end

function Movement.unbind(state: Types.PlayerState)
	clearAerial(state)
	playerStates[state.Humanoid] = nil
	state.MagicSlowMultiplier = 1
	state.MagicCastingMultiplier = 1
	state.Humanoid:SetAttribute("MagicSlowMultiplier", 1)
	state.Character:SetAttribute("MagicCastingMultiplier", 1)
	state.Character:SetAttribute("MagicCastingLocked", false)
	state.MagicRotationLocked = false
	state.MagicCastingDirection = nil
	state.Character:SetAttribute("MagicRotationLocked", false)
	state.Humanoid:SetAttribute("MagicMovementBound", false)
	state.Humanoid.JumpPower = 50 + state.MagicJumpPowerBonus
	state.Humanoid.JumpHeight = state.MagicBaseJumpHeight
end

function Movement.setMagicAerial(state: Types.PlayerState, speed: number)
	local safeSpeed = AerialSpec.clampSpeed(speed, MagicLab.MaxAerialSpeed) or 0
	if safeSpeed <= 0 then
		clearAerial(state)
		return
	end
	state.MagicAerialSpeed = safeSpeed
	state.MagicAerialInput = Vector3.zero
	state.MagicAerialInputExpiresAt = 0
	if not state.MagicAerialAttachment or state.MagicAerialAttachment.Parent ~= state.Root then
		if state.MagicAerialVelocity then
			state.MagicAerialVelocity:Destroy()
		end
		state.MagicAerialAttachment = Instance.new("Attachment")
		state.MagicAerialAttachment.Name = "MagicAerialAttachment"
		state.MagicAerialAttachment.Parent = state.Root
		local velocity = Instance.new("LinearVelocity")
		velocity.Name = "MagicAerialVelocity"
		velocity.Attachment0 = state.MagicAerialAttachment
		velocity.RelativeTo = Enum.ActuatorRelativeTo.World
		velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		velocity.ForceLimitsEnabled = false
		velocity.VectorVelocity = Vector3.zero
		velocity.Parent = state.Root
		state.MagicAerialVelocity = velocity
	end
	state.Character:SetAttribute("MagicAerialSpeed", safeSpeed)
	applyAerialInput(state, workspace:GetServerTimeNow())
end

function Movement.aerialInput(state: Types.PlayerState, direction: Vector3, now: number): boolean
	if state.MagicAerialSpeed <= 0 or not state.MagicAerialVelocity then
		return false
	end
	local x, y, z = AerialSpec.normalizeInput(direction.X, direction.Y, direction.Z, 1.1)
	if x == nil or y == nil or z == nil then
		return false
	end
	state.MagicAerialInput = Vector3.new(x, y, z)
	state.MagicAerialInputExpiresAt = now + 0.35
	applyAerialInput(state, now)
	return true
end

function Movement.setMagicSlow(humanoid: Humanoid, multiplier: number)
	local state = playerStates[humanoid]
	if state then
		state.MagicSlowMultiplier = multiplier
		state.Character:SetAttribute("MagicSlowMultiplier", multiplier)
		humanoid:SetAttribute("MagicSlowMultiplier", multiplier)
		local base = Speed.calculate(
			Config.WalkSpeed,
			Config.SprintSpeed,
			state.Sprinting,
			state.MagicWalkSpeedBonus,
			state.MagicSpeedMultiplier
		)
		humanoid.WalkSpeed = base * multiplier * (state.MagicCastingMultiplier or 1)
		if multiplier <= 0 or (state.MagicCastingMultiplier or 1) <= 0 then
			if humanoid.UseJumpPower then
				humanoid.JumpPower = 0
			else
				humanoid.JumpHeight = 0
			end
		else
			humanoid.JumpPower = 50 + state.MagicJumpPowerBonus
			humanoid.JumpHeight = state.MagicBaseJumpHeight
		end
		return
	end

	local record = npcSlowRecords[humanoid]
	if multiplier == 1 then
		if record then
			record.Writing = true
			record.AppliedSpeed = record.BaseSpeed
			humanoid.WalkSpeed = record.BaseSpeed
			humanoid.JumpPower = record.BaseJumpPower
			humanoid.JumpHeight = record.BaseJumpHeight
			if record.Connection then
				record.Connection:Disconnect()
			end
			npcSlowRecords[humanoid] = nil
		end
		humanoid:SetAttribute("MagicSlowMultiplier", 1)
		return
	end
	if not record then
		record = {
			BaseSpeed = humanoid.WalkSpeed,
			BaseJumpPower = humanoid.JumpPower,
			BaseJumpHeight = humanoid.JumpHeight,
			Multiplier = multiplier,
			AppliedSpeed = humanoid.WalkSpeed * multiplier,
			Writing = false,
			Connection = nil,
		}
		record.Connection = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			local currentSpeed = humanoid.WalkSpeed
			if record.Writing or currentSpeed == record.AppliedSpeed or not humanoid:IsDescendantOf(workspace) then
				return
			end
			record.BaseSpeed = currentSpeed
			record.Writing = true
			record.AppliedSpeed = record.BaseSpeed * record.Multiplier
			humanoid.WalkSpeed = record.AppliedSpeed
			if record.Multiplier <= 0 then
				humanoid.JumpPower = 0
				humanoid.JumpHeight = 0
			else
				humanoid.JumpPower = record.BaseJumpPower
				humanoid.JumpHeight = record.BaseJumpHeight
			end
			record.Writing = false
		end)
		npcSlowRecords[humanoid] = record
	else
		record.Multiplier = multiplier
	end
	record.Writing = true
	record.AppliedSpeed = record.BaseSpeed * multiplier
	humanoid.WalkSpeed = record.AppliedSpeed
	if multiplier <= 0 then
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
	else
		humanoid.JumpPower = record.BaseJumpPower
		humanoid.JumpHeight = record.BaseJumpHeight
	end
	record.Writing = false
	humanoid:SetAttribute("MagicSlowMultiplier", multiplier)
end
function Movement.allowMagicImpulse(root: BasePart, velocity: Vector3)
	local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local old = impulses[root]
	if old and workspace:GetServerTimeNow() >= old.Until then
		old = nil
	end
	impulses[root] =
		{ Speed = math.min(120, horizontal + (old and old.Speed or 0)), Until = workspace:GetServerTimeNow() + 1 }
end

local function maximumSpeed(state: Types.PlayerState): number
	local multiplier = state.MagicSpeedMultiplier
	if workspace:GetServerTimeNow() < (state.MagicSpeedGraceUntil or 0) then
		multiplier = math.max(multiplier, state.MagicPreviousMultiplier or 1)
	end
	return Speed.calculate(Config.WalkSpeed, Config.SprintSpeed, true, state.MagicWalkSpeedBonus, multiplier)
		* (state.MagicSlowMultiplier or 1)
		* (state.MagicCastingMultiplier or 1)
end

local function applySpeed(state: Types.PlayerState)
	state.Humanoid.WalkSpeed = Speed.calculate(
		Config.WalkSpeed,
		Config.SprintSpeed,
		state.Sprinting,
		state.MagicWalkSpeedBonus,
		state.MagicSpeedMultiplier
	) * (state.MagicSlowMultiplier or 1) * (state.MagicCastingMultiplier or 1)
	if state.MagicSlowMultiplier <= 0 or (state.MagicCastingMultiplier or 1) <= 0 then
		if state.Humanoid.UseJumpPower then
			state.Humanoid.JumpPower = 0
		else
			state.Humanoid.JumpHeight = 0
		end
	else
		state.Humanoid.JumpPower = 50 + state.MagicJumpPowerBonus
		state.Humanoid.JumpHeight = state.MagicBaseJumpHeight
	end
end

function Movement.setMagicCasting(state: Types.PlayerState, multiplier: number)
	state.MagicCastingMultiplier = math.clamp(multiplier, 0, 1)
	state.Character:SetAttribute("MagicCastingMultiplier", state.MagicCastingMultiplier)
	state.Character:SetAttribute("MagicCastingLocked", state.MagicCastingMultiplier <= 0)
	applySpeed(state)
end

function Movement.setMagicRotation(state: Types.PlayerState, locked: boolean, direction: Vector3?)
	state.MagicRotationLocked = locked
	state.MagicCastingDirection = if locked then direction else nil
	state.Character:SetAttribute("MagicRotationLocked", locked)
end

function Movement.sprint(state: Types.PlayerState, enabled: boolean)
	state.Sprinting = enabled
	applySpeed(state)
end

-- This deliberately composes with sprinting instead of owning a separate stat
-- system. MagicService provides only validated temporary bonuses.
function Movement.setMagicEnhancement(
	state: Types.PlayerState,
	walkSpeedBonus: number,
	jumpPowerBonus: number,
	multiplier: number?
)
	-- Account for enhanced motion already observed in this validation window
	-- when the player turns the spell off while sprinting or dashing.
	state.MagicPreviousMultiplier = state.MagicSpeedMultiplier
	state.MagicSpeedGraceUntil = workspace:GetServerTimeNow() + Config.ValidationInterval + Config.DashReplicationGrace
	state.MagicSpeedMultiplier = multiplier or 1
	state.Character:SetAttribute("MagicSpeedMultiplier", state.MagicSpeedMultiplier)
	state.MagicWalkSpeedBonus = walkSpeedBonus
	state.MagicJumpPowerBonus = jumpPowerBonus
	state.Character:SetAttribute("MagicWalkSpeedBonus", walkSpeedBonus)
	state.Character:SetAttribute("MagicJumpPowerBonus", jumpPowerBonus)
	applySpeed(state)
end

function Movement.dash(state: Types.PlayerState, now: number): boolean
	if
		state.MagicSlowMultiplier <= 0
		or (state.MagicCastingMultiplier or 1) <= 0
		or now < state.DashReadyAt
		or now < state.ReadyAt
		or now < state.CorrectionUntil
	then
		return false
	end
	state.DashUntil = now + Config.DashDuration
	state.DashReadyAt = now + Config.DashCooldown
	-- Use the previous observed position: prediction can arrive before the request.
	state.DashOrigin = state.LastPosition
	state.DashCheckUntil = state.DashUntil + Config.DashReplicationGrace
	state.DashAllowance += Config.DashDistance
	return true
end

local function correct(state: Types.PlayerState, position: Vector3, now: number, player: Player, feedback: RemoteEvent)
	state.Root:SetNetworkOwner(nil)
	state.Root.CFrame = CFrame.new(position) * state.Root.CFrame.Rotation
	state.Root.AssemblyLinearVelocity = Vector3.zero
	state.CorrectionUntil = now + Config.CorrectionOwnershipTime
	state.Attack = nil
	state.DashOrigin = nil
	state.DashUntil = 0
	state.DashAllowance = 0
	state.LastPosition = position
	state.LastFramePosition = position
	state.LastCheck = now
	feedback:FireClient(player, { Kind = "Correction", Character = state.Character })
end

function Movement.update(player: Player, state: Types.PlayerState, now: number, feedback: RemoteEvent): boolean
	applyAerialInput(state, now)
	if now < state.SpawnGraceUntil then
		-- Roblox may still place/scale the rig after it first enters Workspace.
		-- Track the actual spawn position without fighting that engine movement.
		state.LastPosition = state.Root.Position
		state.LastFramePosition = state.Root.Position
		state.LastCheck = now
		if state.DashOrigin then
			state.DashOrigin = state.Root.Position
		end
		return true
	end
	if state.CorrectionUntil > 0 then
		if now < state.CorrectionUntil then
			return false
		end
		state.CorrectionUntil = 0
		state.Root:SetNetworkOwnershipAuto()
	end
	local elapsed = now - state.LastCheck
	local delta = state.Root.Position - state.LastPosition
	local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
	-- Horizontal checks leave jumping and falling alone. This is a sandbox guard,
	-- not a complete anti-cheat for client-owned Roblox character physics.
	local impulse = impulses[state.Root]
	local extraSpeed = 0
	if impulse then
		if now < impulse.Until then
			extraSpeed = impulse.Speed
		else
			impulses[state.Root] = nil
		end
	end
	local movementSpeed = math.max(maximumSpeed(state), aerialMaximumSpeed(state))
	local travel = if state.MagicAerialSpeed > 0 then delta.Magnitude else horizontal
	local budget = (movementSpeed + extraSpeed) * elapsed + state.DashAllowance + Config.PositionTolerance
	-- Check before every damage sample, not just when advancing the movement anchor.
	if travel ~= travel or travel > budget then
		-- Normal movement leaves vertical jumps/falls alone; aerial movement also
		-- caps height changes, using the same bounded validation window.
		correct(
			state,
			if state.MagicAerialSpeed > 0
				then state.LastPosition
				else Vector3.new(state.LastPosition.X, state.Root.Position.Y, state.LastPosition.Z),
			now,
			player,
			feedback
		)
		return false
	end
	if state.DashOrigin then
		local travel = state.Root.Position - state.LastFramePosition
		if travel.Magnitude > Config.DirectionEpsilon then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { state.Character }
			params.RespectCanCollide = true
			local start = CFrame.new(state.LastFramePosition) * state.Root.CFrame.Rotation
			local obstacle = workspace:Blockcast(start, Config.DashCollisionSize, travel, params)
			if obstacle then
				local safe = state.LastFramePosition + travel.Unit * math.max(0, obstacle.Distance - Config.WallPadding)
				correct(state, safe, now, player, feedback)
				return false
			end
		end
	end
	state.LastFramePosition = state.Root.Position
	if elapsed >= Config.ValidationInterval then
		state.LastCheck = now
		state.LastPosition = state.Root.Position
		-- Keep the allowance while delayed predicted physics can still arrive.
		if now >= state.DashCheckUntil then
			state.DashAllowance = 0
		end
	end
	if state.DashOrigin then
		local displacement = state.Root.Position - state.DashOrigin
		local limit = Config.DashDistance
			+ Config.PositionTolerance
			+ maximumSpeed(state) * (Config.ValidationInterval + Config.DashReplicationGrace)
		if Vector3.new(displacement.X, 0, displacement.Z).Magnitude > limit then
			correct(
				state,
				Vector3.new(state.DashOrigin.X, state.Root.Position.Y, state.DashOrigin.Z),
				now,
				player,
				feedback
			)
			return false
		end
		if now >= state.DashCheckUntil then
			state.DashOrigin = nil
		end
	end
	return true
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="152">
          <Properties>
            <string name="Name">NascentAttackSelector</string>
            <string name="Source"><![CDATA[--!strict

-- Pure, state-based selection for the Stage 1 Nascent. It intentionally has no
-- cooldown table: distance, recent commitment and desperation set the rhythm.
local Selector = {}

function Selector.choose(tuning, distance, lastAttack, serial, desperate)
	if distance <= tuning.MaulingCombination.Range and lastAttack ~= "MaulingCombination" then
		return "MaulingCombination"
	end
	if
		distance >= tuning.PredatoryLunge.MinimumRange
		and distance <= tuning.PredatoryLunge.Range
		and lastAttack ~= "PredatoryLunge"
	then
		return "PredatoryLunge"
	end
	if distance <= tuning.FrenziedChain.Range and lastAttack ~= "FrenziedChain" and (desperate or serial % 3 == 1) then
		return "FrenziedChain"
	end
	if distance <= tuning.RushingStrike.Range then
		return "RushingStrike"
	end
	return nil
end

return Selector
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="153">
          <Properties>
            <string name="Name">OpeningService</string>
            <string name="Source"><![CDATA[--!strict
-- Session identity only; no persistent class or progression state.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Configuration.CityLife)
local Plan = require(Shared.Configuration.PhaseATopology)
local Equipment = require(script.Parent.EquipmentService)
local Spawn = require(script.Parent.WorldSpawnService)
local Arena = require(script.Parent.CombatSandboxService)
local Opening = {}
local sessions = {}

local function dress(character, preset)
	for _, item in character:GetChildren() do
		if
			item:IsA("Accessory")
			or item:IsA("Shirt")
			or item:IsA("Pants")
			or item:IsA("ShirtGraphic")
			or item.Name == "LowerLayerClothing"
		then
			item:Destroy()
		end
	end
	local clothes = Instance.new("Folder")
	clothes.Name = "LowerLayerClothing"
	clothes.Parent = character
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "SandboxEquippedWeapon" then
			local clothed = part.Name ~= "Head" and not string.find(part.Name, "Hand")
			part.Color = if clothed then preset.Cloth else preset.Skin
			if part:IsA("MeshPart") then
				part.TextureID = ""
			end
			if clothed and (string.find(part.Name, "Torso") or string.find(part.Name, "Leg")) then
				local cover = Instance.new("Part")
				cover.Name = "Cloth"
				cover.Size = part.Size + Vector3.new(0.04, 0.02, 0.04)
				cover.CFrame = part.CFrame
				cover.Color = preset.Cloth
				cover.Material = Enum.Material.Fabric
				cover.CanCollide, cover.CanTouch, cover.CanQuery, cover.Massless = false, false, false, true
				cover.Parent = clothes
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = part, cover, cover
			end
		end
	end
end

function Opening.bind(player)
	local session = { Preset = 1, Complete = Arena.enabled(), LastRequest = -math.huge }
	sessions[player] = session
	player:SetAttribute("OpeningComplete", session.Complete)
	session.Connection = player.CharacterAppearanceLoaded:Connect(function(character)
		-- The combat sandbox uses the player's normal avatar appearance. The
		-- lower-layer clothing overlay is only for the story/city opening.
		if not Arena.enabled() and player.Character == character then
			dress(character, Config.Presets[session.Preset])
		end
	end)
end

function Opening.prepareCharacter(player, character)
	if Arena.enabled() then
		character:PivotTo(CFrame.new(require(Shared.Configuration.DevelopmentSandbox).Spawn))
		return
	end
	local session = sessions[player]
	if not session then
		return
	end
	dress(character, Config.Presets[session.Preset])
	if not session.Complete then
		local position = Spawn.ground(Plan.Nodes[Config.Opening.Node] + Config.Opening.Offset, 5, 3)
		if position then
			character:PivotTo(CFrame.new(position))
		end
		character.HumanoidRootPart.Anchored = true
	end
end

function Opening.start(folder, feedback)
	local choice = Instance.new("RemoteEvent")
	choice.Name, choice.Parent = "OpeningChoice", folder
	choice.OnServerEvent:Connect(function(player, preset, path)
		local session = sessions[player]
		if not session or session.Complete or os.clock() - session.LastRequest < 0.5 then
			return
		end
		session.LastRequest = os.clock()
		if typeof(preset) ~= "number" or preset % 1 ~= 0 or not Config.Presets[preset] then
			return
		end
		if path ~= "Melee" and path ~= "Magic" then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not player:GetAttribute("CharacterReady") or not humanoid or humanoid.Health <= 0 then
			return
		end
		if not Equipment.chooseStarter(player, path, feedback) then
			return
		end
		session.Preset, session.Complete = preset, true
		character.HumanoidRootPart.Anchored = false
		character.HumanoidRootPart:SetNetworkOwner(player)
		dress(character, Config.Presets[preset])
		player:SetAttribute("AppearancePreset", preset)
		player:SetAttribute("OpeningComplete", true)
	end)
end
function Opening.remove(player)
	local session = sessions[player]
	if session then
		session.Connection:Disconnect()
	end
	sessions[player] = nil
end
return Opening
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="154">
          <Properties>
            <string name="Name">SandboxService</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local World = require(Shared.Configuration.LowerLayerGraybox)
local Locations = require(Shared.Configuration.AssignmentLocations)
local Graybox = require(script.Parent.Parent.Development.LowerLayerGraybox)
local Sandbox = {}

function Sandbox.start()
	Graybox.start()
	local signs = Instance.new("Folder")
	signs.Name = "DistrictSigns"
	signs.Parent = workspace
	for id, location in Locations do
		if id ~= "Underground_Junction" then
			local sign = Instance.new("Part")
			sign.Name = "Sign_" .. id
			sign.Size = Vector3.new(8, 3, 0.25)
			sign.CFrame = CFrame.new(location.Position + Vector3.new(0, 7, -4))
			sign.Anchored, sign.CanCollide, sign.Material = true, false, Enum.Material.Metal
			sign.Color = Color3.fromRGB(45, 48, 52)
			sign.Parent = signs
			local surface = Instance.new("SurfaceGui")
			surface.Face, surface.CanvasSize = Enum.NormalId.Front, Vector2.new(400, 150)
			surface.Parent = sign
			local text = Instance.new("TextLabel")
			text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 1
			text.Text, text.TextColor3, text.Font, text.TextScaled =
				location.Name:upper(), Color3.new(1, 1, 1), Enum.Font.GothamBold, true
			text.Parent = surface
		end
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "RecruitSpawnLocation"
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.Position = World.PhaseA.RecruitSpawn
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = workspace

	local earth = Instance.new("Part")
	earth.Name = "EarthMagicMaterial"
	earth.Size = Vector3.new(6, 3, 6)
	earth.Position = Vector3.new(-70, 1.5, 1460)
	earth.Anchored = true
	earth.Material = Enum.Material.Slate
	earth.Color = Color3.fromRGB(100, 75, 55)
	earth:SetAttribute("MagicMaterial", "Earth")
	earth:SetAttribute("AvailableAmount", 50)
	earth.Parent = workspace
	CollectionService:AddTag(earth, "MagicMaterialSource")
	local water = Instance.new("Part")
	water.Name = "WaterMagicMaterial"
	water.Size = Vector3.new(6, 3, 6)
	water.Position = Vector3.new(-60, 1.5, 1460)
	water.Anchored = true
	water.Material = Enum.Material.Glass
	water.Color = Color3.fromRGB(65, 150, 185)
	water.Transparency = 0.28
	water:SetAttribute("MagicMaterial", "Water")
	water:SetAttribute("AvailableAmount", 50)
	water.Parent = workspace
	CollectionService:AddTag(water, "MagicMaterialSource")
	local metal = Instance.new("Part")
	metal.Name = "MetalMagicMaterial"
	metal.Size = Vector3.new(6, 3, 6)
	metal.Position = Vector3.new(-50, 1.5, 1460)
	metal.Anchored = true
	metal.Material = Enum.Material.Metal
	metal.Color = Color3.fromRGB(105, 115, 124)
	metal:SetAttribute("MagicMaterial", "Metal")
	metal:SetAttribute("AvailableAmount", 50)
	metal:SetAttribute("MagicRaise", true)
	metal.Parent = workspace
	CollectionService:AddTag(metal, "MagicMaterialSource")
	CollectionService:AddTag(metal, "MagicManipulable")
	local wood = Instance.new("Part")
	wood.Name = "WoodMagicMaterial"
	wood.Size = Vector3.new(6, 3, 6)
	wood.Position = Vector3.new(-40, 1.5, 1460)
	wood.Anchored = true
	wood.Material = Enum.Material.WoodPlanks
	wood.Color = Color3.fromRGB(112, 77, 48)
	wood:SetAttribute("MagicMaterial", "Wood")
	wood:SetAttribute("AvailableAmount", 50)
	wood:SetAttribute("MagicRaise", true)
	wood.Parent = workspace
	CollectionService:AddTag(wood, "MagicMaterialSource")
	CollectionService:AddTag(wood, "MagicManipulable")
	local manipulable = Instance.new("Part")
	manipulable.Name = "EarthRaiseStone"
	manipulable.Size = Vector3.new(5, 2, 5)
	manipulable.Position = Vector3.new(75, 1, 1460)
	manipulable.Anchored = true
	manipulable.Material = Enum.Material.Slate
	manipulable.Color = Color3.fromRGB(90, 105, 80)
	manipulable:SetAttribute("MagicMaterial", "Earth")
	manipulable:SetAttribute("MagicRaise", true)
	manipulable.Parent = workspace
	CollectionService:AddTag(manipulable, "MagicManipulable")
	local movableTarget = Instance.new("Part")
	movableTarget.Name = "MagicMovableObjectTarget"
	movableTarget.Size = Vector3.new(4, 3, 4)
	movableTarget.Position = Vector3.new(86, 1.5, 1460)
	movableTarget.Anchored = false
	movableTarget.Material = Enum.Material.WoodPlanks
	movableTarget.Color = Color3.fromRGB(91, 62, 39)
	movableTarget.Parent = workspace
	CollectionService:AddTag(movableTarget, "MagicManipulable")
	local movableLabel = Instance.new("BillboardGui")
	movableLabel.Size = UDim2.fromOffset(210, 30)
	movableLabel.StudsOffset = Vector3.new(0, 3, 0)
	movableLabel.AlwaysOnTop = true
	movableLabel.Parent = movableTarget
	local movableText = Instance.new("TextLabel")
	movableText.Size = UDim2.fromScale(1, 1)
	movableText.BackgroundTransparency = 1
	movableText.TextColor3 = Color3.new(1, 1, 1)
	movableText.TextStrokeTransparency = 0
	movableText.Text = "Movable object (Force / Control)"
	movableText.Parent = movableLabel
	local label = Instance.new("BillboardGui")
	label.Size = UDim2.fromOffset(180, 30)
	label.StudsOffset = Vector3.new(0, 3, 0)
	label.AlwaysOnTop = true
	label.Parent = earth
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0
	text.Text = "Earth source (Stone Shot)"
	text.Parent = label
	local waterLabel = Instance.new("BillboardGui")
	waterLabel.Size = UDim2.fromOffset(180, 30)
	waterLabel.StudsOffset = Vector3.new(0, 3, 0)
	waterLabel.AlwaysOnTop = true
	waterLabel.Parent = water
	local waterText = Instance.new("TextLabel")
	waterText.Size = UDim2.fromScale(1, 1)
	waterText.BackgroundTransparency = 1
	waterText.TextColor3 = Color3.new(1, 1, 1)
	waterText.TextStrokeTransparency = 0
	waterText.Text = "Water source (Matter Projectile)"
	waterText.Parent = waterLabel
	for _, source in { { metal, "Metal source (Earth affinity)" }, { wood, "Wood source (Earth affinity)" } } do
		local sourceLabel = Instance.new("BillboardGui")
		sourceLabel.Size = UDim2.fromOffset(190, 30)
		sourceLabel.StudsOffset = Vector3.new(0, 3, 0)
		sourceLabel.AlwaysOnTop = true
		sourceLabel.Parent = source[1]
		local sourceText = Instance.new("TextLabel")
		sourceText.Size = UDim2.fromScale(1, 1)
		sourceText.BackgroundTransparency = 1
		sourceText.TextColor3 = Color3.new(1, 1, 1)
		sourceText.TextStrokeTransparency = 0
		sourceText.Text = source[2]
		sourceText.Parent = sourceLabel
	end
end

return Sandbox
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="155">
          <Properties>
            <string name="Name">SandboxStressService</string>
            <string name="Source"><![CDATA[--!strict

-- Temporary wave/performance harness. No persistence, rewards, or difficulty scaling.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sandbox = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local Topology = require(Shared:WaitForChild("Configuration"):WaitForChild("PhaseATopology"))
local Config = Sandbox.StressTest
local Enemy = require(script.Parent.EnemyService)
local StressTest = {}
local COLLISION_GROUP = "SandboxStressEnemies"

type Entry = { Handle: Enemy.Handle, Alive: boolean, RemoveAt: number }

function StressTest.start()
	assert(not workspace:FindFirstChild("SandboxStressTest"), "Sandbox stress test already running")
	assert(#Config.WaveSizes > 0, "Configure at least one wave")
	assert(Config.PathStartsPerSecond > 0 and Config.MaxPathsInFlight >= 1, "Invalid path budget")
	assert(Config.MaxPathsInFlight % 1 == 0 and Config.HitQueryRate > 0, "Invalid path concurrency/hit rate")
	assert(Config.MinSpawnSpacing > 0 and Config.SpawnCandidateMinimumDistance > 0, "Invalid spawn layout")
	assert(Config.SpawnCandidateMaximumDistance > Config.SpawnCandidateMinimumDistance, "Invalid spawn distance range")
	assert(Config.InterWaveDelay >= 0 and Config.CorpseLifetime >= 0, "Invalid wave timing")
	for _, count in Config.WaveSizes do
		assert(count >= 1 and count % 1 == 0, "Wave sizes must be positive integers")
	end
	if not PhysicsService:IsCollisionGroupRegistered(COLLISION_GROUP) then
		PhysicsService:RegisterCollisionGroup(COLLISION_GROUP)
	end
	PhysicsService:CollisionGroupSetCollidable(COLLISION_GROUP, COLLISION_GROUP, Config.EnemyCollisions)
	-- Roblox characters and the baseplate retain Default: body-blocking players is intentional.
	PhysicsService:CollisionGroupSetCollidable(COLLISION_GROUP, "Default", true)
	local visuals = Sandbox.Enemy.VisualCollisionGroup
	local query = Sandbox.Combat.OverlapCollisionGroup
	for _, group in { visuals, query } do
		if not PhysicsService:IsCollisionGroupRegistered(group) then
			PhysicsService:RegisterCollisionGroup(group)
		end
	end
	-- Only the hull blocks physical movement, even if Humanoid toggles a limb's CanCollide.
	PhysicsService:CollisionGroupSetCollidable(visuals, "Default", false)
	PhysicsService:CollisionGroupSetCollidable(visuals, COLLISION_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(visuals, visuals, false)
	-- Attack overlaps see the normal rig, not the taller anti-climb hull.
	PhysicsService:CollisionGroupSetCollidable(query, "Default", true)
	PhysicsService:CollisionGroupSetCollidable(query, visuals, true)
	PhysicsService:CollisionGroupSetCollidable(query, COLLISION_GROUP, false)

	local folder = Instance.new("Folder")
	folder.Name = "SandboxStressTest"
	local enemies = Instance.new("Folder")
	enemies.Name = "Enemies"
	enemies.Parent = folder
	local entries: { Entry } = {}
	local wave, living = 0, 0
	local phase = "Waiting"
	local nextWaveAt = os.clock()
	local nextPathStart = 0
	local inFlight, startedPaths, pathCursor = 0, 0, 0
	local nextMetrics = 0
	local stopped = false
	local heartbeat: RBXScriptConnection? = nil
	local destroying: RBXScriptConnection? = nil

	local function publish()
		folder:SetAttribute("Wave", wave)
		folder:SetAttribute("TotalWaves", #Config.WaveSizes)
		folder:SetAttribute("LivingEnemies", living)
		folder:SetAttribute("Status", phase)
		folder:SetAttribute("NextWaveAt", workspace:GetServerTimeNow() + math.max(0, nextWaveAt - os.clock()))
	end
	publish()
	folder:SetAttribute("PathsInFlight", 0)
	folder:SetAttribute("PathsStarted", 0)
	folder:SetAttribute("PendingPaths", 0)
	folder.Parent = workspace

	local function clearWave()
		for _, entry in entries do
			entry.Handle.Destroy()
		end
		table.clear(entries)
		pathCursor = 0
	end

	local candidateCursor = 0
	local function positions(count: number): { Vector3 }?
		local protected = { Sandbox.Dummy.Position }
		local spawn = workspace:FindFirstChild("SandboxSpawn")
		if spawn and spawn:IsA("BasePart") then
			table.insert(protected, spawn.Position)
		end
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if root and root:IsA("BasePart") then
				table.insert(protected, root.Position)
			end
		end
		local overlap = OverlapParams.new()
		overlap.FilterType = Enum.RaycastFilterType.Exclude
		overlap.FilterDescendantsInstances = { folder }
		overlap.RespectCanCollide = true
		local graybox = workspace:FindFirstChild("LowerLayerGraybox")
		local debugFolder = if graybox then graybox:FindFirstChild("Debug") else nil
		local function groundedPosition(candidate: Vector3): Vector3?
			if not graybox then
				return nil
			end
			local ray = RaycastParams.new()
			ray.FilterType = Enum.RaycastFilterType.Exclude
			ray.FilterDescendantsInstances = { folder }
			ray.RespectCanCollide = true
			-- Probe around the authored route height. The old 140-stud probe began
			-- above the surface and therefore hit it before an underground floor.
			local origin = candidate + Vector3.new(0, Config.GroundProbeHeight, 0)
			local hit = workspace:Raycast(origin, Vector3.new(0, -Config.GroundProbeDistance, 0), ray)
			if
				not hit
				or hit.Normal.Y < 0.9
				or not hit.Instance:IsDescendantOf(graybox)
				or (debugFolder and hit.Instance:IsDescendantOf(debugFolder))
			then
				return nil
			end
			local rootHeight = Sandbox.Enemy.CollisionHull.Height / 2 - Sandbox.Enemy.CollisionHull.CenterOffsetY
			return hit.Position + Vector3.new(0, rootHeight + Config.GroundClearance, 0)
		end
		local available: { { Position: Vector3, Score: number } } = {}
		for _, candidate in Topology.SpawnCandidates do
			local source = (candidate.Position or Topology.Nodes[candidate.Node]) + candidate.Offset
			local position = groundedPosition(source)
			if position then
				local closest = math.huge
				for _, point in protected do
					local delta = position - point
					closest = math.min(closest, Vector3.new(delta.X, 0, delta.Z).Magnitude)
				end
				local valid = closest >= math.max(Config.SpawnCandidateMinimumDistance, Config.SpawnClearance)
					and closest <= Config.SpawnCandidateMaximumDistance
				if
					valid
					and #workspace:GetPartBoundsInBox(
							CFrame.new(position + Vector3.new(0, Sandbox.Enemy.CollisionHull.CenterOffsetY, 0)),
							Vector3.new(5, Sandbox.Enemy.CollisionHull.Height - 0.2, 5),
							overlap
						)
						> 0
				then
					valid = false
				end
				if valid then
					table.insert(available, { Position = position, Score = closest })
				end
			end
		end
		table.sort(available, function(left, right)
			return left.Score < right.Score
		end)
		local result: { Vector3 } = {}
		if #available > 0 then
			candidateCursor = candidateCursor % #available
			for offset = 1, #available do
				local candidate = available[(candidateCursor + offset - 1) % #available + 1]
				local spaced = true
				for _, chosen in result do
					if (candidate.Position - chosen).Magnitude < Config.MinSpawnSpacing then
						spaced = false
						break
					end
				end
				if spaced then
					table.insert(result, candidate.Position)
					if #result == count then
						candidateCursor += offset
						return result
					end
				end
			end
		end
		return nil -- Candidates retry later instead of placing enemies inside characters/walls.
	end

	local function startWave(now: number)
		clearWave()
		local locations = positions(Config.WaveSizes[wave + 1])
		if not locations then
			phase = "Blocked"
			nextWaveAt = now + math.max(1, Config.InterWaveDelay)
			publish()
			return
		end
		wave += 1
		for index, position in locations do
			local handle = Enemy.create(
				position,
				enemies,
				COLLISION_GROUP,
				(index - 1) * Sandbox.Enemy.ThinkInterval / #locations,
				1 / Config.HitQueryRate
			)
			handle.Model.Name = string.format("Enfleshed_W%d_%02d", wave, index)
			handle.Model:SetAttribute("SandboxLabel", string.format("Enfleshed %02d", index))
			table.insert(entries, { Handle = handle, Alive = true, RemoveAt = math.huge })
		end
		living = #entries
		phase = "Active"
		publish()
	end

	destroying = folder.Destroying:Connect(function()
		stopped = true
		if heartbeat then
			heartbeat:Disconnect()
		end
		clearWave()
		if destroying then
			destroying:Disconnect()
		end
	end)

	heartbeat = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		local changed = false
		for _, entry in entries do
			if entry.Alive then
				entry.Handle.Update(now)
				if not entry.Handle.IsAlive() then
					entry.Alive = false
					entry.RemoveAt = now + Config.CorpseLifetime
					living -= 1
					changed = true
				end
			elseif now >= entry.RemoveAt then
				entry.Handle.Destroy()
				entry.RemoveAt = math.huge
			end
		end
		if phase == "Active" and living == 0 then
			phase = if wave == #Config.WaveSizes then "Complete" else "Waiting"
			nextWaveAt = now + Config.InterWaveDelay
			changed = true
		end
		if changed then
			publish()
		end
		if (phase == "Waiting" or phase == "Blocked") and now >= nextWaveAt then
			startWave(now)
		end

		-- Round-robin admission: no catch-up burst after a slow frame, and no per-enemy coroutines waiting for slots.
		if phase == "Active" and now >= nextPathStart and inFlight < Config.MaxPathsInFlight then
			for _ = 1, #entries do
				pathCursor = pathCursor % #entries + 1
				local entry = entries[pathCursor]
				local job = if entry.Alive then entry.Handle.TakePathJob() else nil
				if job then
					inFlight += 1
					startedPaths += 1
					nextPathStart = now + 1 / Config.PathStartsPerSecond
					task.spawn(function()
						local ok, err = pcall(job)
						inFlight -= 1
						if not ok then
							warn("Sandbox path computation failed: " .. tostring(err))
						end
						if not stopped then
							folder:SetAttribute("PathsInFlight", inFlight)
						end
					end)
					break
				end
			end
		end
		if now >= nextMetrics then
			nextMetrics = now + Sandbox.Enemy.ThinkInterval
			local pending = 0
			for _, entry in entries do
				if entry.Alive and entry.Handle.HasPendingPath() then
					pending += 1
				end
			end
			folder:SetAttribute("PendingPaths", pending)
			folder:SetAttribute("PathsInFlight", inFlight)
			folder:SetAttribute("PathsStarted", startedPaths)
		end
		if phase == "Complete" then
			local corpsesRemain = false
			for _, entry in entries do
				if entry.RemoveAt < math.huge then
					corpsesRemain = true
					break
				end
			end
			if not corpsesRemain then
				clearWave()
				if heartbeat then
					heartbeat:Disconnect()
				end
			end
		end
	end)
end

return StressTest
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="156">
          <Properties>
            <string name="Name">SummonService</string>
            <string name="Source"><![CDATA[--!strict

-- Bounded owner/lifetime manager for magic summons. The first archetype is a
-- non-colliding protector familiar; command behavior stays in this focused service.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.MagicSummons)
local Damage = require(script.Parent.DamageService)
local Presentation = require(script.Parent.MagicPresentation)
local Conditions = require(script.Parent.MagicConditions)
local CommandSpec = require(script.Parent.MagicCommandSpec)
local RolePolicy = require(Shared.Modules.MagicSummonRolePolicy)
local Placement = require(script.Parent.MagicSummonPlacement)

type SummonRecord = {
	Owner: Player,
	Caster: Model,
	SpellId: string,
	Archetype: string,
	Role: string,
	Index: number,
	Id: number,
	SpellSlot: number?,
	Color: Color3,
	SpawnPosition: Vector3?,
	Model: Model?,
	Humanoid: Humanoid?,
	NextTargetScan: number,
	NextAttack: number,
	Target: Model?,
	HoldPosition: Vector3?,
	MoveOffset: Vector3,
	Command: string?,
	CommandTarget: Model?,
	CommandPosition: Vector3?,
	PatrolPoints: { Vector3 }?,
	PatrolIndex: number,
	DeathConnection: RBXScriptConnection?,
	HealthConnection: RBXScriptConnection?,
	ModelAncestryConnection: RBXScriptConnection?,
	SpellProfile: any?,
	SpellProfileReason: string?,
	SpellStatus: string?,
	SpellStatusReason: string?,
	TargetSearchReason: string?,
	SpellCastUntil: number,
	CommandIssued: boolean,
}

type SummonGroup = {
	Owner: Player,
	Caster: Model,
	SpellId: string,
	Archetype: string,
	Role: string,
	SpawnAt: string,
	Color: Color3,
	Slots: { SummonRecord },
	Command: string,
	CommandIssued: boolean,
	CommandTarget: Model?,
	CommandPosition: Vector3?,
	PatrolPoints: { Vector3 }?,
	ExpiresAt: number,
	PersistAcrossRespawn: boolean,
	RespawnDeadline: number?,
	LastCapacityNotice: number,
	SourceDefinition: any,
	SourceRemote: RemoteEvent,
	SourceDirection: Vector3,
	SourcePotency: number,
	CasterDeathConnection: RBXScriptConnection?,
}
type CompanionCaster = (
	Player,
	Model,
	number,
	number,
	Model,
	RemoteEvent
) -> (boolean, number, boolean, string?, number?)
type CompanionProfileGetter = (Player, number) -> (any?, string?)
type CommandExecutor = (Player, Model, any, RemoteEvent, Vector3, number, string, { Humanoid }) -> ()

local Summons = {}
local groups: { SummonGroup } = {}
local dismissedGroups: { [Player]: { [string]: boolean } } = {}
local dismissAllUntilCast: { [Player]: boolean } = {}
local rearmedAfterDismiss: { [Player]: { [string]: boolean } } = {}
local folder: Folder?
local started = false
local nextRecordId = 0
local castCompanionSpell: ((Player, Model, number, number, Model) -> (boolean, number, boolean, string?, number?))? =
	nil
local getCompanionProfile: CompanionProfileGetter? = nil
local executeCommandEvent: CommandExecutor? = nil

local function setSpellStatus(record: SummonRecord, status: string, reason: string?)
	local model = record.Model
	if not model or not model.Parent then
		return
	end
	if record.SpellStatus ~= status or record.SpellStatusReason ~= reason then
		record.SpellStatus = status
		record.SpellStatusReason = reason
		model:SetAttribute("MagicSummonSpellStatus", status)
		model:SetAttribute("MagicSummonSpellReason", reason or "")
	end
	if model:GetAttribute("MagicSummonSpellSlot") ~= (record.SpellSlot or 0) then
		model:SetAttribute("MagicSummonSpellSlot", record.SpellSlot or 0)
	end
	if record.Target and record.Target.Parent then
		if model:GetAttribute("MagicSummonSpellTarget") ~= record.Target.Name then
			model:SetAttribute("MagicSummonSpellTarget", record.Target.Name)
		end
	else
		if model:GetAttribute("MagicSummonSpellTarget") ~= "" then
			model:SetAttribute("MagicSummonSpellTarget", "")
		end
	end
end

local function liveCount(owner: Player?): number
	local count = 0
	for _, group in groups do
		if not owner or group.Owner == owner then
			for _, record in group.Slots do
				if record.Model and record.Model:IsDescendantOf(workspace) then
					count += 1
				end
			end
		end
	end
	return count
end

local function refreshOwnerCount(owner: Player)
	if owner.Parent == Players then
		owner:SetAttribute("ActiveMagicSummons", liveCount(owner))
	end
end

local findGroup: (Player, string) -> (SummonGroup?, number?)

local function removeModel(record: SummonRecord)
	if record.ModelAncestryConnection then
		record.ModelAncestryConnection:Disconnect()
		record.ModelAncestryConnection = nil
	end
	if record.DeathConnection then
		record.DeathConnection:Disconnect()
		record.DeathConnection = nil
	end
	if record.HealthConnection then
		record.HealthConnection:Disconnect()
		record.HealthConnection = nil
	end
	if record.Model then
		record.Model:Destroy()
		record.Model = nil
		record.Humanoid = nil
	end
end

local function removeGroupAt(index: number)
	local group = table.remove(groups, index)
	if not group then
		return
	end
	if group.CasterDeathConnection then
		group.CasterDeathConnection:Disconnect()
		group.CasterDeathConnection = nil
	end
	for _, record in group.Slots do
		removeModel(record)
	end
	refreshOwnerCount(group.Owner)
end

local function bindGroupToCharacter(group: SummonGroup, caster: Model, now: number)
	if group.CasterDeathConnection then
		group.CasterDeathConnection:Disconnect()
		group.CasterDeathConnection = nil
	end
	group.Caster = caster
	group.RespawnDeadline = nil
	for _, record in group.Slots do
		record.Caster = caster
		record.Target = nil
		record.NextTargetScan = now
		record.NextAttack = now
		record.SpellCastUntil = 0
		setSpellStatus(record, if record.SpellSlot then "SEARCHING" else "UNASSIGNED", nil)
	end
	if not group.PersistAcrossRespawn then
		local humanoid = caster:FindFirstChildOfClass("Humanoid")
		if humanoid then
			group.CasterDeathConnection = humanoid.Died:Connect(function()
				local _, index = findGroup(group.Owner, group.SpellId)
				if index then
					removeGroupAt(index)
				end
			end)
		end
	end
end

findGroup = function(owner: Player, spellId: string): (SummonGroup?, number?)
	for index, group in groups do
		if group.Owner == owner and group.SpellId == spellId then
			return group, index
		end
	end
	return nil, nil
end

local function setNoCollision(part: BasePart, canQuery: boolean)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = canQuery
	part.Massless = true
end

local function makeSummonModel(record: SummonRecord, position: Vector3, archetype)
	local model = Instance.new("Model")
	model.Name = archetype.ModelName
	model:SetAttribute("MagicSummon", true)
	model:SetAttribute("MagicSummonId", record.Id)
	model:SetAttribute("MagicSummonArchetype", record.Archetype)
	model:SetAttribute("MagicSummonRole", record.Role)
	model:SetAttribute("MagicSummonOwnerUserId", record.Owner.UserId)
	model:SetAttribute("MagicSummonSpellId", record.SpellId)
	model:SetAttribute("MagicSummonSpellSlot", record.SpellSlot or 0)
	model:SetAttribute("MagicSummonSpellStatus", if record.SpellSlot then "SEARCHING" else "UNASSIGNED")
	model:SetAttribute("MagicSummonSpellReason", "")
	model:SetAttribute("MagicSummonSpellTarget", "")
	CollectionService:AddTag(model, "MagicAllyTarget")
	model:SetAttribute("SandboxAlignment", "Ally")

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(1, 1, 1)
	root.Transparency = 1
	root.CFrame = CFrame.new(position)
	setNoCollision(root, false)
	root.Parent = model
	model.PrimaryPart = root

	local core = Instance.new("Part")
	core.Name = archetype.CorePartName
	core.Shape = Enum.PartType[archetype.CoreShape]
	core.Size = Vector3.one * archetype.CoreSize
	core.CFrame = root.CFrame
	core.Material = Enum.Material[archetype.CoreMaterial] or Enum.Material.Neon
	core.Color = record.Color
	core.Transparency = 0.08
	setNoCollision(core, true)
	core.Parent = model
	for index = 1, archetype.ArmorPlateCount do
		local angle = (index - 1) * math.pi * 2 / archetype.ArmorPlateCount
		local plate = Instance.new("Part")
		plate.Name = "SummonArmorPlate"
		plate.Size = Vector3.new(archetype.ArmorPlateThickness, archetype.ArmorPlateHeight, archetype.ArmorPlateWidth)
		plate.CFrame = root.CFrame
			* CFrame.new(
				math.cos(angle) * archetype.ArmorPlateDistance,
				0,
				math.sin(angle) * archetype.ArmorPlateDistance
			)
			* CFrame.Angles(0, -angle, math.rad(7))
		plate.Material = Enum.Material.Metal
		plate.Color = record.Color:Lerp(Color3.fromRGB(42, 47, 56), 0.48)
		setNoCollision(plate, false)
		plate.Parent = model
	end
	local light = Instance.new("PointLight")
	light.Color = record.Color
	light.Range = archetype.LightRange
	light.Brightness = archetype.LightBrightness
	light.Parent = core
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "SummonSparks"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(record.Color)
	emitter.LightEmission = 0.8
	emitter.Lifetime = NumberRange.new(0.3, 0.7)
	emitter.Speed = NumberRange.new(0.3, 1.4)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.22), NumberSequenceKeypoint.new(1, 0) })
	emitter.Rate = archetype.ParticleRate
	emitter.Parent = core

	for index = 1, archetype.MoteCount do
		local angle = (index - 1) * math.pi * 2 / archetype.MoteCount
		local mote = Instance.new("Part")
		mote.Name = "SummonMote"
		mote.Shape = Enum.PartType.Ball
		mote.Size = Vector3.one * archetype.MoteSize
		mote.CFrame = root.CFrame
			* CFrame.new(math.cos(angle) * archetype.MoteDistance, 0, math.sin(angle) * archetype.MoteDistance)
		mote.Material = Enum.Material.Neon
		mote.Color = Color3.new(1, 1, 1)
		setNoCollision(mote, false)
		mote.Parent = model
		mote:SetAttribute("OrbitIndex", index)
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "Humanoid"
	humanoid.RequiresNeck = false
	humanoid.MaxHealth = archetype.Health
	humanoid.Health = archetype.Health
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model

	local gui = Instance.new("BillboardGui")
	gui.Name = "SummonNameplate"
	gui.Adornee = core
	gui.Size = UDim2.fromOffset(150, 34)
	gui.StudsOffset = Vector3.new(0, 1.35, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 100
	gui.Parent = core
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, 0, 0, 22)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 12
	label.TextColor3 = Color3.fromRGB(214, 235, 255)
	label.TextStrokeTransparency = 0.35
	label.Text = string.upper(archetype.Label)
	label.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "HealthFill"
	fill.Position = UDim2.fromOffset(22, 24)
	fill.Size = UDim2.new(1, -44, 0, 5)
	fill.BackgroundColor3 = Color3.fromRGB(39, 48, 59)
	fill.BorderSizePixel = 0
	fill.Parent = gui
	local health = Instance.new("Frame")
	health.Name = "CurrentHealth"
	health.Size = UDim2.fromScale(1, 1)
	health.BackgroundColor3 = Color3.fromRGB(110, 192, 255)
	health.BorderSizePixel = 0
	health.Parent = fill
	record.HealthConnection = humanoid.HealthChanged:Connect(function(value)
		health.Size = UDim2.fromScale(math.clamp(value / humanoid.MaxHealth, 0, 1), 1)
	end)

	model.Parent = folder
	model:PivotTo(CFrame.new(position))
	record.Model = model
	record.Humanoid = humanoid
	record.ModelAncestryConnection = model.AncestryChanged:Connect(function()
		if record.Model == model and not model:IsDescendantOf(workspace) then
			-- External removal must release health/death listeners immediately. Keep
			-- the slot empty until group expiry so repeated pulses cannot respawn it.
			removeModel(record)
			refreshOwnerCount(record.Owner)
		end
	end)
	record.DeathConnection = humanoid.Died:Connect(function()
		-- Keep the slot reserved until expiry; repeated Field/Aura pulses must not
		-- turn one cast into an unlimited respawn loop.
		removeModel(record)
		refreshOwnerCount(record.Owner)
	end)
end

local function canSee(record: SummonRecord, target: Model, from: Vector3, to: Vector3): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { record.Model, record.Caster }
	params.RespectCanCollide = true
	local hit = workspace:Raycast(from, to - from, params)
	return not hit or hit.Instance:IsDescendantOf(target)
end

local function isHostileTarget(candidate: Model): boolean
	return CollectionService:HasTag(candidate, "Enfleshed") or CollectionService:HasTag(candidate, "MagicHostileTarget")
end

local function scanSupportTarget(record: SummonRecord, core: BasePart, archetype, profile: any): Model?
	local best: Model? = nil
	local bestScore = math.huge
	local candidates: { Model } = {}
	local seen: { [Model]: boolean } = {}
	local function addCandidate(candidate: Model?)
		if candidate and not seen[candidate] then
			seen[candidate] = true
			table.insert(candidates, candidate)
		end
	end
	for _, player in Players:GetPlayers() do
		addCandidate(player.Character)
	end
	for _, candidate in CollectionService:GetTagged("MagicAllyTarget") do
		if candidate:IsA("Model") then
			addCandidate(candidate)
		end
	end
	for _, candidate in candidates do
		local humanoid = candidate and candidate:FindFirstChildOfClass("Humanoid")
		local root = candidate and candidate:FindFirstChild("HumanoidRootPart")
		if
			candidate
			and candidate:IsDescendantOf(workspace)
			and humanoid
			and humanoid.Health > 0
			and root
			and root:IsA("BasePart")
			and Conditions.relationshipMatches(record.Model, candidate, "Ally")
		then
			local distance = (root.Position - core.Position).Magnitude
			local missingHealth = profile.CanHeal and humanoid.Health < humanoid.MaxHealth
			local shield = humanoid:GetAttribute("MagicShield")
			local needsShield = profile.CanShield and (type(shield) ~= "number" or shield < profile.ShieldAmount)
			local armorBase = humanoid:GetAttribute("MagicArmor")
			local armorBonus = humanoid:GetAttribute("MagicArmorBonus")
			local armor = (if type(armorBase) == "number" then armorBase else 0)
				+ (if type(armorBonus) == "number" then armorBonus else 0)
			local needsArmor = profile.CanModifyAttribute and armor < profile.ArmorAmount
			local currentTimeRate = humanoid:GetAttribute("MagicTimeRate")
			local needsTimeDilation = profile.CanTimeDilation
				and math.abs((if type(currentTimeRate) == "number" then currentTimeRate else 1) - profile.TimeRate)
					> 0.05
			if
				distance
					<= RolePolicy.targetScanRange(profile.Range, archetype.SearchRadius, Config.CommandChaseRange)
				and (missingHealth or needsShield or needsArmor or needsTimeDilation)
				and canSee(record, candidate, core.Position, root.Position)
			then
				local healthRatio = humanoid.Health / math.max(1, humanoid.MaxHealth)
				local score = if missingHealth
					then healthRatio
					elseif needsArmor then 0.9
					elseif needsTimeDilation then 1
					else 1.1
				if score < bestScore then
					best, bestScore = candidate, score
				end
			end
		end
	end
	return best
end

local function scanTarget(
	record: SummonRecord,
	group: SummonGroup,
	now: number,
	archetype,
	ownerRoot: BasePart,
	profile: any?
): (Model?, string?)
	if now < record.NextTargetScan then
		return record.Target, record.TargetSearchReason
	end
	record.NextTargetScan = now + Config.TargetScanInterval
	local model = record.Model
	local coreName = archetype.CorePartName
	local core = model and model:FindFirstChild(coreName)
	if not core or not core:IsA("BasePart") then
		record.TargetSearchReason = "Summon core is unavailable"
		return nil, record.TargetSearchReason
	end
	local command = record.Command or group.Command
	local commandTarget = if record.Command ~= nil then record.CommandTarget else group.CommandTarget
	if command == "Hold" or command == "Move" or command == "Patrol" then
		record.Target = nil
		record.TargetSearchReason = nil
		return nil, nil
	end
	local role = Config.Roles[group.Role] or Config.Roles[Config.DefaultRole]
	local targetMode = RolePolicy.targetMode(role, command, profile and profile.Mode)
	if targetMode == "Ally" then
		record.Target = scanSupportTarget(record, core, archetype, profile)
		record.TargetSearchReason = if record.Target then nil else "No visible ally currently needs this support spell"
		return record.Target, record.TargetSearchReason
	end
	if targetMode == "None" then
		record.Target = nil
		record.TargetSearchReason = nil
		return record.Target, nil
	end
	if command == "Follow" then
		record.Target = nil
		record.TargetSearchReason = nil
		return nil, nil
	elseif command == "Attack" then
		local target = commandTarget
		local humanoid = target and target:FindFirstChildOfClass("Humanoid")
		local root = target and target:FindFirstChild("HumanoidRootPart")
		if
			target
			and target:IsDescendantOf(workspace)
			and isHostileTarget(target)
			and humanoid
			and humanoid.Health > 0
			and root
			and root:IsA("BasePart")
		then
			local distance = (root.Position - core.Position).Magnitude
			if distance <= Config.CommandChaseRange and canSee(record, target, core.Position, root.Position) then
				record.Target = target
				record.TargetSearchReason = nil
				return target, nil
			end
			record.Target = nil
			record.TargetSearchReason = if distance > Config.CommandChaseRange
				then "Marked hostile is beyond summon command range"
				else "Marked hostile is blocked from view"
			return nil, record.TargetSearchReason
		end
		if record.Command ~= nil then
			record.Command = "Protect"
			record.CommandTarget = nil
		else
			group.Command = "Protect"
			group.CommandTarget = nil
			for _, slot in group.Slots do
				slot.Target = nil
			end
		end
	end
	local best, bestDistance =
		nil, RolePolicy.targetScanRange(profile and profile.Range, archetype.SearchRadius, Config.CommandChaseRange)
	local hasTaggedHostile = false
	local hasLivingHostile = false
	local hasHostileInGuardRadius = false
	local hasHostileInScanRange = false
	local hasVisibleHostile = false
	local candidates = CollectionService:GetTagged("Enfleshed")
	for _, candidate in CollectionService:GetTagged("MagicHostileTarget") do
		table.insert(candidates, candidate)
	end
	for _, candidate in candidates do
		if
			candidate:IsA("Model")
			and candidate ~= record.Caster
			and candidate:IsDescendantOf(workspace)
			and isHostileTarget(candidate)
		then
			hasTaggedHostile = true
			local humanoid = candidate:FindFirstChildOfClass("Humanoid")
			local root = candidate:FindFirstChild("HumanoidRootPart")
			if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
				hasLivingHostile = true
				local distance = (root.Position - core.Position).Magnitude
				local protectingDistance = (root.Position - ownerRoot.Position).Magnitude
				local insideGuardRadius = not RolePolicy.requiresOwnerProtectionRadius(role)
					or protectingDistance <= Config.GuardRadius
				if insideGuardRadius then
					hasHostileInGuardRadius = true
				end
				if distance <= bestDistance then
					hasHostileInScanRange = true
					if insideGuardRadius and canSee(record, candidate, core.Position, root.Position) then
						hasVisibleHostile = true
						if distance < bestDistance then
							best, bestDistance = candidate, distance
						end
					end
				end
			end
		end
	end
	record.Target = best
	local reason = if best
		then nil
		else RolePolicy.noHostileTargetReason(role, {
			HasTaggedHostile = hasTaggedHostile,
			HasLivingHostile = hasLivingHostile,
			WithinGuardRadius = hasHostileInGuardRadius,
			WithinScanRange = hasHostileInScanRange,
			Visible = hasVisibleHostile,
		}, Config.GuardRadius)
	record.TargetSearchReason = reason
	return best, reason
end

local function updateRecord(record: SummonRecord, group: SummonGroup, now: number, delta: number, archetype)
	local model = record.Model
	local humanoid = record.Humanoid
	local casterHumanoid = record.Caster:FindFirstChildOfClass("Humanoid")
	local ownerRoot = record.Caster:FindFirstChild("HumanoidRootPart")
	local role = Config.Roles[record.Role] or Config.Roles[Config.DefaultRole]
	if
		not model
		or not model:IsDescendantOf(workspace)
		or not humanoid
		or humanoid.Health <= 0
		or not casterHumanoid
		or casterHumanoid.Health <= 0
		or group.Owner.Character ~= record.Caster
		or not ownerRoot
		or not ownerRoot:IsA("BasePart")
	then
		return
	end
	local core = model:FindFirstChild(archetype.CorePartName)
	if not core or not core:IsA("BasePart") then
		return
	end
	local angle = now * Config.OrbitRate + (record.Index - 1) * math.pi
	local bob = math.sin(now * archetype.BobRate + record.Index) * archetype.BobHeight
	local offset = Vector3.new(
		math.cos(angle) * archetype.FollowDistance,
		archetype.HoverHeight + bob,
		math.sin(angle) * archetype.FollowDistance
	)
	if now >= record.NextTargetScan then
		if record.SpellSlot and getCompanionProfile then
			record.SpellProfile, record.SpellProfileReason = getCompanionProfile(record.Owner, record.SpellSlot)
		else
			record.SpellProfile, record.SpellProfileReason = nil, nil
		end
	end
	local profile = record.SpellProfile
	local command = record.Command or group.Command
	local commandIssued = if record.Command ~= nil then record.CommandIssued else group.CommandIssued
	local commandPosition = if record.Command ~= nil then record.CommandPosition else group.CommandPosition
	local patrolPoints = if record.Command ~= nil then record.PatrolPoints else group.PatrolPoints
	local roleRequirementError: string? = nil
	if role.RequiredCapability and (not profile or profile[role.RequiredCapability] ~= true) then
		roleRequirementError = if role.RequiredCapability == "CanControl"
			then "Controller needs an assigned hostile spell with Slow, Bind, Control, or Displacement"
			else "Assigned companion spell does not meet this role's requirement"
	end
	local commandCastWaiting = profile
		and not CommandSpec.canExecuteCompanionSpell(profile.RequiresCommand, commandIssued, command)
	local target: Model? = nil
	local targetSearchReason: string? = nil
	if roleRequirementError or commandCastWaiting then
		target = nil
		targetSearchReason = nil
	else
		target, targetSearchReason = scanTarget(record, group, now, archetype, ownerRoot, profile)
	end
	local current = model:GetPivot().Position
	local goal = if command == "Hold"
		then record.HoldPosition or current
		elseif command == "Move" and commandPosition then commandPosition + record.MoveOffset + Vector3.new(
			0,
			archetype.HoverHeight + bob,
			0
		)
		elseif command == "Patrol" and patrolPoints and #patrolPoints > 0 then patrolPoints[record.PatrolIndex]
			+ record.MoveOffset
			+ Vector3.new(0, archetype.HoverHeight + bob, 0)
		elseif group.SpawnAt == "Event" and command == "Protect" then (record.SpawnPosition or ownerRoot.Position)
			+ Vector3.new(math.cos(angle) * 1.5, archetype.HoverHeight + bob, math.sin(angle) * 1.5)
		else ownerRoot.CFrame:PointToWorldSpace(offset)
	if command == "Attack" and target then
		local targetRoot = target:FindFirstChild("HumanoidRootPart")
		if targetRoot and targetRoot:IsA("BasePart") then
			goal = targetRoot.Position
				+ Vector3.new(math.cos(angle) * 7, archetype.HoverHeight + bob, math.sin(angle) * 7)
		end
	end
	local alpha = 1 - math.exp(-delta * Config.FollowResponsiveness)
	local nextPosition = current:Lerp(goal, alpha)
	model:PivotTo(CFrame.new(nextPosition))
	if command == "Patrol" and patrolPoints and #patrolPoints > 1 and (goal - current).Magnitude <= 2.5 then
		record.PatrolIndex = if record.PatrolIndex == 1 then 2 else 1
	end

	if not target then
		local status = if roleRequirementError
			then "INVALID SPELL"
			elseif commandCastWaiting then "COMMAND REQUIRED"
			elseif command == "Move" then "MOVING"
			elseif command == "Patrol" then if patrolPoints and #patrolPoints > 1
				then "PATROLLING"
				else "PATROL SET"
			elseif command == "Hold" then "HOLDING"
			elseif command == "Follow" then "FOLLOWING"
			elseif role.TargetMode == "AllySupport" and (not profile or profile.Mode ~= "Ally") then "INVALID SPELL"
			elseif record.SpellSlot and not profile and record.SpellProfileReason then "INVALID SPELL"
			elseif record.SpellSlot then "SEARCHING"
			else "UNASSIGNED"
		local statusReason = if commandCastWaiting
			then "Issue an Attack or Support order to activate this companion spell"
			elseif status == "SEARCHING" or status == "UNASSIGNED" then targetSearchReason
			elseif status ~= "INVALID SPELL" then nil
			elseif roleRequirementError then roleRequirementError
			elseif
				role.TargetMode == "AllySupport" and not record.SpellProfileReason
			then "Medic requires a compatible Ally support spell"
			else record.SpellProfileReason
		setSpellStatus(record, status, statusReason)
		return
	end
	local targetHumanoid = target:FindFirstChildOfClass("Humanoid")
	local targetRoot = target:FindFirstChild("HumanoidRootPart")
	if not targetHumanoid or targetHumanoid.Health <= 0 or not targetRoot or not targetRoot:IsA("BasePart") then
		record.Target = nil
		return
	end
	local distance = (targetRoot.Position - core.Position).Magnitude
	local castRange = RolePolicy.castRange(profile and profile.Range, archetype.AttackRange, Config.CommandChaseRange)
	if distance > castRange then
		setSpellStatus(record, "OUT OF RANGE", "Target is beyond summon attack range")
		return
	end
	if not canSee(record, target, core.Position, targetRoot.Position) then
		setSpellStatus(record, "BLOCKED", "A world obstacle blocks line of sight")
		return
	end
	if now < record.NextAttack then
		if record.SpellStatus == "CASTING" and now < record.SpellCastUntil then
			setSpellStatus(record, "CASTING", record.SpellStatusReason)
			return
		end
		setSpellStatus(
			record,
			if profile then "COOLDOWN" else "MELEE",
			if profile then string.format("Ready in %ds", math.ceil(record.NextAttack - now)) else nil
		)
		return
	end
	if record.SpellSlot and castCompanionSpell then
		local casted, cooldown, assignedSpellUsable, reason, castDuration =
			castCompanionSpell(record.Owner, model, record.SpellSlot, record.Id, target)
		if casted then
			-- MagicService owns spell cooldown progression, including local time rate.
			-- This is only a short retry throttle so summons do not poll every frame.
			record.NextAttack = now + math.max(0.25, Config.TargetScanInterval)
			record.SpellCastUntil = now + (castDuration or 0)
			setSpellStatus(record, "CASTING", "Server cast accepted")
			return
		elseif assignedSpellUsable then
			local lowered = string.lower(reason or "")
			record.NextAttack = now
				+ if string.find(lowered, "cool", 1, true)
					then math.max(0.25, Config.TargetScanInterval)
					else math.max(0.25, cooldown)
			local status = if string.find(lowered, "range", 1, true)
				then "OUT OF RANGE"
				elseif
					string.find(lowered, "cast", 1, true) or string.find(lowered, "channel", 1, true)
				then "OWNER BUSY"
				elseif string.find(lowered, "mana", 1, true) or string.find(lowered, "strain", 1, true) or string.find(
					lowered,
					"complexity",
					1,
					true
				) then "RESOURCE LIMIT"
				elseif string.find(lowered, "obstruct", 1, true) then "BLOCKED"
				elseif string.find(lowered, "cool", 1, true) then "COOLDOWN"
				else "REJECTED"
			setSpellStatus(record, status, reason)
			return
		end
	end
	if not RolePolicy.canMelee(role, profile and profile.Mode) then
		record.NextAttack = now + math.max(0.25, archetype.AttackInterval)
		setSpellStatus(
			record,
			"REJECTED",
			if role.TargetMode == "AllySupport"
				then "Medic requires a compatible Ally support spell"
				else "Assigned support spell could not be cast"
		)
		return
	end
	record.NextAttack = now + archetype.AttackInterval
	setSpellStatus(record, "MELEE", if record.SpellSlot and not profile then record.SpellProfileReason else nil)
	Presentation.beam(core.Position, targetRoot.Position, archetype.BeamWidth, record.Color, archetype.BeamDuration)
	Damage.apply(model, targetHumanoid, archetype.AttackDamage)
end

function Summons.start(
	castSpell: CompanionCaster?,
	getProfile: CompanionProfileGetter?,
	remote: RemoteEvent,
	commandExecutor: CommandExecutor?
)
	if started then
		return
	end
	started = true
	castCompanionSpell = if castSpell
		then function(owner, caster, slot, summonId, target)
			return castSpell(owner, caster, slot, summonId, target, remote)
		end
		else nil
	getCompanionProfile = getProfile
	executeCommandEvent = commandExecutor
	local existing = workspace:FindFirstChild("MagicSummons")
	if existing and existing:IsA("Folder") then
		folder = existing
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "MagicSummons"
		folder.Parent = workspace
	end
	Players.PlayerRemoving:Connect(function(player)
		Summons.clearOwner(player)
	end)
	RunService.Heartbeat:Connect(function(delta)
		local now = os.clock()
		for index = #groups, 1, -1 do
			local group = groups[index]
			local casterHumanoid = group.Caster:FindFirstChildOfClass("Humanoid")
			local ownerCharacter = group.Owner.Character
			local ownerHumanoid = ownerCharacter and ownerCharacter:FindFirstChildOfClass("Humanoid")
			local ownerAlive = ownerCharacter ~= nil
				and ownerCharacter:IsDescendantOf(workspace)
				and ownerHumanoid ~= nil
				and ownerHumanoid.Health > 0
			if now >= group.ExpiresAt or group.Owner.Parent ~= Players then
				removeGroupAt(index)
			elseif
				group.Owner.Character ~= group.Caster
				or not group.Caster:IsDescendantOf(workspace)
				or not casterHumanoid
				or casterHumanoid.Health <= 0
			then
				if not group.PersistAcrossRespawn then
					removeGroupAt(index)
				else
					group.RespawnDeadline = group.RespawnDeadline or (now + Config.RespawnGracePeriod)
					if now >= group.RespawnDeadline then
						removeGroupAt(index)
					elseif ownerAlive and ownerCharacter then
						bindGroupToCharacter(group, ownerCharacter, now)
						local archetype = Config.Archetypes[group.Archetype]
						for _, record in group.Slots do
							updateRecord(record, group, now, delta, archetype)
						end
					else
						for _, record in group.Slots do
							setSpellStatus(record, "WAITING FOR OWNER", "Party resumes when you respawn")
						end
					end
				end
			else
				local archetype = Config.Archetypes[group.Archetype]
				for _, record in group.Slots do
					updateRecord(record, group, now, delta, archetype)
				end
			end
		end
	end)
end

function Summons.apply(
	owner: Player,
	caster: Model,
	spellId: string,
	payload: any,
	color: Color3,
	sourceDefinition: any,
	sourceRemote: RemoteEvent,
	sourceDirection: Vector3,
	sourcePotency: number,
	eventPosition: Vector3?
): (boolean, number, string?)
	if
		dismissedGroups[owner] and dismissedGroups[owner][spellId]
		or (dismissAllUntilCast[owner] and not (rearmedAfterDismiss[owner] and rearmedAfterDismiss[owner][spellId]))
	then
		return false, liveCount(owner), "Summon dismissed · recast the spell to summon again"
	end
	local archetype = Config.Archetypes[payload.Archetype]
	local role = Config.Roles[payload.Role or Config.DefaultRole]
	local spawnAt = payload.SpawnAt or "Caster"
	local casterHumanoid = caster:FindFirstChildOfClass("Humanoid")
	if
		not started
		or not folder
		or not archetype
		or not role
		or owner.Parent ~= Players
		or owner.Character ~= caster
		or not caster:IsDescendantOf(workspace)
		or not casterHumanoid
		or casterHumanoid.Health <= 0
	then
		return false, liveCount(owner), "Summon is unavailable for this character"
	end
	local casterRoot = caster:FindFirstChild("HumanoidRootPart")
	local casterPosition = if casterRoot and casterRoot:IsA("BasePart")
		then casterRoot.Position
		else caster:GetPivot().Position
	local spawnPosition = casterPosition
	if spawnAt == "Event" then
		if
			typeof(eventPosition) ~= "Vector3"
			or not CommandSpec.validPointCoordinates(eventPosition.X, eventPosition.Y, eventPosition.Z)
			or (eventPosition - casterPosition).Magnitude > Config.MaxEventSpawnRange
		then
			return false, liveCount(owner), "Trigger point is outside the allowed summon placement range"
		end
		-- Trigger locations are often surface impact points. Spawn the core just
		-- behind the incoming cast so it does not begin embedded in the surface.
		spawnPosition = Placement.behindImpact(eventPosition, sourceDirection, archetype.CoreSize * 0.5 + 0.75)
	elseif spawnAt ~= "Caster" then
		return false, liveCount(owner), "Unknown summon placement"
	end
	local now = os.clock()
	local group = findGroup(owner, spellId)
	if
		group
		and (
			group.Archetype ~= payload.Archetype
			or group.Role ~= (payload.Role or Config.DefaultRole)
			or group.SpawnAt ~= spawnAt
		)
	then
		local _, index = findGroup(owner, spellId)
		if index then
			removeGroupAt(index)
		end
		group = nil
	end
	if not group then
		group = {
			Owner = owner,
			Caster = caster,
			SpellId = spellId,
			Archetype = payload.Archetype,
			Role = payload.Role or Config.DefaultRole,
			SpawnAt = spawnAt,
			Color = color,
			Slots = {},
			Command = Config.DefaultCommand,
			CommandIssued = false,
			CommandTarget = nil,
			CommandPosition = nil,
			PatrolPoints = nil,
			ExpiresAt = if payload.LifetimeMode == "UntilCommanded" then math.huge else now + payload.Duration,
			PersistAcrossRespawn = payload.LifetimeMode == "UntilCommanded"
				and payload.RespawnPolicy == "PersistUntilDismissed",
			RespawnDeadline = nil,
			LastCapacityNotice = 0,
			SourceDefinition = sourceDefinition,
			SourceRemote = sourceRemote,
			SourceDirection = sourceDirection,
			SourcePotency = sourcePotency,
			CasterDeathConnection = nil,
		}
		table.insert(groups, group)
		bindGroupToCharacter(group, caster, now)
	else
		group.ExpiresAt = if payload.LifetimeMode == "UntilCommanded" then math.huge else now + payload.Duration
		if spawnAt == "Caster" then
			group.CommandIssued = false
		end
		group.PersistAcrossRespawn = payload.LifetimeMode == "UntilCommanded"
			and payload.RespawnPolicy == "PersistUntilDismissed"
		if not group.PersistAcrossRespawn then
			group.RespawnDeadline = nil
		end
		group.Color = color
		group.Role = payload.Role or Config.DefaultRole
		group.SpawnAt = spawnAt
		group.SourceDefinition = sourceDefinition
		group.SourceRemote = sourceRemote
		group.SourceDirection = sourceDirection
		group.SourcePotency = sourcePotency
		if group.Caster ~= caster then
			bindGroupToCharacter(group, caster, now)
		end
	end
	local spellSlot = tonumber(payload.SpellSlot)
	local countPerTrigger = math.clamp(payload.Count, 1, math.min(Config.MaxActivePerSpell, Config.MaxCountPerCast))
	local requestedCount = if spawnAt == "Event"
		then math.min(Config.MaxActivePerSpell, #group.Slots + countPerTrigger)
		else countPerTrigger
	while spawnAt == "Caster" and #group.Slots > requestedCount do
		local record = table.remove(group.Slots)
		if record then
			removeModel(record)
		end
	end
	local created = false
	if spawnAt == "Caster" then
		-- A dead or externally removed Caster summon keeps its bounded group slot
		-- until expiry. Recasting should refill that slot instead of silently
		-- leaving the group empty because its slot array is already at capacity.
		for index, record in group.Slots do
			if index > requestedCount then
				break
			end
			if
				not record.Model
				and liveCount(owner) < Config.MaxActivePerPlayer
				and liveCount(nil) < Config.MaxActiveGlobal
			then
				record.Caster = caster
				record.SpawnPosition = spawnPosition
				record.NextTargetScan = now
				record.NextAttack = now + (archetype.AttackInterval or 0)
				record.Target = nil
				record.HoldPosition = nil
				local angle = now * Config.OrbitRate + (record.Index - 1) * math.pi
				local initialOffset = Vector3.new(
					math.cos(angle) * archetype.FollowDistance,
					archetype.HoverHeight,
					math.sin(angle) * archetype.FollowDistance
				)
				makeSummonModel(record, record.SpawnPosition + initialOffset, archetype)
				created = true
			end
		end
	end
	for _, record in group.Slots do
		if record.SpellSlot ~= spellSlot then
			record.SpellSlot = spellSlot
			record.Target = nil
			record.SpellProfile = nil
			record.SpellProfileReason = nil
			record.SpellStatus = nil
			record.SpellStatusReason = nil
			record.SpellCastUntil = 0
			record.NextTargetScan = 0
			record.NextAttack = now
			setSpellStatus(record, if spellSlot then "SEARCHING" else "UNASSIGNED", nil)
		end
	end
	while #group.Slots < requestedCount do
		if liveCount(owner) >= Config.MaxActivePerPlayer or liveCount(nil) >= Config.MaxActiveGlobal then
			if now - group.LastCapacityNotice >= 5 then
				group.LastCapacityNotice = now
				refreshOwnerCount(owner)
				local message = if created
					then archetype.Label .. " summoned; remaining summon capacity is full"
					else "Summon capacity reached"
				return created, liveCount(owner), message
			end
			break
		end
		local index = #group.Slots + 1
		local recordSpawnPosition = spawnPosition
		if spawnAt == "Event" then
			local angle = index * 2.4
			recordSpawnPosition += Vector3.new(math.cos(angle) * 2, 0, math.sin(angle) * 2)
		end
		nextRecordId += 1
		local record: SummonRecord = {
			Owner = owner,
			Caster = caster,
			SpellId = spellId,
			Archetype = payload.Archetype,
			Role = payload.Role or Config.DefaultRole,
			Index = index,
			Id = nextRecordId,
			SpellSlot = spellSlot,
			Color = color,
			SpawnPosition = recordSpawnPosition,
			Model = nil,
			Humanoid = nil,
			NextTargetScan = now + (index - 1) * 0.09,
			NextAttack = now + archetype.AttackInterval,
			Target = nil,
			HoldPosition = nil,
			MoveOffset = Vector3.zero,
			PatrolPoints = nil,
			PatrolIndex = 1,
			DeathConnection = nil,
			HealthConnection = nil,
			ModelAncestryConnection = nil,
			SpellProfile = nil,
			SpellProfileReason = nil,
			SpellStatus = nil,
			SpellStatusReason = nil,
			TargetSearchReason = nil,
			SpellCastUntil = 0,
			CommandIssued = false,
		}
		local initialPosition = if spawnAt == "Caster"
			then recordSpawnPosition + Vector3.new(
				math.cos(now * Config.OrbitRate + (index - 1) * math.pi) * archetype.FollowDistance,
				archetype.HoverHeight,
				math.sin(now * Config.OrbitRate + (index - 1) * math.pi) * archetype.FollowDistance
			)
			else recordSpawnPosition + Vector3.new(0, archetype.HoverHeight + 1, 0)
		makeSummonModel(record, initialPosition, archetype)
		table.insert(group.Slots, record)
		created = true
	end
	refreshOwnerCount(owner)
	if created then
		return true, liveCount(owner), string.format("%s summoned · %d active", archetype.Label, liveCount(owner))
	end
	if spawnAt == "Event" and #group.Slots >= Config.MaxActivePerSpell and now - group.LastCapacityNotice >= 5 then
		group.LastCapacityNotice = now
		return false, liveCount(owner), "Per-spell summon limit reached"
	end
	return false, liveCount(owner), nil
end

function Summons.command(owner: Player, mode: any, target: any, worldPoint: any?, selectedId: any?): (boolean, string)
	if not table.find(Config.CommandOrder, mode) then
		return false, "Unknown summon command"
	end
	local character = owner.Character
	local ownerRoot = character and character:FindFirstChild("HumanoidRootPart")
	local ownerHumanoid = character and character:FindFirstChildOfClass("Humanoid")
	if
		owner.Parent ~= Players
		or not character
		or not ownerRoot
		or not ownerRoot:IsA("BasePart")
		or not ownerHumanoid
		or ownerHumanoid.Health <= 0
	then
		return false, "Character is not ready"
	end
	local selectedRecord: SummonRecord? = nil
	local selectedGroup: SummonGroup? = nil
	if selectedId ~= nil and mode ~= "Dismiss" then
		if not CommandSpec.validSelectionId(selectedId) then
			return false, "Invalid summon selection"
		end
		for _, group in groups do
			if group.Owner == owner and group.Caster == character then
				for _, record in group.Slots do
					if
						CommandSpec.matchesSelection(record.Id, selectedId)
						and record.Model
						and record.Model:IsDescendantOf(workspace)
						and record.Humanoid
						and record.Humanoid.Health > 0
					then
						selectedRecord = record
						selectedGroup = group
						break
					end
				end
			end
			if selectedRecord then
				break
			end
		end
		if not selectedRecord then
			return false, "Selected summon is no longer active"
		end
	end
	local function matchesCommandGroup(group: SummonGroup): boolean
		return group.Owner == owner
			and group.Caster == character
			and (selectedRecord == nil or table.find(group.Slots, selectedRecord) ~= nil)
	end
	local activeGroups = 0
	for _, group in groups do
		if matchesCommandGroup(group) then
			if mode == "Dismiss" then
				activeGroups += 1
				continue
			end
			for _, record in group.Slots do
				if
					record.Model
					and record.Model:IsDescendantOf(workspace)
					and record.Humanoid
					and record.Humanoid.Health > 0
				then
					activeGroups += 1
					break
				end
			end
		end
	end
	if activeGroups == 0 and mode ~= "Dismiss" then
		return false, "No active summons to command"
	end
	if mode == "Attack" then
		for _, group in groups do
			if matchesCommandGroup(group) then
				local role = Config.Roles[group.Role] or Config.Roles[Config.DefaultRole]
				if role.TargetMode == "AllySupport" then
					return false, "Medic summons only accept Follow, Protect, Hold, or Support orders"
				end
			end
		end
	end
	if mode == "Support" then
		local hasSupportSpell = false
		for _, group in groups do
			if matchesCommandGroup(group) then
				for _, record in group.Slots do
					local profile = (not selectedRecord or record == selectedRecord)
						and record.SpellSlot
						and getCompanionProfile
						and getCompanionProfile(owner, record.SpellSlot)
					if profile and profile.Mode == "Ally" then
						hasSupportSpell = true
						break
					end
				end
			end
			if hasSupportSpell then
				break
			end
		end
		if not hasSupportSpell then
			return false, "Assign a valid Ally-targeting support spell to the summon’s companion spell slot first"
		end
	end

	local attackTarget: Model? = nil
	local movePosition: Vector3? = nil
	local selectedPatrolPoints: { Vector3 }? = nil
	if mode == "Attack" then
		if
			typeof(target) ~= "Instance"
			or not target:IsA("Model")
			or target == character
			or not target:IsDescendantOf(workspace)
			or not isHostileTarget(target)
		then
			return false, "Aim at a living hostile to order an attack"
		end
		local targetHumanoid = target:FindFirstChildOfClass("Humanoid")
		local targetRoot = target:FindFirstChild("HumanoidRootPart")
		if not targetHumanoid or targetHumanoid.Health <= 0 or not targetRoot or not targetRoot:IsA("BasePart") then
			return false, "Attack target is not a living character"
		end
		local delta = targetRoot.Position - ownerRoot.Position
		if delta.Magnitude > Config.MaxCommandRange then
			return false, "Attack target is outside command range"
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		params.RespectCanCollide = true
		local obstruction = workspace:Raycast(ownerRoot.Position, delta, params)
		if obstruction and not obstruction.Instance:IsDescendantOf(target) then
			return false, "Attack target is obstructed"
		end
		attackTarget = target
	end
	if mode == "Move" or mode == "Patrol" then
		if
			typeof(worldPoint) ~= "Vector3"
			or not CommandSpec.validPointCoordinates(worldPoint.X, worldPoint.Y, worldPoint.Z)
		then
			return false,
				if mode == "Patrol"
					then "Aim at a visible surface to set a patrol waypoint"
					else "Aim at a reachable surface to move summons"
		end
		local delta = worldPoint - ownerRoot.Position
		if delta.Magnitude < 2 or delta.Magnitude > Config.MaxMoveOrderRange then
			return false, "Command point is outside move range"
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character, folder }
		params.RespectCanCollide = true
		local hit = workspace:Raycast(ownerRoot.Position, delta, params)
		if not hit then
			return false, "Command point must be on a visible solid surface"
		end
		movePosition = hit.Position
		if mode == "Patrol" and selectedRecord and selectedGroup then
			local previous = if selectedRecord.Command ~= nil
				then if selectedRecord.Command == "Patrol" then selectedRecord.PatrolPoints else nil
				else if selectedGroup.Command == "Patrol" then selectedGroup.PatrolPoints else nil
			if
				previous
				and #previous == 1
				and (previous[1] - movePosition).Magnitude < Config.MinPatrolWaypointDistance
			then
				return false, "Patrol waypoints need more separation"
			end
			selectedPatrolPoints = CommandSpec.nextPatrolRoute(previous, movePosition)
		elseif mode == "Patrol" then
			for _, group in groups do
				if
					matchesCommandGroup(group)
					and group.Command == "Patrol"
					and group.PatrolPoints
					and #group.PatrolPoints == 1
					and (group.PatrolPoints[1] - movePosition).Magnitude < Config.MinPatrolWaypointDistance
				then
					return false, "Patrol waypoints need more separation"
				end
			end
		end
	end

	local commandEvents = {}
	local patrolComplete = false
	if selectedPatrolPoints then
		patrolComplete = #selectedPatrolPoints > 1
	end
	for _, group in groups do
		if matchesCommandGroup(group) then
			if selectedRecord then
				selectedRecord.Command = mode
				selectedRecord.CommandIssued = true
				selectedRecord.CommandTarget = attackTarget
				selectedRecord.CommandPosition = if mode == "Move" then movePosition else nil
				selectedRecord.PatrolPoints = selectedPatrolPoints
				selectedRecord.PatrolIndex = 1
			else
				local patrolPoints = if mode == "Patrol"
					then CommandSpec.nextPatrolRoute(
						if group.Command == "Patrol" then group.PatrolPoints else nil,
						movePosition
					)
					else nil
				if patrolPoints and #patrolPoints > 1 then
					patrolComplete = true
				end
				group.Command = mode
				group.CommandIssued = true
				group.CommandTarget = attackTarget
				group.CommandPosition = if mode == "Move" then movePosition else nil
				group.PatrolPoints = patrolPoints
			end
			local commandTargets = {}
			for _, record in group.Slots do
				if selectedRecord then
					if record == selectedRecord then
						record.Target = attackTarget
						record.HoldPosition = if mode == "Hold" and record.Model
							then record.Model:GetPivot().Position
							else nil
						record.MoveOffset = Vector3.zero
						record.PatrolIndex = 1
						record.NextTargetScan = 0
					end
				else
					record.Command = nil
					record.CommandTarget = nil
					record.CommandPosition = nil
					record.PatrolPoints = nil
					record.PatrolIndex = 1
					record.Target = attackTarget
					record.HoldPosition = if mode == "Hold" and record.Model
						then record.Model:GetPivot().Position
						else nil
					record.MoveOffset = if mode == "Move" or mode == "Patrol"
						then Vector3.new(
							math.cos(record.Index * math.pi / 2) * 2.5,
							0,
							math.sin(record.Index * math.pi / 2) * 2.5
						)
						else Vector3.zero
					record.NextTargetScan = 0
				end
				if
					(not selectedRecord or record == selectedRecord)
					and not attackTarget
					and record.Humanoid
					and record.Humanoid.Health > 0
					and record.Humanoid:IsDescendantOf(workspace)
				then
					table.insert(commandTargets, record.Humanoid)
				end
			end
			if attackTarget then
				local targetHumanoid = attackTarget:FindFirstChildOfClass("Humanoid")
				if targetHumanoid and not table.find(commandTargets, targetHumanoid) then
					table.insert(commandTargets, targetHumanoid)
				end
			end
			if #commandTargets > 0 then
				table.insert(commandEvents, { Group = group, Targets = commandTargets })
			end
		end
	end
	if executeCommandEvent then
		for _, event in commandEvents do
			local group = event.Group
			executeCommandEvent(
				owner,
				group.Caster,
				group.SourceDefinition,
				group.SourceRemote,
				group.SourceDirection,
				group.SourcePotency,
				mode,
				event.Targets
			)
		end
	end
	if mode == "Dismiss" then
		dismissAllUntilCast[owner] = true
		rearmedAfterDismiss[owner] = nil
		local ownerDismissed = dismissedGroups[owner]
		if not ownerDismissed then
			ownerDismissed = {}
			dismissedGroups[owner] = ownerDismissed
		end
		for index = #groups, 1, -1 do
			local group = groups[index]
			if group.Owner == owner and group.Caster == character then
				ownerDismissed[group.SpellId] = true
				removeGroupAt(index)
			end
		end
		refreshOwnerCount(owner)
		return true, "Summons dismissed until their spells are cast again"
	end
	local text = if attackTarget then "Attack " .. attackTarget.Name elseif movePosition then "Move order" else mode
	local recipient = if selectedRecord then "selected summon" else tostring(activeGroups) .. " summon group(s)"
	if mode == "Patrol" then
		return true,
			if patrolComplete
				then "Two-waypoint patrol started for " .. recipient
				else "Patrol waypoint set; issue Patrol again to set the return point"
	end
	return true, text .. " order set for " .. recipient
end

function Summons.clearSpell(owner: Player, spellId: string)
	if dismissedGroups[owner] then
		dismissedGroups[owner][spellId] = nil
		if next(dismissedGroups[owner]) == nil then
			dismissedGroups[owner] = nil
		end
	end
	local _, index = findGroup(owner, spellId)
	if index then
		removeGroupAt(index)
	end
end

function Summons.clearDismissal(owner: Player, spellId: string)
	if dismissAllUntilCast[owner] then
		local rearmed = rearmedAfterDismiss[owner]
		if not rearmed then
			rearmed = {}
			rearmedAfterDismiss[owner] = rearmed
		end
		rearmed[spellId] = true
	end
	local ownerDismissed = dismissedGroups[owner]
	if not ownerDismissed then
		return
	end
	ownerDismissed[spellId] = nil
	if next(ownerDismissed) == nil then
		dismissedGroups[owner] = nil
	end
end

function Summons.clearOwner(owner: Player)
	dismissedGroups[owner] = nil
	dismissAllUntilCast[owner] = nil
	rearmedAfterDismiss[owner] = nil
	for index = #groups, 1, -1 do
		if groups[index].Owner == owner then
			removeGroupAt(index)
		end
	end
	if owner.Parent == Players then
		owner:SetAttribute("ActiveMagicSummons", 0)
	end
end

return Summons
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="157">
          <Properties>
            <string name="Name">TrainingDummyService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.Sandbox).TrainingDummies

type DummyEntry = {
	Alignment: string,
	Model: Model?,
	Position: Vector3,
	Generation: number,
}

local TrainingDummies = {}
local entries: { [Player]: { DummyEntry } } = {}
local lastRequest: { [Player]: number } = {}
local folder: Folder?

local function countAll(): number
	local count = 0
	for _, owned in entries do
		count += #owned
	end
	return count
end

local function countOwned(player: Player): number
	return #(entries[player] or {})
end

local function updateHealthLabel(model: Model, humanoid: Humanoid, alignment: string)
	local head = model:FindFirstChild("Head")
	local gui = head and head:FindFirstChild("TrainingDummyNameplate")
	local label = gui and gui:FindFirstChild("Label")
	local bar = gui and gui:FindFirstChild("Bar")
	local fill = bar and bar:FindFirstChild("Fill")
	if label and label:IsA("TextLabel") then
		label.Text =
			string.format("%s TRAINING · %d / %d", alignment:upper(), math.ceil(humanoid.Health), humanoid.MaxHealth)
	end
	if fill and fill:IsA("Frame") then
		fill.Size = UDim2.fromScale(math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1), 1)
	end
end

local function makePart(
	model: Model,
	name: string,
	size: Vector3,
	offset: Vector3,
	color: Color3,
	material: Enum.Material
)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = root.CFrame * CFrame.new(offset)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.Material = material
	part.Color = color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	return part
end

local function makeNameplate(head: BasePart, alignment: string)
	local gui = Instance.new("BillboardGui")
	gui.Name = "TrainingDummyNameplate"
	gui.Adornee = head
	gui.Size = UDim2.fromOffset(190, 46)
	gui.StudsOffset = Vector3.new(0, 1.15, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 140
	gui.Parent = head

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, 0, 0, 27)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextColor3 = if alignment == "Ally" then Color3.fromRGB(141, 230, 177) else Color3.fromRGB(255, 145, 125)
	label.TextStrokeTransparency = 0.35
	label.Parent = gui

	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Position = UDim2.fromOffset(32, 28)
	bar.Size = UDim2.new(1, -64, 0, 7)
	bar.BackgroundColor3 = Color3.fromRGB(34, 30, 31)
	bar.BorderSizePixel = 0
	bar.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = if alignment == "Ally" then Color3.fromRGB(77, 203, 128) else Color3.fromRGB(223, 79, 69)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	return gui
end

local function createModel(entry: DummyEntry, owner: Player)
	local alignment = entry.Alignment
	local tone = if alignment == "Ally" then Color3.fromRGB(91, 126, 113) else Color3.fromRGB(126, 77, 73)
	local trim = if alignment == "Ally" then Color3.fromRGB(180, 165, 125) else Color3.fromRGB(171, 92, 75)
	local model = Instance.new("Model")
	model.Name = alignment .. "TrainingDummy"
	model:SetAttribute("SandboxTrainingDummy", true)
	model:SetAttribute("SandboxAlignment", alignment)
	model:SetAttribute("SandboxOwnerUserId", owner.UserId)
	model:SetAttribute("SandboxLabel", alignment .. " Training Dummy")
	if alignment == "Enemy" then
		CollectionService:AddTag(model, "MagicHostileTarget")
	else
		CollectionService:AddTag(model, "MagicAllyTarget")
	end

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	local ownerRoot = owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
	local center = entry.Position + Vector3.new(0, 2.75, 0)
	local facing = if ownerRoot and ownerRoot:IsA("BasePart")
		then Vector3.new(ownerRoot.Position.X, center.Y, ownerRoot.Position.Z)
		else center + Vector3.zAxis
	root.CFrame = CFrame.lookAt(center, facing)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.Parent = model
	model.PrimaryPart = root

	makePart(model, "Torso", Vector3.new(2.1, 2.1, 1.15), Vector3.new(0, 0.05, 0), tone, Enum.Material.SmoothPlastic)
	makePart(
		model,
		"Head",
		Vector3.new(1.2, 1.2, 1.2),
		Vector3.new(0, 1.75, 0),
		Color3.fromRGB(177, 153, 128),
		Enum.Material.SmoothPlastic
	)
	makePart(model, "Left Arm", Vector3.new(0.7, 2, 0.8), Vector3.new(-1.35, 0, 0), tone, Enum.Material.SmoothPlastic)
	makePart(model, "Right Arm", Vector3.new(0.7, 2, 0.8), Vector3.new(1.35, 0, 0), tone, Enum.Material.SmoothPlastic)
	makePart(
		model,
		"Left Leg",
		Vector3.new(0.85, 1.8, 0.95),
		Vector3.new(-0.52, -1.95, 0),
		trim,
		Enum.Material.WoodPlanks
	)
	makePart(
		model,
		"Right Leg",
		Vector3.new(0.85, 1.8, 0.95),
		Vector3.new(0.52, -1.95, 0),
		trim,
		Enum.Material.WoodPlanks
	)

	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "Humanoid"
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.MaxHealth = Config.Health
	humanoid.Health = humanoid.MaxHealth
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model
	local head = model:FindFirstChild("Head") :: BasePart
	makeNameplate(head, alignment)
	humanoid.HealthChanged:Connect(function()
		updateHealthLabel(model, humanoid, alignment)
	end)
	updateHealthLabel(model, humanoid, alignment)
	model.Parent = folder
	entry.Model = model
	entry.Generation += 1
	local generation = entry.Generation
	humanoid.Died:Once(function()
		task.delay(Config.ResetDelay, function()
			if
				entry.Generation == generation
				and entry.Model == model
				and model.Parent
				and table.find(entries[owner] or {}, entry)
			then
				model:Destroy()
				entry.Model = nil
				createModel(entry, owner)
			end
		end)
	end)
end

local function removeEntry(player: Player, entry: DummyEntry)
	local owned = entries[player]
	if not owned then
		return
	end
	local index = table.find(owned, entry)
	if not index then
		return
	end
	table.remove(owned, index)
	entry.Generation += 1
	if entry.Model then
		entry.Model:Destroy()
		entry.Model = nil
	end
	if #owned == 0 then
		entries[player] = nil
	end
end

local function getSpawnPosition(player: Player, root: BasePart): Vector3?
	local dummyFolder = folder
	if not dummyFolder then
		return nil
	end
	local forward = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if forward.Magnitude < 0.1 then
		forward = Vector3.zAxis
	end
	forward = forward.Unit
	local right = Vector3.new(-forward.Z, 0, forward.X)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, dummyFolder }
	params.IgnoreWater = true
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { player.Character, dummyFolder }
	for attempt = 1, Config.SpawnAttempts do
		local ring = math.ceil(attempt / 4)
		local side = ((attempt - 1) % 4) - 1.5
		local desired = root.Position + forward * (Config.SpawnDistance + (ring - 1) * 3) + right * (side * 2.5)
		local origin = desired + Vector3.new(0, 12, 0)
		local hit = workspace:Raycast(origin, Vector3.new(0, -42, 0), params)
		if hit and hit.Normal.Y > 0.6 then
			local position = hit.Position + Vector3.new(0, 0.08, 0)
			local blocked = false
			for _, part in
				workspace:GetPartBoundsInBox(
					CFrame.new(position + Vector3.new(0, 2.8, 0)),
					Vector3.new(3.2, 5.2, 2.2),
					overlap
				)
			do
				if part.CanCollide then
					blocked = true
					break
				end
			end
			if not blocked then
				return position
			end
		end
	end
	return nil
end

local function respond(remote: RemoteEvent, player: Player, ok: boolean, text: string)
	remote:FireClient(player, ok, text, countOwned(player), Config.MaxPerPlayer)
end

function TrainingDummies.start(remoteFolder: Folder, getState: (Player) -> any)
	if not Config.Enabled or not RunService:IsStudio() then
		return
	end
	local rootFolder = Instance.new("Folder")
	rootFolder.Name = "TrainingDummies"
	rootFolder.Parent = workspace
	folder = rootFolder
	local request = Instance.new("RemoteEvent")
	request.Name = "TrainingDummyRequest"
	request.Parent = remoteFolder
	local response = Instance.new("RemoteEvent")
	response.Name = "TrainingDummyResponse"
	response.Parent = remoteFolder

	request.OnServerEvent:Connect(function(player: Player, action: any)
		if typeof(action) ~= "string" or not player:GetAttribute("OpeningComplete") then
			return
		end
		local now = os.clock()
		if now - (lastRequest[player] or -math.huge) < Config.RequestCooldown then
			respond(response, player, false, "Please wait before sending another training command.")
			return
		end
		lastRequest[player] = now
		local state = getState(player)
		if not state or state.Character ~= player.Character or state.Humanoid.Health <= 0 then
			respond(response, player, false, "Your character is not ready.")
			return
		end
		if action == "SpawnAlly" or action == "SpawnEnemy" then
			if countOwned(player) >= Config.MaxPerPlayer or countAll() >= Config.MaxTotal then
				respond(response, player, false, "Training dummy limit reached. Clear some dummies first.")
				return
			end
			local position = getSpawnPosition(player, state.Root)
			if not position then
				respond(response, player, false, "No clear ground nearby. Move to an open floor and try again.")
				return
			end
			local alignment = if action == "SpawnAlly" then "Ally" else "Enemy"
			local entry: DummyEntry = { Alignment = alignment, Model = nil, Position = position, Generation = 0 }
			entries[player] = entries[player] or {}
			table.insert(entries[player], entry)
			createModel(entry, player)
			respond(response, player, true, alignment .. " training dummy spawned.")
		elseif action == "ResetMine" then
			for _, entry in entries[player] or {} do
				local model = entry.Model
				local humanoid = model and model:FindFirstChildOfClass("Humanoid")
				if not model or not humanoid or humanoid.Health <= 0 then
					if model then
						model:Destroy()
						entry.Model = nil
					end
					createModel(entry, player)
				else
					humanoid.Health = humanoid.MaxHealth
				end
			end
			respond(response, player, true, "Your training dummies have been reset.")
		elseif action == "ClearMine" then
			for _, entry in table.clone(entries[player] or {}) do
				removeEntry(player, entry)
			end
			respond(response, player, true, "Your training dummies have been cleared.")
		elseif action == "RestorePlayer" then
			local restored = require(script.Parent.MagicService).restoreTestingResources(player)
			if restored then
				state.Humanoid.Health = state.Humanoid.MaxHealth
			end
			respond(
				response,
				player,
				restored,
				if restored
					then "Health and magic resources restored."
					else "Magic resources are still loading; try again."
			)
		elseif action == "ClearEffects" then
			require(script.Parent.MagicService).reset(player)
			respond(response, player, true, "Your active spells and cooldowns have been reset.")
		elseif action == "ResetPlayer" then
			player:LoadCharacter()
		elseif action == "ReturnToStart" and require(script.Parent.CombatSandboxService).enabled() then
			local position = require(Shared.Configuration.DevelopmentSandbox).Spawn
			state.Character:PivotTo(CFrame.new(position))
			state.Root.AssemblyLinearVelocity = Vector3.zero
			state.LastPosition, state.LastFramePosition = position, position
			state.SpawnGraceUntil = workspace:GetServerTimeNow() + 2
			respond(response, player, true, "Returned to the practice start.")
		else
			respond(response, player, false, "Unknown training command.")
		end
	end)

	if require(script.Parent.CombatSandboxService).enabled() then
		local function bindPractice(player)
			local function seed()
				if not player:GetAttribute("CharacterReady") or countOwned(player) > 0 then
					return
				end
				local state = getState(player)
				if not state then
					return
				end
				for i, alignment in { "Enemy", "Ally" } do
					if countAll() >= Config.MaxTotal or countOwned(player) >= Config.MaxPerPlayer then
						break
					end
					local position = getSpawnPosition(player, state.Root)
					if position then
						position += Vector3.new((i - 1) * 7, 0, 0)
						local entry = { Alignment = alignment, Model = nil, Position = position, Generation = 0 }
						entries[player] = entries[player] or {}
						table.insert(entries[player], entry)
						createModel(entry, player)
					end
				end
			end
			player:GetAttributeChangedSignal("CharacterReady"):Connect(seed)
			seed()
		end
		Players.PlayerAdded:Connect(bindPractice)
		for _, player in Players:GetPlayers() do
			bindPractice(player)
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		for _, entry in table.clone(entries[player] or {}) do
			removeEntry(player, entry)
		end
		lastRequest[player] = nil
	end)
end

return TrainingDummies
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="158">
          <Properties>
            <string name="Name">WorldEventRules</string>
            <string name="Source"><![CDATA[--!strict
-- Pure event rules, shared by the director and deterministic offline tests.
local Rules = {}
function Rules.available(now, cooldown, active, cap, enemies, count, enemyCap)
	return now >= cooldown and active < cap and enemies + count <= enemyCap
end
function Rules.eligible(credit, config)
	return credit ~= nil
		and (
			credit.Damage >= config.ContributionDamage
			or (credit.Seconds >= config.EscortSeconds and credit.Distance >= config.EscortDistance)
		)
end
function Rules.credit(ledger, userId, damage, seconds, distance)
	local credit = ledger[userId] or { Damage = 0, Seconds = 0, Distance = 0, Paid = false }
	credit.Damage = credit.Damage + math.max(0, damage)
	credit.Seconds = credit.Seconds + math.max(0, seconds)
	credit.Distance = credit.Distance + math.max(0, distance)
	ledger[userId] = credit
end
function Rules.claim(ledger, userId, success, config)
	local credit = ledger[userId]
	if not success or not Rules.eligible(credit, config) or credit.Paid then
		return false
	end
	credit.Paid = true
	return true
end
function Rules.escortStep(traveled, playerTravel, nearBefore, nearNow, dt)
	if
		not nearBefore
		or not nearNow
		or traveled <= 0.2
		or traveled >= 30
		or playerTravel <= 0.2
		or playerTravel >= 40
	then
		return 0, 0
	end
	return dt, math.min(traveled, playerTravel)
end
function Rules.outcome(alive, protectedAlive, arrived, travel, expired)
	if not protectedAlive then
		return "Failed"
	end
	if alive == 0 and (not travel or arrived) then
		return "Completed"
	end
	if expired then
		return "Failed"
	end
	return nil
end
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="159">
          <Properties>
            <string name="Name">WorldEventService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Run = game:GetService("RunService")
local Http = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Configuration.WorldEvents)
local Plan = require(Shared.Configuration.PhaseATopology)
local Locations = require(Shared.Configuration.AssignmentLocations)
local Runtime = require(script.Parent.EnemyRuntime)
local Spawn = require(script.Parent.WorldSpawnService)
local City = require(script.Parent.LivingCityService)
local Damage = require(script.Parent.DamageService)
local Rules = require(script.Parent.WorldEventRules)
local Director = {}
local events, cooldowns = {}, {}
local folder, nextEvent = nil, 0
local random = Random.new()
local function countLiving(event)
	local n = 0
	for _, enemy in event.Enemies do
		if enemy.IsAlive() then
			n += 1
		end
	end
	return n
end
local function state(event, value)
	event.State = value
	event.Folder:SetAttribute("State", value)
end
local function center(event)
	return if event.Traveler and event.Traveler.Model.Parent then event.Traveler.Root.Position else event.Position
end
local function resolve(event, success, now)
	if event.State ~= "Active" and event.State ~= "Preparing" then
		return
	end
	state(event, "Resolving")
	event.Success = success
	for _, player in Players:GetPlayers() do
		if Rules.claim(event.Credit, player.UserId, success, Config) then
			player:SetAttribute("MilitaryScrip", (player:GetAttribute("MilitaryScrip") or 0) + event.Definition.Reward)
			player:SetAttribute(
				"EventRewardNotice",
				event.Definition.Name .. " · +" .. event.Definition.Reward .. " scrip"
			)
		end
	end
	event.ResolvedAt = now
end
local function cleanup(event, now)
	state(event, "Cleanup")
	for _, enemy in event.Enemies do
		enemy.Destroy()
	end
	if event.Traveler then
		City.remove(event.Traveler)
	end
	if event.Companion then
		City.remove(event.Companion)
	end
	City.release(event.Id)
	cooldowns[event.LocationId] = now + (event.Definition.Cooldown or Config.LocationCooldown)
	state(event, "Cooldown")
	folder:SetAttribute(
		"Cooldown_" .. event.LocationId,
		workspace:GetServerTimeNow() + (event.Definition.Cooldown or Config.LocationCooldown)
	)
	event.Folder:Destroy()
	events[event.Id] = nil
	-- No successor wave: the location stays quiet through its cooldown.
	nextEvent = math.max(nextEvent, now + Config.GlobalCooldown / math.max(0.1, Config.FrequencyMultiplier))
end
local function spawnPoints(event)
	local points = {}
	local origin = if event.Kind == "RampartAssault" then Plan.Nodes[Config.Anchors.ArchApproach] else event.Position
	for _ = 1, event.Count do
		local point = Spawn.find(origin, Config.SpawnRadius, Config.MinimumPlayerDistance, Config.SafeRadius, points)
		if not point then
			return nil
		end
		table.insert(points, point)
	end
	return points
end
local function objective(enemy, actor)
	if not actor then
		return
	end
	local value = Instance.new("ObjectValue")
	value.Name, value.Value, value.Parent = "ObjectiveTarget", actor.Model, enemy.Model
end
local function activate(event, now)
	-- Recheck ground, player distances and occupancy after the warning period.
	local points = spawnPoints(event)
	if not points then
		resolve(event, false, now)
		return
	end
	if event.Kind == "TravelIncident" then
		event.Traveler = City.create("Supply carrier", "Worker", event.Definition.Route, true)
		event.Companion = City.create("Escort", "Guard", event.Definition.Route, true)
		if not event.Traveler or not event.Companion then
			resolve(event, false, now)
			return
		end
		event.LastPosition = event.Traveler.Root.Position
	end
	local victim = event.Traveler or City.near(event.Position, event.Kind == "RampartAssault")
	if event.Kind == "LocalAttack" or event.Kind == "RampartAssault" then
		local distance
		victim, distance = City.near(event.Position, event.Kind == "RampartAssault")
		if not victim or distance > 160 then
			resolve(event, false, now)
			return
		end
		event.Protected = victim
	end
	for _, point in points do
		local enemy = Runtime.create(point, event.Folder)
		enemy.Model:SetAttribute("Population", "WorldEvent")
		enemy.Model:SetAttribute("EventId", event.Id)
		-- Breaches hold their location; other events approach their human target.
		if event.Kind ~= "Breach" then
			objective(enemy, victim)
		end
		table.insert(event.Enemies, enemy)
	end
	event.Started = now
	event.LastTick = now
	state(event, "Active")
end
local function begin(kind, locationId, location, now)
	local definition = Config.Definitions[kind]
	local count = random:NextInteger(definition.CountRange[1], definition.CountRange[2])
	local active, enemies = 0, 0
	for _, e in events do
		active += 1
		enemies += e.Count
	end
	if
		not Rules.available(now, cooldowns[locationId] or 0, active, Config.ActiveCap, enemies, count, Config.EnemyCap)
	then
		return false
	end
	if not Spawn.safe(location.Position, Config.SafeRadius) then
		return false
	end
	local nearby = false
	for _, root in Spawn.players() do
		local d = (root.Position - location.Position).Magnitude
		if d >= Config.MinimumPlayerDistance and d <= Config.MaximumDiscoveryDistance then
			nearby = true
		end
	end
	if not nearby then
		return false
	end
	local event = {
		Id = Http:GenerateGUID(false),
		Kind = kind,
		Definition = definition,
		LocationId = locationId,
		Position = location.Position,
		Count = count,
		Enemies = {},
		Credit = {},
		PreparedAt = now,
		State = "Preparing",
		PlayerPositions = {},
	}
	if not spawnPoints(event) then
		return false
	end
	if kind == "LocalAttack" or kind == "RampartAssault" then
		local human, distance = City.near(location.Position, kind == "RampartAssault")
		if not human or distance > 160 then
			return false
		end
	end
	if kind == "TravelIncident" and locationId ~= "Checkpoint_Market" then
		return false
	end
	local instance = Instance.new("Folder")
	instance.Name, instance.Parent = event.Id, folder
	instance:SetAttribute("DefinitionId", kind)
	instance:SetAttribute("LocationId", locationId)
	event.Folder = instance
	state(event, "Preparing")
	events[event.Id] = event
	cooldowns[locationId] = math.huge
	if kind == "RampartAssault" then
		City.mobilize(
			event.Id,
			Plan.Nodes[Config.Anchors.RampartDefenseLine],
			Plan.Nodes[Config.Anchors.CivilianRetreatArea]
		)
	end
	nextEvent = now + Config.GlobalCooldown / math.max(0.1, Config.FrequencyMultiplier)
	return true
end
local function attempt(kind)
	if not Config.Definitions[kind] then
		return false, "Unknown event definition"
	end
	local choices = {}
	if kind == "RampartAssault" then
		choices = {
			{
				Id = "RampartDefenseLine",
				Position = Plan.Nodes[Config.Anchors.RampartDefenseLine],
				Category = "Defense",
			},
		}
	else
		for id, location in Locations do
			if table.find(Config.Definitions[kind].Categories, location.Category) then
				table.insert(choices, { Id = id, Position = location.Position, Category = location.Category })
			end
		end
	end
	-- Randomized rotation, rather than starving the last valid location in a table.
	local offset = if #choices > 0 then random:NextInteger(1, #choices) else 1
	for i = 1, #choices do
		local location = choices[(offset + i - 2) % #choices + 1]
		if begin(kind, location.Id, location, os.clock()) then
			return true, "Preparing " .. kind .. " at " .. location.Id
		end
	end
	return false, "No eligible location: check player distance, safe/clear ground, humans, caps and cooldowns"
end
function Director.start()
	if folder then
		return
	end
	folder = Instance.new("Folder")
	folder.Name, folder.Parent = "WorldEvents", workspace
	local anchors = Instance.new("Folder")
	anchors.Name, anchors.Parent = "Anchors", folder
	for name, node in Config.Anchors do
		local anchor = Instance.new("Vector3Value")
		anchor.Name, anchor.Value, anchor.Parent = name, Plan.Nodes[node], anchors
	end
	nextEvent = os.clock() + Config.InitialDelay
	Damage.Applied:Connect(function(attacker, target, amount)
		local player = Players:GetPlayerFromCharacter(attacker)
		local model = target.Parent
		if not player or not model or model:GetAttribute("Population") ~= "WorldEvent" then
			return
		end
		local event = events[model:GetAttribute("EventId")]
		if not event or event.State ~= "Active" then
			return
		end
		-- Attributes alone are insufficient: require membership in this event's owned roster.
		for _, enemy in event.Enemies do
			if enemy.Model == model then
				Rules.credit(event.Credit, player.UserId, amount, 0, 0)
				break
			end
		end
	end)
	if Run:IsStudio() and Config.Development.Enabled then
		local force = Instance.new("BindableFunction")
		force.Name, force.Parent = "Force", folder
		force.OnInvoke = attempt
		if Config.Development.ForceEvent ~= "" then
			-- Wait for a player to finish opening before the one-shot configured test.
			task.spawn(function()
				while #Spawn.players() == 0 do
					task.wait(1)
				end
				local ok, reason = attempt(Config.Development.ForceEvent)
				print("World event force:", ok, reason)
			end)
		end
	end
	local nextTick = 0
	Run.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextTick then
			return
		end
		nextTick = now + Config.Tick
		for _, event in events do
			if
				event.State == "Preparing"
				and now - event.PreparedAt >= (event.Definition.Preparation or Config.Preparation)
			then
				activate(event, now)
			elseif event.State == "Active" then
				local living = countLiving(event)
				local protected = event.Traveler or event.Protected
				local alive = not protected or (protected.Model.Parent ~= nil and protected.Humanoid.Health > 0)
				if event.Traveler and alive then
					local position = event.Traveler.Root.Position
					local traveled = (position - event.LastPosition).Magnitude
					local dt = math.min(now - event.LastTick, Config.Tick * 2)
					-- Stationary proximity and teleports are not escort participation.
					for _, root in Spawn.players() do
						local player = Players:GetPlayerFromCharacter(root.Parent)
						local last = event.PlayerPositions[player.UserId]
						if last then
							local seconds, distance = Rules.escortStep(
								traveled,
								(root.Position - last).Magnitude,
								(last - event.LastPosition).Magnitude < 35,
								(root.Position - position).Magnitude < 35,
								dt
							)
							if seconds > 0 then
								Rules.credit(event.Credit, player.UserId, 0, seconds, distance)
							end
						end
						event.PlayerPositions[player.UserId] = root.Position
					end
					event.LastPosition = position
				end
				event.LastTick = now
				local result = Rules.outcome(
					living,
					alive,
					event.Traveler and event.Traveler.Finished,
					event.Kind == "TravelIncident",
					now - event.Started > event.Definition.Duration
				)
				if result then
					resolve(event, result == "Completed", now)
				end
			elseif event.State == "Resolving" then
				state(event, if event.Success then "Completed" else "Failed")
			elseif
				(event.State == "Completed" or event.State == "Failed")
				and now - event.ResolvedAt >= Config.CleanupDelay
			then
				cleanup(event, now)
			end
		end
		for _, player in Players:GetPlayers() do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local relevant, nearest = nil, math.huge
			if player:GetAttribute("OpeningComplete") and root then
				for _, event in events do
					local distance = (root.Position - center(event)).Magnitude
					if distance < event.Definition.DiscoveryRadius and distance < nearest then
						relevant, nearest = event, distance
					end
				end
			end
			local message = ""
			if relevant then
				message = relevant.Definition.Name .. " · " .. relevant.State
				if relevant.State == "Active" then
					message ..= "\nEnfleshed remaining: " .. countLiving(relevant)
				end
			end
			player:SetAttribute("NearbyWorldEvent", message)
		end
		if Config.RandomEnabled and Config.FrequencyMultiplier > 0 and now >= nextEvent then
			nextEvent = now + 15 -- Back off when every candidate is ineligible.
			local total = 0
			for _, definition in Config.Definitions do
				total += definition.Weight
			end
			local roll = random:NextNumber(0, total)
			for kind, definition in Config.Definitions do
				roll -= definition.Weight
				if roll <= 0 then
					attempt(kind)
					break
				end
			end
		end
	end)
end
return Director
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="160">
          <Properties>
            <string name="Name">WorldSpawnService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Plan = require(Shared.Configuration.PhaseATopology)
local Config = require(Shared.Configuration.Sandbox)
local World = require(Shared.Configuration.LowerLayerGraybox)
local Locations = require(Shared.Configuration.AssignmentLocations)
local Spawn = {}

function Spawn.safe(point: Vector3, radius: number): boolean
	return (point - World.PhaseA.RecruitSpawn).Magnitude >= radius
		and (point - Locations.Barracks_Main.Position).Magnitude >= radius
		and (point - Plan.Nodes.B1).Magnitude >= radius
end

function Spawn.ground(point: Vector3, height: number?, width: number?): Vector3?
	local geometry = workspace:FindFirstChild("LowerLayerGraybox")
	if not geometry then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { geometry }
	params.RespectCanCollide = true
	local hit = workspace:Raycast(point + Vector3.new(0, 8, 0), Vector3.new(0, -24, 0), params)
	if not hit or hit.Normal.Y < 0.9 then
		return nil
	end
	local h = height or Config.Enemy.CollisionHull.Height
	local w = width or Config.Enemy.CollisionHull.Diameter
	local overlap = OverlapParams.new()
	overlap.RespectCanCollide = true
	local center = hit.Position + Vector3.new(0, h / 2 + 0.15, 0)
	if #workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(w, h - 0.1, w), overlap) > 0 then
		return nil
	end
	return hit.Position + Vector3.new(0, 3.1, 0)
end

function Spawn.players(): { BasePart }
	local roots = {}
	for _, player in game:GetService("Players"):GetPlayers() do
		local c = player.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if player:GetAttribute("OpeningComplete") and h and h.Health > 0 and r and r:IsA("BasePart") then
			table.insert(roots, r)
		end
	end
	return roots
end

function Spawn.find(
	center: Vector3,
	radius: number,
	minimum: number,
	safeRadius: number,
	reserved: { Vector3 }
): Vector3?
	local roots = Spawn.players()
	local fallback = nil
	for _, candidate in Plan.SpawnCandidates do
		local point = (candidate.Position or Plan.Nodes[candidate.Node]) + candidate.Offset
		if (point - center).Magnitude > radius or not Spawn.safe(point, safeRadius) then
			continue
		end
		local valid, hidden = true, true
		for _, p in reserved do
			if (point - p).Magnitude < 8 then
				valid = false
			end
		end
		for _, root in roots do
			if (root.Position - point).Magnitude < minimum then
				valid = false
			end
			local params = RaycastParams.new()
			params.FilterDescendantsInstances = { root.Parent }
			params.RespectCanCollide = true
			if
				not workspace:Raycast(
					root.Position + Vector3.new(0, 2, 0),
					point + Vector3.new(0, 3, 0) - (root.Position + Vector3.new(0, 2, 0)),
					params
				)
			then
				hidden = false
			end
		end
		if valid then
			local grounded = Spawn.ground(point)
			if grounded then
				if hidden then
					return grounded
				end
				fallback = fallback or grounded
			end
		end
	end
	return fallback
end
return Spawn
]]></string>
          </Properties>
