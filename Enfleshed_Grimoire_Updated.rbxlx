        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">MagicPresentationBudget</string>
            <string name="Source"><![CDATA[-- Server-side budget for cosmetic particle emitters and explicit particle bursts.
local Budget = {}

function Budget.new(config, now)
	return {
		Config = config,
		ActiveEmitters = 0,
		ContinuousRate = 0,
		BurstTokens = config.BurstCapacity,
		LastRefill = now or 0,
	}
end

function Budget.acquireEmitter(state, rate)
	local config = state.Config
	rate = math.max(0, rate or 0)
	if state.ActiveEmitters >= config.MaxEmitters then
		return false
	end
	if state.ContinuousRate + rate > config.MaxContinuousRate then
		return false
	end
	state.ActiveEmitters = state.ActiveEmitters + 1
	state.ContinuousRate = state.ContinuousRate + rate
	return true
end

function Budget.releaseEmitter(state, rate)
	if state.ActiveEmitters <= 0 then
		return false
	end
	state.ActiveEmitters = state.ActiveEmitters - 1
	state.ContinuousRate = math.max(0, state.ContinuousRate - math.max(0, rate or 0))
	return true
end

function Budget.takeBurst(state, requested, now)
	requested = math.max(0, math.floor(requested or 0))
	if requested == 0 then
		return 0
	end
	local elapsed = math.max(0, (now or state.LastRefill) - state.LastRefill)
	state.LastRefill = now or state.LastRefill
	state.BurstTokens =
		math.min(state.Config.BurstCapacity, state.BurstTokens + elapsed * state.Config.MaxBurstPerSecond)
	local allowed = math.min(requested, math.floor(state.BurstTokens))
	state.BurstTokens = state.BurstTokens - allowed
	return allowed
end

return Budget
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">MagicPrincipleSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Data contract for Principle/Form support and named magical expressions.
-- Principle-specific payload requirements are declared in MagicSchema.
local function set(values)
	local result = {}
	for _, value in ipairs(values) do
		result[value] = true
	end
	return result
end

local materialForms = {
	"Projectile",
	"Beam",
	"Wave",
	"Field",
	"Aura",
	"Construct",
	"Manipulation",
}

local energyForms = {
	"Projectile",
	"Beam",
	"Wave",
	"Field",
	"Aura",
	"Construct",
}

local spaceForms = { "Projectile", "Beam", "Wave", "Field", "Aura", "Construct", "SelfEnhancement" }
local soulForms = { "Projectile", "Beam", "Wave", "Field", "Aura", "Construct", "SelfEnhancement" }
local timeForms = { "Projectile", "Beam", "Wave", "Field", "Aura", "Construct", "SelfEnhancement" }

local Registry = {
	Order = { "Matter", "Energy", "Body", "Soul", "Space", "Time" },
	Definitions = {
		Matter = {
			Label = "Matter",
			Description = "Magic for physical materials such as Earth and Water. Some targeting choices need a nearby material source set up for magic. Use Manipulation to act on those sources or movable objects.",
			Expressions = { "Earth", "Water" },
			DefaultExpression = "Earth",
			Forms = set(materialForms),
			Status = "SUPPORTED",
		},
		Energy = {
			Label = "Energy",
			Description = "Magic with Fire, Lightning, Force, or the legacy Unawakened source. Choose a Form to deliver it and Effects to decide what it does. Fire as a source does not add burning by itself.",
			Expressions = { "Fire", "Lightning", "Force", "Unawakened" },
			DefaultExpression = "Fire",
			Forms = set(energyForms),
			Status = "SUPPORTED",
		},
		Body = {
			Label = "Body",
			Description = "Magic for living bodies. Use direct hits, areas, or a spell on yourself. Add effects separately, such as healing or movement bonuses.",
			Expressions = { "BodyEnhancement" },
			DefaultExpression = "BodyEnhancement",
			Forms = set({ "Projectile", "Beam", "Wave", "Field", "Aura", "Construct", "SelfEnhancement" }),
			Status = "PARTIAL",
		},
		Soul = {
			Label = "Soul",
			Description = "Magic with the Spirit source. Damage effects can use the Soul damage channel, which checks soul protection instead of elemental protection.",
			Expressions = { "Spirit" },
			DefaultExpression = "Spirit",
			Forms = set(soulForms),
			Status = "PARTIAL",
		},
		Space = {
			Label = "Space",
			Description = "Magic that can move living targets to a nearby safe location. Add Spatial Displacement on Effects to use this; choosing Space alone does not teleport anything.",
			Expressions = { "SpatialFold" },
			DefaultExpression = "SpatialFold",
			Forms = set(spaceForms),
			Status = "PARTIAL",
		},
		Time = {
			Label = "Time",
			Description = "Magic that can slow or speed a target and its ongoing effects. Add Time Dilation on Effects to use this; choosing Time alone does not change anyone’s speed.",
			Expressions = { "TemporalShift" },
			DefaultExpression = "TemporalShift",
			Forms = set(timeForms),
			Status = "PARTIAL",
		},
	},
	LegacyExpressions = {
		Unawakened = { Principle = "Energy", Status = "LEGACY" },
	},
	ExpressionDescriptions = {
		Earth = "An Earth source for Matter magic. Material-targeted spells need a nearby source that the game has marked as usable.",
		Water = "A Water source for Matter magic. Material-targeted spells need a usable Water source. Choosing Water does not create flowing water or add damage.",
		Fire = "A Fire source for Energy magic. Add Damage or Damage over time on Effects if you want the spell to hurt targets.",
		Lightning = "A Lightning source for Energy magic. Add effects separately. Chain is a projectile behavior you can add; it is not automatic.",
		Force = "A source for Energy magic. Add the Force effect to push targets; choosing this source alone does not move anything.",
		BodyEnhancement = "Body expression. Choose a supported Form and add effects; selecting this source alone does not grant movement bonuses.",
		SpatialFold = "A source for Space magic. Add Spatial Displacement to move a target to a nearby safe position.",
		Spirit = "A source for Soul magic. Choose the effects you want on Effects.",
		TemporalShift = "A source for Time magic. Add Time Dilation to slow or speed a target.",
		Unawakened = "Legacy Energy source marker, also available in the testing Lab. It does not add effects.",
	},
}

function Registry.supportsForm(principle, form)
	local definition = Registry.Definitions[principle]
	return definition ~= nil and definition.Forms[form] == true
end

function Registry.expressionMatches(principle, expression)
	local definition = Registry.Definitions[principle]
	if not definition then
		return false
	end
	for _, candidate in ipairs(definition.Expressions) do
		if candidate == expression then
			return true
		end
	end
	local legacy = Registry.LegacyExpressions[expression]
	return legacy ~= nil and legacy.Principle == principle
end

return Registry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">MagicProjectileMotion</string>
            <string name="Source"><![CDATA[--!strict

-- Timed, composable projectile motion phases. Movement still resolves through
-- the server's ordinary swept hit-detection path.
local Limits = require(script.Parent.Parent.Configuration.MagicLab)
local Motion = {}

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function supportedMode(mode)
	for _, candidate in ipairs(Limits.ProjectileMotionModes or { "Linear" }) do
		if candidate == mode then
			return true
		end
	end
	return false
end

function Motion.validate(phases, lifetime, baseRadius)
	if type(phases) ~= "table" then
		return false, "Projectile motion phases must be an array"
	end
	local count = 0
	local totalDuration = 0
	for key in pairs(phases) do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > Limits.MaxProjectileMotionPhases then
			return false, "Projectile motion phase list is malformed or exceeds its size limit"
		end
		count = count + 1
	end
	if count ~= #phases then
		return false, "Projectile motion phases must be a dense array"
	end
	for index, phase in ipairs(phases) do
		if type(phase) ~= "table" then
			return false, "Projectile motion phase " .. index .. " must be a table"
		end
		for key in pairs(phase) do
			if
				key ~= "Mode"
				and key ~= "Duration"
				and key ~= "SpeedMultiplier"
				and key ~= "Acceleration"
				and key ~= "Gravity"
				and key ~= "ArcHeight"
				and key ~= "BezierSide"
				and key ~= "BezierHeight"
				and key ~= "OrbitRadius"
				and key ~= "OrbitAngularSpeed"
				and key ~= "ExpandMultiplier"
			then
				return false, "Unknown projectile motion phase setting: " .. tostring(key)
			end
		end
		local mode = phase.Mode or "Linear"
		if not supportedMode(mode) then
			return false, "Unsupported projectile motion mode"
		elseif mode == "Arcing" then
			if
				not finite(phase.ArcHeight)
				or phase.ArcHeight < 0.1
				or phase.ArcHeight > Limits.MaxProjectileArcHeight
			then
				return false, "Projectile arc height exceeds its safety limit"
			end
		elseif mode == "Bezier" then
			if
				not finite(phase.BezierSide or 0)
				or math.abs(phase.BezierSide or 0) > Limits.MaxProjectileBezierOffset
				or not finite(phase.BezierHeight or 0)
				or math.abs(phase.BezierHeight or 0) > Limits.MaxProjectileBezierOffset
				or math.abs(phase.BezierSide or 0) + math.abs(phase.BezierHeight or 0) < 0.1
			then
				return false, "Bezier phases need a visible, bounded side or height offset"
			elseif (phase.Acceleration or 0) ~= 0 or (phase.Gravity or 0) ~= 0 then
				return false, "Bezier phases cannot also apply acceleration or gravity"
			end
		elseif mode == "Falling" then
			if not finite(phase.Gravity) or phase.Gravity < 1 or phase.Gravity > Limits.MaxGravity then
				return false, "Falling projectile phases need bounded positive gravity"
			end
		elseif mode == "Orbiting" then
			if
				not finite(phase.OrbitRadius)
				or phase.OrbitRadius < 0.5
				or phase.OrbitRadius > Limits.MaxProjectileOrbitRadius
				or not finite(phase.OrbitAngularSpeed)
				or math.abs(phase.OrbitAngularSpeed) < 0.1
				or math.abs(phase.OrbitAngularSpeed) > Limits.MaxProjectileOrbitSpeed
			then
				return false, "Orbit radius or angular speed exceeds its safety limit"
			end
		elseif mode == "Expanding" then
			if
				not finite(phase.ExpandMultiplier)
				or phase.ExpandMultiplier < 1.1
				or phase.ExpandMultiplier > Limits.MaxProjectileExpansion
			then
				return false, "Projectile expansion exceeds its safety limit"
			elseif
				(baseRadius or 1) * (phase.ExpandMultiplier - 1) / phase.Duration
				> Limits.MaxProjectileExpansionSpeed
			then
				return false, "Projectile collision growth is too fast for reliable swept hit detection"
			end
		end
		if not finite(phase.Duration) or phase.Duration < Limits.MinInterval or phase.Duration > Limits.MaxDuration then
			return false, "Projectile motion phase duration is outside its safety limit"
		end
		if
			phase.SpeedMultiplier ~= nil
			and (not finite(phase.SpeedMultiplier) or phase.SpeedMultiplier < 0.1 or phase.SpeedMultiplier > 3)
		then
			return false, "Projectile phase speed multiplier must be 0.1–3"
		end
		if
			phase.Acceleration ~= nil
			and (not finite(phase.Acceleration) or math.abs(phase.Acceleration) > Limits.MaxAcceleration)
		then
			return false, "Projectile phase acceleration exceeds its safety limit"
		end
		if
			phase.Gravity ~= nil
			and (not finite(phase.Gravity) or phase.Gravity < 0 or phase.Gravity > Limits.MaxGravity)
		then
			return false, "Projectile phase gravity exceeds its safety limit"
		end
		totalDuration = totalDuration + phase.Duration
	end
	if totalDuration > lifetime then
		return false, "Projectile motion phases outlast the projectile lifetime"
	end
	return true
end

function Motion.advance(phases, index, elapsed, delta)
	if #phases == 0 then
		return nil, 0, nil
	end
	index = math.max(1, math.min(index or 1, #phases))
	elapsed = (elapsed or 0) + math.max(delta, 0)
	while index < #phases and elapsed >= phases[index].Duration do
		elapsed = elapsed - phases[index].Duration
		index = index + 1
	end
	return index, elapsed, phases[index]
end

function Motion.initialSpeed(projectileSpeed, phases)
	local first = phases and phases[1]
	return projectileSpeed * (first and first.SpeedMultiplier or 1)
end

function Motion.arcOffset(height, duration, elapsed)
	local alpha = math.max(0, math.min(elapsed / duration, 1))
	return 4 * height * alpha * (1 - alpha)
end

function Motion.expansion(multiplier, duration, elapsed)
	local alpha = math.max(0, math.min(elapsed / duration, 1))
	return 1 + (multiplier - 1) * alpha
end

function Motion.bezierPosition(origin, direction, sideAxis, distance, sideOffset, heightOffset, alpha)
	local t = math.max(0, math.min(alpha, 1))
	local inverse = 1 - t
	local p0 = origin
	local p1 = origin + direction * (distance / 3) + sideAxis * sideOffset + Vector3.yAxis * heightOffset
	local p2 = origin + direction * (distance * 2 / 3) + sideAxis * sideOffset + Vector3.yAxis * heightOffset
	local p3 = origin + direction * distance
	return p0 * (inverse ^ 3) + p1 * (3 * inverse ^ 2 * t) + p2 * (3 * inverse * t ^ 2) + p3 * (t ^ 3)
end

function Motion.bezierTangent(direction, sideAxis, distance, sideOffset, heightOffset, alpha)
	local t = math.max(0, math.min(alpha, 1))
	local inverse = 1 - t
	local control = sideAxis * sideOffset + Vector3.yAxis * heightOffset
	local p0 = Vector3.zero
	local p1 = direction * (distance / 3) + control
	local p2 = direction * (distance * 2 / 3) + control
	local p3 = direction * distance
	return (p1 - p0) * (3 * inverse ^ 2) + (p2 - p1) * (6 * inverse * t) + (p3 - p2) * (3 * t ^ 2)
end

return Motion
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">MagicProximitySpec</string>
            <string name="Source"><![CDATA[--!strict

-- Shared bounds and per-effect de-duplication state for proximity events.
local Spec = {}

Spec.SupportedForms = {
	SelfEnhancement = true,
	Construct = true,
}

Spec.Defaults = {
	Radius = 8,
	Interval = 0.2,
	MaxTargets = 8,
}

function Spec.validate(value, maxRadius, minInterval, maxTargets)
	if type(value) ~= "table" then
		return false
	end
	local radius = value.Radius
	local interval = value.Interval
	local targetLimit = value.MaxTargets
	return type(radius) == "number"
		and radius == radius
		and radius >= 0.25
		and radius <= maxRadius
		and type(interval) == "number"
		and interval == interval
		and interval >= minInterval
		and interval <= 1
		and type(targetLimit) == "number"
		and targetLimit % 1 == 0
		and targetLimit >= 1
		and targetLimit <= maxTargets
end

function Spec.newState(now)
	return {
		NextCheckAt = now or 0,
		Targets = {},
		TargetCount = 0,
	}
end

function Spec.isDue(state, now, maximumTargets)
	return state.TargetCount < maximumTargets and now >= state.NextCheckAt
end

function Spec.beginSample(state, now, interval)
	state.NextCheckAt = now + interval
end

function Spec.claim(state, target, maximumTargets)
	if state.Targets[target] or state.TargetCount >= maximumTargets then
		return false
	end
	state.Targets[target] = true
	state.TargetCount = state.TargetCount + 1
	return true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">MagicRelationship</string>
            <string name="Source"><![CDATA[--!strict

-- Small pure classifier shared by target filters and condition evaluation.
local Relationships = {}

function Relationships.resolveAlignment(explicitAlignment, ownerAlignment)
	if type(ownerAlignment) == "string" and ownerAlignment ~= "" then
		return ownerAlignment
	end
	if type(explicitAlignment) == "string" and explicitAlignment ~= "" then
		return explicitAlignment
	end
	return nil
end

function Relationships.classify(isSelf, isHostile, sameAlignment, mutuallyAllied)
	if isSelf then
		return "Self"
	elseif isHostile then
		return "Hostile"
	elseif sameAlignment or mutuallyAllied then
		return "Ally"
	end
	return "Neutral"
end

function Relationships.matches(relationship, rule)
	return rule == nil or rule == "Any" or relationship == rule
end

return Relationships
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">MagicRevealSpec</string>
            <string name="Source"><![CDATA[-- Aggregates owner-scoped reveal expiries for one target.
local Reveal = {}

function Reveal.attributeNames(userId)
	local suffix = tostring(userId)
	return "MagicRevealUntil_" .. suffix, "MagicRevealColor_" .. suffix
end

function Reveal.aggregate(effects, now)
	local result = {}
	for _, effect in ipairs(effects) do
		local userId = effect.ViewerUserId
		if effect.Kind == "Reveal" and userId and effect.ExpiresAt > now then
			local previous = result[userId]
			if not previous or effect.ExpiresAt >= previous.ExpiresAt then
				result[userId] = { ExpiresAt = effect.ExpiresAt, Color = effect.Color }
			end
		end
	end
	return result
end

return Reveal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">MagicRig</string>
            <string name="Source"><![CDATA[--!strict
-- Recognize both legacy and upgraded avatar joints; never modify rig attachments.
local Rig = {}
local bodies = {
	RightUpperArm = "RightArm",
	LeftUpperArm = "LeftArm",
	["Right Arm"] = "RightArm",
	["Left Arm"] = "LeftArm",
	RightLowerArm = "RightElbow",
	LeftLowerArm = "LeftElbow",
	UpperTorso = "Torso",
	Torso = "Torso",
	Head = "Neck",
}
function Rig.describe(joint)
	local modern = joint:IsA("AnimationConstraint")
	if not modern and not joint:IsA("Motor6D") then
		return nil
	end
	local part, frame
	if modern then
		if not joint.Attachment0 or not joint.Attachment1 then
			return nil
		end
		part = joint.Attachment1.Parent
		frame = joint.Attachment0.CFrame
	else
		if not joint.Part0 or not joint.Part1 then
			return nil
		end
		part = joint.Part1
		frame = joint.C0
	end
	local role = part and bodies[part.Name]
	if not role then
		return nil
	end
	return { Joint = joint, Frame = frame, Role = role }
end
function Rig.strength(t)
	if t < 0 or t >= 1 then
		return 0
	end
	local x = math.min(t / 0.22, 1) * math.min((1 - t) / 0.3, 1)
	return x * x * (3 - 2 * x)
end
return Rig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">MagicShieldPool</string>
            <string name="Source"><![CDATA[--!strict

-- Consumes the already-ordered shield effects on a target.
local Pool = {}

function Pool.consume(effects, amount)
	local remaining = math.max(0, amount)
	local broken = {}

	for _, effect in ipairs(effects) do
		if effect.Kind == "Shield" and remaining > 0 then
			local pool = math.max(0, effect.Amount or 0)
			local used = math.min(pool, remaining)
			effect.Amount = pool - used
			remaining = remaining - used
			if pool > 0 and effect.Amount <= 0 then
				table.insert(broken, effect)
			end
		end
	end

	return remaining, amount - remaining, broken
end

return Pool
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">MagicSlots</string>
            <string name="Source"><![CDATA[--!strict
-- Fixed identities keep slot replacement from resetting cooldowns.
local Slots = { Count = 9 }
function Slots.id(slot)
	if type(slot) ~= "number" or slot ~= slot or slot % 1 ~= 0 or slot < 1 or slot > Slots.Count then
		return nil
	end
	return "MagicLabSlot" .. slot
end
return Slots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">MagicSpecialResourceSpec</string>
            <string name="Source"><![CDATA[-- Generic named resource rules shared by SpellSpec, the server runtime, and tests.
local Spec = {}

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Spec.order(definitions)
	local result = {}
	for id in pairs(definitions or {}) do
		table.insert(result, id)
	end
	table.sort(result)
	return result
end

function Spec.defaults(definitions)
	local result = {}
	for id, definition in pairs(definitions or {}) do
		result[id] = definition.Starting
	end
	return result
end

function Spec.validateDefinitions(definitions)
	if type(definitions) ~= "table" then
		return false, "Special resource definitions must be a table"
	end
	for id, definition in pairs(definitions) do
		if
			type(id) ~= "string"
			or not string.match(id, "^[%a][%w_]*$")
			or type(definition) ~= "table"
			or type(definition.Label) ~= "string"
			or #definition.Label < 1
			or #definition.Label > 32
			or not finite(definition.Capacity)
			or definition.Capacity <= 0
			or not finite(definition.Starting)
			or definition.Starting < 0
			or definition.Starting > definition.Capacity
			or not finite(definition.RecoveryPerSecond)
			or definition.RecoveryPerSecond < 0
			or type(definition.Attribute) ~= "string"
			or not string.match(definition.Attribute, "^Magic[%w_]+$")
		then
			return false, "Invalid special resource definition: " .. tostring(id)
		end
	end
	return true
end

function Spec.validateCosts(costs, definitions, maxTypes, maxCost)
	if costs == nil then
		return true
	end
	if type(costs) ~= "table" then
		return false, "Special resource costs must be a table"
	end
	local count = 0
	for id, amount in pairs(costs) do
		local definition = definitions and definitions[id]
		if not definition then
			return false, "Unknown special resource: " .. tostring(id)
		end
		if not finite(amount) or amount < 0 or amount > maxCost then
			return false, "Invalid special resource cost: " .. tostring(id)
		end
		count = count + 1
	end
	if count > maxTypes then
		return false, "Too many special resource costs"
	end
	return true
end

function Spec.validateCurrent(current, definitions)
	if type(current) ~= "table" then
		return false
	end
	for id, amount in pairs(current) do
		local definition = definitions and definitions[id]
		if not definition or not finite(amount) or amount < 0 or amount > definition.Capacity then
			return false
		end
	end
	for id in pairs(definitions or {}) do
		if current[id] == nil then
			return false
		end
	end
	return true
end

function Spec.mergeCurrent(current, definitions)
	local result = Spec.defaults(definitions)
	if type(current) == "table" then
		for id, value in pairs(current) do
			if definitions and definitions[id] then
				result[id] = value
			end
		end
	end
	return result
end

function Spec.canAfford(current, costs, definitions)
	local valid = Spec.validateCosts(costs, definitions, math.huge, math.huge)
	if not valid or not Spec.validateCurrent(current, definitions) then
		return false, nil
	end
	for id, amount in pairs(costs or {}) do
		if current[id] < amount then
			return false, id
		end
	end
	return true, nil
end

function Spec.spend(current, costs, definitions)
	local canAfford, missing = Spec.canAfford(current, costs, definitions)
	if not canAfford then
		return false, missing
	end
	for id, amount in pairs(costs or {}) do
		current[id] = current[id] - amount
	end
	return true, nil
end

function Spec.advance(current, definitions, delta)
	if delta <= 0 or not Spec.validateCurrent(current, definitions) then
		return false
	end
	local changed = false
	for id, definition in pairs(definitions or {}) do
		local before = current[id]
		current[id] = math.min(definition.Capacity, before + definition.RecoveryPerSecond * delta)
		changed = changed or current[id] ~= before
	end
	return changed
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">MagicSpellIdentitySpec</string>
            <string name="Source"><![CDATA[-- Shared validation and normalization for editable spell identity tags.
local Spec = { MaxTags = 16, MaxTagLength = 48 }

local function clean(value)
	return string.lower(string.gsub(value, "^%s*(.-)%s*$", "%1"))
end

function Spec.validateTags(tags)
	if type(tags) ~= "table" or #tags > Spec.MaxTags then
		return false, "Use at most " .. Spec.MaxTags .. " spell tags"
	end
	local seen = {}
	for _, value in ipairs(tags) do
		if type(value) ~= "string" then
			return false, "Spell tags must be text"
		end
		local tag = clean(value)
		if tag == "" or #tag > Spec.MaxTagLength or string.find(tag, "[^%w_%-]") then
			return false,
				"Each spell tag must use letters, numbers, _ or - (1–" .. Spec.MaxTagLength .. " characters)"
		end
		if seen[tag] then
			return false, "Spell tags must be unique"
		end
		seen[tag] = true
	end
	return true
end

function Spec.parse(text)
	if type(text) ~= "string" then
		return nil, "Spell tags must be text"
	end
	local tags = {}
	local seen = {}
	for token in string.gmatch(text, "[^,;]+") do
		local tag = clean(token)
		if tag ~= "" and not seen[tag] then
			table.insert(tags, tag)
			seen[tag] = true
		end
	end
	local valid, reason = Spec.validateTags(tags)
	if not valid then
		return nil, reason
	end
	return tags
end

function Spec.encode(tags)
	local valid = Spec.validateTags(tags or {})
	if not valid then
		return "||"
	end
	local canonical = {}
	for _, tag in ipairs(tags) do
		table.insert(canonical, clean(tag))
	end
	return "|" .. table.concat(canonical, "|") .. "|"
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">MagicStatusEffectSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Pure expiry rules for server-owned target status effects.
local Spec = {}

function Spec.isExpired(kind, expiresAt, remaining, now, casterAlive, viewerPresent)
	if not casterAlive or not viewerPresent then
		return true
	end

	if kind == "TimeDilation" then
		return type(expiresAt) ~= "number" or expiresAt ~= expiresAt or expiresAt <= now
	end

	return type(remaining) ~= "number" or remaining ~= remaining or remaining <= 0
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">MagicSummonRolePolicy</string>
            <string name="Source"><![CDATA[--!strict

-- Small role/command targeting policy shared by the server and pure tests.
local Policy = {}

function Policy.targetMode(role, command, profileMode)
	if command == "Hold" or command == "Follow" then
		return "None"
	end
	if role.TargetMode == "AllySupport" then
		if profileMode == "Ally" then
			return "Ally"
		end
		return "None"
	end
	if command == "Attack" then
		return "Hostile"
	end
	if command == "Support" or profileMode == "Ally" then
		if profileMode == "Ally" then
			return "Ally"
		end
		return "None"
	end
	return "Hostile"
end

function Policy.canMelee(role, profileMode)
	return role.CanMelee == true and profileMode ~= "Ally"
end

function Policy.requiresOwnerProtectionRadius(role)
	return role.TargetMode == "GuardedHostile"
end

function Policy.noHostileTargetReason(role, facts, guardRadius)
	if not facts.HasTaggedHostile then
		return "No hostile Enfleshed or MagicHostileTarget is registered"
	elseif not facts.HasLivingHostile then
		return "No living hostile target is available"
	elseif Policy.requiresOwnerProtectionRadius(role) and not facts.WithinGuardRadius then
		return string.format("Guardian only protects hostiles within %d studs of you", guardRadius)
	elseif not facts.WithinScanRange then
		return "No hostile target is within the summon spell's scan range"
	elseif not facts.Visible then
		return "Hostile is in range but blocked from view"
	end
	return "No eligible hostile target is available"
end

function Policy.targetScanRange(authoredSpellRange, defaultRange, maximumRange)
	if type(authoredSpellRange) ~= "number" or authoredSpellRange <= 0 then
		return defaultRange
	end
	return math.min(authoredSpellRange, maximumRange)
end

function Policy.castRange(authoredSpellRange, defaultRange, maximumRange)
	if type(authoredSpellRange) ~= "number" or authoredSpellRange <= 0 then
		return defaultRange
	end
	return math.min(authoredSpellRange, maximumRange)
end

return Policy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">MagicTargetConsentSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Consent is a server-owned player preference. Non-player Humanoids are not
-- gated; spells can require opt-in for multiplayer targets without changing
-- NPC or training-dummy behavior.
local Spec = {}
Spec.Attribute = "MagicAcceptsTargetedSpells"

function Spec.valid(value)
	return type(value) == "boolean"
end

function Spec.allows(required, model, players)
	if required ~= true or not model then
		return true
	end
	local player = players:GetPlayerFromCharacter(model)
	return player == nil or player:GetAttribute(Spec.Attribute) == true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">MagicTargetDeathSpec</string>
            <string name="Source"><![CDATA[-- Cause filters for the OnTargetDeath lifecycle event.
local Spec = {}

Spec.Modes = { "Either", "KilledByThisSpell", "DiedWhileAffected" }

function Spec.matches(mode, cause)
	return mode == nil or mode == "Either" or mode == cause
end

function Spec.claim(runtime, target)
	if type(runtime) ~= "table" or target == nil then
		return true
	end
	local claims = runtime.TargetDeathClaims
	if type(claims) ~= "table" then
		claims = setmetatable({}, { __mode = "k" })
		runtime.TargetDeathClaims = claims
	end
	if claims[target] then
		return false
	end
	claims[target] = true
	return true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">MagicTargetingSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Target selection cannot reach farther than either the authored targeting
-- range or the maximum distance of the Form's actual cast geometry.
local Spec = {}

function Spec.entityRange(definition)
	local targetingRange = definition.TargetRules.Range
	local formRange = nil
	if definition.Form == "Projectile" then
		formRange = definition.Projectile.MaxDistance
	elseif definition.Form == "Beam" then
		formRange = definition.Beam.Range
	elseif definition.Form == "Wave" then
		formRange = definition.Wave.Range
	elseif definition.Form == "Construct" then
		formRange = definition.Construct.Distance
	end
	if type(formRange) == "number" then
		return math.min(targetingRange, formRange)
	end
	return targetingRange
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">MagicTemporalRate</string>
            <string name="Source"><![CDATA[-- Pure bounded time-rate math shared by status and periodic-effect runtimes.
local Rate = {}
Rate.Minimum = 0.25
Rate.Maximum = 2

function Rate.configure(minimum, maximum)
	if
		type(minimum) == "number"
		and type(maximum) == "number"
		and minimum > 0
		and minimum <= 1
		and maximum >= 1
		and maximum >= minimum
	then
		Rate.Minimum = minimum
		Rate.Maximum = maximum
	end
end

function Rate.clamp(value)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return 1
	end
	return math.max(Rate.Minimum, math.min(Rate.Maximum, value))
end

function Rate.combine(effects, now)
	local value = 1
	for _, effect in ipairs(effects) do
		if effect.Kind == "TimeDilation" and effect.ExpiresAt > now then
			value = value * Rate.clamp(effect.Multiplier)
		end
	end
	return Rate.clamp(value)
end

function Rate.advance(remaining, elapsed, multiplier)
	return math.max(0, remaining - math.max(0, elapsed) * Rate.clamp(multiplier))
end

function Rate.worldDuration(localDuration, multiplier)
	return math.max(0, localDuration) / Rate.clamp(multiplier)
end

return Rate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">MagicTickClock</string>
            <string name="Source"><![CDATA[--!strict
-- Preserve tick phase despite frame jitter; skip missed ticks instead of bursting.
local Clock = {}
function Clock.advance(nextTick, interval, expires, now)
	if nextTick > expires or now > expires + interval then
		return false, nil
	end
	if now < nextTick then
		return false, nextTick
	end
	local following = nextTick + interval * (math.floor((now - nextTick) / interval) + 1)
	return true, following <= expires and following or nil
end
return Clock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">MagicTransformationSpec</string>
            <string name="Source"><![CDATA[-- Bounded model-scale transformation rules shared by validation and runtime.
local Limits = require(script.Parent.Parent.Configuration.MagicLab)

local Spec = {}

local function clamp(value, minimum, maximum)
	return math.max(minimum, math.min(maximum, value))
end

function Spec.clampScale(multiplier)
	if type(multiplier) ~= "number" or multiplier ~= multiplier or math.abs(multiplier) == math.huge then
		return nil
	end
	return clamp(multiplier, Limits.MinTransformScale, Limits.MaxTransformScale)
end

function Spec.aggregate(effects, now)
	local scale = 1
	for _, effect in ipairs(effects) do
		if effect.Kind == "Transformation" and (now == nil or effect.ExpiresAt == nil or effect.ExpiresAt > now) then
			scale = scale * (effect.Multiplier or 1)
		end
	end
	return clamp(scale, 1 / Limits.MaxCombinedTransformScale, Limits.MaxCombinedTransformScale)
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">MagicTriggerSpec</string>
            <string name="Source"><![CDATA[-- Pure trigger normalization shared by registered spells and the Magic Lab.
local TriggerSpec = {}

local function normalizeActions(actions)
	if type(actions) ~= "table" then
		return nil
	end
	local first = actions[1]
	if type(first) == "table" and first.Kind ~= nil then
		return { { Payloads = actions } }
	end
	return actions
end

function TriggerSpec.normalize(source)
	local result = {}
	if type(source) ~= "table" then
		return result
	end

	-- Process canonical keys first, then append aliases so unordered table
	-- iteration can never discard or reorder the alias steps.
	for event, actions in pairs(source) do
		if event ~= "OnInterval" then
			local normalized = normalizeActions(actions)
			if normalized then
				result[event] = normalized
			end
		end
	end

	local intervalActions = normalizeActions(source.OnInterval)
	if intervalActions then
		result.OnTick = result.OnTick or {}
		for _, action in ipairs(intervalActions) do
			table.insert(result.OnTick, action)
		end
	end

	return result
end

return TriggerSpec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">MagicVisualSpec</string>
            <string name="Source"><![CDATA[-- Visual authoring is separate from hit geometry and spell execution.
local Spec = {}

Spec.Materials = { "Auto", "Neon", "ForceField", "Glass", "SmoothPlastic", "Slate" }
Spec.CoreShapes = { "Sphere", "Block", "Crystal", "Wedge", "Cylinder" }
Spec.ParticleStyles = { "Sparks", "Smoke", "Embers", "None" }
Spec.TrailStyles = { "Ribbon", "Particles", "None" }
Spec.ImpactStyles = { "Burst", "Ring", "Pulse", "Cross", "None" }
Spec.CastingStyles = { "HandGlow", "GroundSigil", "None" }
Spec.SurfaceBehaviors = { "None", "Pulse" }
Spec.EnvironmentalVisuals = { "None", "Motes", "GroundMist" }
Spec.Palettes = { "Origin", "Ember", "Tide", "Verdant", "Soulfire", "Rift", "Chronal", "LegacyCustom" }
-- Palette presentation is cosmetic metadata. Keep it separate from the dormant
-- discovery rules so the authoring UI does not depend on progression state.
Spec.PaletteDefinitions = {
	Origin = {
		Label = "Origin",
		Colors = { Color3.fromRGB(180, 230, 255), Color3.fromRGB(100, 190, 255), Color3.new(1, 1, 1) },
	},
	Ember = {
		Label = "Ember",
		Colors = { Color3.fromRGB(255, 104, 45), Color3.fromRGB(205, 45, 23), Color3.fromRGB(255, 217, 105) },
	},
	Tide = {
		Label = "Tide",
		Colors = { Color3.fromRGB(61, 183, 207), Color3.fromRGB(48, 103, 180), Color3.fromRGB(178, 239, 237) },
	},
	Verdant = {
		Label = "Verdant",
		Colors = { Color3.fromRGB(119, 194, 105), Color3.fromRGB(49, 119, 75), Color3.fromRGB(218, 225, 129) },
	},
	Soulfire = {
		Label = "Soulfire",
		Colors = { Color3.fromRGB(219, 114, 244), Color3.fromRGB(120, 70, 193), Color3.fromRGB(255, 190, 228) },
	},
	Rift = {
		Label = "Rift",
		Colors = { Color3.fromRGB(237, 187, 100), Color3.fromRGB(173, 99, 58), Color3.fromRGB(255, 232, 174) },
	},
	Chronal = {
		Label = "Chronal",
		Colors = { Color3.fromRGB(124, 225, 197), Color3.fromRGB(62, 140, 143), Color3.fromRGB(209, 255, 227) },
	},
}

local expressionMaterials = {
	Matter = { Earth = "Slate", Water = "Glass" },
	Energy = { Fire = "Neon", Lightning = "ForceField", Force = "SmoothPlastic" },
	Body = { BodyEnhancement = "ForceField" },
	Soul = { Spirit = "Glass" },
	Space = { SpatialFold = "ForceField" },
	Time = { TemporalShift = "Glass" },
}

function Spec.autoMaterial(principle, expression, form)
	if form == "Construct" then
		return "Slate"
	end
	local byExpression = expressionMaterials[principle]
	return (byExpression and byExpression[expression]) or "Neon"
end

Spec.Defaults = {
	Color = Color3.fromRGB(180, 230, 255),
	SecondaryColor = Color3.fromRGB(100, 190, 255),
	AccentColor = Color3.new(1, 1, 1),
	Palette = "Origin",
	Profile = "Auto",
	ProjectileScale = 1,
	CoreShape = "Sphere",
	MaterialAppearance = "Auto",
	Opacity = 0.85,
	Emission = 0.8,
	ParticleStyle = "Sparks",
	TrailStyle = "Ribbon",
	ImpactStyle = "Burst",
	CastingStyle = "HandGlow",
	SurfaceBehavior = "None",
	EnvironmentalVisual = "None",
	Distortion = 0,
}

local allowed = {}
for key in pairs(Spec.Defaults) do
	allowed[key] = true
end

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function contains(values, value)
	for _, item in ipairs(values) do
		if item == value then
			return true
		end
	end
	return false
end

function Spec.validate(visual)
	if type(visual) ~= "table" then
		return false, "Visual settings must be a table"
	end
	for key in pairs(visual) do
		if not allowed[key] then
			return false, "Unsupported visual setting"
		end
	end
	if typeof(visual.Color) ~= "Color3" then
		return false, "Primary visual color must be a Color3"
	end
	for _, key in ipairs({ "SecondaryColor", "AccentColor" }) do
		if visual[key] ~= nil and typeof(visual[key]) ~= "Color3" then
			return false, "Secondary and accent colors must be Color3 values"
		end
	end
	if
		visual.ProjectileScale ~= nil
		and (not finite(visual.ProjectileScale) or visual.ProjectileScale < 1 or visual.ProjectileScale > 4)
	then
		return false, "Projectile appearance scale must be between 1 and 4"
	end
	if visual.Opacity ~= nil and (not finite(visual.Opacity) or visual.Opacity < 0.2 or visual.Opacity > 1) then
		return false, "Visual opacity must be between 0.2 and 1 so core effects remain readable"
	end
	if visual.Emission ~= nil and (not finite(visual.Emission) or visual.Emission < 0 or visual.Emission > 1) then
		return false, "Visual emission must be between 0 and 1"
	end
	if
		visual.Distortion ~= nil and (not finite(visual.Distortion) or visual.Distortion < 0 or visual.Distortion > 1)
	then
		return false, "Camera distortion must be between 0 and 1"
	end
	local options = {
		CoreShape = Spec.CoreShapes,
		MaterialAppearance = Spec.Materials,
		ParticleStyle = Spec.ParticleStyles,
		TrailStyle = Spec.TrailStyles,
		ImpactStyle = Spec.ImpactStyles,
		CastingStyle = Spec.CastingStyles,
		SurfaceBehavior = Spec.SurfaceBehaviors,
		EnvironmentalVisual = Spec.EnvironmentalVisuals,
		Palette = Spec.Palettes,
	}
	for key, values in pairs(options) do
		if visual[key] ~= nil and not contains(values, visual[key]) then
			return false, "Unsupported visual option: " .. key
		end
	end
	return true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">MovementSpeed</string>
            <string name="Source"><![CDATA[--!strict
-- One calculation for server speed, validation budgets and client prediction.
local Speed = {}
function Speed.calculate(walk, sprint, sprinting, bonus, multiplier)
	return ((sprinting and sprint or walk) + bonus) * multiplier
end
return Speed
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">ProjectileBehaviorSpec</string>
            <string name="Source"><![CDATA[--!strict

-- Shared authoring metadata for reusable projectile behavior components.
-- Runtime code has a separate server-only executor registry.
local Limits = require(script.Parent.Parent.Configuration.MagicLab)

local Definitions: { [string]: any } = {
	Proximity = {
		Label = "Proximity trigger",
		Description = "Runs On target approaches once for each valid target entering this moving projectile's radius.",
		Defaults = { Kind = "Proximity", Radius = 6, Interval = 0.2, MaxTargets = 4 },
		Fields = {
			{ Key = "Radius", Label = "Proximity radius", Min = 1, Max = Limits.MaxRadius },
			{ Key = "Interval", Label = "Proximity check interval", Min = Limits.MinInterval, Max = 1 },
			{
				Key = "MaxTargets",
				Label = "Maximum targets triggered",
				Min = 1,
				Max = Limits.MaxTargets,
				Integer = true,
			},
		},
	},
	Absorb = {
		Label = "Absorb hostile projectiles",
		Description = "Intercepts nearby hostile magical projectiles and converts each into a bounded potency increase.",
		Defaults = {
			Kind = "Absorb",
			Radius = 7,
			CheckInterval = 0.15,
			MaxAbsorbed = 3,
			PowerPerAbsorption = 0.35,
			MaxPotencyMultiplier = 2.5,
		},
		Fields = {
			{ Key = "Radius", Label = "Interception radius", Min = 1, Max = Limits.MaxRadius },
			{ Key = "CheckInterval", Label = "Intercept check interval", Min = Limits.MinInterval, Max = 1 },
			{
				Key = "MaxAbsorbed",
				Label = "Maximum projectiles absorbed",
				Min = 1,
				Max = Limits.MaxAbsorbedProjectiles,
				Integer = true,
			},
			{
				Key = "PowerPerAbsorption",
				Label = "Potency gained per absorption",
				Min = 0.1,
				Max = Limits.MaxAbsorbPowerGain,
			},
			{
				Key = "MaxPotencyMultiplier",
				Label = "Maximum potency multiplier",
				Min = 1,
				Max = Limits.MaxAbsorbPotencyMultiplier,
			},
		},
	},
	Reflect = {
		Label = "Reflect hostile projectiles",
		Description = "Redirects nearby hostile magical projectiles toward their original caster and transfers their authority to you.",
		Defaults = {
			Kind = "Reflect",
			Radius = 7,
			CheckInterval = 0.15,
			MaxReflections = 3,
			MaxHopsPerProjectile = 1,
		},
		Fields = {
			{ Key = "Radius", Label = "Interception radius", Min = 1, Max = Limits.MaxRadius },
			{ Key = "CheckInterval", Label = "Intercept check interval", Min = Limits.MinInterval, Max = 1 },
			{
				Key = "MaxReflections",
				Label = "Maximum projectiles redirected",
				Min = 1,
				Max = Limits.MaxProjectileReflections,
				Integer = true,
			},
			{
				Key = "MaxHopsPerProjectile",
				Label = "Maximum reflections per projectile",
				Min = 1,
				Max = Limits.MaxProjectileReflectionHops,
				Integer = true,
			},
		},
	},
	Pulse = {
		Label = "Pulse while traveling",
		Description = "Emits a bounded area pulse around the moving projectile at a fixed interval. Effects use On each pulse.",
		Defaults = { Kind = "Pulse", Radius = 5, Interval = 0.6 },
		Fields = {
			{ Key = "Radius", Label = "Pulse radius", Min = 0.5, Max = Limits.MaxRadius },
			{ Key = "Interval", Label = "Pulse interval", Min = Limits.MinInterval, Max = 5 },
		},
	},
	Homing = {
		Label = "Homing",
		Description = "Turns a moving projectile toward nearby valid targets.",
		Defaults = { Kind = "Homing", SearchRadius = 24, TurnRate = 180 },
		Fields = {
			{ Key = "SearchRadius", Label = "Seek radius", Min = 4, Max = Limits.MaxHomingSearchRadius },
			{ Key = "TurnRate", Label = "Turn rate (degrees / second)", Min = 30, Max = Limits.MaxHomingTurnRate },
		},
	},
	Pierce = {
		Label = "Pierce",
		Description = "Allows a projectile to continue through additional targets.",
		Defaults = { Kind = "Pierce", MaxPierces = 1 },
		Fields = {
			{
				Key = "MaxPierces",
				Label = "Additional targets pierced",
				Min = 1,
				Max = Limits.MaxPierces,
				Integer = true,
			},
		},
	},
	Chain = {
		Label = "Chain",
		Description = "Repeats the projectile payload on nearby targets after impact.",
		Defaults = { Kind = "Chain", Radius = 10, MaxJumps = 3, DamageFalloff = 0.7 },
		Fields = {
			{ Key = "Radius", Label = "Jump radius", Min = 2, Max = Limits.MaxRadius },
			{ Key = "MaxJumps", Label = "Maximum chained jumps", Min = 1, Max = Limits.MaxChainJumps, Integer = true },
			{ Key = "DamageFalloff", Label = "Payload falloff per jump", Min = 0.1, Max = 1 },
		},
	},
	Bounce = {
		Label = "Bounce",
		Description = "Reflects from solid world geometry a limited number of times; characters still receive normal impact effects.",
		Defaults = { Kind = "Bounce", MaxBounces = 2, Restitution = 0.8 },
		Fields = {
			{ Key = "MaxBounces", Label = "Maximum bounces", Min = 1, Max = Limits.MaxBounces, Integer = true },
			{ Key = "Restitution", Label = "Speed retained per bounce", Min = 0.2, Max = 1 },
		},
	},
	Split = {
		Label = "Split",
		Description = "Creates a bounded fan of weaker child projectiles on impact.",
		Defaults = { Kind = "Split", ChildCount = 3, SpreadAngle = 24, DamageFalloff = 0.65 },
		Fields = {
			{ Key = "ChildCount", Label = "Child projectiles", Min = 2, Max = Limits.MaxSplitChildren, Integer = true },
			{ Key = "SpreadAngle", Label = "Fan angle (degrees)", Min = 5, Max = Limits.MaxSplitAngle },
			{ Key = "DamageFalloff", Label = "Payload strength per child", Min = 0.1, Max = 1 },
		},
	},
	Spread = {
		Label = "Spread",
		Description = "Adds symmetric side projectiles to each cast while retaining the aimed center projectile.",
		Defaults = { Kind = "Spread", SidePairs = 1, SpreadAngle = 16, DamageFalloff = 0.7 },
		Fields = {
			{ Key = "SidePairs", Label = "Symmetric side pairs", Min = 1, Max = Limits.MaxSpreadPairs, Integer = true },
			{ Key = "SpreadAngle", Label = "Angle per side pair (degrees)", Min = 5, Max = Limits.MaxSpreadAngle },
			{ Key = "DamageFalloff", Label = "Payload strength per pair", Min = 0.1, Max = 1 },
		},
	},
	Propagate = {
		Label = "Propagate impact",
		Description = "Fans the impact payload out to several nearby valid targets at once. Unlike Chain, it does not hop or draw links.",
		Defaults = { Kind = "Propagate", Radius = 12, MaxTargets = 4, PayloadFalloff = 0.7 },
		Fields = {
			{ Key = "Radius", Label = "Propagation radius", Min = 2, Max = Limits.MaxRadius },
			{
				Key = "MaxTargets",
				Label = "Additional targets",
				Min = 1,
				Max = Limits.MaxPropagationTargets,
				Integer = true,
			},
			{ Key = "PayloadFalloff", Label = "Payload falloff per target", Min = 0.1, Max = 1 },
		},
	},
	Linger = {
		Label = "Linger after impact",
		Description = "Turns the impact point into a bounded pulsing hazard for a short duration.",
		Defaults = { Kind = "Linger", Duration = 4, Radius = 6, Interval = 0.5 },
		Fields = {
			{ Key = "Duration", Label = "Linger duration", Min = 0.2, Max = Limits.MaxDuration },
			{ Key = "Radius", Label = "Hazard radius", Min = 0.5, Max = Limits.MaxRadius },
			{ Key = "Interval", Label = "Pulse interval", Min = Limits.MinInterval, Max = 5 },
		},
	},
	Return = {
		Label = "Return to caster",
		Description = "Turns back toward the living caster after the configured outbound distance, then ends when caught or when its spell lifetime expires.",
		Defaults = { Kind = "Return", ReturnAtDistance = 35, CatchRadius = 2, TurnRate = 360 },
		Fields = {
			{ Key = "ReturnAtDistance", Label = "Turn back after distance", Min = 1, Max = Limits.MaxRange },
			{ Key = "CatchRadius", Label = "Catch distance", Min = 0.5, Max = Limits.MaxRadius },
			{
				Key = "TurnRate",
				Label = "Return turn rate (degrees / second)",
				Min = 30,
				Max = Limits.MaxHomingTurnRate,
			},
		},
	},
}

local Spec = {
	Definitions = Definitions,
	Order = {
		"Proximity",
		"Absorb",
		"Reflect",
		"Pulse",
		"Homing",
		"Pierce",
		"Chain",
		"Bounce",
		"Split",
		"Spread",
		"Propagate",
		"Linger",
		"Return",
	},
}

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Spec.get(kind: string)
	return Definitions[kind]
end

function Spec.copyDefaults(kind: string)
	local definition = Definitions[kind]
	if not definition then
		return nil
	end
	local result = {}
	for key, value in pairs(definition.Defaults) do
		result[key] = value
	end
	return result
end

function Spec.validate(behavior: any): (boolean, string?)
	if type(behavior) ~= "table" or type(behavior.Kind) ~= "string" then
		return false, "Invalid projectile behavior"
	end
	local definition = Definitions[behavior.Kind]
	if not definition then
		return false, "Unsupported projectile behavior: " .. behavior.Kind
	end
	local allowed = { Kind = true }
	for _, field in ipairs(definition.Fields) do
		allowed[field.Key] = true
		local value = behavior[field.Key]
		if not finite(value) or value < field.Min or value > field.Max or (field.Integer and value % 1 ~= 0) then
			return false, "Invalid " .. behavior.Kind .. " setting: " .. field.Key
		end
	end
	for key in pairs(behavior) do
		if not allowed[key] then
			return false, "Unknown " .. behavior.Kind .. " setting: " .. tostring(key)
		end
	end
	return true
end

return Spec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">SpellDefinitionValidator</string>
            <string name="Source"><![CDATA[--!strict

-- Shared structural gate for the subset Magic Runtime V1 actually executes.
-- It deliberately rejects future schema components until their handlers exist.
local Validator = {}
local PrincipleSpec = require(script.Parent.MagicPrincipleSpec)

local function positive(value)
	return typeof(value) == "number" and value == value and value > 0
end

local function payloadsValid(payloads)
	if typeof(payloads) ~= "table" or #payloads == 0 then
		return false
	end
	for _, payload in ipairs(payloads) do
		if payload.Kind == "Damage" then
			if not positive(payload.Amount) then
				return false
			end
		elseif payload.Kind == "Force" then
			if not positive(payload.Magnitude) or (payload.Upward ~= nil and typeof(payload.Upward) ~= "number") then
				return false
			end
		elseif payload.Kind == "Enhancement" then
			if
				typeof(payload.WalkSpeedBonus) ~= "number"
				and typeof(payload.JumpPowerBonus) ~= "number"
				and not positive(payload.SpeedMultiplier)
			then
				return false
			end
			if payload.SpeedMultiplier ~= nil and not positive(payload.SpeedMultiplier) then
				return false
			end
		elseif payload.Kind == "Manipulation" then
			if payload.Operation ~= "Raise" or not positive(payload.Distance) then
				return false
			end
		else
			return false
		end
	end
	return true
end

local function instantaneous(definition)
	return definition.Lifetime and definition.Lifetime.Mode == "Instantaneous"
end

local function castingValid(casting, form)
	if typeof(casting) ~= "table" or not positive(casting.Cooldown) then
		return false
	end
	if casting.StrainPerSecond ~= nil then
		return false
	end
	if casting.Mode == "Instant" then
		return casting.ManaUpkeepPerSecond == nil
	end
	if casting.Mode == "Charged" or casting.Mode == "HoldAndRelease" then
		return casting.ManaUpkeepPerSecond == nil
			and positive(casting.MinimumCharge)
			and positive(casting.MaximumCharge)
			and casting.MinimumCharge <= casting.MaximumCharge
	end
	if casting.Mode == "CommandCast" then
		return casting.ManaUpkeepPerSecond == nil
			and (form == "Projectile" or form == "Beam" or form == "Wave" or form == "Field" or form == "Aura")
	end
	if casting.Mode == "Sustained" then
		return form == "Construct" and positive(casting.ManaUpkeepPerSecond) and casting.ManaUpkeepPerSecond <= 100
	end
	return casting.Mode == "Channeled" and positive(casting.ManaUpkeepPerSecond) and casting.ManaUpkeepPerSecond <= 100
end

function Validator.validate(definition)
	if
		typeof(definition) ~= "table"
		or typeof(definition.SpellId) ~= "string"
		or typeof(definition.Name) ~= "string"
	then
		return false, "Missing identity"
	end
	if
		not definition.Source
		or not PrincipleSpec.expressionMatches(definition.Source.Principle, definition.Source.Expression)
	then
		return false, "Unsupported source"
	end
	local principle = PrincipleSpec.Definitions[definition.Source.Principle]
	if not principle.Forms[definition.Form] then
		return false, "UNSUPPORTED " .. definition.Source.Principle .. "/" .. tostring(definition.Form)
	end
	if
		not castingValid(definition.Casting, definition.Form)
		or typeof(definition.Cost) ~= "table"
		or not positive(definition.Cost.ManaDemand)
		or not positive(definition.Cost.Strain)
		or not positive(definition.Cost.Complexity)
	then
		return false, "Invalid casting or cost data"
	end
	if definition.Form == "Projectile" then
		if
			(definition.Targeting ~= "AimDirection" and definition.Targeting ~= "MaterialTarget")
			or definition.Geometry ~= "Sphere"
			or definition.Motion ~= "Linear"
			or not definition.Projectile
			or not positive(definition.Projectile.Speed)
			or not positive(definition.Projectile.Radius)
			or not definition.Visual
			or not definition.Lifetime
			or definition.Lifetime.Mode ~= "FixedDuration"
			or not positive(definition.Lifetime.Duration)
			or typeof(definition.Triggers) ~= "table"
			or typeof(definition.Triggers.OnImpact) ~= "table"
		then
			return false, "Unsupported projectile definition"
		end
		if definition.Targeting == "MaterialTarget" then
			if
				definition.Source.Principle ~= "Matter"
				or definition.Source.Expression ~= "Earth"
				or not definition.Material
				or definition.Material.Material ~= "Earth"
				or not positive(definition.Material.Amount)
				or not positive(definition.Material.SearchRadius)
			then
				return false, "Invalid material requirement"
			end
		end
		for _, trigger in ipairs(definition.Triggers.OnImpact) do
			if trigger.Payloads and not payloadsValid(trigger.Payloads) then
				return false, "Invalid impact payload"
			end
			if
				trigger.Behavior
				and (
					trigger.Behavior ~= "Explode"
					or not positive(trigger.Radius)
					or not payloadsValid(trigger.Payloads)
				)
			then
				return false, "Unsupported behavior"
			end
		end
		return true
	end
	if definition.Form == "Wave" then
		if
			(definition.Targeting ~= "Self" and definition.Targeting ~= "EntityTarget")
			or definition.Geometry ~= "Cone"
			or definition.Motion ~= "Stationary"
			or not definition.Wave
			or not positive(definition.Wave.Range)
			or typeof(definition.Wave.Dot) ~= "number"
			or definition.Wave.Dot < -1
			or definition.Wave.Dot > 1
			or (definition.Wave.Interval ~= nil and not positive(definition.Wave.Interval))
			or not payloadsValid(definition.Wave.Payloads)
			or not definition.Lifetime
			or (definition.Casting.Mode == "Channeled" and definition.Lifetime.Mode ~= "FixedDuration" or definition.Casting.Mode ~= "Channeled" and definition.Lifetime.Mode ~= "Instantaneous")
			or not definition.Triggers
			or not definition.Triggers.OnCast
			or (definition.Casting.Mode == "Channeled" and not payloadsValid(definition.Triggers.OnTick))
		then
			return false, "Unsupported wave definition"
		end
		return true
	end
	if definition.Form == "Beam" then
		if
			definition.Targeting ~= "AimDirection"
			or definition.Geometry ~= "Line"
			or definition.Motion ~= "Instantaneous"
			or (definition.Casting.Mode == "Channeled" and definition.Lifetime.Mode ~= "FixedDuration")
			or (definition.Casting.Mode ~= "Channeled" and not instantaneous(definition))
			or not definition.Beam
			or not positive(definition.Beam.Range)
			or not definition.Triggers
			or not payloadsValid(definition.Triggers.OnCast)
				and not (definition.Casting.Mode == "Channeled" and payloadsValid(definition.Triggers.OnTick))
		then
			return false, "Unsupported beam definition"
		end
		if (definition.Casting.Mode == "Channeled") ~= (definition.Lifetime.Mode == "FixedDuration") then
			return false, "Channeled Beams require a fixed maximum duration; instant Beams are instantaneous"
		end
		return true
	end
	if definition.Form == "Field" then
		if
			definition.Targeting ~= "WorldPoint"
			or definition.Geometry ~= "Sphere"
			or definition.Motion ~= "Stationary"
			or not definition.Field
			or not positive(definition.Field.Radius)
			or not positive(definition.Field.Interval)
			or not definition.Lifetime
			or definition.Lifetime.Mode ~= "FixedDuration"
			or not positive(definition.Lifetime.Duration)
			or not definition.Triggers
			or not payloadsValid(definition.Triggers.OnInterval)
		then
			return false, "Unsupported field definition"
		end
		return true
	end
	if definition.Form == "SelfEnhancement" then
		if
			definition.Targeting ~= "Self"
			or definition.Geometry ~= "Self"
			or definition.Motion ~= "Stationary"
			or not definition.Lifetime
			or not (definition.Lifetime.Mode == "UntilToggledOff" or (definition.Lifetime.Mode == "FixedDuration" and positive(
				definition.Lifetime.Duration
			)))
			or not definition.Triggers
			or not payloadsValid(definition.Triggers.OnCast)
		then
			return false, "Unsupported self enhancement definition"
		end
		return true
	end
	if definition.Form == "Manipulation" then
		if
			definition.Targeting ~= "MaterialTarget"
			or definition.Geometry ~= "Point"
			or definition.Motion ~= "Instantaneous"
			or not instantaneous(definition)
			or not definition.Material
			or definition.Material.Material ~= "Earth"
			or not positive(definition.Material.SearchRadius)
			or not definition.Triggers
			or not payloadsValid(definition.Triggers.OnCast)
		then
			return false, "Unsupported manipulation definition"
		end
		return true
	end
	return false, "Unsupported form"
end

return Validator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">SpellSpec</string>
            <string name="Source"><![CDATA[--!strict
-- Canonical runtime data. Legacy registered definitions are normalized, not mutated.
local Limits = require(script.Parent.Parent.Configuration.MagicLab)
local Schema = require(script.Parent.Parent.Configuration.MagicSchema)
local ProjectileBehaviorSpec = require(script.Parent.ProjectileBehaviorSpec)
local ProjectileMotion = require(script.Parent.MagicProjectileMotion)
local ConditionSpec = require(script.Parent.MagicConditionSpec)
local LifetimeSpec = require(script.Parent.MagicLifetimeSpec)
local ProximitySpec = require(script.Parent.MagicProximitySpec)
local CastingSpec = require(script.Parent.MagicCastingSpec)
local MaterialSpec = require(script.Parent.MagicMaterialSpec)
local AudioSpec = require(script.Parent.MagicAudioSpec)
local ConstructGeometrySpec = require(script.Parent.MagicConstructGeometrySpec)
local ConstructGrowthSpec = require(script.Parent.MagicConstructGrowthSpec)
local VisualSpec = require(script.Parent.MagicVisualSpec)
local AreaSpec = require(script.Parent.MagicAreaSpec)
local SummonLimits = require(script.Parent.Parent.Configuration.MagicSummons)
local LocusRequirementSpec = require(script.Parent.MagicLocusRequirementSpec)
local EnvironmentRequirementSpec = require(script.Parent.MagicEnvironmentRequirementSpec)
local SpecialResourceSpec = require(script.Parent.MagicSpecialResourceSpec)
local SpecialResources = require(script.Parent.Parent.Configuration.MagicLocus).SpecialResources
local SpellIdentitySpec = require(script.Parent.MagicSpellIdentitySpec)
local TriggerSpec = require(script.Parent.MagicTriggerSpec)
local Spec = {}
Spec.Principles = Schema.Principles
Spec.PresentationProfiles = Schema.PresentationProfiles
Spec.Elements = Schema.Elements
Spec.Forms = Schema.FormOrder
Spec.Events = {}
for form, definition in Schema.Forms do
	Spec.Events[form] = definition.Events
end
Spec.Schema = Schema
function Spec.copy(value)
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for k, v in pairs(value) do
		result[k] = Spec.copy(v)
	end
	return result
end
function Spec.normalize(source)
	local d = Spec.copy(source)
	d.Version = 3
	d.Geometry = d.Geometry or (Schema.Forms[d.Form] and Schema.Forms[d.Form].Geometry)
	d.Element = d.Element or Schema.defaultElementForExpression(d.Source.Expression)
	d.Visual = d.Visual or { Color = Color3.fromRGB(180, 230, 255) }
	d.Visual.ProjectileScale = d.Visual.ProjectileScale or 1
	if d.Construct then
		d.Construct.Components = d.Construct.Components or {}
	end
	d.Audio = d.Audio or Spec.copy(AudioSpec.Defaults)
	d.Cost = d.Cost or { ManaDemand = 0, Strain = 0, Complexity = 0 }
	d.Cost.SpecialResources = d.Cost.SpecialResources or {}
	d.Conditions = d.Conditions or {}
	d.LocusRequirements = d.LocusRequirements or {}
	d.EnvironmentRequirements = d.EnvironmentRequirements or {}
	d.TargetRules = d.TargetRules
		or {
			Range = (d.Beam and d.Beam.Range) or (d.Wave and d.Wave.Range) or 90,
			MaxTargets = 16,
			RequiresLineOfSight = true,
		}
	d.TargetRules.IncludeCaster = d.TargetRules.IncludeCaster or false
	d.TargetRules.Relationship = d.TargetRules.Relationship or "Any"
	d.TargetRules.RequiresConsent = d.TargetRules.RequiresConsent == true
	if d.Targeting == "EntityTarget" then
		d.TargetPolicy = d.TargetPolicy or "Aim"
	end
	d.Casting.CastTime = d.Casting.CastTime or 0
	d.Casting.RecoveryTime = d.Casting.RecoveryTime or 0
	d.Casting.InterruptOnDamage = d.Casting.InterruptOnDamage == true
	d.Casting.InterruptMoveDistance = d.Casting.InterruptMoveDistance or 0
	d.Casting.CanMoveWhileCasting = d.Casting.CanMoveWhileCasting ~= false
	d.Casting.MovementPenalty = d.Casting.MovementPenalty or 0
	d.Casting.CanRotateWhileCasting = d.Casting.CanRotateWhileCasting ~= false
	d.Casting.RequiresFreeHand = d.Casting.RequiresFreeHand == true
	if d.Projectile then
		d.Projectile.MaxDistance = d.Projectile.MaxDistance or d.Projectile.Speed * d.Lifetime.Duration
		d.Projectile.Gravity = d.Projectile.Gravity or 0
		d.Projectile.Acceleration = d.Projectile.Acceleration or 0
		d.Projectile.Behaviors = d.Projectile.Behaviors or {}
		d.Projectile.MotionPhases = d.Projectile.MotionPhases or {}
	end
	if d.Beam then
		d.Beam.Width = d.Beam.Width or 0
		d.Beam.Interval = d.Beam.Interval or 0.15
		d.Beam.Pattern = d.Beam.Pattern or "Single"
		d.Beam.StrikeCount = d.Beam.StrikeCount or 5
		d.Beam.SpreadRadius = d.Beam.SpreadRadius or 12
		d.Beam.DropHeight = d.Beam.DropHeight or 36
		d.Beam.StrikeInterval = d.Beam.StrikeInterval or 0.18
	end
	if d.Field then
		d.Field.Yaw = d.Field.Yaw or 0
	end
	if d.Aura then
		d.Aura.Yaw = d.Aura.Yaw or 0
	end
	local triggers = TriggerSpec.normalize(d.Triggers)
	if d.Wave then
		triggers.OnCast = triggers.OnCast or { { Payloads = d.Wave.Payloads } }
		d.Wave.Payloads = nil
	end
	d.Triggers = triggers
	return d
end
function Spec.createDraft(formName: string, principle: string)
	local form = Schema.Forms[formName]
	if not form or not Schema.supportsPrincipleForm(principle, formName) then
		return nil
	end
	local draft = {
		SpellId = "MagicLabDraft",
		Name = "Untitled Spell",
		Version = 3,
		Tags = {},
		Source = {
			Principle = principle,
			Expression = Schema.defaultExpression(principle),
		},
		Form = formName,
		Targeting = form.Draft.Targeting,
		Geometry = form.Geometry,
		Motion = form.Motion,
		Casting = {
			Mode = "Instant",
			Cooldown = 0.6,
			CastTime = 0,
			RecoveryTime = 0,
			InterruptOnDamage = false,
			InterruptMoveDistance = 0,
			CanMoveWhileCasting = true,
			MovementPenalty = 0,
			CanRotateWhileCasting = true,
			RequiresFreeHand = false,
		},
		Lifetime = Spec.copy(form.Draft.Lifetime),
		Cost = { ManaDemand = 0, Strain = 0, Complexity = 0, SpecialResources = {} },
		Visual = Spec.copy(VisualSpec.Defaults),
		Audio = Spec.copy(AudioSpec.Defaults),
		Element = "Neutral",
		Conditions = {},
		LocusRequirements = {},
		EnvironmentRequirements = {},
		TargetRules = {
			Range = 90,
			MaxTargets = 16,
			RequiresLineOfSight = true,
			IncludeCaster = false,
			Relationship = "Any",
			RequiresConsent = false,
		},
		Triggers = {},
	}
	local mechanics = Spec.copy(form.Draft.Mechanics)
	if next(mechanics) then
		draft[formName] = mechanics
	end
	if formName == "Projectile" then
		draft.Projectile.Behaviors = {}
		draft.Projectile.MotionPhases = {}
	end
	if ProximitySpec.SupportedForms[formName] then
		draft.Proximity = Spec.copy(ProximitySpec.Defaults)
	end
	if draft.Targeting == "MaterialTarget" or draft.Targeting == "ObjectTarget" then
		if draft.Targeting == "ObjectTarget" and formName == "Manipulation" then
			draft.Material = { SearchRadius = 12 }
		elseif
			draft.Targeting == "ObjectTarget" and (formName == "Projectile" or formName == "Beam" or formName == "Wave")
		then
			draft.Material = nil
		else
			draft.Material = Spec.copy(form.Draft.Material or { Material = "Earth", Amount = 1, SearchRadius = 12 })
			if formName ~= "Manipulation" then
				draft.Material.Amount = draft.Material.Amount or 1
			end
		end
	end
	return draft
end
local function finite(v)
	return type(v) == "number" and v == v and v > -math.huge and v < math.huge
end
local function bounded(v, lo, hi)
	return finite(v) and v >= lo and v <= hi
end
local function keys(t, allowed)
	if type(t) ~= "table" then
		return false
	end
	for k in pairs(t) do
		if not allowed[k] then
			return false
		end
	end
	return true
end
local function array(t, max)
	if type(t) ~= "table" then
		return false
	end
	local count = 0
	for k in pairs(t) do
		if type(k) ~= "number" or k % 1 ~= 0 or k < 1 or k > max then
			return false
		end
		count = count + 1
	end
	return count == #t and count <= max
end
local function safeTree(v, depth, budget)
	budget[1] = budget[1] + 1
	if budget[1] > 300 or depth > 8 then
		return false
	end
	if type(v) == "table" then
		for k, x in pairs(v) do
			if
				(type(k) ~= "string" and type(k) ~= "number")
				or (type(k) == "string" and #k > 64)
				or not safeTree(x, depth + 1, budget)
			then
				return false
			end
		end
	elseif type(v) == "number" then
		return finite(v)
	elseif type(v) == "string" then
		return #v <= 100
	elseif type(v) ~= "boolean" and typeof(v) ~= "Color3" then
		return false
	end
	return true
end

local function hasPayload(d, kind)
	if type(d.Triggers) ~= "table" then
		return false
	end
	for _, steps in pairs(d.Triggers) do
		if type(steps) == "table" then
			for _, step in ipairs(steps) do
				if type(step) == "table" and type(step.Payloads) == "table" then
					for _, payload in ipairs(step.Payloads) do
						if type(payload) == "table" and payload.Kind == kind then
							return true
						end
					end
				end
			end
		end
	end
	return false
end

local function hasOnlyObjectInteractionPayloads(d)
	if d.Form == "Projectile" and #(d.Projectile.Behaviors or {}) > 0 then
		return false
	end
	if type(d.Triggers) ~= "table" then
		return false
	end
	local count = 0
	local effectiveCount = 0
	for event, steps in pairs(d.Triggers) do
		local runtimeEvent = if event == "OnInterval" then "OnTick" else event
		if type(steps) ~= "table" then
			return false
		end
		for _, step in ipairs(steps) do
			if type(step) ~= "table" or step.Behavior ~= nil or type(step.Payloads) ~= "table" then
				return false
			end
			for _, payload in ipairs(step.Payloads) do
				if
					type(payload) ~= "table"
					or (payload.Kind ~= "Force" and payload.Kind ~= "Control" and payload.Kind ~= "Manipulation")
				then
					return false
				end
				count += 1
				if
					(d.Form == "Manipulation" and runtimeEvent == "OnCast")
					or (d.Form == "Projectile" and runtimeEvent == "OnImpact")
					or ((d.Form == "Beam" or d.Form == "Wave") and runtimeEvent == "OnCast")
					or (
						(d.Form == "Beam" or d.Form == "Wave")
						and d.Casting.Mode == "Channeled"
						and runtimeEvent == "OnTick"
					)
				then
					effectiveCount += 1
				end
			end
		end
	end
	return count > 0 and effectiveCount > 0
end

function Spec.validate(d)
	if not safeTree(d, 0, { 0 }) then
		return false, "Malformed or oversized SpellSpec"
	end
	if
		not keys(d, {
			SpellId = true,
			Name = true,
			Version = true,
			Tags = true,
			Source = true,
			Form = true,
			Targeting = true,
			TargetPolicy = true,
			Geometry = true,
			Motion = true,
			Casting = true,
			Lifetime = true,
			Cost = true,
			LocusRequirements = true,
			EnvironmentRequirements = true,
			Visual = true,
			Audio = true,
			Element = true,
			Triggers = true,
			Conditions = true,
			TargetRules = true,
			Projectile = true,
			Aura = true,
			Construct = true,
			Beam = true,
			Field = true,
			Wave = true,
			Material = true,
			Proximity = true,
		})
	then
		return false, "Unknown SpellSpec field"
	end
	if type(d.SpellId) ~= "string" or type(d.Name) ~= "string" then
		return false, "Missing spell identity"
	end
	if not keys(d.Source, { Principle = true, Expression = true }) then
		return false, "Invalid source"
	end
	if d.Version ~= 3 or type(d.Source.Expression) ~= "string" or not array(d.Tags, SpellIdentitySpec.MaxTags) then
		return false, "Invalid version, expression, or tags"
	end
	local validTags, tagReason = SpellIdentitySpec.validateTags(d.Tags)
	if not validTags then
		return false, tagReason
	end
	local elementKnown = false
	for _, element in ipairs(Spec.Elements) do
		if d.Element == element then
			elementKnown = true
		end
	end
	if not elementKnown then
		return false, "Unknown element"
	end
	local known = false
	for _, p in ipairs(Spec.Principles) do
		if d.Source.Principle == p then
			known = true
		end
	end
	if not known then
		return false, "Unknown Principle"
	end
	if not Schema.expressionMatches(d.Source.Principle, d.Source.Expression) then
		return false, "UNSUPPORTED expression for " .. d.Source.Principle
	end
	if not Spec.Events[d.Form] then
		return false, "UNSUPPORTED Form: " .. tostring(d.Form)
	end
	local principle = d.Source.Principle
	if not Schema.supportsPrincipleForm(principle, d.Form) then
		return false, "UNSUPPORTED Body/Form combination"
	end
	if d.Form == "SelfEnhancement" and (principle ~= "Body" or d.Targeting ~= "Self") then
		return false, "Body SelfEnhancement must target self"
	end
	if d.Form == "Manipulation" and d.Source.Expression ~= "Earth" then
		return false, "UNSUPPORTED Manipulation expression: Earth is required for current material interaction"
	end
	if
		d.Form == "Manipulation"
		and (principle ~= "Matter" or (d.Targeting ~= "MaterialTarget" and d.Targeting ~= "ObjectTarget"))
	then
		return false, "Manipulation requires Matter and a material or object target"
	end
	local formSchema = Schema.Forms[d.Form]
	local geometrySupported = d.Geometry == formSchema.Geometry
	for _, option in ipairs(formSchema.GeometryOptions or {}) do
		if option == d.Geometry then
			geometrySupported = true
			break
		end
	end
	if not geometrySupported or d.Motion ~= formSchema.Motion then
		return false, "Geometry or Motion does not match Form"
	end
	if not formSchema.Targeting[d.Targeting] then
		return false, "Unsupported targeting mode for Form"
	end
	if d.Targeting == "EntityTarget" then
		local policyKnown = false
		for _, policy in ipairs(Schema.TargetPolicyOrder) do
			if d.TargetPolicy == policy then
				policyKnown = true
				break
			end
		end
		if not policyKnown then
			return false, "Unsupported entity target policy"
		end
		if d.TargetPolicy == "MaintainTarget" then
			local hasHoming = false
			local behaviors = if d.Projectile and type(d.Projectile.Behaviors) == "table"
				then d.Projectile.Behaviors
				else {}
			for _, behavior in ipairs(behaviors) do
				if type(behavior) == "table" and behavior.Kind == "Homing" then
					hasHoming = true
					break
				end
			end
			if not hasHoming then
				return false, "Maintain target requires a homing Projectile"
			end
		end
	elseif d.TargetPolicy ~= nil then
		return false, "Target policy requires EntityTarget"
	end
	for _, f in ipairs({ "Projectile", "Beam", "Wave", "Field", "Aura", "Construct" }) do
		if d[f] and f ~= d.Form then
			return false, f .. " mechanics do not apply to " .. d.Form
		end
	end
	local c = d.Casting
	if
		not keys(c, {
			Mode = true,
			Cooldown = true,
			CastTime = true,
			RecoveryTime = true,
			MinimumCharge = true,
			MaximumCharge = true,
			ManaUpkeepPerSecond = true,
			StrainPerSecond = true,
			InterruptOnDamage = true,
			InterruptMoveDistance = true,
			CanMoveWhileCasting = true,
			MovementPenalty = true,
			CanRotateWhileCasting = true,
			RequiresFreeHand = true,
		})
		or not bounded(c.Cooldown, Limits.MinCooldown, 30)
		or not bounded(c.CastTime, 0, 3)
		or not bounded(c.RecoveryTime, 0, 3)
	then
		return false, "Invalid casting timing (cooldown minimum 0.15s)"
	end
	if
		(c.InterruptOnDamage ~= nil and type(c.InterruptOnDamage) ~= "boolean")
		or (c.InterruptMoveDistance ~= nil and not bounded(c.InterruptMoveDistance, 0, 20))
		or (c.CanMoveWhileCasting ~= nil and type(c.CanMoveWhileCasting) ~= "boolean")
		or (c.MovementPenalty ~= nil and not bounded(c.MovementPenalty, 0, Limits.MaxCastingMovementPenalty))
		or (c.CanRotateWhileCasting ~= nil and type(c.CanRotateWhileCasting) ~= "boolean")
		or (c.RequiresFreeHand ~= nil and type(c.RequiresFreeHand) ~= "boolean")
	then
		return false, "Invalid casting movement or interruption rules"
	end
	if
		c.Mode ~= "Instant"
		and c.Mode ~= "Charged"
		and c.Mode ~= "HoldAndRelease"
		and c.Mode ~= "Channeled"
		and c.Mode ~= "Toggle"
		and c.Mode ~= "CommandCast"
		and c.Mode ~= "Sustained"
	then
		return false, "Unsupported casting mode"
	end
	if c.Mode == "Toggle" and (not CastingSpec.supportsToggle(d.Form) or d.Lifetime.Mode ~= "UntilToggledOff") then
		return false, "Toggle casting requires a Form that supports UntilToggledOff lifetime"
	end
	if c.Mode == "CommandCast" and not CastingSpec.supportsCommandCast(d.Form) then
		return false, "CommandCast requires a Projectile, Beam, Wave, Field, or Aura assigned to a summon"
	end
	if c.Mode == "Sustained" and not CastingSpec.supportsSustained(d.Form) then
		return false, "Sustained casting requires a Construct that can be maintained while held"
	end
	if
		CastingSpec.isChargeMode(c.Mode)
		and (not bounded(c.MinimumCharge, 0.05, 3) or not bounded(c.MaximumCharge, c.MinimumCharge, 3))
	then
		return false, "Invalid charge time"
	end
	if not CastingSpec.isChargeMode(c.Mode) and (c.MinimumCharge ~= nil or c.MaximumCharge ~= nil) then
		return false, "Charge timing is only valid for Charged or HoldAndRelease casting"
	end
	if c.Mode == "Channeled" or c.Mode == "Sustained" then
		if
			(c.Mode == "Channeled" and not CastingSpec.supportsChannel(d.Form))
			or (c.Mode == "Sustained" and not CastingSpec.supportsSustained(d.Form))
			or not bounded(c.ManaUpkeepPerSecond, 0.01, Limits.MaxManaUpkeepPerSecond)
		then
			return false, "Held casting requires a supported Form and positive mana upkeep"
		end
	elseif c.ManaUpkeepPerSecond ~= nil and not bounded(c.ManaUpkeepPerSecond, 0, Limits.MaxManaUpkeepPerSecond) then
		return false, "Ongoing mana upkeep must be 0–100 per second"
	end
	if c.StrainPerSecond ~= nil and not bounded(c.StrainPerSecond, 0, Limits.MaxStrainPerSecond) then
		return false, "Ongoing strain must be 0–100 per second"
	end
	local life = d.Lifetime
	if not keys(life, { Mode = true, Duration = true, EndWhen = true }) then
		return false, "Invalid lifetime"
	end
	if not LifetimeSpec.supports(d.Form, life.Mode) then
		return false, "Unsupported lifetime mode for this Form"
	elseif
		not LifetimeSpec.supportsTargeting(
			d.Form,
			life.Mode,
			d.Targeting,
			d.Form == "Field" and type(d.Field) == "table" and d.Field.FollowTarget == true,
			d.TargetPolicy == "MaintainTarget"
		)
	then
		return false, "UntilTargetLost requires an entity or object target"
	elseif
		life.Mode == "UntilResourceDepleted" and not bounded(c.ManaUpkeepPerSecond, 0.01, Limits.MaxManaUpkeepPerSecond)
	then
		return false, "UntilResourceDepleted requires positive ongoing mana upkeep"
	elseif
		CastingSpec.isHeldMode(c.Mode)
		and life.Mode ~= "FixedDuration"
		and not (c.Mode == "Channeled" and life.Mode == "UntilConditionFails" and life.Duration ~= nil)
	then
		return false, "Held effects require a fixed maximum duration or a bounded keep-alive condition"
	elseif
		d.Form == "Beam"
		and life.Mode ~= (if c.Mode == "Channeled" then "FixedDuration" else "Instantaneous")
		and not (c.Mode == "Channeled" and life.Mode == "UntilConditionFails")
	then
		return false, "Instant Beams are instantaneous; Channeled Beams need a bounded active lifetime"
	elseif
		d.Form == "Wave"
		and life.Mode ~= (if c.Mode == "Channeled" then "FixedDuration" else "Instantaneous")
		and not (c.Mode == "Channeled" and life.Mode == "UntilConditionFails")
	then
		return false, "Instant Waves resolve once; Channeled Waves need a bounded active lifetime"
	elseif life.Mode == "FixedDuration" then
		if not bounded(life.Duration, 0.1, Limits.MaxDuration) then
			return false, "Duration exceeds development safety limit"
		end
	end
	if life.Mode == "Persistent" then
		if
			d.Form ~= "Construct"
			or c.Mode ~= "Instant"
			or life.Duration ~= nil
			or life.EndWhen ~= nil
			or (c.ManaUpkeepPerSecond or 0) > 0
			or (c.StrainPerSecond or 0) > 0
			or d.Proximity ~= nil
			or (d.Construct and d.Construct.GrowthDuration ~= nil and d.Construct.GrowthDuration > 0)
			or next(d.Triggers) ~= nil
		then
			return false,
				"Persistent Constructs must be static Instant placements without upkeep, active triggers, or timed end rules"
		end
	end
	if life.EndWhen ~= nil then
		if life.Mode == "Instantaneous" then
			return false, "Lifetime end conditions require an active Form lifetime"
		end
		local validEndWhen, endWhenReason =
			ConditionSpec.validateForFamilies(life.EndWhen, ConditionSpec.EndConditionFamilies)
		if not validEndWhen then
			return false, endWhenReason
		end
	end
	if life.Mode == "UntilConditionFails" and life.EndWhen == nil then
		return false, "UntilConditionFails requires a condition to remain true while the effect is active"
	end
	if
		life.Mode == "UntilConditionFails"
		and not LifetimeSpec.validConditionDuration(d.Form, life.Duration, Limits.MaxDuration)
	then
		return false, "Condition-bound effects need a valid optional maximum duration; Projectiles require one"
	end
	if life.Mode == "UntilConditionFails" and CastingSpec.isHeldMode(c.Mode) and life.Duration == nil then
		return false, "Condition-bound channels require a bounded maximum duration"
	end
	if life.Mode == "UntilConditionFails" and d.Form == "Projectile" then
		if not bounded(life.Duration, 0.1, Limits.MaxDuration) then
			return false, "Condition-bound Projectiles require a bounded maximum flight time"
		end
	end
	if life.Mode == "Instantaneous" and ((c.ManaUpkeepPerSecond or 0) > 0 or (c.StrainPerSecond or 0) > 0) then
		return false, "Ongoing resource upkeep requires an active lifetime"
	end
	local rules = d.TargetRules
	if
		not keys(rules, {
			Range = true,
			MaxTargets = true,
			RequiresLineOfSight = true,
			IncludeCaster = true,
			Relationship = true,
			RequiresConsent = true,
		})
		or not bounded(rules.Range, 1, Limits.MaxRange)
		or not bounded(rules.MaxTargets, 1, Limits.MaxTargets)
		or rules.MaxTargets % 1 ~= 0
		or type(rules.RequiresLineOfSight) ~= "boolean"
		or type(rules.IncludeCaster) ~= "boolean"
		or type(rules.RequiresConsent) ~= "boolean"
		or not table.find(Schema.TargetRelationshipOrder, rules.Relationship)
	then
		return false, "Invalid targeting limits"
	end
	if
		d.Form == "Wave"
		and d.Wave.GrowthStartScale ~= nil
		and d.Wave.Range * math.max(d.Wave.GrowthStartScale, d.Wave.GrowthEndScale) > rules.Range
	then
		return false, "Expanded Wave reach cannot exceed its targeting maximum range"
	end
	if
		d.Form == "Beam"
		and d.Beam.GrowthStartScale ~= nil
		and d.Beam.Range * math.max(d.Beam.GrowthStartScale, d.Beam.GrowthEndScale) > rules.Range
	then
		return false, "Expanded Beam reach cannot exceed its targeting maximum range"
	end
	local conditionsValid, conditionsReason = ConditionSpec.validate(d.Conditions)
	if not conditionsValid then
		return false, conditionsReason
	end
	if d.Conditions.Operator == nil then
		for _, condition in ipairs(d.Conditions) do
			local definition
			for _, candidate in Schema.Conditions do
				if candidate.Id == condition then
					definition = candidate
					break
				end
			end
			if not definition and condition ~= "TargetIsHumanoid" then
				return false, "UNSUPPORTED condition: " .. tostring(condition)
			end
			if definition and not definition.Forms[d.Form] then
				return false, "Condition is not supported for this Form: " .. tostring(condition)
			end
			if condition == "TargetIsSelf" and d.Form ~= "SelfEnhancement" then
				return false, "TargetIsSelf requires SelfEnhancement"
			end
		end
	end
	if d.Form == "Aura" then
		local validArea, areaReason =
			AreaSpec.validate("Aura", d.Geometry, d.Aura, Limits.MaxRadius, Limits.MinInterval)
		if not validArea then
			return false, areaReason
		end
	elseif d.Form == "Construct" then
		if
			not keys(d.Construct, {
				Width = true,
				Height = true,
				Depth = true,
				Distance = true,
				GrowthStartScale = true,
				GrowthEndScale = true,
				GrowthDuration = true,
				Components = true,
			})
		then
			return false, "Invalid Construct"
		end
		for _, axis in ipairs({ "Width", "Height", "Depth" }) do
			if not bounded(d.Construct[axis], 0.5, 20) then
				return false, "Construct dimensions must be 0.5–20 studs"
			end
		end
		if not bounded(d.Construct.Distance, 4, 40) then
			return false, "Construct distance must be 4–40 studs"
		end
		if d.Construct.Width * d.Construct.Height * d.Construct.Depth > 2000 then
			return false, "Construct volume exceeds 2000 cubic studs"
		end
		local validConstructGrowth, growthReason = ConstructGrowthSpec.validate(d.Construct)
		if not validConstructGrowth then
			return false, growthReason
		end
		if d.Geometry ~= "Custom" and d.Construct.Components and next(d.Construct.Components) then
			return false, "Custom component data requires Custom Construct geometry"
		end
		local components = ConstructGeometrySpec.components(
			d.Geometry,
			d.Construct.Width,
			d.Construct.Height,
			d.Construct.Depth,
			d.Construct.Components
		)
		if not components or #components > 5 then
			return false, "Construct geometry is missing or exceeds the component limit"
		end
		if life.Mode == "Persistent" then
			for _, component in ipairs(components) do
				if component.Duration ~= nil then
					return false, "Persistent Constructs cannot contain expiring components"
				end
			end
		end
	elseif d.Form == "Projectile" then
		local p = d.Projectile
		if
			not keys(p, {
				Speed = true,
				Radius = true,
				MaxDistance = true,
				Gravity = true,
				Acceleration = true,
				ChannelInterval = true,
				Behaviors = true,
				MotionPhases = true,
			})
			or not bounded(p.Speed, 1, Limits.MaxSpeed)
			or not bounded(p.Radius, 0.1, Limits.MaxRadius)
			or not bounded(p.MaxDistance, 1, Limits.MaxRange)
			or not bounded(p.Gravity, 0, Limits.MaxGravity)
			or not bounded(p.Acceleration, -Limits.MaxAcceleration, Limits.MaxAcceleration)
			or (p.ChannelInterval ~= nil and not bounded(p.ChannelInterval, Limits.MinInterval, 1))
		then
			return false, "Invalid projectile speed/radius/distance/gravity/acceleration safety limit"
		end
		if not array(p.Behaviors, Limits.MaxProjectileBehaviors) then
			return false, "Projectile supports at most three composed behaviors"
		end
		local validMotion, motionReason = ProjectileMotion.validate(p.MotionPhases or {}, d.Lifetime.Duration, p.Radius)
		if not validMotion then
			return false, motionReason
		end
		local behaviorKinds = {}
		for _, behavior in ipairs(p.Behaviors) do
			if type(behavior) ~= "table" or type(behavior.Kind) ~= "string" or behaviorKinds[behavior.Kind] then
				return false, "Invalid or duplicate projectile behavior"
			end
			behaviorKinds[behavior.Kind] = true
			local validBehavior, behaviorReason = ProjectileBehaviorSpec.validate(behavior)
			if not validBehavior then
				return false, behaviorReason
			end
			if behavior.Kind == "Return" and behavior.ReturnAtDistance > p.MaxDistance then
				return false, "Return distance cannot exceed projectile maximum distance"
			end
		end
		for _, phase in ipairs(p.MotionPhases or {}) do
			if phase.Mode == "Attached" and not behaviorKinds.Linger then
				return false, "Attached motion requires the Linger projectile behavior"
			end
		end
		if behaviorKinds.Linger and (behaviorKinds.Bounce or behaviorKinds.Pierce or behaviorKinds.Split) then
			return false, "Linger cannot combine with Bounce, Pierce, or Split impact behavior"
		end
		if behaviorKinds.Return and (behaviorKinds.Homing or behaviorKinds.Linger or behaviorKinds.Split) then
			return false, "Return cannot combine with Homing, Linger, or Split"
		end
	elseif d.Form == "Beam" then
		local beamPattern = d.Beam.Pattern or "Single"
		local strikeCount = d.Beam.StrikeCount or 5
		local spreadRadius = d.Beam.SpreadRadius or 12
		local dropHeight = d.Beam.DropHeight or 36
		local strikeInterval = d.Beam.StrikeInterval or 0.18
		if
			not keys(d.Beam, {
				Range = true,
				Width = true,
				DebugDuration = true,
				Interval = true,
				Pattern = true,
				StrikeCount = true,
				SpreadRadius = true,
				DropHeight = true,
				StrikeInterval = true,
				GrowthStartScale = true,
				GrowthEndScale = true,
				GrowthDuration = true,
			})
			or not bounded(d.Beam.Range, 1, Limits.MaxRange)
			or not bounded(d.Beam.Width, 0, 10)
			or not bounded(d.Beam.DebugDuration, 0.05, 1)
			or (d.Beam.Interval ~= nil and not bounded(d.Beam.Interval, 0.05, 1))
			or (d.Beam.Pattern ~= nil and beamPattern ~= "Single" and beamPattern ~= "Cascade")
			or (d.Beam.StrikeCount ~= nil and (not bounded(strikeCount, 2, 8) or strikeCount % 1 ~= 0))
			or (d.Beam.SpreadRadius ~= nil and not bounded(spreadRadius, 0, 30))
			or (d.Beam.DropHeight ~= nil and not bounded(dropHeight, 5, 80))
			or (d.Beam.StrikeInterval ~= nil and not bounded(strikeInterval, 0.1, 1))
		then
			return false, "Invalid beam range/width"
		end
		if beamPattern == "Cascade" then
			if c.Mode ~= "Instant" then
				return false, "Beam Cascade requires an Instant cast"
			end
			if d.Targeting ~= "AimDirection" and d.Targeting ~= "EntityTarget" then
				return false, "Beam Cascade requires aim-direction or aimed-entity targeting"
			end
			if dropHeight + 8 > math.min(d.Beam.Range, d.TargetRules.Range) then
				return false, "Beam range must reach from the Cascade drop height to its impact surface"
			end
		end
		local hasGrowth = (d.Beam.GrowthStartScale ~= nil and d.Beam.GrowthStartScale ~= 0)
			or (d.Beam.GrowthEndScale ~= nil and d.Beam.GrowthEndScale ~= 0)
			or (d.Beam.GrowthDuration ~= nil and d.Beam.GrowthDuration ~= 0)
		if hasGrowth then
			if
				c.Mode ~= "Channeled"
				or not bounded(d.Beam.GrowthStartScale, 0.1, 2)
				or not bounded(d.Beam.GrowthEndScale, 0.1, 2)
				or not bounded(d.Beam.GrowthDuration, 0.1, 30)
			then
				return false, "Beam expansion requires a Channeled Beam and bounded start/end/time values"
			end
			local maximumScale = math.max(d.Beam.GrowthStartScale, d.Beam.GrowthEndScale)
			if d.Beam.Range * maximumScale > Limits.MaxRange or d.Beam.Width * maximumScale > 10 then
				return false, "Expanded Beam dimensions exceed the configured range or width"
			end
		end
	elseif d.Form == "Field" then
		local validArea, areaReason =
			AreaSpec.validate("Field", d.Geometry, d.Field, Limits.MaxRadius, Limits.MinInterval)
		if not validArea then
			return false, areaReason
		end
		if d.Field.FollowTarget == true and d.Targeting ~= "EntityTarget" and d.Targeting ~= "ObjectTarget" then
			return false, "Following Fields require an entity or object target"
		end
	elseif d.Form == "Wave" then
		if
			not keys(d.Wave, {
				Range = true,
				Dot = true,
				Interval = true,
				DebugDuration = true,
				GrowthStartScale = true,
				GrowthEndScale = true,
				GrowthDuration = true,
			})
			or not bounded(d.Wave.Range, 1, Limits.MaxRadius)
			or not bounded(d.Wave.Dot, -1, 1)
			or (d.Wave.Interval ~= nil and not bounded(d.Wave.Interval, Limits.MinInterval, 1))
			or not bounded(d.Wave.DebugDuration, 0.05, 1)
		then
			return false, "Invalid wave range/angle"
		end
		local hasGrowth = (d.Wave.GrowthStartScale ~= nil and d.Wave.GrowthStartScale ~= 0)
			or (d.Wave.GrowthEndScale ~= nil and d.Wave.GrowthEndScale ~= 0)
			or (d.Wave.GrowthDuration ~= nil and d.Wave.GrowthDuration ~= 0)
		if hasGrowth then
			if
				c.Mode ~= "Channeled"
				or not bounded(d.Wave.GrowthStartScale, 0.1, 2)
				or not bounded(d.Wave.GrowthEndScale, 0.1, 2)
				or not bounded(d.Wave.GrowthDuration, 0.1, 30)
			then
				return false, "Wave expansion requires a Channeled Wave and bounded start/end/time values"
			end
			if d.Wave.Range * math.max(d.Wave.GrowthStartScale, d.Wave.GrowthEndScale) > Limits.MaxRadius then
				return false, "Expanded Wave reach exceeds the configured maximum radius"
			end
		end
	end
	if
		hasPayload(d, "Manipulation")
		and (d.Form == "Projectile" or d.Form == "Beam" or d.Form == "Wave")
		and d.Targeting ~= "ObjectTarget"
	then
		return false, "Projectile, Beam, and Wave material Manipulation requires ObjectTarget"
	end
	if d.Targeting == "ObjectTarget" and (d.Form == "Construct" or d.Form == "Field" or d.Form == "Aura") then
		if d.Material ~= nil then
			return false, "This object-targeted Form does not use a material requirement"
		end
	elseif d.Targeting == "ObjectTarget" and (d.Form == "Projectile" or d.Form == "Beam" or d.Form == "Wave") then
		if not hasOnlyObjectInteractionPayloads(d) then
			return false,
				"Object-targeted Projectiles, Beams, and Waves require Force, Control, or authorized Manipulation on a resolving event"
		end
		if hasPayload(d, "Manipulation") then
			if
				not keys(d.Material, { Material = true, SearchRadius = true })
				or not MaterialSpec.supports(
					d.Source.Principle,
					d.Source.Expression,
					d.Form,
					d.Targeting,
					d.Material.Material
				)
				or not bounded(d.Material.SearchRadius, 1, 30)
			then
				return false, "Material Manipulation requires a matching tagged source and bounded object reach"
			end
		elseif d.Material ~= nil then
			if not keys(d.Material, { SearchRadius = true }) or not bounded(d.Material.SearchRadius, 1, 30) then
				return false, "Invalid object-target reach"
			end
		end
	elseif
		d.Targeting == "ObjectTarget"
		and d.Form == "Manipulation"
		and not hasPayload(d, "Manipulation")
		and hasOnlyObjectInteractionPayloads(d)
	then
		if d.Material ~= nil then
			if
				not keys(d.Material, { Material = true, SearchRadius = true })
				or (d.Material.Material ~= nil and not MaterialSpec.supports(
					d.Source.Principle,
					d.Source.Expression,
					d.Form,
					d.Targeting,
					d.Material.Material
				))
				or not bounded(d.Material.SearchRadius, 1, 30)
			then
				return false, "Invalid optional object-target settings"
			end
		end
	elseif d.Targeting == "MaterialTarget" or d.Targeting == "ObjectTarget" then
		if
			not keys(d.Material, { Material = true, Amount = true, SearchRadius = true })
			or not MaterialSpec.supports(
				d.Source.Principle,
				d.Source.Expression,
				d.Form,
				d.Targeting,
				d.Material.Material
			)
			or not bounded(d.Material.SearchRadius, 1, 30)
			or (d.Form ~= "Manipulation" and not bounded(d.Material.Amount, 0.1, 10))
			or (d.Form == "Manipulation" and d.Material.Amount ~= nil)
		then
			return false, "Invalid or unsupported material source requirement"
		end
	elseif d.Material then
		return false, "Material data requires a material or object target"
	end
	local validVisual, visualReason = VisualSpec.validate(d.Visual)
	if not validVisual then
		return false, visualReason
	end
	if d.Audio ~= nil then
		local validAudio, audioReason = AudioSpec.validate(d.Audio)
		if not validAudio then
			return false, audioReason
		end
	end
	if d.Visual.Profile then
		local supported = false
		for _, profile in ipairs(Spec.PresentationProfiles) do
			if profile == d.Visual.Profile then
				supported = true
			end
		end
		if not supported then
			return false, "Unsupported presentation profile"
		end
	end
	for _, color in ipairs({ d.Visual.Color, d.Visual.SecondaryColor, d.Visual.AccentColor }) do
		if color and (not bounded(color.R, 0, 1) or not bounded(color.G, 0, 1) or not bounded(color.B, 0, 1)) then
			return false, "Invalid presentation color"
		end
	end
	if not keys(d.Cost, { ManaDemand = true, Strain = true, Complexity = true, SpecialResources = true }) then
		return false, "Invalid cost data"
	end
	for key, v in pairs(d.Cost) do
		if key == "SpecialResources" then
			continue
		end
		if not bounded(v, 0, 100000) then
			return false, "Invalid cost value"
		end
	end
	local specialCostsValid, specialCostsReason = SpecialResourceSpec.validateCosts(
		d.Cost.SpecialResources,
		SpecialResources,
		Limits.MaxSpecialResourceCostTypes,
		Limits.MaxSpecialResourceCost
	)
	if not specialCostsValid then
		return false, specialCostsReason
	end
	local locusRequirementsValid, locusRequirementsReason = LocusRequirementSpec.validate(d.LocusRequirements)
	if not locusRequirementsValid then
		return false, locusRequirementsReason
	end
	local environmentRequirementsValid, environmentRequirementsReason =
		EnvironmentRequirementSpec.validate(d.EnvironmentRequirements)
	if not environmentRequirementsValid then
		return false, environmentRequirementsReason
	end
	if type(d.Triggers) ~= "table" then
		return false, "Invalid triggers"
	end
	local hasShieldSource = false
	local hasSummonSource = false
	local hasProjectileLinger = false
	local hasProjectilePulse = false
	local hasProjectileProximity = false
	if d.Proximity ~= nil then
		if
			d.Form == "Projectile"
			or not ProximitySpec.SupportedForms[d.Form]
			or not keys(d.Proximity, { Radius = true, Interval = true, MaxTargets = true })
			or not ProximitySpec.validate(d.Proximity, Limits.MaxRadius, Limits.MinInterval, Limits.MaxTargets)
		then
			return false, "Invalid active Form proximity settings"
		end
	end
	if d.Form == "Projectile" then
		for _, behavior in ipairs(d.Projectile.Behaviors) do
			if behavior.Kind == "Linger" then
				hasProjectileLinger = true
			elseif behavior.Kind == "Pulse" then
				hasProjectilePulse = true
			elseif behavior.Kind == "Proximity" then
				hasProjectileProximity = true
			end
		end
	end
	for event, steps in pairs(d.Triggers) do
		if event ~= "OnBreak" and type(steps) == "table" then
			for _, step in pairs(steps) do
				if type(step) == "table" and type(step.Payloads) == "table" then
					for _, payload in pairs(step.Payloads) do
						if type(payload) == "table" and payload.Kind == "Shield" then
							hasShieldSource = true
						end
						if event ~= "OnCommand" and type(payload) == "table" and payload.Kind == "Summon" then
							hasSummonSource = true
						end
					end
				end
			end
		end
	end
	local total = 0
	local single = {}
	for event, steps in pairs(d.Triggers) do
		if not Schema.supportsEvent(d.Form, event, d.Casting.Mode) or not array(steps, Limits.MaxSteps) then
			return false, "UNSUPPORTED trigger: " .. tostring(event)
		end
		if event == "OnTick" and d.Form == "Projectile" and not hasProjectileLinger and not hasProjectilePulse then
			return false, "Projectile OnTick requires Pulse while traveling or Linger after impact"
		end
		if event == "OnProximity" and d.Form == "Projectile" and not hasProjectileProximity then
			return false, "Projectile OnProximity requires the Proximity behavior"
		end
		if event == "OnProximity" and d.Form ~= "Projectile" and not d.Proximity then
			return false, "Active Form OnProximity requires valid proximity settings"
		end
		if event == "OnCommand" and not hasSummonSource then
			return false, "OnCommand requires a Summon payload on another trigger"
		end
		if event == "OnBreak" and not hasShieldSource then
			return false, "OnBreak requires a Shield payload on another trigger"
		end
		local usedThresholds = {}
		for _, step in ipairs(steps) do
			if type(step) ~= "table" then
				return false, "Invalid trigger step"
			end
			local behavior = if step.Behavior then Schema.Behaviors[step.Behavior] else nil
			local stepFields = { Payloads = true }
			if event == "OnThreshold" then
				stepFields.HealthPercent = true
				if
					not bounded(step.HealthPercent, 1, 99)
					or step.HealthPercent % 1 ~= 0
					or usedThresholds[step.HealthPercent]
				then
					return false, "Threshold steps need a unique integer health percentage from 1 to 99"
				end
				usedThresholds[step.HealthPercent] = true
			end
			if event == "OnCommand" then
				stepFields.Command = true
				if step.Command ~= nil and not table.find(Schema.CommandOrder, step.Command) then
					return false, "OnCommand has an unsupported command filter"
				end
			end
			if event == "OnTargetDeath" then
				stepFields.DeathMode = true
				if step.DeathMode ~= nil and not table.find(Schema.TargetDeathModes, step.DeathMode) then
					return false, "OnTargetDeath has an unsupported death-cause filter"
				end
			end
			if behavior then
				stepFields.Behavior = true
				for _, field in behavior.Fields or {} do
					stepFields[field.Key] = true
				end
			elseif step.Behavior then
				return false, "Unsupported behavior: " .. tostring(step.Behavior)
			end
			if
				not keys(step, stepFields)
				or not array(step.Payloads, Limits.MaxPayloads)
				or #step.Payloads < (if behavior then behavior.MinimumPayloads or 0 else 1)
			then
				return false, "Invalid trigger step"
			end
			if behavior then
				if not Schema.supportsBehavior(step.Behavior, d.Form, event) then
					return false, "Behavior is not supported for this Form and trigger"
				end
				for _, field in behavior.Fields or {} do
					local value = step[field.Key]
					if value == nil then
						if field.Required then
							return false, "Missing behavior setting: " .. field.Label
						end
					elseif field.Options then
						if not table.find(field.Options, value) then
							return false, "Invalid behavior setting: " .. field.Label
						end
					elseif not bounded(value, field.Min, field.Max) then
						return false, "Behavior setting is outside its safety limit: " .. field.Label
					end
				end
			end
			for _, p in ipairs(step.Payloads) do
				if type(p) ~= "table" or type(p.Kind) ~= "string" then
					return false, "Invalid payload"
				end
				total = total + 1
				local definition = Schema.Payloads[p.Kind]
				if not definition then
					return false, "Unsupported payload: " .. tostring(p.Kind)
				end
				if behavior and not table.find(behavior.PayloadKinds or {}, p.Kind) then
					return false, "Payload is not supported by this behavior"
				end
				local allowedFields = { Kind = true }
				for _, field in definition.Fields do
					allowedFields[field.Key] = true
				end
				if not keys(p, allowedFields) then
					return false, "Unsupported payload fields"
				end
				local payloadEventSupported = Schema.supportsPayload(p.Kind, d.Form, event, d.Source.Principle)
				local behaviorPayloadSupported = behavior ~= nil
					and definition.Forms[d.Form] == true
					and (definition.Principle == nil or definition.Principle == d.Source.Principle)
				if not payloadEventSupported and not behaviorPayloadSupported then
					return false, "Payload is not supported for this Form and trigger"
				end
				for _, field in definition.Fields do
					local value = p[field.Key]
					if value == nil then
						if field.Required then
							return false, "Missing payload setting: " .. field.Label
						end
					elseif field.Options or field.OptionsByPrinciple then
						local options = field.Options
						if field.OptionsByPrinciple then
							options = field.OptionsByPrinciple[d.Source.Principle] or options
						end
						if not table.find(options, value) then
							return false, "Invalid payload setting: " .. field.Label
						end
					elseif not bounded(value, field.Min, field.Max) or (field.Integer and value % 1 ~= 0) then
						return false, "Payload setting is outside its safety limit: " .. field.Label
					end
				end
				if (p.Kind == "ElementalMark" or p.Kind == "ConsumeElementalMark") and d.Element == "Neutral" then
					return false, "Elemental marks require a non-neutral selected Element"
				end
				if p.Kind == "Summon" then
					local lifetimeMode = p.LifetimeMode or "FixedDuration"
					if not table.find(SummonLimits.LifetimeModes, lifetimeMode) then
						return false, "Invalid payload setting: Summon lifetime"
					end
					if
						lifetimeMode == "FixedDuration"
						and not bounded(p.Duration, SummonLimits.MinDuration, SummonLimits.MaxDuration)
					then
						return false, "Fixed-duration summons need a valid duration"
					elseif lifetimeMode == "UntilCommanded" and p.Duration ~= nil then
						return false, "Until-commanded summons cannot include a duration"
					end
					local respawnPolicy = p.RespawnPolicy or "DismissOnDeath"
					if not table.find(SummonLimits.RespawnPolicies, respawnPolicy) then
						return false, "Invalid payload setting: Summon owner death behavior"
					end
					if respawnPolicy == "PersistUntilDismissed" and lifetimeMode ~= "UntilCommanded" then
						return false, "Only Until-commanded summons can persist across owner respawn"
					end
				end
				if
					p.Kind == "Enhancement"
					or p.Kind == "Manipulation"
					or p.Kind == "ModifyAttribute"
					or p.Kind == "Transformation"
				then
					if single[p.Kind] then
						return false, "Only one movement/material/attribute modifier is supported per spell"
					end
					single[p.Kind] = true
				end
				if
					p.Kind == "Enhancement"
					and p.SpeedMultiplier == nil
					and p.WalkSpeedBonus == nil
					and p.JumpPowerBonus == nil
				then
					return false, "Empty enhancement"
				end
				if p.Kind == "DamageOverTime" or p.Kind == "Restoration" then
					if p.Interval > p.Duration or p.Amount * math.floor(p.Duration / p.Interval) > 500 then
						return false,
							"Invalid periodic payload: interval must fit duration and total base amount must not exceed 500"
					end
				end
				if p.Kind == "TimeDilation" and math.abs(p.Rate - 1) < 0.001 then
					return false, "Time dilation must differ from the normal rate"
				end
				if p.DamageChannel == "Soul" and d.Source.Principle ~= "Soul" then
					return false, "Soul damage requires the Soul Principle"
				end
				if p.DamageChannel == "Physical" and d.Source.Principle ~= "Body" then
					return false, "Physical damage requires the Body Principle"
				end
			end
		end
	end
	if (total == 0 and d.Form ~= "Construct") or total > 8 then
		return false, "Specify 1–8 payloads across triggers"
	end
	return true
end
function Spec.estimate(d)
	local waveScale = if d.Wave then math.max(d.Wave.GrowthStartScale or 1, d.Wave.GrowthEndScale or 1) else 1
	local beamScale = if d.Beam then math.max(d.Beam.GrowthStartScale or 1, d.Beam.GrowthEndScale or 1) else 1
	local radius = (d.Projectile and d.Projectile.Radius)
		or (d.Aura and d.Aura.Radius)
		or (d.Field and d.Field.Radius)
		or (d.Wave and d.Wave.Range * waveScale)
		or 0
	if d.Beam and d.Beam.Pattern == "Cascade" then
		radius = math.max(radius, d.Beam.SpreadRadius or 12)
	end
	local range = (d.Projectile and d.Projectile.MaxDistance)
		or (d.Beam and d.Beam.Range * beamScale)
		or d.TargetRules.Range
	local speed = d.Projectile and d.Projectile.Speed or 0
	local duration = d.Lifetime.Duration or (d.Lifetime.Mode ~= "FixedDuration" and 15 or 1)
	local strength, count, behaviors, constructComponents, additionalBehaviorTargets = 0, 0, 0, 0, 0
	local environmentRequirementCount = 0
	local environmentRequirements = d.EnvironmentRequirements or {}
	if environmentRequirements.RequireGrounded then
		environmentRequirementCount += 1
	end
	if environmentRequirements.ClockTime then
		environmentRequirementCount += 1
	end
	if environmentRequirements.ZoneTags then
		for _, tag in ipairs(environmentRequirements.ZoneTags.Required or {}) do
			if tag then
				environmentRequirementCount += 1
			end
		end
		for _, tag in ipairs(environmentRequirements.ZoneTags.Forbidden or {}) do
			if tag then
				environmentRequirementCount += 1
			end
		end
	end
	if d.Construct then
		local constructScale = math.max(d.Construct.GrowthStartScale or 1, d.Construct.GrowthEndScale or 1)
		strength = d.Construct.Width * d.Construct.Height * d.Construct.Depth * constructScale ^ 3 * 0.1
		local components = ConstructGeometrySpec.components(
			d.Geometry,
			d.Construct.Width,
			d.Construct.Height,
			d.Construct.Depth,
			d.Construct.Components
		)
		constructComponents = components and #components or 0
		strength += math.max(0, constructComponents - 1) * 3
	end
	for _, steps in pairs(d.Triggers) do
		for _, step in ipairs(steps) do
			if step.Behavior then
				behaviors = behaviors + 1
				radius = math.max(radius, step.Radius or 0)
			end
			for _, p in ipairs(step.Payloads) do
				count = count + 1
				strength = strength
					+ math.abs(p.Amount or 0) * ((p.Kind == "DamageOverTime" or p.Kind == "Restoration") and math.floor(
						p.Duration / p.Interval
					) or 1)
					+ (p.Magnitude or 0) * 0.5
					+ math.abs((p.SpeedMultiplier or 1) - 1) * 15
					+ (p.Distance or 0) * 2
			end
		end
	end
	for _, behavior in ipairs(d.Projectile and d.Projectile.Behaviors or {}) do
		behaviors += 1
		if behavior.Kind == "Chain" then
			radius = math.max(radius, behavior.Radius)
			additionalBehaviorTargets += behavior.MaxJumps
		elseif behavior.Kind == "Propagate" then
			radius = math.max(radius, behavior.Radius)
			additionalBehaviorTargets += behavior.MaxTargets
		end
	end
	local motionPhaseCount = #(d.Projectile and d.Projectile.MotionPhases or {})
	local curvedPhaseCount = 0
	for _, phase in ipairs(d.Projectile and d.Projectile.MotionPhases or {}) do
		if phase.Mode == "Bezier" then
			curvedPhaseCount += 1
		end
	end
	local area = d.Field or d.Aura
	local ticks = area and duration / area.Interval or 1
	local beamExtraStrikes = if d.Beam and d.Beam.Pattern == "Cascade"
		then math.max(0, (d.Beam.StrikeCount or 5) - 1)
		else 0
	local cost = math.ceil(
		2
			+ radius * 0.8
			+ range * 0.03
			+ speed * 0.02
			+ duration * 0.3
			+ strength * 0.2 * math.sqrt(ticks)
			+ count * 2
			+ behaviors * 4
			+ additionalBehaviorTargets * 0.5
			+ environmentRequirementCount * 2
			+ motionPhaseCount * 2
			+ curvedPhaseCount * 2
			+ beamExtraStrikes * 2.5
			+ d.TargetRules.MaxTargets * 0.2
	)
	return {
		ManaDemand = cost,
		Strain = math.ceil(cost * 0.4),
		Complexity = math.ceil(
			1
				+ count
				+ behaviors
				+ motionPhaseCount
				+ curvedPhaseCount
				+ math.ceil(beamExtraStrikes / 2)
				+ environmentRequirementCount
				+ math.ceil(additionalBehaviorTargets / 2)
				+ math.sqrt(radius) / 3
				+ math.max(0, constructComponents - 1)
		),
		ManaUpkeepPerSecond = d.Casting.ManaUpkeepPerSecond or 0,
		StrainPerSecond = d.Casting.StrainPerSecond or 0,
	}
end
return Spec
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="91">
