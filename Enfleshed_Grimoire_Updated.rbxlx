	ContributionDamage = 5,
	EscortSeconds = 20,
	EscortDistance = 40,
	Definitions = {
		LocalAttack = {
			Name = "Civilians under attack",
			Categories = { "Housing", "Workshop", "Checkpoint" },
			Weight = 4,
			CountRange = { 1, 1 },
			Reward = 20,
			Duration = 180,
			DiscoveryRadius = 90,
		},
		TravelIncident = {
