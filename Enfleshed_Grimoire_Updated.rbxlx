            <string name="Name">Protocol</string>
            <string name="Source"><![CDATA[--!strict

return table.freeze({
	Folder = "SandboxRemotes",
	Request = "ActionRequest",
	Feedback = "ActionFeedback",
	Sprint = "Sprint",
	Dash = "Dash",
	Light = "Light",
	MagicStart = "MagicStart",
	MagicRelease = "MagicRelease",
	MagicAimUpdate = "MagicAimUpdate",
	AerialControl = "AerialControl",
	EquipmentSwitch = "EquipmentSwitch",
	EquipmentUse = "EquipmentUse",
	MagicAwakeningSelect = "MagicAwakeningSelect",
	SummonCommand = "SummonCommand",
	MagicConsent = "MagicConsent",
})
]]></string>
