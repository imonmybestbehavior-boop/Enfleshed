  <Item class="StarterPlayer" referent="87">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="88">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="89">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Protocol = require(Shared:WaitForChild("Networking"):WaitForChild("Protocol"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local remotes = Shared:WaitForChild(Protocol.Folder)
local request = remotes:WaitForChild(Protocol.Request) :: RemoteEvent
local feedback = remotes:WaitForChild(Protocol.Feedback) :: RemoteEvent
local player = Players.LocalPlayer
local sequence = 0

local function send(action: string, extra: Types.ActionOptions?): number
	sequence += 1
	local character = player.Character
	if not character or not player:GetAttribute("OpeningComplete") then
		return sequence
	end
	local payload: Types.ActionRequest = {
		Action = action,
		Sequence = sequence,
		Character = character,
		Sprinting = if extra then extra.Sprinting else nil,
		Direction = if extra then extra.Direction else nil,
		SpellId = if extra then extra.SpellId else nil,
		AimDirection = if extra then extra.AimDirection else nil,
		WorldPoint = if extra then extra.WorldPoint else nil,
		EquipmentSlot = if extra then extra.EquipmentSlot else nil,
		EquipmentAction = if extra then extra.EquipmentAction else nil,
	}
	request:FireServer(payload)
	return sequence
end

local debug = require(script.Controllers.DebugController).start()
require(script.Controllers.LanternController).start()
local movement = require(script.Controllers.MovementController).start(send)
local combat = require(script.Controllers.CombatController).start(send, movement, debug)
local camera = require(script.Controllers.CameraController).start()
local magic = require(script.Controllers.MagicController).start(send, camera.GetAim)
local equipment = require(script.Controllers.EquipmentController).start(send, combat.Attack, magic.WeaponAction)
local generated = require(script.Controllers.GeneratedSpellController).start(magic, debug)
require(script.Controllers.InputController).start(movement.Sprint, function()
	if combat.CanDash() then
		movement.Dash()
	end
end, magic.Cast, magic.Release, equipment.Use, equipment.Switch, generated.Cycle, generated.Begin, generated.Release)

local function reset()
	movement.Reset()
	combat.Reset()
	magic.Reset()
	equipment.Reset()
end
player.CharacterRemoving:Connect(reset)
local deathConnection: RBXScriptConnection? = nil
local function characterAdded(character: Model)
	reset()
	if deathConnection then
		deathConnection:Disconnect()
		deathConnection = nil
	end
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") and player.Character == character then
		deathConnection = humanoid.Died:Connect(reset)
	end
end
player.CharacterAdded:Connect(characterAdded)
if player.Character then
	task.spawn(characterAdded, player.Character)
end
feedback.OnClientEvent:Connect(function(message)
	if message.Kind == "Equipment" then
		equipment.Feedback(message)
	elseif message.Kind == "Magic" then
		debug.Magic(message)
	elseif message.Kind == "Swing" or (player.Character ~= nil and message.Character == player.Character) then
		movement.Feedback(message)
		combat.Feedback(message)
	end
end)

-- Test-only instructions; no city HUD, assignment or opening screen starts here.
local gui = Instance.new("ScreenGui")
gui.Name = "KitDistrictInstructions"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")
local label = Instance.new("TextLabel")
label.AnchorPoint = Vector2.new(0.5, 1)
label.Position = UDim2.fromScale(0.5, 0.98)
label.Size = UDim2.new(0.94, 0, 0, 48)
label.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
label.BackgroundTransparency = 0.25
label.TextColor3 = Color3.fromRGB(235, 222, 195)
label.TextSize = 15
label.TextWrapped = true
label.Font = Enum.Font.Gotham
local population = workspace:WaitForChild("KitDistrictChaseTest")
local function refresh()
	label.Text = string.format(
		"DISTRICT PILOT | Shift sprint · Q dash · Click melee\nF at brass switch: 5 → 10 → 20 → clear | Living %d / requested %d",
		population:GetAttribute("Living") or 0,
		population:GetAttribute("Requested") or 0
	)
end
population:GetAttributeChangedSignal("Living"):Connect(refresh)
population:GetAttributeChangedSignal("Requested"):Connect(refresh)
refresh()
label.Parent = gui
]]></string>
        </Properties>
        <Item class="Folder" referent="90">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">AssignmentController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Definitions = require(Shared.Configuration.Assignments)

local Assignment = {}

function Assignment.start()
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn = "AssignmentHUD", false
	gui.Parent = player:WaitForChild("PlayerGui")
	local label = Instance.new("TextLabel")
	label.Size, label.Position = UDim2.fromOffset(420, 74), UDim2.new(0.5, -210, 0, 12)
	label.BackgroundTransparency, label.TextColor3, label.TextStrokeTransparency = 0.28, Color3.new(1, 1, 1), 0
	label.BackgroundColor3, label.Font, label.TextSize = Color3.fromRGB(18, 18, 18), Enum.Font.Gotham, 16
	label.Parent = gui
	game:GetService("RunService").RenderStepped:Connect(function()
		local id, status = player:GetAttribute("AssignmentId"), player:GetAttribute("AssignmentState")
		gui.Enabled = id ~= nil and id ~= "" and player:GetAttribute("OpeningComplete") == true
		if not gui.Enabled then
			return
		end
		local definition = Definitions[id]
		label.Text = string.format(
			"%s  |  %s\n%s  |  Scrip: %d",
			definition and definition.Name or id,
			status or "",
			player:GetAttribute("AssignmentLocation") or "",
			player:GetAttribute("MilitaryScrip") or 0
		)
	end)
end

return Assignment
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict

-- A compact Scriptable third-person camera. It owns gameplay mouse look but can
-- release the cursor for a future UI without that UI depending on camera internals.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Configuration.Sandbox).Camera
local Camera = {}

function Camera.start()
	local player = Players.LocalPlayer
	local enabled = true
	local yaw = 0
	local pitch = math.rad(-12)
	local gui = Instance.new("ScreenGui")
	gui.Name = "SandboxCrosshair"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = player:WaitForChild("PlayerGui")
	local crosshair = Instance.new("Frame")
	crosshair.Name = "Center"
	crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
	crosshair.Position = UDim2.fromScale(0.5, 0.5)
	crosshair.Size = UDim2.fromOffset(0, 0)
	crosshair.BackgroundTransparency = 1
	crosshair.Parent = gui
	for _, line in
		{
			{
				UDim2.fromOffset(Config.Crosshair.Thickness, Config.Crosshair.Size),
				UDim2.fromOffset(0, -Config.Crosshair.Gap),
			},
			{
				UDim2.fromOffset(Config.Crosshair.Thickness, Config.Crosshair.Size),
				UDim2.fromOffset(0, Config.Crosshair.Gap),
			},
			{
				UDim2.fromOffset(Config.Crosshair.Size, Config.Crosshair.Thickness),
				UDim2.fromOffset(-Config.Crosshair.Gap, 0),
			},
			{
				UDim2.fromOffset(Config.Crosshair.Size, Config.Crosshair.Thickness),
				UDim2.fromOffset(Config.Crosshair.Gap, 0),
			},
		}
	do
		local part = Instance.new("Frame")
		part.AnchorPoint = Vector2.new(0.5, 0.5)
		part.Size = line[1]
		part.Position = UDim2.fromScale(0.5, 0.5) + line[2]
		part.BackgroundColor3 = Color3.new(1, 1, 1)
		part.BackgroundTransparency = Config.Crosshair.Transparency
		part.BorderSizePixel = 0
		part.Parent = crosshair
	end

	local function setMouseLocked(value: boolean)
		UserInputService.MouseBehavior = if value then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = not value
		gui.Enabled = value
	end

	local function getRoot(): BasePart?
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		return if root and root:IsA("BasePart") then root else nil
	end

	local function getAim(): (Vector3, Vector3)
		local camera = Workspace.CurrentCamera
		if not camera then
			return Vector3.zAxis, Vector3.zero
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character or Workspace }
		params.RespectCanCollide = true
		local direction = camera.CFrame.LookVector
		local hit = Workspace:Raycast(camera.CFrame.Position, direction * Config.AimDistance, params)
		return direction, if hit then hit.Position else camera.CFrame.Position + direction * Config.AimDistance
	end

	function Camera:SetGameplayMouseLookEnabled(value: boolean)
		enabled = value
		setMouseLocked(value and player:GetAttribute("OpeningComplete") == true)
	end

	RunService:BindToRenderStep("SandboxThirdPersonCamera", Enum.RenderPriority.Camera.Value, function()
		local camera = Workspace.CurrentCamera
		local root = getRoot()
		if not camera or not root then
			return
		end
		camera.CameraType = Enum.CameraType.Scriptable
		local playing = enabled
			and player:GetAttribute("OpeningComplete") == true
			and not player:GetAttribute("MagicLabOpen")
		setMouseLocked(playing)
		local delta = if playing then UserInputService:GetMouseDelta() else Vector2.zero
		yaw -= delta.X * Config.MouseSensitivity
		pitch = math.clamp(pitch - delta.Y * Config.MouseSensitivity, Config.MinimumPitch, Config.MaximumPitch)
		local target = root.Position + Vector3.new(0, Config.Height, 0)
		local rotation = CFrame.fromOrientation(pitch, yaw, 0)
		local desired = target - rotation.LookVector * Config.Distance + rotation.RightVector * Config.ShoulderOffset
		local offset = desired - target
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character }
		params.RespectCanCollide = true
		local obstruction = Workspace:Raycast(target, offset, params)
		local position = desired
		if obstruction then
			position = target + offset.Unit * math.max(0, obstruction.Distance - Config.ObstructionPadding)
		end
		camera.CFrame = CFrame.lookAt(position, target)
		camera.Focus = CFrame.new(target)
	end)

	UserInputService.TextBoxFocused:Connect(function()
		Camera:SetGameplayMouseLookEnabled(false)
	end)
	UserInputService.TextBoxFocusReleased:Connect(function()
		Camera:SetGameplayMouseLookEnabled(true)
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		Camera:SetGameplayMouseLookEnabled(false)
	end)
	UserInputService.WindowFocused:Connect(function()
		Camera:SetGameplayMouseLookEnabled(true)
	end)
	GuiService.MenuOpened:Connect(function()
		Camera:SetGameplayMouseLookEnabled(false)
	end)
	GuiService.MenuClosed:Connect(function()
		Camera:SetGameplayMouseLookEnabled(true)
	end)

	setMouseLocked(player:GetAttribute("OpeningComplete") == true)
	return {
		GetAim = getAim,
		SetGameplayMouseLookEnabled = function(value: boolean)
			Camera:SetGameplayMouseLookEnabled(value)
		end,
	}
end

return Camera
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local Protocol = require(Shared:WaitForChild("Networking"):WaitForChild("Protocol"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local Movement = require(script.Parent.MovementController)
local Debug = require(script.Parent.DebugController)
local Combat = {}

local function swing(character: Model, step: number)
	local root = character:FindFirstChild("HumanoidRootPart")
	local attack = Config.Combat.Attacks[step]
	if not root or not root:IsA("BasePart") or not attack then
		return
	end
	local part = Instance.new("Part")
	part.Name = "SwingPreview"
	part.Size = attack.Size
	part.CFrame = root.CFrame * CFrame.new(0, 0, -attack.Offset)
	part.Anchored = false
	part.Massless = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(240, 195, 135)
	part.Transparency = Config.Debug.SwingTransparency
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
	part.Parent = workspace
	Debris:AddItem(part, attack.Startup + attack.Active)
end

function Combat.start(
	send: (string, Types.ActionOptions?) -> number,
	movement: Movement.Controller,
	debug: Debug.Controller
)
	local player = Players.LocalPlayer
	local combo = 0
	local readyAt = 0
	local expires = 0
	local pending = 0
	local bufferedUntil = 0

	local function attack()
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		if not character or not humanoid or humanoid.Health <= 0 or movement.IsDashing() then
			return
		end
		local now = workspace:GetServerTimeNow()
		if now < readyAt or pending ~= 0 then
			if readyAt - now <= Config.Combat.InputBuffer then
				bufferedUntil = now + Config.Combat.InputBuffer
			end
			return
		end
		combo = if now > expires then 1 else combo % #Config.Combat.Attacks + 1
		local definition = Config.Combat.Attacks[combo]
		readyAt = now + definition.Startup + definition.Active + definition.Recovery
		expires = readyAt + Config.Combat.ComboReset
		bufferedUntil = 0
		swing(character, combo)
		pending = send(Protocol.Light, nil)
	end

	RunService.RenderStepped:Connect(function()
		local now = workspace:GetServerTimeNow()
		if bufferedUntil >= now and pending == 0 and now >= readyAt then
			attack()
		end
		debug.Update(if now > expires then 0 else combo, movement.GetCooldown())
	end)

	return {
		Attack = attack,
		CanDash = function(): boolean
			return pending == 0 and workspace:GetServerTimeNow() >= readyAt
		end,
		Reset = function()
			combo = 0
			readyAt = 0
			expires = 0
			pending = 0
			bufferedUntil = 0
			debug.Reset()
		end,
		Feedback = function(message: any)
			if message.Kind == "Swing" then
				if
					typeof(message.Character) == "Instance"
					and message.Character:IsA("Model")
					and message.Character ~= player.Character
				then
					swing(message.Character, message.Combo)
				end
			elseif message.Kind == "Hit" then
				local target = message.Target
				debug.Hit(message.Damage, if typeof(target) == "Instance" and target:IsA("Model") then target else nil)
			elseif message.Kind == "Correction" then
				bufferedUntil = 0
			elseif message.Kind == "Action" and message.Action == Protocol.Light and message.Sequence == pending then
				pending = 0
				combo = message.Combo
				readyAt = message.ReadyAt
				expires = readyAt + Config.Combat.ComboReset
				if not message.Accepted then
					bufferedUntil = 0
				end
			end
		end,
	}
end

return Combat
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">DebugController</string>
              <string name="Source"><![CDATA[--!strict

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Configuration.Sandbox)
local Debug = {}

function Debug.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "SandboxDebug"
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local cityConfig = require(game:GetService("ReplicatedStorage").Shared.Configuration.CityLife)
	gui.Enabled = game:GetService("RunService"):IsStudio()
		and (cityConfig.DevelopmentSpells or Config.StressTest.Enabled)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromOffset(760, 156)
	label.Position = UDim2.fromOffset(12, 12)
	label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	label.BackgroundTransparency = 0.25
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextSize = 17
	label.Font = Enum.Font.Code
	label.Parent = gui
	local hitUntil = 0
	local hitText = ""
	local stress: Instance? = nil
	local magicText = ""
	local magicUntil = 0
	local generatedText = ""
	local function waveText(): string
		if not Config.StressTest.Enabled then
			return ""
		end
		if not stress or not stress.Parent then
			stress = workspace:FindFirstChild("SandboxStressTest")
		end
		if not stress then
			return "Stress test starting..."
		end
		local phase = stress:GetAttribute("Status")
		if phase == "Complete" then
			return "Stress test complete | Living 0"
		end
		if phase == "Blocked" then
			return "Waiting for a clear enemy spawn area"
		end
		local wave = stress:GetAttribute("Wave") or 0
		local total = stress:GetAttribute("TotalWaves") or 0
		local living = stress:GetAttribute("LivingEnemies") or 0
		if phase == "Waiting" then
			local seconds =
				math.max(0, math.ceil((stress:GetAttribute("NextWaveAt") or 0) - workspace:GetServerTimeNow()))
			return string.format("Wave %d/%d | Living %d | Next in %ds", wave, total, living, seconds)
		end
		return string.format("Wave %d/%d | Living %d", wave, total, living)
	end
	return {
		Hit = function(damage: number, target: Model?)
			local name = if target then (target:GetAttribute("SandboxLabel") or target.Name) else "Target"
			hitText = string.format("HIT %s  -%g HP", name, damage)
			hitUntil = os.clock() + Config.Debug.HitDuration
			if not target or not target:IsDescendantOf(workspace) then
				return
			end
			-- Client-only, confirmed-hit debug feedback. One flash/number per target.
			for _, effectName in { "SandboxConfirmedHit", "SandboxDamageNumber" } do
				local previous = target:FindFirstChild(effectName)
				if previous then
					previous:Destroy()
				end
			end
			local flash = Instance.new("Highlight")
			flash.Name = "SandboxConfirmedHit"
			flash.Adornee = target
			flash.FillTransparency = 0.6
			flash.FillColor = Color3.fromRGB(255, 255, 255)
			flash.OutlineColor = Color3.fromRGB(255, 255, 255)
			flash.OutlineTransparency = 0
			flash.DepthMode = Enum.HighlightDepthMode.Occluded
			flash.Parent = target
			Debris:AddItem(flash, Config.Debug.TargetFlashDuration)
			local anchor = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
			if not anchor or not anchor:IsA("BasePart") then
				return
			end
			local number = Instance.new("BillboardGui")
			number.Name = "SandboxDamageNumber"
			number.Adornee = anchor
			number.Size = UDim2.fromOffset(130, 32)
			number.StudsOffset = Vector3.new(0, 3.5, 0)
			number.AlwaysOnTop = true
			number.Parent = target
			local text = Instance.new("TextLabel")
			text.Size = UDim2.fromScale(1, 1)
			text.BackgroundTransparency = 1
			text.Font = Enum.Font.GothamBold
			text.TextSize = 24
			text.TextColor3 = Color3.fromRGB(255, 240, 140)
			text.TextStrokeTransparency = 0
			text.Text = string.format("-%g", damage)
			text.Parent = number
			Debris:AddItem(number, Config.Debug.HitDuration)
		end,
		Reset = function()
			hitUntil = 0
		end,
		Magic = function(message: any)
			magicText = string.format(
				"Magic %s %s | mana %s | strain %s | complexity %s%s%s",
				tostring(message.Name or ""),
				tostring(message.Result or ""),
				tostring(message.Mana or "-"),
				tostring(message.Strain or "-"),
				tostring(message.Complexity or "-"),
				if message.Damage then " | damage " .. tostring(message.Damage) else "",
				if message.Reason then " | " .. tostring(message.Reason) else ""
			)
			magicUntil = os.clock() + 2.5
		end,
		Generated = function(text: string)
			generatedText = text
		end,
		Update = function(combo: number, cooldown: number)
			label.Text = string.format(
				"Combo %d/3  |  Dash %.1fs\n%s\n%s\n%s\n%s\nV2: 4 Lance | 5 Ground | 6 Reinforcement | 7 Raise",
				combo,
				cooldown,
				if os.clock() < hitUntil then hitText else "",
				if os.clock() < magicUntil then magicText else "",
				generatedText,
				waveText()
			)
		end,
	}
end

export type Controller = typeof(Debug.start())
return Debug
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">EquipmentController</string>
              <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Protocol = require(Shared.Networking.Protocol)
local Types = require(Shared.Types.CombatTypes)
local Equipment = {}

function Equipment.start(
	send: (string, Types.ActionOptions?) -> number,
	meleeAttack: () -> (),
	magicAction: (string) -> ()
)
	local player = game:GetService("Players").LocalPlayer
	local activeSlot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
	player:GetAttributeChangedSignal("ActiveEquipmentSlot"):Connect(function()
		activeSlot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
	end)
	return {
		Use = function(action: string)
			if activeSlot == "SecondaryWeapon" and action == "Primary" then
				meleeAttack()
			elseif activeSlot == "PrimaryWeapon" then
				magicAction(action)
			end
		end,
		Switch = function()
			local slot = if activeSlot == "PrimaryWeapon" then "SecondaryWeapon" else "PrimaryWeapon"
			send(Protocol.EquipmentSwitch, { EquipmentSlot = slot })
		end,
		Feedback = function(message: any)
			if
				message.Kind == "Equipment"
				and (message.ActiveSlot == "PrimaryWeapon" or message.ActiveSlot == "SecondaryWeapon")
			then
				activeSlot = message.ActiveSlot
			end
		end,
		Reset = function()
			activeSlot = player:GetAttribute("ActiveEquipmentSlot") or "SecondaryWeapon"
		end,
	}
end

return Equipment
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">GeneratedSpellController</string>
              <string name="Source"><![CDATA[--!strict

-- Development-only keyboard harness for the controlled generated registry.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.Sandbox).DevelopmentSpellStress
local Generated = require(Shared.Configuration.GeneratedSpellStress)
local GeneratedController = {}

function GeneratedController.start(magic: any, debug: any)
	local selected = 1
	local function announce()
		if not Config.Enabled or #Generated.Order == 0 then
			return
		end
		local id = Generated.Order[selected]
		debug.Generated(string.format("Generated %d/%d | %s", selected, #Generated.Order, Generated.Descriptions[id]))
	end
	announce()
	return {
		Cycle = function()
			if not Config.Enabled or #Generated.Order == 0 then
				return
			end
			selected = selected % #Generated.Order + 1
			announce()
		end,
		Begin = function()
			if not Config.Enabled or #Generated.Order == 0 then
				return
			end
			local id = Generated.Order[selected]
			magic.Cast(id, Generated.Definitions[id].Casting.Mode == "Charged")
		end,
		Release = function()
			magic.Release()
		end,
	}
end

return GeneratedController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict

local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local player = game:GetService("Players").LocalPlayer
local development = game:GetService("RunService"):IsStudio()
	and require(game:GetService("ReplicatedStorage").Shared.Configuration.CityLife).DevelopmentSpells
local Input = {}

function Input.start(
	sprint: (boolean) -> (),
	dash: () -> (),
	magicStart: (string, boolean?) -> (),
	magicRelease: () -> (),
	useEquipment: (string) -> (),
	switchEquipment: () -> (),
	cycleGenerated: () -> (),
	startGenerated: () -> (),
	releaseGenerated: () -> ()
)
	ContextActionService:BindAction("SandboxSprint", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprint(false)
		elseif state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			sprint(true)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.LeftShift)
	ContextActionService:BindAction("SandboxDash", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			dash()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Q)
	ContextActionService:BindAction("SandboxLight", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			useEquipment("Primary")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.UserInputType.MouseButton1)
	ContextActionService:BindAction("SandboxEquipmentArea", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			useEquipment("Area")
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.UserInputType.MouseButton2)
	ContextActionService:BindAction("SandboxEquipmentSwitch", function(_, state)
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			switchEquipment()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.E)
	for spellId, key in
		{
			Fireball = Enum.KeyCode.One,
			BodyBurst = Enum.KeyCode.Two,
			StoneShot = Enum.KeyCode.Three,
			LightningLance = Enum.KeyCode.Four,
			BurningGround = Enum.KeyCode.Five,
			BodyReinforcement = Enum.KeyCode.Six,
			StoneRaise = Enum.KeyCode.Seven,
		}
	do
		ContextActionService:BindAction("Sandbox" .. spellId, function(_, state)
			if not development then
				return Enum.ContextActionResult.Pass
			end
			if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
				return Enum.ContextActionResult.Pass
			end
			if UserInputService:GetFocusedTextBox() then
				return Enum.ContextActionResult.Sink
			end
			if state == Enum.UserInputState.Begin then
				magicStart(spellId, spellId == "StoneShot")
			elseif
				spellId == "StoneShot" and (state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel)
			then
				magicRelease()
			end
			return Enum.ContextActionResult.Sink
		end, false, key)
	end
	ContextActionService:BindAction("SandboxGeneratedCycle", function(_, state)
		if not development then
			return Enum.ContextActionResult.Pass
		end
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin and not UserInputService:GetFocusedTextBox() then
			cycleGenerated()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.F)
	ContextActionService:BindAction("SandboxGeneratedCast", function(_, state)
		if not development then
			return Enum.ContextActionResult.Pass
		end
		if not player:GetAttribute("OpeningComplete") or player:GetAttribute("MagicLabOpen") then
			return Enum.ContextActionResult.Pass
		end
		if UserInputService:GetFocusedTextBox() then
			return Enum.ContextActionResult.Sink
		end
		if state == Enum.UserInputState.Begin then
			startGenerated()
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			releaseGenerated()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.R)
	UserInputService.WindowFocusReleased:Connect(function()
		sprint(false)
	end)
	UserInputService.TextBoxFocused:Connect(function()
		sprint(false)
	end)
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">LanternController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local Lantern = {}

function Lantern.start()
	local player = Players.LocalPlayer
	local attachment: Attachment? = nil
	local function clear()
		if attachment then
			attachment:Destroy()
			attachment = nil
		end
	end
	local function bind(character: Model)
		clear()
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if player.Character ~= character or not root or not root:IsA("BasePart") then
			return
		end
		local anchor = Instance.new("Attachment")
		anchor.Name = "LocalFieldLantern"
		anchor.Position = Vector3.new(0, 2.2, -1.4)
		anchor.Parent = root
		attachment = anchor
		local light = Instance.new("PointLight")
		light.Name = "FieldLantern"
		light.Color = Color3.fromRGB(255, 203, 146)
		light.Range, light.Brightness, light.Shadows = 36, 3.25, true
		light.Parent = anchor
	end
	player.CharacterRemoving:Connect(clear)
	player.CharacterAdded:Connect(bind)
	if player.Character then
		task.spawn(bind, player.Character)
	end
end

return Lantern
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">MagicController</string>
              <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Protocol = require(Shared.Networking.Protocol)
local Types = require(Shared.Types.CombatTypes)
local Magic = {}
local function handOrigin()
	local character = game:GetService("Players").LocalPlayer.Character
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm"))
	return if hand and hand:IsA("BasePart")
		then hand.Position - hand.CFrame.UpVector * hand.Size.Y * 0.35 + Vector3.yAxis * 0.9
		else nil
end

function Magic.start(send: (string, Types.ActionOptions?) -> number, aim: () -> (Vector3, Vector3))
	require(script.Parent.MagicPresentationController).start()
	require(script.Parent.MagicLabController).start(send, aim)
	local activeSpell: string? = nil
	local function cast(spellId: string, charged: boolean?)
		local direction, point = aim()
		activeSpell = if charged then spellId else nil
		send(
			Protocol.MagicStart,
			{ SpellId = spellId, AimDirection = direction, WorldPoint = point, CastOrigin = handOrigin() }
		)
	end
	return {
		Cast = cast,
		Release = function()
			if not activeSpell then
				return
			end
			local direction, point = aim()
			send(
				Protocol.MagicRelease,
				{ SpellId = activeSpell, AimDirection = direction, WorldPoint = point, CastOrigin = handOrigin() }
			)
			activeSpell = nil
		end,
		WeaponAction = function(action: string)
			local direction, point = aim()
			send(Protocol.EquipmentUse, { EquipmentAction = action, AimDirection = direction, WorldPoint = point })
		end,
		Reset = function()
			activeSpell = nil
		end,
	}
end

return Magic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">MagicLabController</string>
              <string name="Source"><![CDATA[--!strict
-- Session-only editor. It sends data; authoritative casts stay on the server.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local UIS = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.MagicLab)
local Spec = require(Shared.Modules.SpellSpec)
local ProjectileBehaviorSpec = require(Shared.Modules.ProjectileBehaviorSpec)
local Protocol = require(Shared.Networking.Protocol)
local Elements = require(Shared.Configuration.MagicElements)
local Slots = require(Shared.Modules.MagicSlots)
local Presets = Spec.copy(require(Shared.Configuration.Spells))
for id, preset in require(Shared.Configuration.MagicLabPresets) do
	Presets[id] = preset
end
local Camera = require(script.Parent.CameraController)
local Lab = {}
function Lab.start(send, aim)
	if not Config.Enabled or not (RunService:IsStudio() or (not Config.StudioOnly and Config.AllowLive)) then
		return
	end
	local player = Players.LocalPlayer
	local remotes = Shared:WaitForChild(Protocol.Folder)
	local request = remotes:WaitForChild("MagicLabRequest")
	local response = remotes:WaitForChild("MagicLabResponse")
	local gui = Instance.new("ScreenGui")
	gui.Name = "MagicLab"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 80
	gui.Parent = player:WaitForChild("PlayerGui")
	local panel = Instance.new("Frame")
	panel.Size = UDim2.new(0, 510, 0.88, 0)
	panel.Position = UDim2.new(0, 12, 0.06, 0)
	panel.BackgroundColor3 = Color3.fromRGB(21, 25, 30)
	panel.Visible = false
	panel.Parent = gui
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -16, 1, -150)
	scroll.Position = UDim2.fromOffset(8, 8)
	scroll.BackgroundTransparency = 1
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.ScrollBarThickness = 6
	scroll.Parent = panel
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 5)
	list.Parent = scroll
	local status = Instance.new("TextLabel")
	status.Size = UDim2.new(1, -16, 0, 58)
	status.Position = UDim2.new(0, 8, 1, -139)
	status.BackgroundTransparency = 1
	status.TextWrapped = true
	status.TextSize = 14
	status.TextColor3 = Color3.fromRGB(220, 230, 235)
	status.Parent = panel
	local sourceId = "Fireball"
	local draft = Spec.normalize(Presets[sourceId])
	local event = "OnImpact"
	local saved = {}
	local savedOrder = {}
	local selectedSlot = 1
	local equipped = {}
	local applyingDraft, applyingSlot
	local bar = Instance.new("TextLabel")
	bar.Name = "EquippedSpells"
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.fromScale(0.5, 0.86)
	bar.Size = UDim2.new(0.86, 0, 0, 48)
	bar.BackgroundColor3 = Color3.fromRGB(21, 25, 30)
	bar.BackgroundTransparency = 0.2
	bar.TextColor3 = Color3.fromRGB(220, 230, 235)
	bar.TextSize = 14
	bar.TextWrapped = true
	bar.Parent = gui
	local function refreshBar()
		local names = { "P · Magic Lab" }
		for i = 1, Slots.Count do
			table.insert(names, i .. ": " .. (equipped[i] and equipped[i].Name or "—"))
		end
		bar.Text = table.concat(names, "  |  ")
	end
	refreshBar()
	local pendingCast = false
	local applying = false
	local dirty = true
	local revision = 0
	local appliedRevision = -1
	local debugGeometry = false
	local drawFolder = Instance.new("Folder")
	drawFolder.Name = "MagicLabLocalPreview"
	drawFolder.Parent = workspace
	local toast = Instance.new("TextLabel")
	toast.Name = "CastFeedback"
	toast.AnchorPoint = Vector2.new(0.5, 0)
	toast.Position = UDim2.fromScale(0.5, 0.15)
	toast.Size = UDim2.new(0.7, 0, 0, 44)
	toast.BackgroundColor3 = Color3.fromRGB(21, 25, 30)
	toast.BackgroundTransparency = 0.2
	toast.TextSize = 16
	toast.TextWrapped = true
	toast.Visible = false
	toast.Parent = gui
	local toastUntil = 0
	RunService.Heartbeat:Connect(function()
		toast.Visible = not panel.Visible and os.clock() < toastUntil
	end)
	local function message(text, ok)
		status.Text = text
		toast.Text = text
		toastUntil = os.clock() + 3
		status.TextColor3 = if ok then Color3.fromRGB(170, 235, 200) else Color3.fromRGB(255, 170, 145)
		toast.TextColor3 = status.TextColor3
	end
	local function estimate()
		revision += 1
		dirty = true
		local ok, reason = Spec.validate(draft)
		if not ok then
			message(reason, false)
			return
		end
		local cost = Spec.estimate(draft)
		message(
			string.format(
				"DEV ESTIMATE · demand %d · strain %d · complexity %d\nApply to test; source spell is unchanged.",
				cost.ManaDemand,
				cost.Strain,
				cost.Complexity
			),
			true
		)
	end
	local function visibility(open)
		panel.Visible = open
		player:SetAttribute("MagicLabOpen", open)
		Camera:SetGameplayMouseLookEnabled(not open)
		if open then
			send("Sprint", { Sprinting = false })
		end
	end
	local rebuild
	local order = 0
	local function row(label)
		order += 1
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, -8, 0, 30)
		frame.BackgroundTransparency = 1
		frame.LayoutOrder = order
		frame.Parent = scroll
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(0.58, 0, 1, 0)
		title.BackgroundTransparency = 1
		title.Text = label
		title.TextColor3 = Color3.fromRGB(205, 214, 224)
		title.TextSize = 14
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.Parent = frame
		return frame
	end
	local function heading(text)
		row(text)
	end
	local function button(parent, text, callback)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0.4, 0, 1, 0)
		b.Position = UDim2.new(0.59, 0, 0, 0)
		b.BackgroundColor3 = Color3.fromRGB(48, 61, 75)
		b.TextColor3 = Color3.new(1, 1, 1)
		b.TextSize = 14
		b.TextWrapped = true
		b.Text = text
		b.Parent = parent
		b.Activated:Connect(callback)
		return b
	end
	local function select(label, value, options, change)
		local r = row(label)
		button(r, tostring(value) .. " ▾", function()
			local old = panel:FindFirstChild("Choices")
			if old then
				old:Destroy()
			end
			local choices = Instance.new("ScrollingFrame")
			choices.Name = "Choices"
			choices.Size = UDim2.new(1, -24, 0, math.min(340, #options * 32))
			choices.Position = UDim2.fromOffset(12, 40)
			choices.ZIndex = 20
			choices.BackgroundColor3 = Color3.fromRGB(33, 42, 54)
			choices.CanvasSize = UDim2.fromOffset(0, #options * 32)
			choices.Parent = panel
			for i, option in options do
				local b = button(choices, tostring(option), function()
					choices:Destroy()
					change(option)
					rebuild()
					estimate()
				end)
				b.Size = UDim2.new(1, -10, 0, 30)
				b.Position = UDim2.fromOffset(0, (i - 1) * 32)
				b.ZIndex = 21
			end
		end)
	end
	local function numeric(label, object, key)
		local r = row(label)
		local box = Instance.new("TextBox")
		box.Size = UDim2.new(0.4, 0, 1, 0)
		box.Position = UDim2.new(0.59, 0, 0, 0)
		box.BackgroundColor3 = Color3.fromRGB(39, 45, 54)
		box.TextColor3 = Color3.new(1, 1, 1)
		box.TextSize = 14
		box.ClearTextOnFocus = false
		box.Text = tostring(object[key] or 0)
		box.Parent = r
		box.FocusLost:Connect(function()
			local value = tonumber(box.Text)
			if not value then
				object[key] = nil
				revision += 1
				dirty = true
				message(label .. ": enter a finite number", false)
				return
			end
			object[key] = value
			estimate()
		end)
	end
	local function toggle(label, value, change)
		local r = row(label)
		local b
		b = button(r, value and "ON" or "OFF", function()
			value = not value
			change(value)
			b.Text = value and "ON" or "OFF"
			rebuild()
			estimate()
		end)
	end
	local function primary()
		draft.Triggers[event] = draft.Triggers[event] or {}
		for _, step in draft.Triggers[event] do
			if not step.Behavior then
				return step
			end
		end
		return nil
	end
	local function payload(kind)
		local step = primary()
		if step then
			for _, p in step.Payloads do
				if p.Kind == kind then
					return p
				end
			end
		end
	end
	local function setPayload(kind, on)
		local step = primary()
		if not step and on then
			step = { Payloads = {} }
			table.insert(draft.Triggers[event], 1, step)
		end
		if not step then
			return
		end
		for i = #step.Payloads, 1, -1 do
			if step.Payloads[i].Kind == kind then
				table.remove(step.Payloads, i)
			end
		end
		if on then
			table.insert(
				step.Payloads,
				if kind == "Damage"
					then { Kind = kind, Amount = 20 }
					elseif kind == "DamageOverTime" then { Kind = kind, Amount = 5, Duration = 4, Interval = 1 }
					else { Kind = kind, Magnitude = 10, Upward = 0 }
			)
		end
		if #step.Payloads == 0 then
			for i, s in draft.Triggers[event] do
				if s == step then
					table.remove(draft.Triggers[event], i)
					break
				end
			end
		end
	end
	local function projectileBehavior(kind)
		if not draft.Projectile then
			return nil
		end
		for _, behavior in ipairs(draft.Projectile.Behaviors or {}) do
			if behavior.Kind == kind then
				return behavior
			end
		end
		return nil
	end
	local function setProjectileBehavior(kind, on)
		draft.Projectile.Behaviors = draft.Projectile.Behaviors or {}
		for i = #draft.Projectile.Behaviors, 1, -1 do
			if draft.Projectile.Behaviors[i].Kind == kind then
				table.remove(draft.Projectile.Behaviors, i)
			end
		end
		if not on then
			return
		end
		local behavior = ProjectileBehaviorSpec.copyDefaults(kind)
		if behavior then
			table.insert(draft.Projectile.Behaviors, behavior)
		end
	end
	local defaults = {
		Aura = "LabAura",
		Construct = "LabBarrier",
		Projectile = "Fireball",
		Beam = "LightningLance",
		Wave = "BodyBurst",
		Field = "BurningGround",
		SelfEnhancement = "BodyReinforcement",
		Manipulation = "StoneRaise",
	}
	local function mainEvent(form)
		return if form == "Projectile"
			then "OnImpact"
			elseif form == "Field" or form == "Aura" then "OnTick"
			else "OnCast"
	end
	rebuild = function()
		for _, child in scroll:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		order = 0
		heading("MAGIC LAB · P close · 1–9 cast equipped spells")
		select("Equip into slot", selectedSlot, { 1, 2, 3, 4, 5, 6, 7, 8, 9 }, function(v)
			selectedSlot = v
		end)
		for i = 1, Slots.Count do
			if equipped[i] then
				heading(i .. " · " .. equipped[i].Name)
			end
		end
		local names = {}
		for id in Presets do
			table.insert(names, id)
		end
		table.sort(names)
		for _, name in savedOrder do
			table.insert(names, "Session: " .. name)
		end
		select("Preset", sourceId, names, function(id)
			if saved[id] then
				draft = Spec.copy(saved[id].Spec)
				sourceId = saved[id].Source
			else
				sourceId = id
				draft = Spec.normalize(Presets[id])
			end
			event = mainEvent(draft.Form)
		end)
		local r = row("Temporary preset name")
		local name = Instance.new("TextBox")
		name.Size = UDim2.new(0.4, 0, 1, 0)
		name.Position = UDim2.new(0.59, 0, 0, 0)
		name.Text = draft.Name
		name.ClearTextOnFocus = false
		name.TextSize = 14
		name.Parent = r
		name.FocusLost:Connect(function()
			draft.Name = name.Text
			estimate()
		end)
		select("Casting presentation", draft.Visual.Profile or "Auto", Spec.PresentationProfiles, function(v)
			draft.Visual.Profile = v
		end)
		select("Element (color affinity)", draft.Element, Spec.Elements, function(v)
			draft.Element = v
			draft.Visual.Color = Elements[v]
		end)
		select("Principle", draft.Source.Principle, Spec.Principles, function(v)
			draft.Source.Principle = v
			draft.Source.Expression = ({ Matter = "Earth", Energy = "Fire", Body = "BodyEnhancement" })[v] or v
		end)
		select("Form", draft.Form, Spec.Forms, function(v)
			local principle = draft.Source
			if defaults[v] then
				draft = Spec.normalize(Presets[defaults[v]])
				draft.Source = principle
			else
				draft.Form = v
			end
			event = mainEvent(v)
		end)
		if not Spec.Events[draft.Form] then
			heading("UNSUPPORTED · no executor for this Form")
			return
		end
		heading("CASTING")
		select("Casting mode", draft.Casting.Mode, { "Instant", "Charged" }, function(v)
			draft.Casting.Mode = v
			if v == "Charged" then
				draft.Casting.MinimumCharge = 0.2
				draft.Casting.MaximumCharge = 1.2
			else
				draft.Casting.MinimumCharge = nil
				draft.Casting.MaximumCharge = nil
			end
		end)
		numeric("Cooldown (s)", draft.Casting, "Cooldown")
		numeric("Cast time (s)", draft.Casting, "CastTime")
		numeric("Recovery (s)", draft.Casting, "RecoveryTime")
		if draft.Casting.Mode == "Charged" then
			numeric("Charge time (automatic Lab hold)", draft.Casting, "MinimumCharge")
			numeric("Maximum charge", draft.Casting, "MaximumCharge")
		end
		heading("TARGETING")
		select("Mode", draft.Targeting, { "AimDirection", "WorldPoint", "Self", "MaterialTarget" }, function(v)
			draft.Targeting = v
			draft.Material = if v == "MaterialTarget"
				then { Material = "Earth", Amount = 1, SearchRadius = 12 }
				else nil
		end)
		numeric("Targeting range", draft.TargetRules, "Range")
		numeric("Maximum targets", draft.TargetRules, "MaxTargets")
		toggle("Require line of sight", draft.TargetRules.RequiresLineOfSight, function(v)
			draft.TargetRules.RequiresLineOfSight = v
		end)
		heading("FORM MECHANICS")
		if draft.Form == "Projectile" then
			for _, entry in
				{
					{ "Speed", "Speed" },
					{ "Radius", "Radius" },
					{ "Maximum distance", "MaxDistance" },
					{ "Gravity (studs/s²)", "Gravity" },
					{ "Acceleration", "Acceleration" },
				}
			do
				numeric(entry[1], draft.Projectile, entry[2])
			end
			heading("COMPOSABLE PROJECTILE BEHAVIORS · element-agnostic")
			for _, kind in ProjectileBehaviorSpec.Order do
				local behavior = projectileBehavior(kind)
				toggle(kind, behavior ~= nil, function(v)
					setProjectileBehavior(kind, v)
				end)
				if behavior then
					local metadata = ProjectileBehaviorSpec.get(kind)
					for _, field in metadata.Fields do
						numeric(field.Label, behavior, field.Key)
					end
				end
			end
		elseif draft.Form == "Beam" then
			numeric("Length / range", draft.Beam, "Range")
			numeric("Width (0 = ray)", draft.Beam, "Width")
			heading("Instant beam · sustained duration UNSUPPORTED")
		elseif draft.Form == "Construct" then
			for _, key in { "Width", "Height", "Depth", "Distance" } do
				numeric(key, draft.Construct, key)
			end
			heading("Aim to attach · open air also works")
		elseif draft.Form == "Aura" then
			numeric("Radius", draft.Aura, "Radius")
			numeric("Tick interval (seconds)", draft.Aura, "Interval")
		elseif draft.Form == "Field" then
			numeric("Radius", draft.Field, "Radius")
			numeric("Tick interval (seconds)", draft.Field, "Interval")
		elseif draft.Form == "Wave" then
			numeric("Range", draft.Wave, "Range")
			numeric("Facing dot (-1 radial; 1 narrow)", draft.Wave, "Dot")
		end
		if draft.Form == "SelfEnhancement" then
			toggle("Toggle until switched off", draft.Lifetime.Mode == "UntilToggledOff", function(v)
				draft.Lifetime = if v then { Mode = "UntilToggledOff" } else { Mode = "FixedDuration", Duration = 10 }
			end)
		end
		if draft.Lifetime.Mode == "FixedDuration" then
			numeric("Duration (seconds)", draft.Lifetime, "Duration")
		end
		if draft.Material then
			numeric("Material search radius", draft.Material, "SearchRadius")
		end
		if draft.Form == "Construct" then
			heading("Temporary solid geometry · no damage payload")
			return
		end
		heading("PAYLOADS / TRIGGERS")
		local events = {}
		for e in Spec.Events[draft.Form] do
			table.insert(events, e)
		end
		table.sort(events)
		select("Edit trigger", event, events, function(v)
			event = v
		end)
		if draft.Form == "SelfEnhancement" then
			local p = payload("Enhancement")
			if p then
				numeric("Movement multiplier", p, "SpeedMultiplier")
				numeric("Jump-power bonus", p, "JumpPowerBonus")
				numeric("Walk-speed bonus", p, "WalkSpeedBonus")
			end
		elseif draft.Form == "Manipulation" then
			local p = payload("Manipulation")
			if p then
				numeric("Discrete raise distance", p, "Distance")
			end
			heading("Tagged Earth only · control relinquished immediately")
		else
			for _, kind in { "Damage", "Force", "DamageOverTime" } do
				local p = payload(kind)
				toggle(kind, p ~= nil, function(v)
					setPayload(kind, v)
				end)
				if p then
					numeric(
						kind ~= "Force" and "Damage per hit/tick" or "Force velocity impulse",
						p,
						kind ~= "Force" and "Amount" or "Magnitude"
					)
					if kind == "DamageOverTime" then
						numeric("DoT duration (s)", p, "Duration")
						numeric("DoT tick interval (s)", p, "Interval")
					end
					if kind == "Force" then
						numeric("Upward impulse", p, "Upward")
					end
				end
			end
			if draft.Form == "Projectile" and event == "OnImpact" then
				local explosion = nil
				for _, step in draft.Triggers.OnImpact or {} do
					if step.Behavior == "Explode" then
						explosion = step
					end
				end
				toggle("Explode on impact", explosion ~= nil, function(v)
					local steps = draft.Triggers.OnImpact or {}
					draft.Triggers.OnImpact = steps
					for i = #steps, 1, -1 do
						if steps[i].Behavior then
							table.remove(steps, i)
						end
					end
					if v then
						table.insert(
							steps,
							{ Behavior = "Explode", Radius = 7, Payloads = { { Kind = "Damage", Amount = 18 } } }
						)
					end
				end)
				if explosion then
					numeric("Explosion radius", explosion, "Radius")
					for _, p in explosion.Payloads do
						if p.Kind == "Damage" then
							numeric("Explosion damage (additional)", p, "Amount")
						end
					end
				end
			end
		end
		if draft.Form ~= "Projectile" then
			heading("Homing / Pierce / Chain apply to Projectile Form")
		end
		heading("CONDITIONS")
		for _, condition in { "OnGround", "TargetWithinRange", "HasLineOfSight" } do
			local found = table.find(draft.Conditions, condition) ~= nil
			toggle(condition, found, function(v)
				local index = table.find(draft.Conditions, condition)
				if index then
					table.remove(draft.Conditions, index)
				end
				if v then
					table.insert(draft.Conditions, condition)
				end
			end)
		end
		toggle("Local geometry preview on test", debugGeometry, function(v)
			debugGeometry = v
		end)
	end
	local function preview(direction, point)
		drawFolder:ClearAllChildren()
		if not debugGeometry then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		local p = Instance.new("Part")
		p.Name = "DevelopmentGeometry"
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Transparency = 0.75
		p.Material = Enum.Material.Neon
		p.Color = draft.Visual.Color
		local radius = (draft.Projectile and draft.Projectile.Radius)
			or (draft.Field and draft.Field.Radius)
			or (draft.Wave and draft.Wave.Range)
			or 2
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.one * radius * 2
		p.Position = if draft.Form == "Field" then point else root.Position + direction * (radius + 3)
		if draft.Beam then
			p.Shape = Enum.PartType.Block
			p.Size = Vector3.new(math.max(0.16, draft.Beam.Width), math.max(0.16, draft.Beam.Width), draft.Beam.Range)
			p.CFrame = CFrame.lookAt(
				root.Position + direction * draft.Beam.Range / 2,
				root.Position + direction * draft.Beam.Range
			)
		end
		p.Parent = drawFolder
		Debris:AddItem(p, 1.5)
	end
	local function cast(slot)
		slot = slot or selectedSlot
		if not equipped[slot] then
			message("This slot is empty. Select a slot and press EQUIP.", false)
			return
		end
		visibility(false)
		local direction, point = aim()
		local editing = draft
		draft = equipped[slot]
		preview(direction, point)
		draft = editing
		request:FireServer("Cast", { AimDirection = direction, WorldPoint = point, Character = player.Character }, slot)
	end
	local function apply(andCast)
		if applying then
			return
		end
		local focused = UIS:GetFocusedTextBox()
		if focused then
			focused:ReleaseFocus()
		end
		local ok, reason = Spec.validate(draft)
		if not ok then
			message(reason, false)
			return
		end
		applying = true
		appliedRevision = revision
		pendingCast = andCast
		applyingSlot, applyingDraft = selectedSlot, Spec.copy(draft)
		request:FireServer("Apply", applyingDraft, applyingSlot)
	end
	local actions = Instance.new("Frame")
	actions.Size = UDim2.new(1, -16, 0, 64)
	actions.Position = UDim2.new(0, 8, 1, -72)
	actions.BackgroundTransparency = 1
	actions.Parent = panel
	local function action(label, index, callback)
		local b = button(actions, label, callback)
		b.Size = UDim2.new(0.32, 0, 0, 29)
		b.Position = UDim2.new((index % 3) * 0.335, 0, 0, math.floor(index / 3) * 33)
	end
	action("EQUIP", 0, function()
		apply(false)
	end)
	action("CAST TEST", 1, function()
		apply(true)
	end)
	action("RESET SOURCE", 2, function()
		draft = Spec.normalize(Presets[sourceId])
		event = mainEvent(draft.Form)
		rebuild()
		estimate()
	end)
	action("SAVE TEMP", 3, function()
		local ok, reason = Spec.validate(draft)
		if not ok then
			message(reason, false)
			return
		end
		local key = "Session: " .. draft.Name
		if not saved[key] and #savedOrder >= Config.MaxPresets then
			message("Session preset limit reached", false)
			return
		end
		if not saved[key] then
			table.insert(savedOrder, draft.Name)
		end
		saved[key] = { Spec = Spec.copy(draft), Source = sourceId }
		rebuild()
		message("Saved for this client session only", true)
	end)
	action("CLOSE · P", 4, function()
		visibility(false)
	end)
	response.OnClientEvent:Connect(function(ok, text, cost, actionName, slot)
		if actionName ~= "Apply" then
			message(text, ok)
			return
		end
		if slot ~= applyingSlot then
			return
		end
		if ok then
			equipped[slot] = applyingDraft
			refreshBar()
		end
		applying = false
		message(text, ok)
		if ok and appliedRevision == revision then
			dirty = false
		end
		if ok and pendingCast then
			pendingCast = false
			task.delay(0.12, function()
				cast(slot)
			end)
		else
			pendingCast = false
		end
	end)
	remotes:WaitForChild("ActionFeedback").OnClientEvent:Connect(function(data)
		if data.Kind == "Magic" then
			message(
				(data.Result or "")
					.. " · "
					.. (data.Reason or data.Name or "")
					.. (data.Damage and (" damage " .. data.Damage) or ""),
				data.Result ~= "IMPOSSIBLE"
			)
		end
	end)
	UIS.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.P and not UIS:GetFocusedTextBox() then
			visibility(not panel.Visible)
		end
	end)
	local slotKeys = {
		Enum.KeyCode.One,
		Enum.KeyCode.Two,
		Enum.KeyCode.Three,
		Enum.KeyCode.Four,
		Enum.KeyCode.Five,
		Enum.KeyCode.Six,
		Enum.KeyCode.Seven,
		Enum.KeyCode.Eight,
		Enum.KeyCode.Nine,
	}
	for slot, key in slotKeys do
		ContextActionService:BindActionAtPriority("MagicLabSlot" .. slot, function(_, state)
			if UIS:GetFocusedTextBox() then
				return Enum.ContextActionResult.Pass
			end
			if state == Enum.UserInputState.Begin and player:GetAttribute("OpeningComplete") then
				cast(slot)
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value + 1, key)
	end
	player.CharacterRemoving:Connect(function()
		visibility(false)
		drawFolder:ClearAllChildren()
		pendingCast = false
	end)
	rebuild()
	estimate()
end
return Lab
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">MagicPresentationController</string>
              <string name="Source"><![CDATA[--!strict
-- Post-Animator procedural overlays for Motor6D and AnimationConstraint rigs.
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.MagicPresentation)
local Protocol = require(Shared.Networking.Protocol)
local Controller = {}
local started = false
local Rig = require(Shared.Modules.MagicRig)
local function angles(profile, role, releasing)
	if not releasing then
		local ground = profile == "GroundCast"
		local beam = profile == "BeamCast"
		local self = profile == "SelfCast"
		if role == "Torso" then
			return if ground then -12 else -6, if self then 4 else 0, 0
		end
		if role == "Neck" then
			return if ground then 8 else 3, 0, 0
		end
		if role == "RightArm" then
			return if ground then 18 elseif beam then 58 elseif self then 52 else 38, 0, 10
		end
		if role == "LeftArm" then
			return if ground then 18 elseif beam then 58 elseif self then 52 else 28, 0, -10
		end
		return if ground then 58 else 42, 0, 0
	end
	local beam = profile == "BeamCast"
	local ground = profile == "GroundCast"
	local self = profile == "SelfCast"
	if role == "Torso" then
		return if ground then -30 elseif self then 5 else -8, if beam or ground or self then 0 else -14, 0
	elseif role == "Neck" then
		return if ground then 12 else 5, 0, 0
	elseif role == "RightArm" then
		return if beam then 105 elseif ground then -35 elseif self then 82 else 115, 0, if self then 30 else 8
	elseif role == "LeftArm" then
		return if beam then 105 elseif ground then -25 elseif self then 82 else 35, 0, if self then -30 else -12
	else
		return if self then 55 elseif ground then 20 else 30, 0, 0
	end
end
function Controller.start()
	if started then
		return
	end
	started = true
	local casts = {}
	local applied = {}
	local warned = setmetatable({}, { __mode = "k" })
	local function restoreTransforms()
		for joint, previous in applied do
			if joint.Parent and joint.Transform == previous.Output then
				joint.Transform = previous.Base
			end
		end
		table.clear(applied)
	end
	RunService.PreAnimation:Connect(restoreTransforms)
	local function restore(character)
		local cast = casts[character]
		if cast then
			for _, entry in cast.Joints do
				local previous = applied[entry.Joint]
				if previous and entry.Joint.Parent and entry.Joint.Transform == previous.Output then
					entry.Joint.Transform = previous.Base
				end
				applied[entry.Joint] = nil
			end
		end
		casts[character] = nil
	end
	Shared:WaitForChild(Protocol.Folder)
		:WaitForChild("MagicPresentation").OnClientEvent
		:Connect(function(character, profile, phase, duration, gather)
			if typeof(character) ~= "Instance" or not character:IsA("Model") then
				return
			end
			if phase == "Cancel" then
				restore(character)
				return
			end
			if phase == "Release" then
				local existing = casts[character]
				if existing then
					existing.Phase = "Release"
					existing.Start = os.clock()
					existing.Duration = math.max(0.25, duration)
					existing.Gather = 0
				end
				return
			end
			local root = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local camera = workspace.CurrentCamera
			if
				not root
				or not humanoid
				or humanoid.Health <= 0
				or not camera
				or (root.Position - camera.CFrame.Position).Magnitude > Config.ObserverDistance
			then
				return
			end
			local count = 0
			for _ in casts do
				count += 1
			end
			if not casts[character] and count >= Config.MaxObservedCasts then
				return
			end
			restore(character)
			local joints = {}
			for _, joint in character:GetDescendants() do
				local entry = Rig.describe(joint)
				if entry then
					table.insert(joints, entry)
				end
			end
			character:SetAttribute("MagicPoseJointCount", #joints)
			character:SetAttribute("MagicPoseProfile", profile)
			if #joints == 0 and not warned[character] then
				warned[character] = true
				warn("Magic casting: no supported body joints found in " .. character.Name)
			end
			casts[character] = {
				Profile = profile,
				Phase = phase,
				Start = os.clock(),
				Duration = math.clamp(duration, 0.1, Config.MaxPoseDuration),
				Gather = math.clamp(gather or 0.1, 0.05, Config.MaxPoseDuration),
				Joints = joints,
			}
		end)
	RunService.PreSimulation:Connect(function()
		local now = os.clock()
		for character, cast in casts do
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local elapsed = now - cast.Start
			local t = elapsed / cast.Duration
			local strength
			local releasing = cast.Phase == "Release"
			if cast.Phase == "Charge" then
				strength = 0.88
			elseif releasing then
				strength = math.min(elapsed / 0.12, 1) * math.min((cast.Duration - elapsed) / 0.2, 1)
				strength = strength * strength * (3 - 2 * strength)
			elseif elapsed < cast.Gather then
				local rise = math.min(elapsed / 0.22, 1)
				strength = 0.82 * rise * rise * (3 - 2 * rise)
			else
				strength = 0.82 * math.min((cast.Duration - elapsed) / 0.2, 1)
			end
			if
				not character:IsDescendantOf(workspace)
				or not humanoid
				or humanoid.Health <= 0
				or (cast.Phase ~= "Charge" and t >= 1)
			then
				restore(character)
				continue
			end
			local strength = Rig.strength(t)
			for _, entry in cast.Joints do
				if not entry.Joint.Parent then
					continue
				end
				local x, y, z = angles(cast.Profile, entry.Role, releasing)
				-- Rotate in the parent body's axes, not the differently oriented R6/R15 joint axes.
				local offset = CFrame.Angles(math.rad(x) * strength, math.rad(y) * strength, math.rad(z) * strength)
				local frame = entry.Frame.Rotation
				local localOffset = frame:Inverse() * offset * frame
				local base = entry.Joint.Transform
				local output = localOffset * base
				applied[entry.Joint] = { Base = base, Output = output }
				entry.Joint.Transform = output
			end
		end
	end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox")).Movement
local Protocol = require(Shared:WaitForChild("Networking"):WaitForChild("Protocol"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local Speed = require(Shared.Modules.MovementSpeed)
local Movement = {}

function Movement.start(send: (string, Types.ActionOptions?) -> number)
	local player = Players.LocalPlayer
	local readyAt = 0
	local sprinting = false
	local dashSequence = 0
	local sprintSequence = 0
	local stopDash: (() -> ())? = nil
	local speedConnection: RBXScriptConnection? = nil
	local multiplierConnection: RBXScriptConnection? = nil

	local function applyPredictedSpeed()
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		if humanoid and humanoid.Health > 0 then
			local bonus = character:GetAttribute("MagicWalkSpeedBonus")
			local multiplier = character:GetAttribute("MagicSpeedMultiplier")
			humanoid.WalkSpeed = Speed.calculate(
				Config.WalkSpeed,
				Config.SprintSpeed,
				sprinting,
				if typeof(bonus) == "number" then bonus else 0,
				if typeof(multiplier) == "number" then multiplier else 1
			)
		end
	end

	local function bindCharacter(character: Model)
		if multiplierConnection then
			multiplierConnection:Disconnect()
		end
		if speedConnection then
			speedConnection:Disconnect()
		end
		speedConnection = character:GetAttributeChangedSignal("MagicWalkSpeedBonus"):Connect(applyPredictedSpeed)
		multiplierConnection = character:GetAttributeChangedSignal("MagicSpeedMultiplier"):Connect(applyPredictedSpeed)
		applyPredictedSpeed()
	end
	player.CharacterAdded:Connect(bindCharacter)
	if player.Character then
		bindCharacter(player.Character)
	end

	local function cancel()
		if stopDash then
			stopDash()
		end
	end

	local function sprint(enabled: boolean)
		if sprinting == enabled then
			return
		end
		sprinting = enabled
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		if humanoid and humanoid.Health > 0 then
			applyPredictedSpeed()
			sprintSequence = send(Protocol.Sprint, { Sprinting = enabled })
		end
	end

	local function dash(): boolean
		local now = workspace:GetServerTimeNow()
		if now < readyAt or stopDash then
			return false
		end
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if not character or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
			return false
		end
		local move = humanoid.MoveDirection
		local direction = Vector3.new(move.X, 0, move.Z)
		if direction.Magnitude < Config.DirectionEpsilon then
			local facing = root.CFrame.LookVector
			direction = Vector3.new(facing.X, 0, facing.Z)
		end
		if direction.Magnitude < Config.DirectionEpsilon then
			return false
		end
		direction = direction.Unit
		readyAt = now + Config.DashCooldown
		local attachment = Instance.new("Attachment")
		attachment.Name = "PredictedDashAttachment"
		attachment.Parent = root
		local velocity = Instance.new("LinearVelocity")
		velocity.Name = "PredictedDashVelocity"
		velocity.Attachment0 = attachment
		velocity.RelativeTo = Enum.ActuatorRelativeTo.World
		velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		velocity.PrimaryTangentAxis = Vector3.xAxis
		velocity.SecondaryTangentAxis = Vector3.zAxis
		velocity.ForceLimitsEnabled = false
		local speed = Config.DashDistance / Config.DashDuration
		velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * speed
		velocity.Parent = root
		local rotate = humanoid.AutoRotate
		humanoid.AutoRotate = false
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		params.RespectCanCollide = true
		local connection: RBXScriptConnection? = nil
		stopDash = function()
			if connection then
				connection:Disconnect()
			end
			velocity:Destroy()
			attachment:Destroy()
			humanoid.AutoRotate = rotate
			stopDash = nil
		end
		connection = RunService.PreSimulation:Connect(function(dt)
			if player.Character ~= character or humanoid.Health <= 0 or not root.Parent then
				cancel()
				return
			end
			if workspace:GetServerTimeNow() >= now + Config.DashDuration then
				cancel()
				local normal = humanoid.MoveDirection * humanoid.WalkSpeed
				root.AssemblyLinearVelocity = Vector3.new(normal.X, root.AssemblyLinearVelocity.Y, normal.Z)
				return
			end
			local result = workspace:Blockcast(
				root.CFrame,
				Config.DashCollisionSize,
				direction * (speed * dt + Config.WallPadding),
				params
			)
			if result then
				cancel()
				root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
			end
		end)
		-- Prediction is already active before the request leaves the client.
		dashSequence = send(Protocol.Dash, { Direction = direction })
		return true
	end

	return {
		Sprint = sprint,
		Dash = dash,
		Cancel = cancel,
		IsDashing = function(): boolean
			return stopDash ~= nil
		end,
		GetCooldown = function(): number
			return math.max(0, readyAt - workspace:GetServerTimeNow())
		end,
		Reset = function()
			cancel()
			readyAt = 0
			sprinting = false
			dashSequence = 0
			sprintSequence = 0
		end,
		Feedback = function(message: any)
			if message.Kind == "Correction" then
				cancel()
			end
			if message.Kind ~= "Action" then
				return
			end
			if message.Action == Protocol.Dash and message.Sequence == dashSequence then
				readyAt = message.DashReadyAt
				if not message.Accepted then
					local wasDashing = stopDash ~= nil
					cancel()
					local character = player.Character
					local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
					if wasDashing and root and root:IsA("BasePart") then
						root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
					end
				end
			elseif message.Action == Protocol.Sprint and message.Sequence == sprintSequence then
				-- Apply only the latest sprint acknowledgement.
				sprinting = message.Sprinting
				applyPredictedSpeed()
			end
		end,
	}
end

export type Controller = typeof(Movement.start(function()
	return 0
end))
return Movement
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">NavigationController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Topology = require(Shared.Configuration.PhaseATopology)
local Locations = require(Shared.Configuration.AssignmentLocations)
local Navigation = require(Shared.Configuration.Navigation)

local Controller = {}
function Controller.start()
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = "DistrictNavigation"
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local compass = Instance.new("TextLabel")
	compass.Size = UDim2.fromOffset(300, 28)
	compass.Position = UDim2.new(0.5, -150, 0, 92)
	compass.BackgroundTransparency = 0.35
	compass.TextColor3 = Color3.new(1, 1, 1)
	compass.Font = Enum.Font.GothamBold
	compass.Parent = gui
	local map = Instance.new("Frame")
	map.Size = UDim2.fromOffset(520, 520)
	map.Position = UDim2.new(0.5, -260, 0.5, -260)
	map.BackgroundColor3 = Color3.fromRGB(15, 18, 21)
	map.Visible = false
	map.Parent = gui
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromOffset(520, 28)
	title.BackgroundTransparency = 1
	title.Text = "LOWER LAYER — PHASE A  |  M to close"
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Parent = map
	local minX, maxX, minZ, maxZ = -700, 700, 300, 1800
	local function point(position: Vector3, color: Color3, size: number)
		local p = Instance.new("Frame")
		p.Size = UDim2.fromOffset(size, size)
		p.BackgroundColor3 = color
		p.BorderSizePixel = 0
		p.Position = UDim2.fromScale((position.X - minX) / (maxX - minX), (position.Z - minZ) / (maxZ - minZ))
		p.Parent = map
		return p
	end
	local function route(points)
		for i = 2, #points do
			local a, b = points[i - 1], points[i]
			if a and b and a.Y >= 0 and b.Y >= 0 then
				local dx, dz = (b.X - a.X) * 520 / (maxX - minX), (b.Z - a.Z) * 520 / (maxZ - minZ)
				local line = point((a + b) / 2, Navigation.Map.SurfaceColor, 2)
				line.AnchorPoint = Vector2.new(0.5, 0.5)
				line.Size = UDim2.fromOffset(math.max(2, math.sqrt(dx * dx + dz * dz)), 2)
				line.Rotation = math.deg(math.atan2(dz, dx))
			end
		end
	end
	for _, edge in ipairs(Topology.Edges) do
		route(edge.Points or { Topology.Nodes[edge[1]], Topology.Nodes[edge[2]] })
	end
	for _, branch in ipairs(Topology.Hive.Branches) do
		local points = {}
		for _, p in ipairs(branch) do
			table.insert(points, Vector3.new(p[1], p[2], p[3]))
		end
		route(points)
	end
	for _, location in Locations do
		local marker = point(location.Position, Color3.fromRGB(255, 220, 100), 8)
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromOffset(100, 16)
		text.Position = UDim2.fromOffset(5, -4)
		text.BackgroundTransparency = 1
		text.Text = location.Name
		text.TextSize = 10
		text.TextColor3 = Color3.new(1, 1, 1)
		text.Parent = marker
	end
	local playerDot = point(Vector3.zero, Color3.fromRGB(100, 220, 255), 10)
	local objectiveDot = point(Vector3.zero, Color3.fromRGB(255, 100, 80), 10)
	objectiveDot.Visible = false
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.M then
			map.Visible = not map.Visible
		end
	end)
	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not camera or not root or not root:IsA("BasePart") then
			return
		end
		local look = camera.CFrame.LookVector
		local heading = math.atan2(-look.X, -look.Z)
		local labels = { "N", "E", "S", "W" }
		local index = (math.floor((heading + math.pi / 4) / (math.pi / 2)) % 4) + 1
		local objective = if player:GetAttribute("AssignmentId") and player:GetAttribute("AssignmentId") ~= ""
			then Locations[player:GetAttribute("AssignmentLocation") or ""]
			else nil
		local suffix = ""
		objectiveDot.Visible = objective ~= nil
		if objective then
			local delta = objective.Position - root.Position
			suffix = string.format("  •  %ds", delta.Magnitude)
			if math.abs(delta.Y) > Navigation.Compass.ObjectiveVerticalThreshold then
				suffix ..= (if delta.Y > 0 then " ↑" else " ↓")
			end
			objectiveDot.Position = UDim2.fromScale(
				(objective.Position.X - minX) / (maxX - minX),
				(objective.Position.Z - minZ) / (maxZ - minZ)
			)
		end
		compass.Text = string.format(
			"%s   %s   %s   %s%s",
			labels[index],
			labels[index % 4 + 1],
			labels[(index + 1) % 4 + 1],
			labels[(index + 2) % 4 + 1],
			suffix
		)
		playerDot.Position =
			UDim2.fromScale((root.Position.X - minX) / (maxX - minX), (root.Position.Z - minZ) / (maxZ - minZ))
	end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">OpeningController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.CityLife)
local Opening = {}
function Opening.start(remotes)
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.DisplayOrder = "LowerLayerOpening", false, 20
	gui.Parent = player:WaitForChild("PlayerGui")
	local frame = Instance.new("Frame")
	frame.AnchorPoint, frame.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
	frame.Size, frame.BackgroundColor3 = UDim2.fromScale(0.8, 0.65), Color3.fromRGB(26, 25, 23)
	frame.Parent = gui
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize, limit.Parent = Vector2.new(580, 400), frame
	local text = Instance.new("TextLabel")
	text.Size, text.Position = UDim2.fromScale(0.9, 0.53), UDim2.fromScale(0.05, 0.03)
	text.BackgroundTransparency, text.TextWrapped = 1, true
	text.TextColor3, text.TextSize, text.Font = Color3.fromRGB(226, 216, 196), 19, Enum.Font.Gotham
	text.Text =
		"You wake without a name.\n\nBeyond the room, workers and watchmen pass beneath stone no human laid. A settlement lives inside this ancient structure. The Enfleshed are a familiar danger here.\n\nA spare weapon waits beside you. Which feels familiar?"
	text.Parent = frame
	local function button(y, caption, callback)
		local b = Instance.new("TextButton")
		b.Position, b.Size = UDim2.fromScale(0.05, y), UDim2.fromScale(0.9, 0.11)
		b.Text, b.TextSize, b.Font = caption, 17, Enum.Font.Gotham
		b.TextColor3, b.BackgroundColor3, b.Modal = text.TextColor3, Color3.fromRGB(65, 60, 50), true
		b.Parent = frame
		b.Activated:Connect(callback)
		return b
	end
	local preset = 1
	local appearance
	appearance = button(0.58, "Appearance: " .. Config.Presets[preset].Name, function()
		preset = preset % #Config.Presets + 1
		appearance.Text = "Appearance: " .. Config.Presets[preset].Name
	end)
	local remote = remotes:WaitForChild("OpeningChoice")
	local function choose(path)
		if player:GetAttribute("CharacterReady") then
			remote:FireServer(preset, path)
		end
	end
	button(0.72, "Take the melee weapon", function()
		choose("Melee")
	end)
	button(0.85, "Take the recruit magic weapon", function()
		choose("Magic")
	end)
	local function refresh()
		gui.Enabled = player:GetAttribute("OpeningComplete") ~= true
	end
	player:GetAttributeChangedSignal("OpeningComplete"):Connect(refresh)
	refresh()
end
return Opening
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">WorldEventController</string>
              <string name="Source"><![CDATA[--!strict
-- Nearby text only. No global markers, acceptance button or client outcome requests.
local HUD = {}
function HUD.start()
	local player = game:GetService("Players").LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn = "NearbyWorldEvent", false
	gui.Parent = player:WaitForChild("PlayerGui")
	local label = Instance.new("TextLabel")
	label.AnchorPoint, label.Position = Vector2.new(0.5, 1), UDim2.fromScale(0.5, 0.88)
	label.Size, label.BackgroundTransparency = UDim2.fromOffset(410, 66), 0.25
	label.BackgroundColor3, label.TextColor3 = Color3.fromRGB(26, 25, 23), Color3.fromRGB(229, 217, 191)
	label.TextWrapped, label.TextSize, label.Font = true, 16, Enum.Font.Gotham
	label.Parent = gui
	local notice, untilTime = "", 0
	local function update()
		local event = player:GetAttribute("NearbyWorldEvent") or ""
		label.Text = if os.clock() < untilTime then notice else event
		gui.Enabled = player:GetAttribute("OpeningComplete") == true and label.Text ~= ""
	end
	for _, attribute in { "NearbyWorldEvent", "OpeningComplete" } do
		player:GetAttributeChangedSignal(attribute):Connect(update)
	end
	for _, attribute in { "EventRewardNotice", "CityRemark" } do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			notice = player:GetAttribute(attribute) or ""
			untilTime = os.clock() + 5
			update()
			task.delay(5, update)
		end)
	end
	update()
end
return HUD
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
