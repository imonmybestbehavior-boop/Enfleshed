      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Types</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">CombatTypes</string>
            <string name="Source"><![CDATA[--!strict

export type Attack = {
	Startup: number,
	Active: number,
	Recovery: number,
	Damage: number,
	Size: Vector3,
	Offset: number,
	Reach: number,
}

export type ActionOptions = {
	Sprinting: boolean?,
	Direction: Vector3?,
	SpellId: string?,
	AimDirection: Vector3?,
	WorldPoint: Vector3?,
	CastOrigin: Vector3?,
	EquipmentSlot: string?,
	EquipmentAction: string?,
}

export type ActionRequest = {
	Action: string,
	Sequence: number,
	Character: Model,
	Sprinting: boolean?,
	Direction: Vector3?,
	SpellId: string?,
	AimDirection: Vector3?,
	WorldPoint: Vector3?,
	CastOrigin: Vector3?,
	EquipmentSlot: string?,
	EquipmentAction: string?,
}

export type HitResult = { Target: Model, Damage: number, Health: number }

-- Type information only: the actual state is created and retained exclusively on the server.
export type PlayerState = {
	Character: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Sprinting: boolean,
	MagicWalkSpeedBonus: number,
	MagicSpeedMultiplier: number,
	MagicPreviousMultiplier: number?,
	MagicSpeedGraceUntil: number?,
	MagicJumpPowerBonus: number,
	DashUntil: number,
	DashReadyAt: number,
	DashOrigin: Vector3?,
	DashCheckUntil: number,
	LastPosition: Vector3,
	LastFramePosition: Vector3,
	LastCheck: number,
	DashAllowance: number,
	CorrectionUntil: number,
	SpawnGraceUntil: number,
	Combo: number,
	ReadyAt: number,
	ComboExpires: number,
	Attack: Attack?,
	ActiveAt: number,
	ActiveUntil: number,
	HitTargets: { [Humanoid]: boolean },
}

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">EquipmentTypes</string>
            <string name="Source"><![CDATA[--!strict

export type Slot = "PrimaryWeapon" | "SecondaryWeapon" | "Utility"

export type State = {
	PrimaryWeapon: string?,
	SecondaryWeapon: string?,
	Utility: string?,
	ActiveSlot: Slot,
}

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">MagicTypes</string>
            <string name="Source"><![CDATA[--!strict

export type ValidationResult = "VALID" | "UNSAFE" | "IMPOSSIBLE"

export type CastIntent = {
	SpellId: string,
	AimDirection: Vector3,
	WorldPoint: Vector3?,
}

export type ActiveSpell = {
	SpellId: string,
	Caster: Model,
	Age: number,
	CurrentPhase: string,
	TargetsHit: { [Humanoid]: boolean },
	RemainingLifetime: number,
}

export type Payload = {
	Kind: string,
	Duration: number?,
	Interval: number?,
	Amount: number?,
	Magnitude: number?,
	Upward: number?,
	SpeedMultiplier: number?,
	WalkSpeedBonus: number?,
	JumpPowerBonus: number?,
	Operation: string?,
	Distance: number?,
}
export type TriggerStep = { Behavior: string?, Radius: number?, Payloads: { Payload } }
export type SpellSpec = {
	SpellId: string,
	Name: string,
	Version: number,
	Tags: { string },
	Element: string,
	Source: { Principle: string, Expression: string },
	Form: string,
	Targeting: string,
	Geometry: string,
	Motion: string,
	TargetRules: { Range: number, MaxTargets: number, RequiresLineOfSight: boolean },
	Conditions: { string },
	Casting: {
		Mode: string,
		Cooldown: number,
		CastTime: number,
		RecoveryTime: number,
		MinimumCharge: number?,
		MaximumCharge: number?,
	},
	Lifetime: { Mode: string, Duration: number? },
	Cost: { ManaDemand: number, Strain: number, Complexity: number },
	Triggers: { [string]: { TriggerStep } },
	Visual: { Color: Color3, Profile: string? },
	Projectile: { Speed: number, Radius: number, MaxDistance: number, Gravity: number, Acceleration: number }?,
	Beam: { Range: number, Width: number, DebugDuration: number }?,
	Field: { Radius: number, Interval: number, DebugHeight: number }?,
	Wave: { Range: number, Dot: number, DebugDuration: number }?,
	Aura: { Radius: number, Interval: number }?,
	Construct: { Width: number, Height: number, Depth: number, Distance: number }?,
	Material: { Material: string, Amount: number?, SearchRadius: number }?,
}
return {}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Utilities</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="36">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="37">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Isolated traversal harness: uses existing movement/combat/AI without city startup.
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local corpseLifetime = 2
local Runtime = require(script.Services.EnemyRuntime)
Runtime.start()
require(script.Networking.ActionRouter).start()

local folder = Instance.new("Folder")
folder.Name = "KitDistrictChaseTest"
folder.Parent = workspace
local handles: { any } = {}
local mode, lastUse = 0, -math.huge
local candidates = require(script.SpawnPoints)
local counts = { 5, 10, 20, 0 }

local console = Instance.new("Part")
console.Name = "ChaseTestSwitch"
console.Anchored = true
console.CanCollide = false
console.CanQuery = false
console.Size = Vector3.new(1, 2, 0.5)
console.Position = Vector3.new(5, 3, 15)
console.Color = Color3.fromRGB(189, 146, 73)
console.Parent = folder
local prompt = Instance.new("ProximityPrompt")
prompt.ObjectText = "DISTRICT — OPTIONAL STRESS TEST"
prompt.ActionText = "Start 5 Nascent"
prompt.KeyboardKeyCode = Enum.KeyCode.F
prompt.MaxActivationDistance = 10
prompt.RequiresLineOfSight = false
prompt.HoldDuration = 0.3
prompt.Parent = console

local function clear()
	for _, handle in handles do
		handle.Destroy()
	end
	table.clear(handles)
	for _, child in folder:GetChildren() do
		if child:IsA("Model") then
			child:Destroy()
		end
	end
	folder:SetAttribute("Living", 0)
	folder:SetAttribute("Requested", 0)
end

-- EnemyRuntime retires dead AI handles but intentionally leaves corpse ownership
-- to its caller. Debris also covers a clear/restart while removal is pending.
local cleanupElapsed = 0
RunService.Heartbeat:Connect(function(delta)
	cleanupElapsed += delta
	if cleanupElapsed < 0.2 then
		return
	end
	cleanupElapsed = 0
	for i = #handles, 1, -1 do
		local handle = handles[i]
		if not handle.Model.Parent or not handle.IsAlive() then
			table.remove(handles, i)
			if handle.Model.Parent then
				Debris:AddItem(handle.Model, corpseLifetime)
			end
		end
	end
	folder:SetAttribute("Living", #handles)
end)

prompt.Triggered:Connect(function(player: Player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if
		not root
		or not root:IsA("BasePart")
		or not humanoid
		or humanoid.Health <= 0
		or (root.Position - console.Position).Magnitude > 12
		or os.clock() - lastUse < 2
	then
		return
	end
	lastUse = os.clock()
	clear()
	mode = (mode % #counts) + 1
	local count = counts[mode]
	folder:SetAttribute("Requested", count)
	local accepted: { Vector3 } = {}
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.KitDistrict }
	params.RespectCanCollide = true
	for i, candidate in candidates do
		if #handles >= count then
			break
		end
		local hit = workspace:Raycast(candidate, Vector3.new(0, -16, 0), params)
		if not hit or hit.Normal.Y < 0.9 then
			warn("KitDistrict: no safe ground at chase spawn " .. i)
			continue
		end
		local position = hit.Position + Vector3.new(0, 4.5, 0)
		local clearOfPlayers = true
		for _, other in Players:GetPlayers() do
			local otherRoot = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
			if otherRoot and otherRoot:IsA("BasePart") and (otherRoot.Position - position).Magnitude < 8 then
				clearOfPlayers = false
			end
		end
		for _, occupied in accepted do
			if (occupied - position).Magnitude < 7 then
				clearOfPlayers = false
				break
			end
		end
		local overlap = OverlapParams.new()
		overlap.FilterType = Enum.RaycastFilterType.Include
		overlap.FilterDescendantsInstances = { workspace.KitDistrict }
		overlap.RespectCanCollide = true
		local blockers =
			workspace:GetPartBoundsInBox(CFrame.new(hit.Position + Vector3.new(0, 5, 0)), Vector3.new(4, 8, 4), overlap)
		if clearOfPlayers and #blockers == 0 then
			table.insert(handles, Runtime.create(position, folder))
			table.insert(accepted, position)
		end
	end
	local nextCount = counts[(mode % #counts) + 1]
	prompt.ActionText = if nextCount == 0 then "Clear enemies" else "Restart with " .. nextCount .. " Nascent"
	folder:SetAttribute("Spawned", #handles)
end)
Players.PlayerRemoving:Connect(function()
	if #Players:GetPlayers() <= 1 then
		clear()
		mode = 0
		prompt.ActionText = "Start 5 Nascent"
	end
end)
print("KitDistrict ready: explore first; use F at the brass switch beside spawn for an optional chase.")
]]></string>
      </Properties>
      <Item class="Folder" referent="38">
        <Properties>
          <string name="Name">Development</string>
        </Properties>
        <Item class="Folder" referent="39">
          <Properties>
            <string name="Name">LowerLayer</string>
          </Properties>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">BuildContext</string>
              <string name="Source"><![CDATA[--!strict

local Lighting = game:GetService("Lighting")
local BuildContext = {}
BuildContext.__index = BuildContext

function BuildContext.new(config: any): any
	local root = Instance.new("Folder")
	root.Name = "LowerLayerGraybox"
	root.Parent = workspace
	local groups: { [string]: Instance } = {}
	for _, name in
		{ "Ancient", "Human", "Military", "Frontline", "Contamination", "Navigation", "SpawnPoints", "Debug" }
	do
		local group = Instance.new("Folder")
		group.Name = name
		group.Parent = root
		groups[name] = group
	end
	-- Only the six distant enclosure surfaces must survive streaming. Detailed
	-- buildings, streets and ancient ribs continue to stream normally.
	local enclosure = Instance.new("Model")
	enclosure.Name = "Enclosure"
	enclosure.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	enclosure.Parent = root
	groups.Enclosure = enclosure
	return setmetatable({ Config = config, Root = root, Groups = groups, PartCount = 0 }, BuildContext)
end

function BuildContext:part(
	group: string,
	name: string,
	position: Vector3,
	size: Vector3,
	color: Color3,
	collide: boolean?
): Part
	self.PartCount += 1
	local result = Instance.new("Part")
	result.Name, result.Anchored, result.Position, result.Size = name, true, position, size
	result.Color, result.Material = color, Enum.Material.Concrete
	result.CanCollide, result.CanTouch = collide ~= false, false
	result.Parent = self.Groups[group]
	return result
end

function BuildContext:floor(group: string, name: string, position: Vector3, size: Vector3, color: Color3): Part
	local support = self:part(
		"Navigation",
		name .. "Support",
		position - Vector3.new(0, 0.65, 0),
		size + Vector3.new(1, 0.8, 1),
		self.Config.Colors.AncientDark
	)
	support.Transparency = 0.97
	return self:part(group, name, position, size, color, false)
end

function BuildContext:marker(name: string, position: Vector3)
	local result = self:part("SpawnPoints", name, position, Vector3.new(4, 0.2, 4), self.Config.Colors.Light, false)
	result.Material, result.Transparency = Enum.Material.Neon, 0.4
	result:SetAttribute("GrayboxMarker", true)
end

function BuildContext:lamp(position: Vector3, range: number, brightness: number?, shadows: boolean?)
	local fixture =
		self:part("Human", "PracticalLamp", position, Vector3.new(0.6, 1, 0.6), self.Config.Colors.Light, false)
	fixture.Material = Enum.Material.Neon
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = self.Config.Colors.Light, range, brightness or 1.2
	light.Shadows = shadows == true
	light.Parent = fixture
end

function BuildContext:finish()
	self.Root:SetAttribute("PartCount", self.PartCount)
	self.Root:SetAttribute("Phase", "A")
	Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(12, 13, 18), Color3.fromRGB(20, 20, 28)
	Lighting.FogColor = Color3.fromRGB(22, 24, 30)
	Lighting.FogStart, Lighting.FogEnd = 220, 900
end

return BuildContext
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Builders</string>
              <string name="Source"><![CDATA[--!strict

local Builders = {}

function Builders.street(ctx: any, name: string, position: Vector3, size: Vector3, color: Color3)
	ctx:floor("Human", name, position, size, color)
	for offset = -size.Z / 2 + 30, size.Z / 2 - 10, 60 do
		ctx:lamp(position + Vector3.new(-size.X / 2 + 4, 8, offset), 28)
	end
end

function Builders.partial(ctx: any, name: string, position: Vector3, size: Vector3)
	local c = ctx.Config.Colors
	ctx:floor("Human", name .. "Apron", position, Vector3.new(size.X, 0.3, size.Z), c.HumanDark)
	for floor = 0, 2 do
		local y = floor * 10 + 5
		ctx:part(
			"Human",
			name .. "Frontage",
			position + Vector3.new(0, y, -size.Z / 2 + 2),
			Vector3.new(size.X, 10, 4),
			if floor % 2 == 0 then c.HumanDark else c.Human
		)
		ctx:part(
			"Human",
			name .. "RearMass",
			position + Vector3.new(0, y, size.Z / 2 - 3),
			Vector3.new(size.X, 10, 6),
			c.HumanDark
		)
		ctx:part(
			"Human",
			name .. "SideWing",
			position + Vector3.new(size.X / 2 - 3, y, 0),
			Vector3.new(6, 10, size.Z - 8),
			c.Human
		)
		ctx:part(
			"Human",
			name .. "UpperSlab",
			position + Vector3.new(0, y + 5, 0),
			Vector3.new(size.X - 10, 1, size.Z - 12),
			c.HumanDark,
			false
		)
	end
	ctx:part(
		"Human",
		name .. "RoofAddition",
		position + Vector3.new(-size.X * 0.2, 36, size.Z * 0.15),
		Vector3.new(size.X * 0.55, 8, size.Z * 0.45),
		c.Human
	)
	ctx:part(
		"Human",
		name .. "Balcony",
		position + Vector3.new(-size.X * 0.25, 18, -size.Z / 2 - 2),
		Vector3.new(size.X * 0.35, 1, 8),
		c.Human,
		false
	)
end

function Builders.throughBuilding(
	ctx: any,
	name: string,
	position: Vector3,
	width: number,
	depth: number,
	upper: boolean
)
	local c = ctx.Config.Colors
	ctx:floor("Human", name .. "InteriorFloor", position, Vector3.new(width, 0.35, depth), c.Human)
	for _, x in { -width / 2 + 2, width / 2 - 2 } do
		ctx:part("Human", name .. "SideWall", position + Vector3.new(x, 8, 0), Vector3.new(4, 16, depth), c.HumanDark)
	end
	ctx:part(
		"Human",
		name .. "InteriorDivider",
		position + Vector3.new(0, 5, 0),
		Vector3.new(width - 10, 10, 2),
		c.HumanDark
	)
	ctx:part(
		"Human",
		name .. "FrontFrameLeft",
		position + Vector3.new(-width / 2 + 5, 7, -depth / 2),
		Vector3.new(4, 14, 3),
		c.HumanDark
	)
	ctx:part(
		"Human",
		name .. "FrontFrameRight",
		position + Vector3.new(width / 2 - 5, 7, -depth / 2),
		Vector3.new(4, 14, 3),
		c.HumanDark
	)
	if upper then
		local y = ctx.Config.Metrics.UpperRouteHeight
		ctx:floor(
			"Human",
			name .. "UpperFloor",
			position + Vector3.new(0, y, 0),
			Vector3.new(width - 8, 0.35, depth * 0.55),
			c.HumanDark
		)
		for step = 0, 32 do
			ctx:floor(
				"Human",
				name .. "Stair",
				position + Vector3.new(-width / 2 + 8, step * 2.25, -depth / 2 + 8 + step * 0.9),
				Vector3.new(10, 0.5, 8),
				c.Human
			)
		end
	end
end

function Builders.ancient(ctx: any, name: string, position: Vector3, size: Vector3)
	return ctx:part("Ancient", name, position, size, ctx.Config.Colors.Ancient)
end

return Builders
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">BuildingCirculation</string>
              <string name="Source"><![CDATA[--!strict
-- Shared stairs, cross-property halls and two inter-building circulation tiers.
-- Pure geometry, consumed identically by Studio assembly and offline validation.
local Circulation = {}
function Circulation.position(a, x, y, z)
	local angle = math.rad(a.Yaw)
	local c, s = math.floor(math.cos(angle) + 0.5), math.floor(math.sin(angle) + 0.5)
	return a.X + c * x + s * z, y, a.Z - s * x + c * z
end
function Circulation.removeSourcePart(name, y)
	return name == "RoomShadow"
		or name == "ClosedInnerResidentialDoor"
		or name == "EntryHallRear"
		or name == "InnerDoorFrame"
		or name == "InnerDoorHeader"
		or (name == "ApartmentFloor" and (y == 36 or y == 52 or y == 68))
		or name == "FloorSlab_33"
		or name == "FloorSlab_65"
		or name == "FloorSlab_49"
end
function Circulation.build(data, plan, solid)
	local out = { Parts = {}, Cuts = {}, Samples = {}, Lights = {}, Links = data.Links, Buildings = data.Buildings }
	local walkCuts = {}
	local function box(name, x, y, z, w, h, d, color)
		local p = {
			Name = "Circulation_" .. name,
			X = x,
			Y = y,
			Z = z,
			W = w,
			H = h,
			D = d,
			Color = color or "HumanDark",
			Collision = true,
		}
		table.insert(out.Parts, p)
		return p
	end
	local function sample(name, x, y, z)
		table.insert(out.Samples, { Name = name, X = x, Y = y, Z = z })
	end
	local function segmentSamples(name, a, b, y)
		local steps = math.max(1, math.ceil((math.abs(a[1] - b[1]) + math.abs(a[2] - b[2])) / 2))
		for i = 0, steps do
			sample(name, a[1] + (b[1] - a[1]) * i / steps, y, a[2] + (b[2] - a[2]) * i / steps)
		end
	end
	for i, a in ipairs(data.Buildings) do
		local residential = a.Name == "Tenement"
		local base = residential and 4.5 or 0
		local half = residential and 46 or 54
		local function localBox(n, x, y, z, w, h, d, c)
			local xx, yy, zz = Circulation.position(a, x, y, z)
			local turn = a.Yaw == 90 or a.Yaw == -90
			return box(i .. "_" .. n, xx, yy, zz, turn and d or w, h, turn and w or d, c)
		end
		local function cut(x1, y1, z1, x2, y2, z2)
			local p = localBox("Cut", (x1 + x2) / 2, (y1 + y2) / 2, (z1 + z2) / 2, x2 - x1, y2 - y1, z2 - z1)
			table.remove(out.Parts)
			table.insert(out.Cuts, solid.bounds(p))
		end
		local function localSample(n, x, y, z)
			sample(i .. "_" .. n, Circulation.position(a, x, y, z))
		end
		local function localPath(n, x, z, xx, zz, y)
			local ax, _, az = Circulation.position(a, x, y, z)
			local bx, _, bz = Circulation.position(a, xx, y, zz)
			segmentSamples(i .. "_" .. n, { ax, az }, { bx, bz }, y)
			table.insert(walkCuts, {
				math.min(ax, bx) - 4,
				y + 0.01,
				math.min(az, bz) - 4,
				math.max(ax, bx) + 4,
				y + 12,
				math.max(az, bz) + 4,
			})
		end
		-- Shops remain distinct at the street but open into a shared back passage.
		-- Residential inner doors are removed; the two halls now feed a common stair.
		cut(-half + 2, base + 0.01, 12, half - 2, base + 12, 20)
		cut(-28, base + 0.01, 8, -18, base + 12, 30)
		cut(-18, base + 0.01, 7, 42, 80.5, 28)
		local doors = residential and { -23, 21 } or { -47, -2, 9, 47 }
		for _, door in ipairs(doors) do
			localPath("Entry", door, 8, door, 16, base)
			localPath("SharedGroundHall", door, 16, -23, 16, base)
		end
		localPath("StairApproach", -23, 16, -23, 23, base)
		localPath("StairApproach", -23, 23, -10, 23, base)
		-- Four compact flights: broad treads, supported returns, no precision jumps.
		local levels = { base, residential and 20.5 or 18, 36.5, 52.5, 68.5 }
		for flight = 1, 4 do
			local low, high = levels[flight], levels[flight + 1]
			local forward = flight % 2 == 1
			local z = forward and 23 or 11
			for step = 1, 28 do
				local x = forward and (-10 + (step - 0.5) * 1.5) or (32 - (step - 0.5) * 1.5)
				local top = low + (high - low) * step / 28
				localBox("StairTread", x, top - 0.4, z, 1.6, 0.8, 8, "Human")
				localSample("Stair", x, top, z)
				if step % 4 == 0 then
					local gx = forward and x - 2.25 or x + 2.25
					for _, side in ipairs({ -1, 1 }) do
						localBox("StairGuard", gx, top + 1.8, z + side * 4.25, 6.05, 3.6, 0.4, "Military")
					end
				end
			end
			local x = forward and 36.5 or -14
			localBox("ReturnLanding", x, high - 0.5, 17, forward and 9 or 8, 1, 20, "Human")
			localPath("Landing", forward and 32 or -10, z, x, z, high)
			localPath("Landing", x, 23, x, 11, high)
			localBox("WellFrontGuard", 7, high + 1.8, 6.9, 50, 3.6, 0.4, "Military")
			localBox("WellRearGuard", 12, high + 1.8, 28.2, 60, 3.6, 0.4, "Military")
			if forward then
				-- The half landings also open onto the existing intermediate-floor rooms.
				localPath("IntermediateRoom", 36.5, 11, 36.5, 4.5, high)
				if flight == 3 then
					localPath("UpperHall", 36.5, 4.5, -23, 4.5, high)
					localPath("UpperHall", -23, 4.5, -23, 30.5, high)
					localPath("SideExit", -23, 30.5, -half - 1, 30.5, high)
				end
			else
				localPath("UpperHall", -14, 11, -23, 11, high)
				localPath("UpperHall", -23, 11, -23, flight == 4 and 29 or 30.5, high)
				if flight == 2 then
					localPath("SideExit", -23, 30.5, -half - 1, 30.5, high)
				end
			end
		end
		-- Public upper floors connect rooms as well as the stair. Each floor has a
		-- generous stairwell opening; a side gallery leads to actual party-wall exits.
		for _, y in ipairs({ 36.5, 52.5, 68.5 }) do
			if y ~= 68.5 then
				cut(-half - 2, y - 0.51, 25.5, -18, y + 12, 36.5)
			end
			local floor = {
				Name = "UpperFloor",
				X = 0,
				Y = y - 0.5,
				Z = 17,
				W = 2 * half - 4,
				H = 1,
				D = 32,
				Color = "Human",
				Collision = true,
			}
			for _, p in ipairs(solid.parts(floor, { { -18, y - 1, 7, 42, y + 1, 28 } })) do
				localBox(p.Name, p.X, p.Y, p.Z, p.W, p.H, p.D, p.Color)
			end
			if y ~= 68.5 then
				localBox("SideGallery", (-half - 1 - 18) / 2, y - 0.5, 30.5, half - 17, 1, 10, "Human")
				localBox("GalleryRear", (-half - 1 - 18) / 2, y + 6, 35.5, half - 17, 12, 1)
			end
			-- Two real rooms beside the public gallery. Continuous partitions,
			-- framed openings and the existing outer walls enclose usable space.
			for _, span in ipairs({ { 2, 5 }, { 13, 18 }, { 26, 27 } }) do
				localBox("RoomPartition", -29, y + 5.5, (span[1] + span[2]) / 2, 1, 11, span[2] - span[1], "Human")
			end
			for _, doorZ in ipairs({ 9, 22 }) do
				localBox("RoomDoorHeader", -29, y + 10, doorZ, 1.4, 2, 8, "Military")
				localPath("RoomEntry", -23, doorZ, -half + 10, doorZ, y)
			end
			localBox("RoomDivider", (-half + 2 - 29) / 2, y + 5.5, 15.5, half - 31, 11, 1, "Human")
			localBox("RoomRearPartition", (-half + 2 - 29) / 2, y + 5.5, 27, half - 31, 11, 1, "Human")
			localBox("GalleryDoorHeader", -29, y + 10, 30.5, 1.4, 2, 7, "Military")
			localBox("GalleryGuard", -18.5, y + 1.8, 20, 1, 3.6, 12, "Military")
			local lx, ly, lz = Circulation.position(a, -23, y + 9, 30.5)
			table.insert(out.Lights, { X = lx, Y = ly, Z = lz })
		end
		local lx, ly, lz = Circulation.position(a, -23, base + 10, 16)
		table.insert(out.Lights, { X = lx, Y = ly, Z = lz })
	end
	-- Collect every passage's clear volume before constructing its walls. This
	-- makes shared junctions open; overlapping corridor modules cannot seal exits.
	local segments = {}
	for i, link in ipairs(data.Links) do
		for k = 2, #link.Points do
			local a, b = link.Points[k - 1], link.Points[k]
			local x, z = (a[1] + b[1]) / 2, (a[2] + b[2]) / 2
			local width = link.Widths and link.Widths[k - 1] or 10
			local w, d = math.abs(a[1] - b[1]) + width + 2, math.abs(a[2] - b[2]) + width + 2
			table.insert(out.Cuts, { x - w / 2, link.Y - 0.51, z - d / 2, x + w / 2, link.Y + 13, z + d / 2 })
			table.insert(
				walkCuts,
				{ x - (w - 2) / 2, link.Y + 0.01, z - (d - 2) / 2, x + (w - 2) / 2, link.Y + 12, z + (d - 2) / 2 }
			)
			table.insert(segments, {
				A = a,
				B = b,
				Y = link.Y,
				Id = i,
				Width = width,
				Space = link.Spaces and link.Spaces[k - 1] or "Service",
			})
			segmentSamples("Link_" .. i, a, b, link.Y)
		end
	end
	-- Where the new network crosses an old catwalk, retain access both ways.
	for _, edge in ipairs(plan.Edges) do
		if edge.Kind == "Catwalk" or edge.Kind == "RoofBridge" then
			local points = edge.Points or { plan.Nodes[edge[1]], plan.Nodes[edge[2]] }
			for k = 2, #points do
				local a, b = points[k - 1], points[k]
				table.insert(out.Cuts, {
					math.min(a.X, b.X) - edge.Width / 2,
					a.Y + 0.51,
					math.min(a.Z, b.Z) - edge.Width / 2,
					math.max(a.X, b.X) + edge.Width / 2,
					a.Y + 10,
					math.max(a.Z, b.Z) + edge.Width / 2,
				})
				table.insert(walkCuts, {
					math.min(a.X, b.X) - edge.Width / 2,
					a.Y + 0.01,
					math.min(a.Z, b.Z) - edge.Width / 2,
					math.max(a.X, b.X) + edge.Width / 2,
					a.Y + 10,
					math.max(a.Z, b.Z) + edge.Width / 2,
				})
			end
		end
	end
	local laidFloors = {}
	for _, s in ipairs(segments) do
		local a, b, y = s.A, s.B, s.Y
		local x, z = (a[1] + b[1]) / 2, (a[2] + b[2]) / 2
		local w, d = math.abs(a[1] - b[1]) + s.Width + 2, math.abs(a[2] - b[2]) + s.Width + 2
		local open = s.Space == "Balcony" or s.Space == "Bridge"
		laidFloors[y] = laidFloors[y] or {}
		local tile = { X = x, Y = y - 0.5, Z = z, W = w, H = 1, D = d }
		for _, piece in ipairs(solid.parts(tile, laidFloors[y])) do
			box("ConnectingFloor", piece.X, piece.Y, piece.Z, piece.W, 1, piece.D, "Human")
			if not open then
				box("ConnectingCeiling", piece.X, piece.Y + 13, piece.Z, piece.W, 1, piece.D)
			end
			table.insert(laidFloors[y], solid.bounds(piece))
		end
		for _, side in ipairs({ -1, 1 }) do
			local vertical = a[1] == b[1]
			local p = {
				Name = "PassageWall",
				X = x + (vertical and side * (s.Width / 2 + 0.5) or 0),
				Y = y + (open and 1.8 or 6),
				Z = z + (vertical and 0 or side * (s.Width / 2 + 0.5)),
				W = vertical and 1 or w,
				H = open and 3.6 or 12,
				D = vertical and d or 1,
				Color = "HumanDark",
				Collision = true,
			}
			for _, piece in ipairs(solid.parts(p, walkCuts)) do
				box(piece.Name, piece.X, piece.Y, piece.Z, piece.W, piece.H, piece.D, piece.Color)
			end
		end
		if math.abs(a[1] - b[1]) + math.abs(a[2] - b[2]) > 24 then
			table.insert(out.Lights, { X = x, Y = y + 10, Z = z })
		end
	end
	local finished = {}
	for _, p in ipairs(out.Parts) do
		if string.find(p.Name, "GalleryRear") then
			for _, piece in ipairs(solid.parts(p, walkCuts)) do
				table.insert(finished, piece)
			end
		else
			table.insert(finished, p)
		end
	end
	out.Parts = finished
	return out
end
return Circulation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">BuildingCirculationRuntime</string>
              <string name="Source"><![CDATA[--!strict
local Solid = require(script.Parent.SolidClipping)
local Layout = require(script.Parent.BuildingCirculation)
local Connections = require(script.Parent.BuildingConnections)
local Runtime = {}
function Runtime.apply(ctx, plan, placements)
	assert(#placements == #Connections.Buildings, "Rebuild building connections after changing placements")
	for i, entry in ipairs(placements) do
		local actual, expected = entry.Asset, Connections.Buildings[i]
		assert(
			actual.Name == expected.Name
				and actual.X == expected.X
				and actual.Z == expected.Z
				and actual.Yaw == expected.Yaw,
			"Stale building connections: run scripts/build_building_connections.py"
		)
		-- Retire sealed hallway doors and replace upper floor slabs with stair-ready floors.
		for _, part in ipairs(entry.Model:GetDescendants()) do
			if part:IsA("BasePart") and Layout.removeSourcePart(part.Name, part.Position.Y) then
				ctx.PartCount -= 1
				part:Destroy()
			end
		end
	end
	local layout = Layout.build(Connections, plan, Solid)
	local index = Solid.index(layout.Cuts)
	-- Cut both collision AND visible geometry. Old block masses are allowed to
	-- change wherever real circulation requires it; no invisible-wall shortcuts.
	for _, part in ipairs(ctx.Root:GetDescendants()) do
		if part:IsA("BasePart") then
			local cf, size = part.CFrame, part.Size
			local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
			local width = math.abs(r.X) * size.X + math.abs(u.X) * size.Y + math.abs(l.X) * size.Z
			local height = math.abs(r.Y) * size.X + math.abs(u.Y) * size.Y + math.abs(l.Y) * size.Z
			local depth = math.abs(r.Z) * size.X + math.abs(u.Z) * size.Y + math.abs(l.Z) * size.Z
			local p = { X = cf.X, Y = cf.Y, Z = cf.Z, W = width, H = height, D = depth }
			local cuts = Solid.near(p, index)
			if #cuts > 0 then
				local pieces = Solid.parts(p, cuts)
				local unchanged = #pieces == 1
					and math.abs(pieces[1].W - width) < 0.001
					and math.abs(pieces[1].H - height) < 0.001
					and math.abs(pieces[1].D - depth) < 0.001
				if not unchanged then
					for _, piece in ipairs(pieces) do
						local replacement = part:Clone()
						replacement.Size = Vector3.new(piece.W, piece.H, piece.D)
						replacement.CFrame = CFrame.new(piece.X, piece.Y, piece.Z)
						replacement.Parent = part.Parent
					end
					ctx.PartCount += #pieces - 1
					part:Destroy()
				end
			end
		end
	end
	for _, p in ipairs(layout.Parts) do
		ctx:part(
			"Human",
			p.Name,
			Vector3.new(p.X, p.Y, p.Z),
			Vector3.new(p.W, p.H, p.D),
			ctx.Config.Colors[p.Color],
			true
		)
	end
	-- Deduplicate nearby fixtures and cap new lights; intersections remain readable.
	local lit = {}
	local lightCount = 0
	for _, p in ipairs(layout.Lights) do
		local key = math.floor(p.X / 24) .. ":" .. math.floor(p.Y / 16) .. ":" .. math.floor(p.Z / 24)
		if not lit[key] and lightCount < 320 then
			lit[key] = true
			lightCount += 1
			ctx:lamp(Vector3.new(p.X, p.Y, p.Z), 24, 1.2, false)
		end
	end
	ctx.Root:SetAttribute("InteriorConnectedBuildings", #Connections.Buildings)
	ctx.Root:SetAttribute("InteriorConnections", #Connections.Links)
	ctx.Root:SetAttribute("InteriorGraphCycles", #Connections.Links - #Connections.Buildings + 1)
	ctx.Root:SetAttribute("InteriorCirculationLevels", "36.5, 52.5")
	ctx.Root:SetAttribute("InteriorCirculationLights", lightCount)
	ctx.Root:SetAttribute("InteriorNewPartCount", #layout.Parts)
	ctx.Root:SetAttribute(
		"EnvironmentalLightCount",
		(ctx.Root:GetAttribute("EnvironmentalLightCount") or 0) + lightCount
	)
end
return Runtime
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">BuildingConnections</string>
              <string name="Source"><![CDATA[--!strict
-- Generated by scripts/build_building_connections.py; edit source geometry then regenerate.
return {
	Buildings = {
		{ Name = "Commercial", X = -18, Z = 1100, Yaw = -90 },
		{ Name = "Tenement", X = -140, Z = 1152, Yaw = -90 },
		{ Name = "Commercial", X = 32, Z = 1476, Yaw = 90 },
		{ Name = "Tenement", X = -42, Z = 860, Yaw = -90 },
		{ Name = "Commercial", X = 10, Z = 892, Yaw = 90 },
		{ Name = "Tenement", X = 52, Z = 676, Yaw = 90 },
		{ Name = "Commercial", X = -20, Z = 692, Yaw = -90 },
		{ Name = "Commercial", X = -30, Z = 476, Yaw = -90 },
		{ Name = "Commercial", X = 10, Z = 476, Yaw = 90 },
		{ Name = "Tenement", X = -444, Z = 1376, Yaw = 180 },
		{ Name = "Tenement", X = -444, Z = 1424, Yaw = 0 },
		{ Name = "Tenement", X = -188, Z = 1376, Yaw = 180 },
		{ Name = "Tenement", X = -156, Z = 1424, Yaw = 0 },
		{ Name = "Tenement", X = -92, Z = 1376, Yaw = 180 },
		{ Name = "Tenement", X = -444, Z = 974, Yaw = 180 },
		{ Name = "Tenement", X = -444, Z = 1026, Yaw = 0 },
		{ Name = "Tenement", X = -444, Z = 638, Yaw = 0 },
		{ Name = "Commercial", X = -428, Z = 574, Yaw = 180 },
		{ Name = "Tenement", X = -348, Z = 638, Yaw = 0 },
		{ Name = "Tenement", X = -204, Z = 638, Yaw = 0 },
		{ Name = "Commercial", X = -140, Z = 574, Yaw = 180 },
		{ Name = "Tenement", X = -108, Z = 638, Yaw = 0 },
		{ Name = "Tenement", X = 92, Z = 1376, Yaw = 180 },
		{ Name = "Tenement", X = 124, Z = 1424, Yaw = 0 },
		{ Name = "Tenement", X = 188, Z = 1376, Yaw = 180 },
		{ Name = "Tenement", X = 316, Z = 1376, Yaw = 180 },
		{ Name = "Tenement", X = 364, Z = 1424, Yaw = 0 },
		{ Name = "Tenement", X = 412, Z = 1376, Yaw = 180 },
		{ Name = "Tenement", X = 140, Z = 1026, Yaw = 0 },
		{ Name = "Tenement", X = 188, Z = 974, Yaw = 180 },
		{ Name = "Tenement", X = 316, Z = 974, Yaw = 180 },
		{ Name = "Tenement", X = 316, Z = 1026, Yaw = 0 },
		{ Name = "Tenement", X = 412, Z = 974, Yaw = 180 },
		{ Name = "Tenement", X = 412, Z = 1026, Yaw = 0 },
		{ Name = "Commercial", X = 108, Z = 578, Yaw = 180 },
		{ Name = "Tenement", X = 140, Z = 634, Yaw = 0 },
		{ Name = "Tenement", X = 332, Z = 634, Yaw = 0 },
		{ Name = "Commercial", X = 380, Z = 578, Yaw = 180 },
		{ Name = "Tenement", X = -224, Z = 1624, Yaw = 0 },
		{ Name = "Tenement", X = -128, Z = 1624, Yaw = 0 },
		{ Name = "Tenement", X = 108, Z = 426, Yaw = 0 },
