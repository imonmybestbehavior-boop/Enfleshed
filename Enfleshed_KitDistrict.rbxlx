        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MagicLabPresets</string>
            <string name="Source"><![CDATA[--!strict
-- Development-only examples; the registered spell library remains unchanged.
local Spec = require(script.Parent.Parent.Modules.SpellSpec)
local Spells = require(script.Parent.Spells)
local aura = Spec.normalize(Spells.BurningGround)
aura.SpellId, aura.Name = "LabAura", "Energy Aura"
aura.Form, aura.Targeting, aura.Motion = "Aura", "Self", "FollowCaster"
aura.Aura = { Radius = 7, Interval = 0.6 }
aura.Field = nil
aura.Lifetime.Duration = 8
local barrier = Spec.normalize(Spells.Fireball)
barrier.SpellId, barrier.Name = "LabBarrier", "Construct Barrier"
barrier.Source = { Principle = "Matter", Expression = "ConjuredStructure" }
barrier.Form, barrier.Targeting, barrier.Geometry, barrier.Motion = "Construct", "AimDirection", "Box", "Stationary"
barrier.Projectile = nil
barrier.Construct = { Width = 10, Height = 8, Depth = 1, Distance = 12 }
barrier.Triggers = {}
barrier.Lifetime.Duration = 10
local platform = Spec.copy(barrier)
platform.SpellId, platform.Name = "LabPlatform", "Construct Platform"
platform.Construct = { Width = 10, Height = 1, Depth = 8, Distance = 12 }
return { LabAura = aura, LabBarrier = barrier, LabPlatform = platform }
]]></string>
          </Properties>
        </Item>
