    <Item class="Script" referent="27">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Sandbox = require(script.Services.SandboxService)
local StressTest = require(script.Services.SandboxStressService)
local Assignments = require(script.Services.AssignmentService)
local Ambient = require(script.Services.AmbientEnemyService)
local ActionRouter = require(script.Networking.ActionRouter)
local Config = require(game:GetService("ReplicatedStorage").Shared.Configuration.Sandbox)

Sandbox.start()
require(script.Services.EnemyRuntime).start()
ActionRouter.start()
if Config.StressTest.Enabled then
	StressTest.start()
end
Assignments.start()
Ambient.start()

require(script.Services.LivingCityService).start()
require(script.Services.WorldEventService).start()
]]></string>
      </Properties>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Configuration</string>
        </Properties>
      </Item>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">Development</string>
        </Properties>
        <Item class="Folder" referent="30">
          <Properties>
            <string name="Name">LowerLayer</string>
          </Properties>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">BuildContext</string>
              <string name="Source"><![CDATA[--!strict

local Lighting = game:GetService("Lighting")
local BuildContext = {}
BuildContext.__index = BuildContext

function BuildContext.new(config: any): any
	local root = Instance.new("Folder")
	root.Name = "LowerLayerGraybox"
	root.Parent = workspace
	local groups: { [string]: Instance } = {}
	for _, name in
		{ "Ancient", "Human", "Military", "Frontline", "Contamination", "Navigation", "SpawnPoints", "Debug" }
	do
		local group = Instance.new("Folder")
		group.Name = name
		group.Parent = root
		groups[name] = group
	end
	-- Only the six distant enclosure surfaces must survive streaming. Detailed
	-- buildings, streets and ancient ribs continue to stream normally.
	local enclosure = Instance.new("Model")
	enclosure.Name = "Enclosure"
	enclosure.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	enclosure.Parent = root
	groups.Enclosure = enclosure
	return setmetatable({ Config = config, Root = root, Groups = groups, PartCount = 0 }, BuildContext)
end

function BuildContext:part(
	group: string,
	name: string,
	position: Vector3,
	size: Vector3,
	color: Color3,
	collide: boolean?
): Part
	self.PartCount += 1
	local result = Instance.new("Part")
	result.Name, result.Anchored, result.Position, result.Size = name, true, position, size
	result.Color, result.Material = color, Enum.Material.Concrete
	result.CanCollide, result.CanTouch = collide ~= false, false
	result.Parent = self.Groups[group]
	return result
end

function BuildContext:floor(group: string, name: string, position: Vector3, size: Vector3, color: Color3): Part
	local support = self:part(
		"Navigation",
		name .. "Support",
		position - Vector3.new(0, 0.65, 0),
		size + Vector3.new(1, 0.8, 1),
		self.Config.Colors.AncientDark
	)
	support.Transparency = 0.97
	return self:part(group, name, position, size, color, false)
end

function BuildContext:marker(name: string, position: Vector3)
	local result = self:part("SpawnPoints", name, position, Vector3.new(4, 0.2, 4), self.Config.Colors.Light, false)
	result.Material, result.Transparency = Enum.Material.Neon, 0.4
	result:SetAttribute("GrayboxMarker", true)
end

function BuildContext:lamp(position: Vector3, range: number, brightness: number?, shadows: boolean?)
	local fixture =
		self:part("Human", "PracticalLamp", position, Vector3.new(0.6, 1, 0.6), self.Config.Colors.Light, false)
	fixture.Material = Enum.Material.Neon
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = self.Config.Colors.Light, range, brightness or 1.2
	light.Shadows = shadows == true
	light.Parent = fixture
end

function BuildContext:finish()
	self.Root:SetAttribute("PartCount", self.PartCount)
	self.Root:SetAttribute("Phase", "A")
	Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(12, 13, 18), Color3.fromRGB(20, 20, 28)
	Lighting.FogColor = Color3.fromRGB(22, 24, 30)
	Lighting.FogStart, Lighting.FogEnd = 220, 900
end

return BuildContext
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Builders</string>
              <string name="Source"><![CDATA[--!strict

local Builders = {}

function Builders.street(ctx: any, name: string, position: Vector3, size: Vector3, color: Color3)
	ctx:floor("Human", name, position, size, color)
	for offset = -size.Z / 2 + 30, size.Z / 2 - 10, 60 do
		ctx:lamp(position + Vector3.new(-size.X / 2 + 4, 8, offset), 28)
	end
end

function Builders.partial(ctx: any, name: string, position: Vector3, size: Vector3)
	local c = ctx.Config.Colors
	ctx:floor("Human", name .. "Apron", position, Vector3.new(size.X, 0.3, size.Z), c.HumanDark)
	for floor = 0, 2 do
		local y = floor * 10 + 5
		ctx:part(
			"Human",
			name .. "Frontage",
			position + Vector3.new(0, y, -size.Z / 2 + 2),
			Vector3.new(size.X, 10, 4),
			if floor % 2 == 0 then c.HumanDark else c.Human
		)
		ctx:part(
			"Human",
			name .. "RearMass",
			position + Vector3.new(0, y, size.Z / 2 - 3),
			Vector3.new(size.X, 10, 6),
			c.HumanDark
		)
		ctx:part(
			"Human",
			name .. "SideWing",
			position + Vector3.new(size.X / 2 - 3, y, 0),
			Vector3.new(6, 10, size.Z - 8),
			c.Human
		)
		ctx:part(
			"Human",
			name .. "UpperSlab",
			position + Vector3.new(0, y + 5, 0),
			Vector3.new(size.X - 10, 1, size.Z - 12),
			c.HumanDark,
			false
		)
	end
	ctx:part(
		"Human",
		name .. "RoofAddition",
		position + Vector3.new(-size.X * 0.2, 36, size.Z * 0.15),
		Vector3.new(size.X * 0.55, 8, size.Z * 0.45),
		c.Human
	)
	ctx:part(
		"Human",
		name .. "Balcony",
		position + Vector3.new(-size.X * 0.25, 18, -size.Z / 2 - 2),
		Vector3.new(size.X * 0.35, 1, 8),
		c.Human,
		false
	)
end

function Builders.throughBuilding(
	ctx: any,
	name: string,
	position: Vector3,
	width: number,
	depth: number,
	upper: boolean
)
	local c = ctx.Config.Colors
	ctx:floor("Human", name .. "InteriorFloor", position, Vector3.new(width, 0.35, depth), c.Human)
	for _, x in { -width / 2 + 2, width / 2 - 2 } do
		ctx:part("Human", name .. "SideWall", position + Vector3.new(x, 8, 0), Vector3.new(4, 16, depth), c.HumanDark)
	end
	ctx:part(
		"Human",
		name .. "InteriorDivider",
		position + Vector3.new(0, 5, 0),
		Vector3.new(width - 10, 10, 2),
		c.HumanDark
	)
	ctx:part(
		"Human",
		name .. "FrontFrameLeft",
		position + Vector3.new(-width / 2 + 5, 7, -depth / 2),
		Vector3.new(4, 14, 3),
		c.HumanDark
	)
	ctx:part(
		"Human",
		name .. "FrontFrameRight",
		position + Vector3.new(width / 2 - 5, 7, -depth / 2),
		Vector3.new(4, 14, 3),
		c.HumanDark
	)
	if upper then
		local y = ctx.Config.Metrics.UpperRouteHeight
		ctx:floor(
			"Human",
			name .. "UpperFloor",
			position + Vector3.new(0, y, 0),
			Vector3.new(width - 8, 0.35, depth * 0.55),
			c.HumanDark
		)
		for step = 0, 32 do
			ctx:floor(
				"Human",
				name .. "Stair",
				position + Vector3.new(-width / 2 + 8, step * 2.25, -depth / 2 + 8 + step * 0.9),
				Vector3.new(10, 0.5, 8),
				c.Human
			)
		end
	end
end

function Builders.ancient(ctx: any, name: string, position: Vector3, size: Vector3)
	return ctx:part("Ancient", name, position, size, ctx.Config.Colors.Ancient)
end

return Builders
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">HousingInfill</string>
              <string name="Source"><![CDATA[--!strict

local Layout = require(script.Parent.InfillLayout)
local Housing = {}

function Housing.build(ctx: any)
	local reservations = {}
	local function reserve(x: number, z: number, width: number, depth: number)
		table.insert(reservations, { x - width / 2, z - depth / 2, x + width / 2, z + depth / 2 })
	end
	-- Read the assembled geometry, reserving real route floors and existing
	-- structures rather than only relying on the abstract topology graph.
	for _, part in ctx.Groups.Human:GetChildren() do
		if not part:IsA("BasePart") then
			continue
		end
		local p, s = part.Position, part.Size
		local paving = string.find(part.Name, "NeighborhoodPaving", 1, true)
		if not paving and p.Y - s.Y / 2 < 62 and p.Y + s.Y / 2 >= 0 then
			reserve(p.X, p.Z, s.X + 2, s.Z + 2)
		end
		if string.find(part.Name, "InteriorFloor", 1, true) then
			-- Both open ends retain a broad approach through the added housing.
			reserve(p.X, p.Z, 18, s.Z + 160)
		end
		if string.find(part.Name, "Apron", 1, true) then
			-- Partial buildings are open on their west side. Connect that opening
			-- across at least one infill column to the surrounding alley network.
			reserve(p.X - s.X / 2 - 48, p.Z, 98, 18)
		end
	end
	reserve(0, 1550, 70, 70)
	reserve(460, 650, 128, 128)
	reserve(0, 410, 66, 152)
	-- Existing upper routes need headroom too; housing tops remain below Y=62.
	local lots = Layout.build(reservations)
	local c = ctx.Config.Colors
	for index, lot in lots do
		local width, depth = lot[3] - lot[1], lot[4] - lot[2]
		local x, z = (lot[1] + lot[3]) / 2, (lot[2] + lot[4]) / 2
		local height = 40 + (index % 4) * 6
		local name = "InfillHousing" .. index
		ctx:part("Human", name, Vector3.new(x, height / 2, z), Vector3.new(width, height, depth), c.HumanDark)
		ctx:part(
			"Human",
			name .. "UpperDwelling",
			Vector3.new(x, height - 5, z),
			Vector3.new(width - 2, 10, depth - 2),
			c.Human
		)
		-- Thin facade bands suggest stacked occupied floors without adding lights
		-- or detail objects to every dwelling. All decoration stays inside its lot.
		for _, y in { 12, 24 } do
			local strip = ctx:part(
				"Human",
				name .. "WindowBand",
				Vector3.new(x, y, z - depth / 2 - 0.05),
				Vector3.new(width - 4, 1.5, 0.1),
				c.Light,
				false
			)
			strip.CanQuery = false
		end
	end
	ctx.Root:SetAttribute("InfillHousingCount", #lots)
end

return Housing
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">InfillLayout</string>
              <string name="Source"><![CDATA[--!strict
-- Deterministic graybox lot clipping. Rectangles are { minX, minZ, maxX, maxZ }.
-- Kept independent of Roblox so clearance can be checked offline.
local Layout = {}

function Layout.subtract(rect, cut)
	local x1, z1 = math.max(rect[1], cut[1]), math.max(rect[2], cut[2])
	local x2, z2 = math.min(rect[3], cut[3]), math.min(rect[4], cut[4])
	if x1 >= x2 or z1 >= z2 then
		return { rect }
	end
	local result = {}
	for _, piece in ipairs({
		{ rect[1], rect[2], x1, rect[4] },
		{ x2, rect[2], rect[3], rect[4] },
		{ x1, rect[2], x2, z1 },
		{ x1, z2, x2, rect[4] },
	}) do
		if piece[3] > piece[1] and piece[4] > piece[2] then
			table.insert(result, piece)
		end
	end
	return result
end

function Layout.build(reservations)
	local lots = {}
	for column = 0, 13 do
		local x = -675 + column * 96
		-- Offset cross passages so pursuit requires turns between adjacent rows.
		local offset = (column % 3) * 28
		for row = -1, 12 do
			local z = 350 + row * 116 + offset
			local pieces = { { x, math.max(350, z), math.min(675, x + 80), math.min(1750, z + 100) } }
			for _, cut in ipairs(reservations) do
				local remaining = {}
				for _, piece in ipairs(pieces) do
					for _, fragment in ipairs(Layout.subtract(piece, cut)) do
						table.insert(remaining, fragment)
					end
				end
				pieces = remaining
			end
			for _, piece in ipairs(pieces) do
				if piece[3] - piece[1] >= 12 and piece[4] - piece[2] >= 12 then
					table.insert(lots, piece)
				end
			end
		end
	end
	return lots
end

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">PhaseA</string>
              <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Plan = require(Shared.Configuration.PhaseATopology)
local Geometry = require(script.Parent.RouteGeometry)
local Clipping = require(script.Parent.InfillLayout)
local Frontage = require(script.Parent.StreetFrontage)
local PhaseA = {}

function PhaseA.build(ctx: any)
	local manifest = Geometry.build(Plan, Clipping)
	local c = ctx.Config.Colors
	local environmentalLights = 0
	local function lamp(position: Vector3, range: number, brightness: number)
		ctx:lamp(position, range, brightness, false)
		environmentalLights += 1
	end
	for _, p in manifest.Parts do
		ctx:part("Human", p.Name, Vector3.new(p.X, p.Y, p.Z), Vector3.new(p.W, p.H, p.D), c[p.Color], p.Collision)
	end
	-- Invisible backup surfaces follow the same shaft cutouts. Their top is a
	-- full stud below the visible collision floor, so they cannot z-fight.
	for _, r in manifest.Planes[0] do
		local support = ctx:part(
			"Navigation",
			"GroundSafetySupport",
			Vector3.new((r[1] + r[3]) / 2, -2, (r[2] + r[4]) / 2),
			Vector3.new(r[3] - r[1] + 0.5, 2, r[4] - r[2] + 0.5),
			c.AncientDark
		)
		support.Transparency = 1
	end
	local lots = Clipping.build(manifest.Reservations)
	local fronts = Frontage.build(lots, Plan, manifest.Parts)
	local markers = Instance.new("Folder")
	markers.Name, markers.Parent = "StreetFronts", ctx.Root
	for _, p in fronts.Parts do
		local part =
			ctx:part("Human", p.Name, Vector3.new(p.X, p.Y, p.Z), Vector3.new(p.W, p.H, p.D), c[p.Color], p.Collision)
		if string.find(p.Name, "Fascia") then
			local lot = tonumber(string.match(p.Name, "StreetFront_(%d+)"))
			local f = fronts.ByLot[lot]
			local sign = Instance.new("SurfaceGui")
			sign.Face = if f.Axis == "X"
				then (if f.Sign > 0 then Enum.NormalId.Right else Enum.NormalId.Left)
				else (if f.Sign > 0 then Enum.NormalId.Back else Enum.NormalId.Front)
			sign.CanvasSize = Vector2.new(600, 80)
			sign.AlwaysOnTop = false
			sign.MaxDistance = 70
			sign.Parent = part
			local text = Instance.new("TextLabel")
			text.Size = UDim2.fromScale(1, 1)
			text.BackgroundTransparency = 1
			text.Text = ({
				Shopfront = "CLOTH & HOUSEHOLD",
				ServiceCounter = "REPAIRS",
				Workshop = "METALWORK",
				MarketStall = "PROVISIONS",
				BoardedStore = "CLOSED",
				GuardSupply = "WATCH SUPPLIES",
			})[f.Kind]
			text.TextColor3 = Color3.fromRGB(216, 195, 155)
			text.TextScaled = true
			text.Font = Enum.Font.Gotham
			text.Parent = sign
		end
	end
	for _, f in fronts.Fronts do
		local marker = Instance.new("Vector3Value")
		marker.Name, marker.Value, marker.Parent = f.Id, Vector3.new(f.Home.X, 0, f.Home.Z), markers
		marker:SetAttribute("Archetype", f.Kind)
		marker:SetAttribute("Enterable", f.Enterable)
		marker:SetAttribute("Entrance", Vector3.new(f.Entry.X, 0, f.Entry.Z))
		if f.Enterable then
			lamp(marker.Value + Vector3.new(0, 10, 0), 22, 1.3)
		end
	end
	ctx.Root:SetAttribute("StreetFrontCount", #fronts.Fronts)
	for i, r in lots do
		local x, z = (r[1] + r[3]) / 2, (r[2] + r[4]) / 2
		local w, d = r[3] - r[1], r[4] - r[2]
		local top = 220 + (i % 6) * 56
		-- Solid street housing; upper accretions are visual, without extra collision.
		if not fronts.ByLot[i] then
			ctx:part("Human", "HousingFoundation" .. i, Vector3.new(x, 32, z), Vector3.new(w, 64, d), c.HumanDark)
		end
		-- Selected lots gain only a few large, named generations near street level.
		-- These are future modular-asset seams, not decorative scatter.
		if i % 4 == 0 and not fronts.ByLot[i] then
			local side = i % 8 == 0 and 1 or -1
			ctx:part(
				"Human",
				"WorkshopExtension" .. i,
				Vector3.new(x + side * w * 0.42, 10, z - d * 0.22),
				Vector3.new(math.max(10, w * 0.32), 20, math.max(12, d * 0.36)),
				c.Human,
				false
			)
			ctx:part(
				"Human",
				"StairTower" .. i,
				Vector3.new(x - side * w * 0.38, 18, z + d * 0.25),
				Vector3.new(math.max(8, w * 0.16), 36, math.max(10, d * 0.2)),
				c.Military,
				false
			)
			ctx:part(
				"Human",
				"ProjectedHousingAddition" .. i,
				Vector3.new(x + side * w * 0.3, 52, z - d * 0.1),
				Vector3.new(math.max(12, w * 0.46), 20, math.max(12, d * 0.38)),
				c.HumanDark,
				false
			)
		end
		for level = 0, 3 do
			local h = (top - 64) / 4
			local inset = (level % 2) * 2
			ctx:part(
				"Human",
				"AccretedHabitation" .. i,
				Vector3.new(x, 64 + (level + 0.5) * h, z),
				Vector3.new(w - inset, h, d - inset),
				if (i + level) % 2 == 0 then c.Human else c.HumanDark,
				false
			)
			local band = ctx:part(
				"Human",
				"UpperWindowBand",
				Vector3.new(x, 70 + level * h, z - d / 2 - 0.1),
				Vector3.new(math.max(4, w - 4), 1.2, 0.2),
				c.Light,
				false
			)
			band.CanQuery = false
		end
		-- Later generations project rooms over the lanes above playable roofs.
		-- Alternating sides break the silhouette without blocking circulation.
		for layer = 1, 2 do
			local side = if (i + layer) % 2 == 0 then 1 else -1
			ctx:part(
				"Human",
				"GraftedUpperRooms",
				Vector3.new(x + side * w * 0.4, 100 + layer * 50, z),
				Vector3.new(w * 0.5, 18 + layer * 4, math.max(10, d * 0.6)),
				c.Human,
				false
			)
		end
	end
	-- Bridges and additions ABOVE the playable roofs give the avenue several
	-- overhead layers. They are clearly inaccessible background habitation.
	for i, z in { 480, 690, 910, 1120, 1330, 1550 } do
		ctx:part(
			"Human",
			"SuspendedUpperStreet",
			Vector3.new(0, 160 + (i % 3) * 65, z),
			Vector3.new(620, 12, 26),
			c.HumanDark,
			false
		)
		ctx:part(
			"Human",
			"SuspendedWorkshop",
			Vector3.new(if i % 2 == 0 then 80 else -100, 186 + (i % 3) * 65, z),
			Vector3.new(110, 40, 40),
			c.Human,
			false
		)
	end
	-- Layered ancient ribs remain much larger than the human additions. The six
	-- persistent shell faces are only a distant occlusion backstop.
	for _, x in { -870, 870 } do
		ctx:part("Ancient", "ShaftWall", Vector3.new(x, 440, 1050), Vector3.new(180, 1100, 1800), c.Ancient)
	end
	for i, z in { 400, 900, 1450, 1800 } do
		ctx:part(
			"Ancient",
			"AncientOverheadRib",
			Vector3.new(0, 600 + (i % 2) * 90, z),
			Vector3.new(1850, 100, 110),
			c.Ancient,
			false
		)
		ctx:part(
			"Ancient",
			"SuspendedAncientMass",
			Vector3.new(if i % 2 == 0 then -400 else 380, 760, z),
			Vector3.new(640, 170, 190),
			c.AncientDark,
			false
		)
	end
	local lo, hi = ctx.Config.Enclosure.Minimum, ctx.Config.Enclosure.Maximum
	local mid, size = (lo + hi) / 2, hi - lo
	local t = ctx.Config.Enclosure.Thickness
	for _, f in
		{
			{ Vector3.new(mid.X, lo.Y, mid.Z), Vector3.new(size.X + t, t, size.Z + t) },
			{ Vector3.new(mid.X, hi.Y, mid.Z), Vector3.new(size.X + t, t, size.Z + t) },
			{ Vector3.new(lo.X, mid.Y, mid.Z), Vector3.new(t, size.Y + t, size.Z + t) },
			{ Vector3.new(hi.X, mid.Y, mid.Z), Vector3.new(t, size.Y + t, size.Z + t) },
			{ Vector3.new(mid.X, mid.Y, lo.Z), Vector3.new(size.X + t, size.Y + t, t) },
			{ Vector3.new(mid.X, mid.Y, hi.Z), Vector3.new(size.X + t, size.Y + t, t) },
		}
	do
		local shell = ctx:part("Enclosure", "AncientEnclosure", f[1], f[2], c.AncientDark, false)
		shell.CanQuery = false
	end
	-- Keep the development safety boundary and catch floor.
	for _, f in
		{
			{ Vector3.new(-710, 150, 1050), Vector3.new(4, 450, 1404) },
			{ Vector3.new(710, 150, 1050), Vector3.new(4, 450, 1404) },
			{ Vector3.new(0, 150, 340), Vector3.new(1424, 450, 4) },
			{ Vector3.new(0, 150, 1760), Vector3.new(1424, 450, 4) },
		}
	do
		local boundary = ctx:part("Debug", "DevelopmentBoundary", f[1], f[2], c.AncientDark)
		boundary.Transparency = 1
	end
	-- Route lights intentionally follow the authored circulation rather than the
	-- visual infill. This leaves alleys darker but keeps paths legible.
	for _, edge in Plan.Edges do
		if edge.Kind == "Street" or edge.Kind == "Alley" then
			local points = edge.Points or { Plan.Nodes[edge[1]], Plan.Nodes[edge[2]] }
			for index = 2, #points do
				local start, finish = points[index - 1], points[index]
				for fraction = 0.25, 0.75, 0.5 do
					lamp(
						start:Lerp(finish, fraction) + Vector3.new(0, 10, 0),
						34,
						if edge.Kind == "Street" then 2.2 else 1.35
					)
				end
			end
		end
	end
	for _, id in Plan.UndergroundNodes do
		local p = Plan.Nodes[id]
		lamp(p + Vector3.new(-8, 10, 0), 28, 1.45)
		lamp(p + Vector3.new(8, 10, 0), 28, 1.15)
	end
	for _, edge in Plan.Edges do
		if edge.Kind == "UndergroundStair" then
			local p = Plan.Nodes[edge[1]]
			lamp(p + Vector3.new(0, 8, 32), 26, 1.6)
		end
	end
	for _, b in Plan.Buildings do
		local p = Plan.Nodes[b.Ground]
		for _, y in { 8, 26, 44, 58 } do
			lamp(p + Vector3.new(-8, y, -40), 25, 1.5)
		end
		for _, side in { -1, 1 } do
			lamp(p + Vector3.new(0, 10, side * 58), 22, 1.8)
		end
	end
	for _, node in Plan.UpperNodes do
		local p = Plan.Nodes[node]
		for level = 1, 4 do
			local light = ctx:part(
				"Human",
				"UpperCityWindow",
				p + Vector3.new((level % 2 == 0 and 22 or -22), 90 + level * 72, 8),
				Vector3.new(2, 3, 1),
				c.Light,
				false
			)
			light.Material = Enum.Material.Neon
		end
	end
	ctx:part("Military", "PhaseBConstructionGate", Vector3.new(0, 18, 360), Vector3.new(70, 36, 8), c.Military)
	ctx:marker("RecruitSpawn", ctx.Config.PhaseA.RecruitSpawn)
	ctx:marker("MarketCombatYard", ctx.Config.PhaseA.MarketCombatYard)
	if ctx.Config.SpawnDebug then
		for _, candidate in Plan.SpawnCandidates do
			local position = (candidate.Position or Plan.Nodes[candidate.Node]) + candidate.Offset
			ctx:marker("Spawn_" .. candidate.Kind .. "_" .. candidate.Id, position + Vector3.new(0, 0.12, 0))
		end
	end
	if Plan.DebugRoutes then
		for index, edge in Plan.Edges do
			if edge.Kind == "Street" or edge.Kind == "Alley" then
				local a, b = Plan.Nodes[edge[1]], Plan.Nodes[edge[2]]
				ctx:marker("RouteSpace_" .. edge.Space .. "_" .. index, (a + b) / 2 + Vector3.new(0, 0.2, 0))
			end
		end
	end
	local count = 0
	for id, p in Plan.Nodes do
		count += 1
		if Plan.DebugRoutes then
			ctx:marker(id, p + Vector3.new(0, 0.1, 0))
		end
	end
	ctx.Root:SetAttribute("RouteNodeCount", count)
	ctx.Root:SetAttribute("RouteConnectionCount", #Plan.Edges)
	ctx.Root:SetAttribute("IndependentLoopCount", #Plan.Edges - count + 1)
	ctx.Root:SetAttribute("InfillHousingCount", #lots)
	ctx.Root:SetAttribute("StairFlightCount", #manifest.Stairs)
	ctx.Root:SetAttribute("HumanVisualHeight", 500)
	ctx.Root:SetAttribute("SpawnCandidateCount", #Plan.SpawnCandidates)
	ctx.Root:SetAttribute("EnvironmentalLightCount", environmentalLights)
end
return PhaseA
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">RouteGeometry</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Phase A only: an inspectable, axis-aligned geometry manifest shared by the
-- runtime builder and offline clearance tests. Coordinates use walkable top Y.
local Geometry = {}

function Geometry.build(plan, clipping)
	local result = { Parts = {}, Floors = {}, Stairs = {}, Doors = {}, Reservations = {}, Holes = {} }
	local planes = {}
	local function box(name, x, y, z, w, h, d, color, collision)
		local p = {
			Name = name,
			X = x,
			Y = y,
			Z = z,
			W = w,
			H = h,
			D = d,
			Color = color or "HumanDark",
			Collision = collision ~= false,
		}
		table.insert(result.Parts, p)
		return p
	end
	local function rect(x, z, w, d)
		return { x - w / 2, z - d / 2, x + w / 2, z + d / 2 }
	end
	local function reserve(r)
		table.insert(result.Reservations, r)
	end
	local function cutAll(pieces, cuts)
		for _, cut in ipairs(cuts) do
			local nextPieces = {}
			for _, piece in ipairs(pieces) do
				for _, p in ipairs(clipping.subtract(piece, cut)) do
					table.insert(nextPieces, p)
				end
			end
			pieces = nextPieces
		end
		return pieces
	end
	-- Stair wells are registered BEFORE any floor generation.
	for _, b in ipairs(plan.Buildings) do
		local p = plan.Nodes[b.Ground]
		for _, y in ipairs({ 36, 72 }) do
			result.Holes[y] = result.Holes[y] or {}
			table.insert(result.Holes[y], rect(p.X + 29, p.Z - 12, 36, 72))
		end
		reserve(rect(p.X, p.Z, 100, 124))
	end
	for _, e in ipairs(plan.Edges) do
		if e.Kind == "UndergroundStair" then
			local p = plan.Nodes[e[1]]
			result.Holes[0] = result.Holes[0] or {}
			table.insert(result.Holes[0], rect(p.X, p.Z + 52, 22, 104))
			reserve(rect(p.X, p.Z + 52, 26, 112))
		end
	end
	local function floor(name, x, y, z, w, d, color)
		local pieces = cutAll({ rect(x, z, w, d) }, result.Holes[y] or {})
		planes[y] = planes[y] or {}
		pieces = cutAll(pieces, planes[y])
		for _, r in ipairs(pieces) do
			if r[3] - r[1] > 0.01 and r[4] - r[2] > 0.01 then
				table.insert(planes[y], r)
				local p = box(name, (r[1] + r[3]) / 2, y - 0.5, (r[2] + r[4]) / 2, r[3] - r[1], 1, r[4] - r[2], color)
				table.insert(result.Floors, p)
			end
		end
	end
	local function segment(name, a, b, width, color)
		assert(a.Y == b.Y and (a.X == b.X or a.Z == b.Z), "Non-axis route " .. name)
		local w, d = math.abs(a.X - b.X) + width, math.abs(a.Z - b.Z) + width
		floor(name, (a.X + b.X) / 2, a.Y, (a.Z + b.Z) / 2, w, d, color)
		if a.Y >= 0 then
			reserve(rect((a.X + b.X) / 2, (a.Z + b.Z) / 2, w + 4, d + 4))
		end
	end
	local function point(x, y, z)
		return { X = x, Y = y, Z = z }
	end
	local function stairs(name, x, z, y, dir, rise, count, width, tread)
		local samples = {}
		for i = 1, count do
			local top = y + rise * i
			local zz = z + dir * tread * (i - 0.5)
			box(name .. "Step", x, top - 0.4, zz, width, 0.8, i == count and tread or tread + 0.2, "Human")
			table.insert(samples, point(x, top, zz))
		end
		table.insert(result.Stairs, {
			Name = name,
			Samples = samples,
			Width = width,
			Bottom = point(x, y, z),
			Top = point(x, y + rise * count, z + dir * tread * count),
		})
	end
	local function interiorVariation(b, p, y)
		local name, style = b.Name, b.Style
		local function detail(partName, x, height, z, width, depth, color)
			-- Interior detail reads as circulation variation but stays out of the
			-- enemy-compatible core path until final collision/art passes.
			box(partName, x, y + height / 2, z, width, height, depth, color, false)
		end
		if style == "BunkHall" then
			for _, z in ipairs({ -38, -12, 18, 44 }) do
				detail(name .. "BunkBay", p.X - 29, 6, p.Z + z, 24, 18, "HumanDark")
			end
			detail(name .. "GuardPost", p.X - 16, 8, p.Z - 50, 14, 10, "Military")
		elseif style == "TrainingHall" then
			for _, x in ipairs({ -30, -10, 10 }) do
				detail(name .. "TrainingBarrier", p.X + x, 4, p.Z + 20, 10, 6, "Military")
			end
			detail(name .. "ObservationDais", p.X - 30, 6, p.Z + 42, 24, 18, "HumanDark")
		elseif style == "DenseCells" then
			for _, z in ipairs({ -42, -18, 8, 34 }) do
				detail(name .. "CellPartition", p.X - 30, 16, p.Z + z, 30, 2, "HumanDark")
			end
			detail(name .. "SharedTable", p.X - 4, 4, p.Z + 26, 14, 10, "Human")
		elseif style == "SplitLevel" then
			detail(name .. "RaisedLivingBay", p.X - 31, 4, p.Z + 28, 26, 42, "HumanDark")
			detail(name .. "LowDivider", p.X - 14, 8, p.Z - 32, 2, 38, "Human")
			detail(name .. "ExteriorAddition", p.X + 34, 20, p.Z + 44, 20, 14, "HumanDark")
		elseif style == "CourtyardRooms" then
			for _, z in ipairs({ -34, 0, 34 }) do
				detail(name .. "CourtyardAlcove", p.X - 31, 12, p.Z + z, 24, 2, "HumanDark")
			end
			detail(name .. "RearSharedRoom", p.X + 5, 10, p.Z + 42, 26, 20, "Human")
		elseif style == "OpenWorkshop" then
			for _, z in ipairs({ -28, 0, 28 }) do
				detail(name .. "WorkBench", p.X - 28, 6, p.Z + z, 28, 8, "HumanDark")
			end
			detail(name .. "LoadingPlatform", p.X + 30, 8, p.Z + 38, 22, 20, "Military")
		elseif style == "StorageWorkshop" then
			for _, z in ipairs({ -40, -12, 16, 44 }) do
				detail(name .. "StorageStack", p.X - 30, 10, p.Z + z, 22, 16, "HumanDark")
			end
			detail(name .. "ServiceBench", p.X + 5, 6, p.Z - 36, 22, 10, "Human")
		elseif style == "GatheringHall" then
			for _, z in ipairs({ -34, 34 }) do
				detail(name .. "MarketStall", p.X - 28, 6, p.Z + z, 26, 14, "HumanDark")
				detail(name .. "MarketStall", p.X + 6, 6, p.Z + z, 16, 14, "Human")
			end
			detail(name .. "GatheringDais", p.X - 30, 6, p.Z, 22, 22, "Military")
		end
	end
	-- Ground routes, then buildings. All floors at a given height are clipped
	-- against preceding floors: no visible coplanar overlap, including junctions.
	for i, e in ipairs(plan.Edges) do
		if e.Kind == "Street" or e.Kind == "Alley" then
			local pts = e.Points or { plan.Nodes[e[1]], plan.Nodes[e[2]] }
			for n = 2, #pts do
				segment("Route" .. i, pts[n - 1], pts[n], e.Width, "Human")
			end
		end
	end
	for i = 1, 15 do
		local p = plan.Nodes["S" .. i]
		-- Most intersections are occupied human junctions; only selected primary
		-- nodes retain a broader market/military release for multi-enemy combat.
		local size = (i == 1 or i == 5 or i == 10) and 50 or 30
		floor("Court" .. i, p.X, 0, p.Z, size, size, "Human")
		reserve(rect(p.X, p.Z, size + 4, size + 4))
	end
	for _, b in ipairs(plan.Buildings) do
		local p = plan.Nodes[b.Ground]
		local roof = b.Roof and 72 or 36
		for _, side in ipairs({ -1, 1 }) do
			floor(b.Name .. "UpperBalcony", p.X, 36, p.Z + side * 65, 24, 14, "HumanDark")
			reserve(rect(p.X, p.Z + side * 65, 28, 18))
		end
		for y = 0, roof, 36 do
			floor(b.Name .. "Floor", p.X, y, p.Z, 96, 120, "Human")
			if y < roof then
				-- Full side walls, front/rear walls with actual 18 x 14 openings.
				for _, side in ipairs({ -1, 1 }) do
					box(b.Name .. "SideWall", p.X + side * 47, y + 17.5, p.Z, 2, 35, 120)
					for _, x in ipairs({ -28.5, 28.5 }) do
						box(b.Name .. "DoorWall", p.X + x, y + 17.5, p.Z + side * 59, 39, 35, 2)
					end
					box(b.Name .. "DoorLintel", p.X, y + 24.5, p.Z + side * 59, 18, 21, 2)
					table.insert(result.Doors, { X = p.X, Y = y, Z = p.Z + side * 59, Width = 18, Height = 14 })
				end
				-- Side rooms open onto the central north/south circulation hall.
				if b.Style ~= "TrainingHall" and b.Style ~= "OpenWorkshop" and b.Style ~= "GatheringHall" then
					for _, z in ipairs({ -26, 26 }) do
						box(b.Name .. "RoomPartition", p.X - 29, y + 8, p.Z + z, 34, 16, 2)
					end
				end
				interiorVariation(b, p, y)
				-- Two broad flights, with side-by-side returns in a reserved well.
				stairs(b.Name .. "Up", p.X + 20, p.Z - 48, y, 1, 0.75, 24, 12, 2)
				floor(b.Name .. "HalfLanding", p.X + 29, y + 18, p.Z + 8, 36, 16, "Human")
				stairs(b.Name .. "Return", p.X + 38, p.Z, y + 18, -1, 0.75, 24, 12, 2)
				-- Bottom and top landings connect the stairwell to the central hall.
				floor(b.Name .. "EntryLanding", p.X + 20, y, p.Z - 56, 52, 8, "Human")
			end
		end
		-- Upper habitable level has rooms and side walls even without roof access.
		if not b.Roof then
			for _, side in ipairs({ -1, 1 }) do
				box(b.Name .. "UpperSideWall", p.X + side * 47, 48, p.Z, 2, 24, 120)
			end
			for _, z in ipairs({ -26, 26 }) do
				box(b.Name .. "UpperRoomPartition", p.X - 29, 44, p.Z + z, 34, 16, 2)
			end
			for _, side in ipairs({ -1, 1 }) do
				for _, x in ipairs({ -28.5, 28.5 }) do
					box(b.Name .. "UpperDoorWall", p.X + x, 48, p.Z + side * 59, 39, 24, 2)
				end
				box(b.Name .. "UpperDoorLintel", p.X, 55, p.Z + side * 59, 18, 10, 2)
				table.insert(result.Doors, { X = p.X, Y = 36, Z = p.Z + side * 59, Width = 18, Height = 14 })
			end
			box(b.Name .. "SealedRoof", p.X, 61, p.Z, 96, 2, 120, "HumanDark")
		end
	end
	-- Underground junction rooms and bent passages, entirely below street level.
	for _, id in ipairs(plan.UndergroundNodes) do
		local p = plan.Nodes[id]
		floor(id .. "Junction", p.X, p.Y, p.Z, 34, 34, "AncientDark")
	end
	for i, e in ipairs(plan.Edges) do
		if e.Kind == "Tunnel" then
			for n = 2, #e.Points do
				segment("Utility" .. i, e.Points[n - 1], e.Points[n], e.Width, "AncientDark")
			end
		elseif e.Kind == "UndergroundStair" then
			local a, b = plan.Nodes[e[1]], plan.Nodes[e[2]]
			-- First tread touches the court; final tread meets the bottom landing.
			stairs("Maintenance" .. i, a.X, a.Z, 0, 1, -0.75, 48, 18, 2)
			floor("MaintenanceBottom", a.X, -36, a.Z + 104, 22, 16, "Human")
			segment("BasementLink", point(a.X, -36, a.Z + 104), point(b.X, -36, a.Z + 104), 18, "AncientDark")
			segment("BasementLink", point(b.X, -36, a.Z + 104), b, 18, "AncientDark")
		end
	end
	-- Build tunnel walls around the UNION of floor rectangles, not across
	-- junctions. Ceilings stay above the 14-stud clear passage height.
	local tunnelRects = planes[-36] or {}
	local wallRects = {}
	for _, r in ipairs(tunnelRects) do
		for _, side in ipairs({
			{ r[1] - 2, r[2], r[1], r[4] },
			{ r[3], r[2], r[3] + 2, r[4] },
			{ r[1], r[2] - 2, r[3], r[2] },
			{ r[1], r[4], r[3], r[4] + 2 },
		}) do
			for _, piece in ipairs(cutAll(cutAll(cutAll({ side }, tunnelRects), wallRects), result.Holes[0])) do
				table.insert(wallRects, piece)
				box(
					"UtilityWall",
					(piece[1] + piece[3]) / 2,
					-28,
					(piece[2] + piece[4]) / 2,
					piece[3] - piece[1],
					16,
					piece[4] - piece[2],
					"AncientDark"
				)
			end
		end
	end
	-- Covered tunnels exclude surface stair shafts, including their headroom.
	result.Holes[-20] = result.Holes[0]
	for _, r in ipairs(tunnelRects) do
		floor("UtilityCeiling", (r[1] + r[3]) / 2, -20, (r[2] + r[4]) / 2, r[3] - r[1], r[4] - r[2], "AncientDark")
	end
	for i, e in ipairs(plan.Edges) do
		if e.Kind == "Catwalk" or e.Kind == "RoofBridge" then
			local pts = e.Points or { plan.Nodes[e[1]], plan.Nodes[e[2]] }
			for n = 2, #pts do
				segment("UpperRoute" .. i, pts[n - 1], pts[n], e.Width, "HumanDark")
			end
		end
	end
	-- Remaining ordinary ground is a single non-overlapping surface partition;
	-- the four stair shafts are intentionally cut out of it.
	floor("NeighborhoodPaving", 0, 0, 1050, 1400, 1400, "HumanDark")
	reserve(rect(460, 650, 128, 128))
	result.Planes = planes
	return result
end

return Geometry
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">StreetFrontage</string>
              <string name="Source"><![CDATA[--!strict
-- Pure deterministic geometry: cavities replace solid foundations, never widen streets.
local Frontage = {}
local kinds = { "Shopfront", "ServiceCounter", "Workshop", "MarketStall", "BoardedStore", "GuardSupply" }
function Frontage.build(lots, plan, existingParts)
	local result = { Parts = {}, Fronts = {}, ByLot = {} }
	for index, r in ipairs(lots) do
		local best, score = nil, math.huge
		local x, z, w, d = (r[1] + r[3]) / 2, (r[2] + r[4]) / 2, r[3] - r[1], r[4] - r[2]
		for _, edge in ipairs(plan.Edges) do
			if edge.Kind == "Street" and edge.Width >= 30 then
				local points = edge.Points or { plan.Nodes[edge[1]], plan.Nodes[edge[2]] }
				for j = 2, #points do
					local a, b = points[j - 1], points[j]
					if a.Y == 0 and b.Y == 0 then
						local vertical = math.abs(a.X - b.X) < 0.01
						local horizontal = math.abs(a.Z - b.Z) < 0.01
						local along = vertical and z or x
						local low = vertical and math.min(a.Z, b.Z) or math.min(a.X, b.X)
						local high = vertical and math.max(a.Z, b.Z) or math.max(a.X, b.X)
						local width = vertical and d or w
						local depth = vertical and w or d
						local distance = vertical and math.abs(x - a.X) - w / 2 or math.abs(z - a.Z) - d / 2
						if
							(vertical or horizontal)
							and width >= 28
							and depth >= 24
							and along >= low + 16
							and along <= high - 16
							and distance >= edge.Width / 2
							and distance <= edge.Width / 2 + 24
							and distance < score
						then
							score = distance
							best = {
								Axis = vertical and "X" or "Z",
								Sign = (vertical and x < a.X or horizontal and z < a.Z) and 1 or -1,
								Width = width,
								Depth = depth,
							}
						end
					end
				end
			end
		end
		if best then
			local face = best.Axis == "X" and x + best.Sign * w / 2 or z + best.Sign * d / 2
			for step = 0, math.ceil(score) do
				local px = best.Axis == "X" and face + best.Sign * step or x
				local pz = best.Axis == "X" and z or face + best.Sign * step
				for otherIndex, other in ipairs(lots) do
					if
						otherIndex ~= index
						and px > other[1] - 2
						and px < other[3] + 2
						and pz > other[2] - 2
						and pz < other[4] + 2
					then
						best = nil
						break
					end
				end
				for _, p in ipairs(existingParts or {}) do
					if
						p.Collision
						and p.Y + p.H / 2 > 1
						and p.Y - p.H / 2 < 10
						and math.abs(px - p.X) < p.W / 2 + 2
						and math.abs(pz - p.Z) < p.D / 2 + 2
					then
						best = nil
						break
					end
				end
				if not best then
					break
				end
			end
		end
		if best then
			local f = best
			f.ApproachDistance = score
			f.Lot = index
			f.Kind = kinds[#result.Fronts % #kinds + 1]
			f.Enterable = f.Kind ~= "BoardedStore"
			f.X = x
			f.Z = z
			f.RoomDepth = math.min((f.Kind == "ServiceCounter" or f.Kind == "MarketStall") and 20 or 24, f.Depth - 2)
			f.Face = f.Axis == "X" and x + f.Sign * w / 2 or z + f.Sign * d / 2
			f.Id = "StreetFront_" .. index
			local function part(name, u, y, v, uw, h, vd, color)
				local px = f.Axis == "X" and f.Face - f.Sign * v or x + u
				local pz = f.Axis == "X" and z + u or f.Face - f.Sign * v
				table.insert(result.Parts, {
					Name = f.Id .. "_" .. name,
					X = px,
					Y = y,
					Z = pz,
					W = f.Axis == "X" and vd or uw,
					H = h,
					D = f.Axis == "X" and uw or vd,
					Color = color or "HumanDark",
					Collision = true,
				})
			end
			-- Full upper mass and solid rear remain. Interior uses the existing continuous paving/support.
			part("UpperMass", 0, 41, f.Depth / 2, f.Width, 46, f.Depth)
			part("RearMass", 0, 9, (f.Depth + f.RoomDepth) / 2, f.Width, 18, f.Depth - f.RoomDepth)
			part("LeftWall", -f.Width / 2 + 1, 9, f.RoomDepth / 2, 2, 18, f.RoomDepth)
			part("RightWall", f.Width / 2 - 1, 9, f.RoomDepth / 2, 2, 18, f.RoomDepth)
			local jamb = (f.Width - 14) / 2
			if f.Kind == "ServiceCounter" then
				part("ServiceSill", -(14 + jamb) / 2, 2, 1, jamb, 4, 2, "Human")
				part("ServiceHeader", -(14 + jamb) / 2, 12, 1, jamb, 4, 2, "Human")
				part("ServiceDesk", -(14 + jamb) / 2, 4, 2, jamb, 1, 4, "Military")
			else
				part("FrontLeft", -(14 + jamb) / 2, 7, 1, jamb, 14, 2, "Human")
			end
			part("FrontRight", (14 + jamb) / 2, 7, 1, jamb, 14, 2, "Human")
			part("Lintel", 0, 16, 1, f.Width, 4, 2, "Military")
			-- Recessed overhang and fascia stay inside the lot/route boundary.
			part("Canopy", 0, 13, 3, f.Width - 2, 1, 6, "Military")
			part(f.Kind .. "Fascia", 0, 15, 0.3, math.min(f.Width - 4, 30), 2, 0.6, "Human")
			if f.Enterable then
				part("Counter", -f.Width / 2 + 5, 2, 12, 6, 4, 7, "Human")
				part("Shelving", f.Width / 2 - 3, 4, f.RoomDepth - 4, 3, 8, 5, "Military")
				part("ShelfGoods", f.Width / 2 - 3, 8.5, f.RoomDepth - 4, 2, 1, 3, "Human")
				if f.Kind == "GuardSupply" then
					part("SupplyLocker", -f.Width / 2 + 4, 5, f.RoomDepth - 3, 4, 10, 4, "Military")
				elseif f.Kind == "Shopfront" then
					part("DisplayTable", f.Width / 2 - 4, 2, 6, 4, 4, 5, "Human")
				end
				if f.Kind == "Workshop" then
					part("WorkBench", -f.Width / 2 + 5, 3, f.RoomDepth - 3, 6, 6, 4, "Military")
				end
				if f.Kind == "MarketStall" then
					part("StallFrame", -f.Width / 2 + 5, 8, 12, 6, 1, 8, "Human")
				end
			else
				for y = 2, 10, 4 do
					part("Boards", 0, y, 1, 14, 2, 1, "Human")
				end
			end
			f.Entry = { X = f.Axis == "X" and f.Face or x, Y = 0, Z = f.Axis == "X" and z or f.Face }
			f.Home = {
				X = f.Axis == "X" and f.Face - f.Sign * (f.RoomDepth - 5) or x,
				Y = 0,
				Z = f.Axis == "X" and z or f.Face - f.Sign * (f.RoomDepth - 5),
			}
			table.insert(result.Fronts, f)
			result.ByLot[index] = f
		end
	end
	return result
end
return Frontage
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">LowerLayerGraybox</string>
            <string name="Source"><![CDATA[--!strict

-- Development entry point. Each world phase is a designed assembly, while the
-- reusable helpers keep this from becoming another monolithic world function.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.LowerLayerGraybox)
local Context = require(script.Parent.LowerLayer.BuildContext)
local PhaseA = require(script.Parent.LowerLayer.PhaseA)

local Graybox = {}

function Graybox.start()
	if not Config.Enabled then
		return
	end
	local existing = workspace:FindFirstChild("LowerLayerGraybox")
	if existing then
		existing:Destroy()
	end
	local context = Context.new(Config)
	PhaseA.build(context)
	context:finish()
end

return Graybox
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">PhaseANavigationCheck</string>
            <string name="Source"><![CDATA[--!strict
-- Opt-in Studio check; never runs during ordinary wave updates. This tests the
-- engine navmesh, not an NPC chase. See PHASE_A_REPORT.md for physical playtests.
local Pathfinding = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Plan = require(Shared.Configuration.PhaseATopology)
local Agent = require(Shared.Configuration.Sandbox).Enemy.Navigation
local Check = {}

function Check.run()
	assert(RunService:IsStudio(), "Development navigation check is Studio-only")
	assert(workspace:FindFirstChild("LowerLayerGraybox"), "Start a play session before checking navigation")
	local results = {}
	for _, test in
		{
			{ "Recruit Avenue", "S1", "S4" },
			{ "Residential alley", "S8", "B3" },
			{ "Courtyard to housing", "S11", "B4" },
			{ "Housing upper floor", "B3", "U3" },
			{ "Barracks upper floor", "B1", "U1" },
			{ "Workshop West", "S10", "B7" },
			{ "Market cross avenue", "S10", "S13" },
			{ "Underground entry", "S8", "D1" },
			{ "Underground loop", "D1", "D6" },
		}
	do
		local path = Pathfinding:CreatePath({
			AgentRadius = Agent.AgentRadius,
			AgentHeight = Agent.AgentHeight,
			AgentCanJump = Agent.AgentCanJump,
			WaypointSpacing = Agent.WaypointSpacing,
		})
		local ok, err = pcall(function()
			path:ComputeAsync(Plan.Nodes[test[2]] + Vector3.new(0, 3, 0), Plan.Nodes[test[3]] + Vector3.new(0, 3, 0))
		end)
		local success = ok and path.Status == Enum.PathStatus.Success
		table.insert(
			results,
			{ Route = test[1], Success = success, Error = if ok then tostring(path.Status) else tostring(err) }
		)
		print(
			"Phase A navigation",
			test[1],
			if success then "PASS" else "FAIL",
			if ok then tostring(path.Status) else tostring(err)
		)
		path:Destroy()
		task.wait(0.1)
	end
	return results
end

return Check
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Networking</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">ActionRouter</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local Protocol = require(Shared:WaitForChild("Networking"):WaitForChild("Protocol"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local Services = script.Parent.Parent.Services
local Movement = require(Services.MovementService)
local Combat = require(Services.CombatService)
local Magic = require(Services.MagicService)
local Equipment = require(Services.EquipmentService)
local CityConfig = require(Shared.Configuration.CityLife)
local Opening = require(Services.OpeningService)
local Router = {}

function Router.start()
	local folder = Instance.new("Folder")
	folder.Name = Protocol.Folder
	local request = Instance.new("RemoteEvent")
	request.Name = Protocol.Request
	request.Parent = folder
	local feedback = Instance.new("RemoteEvent")
	feedback.Name = Protocol.Feedback
	feedback.Parent = folder
	Opening.start(folder, feedback)

	local states: { [Player]: Types.PlayerState } = {}
	local limits: { [Player]: { Tokens: number, Updated: number, Sequence: number } } = {}
	local connections: { [Player]: { RBXScriptConnection } } = {}

	local function bind(player: Player)
		limits[player] = { Tokens = Config.Networking.Burst, Updated = os.clock(), Sequence = 0 }
		Magic.bind(player)
		Equipment.bind(player)
		Opening.bind(player)
		local function characterAdded(character: Model)
			if player.Character ~= character then
				return
			end
			states[player] = nil
			player:SetAttribute("CharacterReady", false)
			Magic.reset(player)
			local humanoid = character:WaitForChild("Humanoid", 10)
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if
				player.Character ~= character
				or not humanoid
				or not humanoid:IsA("Humanoid")
				or not root
				or not root:IsA("BasePart")
				or not limits[player]
			then
				return
			end
			-- CharacterAdded precedes parenting, rig scaling, and final spawn placement.
			-- Do not seed a movement anchor from the provisional character transform.
			local deadline = os.clock() + Config.Movement.CharacterReadyTimeout
			while not root:IsDescendantOf(workspace) do
				if player.Character ~= character or not limits[player] or humanoid.Health <= 0 then
					return
				end
				if os.clock() >= deadline then
					warn("Sandbox: character did not enter Workspace for " .. player.Name)
					return
				end
				RunService.Heartbeat:Wait()
			end
			if player.Character ~= character or not limits[player] or humanoid.Health <= 0 then
				return
			end
			Opening.prepareCharacter(player, character)
			local now = workspace:GetServerTimeNow()
			humanoid.MaxHealth = Config.Player.MaxHealth
			humanoid.Health = Config.Player.MaxHealth
			humanoid.WalkSpeed = Config.Movement.WalkSpeed
			character:SetAttribute("MagicWalkSpeedBonus", 0)
			character:SetAttribute("MagicSpeedMultiplier", 1)
			character:SetAttribute("MagicJumpPowerBonus", 0)
			states[player] = {
				Character = character,
				Humanoid = humanoid,
				Root = root,
				Sprinting = false,
				MagicWalkSpeedBonus = 0,
				MagicSpeedMultiplier = 1,
				MagicJumpPowerBonus = 0,
				DashUntil = 0,
				DashReadyAt = 0,
				DashCheckUntil = 0,
				DashOrigin = nil,
				LastPosition = root.Position,
				LastFramePosition = root.Position,
				LastCheck = now,
				DashAllowance = 0,
				CorrectionUntil = 0,
				SpawnGraceUntil = now + Config.Movement.SpawnValidationGrace,
				Combo = 0,
				ReadyAt = 0,
				ComboExpires = 0,
				Attack = nil,
				ActiveAt = 0,
				ActiveUntil = 0,
				HitTargets = {},
			}
			Equipment.characterAdded(player, feedback)
			player:SetAttribute("CharacterReady", true)
		end
		connections[player] = {
			player.CharacterAdded:Connect(characterAdded),
			player.CharacterRemoving:Connect(function(character)
				local state = states[player]
				if state and state.Character == character then
					states[player] = nil
				end
			end),
		}
		if player.Character then
			task.spawn(characterAdded, player.Character)
		end
	end

	Players.PlayerAdded:Connect(bind)
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
		limits[player] = nil
		Magic.remove(player)
		Equipment.remove(player)
		Opening.remove(player)
		for _, connection in connections[player] or {} do
			connection:Disconnect()
		end
		connections[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		bind(player)
	end

	request.OnServerEvent:Connect(function(player: Player, payload: any)
		local limit = limits[player]
		if not limit or not player:GetAttribute("OpeningComplete") then
			return
		end
		local clock = os.clock()
		limit.Tokens = math.min(
			Config.Networking.Burst,
			limit.Tokens + (clock - limit.Updated) * Config.Networking.RequestsPerSecond
		)
		limit.Updated = clock
		if limit.Tokens < 1 then
			return
		end
		limit.Tokens -= 1
		if typeof(payload) ~= "table" then
			return
		end
		local sequence = payload.Sequence
		if
			typeof(sequence) ~= "number"
			or sequence ~= sequence
			or sequence % 1 ~= 0
			or sequence <= limit.Sequence
			or sequence > Config.Networking.MaxSequence
		then
			return
		end
		limit.Sequence = sequence
		local action = payload.Action
		if
			action ~= Protocol.Sprint
			and action ~= Protocol.Dash
			and action ~= Protocol.Light
			and action ~= Protocol.MagicStart
			and action ~= Protocol.MagicRelease
			and action ~= Protocol.EquipmentSwitch
			and action ~= Protocol.EquipmentUse
		then
			return
		end
		local state = states[player]
		if
			not state
			or payload.Character ~= state.Character
			or state.Humanoid.Health <= 0
			or not state.Root:IsDescendantOf(workspace)
		then
			if payload.Character == player.Character then
				feedback:FireClient(player, {
					Kind = "Action",
					Action = action,
					Sequence = sequence,
					Character = player.Character,
					Accepted = false,
					Combo = 0,
					ReadyAt = 0,
					DashReadyAt = 0,
					Sprinting = false,
				})
			end
			return
		end
		local now = workspace:GetServerTimeNow()
		local accepted = false
		local validPosition = true
		if action == Protocol.Sprint and typeof(payload.Sprinting) == "boolean" then
			Movement.sprint(state, payload.Sprinting)
			accepted = true
		elseif action == Protocol.Light then
			validPosition = Movement.update(player, state, now, feedback)
			accepted = validPosition and Equipment.meleeActive(player) and Combat.request(state, now)
		elseif action == Protocol.Dash and validPosition then
			local direction = payload.Direction
			if
				typeof(direction) == "Vector3"
				and direction.X == direction.X
				and direction.Z == direction.Z
				and math.abs(direction.Y) < Config.Movement.DirectionEpsilon
				and direction.Magnitude > 0.9
				and direction.Magnitude < 1.1
			then
				accepted = Movement.dash(state, now)
				validPosition = Movement.update(player, state, now, feedback)
				accepted = accepted and validPosition
			end
		elseif action == Protocol.MagicStart and RunService:IsStudio() and CityConfig.DevelopmentSpells then
			Magic.start(player, state, payload, feedback)
			accepted = true
		elseif action == Protocol.MagicRelease and RunService:IsStudio() and CityConfig.DevelopmentSpells then
			Magic.release(player, state, payload, feedback)
			accepted = true
		elseif action == Protocol.EquipmentSwitch then
			accepted = Equipment.switch(player, payload.EquipmentSlot, feedback)
		elseif action == Protocol.EquipmentUse and now >= state.DashUntil then
			local spellId, castContext = Equipment.magicCast(player, payload.EquipmentAction)
			if spellId then
				Magic.start(player, state, {
					SpellId = spellId,
					AimDirection = payload.AimDirection,
					WorldPoint = payload.WorldPoint,
				}, feedback, castContext)
				accepted = true
			end
		end
		feedback:FireClient(player, {
			Kind = "Action",
			Action = action,
			Sequence = sequence,
			Character = state.Character,
			Accepted = accepted,
			Combo = state.Combo,
			ReadyAt = state.ReadyAt,
			DashReadyAt = state.DashReadyAt,
			Sprinting = state.Sprinting,
		})
		if accepted and action == Protocol.Light then
			feedback:FireAllClients({ Kind = "Swing", Character = state.Character, Combo = state.Combo })
		end
	end)

	RunService.Heartbeat:Connect(function()
		local now = workspace:GetServerTimeNow()
		for player, state in states do
			if state.Humanoid.Health <= 0 or not state.Root:IsDescendantOf(workspace) then
				states[player] = nil
			elseif Movement.update(player, state, now, feedback) then
				Combat.update(player, state, now, feedback)
			end
		end
	end)
	-- Publish only after listeners are connected.
	folder.Parent = Shared
end

return Router
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">AmbientEnemyService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Topology = require(Shared.Configuration.PhaseATopology)
local Locations = require(Shared.Configuration.AssignmentLocations)
local Config = require(Shared.Configuration.Navigation).Ambient
local Enemy = require(script.Parent.EnemyService)
local Runtime = require(script.Parent.EnemyRuntime)
local Spawn = require(script.Parent.WorldSpawnService)
local Ambient = {}

function Ambient.start()
	if not Config.Enabled then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "AmbientEnfleshed"
	folder.Parent = workspace
	local entries: { { Handle: Enemy.Handle, Candidate: string } } = {}
	local used: { [string]: number } = {}
	local nextSpawn, nextScan = 0, 0
	local function nearest(position: Vector3): number
		local result = math.huge
		for _, player in Players:GetPlayers() do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if player:GetAttribute("OpeningComplete") and root and root:IsA("BasePart") then
				result = math.min(result, (root.Position - position).Magnitude)
			end
		end
		return result
	end
	local function candidate(now: number): (string?, Vector3?)
		for offset = 1, #Topology.SpawnCandidates do
			local item = Topology.SpawnCandidates[(math.floor(now) + offset - 1) % #Topology.SpawnCandidates + 1]
			local position = (item.Position or Topology.Nodes[item.Node]) + item.Offset
			local distance = nearest(position)
			if
				Spawn.safe(position, Config.SafeZoneRadius)
				and distance >= Config.MinimumPlayerDistance
				and distance <= Config.MaximumPlayerDistance
				and (used[item.Id] or 0) <= now
			then
				local grounded = Spawn.ground(position)
				if grounded then
					return item.Id, grounded
				end
			end
		end
		return nil, nil
	end
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextScan then
			return
		end
		nextScan = now + 1
		for index = #entries, 1, -1 do
			local entry = entries[index]
			if
				not entry.Handle.IsAlive()
				or nearest(entry.Handle.Model:GetPivot().Position) > Config.DespawnDistance
			then
				entry.Handle.Destroy()
				table.remove(entries, index)
			end
		end
		if #entries < Config.Cap and now >= nextSpawn then
			nextSpawn = now + Config.SpawnInterval
			local id, position = candidate(now)
			if id and position then
				local handle = Runtime.create(position, folder)
				handle.Model.Name = "AmbientNascent_" .. id
				handle.Model:SetAttribute("Population", "Ambient")
				handle.Model:SetAttribute("SpawnCandidate", id)
				table.insert(entries, { Handle = handle, Candidate = id })
				used[id] = now + Config.MinimumCandidateReuseSeconds
			end
		end
	end)
end

return Ambient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">AssignmentService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Definitions = require(Shared.Configuration.Assignments)
local Locations = require(Shared.Configuration.AssignmentLocations)
local Enemy = require(script.Parent.EnemyService)
local Runtime = require(script.Parent.EnemyRuntime)

local Assignments = {}
type State = {
	Id: string,
	Status: string,
	Location: string,
	Step: number,
	Enemies: { Enemy.Handle },
	Rewarded: boolean,
	Prop: BasePart?,
}
local states: { [Player]: State } = {}

local function prompt(part: BasePart, text: string, action: string, callback: (Player) -> ())
	local p = Instance.new("ProximityPrompt")
	p.ActionText, p.ObjectText, p.HoldDuration, p.MaxActivationDistance = action, text, 0, 10
	p.Parent = part
	p.Triggered:Connect(callback)
	return p
end

local function marker(parent: Instance, name: string, position: Vector3, color: Color3): BasePart
	local part = Instance.new("Part")
	part.Name, part.Size, part.Position = name, Vector3.new(3, 4, 3), position + Vector3.new(0, 2, 0)
	part.Anchored, part.CanCollide, part.Material, part.Color = true, false, Enum.Material.Neon, color
	part.Parent = parent
	return part
end

local function publish(player: Player)
	local state = states[player]
	player:SetAttribute("AssignmentId", state and state.Id or "")
	player:SetAttribute("AssignmentState", state and state.Status or "Available")
	player:SetAttribute("AssignmentLocation", state and state.Location or "Barracks_Main")
	player:SetAttribute("AssignmentStep", state and state.Step or 0)
	player:SetAttribute("AssignmentEnemies", state and #state.Enemies or 0)
end

local function cleanup(player: Player)
	local state = states[player]
	if not state then
		return
	end
	if state.Prop then
		state.Prop:Destroy()
	end
	for _, enemy in state.Enemies do
		enemy.Destroy()
	end
	states[player] = nil
	publish(player)
end

local function choose(definition: any, player: Player): string
	local options = definition.Destinations or definition.Route
	return options[(player.UserId % #options) + 1]
end

local function setReturn(player: Player)
	local state = states[player]
	if not state then
		return
	end
	state.Status = "ReturnRequired"
	if state.Prop then
		state.Prop:Destroy()
		state.Prop = nil
	end
	publish(player)
end

local function spawnEncounter(player: Player, state: State, count: number)
	local center = Locations[state.Location].Position
	for i = 1, count do
		local handle = Runtime.create(
			center + Vector3.new((i - 1) * 7 - 3.5, 4, 8),
			workspace:WaitForChild("RecruitAssignments"):WaitForChild("Encounters")
		)
		handle.Model:SetAttribute("AssignmentOwner", player.UserId)
		handle.Model:SetAttribute("AssignmentId", state.Id)
		table.insert(state.Enemies, handle)
	end
end

local function activate(player: Player, state: State)
	local definition = Definitions[state.Id]
	if definition.AssignmentType == "ClearInfestation" then
		state.Status = "Active"
		spawnEncounter(player, state, definition.EnemyCount)
	elseif definition.AssignmentType == "DefendPosition" then
		state.Status = "Active"
		spawnEncounter(player, state, 1)
	else
		state.Step += 1
		if definition.AssignmentType == "Patrol" and state.Step < #definition.Route then
			state.Location = definition.Route[state.Step + 1]
			local loc = Locations[state.Location]
			state.Prop =
				marker(workspace.RecruitAssignments, "AssignmentObjective", loc.Position, Color3.fromRGB(255, 215, 95))
			prompt(state.Prop, loc.Name, "Inspect", function(who)
				if who == player then
					activate(player, state)
				end
			end)
		else
			setReturn(player)
		end
	end
	publish(player)
end

local function accept(player: Player, id: string)
	if states[player] or not Definitions[id] then
		return
	end
	local definition = Definitions[id]
	local location = choose(definition, player)
	local state: State =
		{ Id = id, Status = "Active", Location = location, Step = 0, Enemies = {}, Rewarded = false, Prop = nil }
	states[player] = state
	local loc = Locations[location]
	state.Prop = marker(workspace.RecruitAssignments, "AssignmentObjective", loc.Position, Color3.fromRGB(255, 215, 95))
	prompt(
		state.Prop,
		loc.Name,
		definition.AssignmentType == "DefendPosition" and "Activate" or "Complete",
		function(who)
			if who == player and states[player] == state and state.Status == "Active" then
				activate(player, state)
			end
		end
	)
	publish(player)
end

function Assignments.start()
	local folder = Instance.new("Folder")
	folder.Name = "RecruitAssignments"
	folder.Parent = workspace
	local encounters = Instance.new("Folder")
	encounters.Name = "Encounters"
	encounters.Parent = folder
	local barracks = Locations.Barracks_Main.Position
	local offerIds = { "Patrol", "SupplyDelivery", "Investigation", "ClearInfestation", "DefendPosition" }
	local offerCursor = 1
	local slots: { { Prompt: ProximityPrompt, Id: string } } = {}
	local function refreshOffers()
		for index, slot in slots do
			slot.Id = offerIds[(offerCursor + index - 2) % #offerIds + 1]
			slot.Prompt.ObjectText = Definitions[slot.Id].Name
		end
		offerCursor = offerCursor % #offerIds + 1
	end
	for index = 1, 3 do
		local board = marker(
			folder,
			"AssignmentBoard" .. index,
			barracks + Vector3.new((index - 2) * 5, 0, -8),
			Color3.fromRGB(90, 150, 210)
		)
		local slot = { Prompt = nil :: any, Id = "" }
		slot.Prompt = prompt(board, "Assignment", "Accept", function(player)
			accept(player, slot.Id)
			refreshOffers()
		end)
		table.insert(slots, slot)
	end
	refreshOffers()
	local turnIn = marker(folder, "AssignmentTurnIn", barracks + Vector3.new(0, 0, 7), Color3.fromRGB(110, 220, 130))
	prompt(turnIn, "Assignment Office", "Turn In / Abandon", function(player)
		local state = states[player]
		if state and state.Status == "ReturnRequired" and not state.Rewarded then
			state.Rewarded = true
			player:SetAttribute(
				"MilitaryScrip",
				(player:GetAttribute("MilitaryScrip") or 0) + Definitions[state.Id].Reward
			)
			cleanup(player)
		elseif state then
			cleanup(player)
		end
	end)
	local medical = marker(folder, "BarracksMedical", barracks + Vector3.new(-8, 0, 7), Color3.fromRGB(180, 240, 255))
	prompt(medical, "Barracks Medical", "Recover", function(player)
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if h then
			h.Health = h.MaxHealth
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		player:SetAttribute("MilitaryScrip", player:GetAttribute("MilitaryScrip") or 0)
		publish(player)
		player.CharacterAdded:Connect(function(character)
			local h = character:WaitForChild("Humanoid", 10)
			if h then
				h.Died:Connect(function()
					cleanup(player)
				end)
			end
		end)
	end)
	Players.PlayerRemoving:Connect(cleanup)
	for _, player in Players:GetPlayers() do
		player:SetAttribute("MilitaryScrip", player:GetAttribute("MilitaryScrip") or 0)
		publish(player)
	end
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for player, state in states do
			for index = #state.Enemies, 1, -1 do
				if not state.Enemies[index].IsAlive() then
					state.Enemies[index].Destroy()
					table.remove(state.Enemies, index)
				end
			end
			if
				state.Status == "Active"
				and #state.Enemies == 0
				and (state.Id == "ClearInfestation" or state.Id == "DefendPosition")
			then
				if state.Id == "DefendPosition" and state.Step == 0 then
					state.Step = 1
					spawnEncounter(player, state, 1)
				else
					setReturn(player)
				end
			end
			publish(player)
		end
	end)
end

return Assignments
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">CityPopulationLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Pure placement plan. Each ambient slot has a distinct home; events retain their own routes.
local Layout = {}
function Layout.build(plan, base, fronts, target)
	local roster = {}
	for _, entry in ipairs(base) do
		if #roster >= target then
			return roster
		end
		table.insert(roster, entry)
	end
	for _, front in ipairs(fronts) do
		if front.Enterable and #roster < target then
			table.insert(roster, {
				Name = front.Kind == "Workshop" and "Artisan" or "Merchant",
				Role = front.Kind == "Workshop" and "Worker" or "Shopkeeper",
				Nodes = { "S1", "S1" },
				Position = front.Home,
				District = "StreetFront",
			})
		end
	end
	local segments = {}
	for _, edge in ipairs(plan.Edges) do
		if edge.Kind == "Street" then
			local points = edge.Points or { plan.Nodes[edge[1]], plan.Nodes[edge[2]] }
			for i = 2, #points do
				local a, b = points[i - 1], points[i]
				local dx, dz = b.X - a.X, b.Z - a.Z
				local length = math.sqrt(dx * dx + dz * dz)
				if a.Y == 0 and b.Y == 0 and length >= 50 then
					table.insert(segments, { A = a, B = b, Length = length, Width = edge.Width })
				end
			end
		end
	end
	-- Round-robin across the district before adding a second person to a segment.
	for pass = 1, 4 do
		for i, segment in ipairs(segments) do
			if #roster >= target then
				return roster
			end
			local t = ({ 0.35, 0.7, 0.15, 0.9 })[pass]
			local a, b = segment.A, segment.B
			local side = (i % 2 == 0 and 1 or -1) * (segment.Width / 2 - 4)
			local x = a.X + (b.X - a.X) * t - (b.Z - a.Z) / segment.Length * side
			local z = a.Z + (b.Z - a.Z) * t + (b.X - a.X) / segment.Length * side
			local district = z >= 1380 and "Recruit" or (math.abs(x) > 200 and "Residential" or "Market")
			local roles = district == "Recruit" and { "Recruit", "Guard", "Recruit" }
				or (
					district == "Residential" and { "Resident", "Civilian", "Resident" }
					or { "Worker", "Civilian", "Shopkeeper" }
				)
			local role = roles[(i + pass - 2) % #roles + 1]
			table.insert(roster, {
				Name = role,
				Role = role,
				Nodes = { "S1", "S1" },
				Position = { X = x, Y = 0, Z = z },
				District = district,
			})
		end
	end
	return roster
end
return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local HitDetection = require(script.Parent.HitDetectionService)
local Damage = require(script.Parent.DamageService)
local Enemy = require(script.Parent.EnemyService)
local Combat = {}

function Combat.request(state: Types.PlayerState, now: number): boolean
	if now < state.ReadyAt or now < state.DashUntil or now < state.CorrectionUntil then
		return false
	end
	state.Combo = if now > state.ComboExpires then 1 else state.Combo % #Config.Combat.Attacks + 1
	local attack = Config.Combat.Attacks[state.Combo]
	state.Attack = attack
	state.ActiveAt = now + attack.Startup
	state.ActiveUntil = state.ActiveAt + attack.Active
	state.ReadyAt = state.ActiveUntil + attack.Recovery
	state.ComboExpires = state.ReadyAt + Config.Combat.ComboReset
	state.HitTargets = {}
	return true
end

function Combat.update(player: Player, state: Types.PlayerState, now: number, feedback: RemoteEvent)
	local attack = state.Attack
	if not attack then
		return
	end
	if now > state.ActiveUntil then
		state.Attack = nil
		return
	end
	if now < state.ActiveAt then
		return
	end
	local origin = state.Root.CFrame
	for _, target in
		HitDetection.find(state.Character, origin, origin * CFrame.new(0, 0, -attack.Offset), attack.Size, {
			OverlapCollisionGroup = Config.Combat.OverlapCollisionGroup,
			MaxDistance = attack.Reach,
			MinimumFacingDot = Config.Combat.MinimumFacingDot,
			RequireLineOfSight = true,
		})
	do
		if state.HitTargets[target] then
			continue
		end
		state.HitTargets[target] = true
		local amount = Damage.apply(state.Character, target, attack.Damage)
		if amount > 0 then
			-- Only the recruit finisher is significant. Ordinary lights damage a
			-- Nascent without stopping its committed pressure.
			Enemy.onHit(target, if state.Combo == #Config.Combat.Attacks then "Significant" else "Minor")
			local hit: Types.HitResult = { Target = target.Parent :: Model, Damage = amount, Health = target.Health }
			feedback:FireClient(player, {
				Kind = "Hit",
				Character = state.Character,
				Target = hit.Target,
				Damage = hit.Damage,
				Health = hit.Health,
			})
		end
	end
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">DamageService</string>
            <string name="Source"><![CDATA[--!strict

local applied = Instance.new("BindableEvent")
local Damage = { Applied = applied.Event }

function Damage.apply(attacker: Model, target: Humanoid, amount: number): number
	if target.Parent == attacker or target.Health <= 0 or not target:IsDescendantOf(workspace) then
		return 0
	end
	local before = target.Health
	target:TakeDamage(amount)
	local dealt = math.max(0, before - target.Health)
	if dealt > 0 then
		applied:Fire(attacker, target, dealt)
	end
	return dealt
end

return Damage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">EnemyRuntime</string>
            <string name="Source"><![CDATA[--!strict
-- Shared admission/scheduling, independent from population ownership.
local Physics = game:GetService("PhysicsService")
local Run = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Configuration.Sandbox)
local Enemy = require(script.Parent.EnemyService)
local Runtime = { Group = "SandboxStressEnemies" }
local handles: { Enemy.Handle } = {}
local started, inFlight, cursor, nextPath = false, 0, 0, 0

function Runtime.start()
	if started then
		return
	end
	started = true
	local visual, query = Config.Enemy.VisualCollisionGroup, Config.Combat.OverlapCollisionGroup
	for _, group in { Runtime.Group, visual, query } do
		if not Physics:IsCollisionGroupRegistered(group) then
			Physics:RegisterCollisionGroup(group)
		end
	end
	Physics:CollisionGroupSetCollidable(Runtime.Group, Runtime.Group, Config.StressTest.EnemyCollisions)
	Physics:CollisionGroupSetCollidable(Runtime.Group, "Default", true)
	Physics:CollisionGroupSetCollidable(visual, "Default", false)
	Physics:CollisionGroupSetCollidable(visual, Runtime.Group, false)
	Physics:CollisionGroupSetCollidable(visual, visual, false)
	Physics:CollisionGroupSetCollidable(query, visual, true)
	Physics:CollisionGroupSetCollidable(query, "Default", true)
	Physics:CollisionGroupSetCollidable(query, Runtime.Group, false)
	Run.Heartbeat:Connect(function()
		local now = os.clock()
		for i = #handles, 1, -1 do
			local handle = handles[i]
			if not handle.Model.Parent or not handle.IsAlive() then
				table.remove(handles, i)
			else
				handle.Update(now)
			end
		end
		if #handles == 0 or now < nextPath or inFlight >= Config.StressTest.MaxPathsInFlight then
			return
		end
		for _ = 1, #handles do
			cursor = cursor % #handles + 1
			local job = handles[cursor].TakePathJob()
			if job then
				inFlight += 1
				nextPath = now + 1 / Config.StressTest.PathStartsPerSecond
				task.spawn(function()
					local ok, err = pcall(job)
					inFlight -= 1
					if not ok then
						warn(err)
					end
				end)
				break
			end
		end
	end)
end

function Runtime.create(position: Vector3, folder: Folder): Enemy.Handle
	Runtime.start()
	local handle =
		Enemy.create(position, folder, Runtime.Group, (#handles % 10) * 0.01, 1 / Config.StressTest.HitQueryRate)
	table.insert(handles, handle)
	return handle
end

return Runtime
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">EnemyService</string>
            <string name="Source"><![CDATA[--!strict

local Collection = game:GetService("CollectionService")
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sandbox = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local Config = Sandbox.Enemy
local Damage = require(script.Parent.DamageService)
local HitDetection = require(script.Parent.HitDetectionService)
local AttackSelector = require(script.Parent.NascentAttackSelector)
local Enemy = {}
local hitReactions: { [Humanoid]: (string) -> () } = {}

-- One synchronous reaction for this basic enemy; no status-effect bus or registry of effects.
function Enemy.onLightHit(humanoid: Humanoid)
	local react = hitReactions[humanoid]
	if react then
		react("Minor")
	end
end

function Enemy.onHit(humanoid: Humanoid, strength: string)
	local react = hitReactions[humanoid]
	if react then
		react(strength)
	end
end

type State = "Idle" | "Chase" | "Telegraph" | "Attack" | "Recover" | "Vulnerable" | "Flinch" | "Dead"

-- One local placeholder rig, with no asset request, animation package, or spawn manager.
local function createRig(
	position: Vector3,
	container: Folder,
	collisionGroup: string
): (Model, Humanoid, BasePart, TextLabel, (string, number) -> ())
	local model = Instance.new("Model")
	model.Name = "Stage1Enfleshed"
	Collection:AddTag(model, "Enfleshed")
	local function part(name: string, size: Vector3, offset: Vector3, color: Color3?): Part
		local result = Instance.new("Part")
		result.Name = name
		result.Size = size
		result.Position = position + offset
		result.Color = color or Color3.fromRGB(130, 65, 70)
		result.Material = Enum.Material.SmoothPlastic
		result.CanCollide = false
		result.CanTouch = false
		result.Massless = name ~= "HumanoidRootPart"
		result.CollisionGroup = Config.VisualCollisionGroup
		result.Parent = model
		return result
	end
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.zero)
	root.Transparency = 1
	local torso = part("Torso", Vector3.new(3.2, 3.7, 1.75), Vector3.new(0, 0.3, 0), Color3.fromRGB(94, 42, 52))
	local head = part("Head", Vector3.new(1.9, 2.15, 1.8), Vector3.new(-0.18, 2.75, -0.35), Color3.fromRGB(145, 72, 76))
	head.Shape = Enum.PartType.Ball
	local function joint(name: string, parent: BasePart, limb: BasePart): Motor6D
		local motor = Instance.new("Motor6D")
		motor.Name = name
		motor.Part0 = parent
		motor.Part1 = limb
		motor.C0 = parent.CFrame:ToObjectSpace(limb.CFrame)
		motor.Parent = parent
		return motor
	end
	local rootJoint = joint("RootJoint", root, torso)
	local neck = joint("Neck", torso, head)
	local leftShoulder = joint(
		"Left Shoulder",
		torso,
		part("Left Arm", Vector3.new(1.45, 3.7, 1.3), Vector3.new(-2.25, 0.05, -0.15), Color3.fromRGB(121, 55, 71))
	)
	local rightShoulder = joint(
		"Right Shoulder",
		torso,
		part("Right Arm", Vector3.new(1.8, 4.5, 1.55), Vector3.new(2.4, -0.25, -0.5), Color3.fromRGB(151, 61, 67))
	)
	local leftHip = joint(
		"Left Hip",
		torso,
		part("Left Leg", Vector3.new(1.2, 3, 1.2), Vector3.new(-0.65, -2.9, 0), Color3.fromRGB(90, 42, 55))
	)
	local rightHip = joint(
		"Right Hip",
		torso,
		part("Right Leg", Vector3.new(1.2, 3, 1.2), Vector3.new(0.65, -2.9, 0), Color3.fromRGB(90, 42, 55))
	)
	-- The humanoid joints remain the animatable foundation. These welded growths
	-- only distort the silhouette into an asymmetrical, once-human Nascent.
	local function growth(name: string, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?)
		local piece = part(name, size, Vector3.zero, color)
		piece.Shape = shape or Enum.PartType.Block
		piece.CFrame = torso.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = torso
		weld.Part1 = piece
		weld.Parent = piece
	end
	growth(
		"ShoulderGrowth",
		Vector3.new(2.25, 1.45, 2.1),
		CFrame.new(-1.35, 1.05, 0.15),
		Color3.fromRGB(112, 49, 62),
		Enum.PartType.Ball
	)
	growth(
		"RibGrowth",
		Vector3.new(1.15, 2.4, 0.75),
		CFrame.new(1.5, -0.2, -0.6) * CFrame.Angles(0, 0, -0.35),
		Color3.fromRGB(128, 57, 62)
	)
	growth(
		"BackMass",
		Vector3.new(2.4, 2.7, 1.25),
		CFrame.new(0.5, 0.1, 1.1) * CFrame.Angles(0.2, 0.25, 0),
		Color3.fromRGB(69, 31, 42),
		Enum.PartType.Ball
	)
	growth(
		"JawGrowth",
		Vector3.new(1.4, 0.65, 1.1),
		CFrame.new(-0.1, 1.45, -0.85),
		Color3.fromRGB(173, 83, 83),
		Enum.PartType.Ball
	)
	local hull = Instance.new("Part")
	hull.Name = "CollisionHull"
	hull.Shape = Enum.PartType.Cylinder
	-- Cylinders run along local X; rotate upright. The flat cap is above normal jump height.
	hull.Size = Vector3.new(Config.CollisionHull.Height, Config.CollisionHull.Diameter, Config.CollisionHull.Diameter)
	hull.CFrame = root.CFrame * CFrame.new(0, Config.CollisionHull.CenterOffsetY, 0) * CFrame.Angles(0, 0, math.pi / 2)
	hull.Transparency = 1
	hull.Massless = true
	hull.CanCollide = true
	hull.CanTouch = false
	hull.CollisionGroup = collisionGroup
	hull.CustomPhysicalProperties = PhysicalProperties.new(0.7, Config.CollisionHull.Friction, 0, 100, 100)
	hull.Parent = model
	local hullWeld = Instance.new("WeldConstraint")
	hullWeld.Part0 = root
	hullWeld.Part1 = hull
	hullWeld.Parent = hull
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R6
	humanoid.HipHeight = 0
	humanoid.MaxHealth = Config.Health
	humanoid.Health = Config.Health
	humanoid.WalkSpeed = Config.WalkSpeed
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model
	model.PrimaryPart = root
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(240, 48)
	gui.StudsOffset = Vector3.new(0, 2, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 55
	gui.Parent = head
	local label = Instance.new("TextLabel")
	label.Name = "NameLabel"
	label.Size = UDim2.fromScale(1, 0.5)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.TextSize = 16
	label.Parent = gui
	local bar = Instance.new("Frame")
	bar.Name = "HealthBack"
	bar.Size = UDim2.fromScale(0.7, 0.14)
	bar.Position = UDim2.fromScale(0.15, 0.62)
	bar.BorderSizePixel, bar.BackgroundColor3 = 0, Color3.fromRGB(20, 20, 20)
	bar.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "HealthFill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BorderSizePixel, fill.BackgroundColor3 = 0, Color3.fromRGB(155, 58, 68)
	fill.Parent = bar
	model.Parent = container
	root:SetNetworkOwner(nil)
	local function pose(
		state: string,
		now: number,
		attack: string,
		step: number,
		desperate: boolean,
		majorFlinch: boolean
	)
		local breath = math.sin(now * (if desperate then 6 else 3))
		rootJoint.Transform = CFrame.new(0, breath * 0.055, 0.12) * CFrame.Angles(-0.16, 0, 0)
		neck.Transform = CFrame.Angles(0.18, breath * 0.1, -0.08)
		leftShoulder.Transform = CFrame.Angles(0.15, 0, 0.28)
		rightShoulder.Transform = CFrame.Angles(0.32, 0, -0.34)
		leftHip.Transform = CFrame.new()
		rightHip.Transform = CFrame.new()
		if state == "Chase" then
			local stride = math.sin(now * (if desperate then 13 else 10)) * 0.72
			rootJoint.Transform *= CFrame.Angles(-0.22, 0, 0)
			leftShoulder.Transform = CFrame.Angles(stride + 0.35, 0, 0.35)
			rightShoulder.Transform = CFrame.Angles(-stride - 0.6, 0, -0.52)
			leftHip.Transform = CFrame.Angles(-stride, 0, 0)
			rightHip.Transform = CFrame.Angles(stride, 0, 0)
		elseif state == "Telegraph" then
			if attack == "PredatoryLunge" then
				rootJoint.Transform = CFrame.new(0, -0.25, 0.45) * CFrame.Angles(0.52, 0, 0)
				leftShoulder.Transform = CFrame.Angles(-1.4, 0, 0.6)
				rightShoulder.Transform = CFrame.Angles(-1.6, 0, -0.7)
			elseif attack == "FrenziedChain" then
				rootJoint.Transform = CFrame.Angles(-0.38, 0, if step % 2 == 0 then -0.2 else 0.2)
				leftShoulder.Transform = CFrame.Angles(-1.05, 0, 0.7)
				rightShoulder.Transform = CFrame.Angles(-0.55, 0, -0.75)
			elseif attack == "MaulingCombination" then
				rootJoint.Transform = CFrame.Angles(-0.34, 0, if step == 3 then 0.25 else -0.16)
				leftShoulder.Transform = CFrame.Angles(-0.75, 0, 0.55)
				rightShoulder.Transform = CFrame.Angles(-1.1, 0, -0.55)
			else
				rootJoint.Transform = CFrame.Angles(-0.28, 0, 0)
				leftShoulder.Transform = CFrame.Angles(-0.65, 0, 0.45)
				rightShoulder.Transform = CFrame.Angles(-1.3, 0, -0.5)
			end
		elseif state == "Attack" then
			rootJoint.Transform = CFrame.new(0, 0, -0.25) * CFrame.Angles(-0.28, 0, 0)
			if attack == "FrenziedChain" then
				if step == 1 then
					rightShoulder.Transform = CFrame.Angles(1.5, 0, -0.6)
				elseif step == 2 then
					leftShoulder.Transform = CFrame.Angles(1.35, 0, 0.75)
				elseif step == 3 then
					rightShoulder.Transform = CFrame.Angles(1.1, 0, 0.8)
				else
					rootJoint.Transform *= CFrame.Angles(-0.28, 0, 0.35)
					leftShoulder.Transform = CFrame.Angles(1.5, 0, 1)
					rightShoulder.Transform = CFrame.Angles(1.55, 0, -0.8)
				end
			elseif attack == "PredatoryLunge" then
				rootJoint.Transform = CFrame.new(0, 0.15, -0.5) * CFrame.Angles(-0.55, 0, 0)
				leftShoulder.Transform = CFrame.Angles(1.2, 0, 0.6)
				rightShoulder.Transform = CFrame.Angles(1.35, 0, -0.7)
			elseif attack == "MaulingCombination" then
				leftShoulder.Transform = CFrame.Angles(if step == 2 then 0.55 else 1.15, 0, 0.8)
				rightShoulder.Transform = CFrame.Angles(if step == 3 then 1.65 else 0.85, 0, -0.8)
			else
				rightShoulder.Transform = CFrame.Angles(1.35, 0, -0.35)
				leftShoulder.Transform = CFrame.Angles(0.75, 0, 0.42)
			end
		elseif state == "Vulnerable" then
			rootJoint.Transform = CFrame.new(0, -0.3, 0.38) * CFrame.Angles(0.48, 0, 0.35)
			leftShoulder.Transform = CFrame.Angles(0.9, 0, 1.1)
			rightShoulder.Transform = CFrame.Angles(0.75, 0, -1.15)
		elseif state == "Flinch" then
			rootJoint.Transform =
				CFrame.Angles(if majorFlinch then 0.45 else 0.16, 0, if majorFlinch then -0.45 else -0.16)
			leftShoulder.Transform = CFrame.Angles(0.65, 0, 0.8)
			rightShoulder.Transform = CFrame.Angles(0.65, 0, -0.8)
		elseif state == "Dead" then
			rootJoint.Transform = CFrame.new(0, -1.1, 0.55) * CFrame.Angles(1.25, 0, -0.5)
		end
	end
	return model, humanoid, root, label, pose
end

export type Handle = {
	Model: Model,
	Update: (number) -> (),
	IsAlive: () -> boolean,
	Destroy: () -> (),
	TakePathJob: () -> (() -> ())?,
	HasPendingPath: () -> boolean,
}

function Enemy.create(
	position: Vector3,
	container: Folder,
	collisionGroup: string,
	thinkOffset: number,
	hitInterval: number
): Handle
	local model, humanoid, root, label, pose = createRig(position, container, collisionGroup)
	local state: State = "Idle"
	local target: Instance? = nil
	local nextThink = os.clock() + thinkOffset
	local nextHit = 0
	local activeAt, activeUntil, recoverUntil = 0, 0, 0
	local activeAttack: any? = nil
	local attackName = ""
	local attackStep, attackCount = 0, 0
	local attackHit = false
	local attackSerial = 0
	local lastAttack = ""
	local flinchUntil = 0
	local flinchMajor = false
	local flinchAfterAttack = false
	local resumeRecovery = false
	local committedOrigin = root.CFrame
	local committedBox = root.CFrame
	local hitTargets: { [Humanoid]: boolean } = {}
	local debugBox: Part? = nil
	local debugHighlight: Highlight? = nil
	local connections: { RBXScriptConnection } = {}
	local nav = Config.Navigation
	local path: Path? = nil
	local blockedConnection: RBXScriptConnection? = nil
	local waypoints: { PathWaypoint } = {}
	local waypointIndex = 1
	local pathGoal: Vector3? = nil
	local generation = 0
	local computing = false
	local pendingPath: (() -> ())? = nil
	local nextPath = 0
	local progressPosition = root.Position
	local progressAt = 0
	local stuck = false
	local lastUpdateAt = os.clock()

	local function turnToward(other: BasePart, maxRadians: number, pivotRadians: number?): boolean
		local flatTarget = Vector3.new(other.Position.X, root.Position.Y, other.Position.Z) - root.Position
		if flatTarget.Magnitude < 0.01 then
			return false
		end
		local current = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		if current.Magnitude < 0.01 then
			return false
		end
		current = current.Unit
		local desired = flatTarget.Unit
		local signed = math.atan2(current:Cross(desired).Y, math.clamp(current:Dot(desired), -1, 1))
		if pivotRadians and math.abs(signed) >= Config.Turning.PivotAngle then
			maxRadians = math.max(maxRadians, pivotRadians)
		end
		local turn = math.clamp(signed, -maxRadians, maxRadians)
		root.CFrame = CFrame.lookAt(root.Position, root.Position + current) * CFrame.Angles(0, turn, 0)
		return true
	end

	local function combatTurnRate(other: BasePart): number
		local distance = (other.Position - root.Position).Magnitude
		local turning = Config.Turning
		if distance <= turning.VeryCloseDistance then
			return turning.VeryCloseTurnRate
		elseif distance <= turning.CloseCombatDistance then
			return turning.CloseCombatTurnRate
		elseif distance <= turning.MidRangeDistance then
			return turning.MidRangeTurnRate
		end
		return turning.ChaseTurnRate
	end

	local function clearPath()
		pendingPath = nil
		model:SetAttribute("PathQueued", false)
		generation += 1 -- Any yielding ComputeAsync result from an earlier state is obsolete.
		if blockedConnection then
			blockedConnection:Disconnect()
			blockedConnection = nil
		end
		if path then
			path:Destroy()
			path = nil
		end
		waypoints = {}
		pathGoal = nil
		waypointIndex = 1
	end

	local function clearDebug()
		if debugBox then
			debugBox:Destroy()
			debugBox = nil
		end
		if debugHighlight then
			debugHighlight:Destroy()
			debugHighlight = nil
		end
	end

	local function display()
		label.Text = if Config.DebugLabels
			then string.format(
				"%s  %d/%d\n%s",
				model:GetAttribute("SandboxLabel") or "Nascent",
				humanoid.Health,
				humanoid.MaxHealth,
				state
			)
			else "Nascent"
		local fill = label.Parent
			and label.Parent:FindFirstChild("HealthBack")
			and label.Parent.HealthBack:FindFirstChild("HealthFill")
		if fill and fill:IsA("Frame") then
			fill.Size = UDim2.fromScale(math.max(0, humanoid.Health / humanoid.MaxHealth), 1)
		end
		model:SetAttribute("SandboxState", state)
		model:SetAttribute("NascentAttack", attackName)
		model:SetAttribute("NascentVulnerable", state == "Vulnerable")
		model:SetAttribute("NascentDesperate", humanoid.Health / humanoid.MaxHealth <= Config.DesperateHealthFraction)
	end

	local function setState(value: State)
		if state ~= value then
			state = value
			display()
		end
	end

	local function stopMoving()
		humanoid:MoveTo(root.Position)
		humanoid:Move(Vector3.zero)
	end

	local function targetRoot(subject: Instance?): BasePart?
		local character = if subject and subject:IsA("Player")
			then subject.Character
			elseif subject and subject:IsA("Model") then subject
			else nil
		if subject and subject:IsA("Player") and not subject:GetAttribute("OpeningComplete") then
			return nil
		end
		local health = if character then character:FindFirstChildOfClass("Humanoid") else nil
		local result = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if health and health.Health > 0 and result and result:IsA("BasePart") and result:IsDescendantOf(workspace) then
			return result
		end
		return nil
	end

	local function rayParams(character: Instance): RaycastParams
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { container, character }
		params.RespectCanCollide = true
		return params
	end

	local function visible(other: BasePart): boolean
		return workspace:Raycast(root.Position, other.Position - root.Position, rayParams(other.Parent :: Instance))
			== nil
	end

	local function die()
		if state == "Dead" then
			return
		end
		setState("Dead")
		pose("Dead", os.clock(), attackName, attackStep, false, false)
		hitReactions[humanoid] = nil
		clearPath()
		clearDebug()
		target = nil
		hitTargets = {}
		stopMoving()
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = true
		for _, connection in connections do
			connection:Disconnect()
		end
		-- The temporary coordinator retires this handle and removes the corpse.
		for _, item in model:GetDescendants() do
			if item:IsA("BasePart") then
				item.CanCollide = false
				item.CanQuery = false
			end
		end
	end

	local function beginFlinch(now: number, keepRecovery: boolean, duration: number?, major: boolean?)
		clearPath()
		clearDebug()
		stopMoving()
		humanoid.AutoRotate = false
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = true
		activeAt, activeUntil = 0, 0
		activeAttack = nil
		hitTargets = {}
		flinchAfterAttack = false
		flinchMajor = major == true
		resumeRecovery = keepRecovery
		if not keepRecovery then
			recoverUntil = 0
		end
		flinchUntil = now + (duration or Config.Reactions.Significant.Flinch)
		setState("Flinch")
	end

	hitReactions[humanoid] = function(strength: string)
		if state == "Dead" or humanoid.Health <= 0 then
			return
		end
		local reaction = Config.Reactions[strength] or Config.Reactions.Minor
		local now = os.clock()
		if state == "Vulnerable" then
			reaction = Config.Reactions.Major
		end
		if reaction.Flinch <= 0 then
			return
		end
		local committed = (state == "Telegraph" or state == "Attack") and now >= activeAt
		if committed and now < activeUntil and strength ~= "Major" then
			-- An already active strike finishes; it cannot be retroactively dodged by hitting.
			flinchAfterAttack = true
			return
		end
		beginFlinch(
			now,
			state == "Recover" or committed or (state == "Flinch" and resumeRecovery),
			reaction.Flinch,
			strength == "Major" or state == "Vulnerable"
		)
	end

	local function beginAttack(other: BasePart, name: string, now: number)
		local attacks = Config.Nascent
		activeAttack = attacks[name]
		if not activeAttack then
			return
		end
		clearPath()
		stopMoving()
		humanoid.AutoRotate = false
		local facing = Vector3.new(other.Position.X, root.Position.Y, other.Position.Z)
		if (facing - root.Position).Magnitude > 0 then
			root.CFrame = CFrame.lookAt(root.Position, facing)
		end
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = true -- Prevent contact physics from moving the committed strike.
		attackName = name
		attackStep = 1
		attackCount = activeAttack.Count or 1
		attackHit = false
		attackSerial += 1
		committedOrigin = root.CFrame
		committedBox = committedOrigin * CFrame.new(0, 0, -activeAttack.Offset)
		activeAt = now + activeAttack.Telegraph
		activeUntil = activeAt + activeAttack.Active
		local desperate = humanoid.Health / humanoid.MaxHealth <= Config.DesperateHealthFraction
		recoverUntil = activeUntil
			+ activeAttack.Recovery * (if desperate then Config.Nascent.DesperateRecoveryMultiplier else 1)
		hitTargets = {}
		nextHit = activeAt
		setState("Telegraph")
		if Config.DebugTelegraph and Config.DebugNascent then
			local box = Instance.new("Part")
			box.Name = "TemporaryEnemyAttackDebug"
			box.Size = activeAttack.Size
			box.CFrame = committedBox
			box.Anchored = true
			box.CanCollide = false
			box.CanTouch = false
			box.CanQuery = false
			box.Material = Enum.Material.Neon
			box.Color = Color3.fromRGB(255, 170, 40)
			box.Transparency = 0.7
			box.Parent = workspace
			debugBox = box
			local highlight = Instance.new("Highlight")
			highlight.Name = "TemporaryTelegraphDebug"
			highlight.Adornee = model
			highlight.FillColor = box.Color
			highlight.FillTransparency = 0.5
			highlight.Parent = model
			debugHighlight = highlight
		end
	end

	local function chooseAttack(distance: number): string?
		local desperate = humanoid.Health / humanoid.MaxHealth <= Config.DesperateHealthFraction
		return AttackSelector.choose(Config.Nascent, distance, lastAttack, attackSerial, desperate)
	end

	local function requestPath(_other: BasePart, now: number)
		if computing or pendingPath or now < nextPath then
			return
		end
		-- Keep a usable old route while waiting for the shared round-robin budget.
		pendingPath = function()
			local other = targetRoot(target)
			if state ~= "Chase" or not other then
				computing = false
				return
			end
			local token = generation
			local destination = other.Position
			local requestedTarget = target
			nextPath = os.clock() + nav.RepathInterval
			local candidate = PathfindingService:CreatePath({
				AgentRadius = nav.AgentRadius,
				AgentHeight = nav.AgentHeight,
				AgentCanJump = nav.AgentCanJump,
				WaypointSpacing = nav.WaypointSpacing,
			})
			local ok = pcall(function()
				candidate:ComputeAsync(root.Position, destination)
			end)
			computing = false
			local currentRoot = targetRoot(target)
			if
				not ok
				or candidate.Status ~= Enum.PathStatus.Success
				or state ~= "Chase"
				or token ~= generation
				or target ~= requestedTarget
				or not currentRoot
				or (currentRoot.Position - destination).Magnitude > nav.TargetMoveThreshold
			then
				candidate:Destroy()
				return
			end
			clearPath()
			path = candidate
			pathGoal = destination
			waypoints = candidate:GetWaypoints()
			waypointIndex = 2
			blockedConnection = candidate.Blocked:Connect(function(index)
				if index >= waypointIndex then
					clearPath()
					stopMoving()
				end
			end)
		end
		model:SetAttribute("PathQueued", true)
	end

	local function chase(other: BasePart, now: number, frameDelta: number)
		local targetDistance = (other.Position - root.Position).Magnitude
		local closeCombat = targetDistance <= Config.Turning.CloseCombatDistance
		humanoid.AutoRotate = not closeCombat
		if closeCombat then
			turnToward(other, combatTurnRate(other) * frameDelta, Config.Turning.PivotTurnRate * frameDelta)
		end
		if targetDistance <= Config.Turning.CloseStandoffDistance + nav.WaypointTolerance then
			-- Holding the intended melee standoff is progress, not a navigation stall.
			progressPosition = root.Position
			progressAt = now
			stuck = false
		elseif (root.Position - progressPosition).Magnitude >= nav.ProgressDistance then
			progressPosition = root.Position
			progressAt = now
			stuck = false
		elseif now - progressAt >= nav.StuckTime then
			stuck = true
			clearPath()
			progressAt = now
		end
		local travel = other.Position - root.Position
		local direct = workspace:Blockcast(
			root.CFrame * CFrame.new(0, Config.CollisionHull.CenterOffsetY, 0),
			nav.SweepSize,
			travel,
			rayParams(other.Parent :: Instance)
		) == nil
		if direct and not stuck then
			if path or computing or pendingPath then
				clearPath()
			end
			local horizontal = Vector3.new(other.Position.X - root.Position.X, 0, other.Position.Z - root.Position.Z)
			if horizontal.Magnitude <= Config.Turning.CloseStandoffDistance then
				-- At melee range, face and pressure instead of running through prey.
				stopMoving()
			else
				local destination = other.Position - horizontal.Unit * Config.Turning.CloseStandoffDistance
				humanoid:MoveTo(destination)
			end
			return
		end
		if not pathGoal or (other.Position - pathGoal).Magnitude >= nav.TargetMoveThreshold then
			requestPath(other, now)
		end
		local waypoint = waypoints[waypointIndex]
		while waypoint do
			local delta = waypoint.Position - root.Position
			if Vector3.new(delta.X, 0, delta.Z).Magnitude > nav.WaypointTolerance then
				break
			end
			waypointIndex += 1
			waypoint = waypoints[waypointIndex]
		end
		if waypoint then
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
			humanoid:MoveTo(waypoint.Position)
		else
			stopMoving()
			if path then
				clearPath()
			end
			requestPath(other, now)
		end
	end

	table.insert(connections, model:GetAttributeChangedSignal("SandboxLabel"):Connect(display))
	table.insert(connections, humanoid.HealthChanged:Connect(display))
	table.insert(connections, humanoid.Died:Connect(die))
	table.insert(connections, model.Destroying:Connect(die))
	local function update(now: number)
		if humanoid.Health <= 0 or not model:IsDescendantOf(workspace) then
			die()
			return
		end
		local frameDelta = math.min(0.1, math.max(0, now - lastUpdateAt))
		lastUpdateAt = now
		pose(
			state,
			now,
			attackName,
			attackStep,
			humanoid.Health / humanoid.MaxHealth <= Config.DesperateHealthFraction,
			flinchMajor
		)
		-- Timers are cheap; hit queries are capped separately from staggered navigation.
		if state == "Telegraph" or state == "Attack" then
			local other = targetRoot(target)
			if state == "Telegraph" and other and activeAttack then
				if activeAttack.TrackingByStrike then
					local tracking = activeAttack.TrackingByStrike[attackStep] or 0
					if
						(other.Position - root.Position).Magnitude <= activeAttack.TrackingEscapeRange
						and tracking > 0
					then
						turnToward(other, activeAttack.TrackingTurnRate * tracking * frameDelta)
					end
				elseif activeAttack.TelegraphTurnRate then
					local windupProgress =
						math.clamp((now - (activeAt - activeAttack.Telegraph)) / activeAttack.Telegraph, 0, 1)
					local rate = if windupProgress < (activeAttack.CommitFraction or 1)
						then activeAttack.TelegraphTurnRate
						else activeAttack.CommitTurnRate or 0
					turnToward(other, rate * frameDelta)
				end
			end
			if now >= activeUntil then
				if flinchAfterAttack then
					clearDebug()
					beginFlinch(now, true)
				elseif attackStep < attackCount then
					attackStep += 1
					hitTargets = {}
					activeAt = now + (activeAttack.StepGap or 0)
					activeUntil = activeAt + activeAttack.Active
					setState("Telegraph")
				elseif attackName == "FrenziedChain" then
					clearDebug()
					recoverUntil = now + activeAttack.Recovery
					setState("Vulnerable")
				elseif attackName == "PredatoryLunge" and not attackHit then
					clearDebug()
					recoverUntil = now + activeAttack.MissRecovery
					setState("Vulnerable")
				elseif attackName == "RushingStrike" and not attackHit and attackSerial % 2 == 0 then
					clearDebug()
					beginAttack(other or root, "ReversalSwipe", now)
				else
					clearDebug()
					lastAttack = attackName
					activeAttack = nil
					setState("Recover")
				end
			elseif now >= activeAt then
				if state ~= "Attack" then
					setState("Attack")
					-- Contact begins with the visible strike pose, before the first
					-- server hit query runs on this active window.
					pose(
						"Attack",
						now,
						attackName,
						attackStep,
						humanoid.Health / humanoid.MaxHealth <= Config.DesperateHealthFraction,
						flinchMajor
					)
					committedOrigin = root.CFrame
					committedBox = committedOrigin * CFrame.new(0, 0, -(activeAttack and activeAttack.Offset or 0))
					if debugBox then
						debugBox.Color = Color3.fromRGB(255, 55, 55)
					end
					if debugHighlight then
						debugHighlight.FillColor = Color3.fromRGB(255, 55, 55)
					end
				end
				if other and activeAttack then
					if activeAttack.TrackingByStrike then
						local tracking = activeAttack.TrackingByStrike[attackStep] or 0
						if
							(other.Position - root.Position).Magnitude <= activeAttack.TrackingEscapeRange
							and tracking > 0
						then
							turnToward(other, activeAttack.TrackingTurnRate * tracking * frameDelta)
						end
					elseif activeAttack.CommitTurnRate then
						turnToward(other, activeAttack.CommitTurnRate * frameDelta)
					end
				end
				if activeAttack and activeAttack.Travel > 0 then
					local travel = root.CFrame.LookVector
						* (activeAttack.Travel * math.min(1, hitInterval / activeAttack.Active))
					local obstacle = workspace:Blockcast(
						root.CFrame,
						Config.CollisionHull.Diameter * Vector3.new(1, 1, 1),
						travel,
						rayParams(model)
					)
					if obstacle then
						travel = travel.Unit * math.max(0, obstacle.Distance - 0.2)
					end
					root.CFrame += travel
					committedOrigin = root.CFrame
					committedBox = committedOrigin * CFrame.new(0, 0, -activeAttack.Offset)
					if debugBox then
						debugBox.CFrame = committedBox
					end
				end
				if now < nextHit or not activeAttack then
					return
				end
				nextHit = now + hitInterval
				for _, victim in
					HitDetection.find(model, committedOrigin, committedBox, activeAttack.Size, {
						OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
						RequireLineOfSight = true,
						CanTarget = function(character)
							return Players:GetPlayerFromCharacter(character) ~= nil
								or Collection:HasTag(character, "CityHuman")
						end,
					})
				do
					if not hitTargets[victim] then
						hitTargets[victim] = true
						local damage = activeAttack.Damage
						Damage.apply(model, victim, if typeof(damage) == "table" then damage[attackStep] else damage)
						attackHit = true
					end
				end
			end
			return
		end
		if state == "Flinch" then
			if now < flinchUntil then
				return
			end
			-- Reuse release logic below; preserve an existing recovery instead of shortening it.
			if not resumeRecovery then
				recoverUntil = 0
			end
			setState("Recover")
		end
		if state == "Vulnerable" then
			if now < recoverUntil then
				return
			end
			activeAttack = nil
			lastAttack = attackName
			root.Anchored = false
			root:SetNetworkOwner(nil)
			humanoid.AutoRotate = true
			setState("Chase")
		end
		if state == "Recover" then
			if now < recoverUntil then
				return
			end
			root.Anchored = false
			root:SetNetworkOwner(nil)
			humanoid.AutoRotate = true
			progressPosition = root.Position
			progressAt = now
			setState("Chase")
		end
		if state == "Chase" then
			local chaseTarget = targetRoot(target)
			if
				chaseTarget
				and (chaseTarget.Position - root.Position).Magnitude <= Config.Turning.CloseCombatDistance
			then
				humanoid.AutoRotate = false
				turnToward(
					chaseTarget,
					combatTurnRate(chaseTarget) * frameDelta,
					Config.Turning.PivotTurnRate * frameDelta
				)
			elseif chaseTarget then
				humanoid.AutoRotate = true
			end
		end
		if now < nextThink then
			return
		end
		nextThink = now + Config.ThinkInterval
		local other = targetRoot(target)
		local order = model:FindFirstChild("ObjectiveTarget")
		local objective = if order and order:IsA("ObjectValue") then order.Value else nil
		if
			not other or (target ~= objective and (other.Position - root.Position).Magnitude > Config.DisengageRange)
		then
			target = nil
			other = nil
			clearPath()
			stopMoving()
			setState("Idle")
			local nearest = Config.DetectionRange
			local candidates: { Instance } = {}
			for _, player in Players:GetPlayers() do
				table.insert(candidates, player)
			end
			for _, human in Collection:GetTagged("CityHuman") do
				table.insert(candidates, human)
			end
			for _, player in candidates do
				local candidate = targetRoot(player)
				if candidate then
					local distance = (candidate.Position - root.Position).Magnitude
					if distance <= nearest and visible(candidate) then
						nearest = distance
						target = player
						other = candidate
					end
				end
			end
			if not other and objective then
				target, other = objective, targetRoot(objective)
			end
			if other then
				progressAt = now
				progressPosition = root.Position
				stuck = false
				setState("Chase")
			end
		end
		if other then
			local choice = if visible(other) then chooseAttack((other.Position - root.Position).Magnitude) else nil
			if choice then
				beginAttack(other, choice, now)
			else
				chase(other, now, frameDelta)
			end
		end
	end
	display()
	return {
		Model = model,
		Update = update,
		IsAlive = function(): boolean
			return state ~= "Dead"
		end,
		HasPendingPath = function(): boolean
			return pendingPath ~= nil
		end,
		TakePathJob = function(): (() -> ())?
			local job = pendingPath
			if not job or state == "Dead" then
				return nil
			end
			pendingPath = nil
			model:SetAttribute("PathQueued", false)
			computing = true
			return function()
				local ok, err = pcall(job)
				computing = false -- Release even if creating or processing a path raises an error.
				if not ok then
					error(tostring(err))
				end
			end
		end,
		Destroy = function()
			die()
			model:Destroy()
		end,
	}
end

return Enemy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">EquipmentService</string>
            <string name="Source"><![CDATA[--!strict

-- Server-owned prototype equipment state. It selects items/profiles but never
-- executes weapon combat; magic remains in MagicService and melee in CombatService.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Definitions = require(Shared.Configuration.Items)
local Equipment = {}

type Slot = "PrimaryWeapon" | "SecondaryWeapon" | "Utility"
type State = {
	Owned: { [string]: boolean },
	PrimaryWeapon: string?,
	SecondaryWeapon: string?,
	Utility: string?,
	ActiveSlot: Slot,
}

local states: { [Player]: State } = {}

local function itemInSlot(state: State, slot: Slot): string?
	return state[slot]
end

local function publish(player: Player, state: State, remote: RemoteEvent)
	player:SetAttribute("PrimaryWeapon", state.PrimaryWeapon)
	player:SetAttribute("SecondaryWeapon", state.SecondaryWeapon)
	player:SetAttribute("Utility", state.Utility)
	player:SetAttribute("ActiveEquipmentSlot", state.ActiveSlot)
	remote:FireClient(player, {
		Kind = "Equipment",
		PrimaryWeapon = state.PrimaryWeapon,
		SecondaryWeapon = state.SecondaryWeapon,
		Utility = state.Utility,
		ActiveSlot = state.ActiveSlot,
	})
end

local function attachVisual(player: Player, state: State)
	local character = player.Character
	if not character then
		return
	end
	local previous = character:FindFirstChild("SandboxEquippedWeapon")
	if previous then
		previous:Destroy()
	end
	local itemId = itemInSlot(state, state.ActiveSlot)
	local item = if itemId then Definitions.Items[itemId] else nil
	if not item or not item.Visual then
		return
	end
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return
	end
	local visual = item.Visual
	local part = Instance.new("Part")
	part.Name = "SandboxEquippedWeapon"
	part.Size = visual.Size
	part.Color = visual.Color
	part.Material = visual.Material
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CFrame = hand.CFrame * visual.Offset
	part.Parent = character
	if visual.MuzzleOffset then
		local muzzle = Instance.new("Attachment")
		muzzle.Name = "Muzzle"
		muzzle.CFrame = visual.MuzzleOffset
		muzzle.Parent = part
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = part
	weld.Parent = part
end

function Equipment.bind(player: Player)
	states[player] = {
		Owned = {},
		PrimaryWeapon = nil,
		SecondaryWeapon = nil,
		Utility = nil,
		ActiveSlot = "SecondaryWeapon", -- Preserve existing melee controls on spawn.
	}
end

function Equipment.chooseStarter(player: Player, path: string, remote: RemoteEvent): boolean
	local state = states[player]
	if not state or next(state.Owned) ~= nil or (path ~= "Melee" and path ~= "Magic") then
		return false
	end
	local id = if path == "Melee" then "RecruitMeleeWeapon" else "RecruitMagicWeapon"
	local slot: Slot = if path == "Melee" then "SecondaryWeapon" else "PrimaryWeapon"
	state.Owned[id] = true
	state[slot] = id
	state.ActiveSlot = slot
	attachVisual(player, state)
	publish(player, state, remote)
	return true
end

function Equipment.characterAdded(player: Player, remote: RemoteEvent)
	local state = states[player]
	if state then
		attachVisual(player, state)
		publish(player, state, remote)
	end
end

function Equipment.switch(player: Player, slot: any, remote: RemoteEvent): boolean
	local state = states[player]
	if slot ~= "PrimaryWeapon" and slot ~= "SecondaryWeapon" and slot ~= "Utility" then
		return false
	end
	if not state then
		return false
	end
	local itemId = itemInSlot(state, slot :: Slot)
	if not itemId or not state.Owned[itemId] or not Definitions.Items[itemId] then
		return false
	end
	state.ActiveSlot = slot
	attachVisual(player, state)
	publish(player, state, remote)
	return true
end

function Equipment.magicCast(player: Player, action: any): (string?, { Origin: Vector3 }?)
	local state = states[player]
	if not state or state.ActiveSlot ~= "PrimaryWeapon" or (action ~= "Primary" and action ~= "Area") then
		return nil, nil
	end
	local itemId = state.PrimaryWeapon
	local item = if itemId and state.Owned[itemId] then Definitions.Items[itemId] else nil
	if not item or item.ItemType ~= "Weapon" or item.WeaponType ~= "MagicFocus" then
		return nil, nil
	end
	local profile = Definitions.MagicProfiles[item.MagicProfile]
	if not profile then
		return nil, nil
	end
	local weapon = player.Character and player.Character:FindFirstChild("SandboxEquippedWeapon")
	local muzzle = if weapon then weapon:FindFirstChild("Muzzle") else nil
	local context = if muzzle and muzzle:IsA("Attachment") then { Origin = muzzle.WorldPosition } else nil
	return if action == "Primary" then profile.PrimarySpellId else profile.AreaSpellId, context
end

function Equipment.meleeActive(player: Player): boolean
	local state = states[player]
	if not state or state.ActiveSlot ~= "SecondaryWeapon" then
		return false
	end
	local itemId = state.SecondaryWeapon
	local item = if itemId and state.Owned[itemId] then Definitions.Items[itemId] else nil
	return item ~= nil and item.ItemType == "Weapon" and item.WeaponType == "Melee"
end

function Equipment.remove(player: Player)
	states[player] = nil
end

return Equipment
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">HitDetectionService</string>
            <string name="Source"><![CDATA[--!strict

local HitDetection = {}

export type Rules = {
	OverlapCollisionGroup: string?,
	MaxDistance: number?,
	MinimumFacingDot: number?,
	RequireLineOfSight: boolean?,
	CanTarget: ((Model, Humanoid) -> boolean)?,
}

-- Geometry and target policy come from the caller, never from attacker identity.
function HitDetection.find(attacker: Model, origin: CFrame, hitbox: CFrame, size: Vector3, rules: Rules): { Humanoid }
	local overlap = OverlapParams.new()
	overlap.CollisionGroup = rules.OverlapCollisionGroup or "Default"
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { attacker }
	local found: { [Humanoid]: boolean } = {}
	local targets: { Humanoid } = {}
	for _, part in workspace:GetPartBoundsInBox(hitbox, size, overlap) do
		local model = part:FindFirstAncestorOfClass("Model")
		while model and not model:FindFirstChildOfClass("Humanoid") do
			model = model:FindFirstAncestorOfClass("Model")
		end
		local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
		local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
		if
			not model
			or model == attacker
			or not humanoid
			or humanoid.Health <= 0
			or not root
			or not root:IsA("BasePart")
			or found[humanoid]
		then
			continue
		end
		found[humanoid] = true
		if rules.CanTarget and not rules.CanTarget(model, humanoid) then
			continue
		end
		local delta = root.Position - origin.Position
		if rules.MaxDistance and delta.Magnitude > rules.MaxDistance then
			continue
		end
		local horizontal = Vector3.new(delta.X, 0, delta.Z)
		if
			rules.MinimumFacingDot
			and horizontal.Magnitude > 0
			and origin.LookVector:Dot(horizontal.Unit) < rules.MinimumFacingDot
		then
			continue
		end
		if rules.RequireLineOfSight then
			local ray = RaycastParams.new()
			ray.FilterType = Enum.RaycastFilterType.Exclude
			ray.FilterDescendantsInstances = { attacker, model }
			ray.RespectCanCollide = true
			if workspace:Raycast(origin.Position, delta, ray) then
				continue
			end
		end
		table.insert(targets, humanoid)
	end
	return targets
end

-- Sphere and cone use the same target/LOS policy as melee. They remain neutral
-- queries: callers provide geometry and target policy rather than attacker roles.
function HitDetection.findSphere(attacker: Model, origin: CFrame, radius: number, rules: Rules): { Humanoid }
	local overlap = OverlapParams.new()
	overlap.CollisionGroup = rules.OverlapCollisionGroup or "Default"
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { attacker }
	local found: { [Humanoid]: boolean } = {}
	local targets: { Humanoid } = {}
	for _, part in workspace:GetPartBoundsInRadius(origin.Position, radius, overlap) do
		local model = part:FindFirstAncestorOfClass("Model")
		local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
		local root = if model then model:FindFirstChild("HumanoidRootPart") else nil
		if
			not model
			or not humanoid
			or not root
			or not root:IsA("BasePart")
			or humanoid.Health <= 0
			or found[humanoid]
		then
			continue
		end
		found[humanoid] = true
		local delta = root.Position - origin.Position
		if
			(rules.MaxDistance and delta.Magnitude > rules.MaxDistance)
			or (rules.CanTarget and not rules.CanTarget(model, humanoid))
		then
			continue
		end
		if rules.RequireLineOfSight then
			local ray = RaycastParams.new()
			ray.FilterType = Enum.RaycastFilterType.Exclude
			ray.FilterDescendantsInstances = { attacker, model }
			ray.RespectCanCollide = true
			if workspace:Raycast(origin.Position, delta, ray) then
				continue
			end
		end
		table.insert(targets, humanoid)
	end
	return targets
end

function HitDetection.findCone(
	attacker: Model,
	origin: CFrame,
	range: number,
	minimumDot: number,
	rules: Rules
): { Humanoid }
	local result: { Humanoid } = {}
	for _, humanoid in HitDetection.findSphere(attacker, origin, range, rules) do
		local root = humanoid.Parent and humanoid.Parent:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local delta = root.Position - origin.Position
			local horizontal = Vector3.new(delta.X, 0, delta.Z)
			if horizontal.Magnitude == 0 or origin.LookVector:Dot(horizontal.Unit) >= minimumDot then
				table.insert(result, humanoid)
			end
		end
	end
	return result
end

return HitDetection
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">LivingCityService</string>
            <string name="Source"><![CDATA[--!strict
-- A bounded population, one update loop and one shared navigation computation.
local Collection = game:GetService("CollectionService")
local Pathfinding = game:GetService("PathfindingService")
local Run = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Configuration.CityLife).NPCs
local Plan = require(Shared.Configuration.PhaseATopology)
local Spawn = require(script.Parent.WorldSpawnService)
local Damage = require(script.Parent.DamageService)
local PopulationLayout = require(script.Parent.CityPopulationLayout)
local City = {}
local entries, mobilizations = {}, {}
local folder, computing, cursor, nextPathStart = nil, false, 0, 0

local function groundedAround(point)
	for _, offset in
		{ Vector3.zero, Vector3.new(5, 0, 0), Vector3.new(-5, 0, 0), Vector3.new(0, 0, 5), Vector3.new(0, 0, -5) }
	do
		local result = Spawn.ground(point + offset, 5, 2.5)
		if result then
			return result
		end
	end
	return nil
end
local function rig(name, role, position)
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("Role", role)
	local function part(name, size, offset, color)
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame = name, size, CFrame.new(position + offset)
		p.Color, p.Material = color, Enum.Material.Fabric
		p.CanCollide, p.CanTouch = false, false
		p.Parent = model
		return p
	end
	local skin, cloth = Color3.fromRGB(157, 120, 91), Color3.fromRGB(92, 83, 67)
	if role == "Guard" or role == "Patrol" then
		cloth = Color3.fromRGB(64, 74, 71)
	end
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.zero, cloth)
	root.Transparency, root.CanCollide = 1, true
	local torso = part("Torso", Vector3.new(2, 2, 1), Vector3.zero, cloth)
	local head = part("Head", Vector3.new(2, 1, 1), Vector3.new(0, 1.5, 0), skin)
	local function joint(a, b, name)
		local motor = Instance.new("Motor6D")
		motor.Name, motor.Part0, motor.Part1 = name, a, b
		motor.C0, motor.Parent = a.CFrame:ToObjectSpace(b.CFrame), a
	end
	joint(root, torso, "RootJoint")
	joint(torso, head, "Neck")
	for _, side in { -1, 1 } do
		local prefix = if side < 0 then "Left" else "Right"
		joint(
			torso,
			part(prefix .. " Arm", Vector3.new(1, 2, 1), Vector3.new(side * 1.5, 0, 0), cloth),
			prefix .. " Shoulder"
		)
		joint(
			torso,
			part(prefix .. " Leg", Vector3.new(1, 2, 1), Vector3.new(side * 0.5, -2, 0), cloth),
			prefix .. " Hip"
		)
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.MaxHealth, humanoid.Health, humanoid.WalkSpeed = Config.Health, Config.Health, Config.Speed
	humanoid.Parent = model
	model.PrimaryPart, model.Parent = root, folder
	root:SetNetworkOwner(nil)
	Collection:AddTag(model, "CityHuman")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ObjectText, prompt.ActionText = name .. " · " .. role, "Listen"
	prompt.KeyboardKeyCode, prompt.MaxActivationDistance, prompt.RequiresLineOfSight = Enum.KeyCode.K, 8, true
	prompt.Parent = head
	prompt.Triggered:Connect(function(player)
		if humanoid.Health <= 0 or not player:GetAttribute("OpeningComplete") then
			return
		end
		local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if r and (r.Position - root.Position).Magnitude <= 10 then
			player:SetAttribute(
				"CityRemark",
				if role == "Guard" or role == "Patrol"
					then "Stay alert. We hold these streets together."
					else "Work goes on. Keep clear of the lower passages."
			)
		end
	end)
	return model, humanoid, root
end
function City.create(name, role, nodes, temporary, home)
	if not folder or #entries >= Config.MaxPopulation then
		return nil
	end
	local position = groundedAround(home or Plan.Nodes[nodes[1]])
	if not position then
		return nil
	end
	local model, humanoid, root = rig(name, role, position)
	local entry = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Role = role,
		Nodes = nodes,
		Index = 2,
		Home = position,
		NextPath = 0,
		NextHit = 0,
		NextIdle = 0,
		Temporary = temporary,
		Finished = false,
		Path = nil,
		Waypoint = 1,
	}
	table.insert(entries, entry)
	return entry
end
function City.remove(entry)
	if not entry then
		return
	end
	entry.Removed = true
	entry.Model:Destroy()
end
function City.near(point, guardsOnly)
	local nearest, distance = nil, math.huge
	for _, entry in entries do
		if
			not entry.Removed
			and entry.Humanoid.Health > 0
			and (not guardsOnly or entry.Role == "Guard" or entry.Role == "Patrol")
		then
			local d = (entry.Root.Position - point).Magnitude
			if d < distance then
				nearest, distance = entry, d
			end
		end
	end
	return nearest, distance
end
function City.mobilize(id, defense, retreat)
	mobilizations[id] = { Defense = defense, Retreat = retreat }
end
function City.release(id)
	mobilizations[id] = nil
end
local function visible(a, b, exclude)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances, params.RespectCanCollide = exclude, true
	return workspace:Raycast(a, b - a, params) == nil
end
function City.start()
	if folder or not Config.Enabled then
		return
	end
	folder = Instance.new("Folder")
	folder.Name, folder.Parent = "LivingCity", workspace
	local roster = {}
	local fronts = {}
	local geometry = workspace:FindFirstChild("LowerLayerGraybox")
	local markers = geometry and geometry:FindFirstChild("StreetFronts")
	if markers then
		local ordered = markers:GetChildren()
		table.sort(ordered, function(a, b)
			return a.Name < b.Name
		end)
		for _, marker in ordered do
			table.insert(fronts, {
				Kind = marker:GetAttribute("Archetype"),
				Enterable = marker:GetAttribute("Enterable"),
				Home = marker.Value,
			})
		end
	end
	local target = math.min(
		Config.MaxPopulation - Config.EventReserve,
		math.floor(Config.AmbientTarget * math.max(0, Config.Scale))
	)
	local definitions = PopulationLayout.build(Plan, Config.Roster, fronts, target)
	for i = 1, math.min(target, #definitions) do
		table.insert(roster, { Definition = definitions[i], Retry = 0 })
	end
	folder:SetAttribute("AmbientTarget", #roster)
	local updateCursor = 0
	local nextTick = 0
	Run.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextTick then
			return
		end
		nextTick = now + Config.Tick
		local spawnAttempts = 0
		for _, slot in roster do
			if slot.Entry and (slot.Entry.Removed or slot.Entry.Humanoid.Health <= 0) then
				slot.Entry = nil
				slot.Retry = now + Config.RespawnSeconds
			end
			if not slot.Entry and now >= slot.Retry and spawnAttempts < Config.SpawnAttemptsPerTick then
				spawnAttempts += 1
				local d = slot.Definition
				local home = if d.Position then Vector3.new(d.Position.X, d.Position.Y, d.Position.Z) else nil
				slot.Entry = City.create(d.Name, d.Role, d.Nodes, false, home)
				if slot.Entry then
					slot.Entry.Model:SetAttribute("District", d.District or "Authored")
				end
				slot.Retry = now + Config.RespawnSeconds
			end
		end
		local threats = Collection:GetTagged("Enfleshed")
		for i = #entries, 1, -1 do
			if entries[i].Removed or not entries[i].Model.Parent then
				table.remove(entries, i)
			end
		end
		local living = 0
		for _, entry in entries do
			if entry.Humanoid.Health > 0 then
				living += 1
			end
		end
		folder:SetAttribute("LivingCount", living)
		for _ = 1, math.min(Config.UpdatesPerTick, #entries) do
			updateCursor = updateCursor % #entries + 1
			local e = entries[updateCursor]
			if e.Removed or not e.Model.Parent then
				continue
			end
			if e.Humanoid.Health <= 0 then
				e.DeadAt = e.DeadAt or now
				if now - e.DeadAt > 4 then
					City.remove(e)
				end
				continue
			end
			local threat, distance = nil, Config.DangerRadius
			for _, model in threats do
				local h = model:FindFirstChildOfClass("Humanoid")
				local r = model:FindFirstChild("HumanoidRootPart")
				if h and h.Health > 0 and r then
					local d = (r.Position - e.Root.Position).Magnitude
					if d < distance and visible(e.Root.Position, r.Position, { e.Model, model }) then
						threat, distance = model, d
					end
				end
			end
			local guard = e.Role == "Guard" or e.Role == "Patrol"
			local goal = nil
			e.Humanoid.WalkSpeed = Config.Speed
			if threat then
				local r = threat.HumanoidRootPart
				if guard then
					goal = if distance <= Config.GuardRange then e.Root.Position else r.Position
					if distance <= Config.GuardRange and now >= e.NextHit then
						e.NextHit = now + Config.GuardCooldown
						Damage.apply(e.Model, threat:FindFirstChildOfClass("Humanoid"), Config.GuardDamage)
					end
				else
					e.Humanoid.WalkSpeed = Config.FleeSpeed
					local away = e.Root.Position - r.Position
					if away.Magnitude > 0 then
						goal = groundedAround(e.Root.Position + away.Unit * 16)
					end
					goal = goal or e.Home
				end
			else
				for _, orders in mobilizations do
					if (e.Home - orders.Defense).Magnitude < 350 then
						goal = (if guard then orders.Defense else orders.Retreat) + Vector3.new(0, 3, 0)
						break
					end
				end
				if not goal then
					if e.Nodes[1] == e.Nodes[2] then
						if e.Role == "Shopkeeper" or e.Role == "Guard" then
							goal = e.Home
						else
							if now >= e.NextIdle then
								e.NextIdle = now + 8
								e.IdleGoal = groundedAround(
									e.Home + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))
								) or e.Home
							end
							goal = e.IdleGoal
						end
					elseif not e.Finished then
						goal = Plan.Nodes[e.Nodes[e.Index]] + Vector3.new(0, 3, 0)
						if (goal - e.Root.Position).Magnitude < 7 then
							e.Index += 1
							e.Path = nil
							if e.Index > #e.Nodes then
								if e.Temporary then
									e.Finished = true
								else
									e.Index = 1
								end
							end
						end
					end
				end
			end
			if e.Goal and goal and (e.Goal - goal).Magnitude > 12 then
				e.Path = nil
			end
			e.Goal = goal
			if not goal or (goal - e.Root.Position).Magnitude < 3 then
				e.NeedPath = false
				e.Humanoid:MoveTo(e.Root.Position)
				continue
			end
			local params = RaycastParams.new()
			params.FilterDescendantsInstances = { folder }
			params.RespectCanCollide = true
			-- A broad sweep prevents repeated straight-line commands into door frames.
			local direction = goal - e.Root.Position
			local blocked = workspace:Blockcast(CFrame.new(e.Root.Position), Vector3.new(2, 3, 2), direction, params)
			if not blocked and math.abs(direction.Y) < 4 then
				e.Path = nil
				e.NeedPath = false
				e.Humanoid:MoveTo(goal)
			else
				e.NeedPath = true
				if e.Path then
					local waypoint = e.Path[e.Waypoint]
					if waypoint and (waypoint.Position - e.Root.Position).Magnitude < 5 then
						e.Waypoint += 1
						waypoint = e.Path[e.Waypoint]
					end
					if waypoint then
						e.Humanoid.Jump = waypoint.Action == Enum.PathWaypointAction.Jump
						e.Humanoid:MoveTo(waypoint.Position)
					end
				end
			end
		end
		if not computing and now >= nextPathStart and #entries > 0 then
			for _ = 1, #entries do
				cursor = cursor % #entries + 1
				local e = entries[cursor]
				if e.NeedPath and e.Goal and now >= e.NextPath and e.Humanoid.Health > 0 and not e.Removed then
					computing = true
					nextPathStart = now + 1 / Config.PathStartsPerSecond
					e.NextPath = now + Config.RepathSeconds
					local goal = e.Goal
					task.spawn(function()
						local path = Pathfinding:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
						local ok = pcall(function()
							path:ComputeAsync(e.Root.Position, goal)
						end)
						if
							ok
							and not e.Removed
							and e.Humanoid.Health > 0
							and e.Goal
							and (e.Goal - goal).Magnitude < 10
							and path.Status == Enum.PathStatus.Success
						then
							e.Path = path:GetWaypoints()
							e.Waypoint = 2
						end
						path:Destroy()
						computing = false
					end)
					break
				end
			end
		end
	end)
end
return City
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">MagicBehaviorExecutors</string>
            <string name="Source"><![CDATA[--!strict

-- V1 behavior registry. Each handler receives runtime context supplied by
-- MagicService, keeping behaviors independent from spell identities.
local Behaviors = {}

type Context = {
	ApplySpherePayloads: (radius: number, payloads: { any }) -> (),
}

local executors: { [string]: (Context, any) -> () } = {
	Explode = function(context, behavior)
		context.ApplySpherePayloads(behavior.Radius, behavior.Payloads)
	end,
}

function Behaviors.execute(name: string, context: Context, behavior: any): boolean
	local executor = executors[name]
	if not executor then
		return false
	end
	executor(context, behavior)
	return true
end

return Behaviors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">MagicFormExecutors</string>
            <string name="Source"><![CDATA[--!strict

-- V2 form dispatch. Each executor operates entirely through its supplied
-- context, which keeps this registry independent of individual spell IDs.
local Forms = {}

Forms.Executors = {
	Beam = function(definition: any, context: any)
		context.ExecuteBeam(definition)
	end,
	Field = function(definition: any, context: any)
		context.CreateField(definition)
	end,
	SelfEnhancement = function(definition: any, context: any)
		context.ApplySelf(definition)
	end,
	Manipulation = function(definition: any, context: any)
		context.ApplyManipulation(definition)
	end,
}

function Forms.execute(form: string, definition: any, context: any): boolean
	local executor = Forms.Executors[form]
	if not executor then
		return false
	end
	executor(definition, context)
	return true
end

return Forms
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">MagicPayloadExecutors</string>
            <string name="Source"><![CDATA[--!strict

-- Small registry for payload kinds the runtime currently supports. Context is
-- supplied by MagicService so executors remain neutral about spell identities.
local Damage = require(script.Parent.DamageService)

local Payloads = {}

Payloads.Executors = {
	Damage = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			local dealt = Damage.apply(context.Caster, humanoid, payload.Amount * context.Potency)
			if dealt > 0 then
				context.HitFeedback(humanoid, dealt)
			end
		end
	end,
	Force = function(payload: any, context: any)
		for _, humanoid in context.Targets or {} do
			local root = humanoid.Parent and humanoid.Parent:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				root.AssemblyLinearVelocity += context.Direction * payload.Magnitude + Vector3.new(
					0,
					payload.Upward or 0,
					0
				)
			end
		end
	end,
	Enhancement = function(payload: any, context: any)
		context.ApplyEnhancement(payload)
	end,
	Manipulation = function(payload: any, context: any)
		context.ApplyManipulation(payload)
	end,
}

function Payloads.execute(payloads: { any }, context: any)
	for _, payload in payloads do
		local executor = Payloads.Executors[payload.Kind]
		if executor then
			executor(payload, context)
		end
	end
end

return Payloads
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">MagicService</string>
            <string name="Source"><![CDATA[--!strict

-- Small server-owned interpreter for registered spell data. It intentionally
-- implements only the V1 component subset, rather than a final spell engine.
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sandbox = require(Shared.Configuration.Sandbox)
local Definitions = require(Shared.Configuration.Spells)
local Generated = require(Shared.Configuration.GeneratedSpellStress)
local Validator = require(Shared.Modules.SpellDefinitionValidator)
local HitDetection = require(script.Parent.HitDetectionService)
local Behaviors = require(script.Parent.MagicBehaviorExecutors)
local Forms = require(script.Parent.MagicFormExecutors)
local Payloads = require(script.Parent.MagicPayloadExecutors)
local Movement = require(script.Parent.MovementService)
local Magic = {}

type State = { Character: Model, Humanoid: Humanoid, Root: BasePart }
type Charge = { SpellId: string, BeganAt: number }
type CastContext = { Origin: Vector3 }?
type Active = {
	SpellId: string,
	Caster: Model,
	Age: number,
	CurrentPhase: string,
	TargetsHit: { [Humanoid]: boolean },
	RemainingLifetime: number,
	Definition: any,
	Position: Vector3,
	Direction: Vector3,
	Visual: BasePart,
	Player: Player,
	Remote: RemoteEvent,
}

local playerData: { [Player]: { Mana: number, Strain: number, Ready: { [string]: number }, Charge: Charge? } } = {}
local active: { any } = {}
local enhancements: {
	[Player]: {
		[string]: {
			State: State,
			ExpiresAt: number,
			WalkSpeedBonus: number,
			JumpPowerBonus: number,
			SpeedMultiplier: number,
		},
	},
} =
	{}

local function feedback(remote: RemoteEvent, player: Player, result: string, spell: any?, data: { [string]: any }?)
	remote:FireClient(player, {
		Kind = "Magic",
		Result = result,
		SpellId = if spell then spell.SpellId else nil,
		Name = if spell then spell.Name else nil,
		Mana = data and data.Mana or nil,
		Strain = data and data.Strain or nil,
		Complexity = data and data.Complexity or nil,
		Reason = data and data.Reason or nil,
		Damage = data and data.Damage or nil,
	})
end

local function validVector(value: any): boolean
	return typeof(value) == "Vector3" and value.X == value.X and value.Y == value.Y and value.Z == value.Z
end

local function getDefinition(id: any): any?
	if typeof(id) ~= "string" then
		return nil
	end
	return Definitions[id] or Generated.Definitions[id]
end

local function findMaterial(definition: any, point: Vector3): Instance?
	local requirement = definition.Material
	if not requirement then
		return nil
	end
	local closest: Instance? = nil
	local closestDistance = math.huge
	for _, source in CollectionService:GetTagged("MagicMaterialSource") do
		local position = if source:IsA("BasePart")
			then source.Position
			elseif source:IsA("Model") then source:GetPivot().Position
			else nil
		if
			position
			and source:GetAttribute("MagicMaterial") == requirement.Material
			and (source:GetAttribute("AvailableAmount") or 0) >= requirement.Amount
			and (position - point).Magnitude <= requirement.SearchRadius
			and (position - point).Magnitude < closestDistance
		then
			closest, closestDistance = source, (position - point).Magnitude
		end
	end
	return closest
end

local function findManipulable(definition: any, point: Vector3): BasePart?
	local closest: BasePart? = nil
	local closestDistance = math.huge
	for _, source in CollectionService:GetTagged("MagicManipulable") do
		if
			source:IsA("BasePart")
			and source:GetAttribute("MagicMaterial") == definition.Material.Material
			and source:GetAttribute("MagicRaise") == true
			and (source.Position - point).Magnitude <= definition.Material.SearchRadius
			and (source.Position - point).Magnitude < closestDistance
		then
			closest, closestDistance = source, (source.Position - point).Magnitude
		end
	end
	return closest
end

local function costs(definition: any, charge: number): (number, number, number)
	local scale = 1 + charge * Sandbox.Magic.ChargeCostScale
	return definition.Cost.ManaDemand * scale / Sandbox.Magic.Player.Efficiency,
		definition.Cost.Strain * scale / Sandbox.Magic.Player.StrainTolerance * 30,
		definition.Cost.Complexity
end

local function validate(
	player: Player,
	state: State,
	intent: any,
	definition: any,
	charge: number
): (string, string?, Instance?, Vector3?)
	if not definition or not validVector(intent.AimDirection) then
		return "IMPOSSIBLE", "Invalid spell or aim"
	end
	local direction = intent.AimDirection
	if direction.Magnitude < 0.9 or direction.Magnitude > 1.1 then
		return "IMPOSSIBLE", "Invalid aim direction"
	end
	direction = direction.Unit
	local worldPoint = intent.WorldPoint
	local material: Instance? = nil
	if definition.Targeting == "WorldPoint" then
		if
			not validVector(worldPoint)
			or (worldPoint - state.Root.Position).Magnitude > Sandbox.Magic.MaxAimDistance
		then
			return "IMPOSSIBLE", "Invalid world target"
		end
		local aimedDelta = worldPoint - (state.Root.Position + Vector3.new(0, 1.5, 0))
		if aimedDelta.Magnitude > 0 and direction:Dot(aimedDelta.Unit) < Sandbox.Magic.MinimumWorldAimDot then
			return "IMPOSSIBLE", "World target is outside aim direction"
		end
	elseif definition.Targeting == "MaterialTarget" then
		if
			not validVector(worldPoint)
			or (worldPoint - state.Root.Position).Magnitude > Sandbox.Magic.MaxAimDistance
		then
			return "IMPOSSIBLE", "Invalid material target"
		end
		-- Use a server-known spell origin for the anti-spoof comparison rather than
		-- trusting a client-provided camera position. This preserves camera pitch.
		local aimedDelta = worldPoint - (state.Root.Position + Vector3.new(0, 1.5, 0))
		if aimedDelta.Magnitude > 0 and direction:Dot(aimedDelta.Unit) < Sandbox.Magic.MinimumWorldAimDot then
			return "IMPOSSIBLE", "Material target is outside aim direction"
		end
		material = if definition.Form == "Manipulation"
			then findManipulable(definition, worldPoint)
			else findMaterial(definition, worldPoint)
		if not material then
			return "IMPOSSIBLE", "No valid Earth target nearby"
		end
	end
	local mana, strain, complexity = costs(definition, charge)
	local stats = playerData[player]
	if not stats or mana > stats.Mana then
		return "IMPOSSIBLE", "Insufficient mana"
	end
	if complexity > Sandbox.Magic.Player.ComplexityCapacity then
		return "IMPOSSIBLE", "Complexity exceeds capacity"
	end
	if mana > Sandbox.Magic.Player.SafeManaDemand or strain > Sandbox.Magic.Player.SafeStrain then
		return "UNSAFE", "Above safe Locus threshold", material, direction
	end
	return "VALID", nil, material, direction
end

local function applyPayloads(
	caster: Model,
	origin: CFrame,
	targets: { Humanoid },
	payloads: { any },
	direction: Vector3,
	remote: RemoteEvent,
	player: Player
)
	Payloads.execute(payloads, {
		Caster = caster,
		Targets = targets,
		Direction = direction,
		Potency = Sandbox.Magic.Player.Potency,
		HitFeedback = function(humanoid: Humanoid, dealt: number)
			feedback(remote, player, "HIT", nil, { Reason = humanoid.Parent and humanoid.Parent.Name, Damage = dealt })
		end,
	})
end

local function visual(definition: any, position: Vector3): BasePart
	local part = Instance.new("Part")
	part.Name = "MagicProjectile"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(
		definition.Projectile.Radius * 2,
		definition.Projectile.Radius * 2,
		definition.Projectile.Radius * 2
	)
	part.Position = position
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = Enum.Material.Neon
	part.Color = definition.Visual.Color
	part.Parent = workspace
	return part
end

-- Projectile sweeps query character limbs as well as solid world geometry, then
-- skip only cosmetic/non-solid query parts. This avoids high-speed tunnelling
-- without allowing a non-colliding decoration to shield a wall behind it.
local function isProjectileImpact(instance: Instance, caster: Model): boolean
	local model = instance:FindFirstAncestorOfClass("Model")
	local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
	if humanoid and model ~= caster then
		return true
	end
	if instance:IsA("BasePart") then
		return instance.CanCollide
	end
	return instance:IsA("Terrain")
end

local function sweepProjectile(start: Vector3, delta: Vector3, caster: Model, visualPart: BasePart): RaycastResult?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { caster, visualPart }
	params.RespectCanCollide = false
	local endpoint = start + delta
	local origin = start
	for _ = 1, 16 do
		local remaining = endpoint - origin
		if remaining.Magnitude <= 0.001 then
			return nil
		end
		local result = workspace:Raycast(origin, remaining, params)
		if not result then
			return nil
		end
		if isProjectileImpact(result.Instance, caster) then
			return result
		end
		table.insert(params.FilterDescendantsInstances, result.Instance)
		origin = result.Position + remaining.Unit * 0.01
	end
	return nil
end

local function debugMarker(name: string, position: Vector3, size: Vector3, color: Color3, duration: number?): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = Enum.PartType.Cylinder
	part.Size = size
	part.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
	part.Transparency, part.Material, part.Color = 0.55, Enum.Material.Neon, color
	part.Parent = workspace
	if duration then
		Debris:AddItem(part, duration)
	end
	return part
end

local function updateEnhancement(player: Player, fallbackState: any?)
	local walkSpeedBonus, jumpPowerBonus = 0, 0
	local multiplier = 1
	for _, effect in enhancements[player] or {} do
		walkSpeedBonus += effect.WalkSpeedBonus
		jumpPowerBonus += effect.JumpPowerBonus
		multiplier = math.max(multiplier, effect.SpeedMultiplier)
	end
	local _, effect = next(enhancements[player] or {})
	if effect then
		Movement.setMagicEnhancement(effect.State, walkSpeedBonus, jumpPowerBonus, multiplier)
	elseif fallbackState then
		Movement.setMagicEnhancement(fallbackState, 0, 0, 1)
	end
end

local function execute(
	player: Player,
	state: State,
	remote: RemoteEvent,
	definition: any,
	intent: any,
	charge: number,
	material: Instance?,
	direction: Vector3,
	result: string,
	castContext: CastContext
)
	local stats = playerData[player]
	local mana, strain, complexity = costs(definition, charge)
	stats.Mana -= mana
	stats.Strain += strain
	stats.Ready[definition.SpellId] = workspace:GetServerTimeNow() + definition.Casting.Cooldown
	if material and definition.Material.Amount then
		material:SetAttribute(
			"AvailableAmount",
			(material:GetAttribute("AvailableAmount") or 0) - definition.Material.Amount
		)
	end
	feedback(remote, player, result, definition, { Mana = stats.Mana, Strain = stats.Strain, Complexity = complexity })
	if definition.Form ~= "Projectile" and definition.Form ~= "Wave" then
		local executed = Forms.execute(definition.Form, definition, {
			ExecuteBeam = function(beamDefinition: any)
				local origin = state.Root.Position + Vector3.new(0, 1.5, 0)
				if castContext then
					origin = castContext.Origin
				end
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { state.Character }
				params.RespectCanCollide = true
				local resultRay = workspace:Raycast(origin, direction * beamDefinition.Beam.Range, params)
				local endpoint = if resultRay
					then resultRay.Position
					else origin + direction * beamDefinition.Beam.Range
				local line = Instance.new("Part")
				line.Name = "MagicBeamDebug"
				line.Anchored, line.CanCollide, line.CanTouch, line.CanQuery = true, false, false, false
				line.Material, line.Color = Enum.Material.Neon, Color3.fromRGB(180, 230, 255)
				line.Size = Vector3.new(0.16, 0.16, (endpoint - origin).Magnitude)
				line.CFrame = CFrame.lookAt((origin + endpoint) / 2, endpoint)
				line.Parent = workspace
				Debris:AddItem(line, beamDefinition.Beam.DebugDuration)
				local model = if resultRay then resultRay.Instance:FindFirstAncestorOfClass("Model") else nil
				local humanoid = if model then model:FindFirstChildOfClass("Humanoid") else nil
				if humanoid and model ~= state.Character then
					applyPayloads(
						state.Character,
						CFrame.new(origin),
						{ humanoid },
						beamDefinition.Triggers.OnCast,
						direction,
						remote,
						player
					)
				end
			end,
			CreateField = function(fieldDefinition: any)
				local point = intent.WorldPoint :: Vector3
				local marker = debugMarker(
					"MagicFieldDebug",
					point,
					Vector3.new(
						fieldDefinition.Field.Radius * 2,
						fieldDefinition.Field.DebugHeight,
						fieldDefinition.Field.Radius * 2
					),
					fieldDefinition.Visual.Color
				)
				table.insert(active, {
					Kind = "Field",
					Caster = state.Character,
					Player = player,
					Remote = remote,
					Definition = fieldDefinition,
					Position = point,
					RemainingLifetime = fieldDefinition.Lifetime.Duration,
					NextInterval = 0,
					Visual = marker,
				})
			end,
			ApplySelf = function(selfDefinition: any)
				Payloads.execute(selfDefinition.Triggers.OnCast, {
					ApplyEnhancement = function(payload: any)
						local activeEffects = enhancements[player] or {}
						enhancements[player] = activeEffects
						activeEffects[selfDefinition.SpellId] = {
							State = state,
							ExpiresAt = if selfDefinition.Lifetime.Mode == "UntilToggledOff"
								then math.huge
								else workspace:GetServerTimeNow() + selfDefinition.Lifetime.Duration,
							WalkSpeedBonus = payload.WalkSpeedBonus or 0,
							JumpPowerBonus = payload.JumpPowerBonus or 0,
							SpeedMultiplier = payload.SpeedMultiplier or 1,
						}
						updateEnhancement(player)
					end,
				})
			end,
			ApplyManipulation = function(payload: any)
				if payload.Triggers then
					Payloads.execute(payload.Triggers.OnCast, {
						ApplyManipulation = function(operation: any)
							local target = material
							if target and target:IsA("BasePart") and operation.Operation == "Raise" then
								target.Position += Vector3.new(0, operation.Distance, 0)
							end
						end,
					})
				end
			end,
		})
		if executed then
			return
		end
	end
	if definition.Form == "Wave" then
		-- Waves deliberately stay ground-relative in V1. Projectile directions are
		-- left fully 3D; this form-specific projection does not affect validation.
		local horizontal = Vector3.new(direction.X, 0, direction.Z)
		local waveDirection = if horizontal.Magnitude > 0 then horizontal.Unit else state.Root.CFrame.LookVector
		local castFrame = CFrame.lookAt(state.Root.Position, state.Root.Position + waveDirection)
		local targets = HitDetection.findCone(state.Character, castFrame, definition.Wave.Range, definition.Wave.Dot, {
			OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
			RequireLineOfSight = true,
		})
		applyPayloads(state.Character, castFrame, targets, definition.Wave.Payloads, waveDirection, remote, player)
		local marker = Instance.new("Part")
		marker.Name = "MagicWaveDebug"
		marker.Shape = Enum.PartType.Ball
		marker.Size = Vector3.new(definition.Wave.Range * 2, 0.15, definition.Wave.Range * 2)
		marker.CFrame = castFrame * CFrame.new(0, -2.7, -definition.Wave.Range / 2)
		marker.Anchored, marker.CanCollide, marker.CanQuery = true, false, false
		marker.Transparency, marker.Material, marker.Color = 0.6, Enum.Material.Neon, Color3.fromRGB(170, 255, 170)
		marker.Parent = workspace
		Debris:AddItem(marker, definition.Wave.DebugDuration)
		return
	end
	local start = state.Root.Position + Vector3.new(0, 1.5, 0) + direction * 2
	if castContext then
		start = castContext.Origin
		if validVector(intent.WorldPoint) then
			local targetDelta = intent.WorldPoint - start
			if targetDelta.Magnitude > 0 then
				direction = targetDelta.Unit
			end
		end
	end
	table.insert(active, {
		SpellId = definition.SpellId,
		Caster = state.Character,
		Age = 0,
		CurrentPhase = "Travel",
		TargetsHit = {},
		RemainingLifetime = definition.Lifetime.Duration,
		Definition = definition,
		Position = start,
		Direction = direction,
		Visual = visual(definition, start),
		Player = player,
		Remote = remote,
	})
end

function Magic.start(player: Player, state: State, intent: any, remote: RemoteEvent, castContext: CastContext)
	local definition = getDefinition(intent.SpellId)
	if not definition then
		feedback(remote, player, "IMPOSSIBLE", nil, { Reason = "Unknown spell" })
		return
	end
	local definitionValid, definitionReason = Validator.validate(definition)
	if not definitionValid then
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = definitionReason })
		return
	end
	local stats = playerData[player]
	-- Turning an existing toggle OFF must not require mana, aim validation or
	-- waiting for its activation cooldown. The router still validates ownership,
	-- life state and request rate before reaching this handler.
	local effects = enhancements[player]
	if
		definition.Form == "SelfEnhancement"
		and definition.Lifetime.Mode == "UntilToggledOff"
		and effects
		and effects[definition.SpellId]
	then
		effects[definition.SpellId] = nil
		updateEnhancement(player, state)
		feedback(remote, player, "OFF", definition, nil)
		return
	end
	if not stats or workspace:GetServerTimeNow() < (stats.Ready[definition.SpellId] or 0) then
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = "Spell is cooling down" })
		return
	end
	if definition.Casting.Mode == "Charged" then
		if stats.Charge then
			feedback(remote, player, "IMPOSSIBLE", definition, { Reason = "A spell is already charging" })
			return
		end
		stats.Charge = { SpellId = definition.SpellId, BeganAt = workspace:GetServerTimeNow() }
		feedback(
			remote,
			player,
			"CHARGING",
			definition,
			{ Mana = stats.Mana, Strain = stats.Strain, Complexity = definition.Cost.Complexity }
		)
		return
	end
	local result, reason, material, direction = validate(player, state, intent, definition, 0)
	if result == "IMPOSSIBLE" or not direction then
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = reason })
		return
	end
	execute(player, state, remote, definition, intent, 0, material, direction, result, castContext)
end

function Magic.release(player: Player, state: State, intent: any, remote: RemoteEvent)
	local stats = playerData[player]
	local charge = if stats then stats.Charge else nil
	if not charge then
		feedback(remote, player, "IMPOSSIBLE", nil, { Reason = "No spell is charging" })
		return
	end
	stats.Charge = nil
	local definition = getDefinition(charge.SpellId)
	if not definition then
		return
	end
	local definitionValid, definitionReason = Validator.validate(definition)
	if not definitionValid then
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = definitionReason })
		return
	end
	local elapsed = math.clamp(workspace:GetServerTimeNow() - charge.BeganAt, 0, definition.Casting.MaximumCharge)
	if elapsed < definition.Casting.MinimumCharge then
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = "Charge was released too early" })
		return
	end
	local result, reason, material, direction = validate(player, state, intent, definition, elapsed)
	if result == "IMPOSSIBLE" or not direction then
		feedback(remote, player, "IMPOSSIBLE", definition, { Reason = reason })
		return
	end
	execute(player, state, remote, definition, intent, elapsed, material, direction, result, nil)
end

function Magic.bind(player: Player)
	playerData[player] =
		{ Mana = math.min(Sandbox.Magic.Player.Mana, Sandbox.Magic.Player.Capacity), Strain = 0, Ready = {} }
end

function Magic.reset(player: Player)
	for _, effect in enhancements[player] or {} do
		Movement.setMagicEnhancement(effect.State, 0, 0)
	end
	enhancements[player] = nil
	local stats = playerData[player]
	if stats then
		stats.Charge = nil
		stats.Mana = math.min(Sandbox.Magic.Player.Mana, Sandbox.Magic.Player.Capacity)
		stats.Strain = 0
		table.clear(stats.Ready)
	end
end

function Magic.remove(player: Player)
	playerData[player] = nil
	for _, effect in enhancements[player] or {} do
		Movement.setMagicEnhancement(effect.State, 0, 0)
	end
	enhancements[player] = nil
end

RunService.Heartbeat:Connect(function(delta)
	local now = workspace:GetServerTimeNow()
	for _, stats in playerData do
		stats.Mana =
			math.min(Sandbox.Magic.Player.Capacity, stats.Mana + Sandbox.Magic.Player.ManaRegenerationPerSecond * delta)
		stats.Strain = math.max(0, stats.Strain - Sandbox.Magic.Player.StrainRecoveryPerSecond * delta)
	end
	for index = #active, 1, -1 do
		local spell = active[index]
		if not spell.Caster:IsDescendantOf(workspace) then
			spell.Visual:Destroy()
			table.remove(active, index)
			continue
		end
		if spell.Kind == "Field" then
			spell.RemainingLifetime -= delta
			if spell.RemainingLifetime <= 0 then
				spell.Visual:Destroy()
				table.remove(active, index)
				continue
			end
			if now >= spell.NextInterval then
				spell.NextInterval = now + spell.Definition.Field.Interval
				local targets =
					HitDetection.findSphere(spell.Caster, CFrame.new(spell.Position), spell.Definition.Field.Radius, {
						OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
						RequireLineOfSight = true,
					})
				applyPayloads(
					spell.Caster,
					CFrame.new(spell.Position),
					targets,
					spell.Definition.Triggers.OnInterval,
					Vector3.zero,
					spell.Remote,
					spell.Player
				)
			end
			continue
		end
		spell.Age += delta
		spell.RemainingLifetime -= delta
		local definition = spell.Definition
		local previous = spell.Position
		local nextPosition = previous + spell.Direction * definition.Projectile.Speed * delta
		local impact = sweepProjectile(previous, nextPosition - previous, spell.Caster, spell.Visual)
		spell.Position = if impact then impact.Position else nextPosition
		spell.Visual.Position = spell.Position
		if impact then
			local hitModel = if impact then impact.Instance:FindFirstAncestorOfClass("Model") else nil
			local hitHumanoid = if hitModel then hitModel:FindFirstChildOfClass("Humanoid") else nil
			for _, trigger in definition.Triggers.OnImpact or {} do
				if trigger.Payloads and hitHumanoid and hitModel ~= spell.Caster then
					applyPayloads(
						spell.Caster,
						CFrame.new(spell.Position),
						{ hitHumanoid },
						trigger.Payloads,
						spell.Direction,
						spell.Remote,
						spell.Player
					)
				end
				if trigger.Behavior then
					Behaviors.execute(trigger.Behavior, {
						ApplySpherePayloads = function(radius: number, payloads: { any })
							local targets = HitDetection.findSphere(spell.Caster, CFrame.new(spell.Position), radius, {
								OverlapCollisionGroup = Sandbox.Combat.OverlapCollisionGroup,
								RequireLineOfSight = true,
							})
							applyPayloads(
								spell.Caster,
								CFrame.new(spell.Position),
								targets,
								payloads,
								spell.Direction,
								spell.Remote,
								spell.Player
							)
						end,
					}, trigger)
				end
			end
			spell.Visual:Destroy()
			table.remove(active, index)
		elseif spell.RemainingLifetime <= 0 then
			-- Expiration is not an impact: a bolt that reaches its maximum range
			-- simply vanishes and cannot apply delayed damage or an explosion.
			spell.Visual:Destroy()
			table.remove(active, index)
		end
	end
	for player, effects in enhancements do
		local changed = false
		local expiredState: State? = nil
		for spellId, effect in effects do
			if
				now >= effect.ExpiresAt
				or effect.State.Character ~= player.Character
				or effect.State.Humanoid.Health <= 0
			then
				expiredState = effect.State
				effects[spellId] = nil
				changed = true
			end
		end
		if changed then
			if next(effects) then
				updateEnhancement(player)
			elseif expiredState then
				Movement.setMagicEnhancement(expiredState, 0, 0)
			end
		end
	end
end)

return Magic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox")).Movement
local Types = require(Shared:WaitForChild("Types"):WaitForChild("CombatTypes"))
local Speed = require(Shared.Modules.MovementSpeed)
local Movement = {}

local function maximumSpeed(state: Types.PlayerState): number
	local multiplier = state.MagicSpeedMultiplier
	if workspace:GetServerTimeNow() < (state.MagicSpeedGraceUntil or 0) then
		multiplier = math.max(multiplier, state.MagicPreviousMultiplier or 1)
	end
	return Speed.calculate(Config.WalkSpeed, Config.SprintSpeed, true, state.MagicWalkSpeedBonus, multiplier)
end

local function applySpeed(state: Types.PlayerState)
	state.Humanoid.WalkSpeed = Speed.calculate(
		Config.WalkSpeed,
		Config.SprintSpeed,
		state.Sprinting,
		state.MagicWalkSpeedBonus,
		state.MagicSpeedMultiplier
	)
	state.Humanoid.JumpPower = 50 + state.MagicJumpPowerBonus
end

function Movement.sprint(state: Types.PlayerState, enabled: boolean)
	state.Sprinting = enabled
	applySpeed(state)
end

-- This deliberately composes with sprinting instead of owning a separate stat
-- system. MagicService provides only validated temporary bonuses.
function Movement.setMagicEnhancement(
	state: Types.PlayerState,
	walkSpeedBonus: number,
	jumpPowerBonus: number,
	multiplier: number?
)
	-- Account for enhanced motion already observed in this validation window
	-- when the player turns the spell off while sprinting or dashing.
	state.MagicPreviousMultiplier = state.MagicSpeedMultiplier
	state.MagicSpeedGraceUntil = workspace:GetServerTimeNow() + Config.ValidationInterval + Config.DashReplicationGrace
	state.MagicSpeedMultiplier = multiplier or 1
	state.Character:SetAttribute("MagicSpeedMultiplier", state.MagicSpeedMultiplier)
	state.MagicWalkSpeedBonus = walkSpeedBonus
	state.MagicJumpPowerBonus = jumpPowerBonus
	state.Character:SetAttribute("MagicWalkSpeedBonus", walkSpeedBonus)
	state.Character:SetAttribute("MagicJumpPowerBonus", jumpPowerBonus)
	applySpeed(state)
end

function Movement.dash(state: Types.PlayerState, now: number): boolean
	if now < state.DashReadyAt or now < state.ReadyAt or now < state.CorrectionUntil then
		return false
	end
	state.DashUntil = now + Config.DashDuration
	state.DashReadyAt = now + Config.DashCooldown
	-- Use the previous observed position: prediction can arrive before the request.
	state.DashOrigin = state.LastPosition
	state.DashCheckUntil = state.DashUntil + Config.DashReplicationGrace
	state.DashAllowance += Config.DashDistance
	return true
end

local function correct(state: Types.PlayerState, position: Vector3, now: number, player: Player, feedback: RemoteEvent)
	state.Root:SetNetworkOwner(nil)
	state.Root.CFrame = CFrame.new(position) * state.Root.CFrame.Rotation
	state.Root.AssemblyLinearVelocity = Vector3.zero
	state.CorrectionUntil = now + Config.CorrectionOwnershipTime
	state.Attack = nil
	state.DashOrigin = nil
	state.DashUntil = 0
	state.DashAllowance = 0
	state.LastPosition = position
	state.LastFramePosition = position
	state.LastCheck = now
	feedback:FireClient(player, { Kind = "Correction", Character = state.Character })
end

function Movement.update(player: Player, state: Types.PlayerState, now: number, feedback: RemoteEvent): boolean
	if now < state.SpawnGraceUntil then
		-- Roblox may still place/scale the rig after it first enters Workspace.
		-- Track the actual spawn position without fighting that engine movement.
		state.LastPosition = state.Root.Position
		state.LastFramePosition = state.Root.Position
		state.LastCheck = now
		if state.DashOrigin then
			state.DashOrigin = state.Root.Position
		end
		return true
	end
	if state.CorrectionUntil > 0 then
		if now < state.CorrectionUntil then
			return false
		end
		state.CorrectionUntil = 0
		state.Root:SetNetworkOwnershipAuto()
	end
	local elapsed = now - state.LastCheck
	local delta = state.Root.Position - state.LastPosition
	local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
	-- Horizontal checks leave jumping and falling alone. This is a sandbox guard,
	-- not a complete anti-cheat for client-owned Roblox character physics.
	local budget = maximumSpeed(state) * elapsed + state.DashAllowance + Config.PositionTolerance
	-- Check before every damage sample, not just when advancing the movement anchor.
	if horizontal ~= horizontal or horizontal > budget then
		-- This violation is horizontal: preserve current jumping/falling height.
		correct(
			state,
			Vector3.new(state.LastPosition.X, state.Root.Position.Y, state.LastPosition.Z),
			now,
			player,
			feedback
		)
		return false
	end
	if state.DashOrigin then
		local travel = state.Root.Position - state.LastFramePosition
		if travel.Magnitude > Config.DirectionEpsilon then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { state.Character }
			params.RespectCanCollide = true
			local start = CFrame.new(state.LastFramePosition) * state.Root.CFrame.Rotation
			local obstacle = workspace:Blockcast(start, Config.DashCollisionSize, travel, params)
			if obstacle then
				local safe = state.LastFramePosition + travel.Unit * math.max(0, obstacle.Distance - Config.WallPadding)
				correct(state, safe, now, player, feedback)
				return false
			end
		end
	end
	state.LastFramePosition = state.Root.Position
	if elapsed >= Config.ValidationInterval then
		state.LastCheck = now
		state.LastPosition = state.Root.Position
		-- Keep the allowance while delayed predicted physics can still arrive.
		if now >= state.DashCheckUntil then
			state.DashAllowance = 0
		end
	end
	if state.DashOrigin then
		local displacement = state.Root.Position - state.DashOrigin
		local limit = Config.DashDistance
			+ Config.PositionTolerance
			+ maximumSpeed(state) * (Config.ValidationInterval + Config.DashReplicationGrace)
		if Vector3.new(displacement.X, 0, displacement.Z).Magnitude > limit then
			correct(
				state,
				Vector3.new(state.DashOrigin.X, state.Root.Position.Y, state.DashOrigin.Z),
				now,
				player,
				feedback
			)
			return false
		end
		if now >= state.DashCheckUntil then
			state.DashOrigin = nil
		end
	end
	return true
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">NascentAttackSelector</string>
            <string name="Source"><![CDATA[--!strict

-- Pure, state-based selection for the Stage 1 Nascent. It intentionally has no
-- cooldown table: distance, recent commitment and desperation set the rhythm.
local Selector = {}

function Selector.choose(tuning, distance, lastAttack, serial, desperate)
	if distance <= tuning.MaulingCombination.Range and lastAttack ~= "MaulingCombination" then
		return "MaulingCombination"
	end
	if
		distance >= tuning.PredatoryLunge.MinimumRange
		and distance <= tuning.PredatoryLunge.Range
		and lastAttack ~= "PredatoryLunge"
	then
		return "PredatoryLunge"
	end
	if distance <= tuning.FrenziedChain.Range and lastAttack ~= "FrenziedChain" and (desperate or serial % 3 == 1) then
		return "FrenziedChain"
	end
	if distance <= tuning.RushingStrike.Range then
		return "RushingStrike"
	end
	return nil
end

return Selector
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">OpeningService</string>
            <string name="Source"><![CDATA[--!strict
-- Session identity only; no persistent class or progression state.
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Configuration.CityLife)
local Plan = require(Shared.Configuration.PhaseATopology)
local Equipment = require(script.Parent.EquipmentService)
local Spawn = require(script.Parent.WorldSpawnService)
local Opening = {}
local sessions = {}

local function dress(character, preset)
	for _, item in character:GetChildren() do
		if
			item:IsA("Accessory")
			or item:IsA("Shirt")
			or item:IsA("Pants")
			or item:IsA("ShirtGraphic")
			or item.Name == "LowerLayerClothing"
		then
			item:Destroy()
		end
	end
	local clothes = Instance.new("Folder")
	clothes.Name = "LowerLayerClothing"
	clothes.Parent = character
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "SandboxEquippedWeapon" then
			local clothed = part.Name ~= "Head" and not string.find(part.Name, "Hand")
			part.Color = if clothed then preset.Cloth else preset.Skin
			if part:IsA("MeshPart") then
				part.TextureID = ""
			end
			if clothed and (string.find(part.Name, "Torso") or string.find(part.Name, "Leg")) then
				local cover = Instance.new("Part")
				cover.Name = "Cloth"
				cover.Size = part.Size + Vector3.new(0.04, 0.02, 0.04)
				cover.CFrame = part.CFrame
				cover.Color = preset.Cloth
				cover.Material = Enum.Material.Fabric
				cover.CanCollide, cover.CanTouch, cover.CanQuery, cover.Massless = false, false, false, true
				cover.Parent = clothes
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = part, cover, cover
			end
		end
	end
end

function Opening.bind(player)
	local session = { Preset = 1, Complete = false, LastRequest = -math.huge }
	sessions[player] = session
	player:SetAttribute("OpeningComplete", false)
	session.Connection = player.CharacterAppearanceLoaded:Connect(function(character)
		if player.Character == character then
			dress(character, Config.Presets[session.Preset])
		end
	end)
end

function Opening.prepareCharacter(player, character)
	local session = sessions[player]
	if not session then
		return
	end
	dress(character, Config.Presets[session.Preset])
	if not session.Complete then
		local position = Spawn.ground(Plan.Nodes[Config.Opening.Node] + Config.Opening.Offset, 5, 3)
		if position then
			character:PivotTo(CFrame.new(position))
		end
		character.HumanoidRootPart.Anchored = true
	end
end

function Opening.start(folder, feedback)
	local choice = Instance.new("RemoteEvent")
	choice.Name, choice.Parent = "OpeningChoice", folder
	choice.OnServerEvent:Connect(function(player, preset, path)
		local session = sessions[player]
		if not session or session.Complete or os.clock() - session.LastRequest < 0.5 then
			return
		end
		session.LastRequest = os.clock()
		if typeof(preset) ~= "number" or preset % 1 ~= 0 or not Config.Presets[preset] then
			return
		end
		if path ~= "Melee" and path ~= "Magic" then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not player:GetAttribute("CharacterReady") or not humanoid or humanoid.Health <= 0 then
			return
		end
		if not Equipment.chooseStarter(player, path, feedback) then
			return
		end
		session.Preset, session.Complete = preset, true
		character.HumanoidRootPart.Anchored = false
		character.HumanoidRootPart:SetNetworkOwner(player)
		dress(character, Config.Presets[preset])
		player:SetAttribute("AppearancePreset", preset)
		player:SetAttribute("OpeningComplete", true)
	end)
end
function Opening.remove(player)
	local session = sessions[player]
	if session then
		session.Connection:Disconnect()
	end
	sessions[player] = nil
end
return Opening
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">SandboxService</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Configuration.Sandbox)
local World = require(Shared.Configuration.LowerLayerGraybox)
local Locations = require(Shared.Configuration.AssignmentLocations)
local Graybox = require(script.Parent.Parent.Development.LowerLayerGraybox)
local Sandbox = {}

function Sandbox.start()
	Graybox.start()
	local signs = Instance.new("Folder")
	signs.Name = "DistrictSigns"
	signs.Parent = workspace
	for id, location in Locations do
		if id ~= "Underground_Junction" then
			local sign = Instance.new("Part")
			sign.Name = "Sign_" .. id
			sign.Size = Vector3.new(8, 3, 0.25)
			sign.CFrame = CFrame.new(location.Position + Vector3.new(0, 7, -4))
			sign.Anchored, sign.CanCollide, sign.Material = true, false, Enum.Material.Metal
			sign.Color = Color3.fromRGB(45, 48, 52)
			sign.Parent = signs
			local surface = Instance.new("SurfaceGui")
			surface.Face, surface.CanvasSize = Enum.NormalId.Front, Vector2.new(400, 150)
			surface.Parent = sign
			local text = Instance.new("TextLabel")
			text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 1
			text.Text, text.TextColor3, text.Font, text.TextScaled =
				location.Name:upper(), Color3.new(1, 1, 1), Enum.Font.GothamBold, true
			text.Parent = surface
		end
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "RecruitSpawnLocation"
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.Position = World.PhaseA.RecruitSpawn
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = workspace

	local function createDummy()
		local model = Instance.new("Model")
		model.Name = "TargetDummy"
		local root = Instance.new("Part")
		root.Name = "HumanoidRootPart"
		root.Size = Vector3.new(2, 2, 1)
		root.Transparency = 1
		root.CanCollide = false
		root.Anchored = true
		root.Position = Config.Dummy.Position
		root.Parent = model
		local body = Instance.new("Part")
		body.Name = "Torso"
		body.Size = Vector3.new(3, 4, 2)
		body.Position = Config.Dummy.Position
		body.Anchored = true
		body.Color = Color3.fromRGB(175, 95, 85)
		body.Parent = model
		local head = Instance.new("Part")
		head.Name = "Head"
		head.Size = Vector3.new(2, 2, 2)
		head.Position = Config.Dummy.Position + Vector3.new(0, 3, 0)
		head.Anchored = true
		head.Parent = model
		local humanoid = Instance.new("Humanoid")
		humanoid.RequiresNeck = false
		humanoid.BreakJointsOnDeath = false
		humanoid.MaxHealth = Config.Dummy.Health
		humanoid.Health = Config.Dummy.Health
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.Parent = model
		model.PrimaryPart = root
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(180, 40)
		gui.StudsOffset = Vector3.new(0, 2, 0)
		gui.AlwaysOnTop = true
		gui.Parent = head
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 0
		label.TextSize = 18
		label.Parent = gui
		local function update()
			label.Text = string.format("Dummy  %d / %d", humanoid.Health, humanoid.MaxHealth)
		end
		update()
		humanoid.HealthChanged:Connect(update)
		humanoid.Died:Once(function()
			task.delay(Config.Dummy.ResetDelay, function()
				model:Destroy()
				createDummy()
			end)
		end)
		model.Parent = workspace
	end
	createDummy()
	local earth = Instance.new("Part")
	earth.Name = "EarthMagicMaterial"
	earth.Size = Vector3.new(6, 3, 6)
	earth.Position = Vector3.new(-70, 1.5, 1460)
	earth.Anchored = true
	earth.Material = Enum.Material.Slate
	earth.Color = Color3.fromRGB(100, 75, 55)
	earth:SetAttribute("MagicMaterial", "Earth")
	earth:SetAttribute("AvailableAmount", 50)
	earth.Parent = workspace
	CollectionService:AddTag(earth, "MagicMaterialSource")
	local manipulable = Instance.new("Part")
	manipulable.Name = "EarthRaiseStone"
	manipulable.Size = Vector3.new(5, 2, 5)
	manipulable.Position = Vector3.new(75, 1, 1460)
	manipulable.Anchored = true
	manipulable.Material = Enum.Material.Slate
	manipulable.Color = Color3.fromRGB(90, 105, 80)
	manipulable:SetAttribute("MagicMaterial", "Earth")
	manipulable:SetAttribute("MagicRaise", true)
	manipulable.Parent = workspace
	CollectionService:AddTag(manipulable, "MagicManipulable")
	local label = Instance.new("BillboardGui")
	label.Size = UDim2.fromOffset(180, 30)
	label.StudsOffset = Vector3.new(0, 3, 0)
	label.AlwaysOnTop = true
	label.Parent = earth
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0
	text.Text = "Earth source (Stone Shot)"
	text.Parent = label
end

return Sandbox
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">SandboxStressService</string>
            <string name="Source"><![CDATA[--!strict

-- Temporary wave/performance harness. No persistence, rewards, or difficulty scaling.
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sandbox = require(Shared:WaitForChild("Configuration"):WaitForChild("Sandbox"))
local Topology = require(Shared:WaitForChild("Configuration"):WaitForChild("PhaseATopology"))
local Config = Sandbox.StressTest
local Enemy = require(script.Parent.EnemyService)
local StressTest = {}
local COLLISION_GROUP = "SandboxStressEnemies"

type Entry = { Handle: Enemy.Handle, Alive: boolean, RemoveAt: number }

function StressTest.start()
	assert(not workspace:FindFirstChild("SandboxStressTest"), "Sandbox stress test already running")
	assert(#Config.WaveSizes > 0, "Configure at least one wave")
	assert(Config.PathStartsPerSecond > 0 and Config.MaxPathsInFlight >= 1, "Invalid path budget")
	assert(Config.MaxPathsInFlight % 1 == 0 and Config.HitQueryRate > 0, "Invalid path concurrency/hit rate")
	assert(Config.MinSpawnSpacing > 0 and Config.SpawnCandidateMinimumDistance > 0, "Invalid spawn layout")
	assert(Config.SpawnCandidateMaximumDistance > Config.SpawnCandidateMinimumDistance, "Invalid spawn distance range")
	assert(Config.InterWaveDelay >= 0 and Config.CorpseLifetime >= 0, "Invalid wave timing")
	for _, count in Config.WaveSizes do
		assert(count >= 1 and count % 1 == 0, "Wave sizes must be positive integers")
	end
	if not PhysicsService:IsCollisionGroupRegistered(COLLISION_GROUP) then
		PhysicsService:RegisterCollisionGroup(COLLISION_GROUP)
	end
	PhysicsService:CollisionGroupSetCollidable(COLLISION_GROUP, COLLISION_GROUP, Config.EnemyCollisions)
	-- Roblox characters and the baseplate retain Default: body-blocking players is intentional.
	PhysicsService:CollisionGroupSetCollidable(COLLISION_GROUP, "Default", true)
	local visuals = Sandbox.Enemy.VisualCollisionGroup
	local query = Sandbox.Combat.OverlapCollisionGroup
	for _, group in { visuals, query } do
		if not PhysicsService:IsCollisionGroupRegistered(group) then
			PhysicsService:RegisterCollisionGroup(group)
		end
	end
	-- Only the hull blocks physical movement, even if Humanoid toggles a limb's CanCollide.
	PhysicsService:CollisionGroupSetCollidable(visuals, "Default", false)
	PhysicsService:CollisionGroupSetCollidable(visuals, COLLISION_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(visuals, visuals, false)
	-- Attack overlaps see the normal rig, not the taller anti-climb hull.
	PhysicsService:CollisionGroupSetCollidable(query, "Default", true)
	PhysicsService:CollisionGroupSetCollidable(query, visuals, true)
	PhysicsService:CollisionGroupSetCollidable(query, COLLISION_GROUP, false)

	local folder = Instance.new("Folder")
	folder.Name = "SandboxStressTest"
	local enemies = Instance.new("Folder")
	enemies.Name = "Enemies"
	enemies.Parent = folder
	local entries: { Entry } = {}
	local wave, living = 0, 0
	local phase = "Waiting"
	local nextWaveAt = os.clock()
	local nextPathStart = 0
	local inFlight, startedPaths, pathCursor = 0, 0, 0
	local nextMetrics = 0
	local stopped = false
	local heartbeat: RBXScriptConnection? = nil
	local destroying: RBXScriptConnection? = nil

	local function publish()
		folder:SetAttribute("Wave", wave)
		folder:SetAttribute("TotalWaves", #Config.WaveSizes)
		folder:SetAttribute("LivingEnemies", living)
		folder:SetAttribute("Status", phase)
		folder:SetAttribute("NextWaveAt", workspace:GetServerTimeNow() + math.max(0, nextWaveAt - os.clock()))
	end
	publish()
	folder:SetAttribute("PathsInFlight", 0)
	folder:SetAttribute("PathsStarted", 0)
	folder:SetAttribute("PendingPaths", 0)
	folder.Parent = workspace

	local function clearWave()
		for _, entry in entries do
			entry.Handle.Destroy()
		end
		table.clear(entries)
		pathCursor = 0
	end

	local candidateCursor = 0
	local function positions(count: number): { Vector3 }?
		local protected = { Sandbox.Dummy.Position }
		local spawn = workspace:FindFirstChild("SandboxSpawn")
		if spawn and spawn:IsA("BasePart") then
			table.insert(protected, spawn.Position)
		end
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if root and root:IsA("BasePart") then
				table.insert(protected, root.Position)
			end
		end
		local overlap = OverlapParams.new()
		overlap.FilterType = Enum.RaycastFilterType.Exclude
		overlap.FilterDescendantsInstances = { folder }
		overlap.RespectCanCollide = true
		local graybox = workspace:FindFirstChild("LowerLayerGraybox")
		local debugFolder = if graybox then graybox:FindFirstChild("Debug") else nil
		local function groundedPosition(candidate: Vector3): Vector3?
			if not graybox then
				return nil
			end
			local ray = RaycastParams.new()
			ray.FilterType = Enum.RaycastFilterType.Exclude
			ray.FilterDescendantsInstances = { folder }
			ray.RespectCanCollide = true
			-- Probe around the authored route height. The old 140-stud probe began
			-- above the surface and therefore hit it before an underground floor.
			local origin = candidate + Vector3.new(0, Config.GroundProbeHeight, 0)
			local hit = workspace:Raycast(origin, Vector3.new(0, -Config.GroundProbeDistance, 0), ray)
			if
				not hit
				or hit.Normal.Y < 0.9
				or not hit.Instance:IsDescendantOf(graybox)
				or (debugFolder and hit.Instance:IsDescendantOf(debugFolder))
			then
				return nil
			end
			local rootHeight = Sandbox.Enemy.CollisionHull.Height / 2 - Sandbox.Enemy.CollisionHull.CenterOffsetY
			return hit.Position + Vector3.new(0, rootHeight + Config.GroundClearance, 0)
		end
		local available: { { Position: Vector3, Score: number } } = {}
		for _, candidate in Topology.SpawnCandidates do
			local source = (candidate.Position or Topology.Nodes[candidate.Node]) + candidate.Offset
			local position = groundedPosition(source)
			if position then
				local closest = math.huge
				for _, point in protected do
					local delta = position - point
					closest = math.min(closest, Vector3.new(delta.X, 0, delta.Z).Magnitude)
				end
				local valid = closest >= math.max(Config.SpawnCandidateMinimumDistance, Config.SpawnClearance)
					and closest <= Config.SpawnCandidateMaximumDistance
				if
					valid
					and #workspace:GetPartBoundsInBox(
							CFrame.new(position + Vector3.new(0, Sandbox.Enemy.CollisionHull.CenterOffsetY, 0)),
							Vector3.new(5, Sandbox.Enemy.CollisionHull.Height - 0.2, 5),
							overlap
						)
						> 0
				then
					valid = false
				end
				if valid then
					table.insert(available, { Position = position, Score = closest })
				end
			end
		end
		table.sort(available, function(left, right)
			return left.Score < right.Score
		end)
		local result: { Vector3 } = {}
		if #available > 0 then
			candidateCursor = candidateCursor % #available
			for offset = 1, #available do
				local candidate = available[(candidateCursor + offset - 1) % #available + 1]
				local spaced = true
				for _, chosen in result do
					if (candidate.Position - chosen).Magnitude < Config.MinSpawnSpacing then
						spaced = false
						break
					end
				end
				if spaced then
					table.insert(result, candidate.Position)
					if #result == count then
						candidateCursor += offset
						return result
					end
				end
			end
		end
		return nil -- Candidates retry later instead of placing enemies inside characters/walls.
	end

	local function startWave(now: number)
		clearWave()
		local locations = positions(Config.WaveSizes[wave + 1])
		if not locations then
			phase = "Blocked"
			nextWaveAt = now + math.max(1, Config.InterWaveDelay)
			publish()
			return
		end
		wave += 1
		for index, position in locations do
			local handle = Enemy.create(
				position,
				enemies,
				COLLISION_GROUP,
				(index - 1) * Sandbox.Enemy.ThinkInterval / #locations,
				1 / Config.HitQueryRate
			)
			handle.Model.Name = string.format("Enfleshed_W%d_%02d", wave, index)
			handle.Model:SetAttribute("SandboxLabel", string.format("Enfleshed %02d", index))
			table.insert(entries, { Handle = handle, Alive = true, RemoveAt = math.huge })
		end
		living = #entries
		phase = "Active"
		publish()
	end

	destroying = folder.Destroying:Connect(function()
		stopped = true
		if heartbeat then
			heartbeat:Disconnect()
		end
		clearWave()
		if destroying then
			destroying:Disconnect()
		end
	end)

	heartbeat = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		local changed = false
		for _, entry in entries do
			if entry.Alive then
				entry.Handle.Update(now)
				if not entry.Handle.IsAlive() then
					entry.Alive = false
					entry.RemoveAt = now + Config.CorpseLifetime
					living -= 1
					changed = true
				end
			elseif now >= entry.RemoveAt then
				entry.Handle.Destroy()
				entry.RemoveAt = math.huge
			end
		end
		if phase == "Active" and living == 0 then
			phase = if wave == #Config.WaveSizes then "Complete" else "Waiting"
			nextWaveAt = now + Config.InterWaveDelay
			changed = true
		end
		if changed then
			publish()
		end
		if (phase == "Waiting" or phase == "Blocked") and now >= nextWaveAt then
			startWave(now)
		end

		-- Round-robin admission: no catch-up burst after a slow frame, and no per-enemy coroutines waiting for slots.
		if phase == "Active" and now >= nextPathStart and inFlight < Config.MaxPathsInFlight then
			for _ = 1, #entries do
				pathCursor = pathCursor % #entries + 1
				local entry = entries[pathCursor]
				local job = if entry.Alive then entry.Handle.TakePathJob() else nil
				if job then
					inFlight += 1
					startedPaths += 1
					nextPathStart = now + 1 / Config.PathStartsPerSecond
					task.spawn(function()
						local ok, err = pcall(job)
						inFlight -= 1
						if not ok then
							warn("Sandbox path computation failed: " .. tostring(err))
						end
						if not stopped then
							folder:SetAttribute("PathsInFlight", inFlight)
						end
					end)
					break
				end
			end
		end
		if now >= nextMetrics then
			nextMetrics = now + Sandbox.Enemy.ThinkInterval
			local pending = 0
			for _, entry in entries do
				if entry.Alive and entry.Handle.HasPendingPath() then
					pending += 1
				end
			end
			folder:SetAttribute("PendingPaths", pending)
			folder:SetAttribute("PathsInFlight", inFlight)
			folder:SetAttribute("PathsStarted", startedPaths)
		end
		if phase == "Complete" then
			local corpsesRemain = false
			for _, entry in entries do
				if entry.RemoveAt < math.huge then
					corpsesRemain = true
					break
				end
			end
			if not corpsesRemain then
				clearWave()
				if heartbeat then
					heartbeat:Disconnect()
				end
			end
		end
	end)
end

return StressTest
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">WorldEventRules</string>
            <string name="Source"><![CDATA[--!strict
-- Pure event rules, shared by the director and deterministic offline tests.
local Rules = {}
function Rules.available(now, cooldown, active, cap, enemies, count, enemyCap)
	return now >= cooldown and active < cap and enemies + count <= enemyCap
end
function Rules.eligible(credit, config)
	return credit ~= nil
		and (
			credit.Damage >= config.ContributionDamage
			or (credit.Seconds >= config.EscortSeconds and credit.Distance >= config.EscortDistance)
		)
end
function Rules.credit(ledger, userId, damage, seconds, distance)
	local credit = ledger[userId] or { Damage = 0, Seconds = 0, Distance = 0, Paid = false }
	credit.Damage = credit.Damage + math.max(0, damage)
	credit.Seconds = credit.Seconds + math.max(0, seconds)
	credit.Distance = credit.Distance + math.max(0, distance)
	ledger[userId] = credit
end
function Rules.claim(ledger, userId, success, config)
	local credit = ledger[userId]
	if not success or not Rules.eligible(credit, config) or credit.Paid then
		return false
	end
	credit.Paid = true
	return true
end
function Rules.escortStep(traveled, playerTravel, nearBefore, nearNow, dt)
	if
		not nearBefore
		or not nearNow
		or traveled <= 0.2
		or traveled >= 30
		or playerTravel <= 0.2
		or playerTravel >= 40
	then
		return 0, 0
	end
	return dt, math.min(traveled, playerTravel)
end
function Rules.outcome(alive, protectedAlive, arrived, travel, expired)
	if not protectedAlive then
		return "Failed"
	end
	if alive == 0 and (not travel or arrived) then
		return "Completed"
	end
	if expired then
		return "Failed"
	end
	return nil
end
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">WorldEventService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Run = game:GetService("RunService")
local Http = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Configuration.WorldEvents)
local Plan = require(Shared.Configuration.PhaseATopology)
local Locations = require(Shared.Configuration.AssignmentLocations)
local Runtime = require(script.Parent.EnemyRuntime)
local Spawn = require(script.Parent.WorldSpawnService)
local City = require(script.Parent.LivingCityService)
local Damage = require(script.Parent.DamageService)
local Rules = require(script.Parent.WorldEventRules)
local Director = {}
local events, cooldowns = {}, {}
local folder, nextEvent = nil, 0
local random = Random.new()
local function countLiving(event)
	local n = 0
	for _, enemy in event.Enemies do
		if enemy.IsAlive() then
			n += 1
		end
	end
	return n
end
local function state(event, value)
	event.State = value
	event.Folder:SetAttribute("State", value)
end
local function center(event)
	return if event.Traveler and event.Traveler.Model.Parent then event.Traveler.Root.Position else event.Position
end
local function resolve(event, success, now)
	if event.State ~= "Active" and event.State ~= "Preparing" then
		return
	end
	state(event, "Resolving")
	event.Success = success
	for _, player in Players:GetPlayers() do
		if Rules.claim(event.Credit, player.UserId, success, Config) then
			player:SetAttribute("MilitaryScrip", (player:GetAttribute("MilitaryScrip") or 0) + event.Definition.Reward)
			player:SetAttribute(
				"EventRewardNotice",
				event.Definition.Name .. " · +" .. event.Definition.Reward .. " scrip"
			)
		end
	end
	event.ResolvedAt = now
end
local function cleanup(event, now)
	state(event, "Cleanup")
	for _, enemy in event.Enemies do
		enemy.Destroy()
	end
	if event.Traveler then
		City.remove(event.Traveler)
	end
	if event.Companion then
		City.remove(event.Companion)
	end
	City.release(event.Id)
	cooldowns[event.LocationId] = now + (event.Definition.Cooldown or Config.LocationCooldown)
	state(event, "Cooldown")
	folder:SetAttribute(
		"Cooldown_" .. event.LocationId,
		workspace:GetServerTimeNow() + (event.Definition.Cooldown or Config.LocationCooldown)
	)
	event.Folder:Destroy()
	events[event.Id] = nil
	-- No successor wave: the location stays quiet through its cooldown.
	nextEvent = math.max(nextEvent, now + Config.GlobalCooldown / math.max(0.1, Config.FrequencyMultiplier))
end
local function spawnPoints(event)
	local points = {}
	local origin = if event.Kind == "RampartAssault" then Plan.Nodes[Config.Anchors.ArchApproach] else event.Position
	for _ = 1, event.Count do
		local point = Spawn.find(origin, Config.SpawnRadius, Config.MinimumPlayerDistance, Config.SafeRadius, points)
		if not point then
			return nil
		end
		table.insert(points, point)
	end
	return points
end
local function objective(enemy, actor)
	if not actor then
		return
	end
	local value = Instance.new("ObjectValue")
	value.Name, value.Value, value.Parent = "ObjectiveTarget", actor.Model, enemy.Model
end
local function activate(event, now)
	-- Recheck ground, player distances and occupancy after the warning period.
	local points = spawnPoints(event)
	if not points then
		resolve(event, false, now)
		return
	end
	if event.Kind == "TravelIncident" then
		event.Traveler = City.create("Supply carrier", "Worker", event.Definition.Route, true)
		event.Companion = City.create("Escort", "Guard", event.Definition.Route, true)
		if not event.Traveler or not event.Companion then
			resolve(event, false, now)
			return
		end
		event.LastPosition = event.Traveler.Root.Position
	end
	local victim = event.Traveler or City.near(event.Position, event.Kind == "RampartAssault")
	if event.Kind == "LocalAttack" or event.Kind == "RampartAssault" then
		local distance
		victim, distance = City.near(event.Position, event.Kind == "RampartAssault")
		if not victim or distance > 160 then
			resolve(event, false, now)
			return
		end
		event.Protected = victim
	end
	for _, point in points do
		local enemy = Runtime.create(point, event.Folder)
		enemy.Model:SetAttribute("Population", "WorldEvent")
		enemy.Model:SetAttribute("EventId", event.Id)
		-- Breaches hold their location; other events approach their human target.
		if event.Kind ~= "Breach" then
			objective(enemy, victim)
		end
		table.insert(event.Enemies, enemy)
	end
	event.Started = now
	event.LastTick = now
	state(event, "Active")
end
local function begin(kind, locationId, location, now)
	local definition = Config.Definitions[kind]
	local count = random:NextInteger(definition.CountRange[1], definition.CountRange[2])
	local active, enemies = 0, 0
	for _, e in events do
		active += 1
		enemies += e.Count
	end
	if
		not Rules.available(now, cooldowns[locationId] or 0, active, Config.ActiveCap, enemies, count, Config.EnemyCap)
	then
		return false
	end
	if not Spawn.safe(location.Position, Config.SafeRadius) then
		return false
	end
	local nearby = false
	for _, root in Spawn.players() do
		local d = (root.Position - location.Position).Magnitude
		if d >= Config.MinimumPlayerDistance and d <= Config.MaximumDiscoveryDistance then
			nearby = true
		end
	end
	if not nearby then
		return false
	end
	local event = {
		Id = Http:GenerateGUID(false),
		Kind = kind,
		Definition = definition,
		LocationId = locationId,
		Position = location.Position,
		Count = count,
		Enemies = {},
		Credit = {},
		PreparedAt = now,
		State = "Preparing",
		PlayerPositions = {},
	}
	if not spawnPoints(event) then
		return false
	end
	if kind == "LocalAttack" or kind == "RampartAssault" then
		local human, distance = City.near(location.Position, kind == "RampartAssault")
		if not human or distance > 160 then
			return false
		end
	end
	if kind == "TravelIncident" and locationId ~= "Checkpoint_Market" then
		return false
	end
	local instance = Instance.new("Folder")
	instance.Name, instance.Parent = event.Id, folder
	instance:SetAttribute("DefinitionId", kind)
	instance:SetAttribute("LocationId", locationId)
	event.Folder = instance
	state(event, "Preparing")
	events[event.Id] = event
	cooldowns[locationId] = math.huge
	if kind == "RampartAssault" then
		City.mobilize(
			event.Id,
			Plan.Nodes[Config.Anchors.RampartDefenseLine],
			Plan.Nodes[Config.Anchors.CivilianRetreatArea]
		)
	end
	nextEvent = now + Config.GlobalCooldown / math.max(0.1, Config.FrequencyMultiplier)
	return true
end
local function attempt(kind)
	if not Config.Definitions[kind] then
		return false, "Unknown event definition"
	end
	local choices = {}
	if kind == "RampartAssault" then
		choices = {
			{
				Id = "RampartDefenseLine",
				Position = Plan.Nodes[Config.Anchors.RampartDefenseLine],
				Category = "Defense",
			},
		}
	else
		for id, location in Locations do
			if table.find(Config.Definitions[kind].Categories, location.Category) then
				table.insert(choices, { Id = id, Position = location.Position, Category = location.Category })
			end
		end
	end
	-- Randomized rotation, rather than starving the last valid location in a table.
	local offset = if #choices > 0 then random:NextInteger(1, #choices) else 1
	for i = 1, #choices do
		local location = choices[(offset + i - 2) % #choices + 1]
		if begin(kind, location.Id, location, os.clock()) then
			return true, "Preparing " .. kind .. " at " .. location.Id
		end
	end
	return false, "No eligible location: check player distance, safe/clear ground, humans, caps and cooldowns"
end
function Director.start()
	if folder then
		return
	end
	folder = Instance.new("Folder")
	folder.Name, folder.Parent = "WorldEvents", workspace
	local anchors = Instance.new("Folder")
	anchors.Name, anchors.Parent = "Anchors", folder
	for name, node in Config.Anchors do
		local anchor = Instance.new("Vector3Value")
		anchor.Name, anchor.Value, anchor.Parent = name, Plan.Nodes[node], anchors
	end
	nextEvent = os.clock() + Config.InitialDelay
	Damage.Applied:Connect(function(attacker, target, amount)
		local player = Players:GetPlayerFromCharacter(attacker)
		local model = target.Parent
		if not player or not model or model:GetAttribute("Population") ~= "WorldEvent" then
			return
		end
		local event = events[model:GetAttribute("EventId")]
		if not event or event.State ~= "Active" then
			return
		end
		-- Attributes alone are insufficient: require membership in this event's owned roster.
		for _, enemy in event.Enemies do
			if enemy.Model == model then
				Rules.credit(event.Credit, player.UserId, amount, 0, 0)
				break
			end
		end
	end)
	if Run:IsStudio() and Config.Development.Enabled then
		local force = Instance.new("BindableFunction")
		force.Name, force.Parent = "Force", folder
		force.OnInvoke = attempt
		if Config.Development.ForceEvent ~= "" then
			-- Wait for a player to finish opening before the one-shot configured test.
			task.spawn(function()
				while #Spawn.players() == 0 do
					task.wait(1)
				end
				local ok, reason = attempt(Config.Development.ForceEvent)
				print("World event force:", ok, reason)
			end)
		end
	end
	local nextTick = 0
	Run.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextTick then
			return
		end
		nextTick = now + Config.Tick
		for _, event in events do
			if
				event.State == "Preparing"
				and now - event.PreparedAt >= (event.Definition.Preparation or Config.Preparation)
			then
				activate(event, now)
			elseif event.State == "Active" then
				local living = countLiving(event)
				local protected = event.Traveler or event.Protected
				local alive = not protected or (protected.Model.Parent ~= nil and protected.Humanoid.Health > 0)
				if event.Traveler and alive then
					local position = event.Traveler.Root.Position
					local traveled = (position - event.LastPosition).Magnitude
					local dt = math.min(now - event.LastTick, Config.Tick * 2)
					-- Stationary proximity and teleports are not escort participation.
					for _, root in Spawn.players() do
						local player = Players:GetPlayerFromCharacter(root.Parent)
						local last = event.PlayerPositions[player.UserId]
						if last then
							local seconds, distance = Rules.escortStep(
								traveled,
								(root.Position - last).Magnitude,
								(last - event.LastPosition).Magnitude < 35,
								(root.Position - position).Magnitude < 35,
								dt
							)
							if seconds > 0 then
								Rules.credit(event.Credit, player.UserId, 0, seconds, distance)
							end
						end
						event.PlayerPositions[player.UserId] = root.Position
					end
					event.LastPosition = position
				end
				event.LastTick = now
				local result = Rules.outcome(
					living,
					alive,
					event.Traveler and event.Traveler.Finished,
					event.Kind == "TravelIncident",
					now - event.Started > event.Definition.Duration
				)
				if result then
					resolve(event, result == "Completed", now)
				end
			elseif event.State == "Resolving" then
				state(event, if event.Success then "Completed" else "Failed")
			elseif
				(event.State == "Completed" or event.State == "Failed")
				and now - event.ResolvedAt >= Config.CleanupDelay
			then
				cleanup(event, now)
			end
		end
		for _, player in Players:GetPlayers() do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local relevant, nearest = nil, math.huge
			if player:GetAttribute("OpeningComplete") and root then
				for _, event in events do
					local distance = (root.Position - center(event)).Magnitude
					if distance < event.Definition.DiscoveryRadius and distance < nearest then
						relevant, nearest = event, distance
					end
				end
			end
			local message = ""
			if relevant then
				message = relevant.Definition.Name .. " · " .. relevant.State
				if relevant.State == "Active" then
					message ..= "\nEnfleshed remaining: " .. countLiving(relevant)
				end
			end
			player:SetAttribute("NearbyWorldEvent", message)
		end
		if Config.RandomEnabled and Config.FrequencyMultiplier > 0 and now >= nextEvent then
			nextEvent = now + 15 -- Back off when every candidate is ineligible.
			local total = 0
			for _, definition in Config.Definitions do
				total += definition.Weight
			end
			local roll = random:NextNumber(0, total)
			for kind, definition in Config.Definitions do
				roll -= definition.Weight
				if roll <= 0 then
					attempt(kind)
					break
				end
			end
		end
	end)
end
return Director
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">WorldSpawnService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Plan = require(Shared.Configuration.PhaseATopology)
local Config = require(Shared.Configuration.Sandbox)
local World = require(Shared.Configuration.LowerLayerGraybox)
local Locations = require(Shared.Configuration.AssignmentLocations)
local Spawn = {}

function Spawn.safe(point: Vector3, radius: number): boolean
	return (point - World.PhaseA.RecruitSpawn).Magnitude >= radius
		and (point - Locations.Barracks_Main.Position).Magnitude >= radius
		and (point - Plan.Nodes.B1).Magnitude >= radius
end

function Spawn.ground(point: Vector3, height: number?, width: number?): Vector3?
	local geometry = workspace:FindFirstChild("LowerLayerGraybox")
	if not geometry then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { geometry }
	params.RespectCanCollide = true
	local hit = workspace:Raycast(point + Vector3.new(0, 8, 0), Vector3.new(0, -24, 0), params)
	if not hit or hit.Normal.Y < 0.9 then
		return nil
	end
	local h = height or Config.Enemy.CollisionHull.Height
	local w = width or Config.Enemy.CollisionHull.Diameter
	local overlap = OverlapParams.new()
	overlap.RespectCanCollide = true
	local center = hit.Position + Vector3.new(0, h / 2 + 0.15, 0)
	if #workspace:GetPartBoundsInBox(CFrame.new(center), Vector3.new(w, h - 0.1, w), overlap) > 0 then
		return nil
	end
	return hit.Position + Vector3.new(0, 3.1, 0)
end

function Spawn.players(): { BasePart }
	local roots = {}
	for _, player in game:GetService("Players"):GetPlayers() do
		local c = player.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if player:GetAttribute("OpeningComplete") and h and h.Health > 0 and r and r:IsA("BasePart") then
			table.insert(roots, r)
		end
	end
	return roots
end

function Spawn.find(
	center: Vector3,
	radius: number,
	minimum: number,
	safeRadius: number,
	reserved: { Vector3 }
): Vector3?
	local roots = Spawn.players()
	local fallback = nil
	for _, candidate in Plan.SpawnCandidates do
		local point = (candidate.Position or Plan.Nodes[candidate.Node]) + candidate.Offset
		if (point - center).Magnitude > radius or not Spawn.safe(point, safeRadius) then
			continue
		end
		local valid, hidden = true, true
		for _, p in reserved do
			if (point - p).Magnitude < 8 then
				valid = false
			end
		end
		for _, root in roots do
			if (root.Position - point).Magnitude < minimum then
				valid = false
			end
			local params = RaycastParams.new()
			params.FilterDescendantsInstances = { root.Parent }
			params.RespectCanCollide = true
			if
				not workspace:Raycast(
					root.Position + Vector3.new(0, 2, 0),
					point + Vector3.new(0, 3, 0) - (root.Position + Vector3.new(0, 2, 0)),
					params
				)
			then
				hidden = false
			end
		end
		if valid then
			local grounded = Spawn.ground(point)
			if grounded then
				if hidden then
					return grounded
				end
				fallback = fallback or grounded
			end
		end
	end
	return fallback
end
return Spawn
]]></string>
          </Properties>
        </Item>
